<script src="~/Scripts/AngularFramework/AuditorBudget.js?v=@DateTime.Now.Ticks"></script>

<style>


    table.devtable thead tr th {
        background: #1899a0;
        text-align: center;
    }

    table.devtable tfoot tr th, table.devtable tfoot td {
        background: #1899a0;
    }

    table.devtable tbody .add {
        display: inline-block;
        padding: 6px 12px;
        border: 1px solid #006159;
        border-radius: 5px;
        background: #006159;
        color: #fff;
        font-weight: 700;
        font-size: 12px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        table.devtable tbody .add:hover {
            background: #168178;
        }
</style>
<div ng-app="auditorBudgetMod" ng-controller="auditorBudgetCtrl" ng-cloak="">
    <div class="page">
        <div class="col-md-12">
            <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">
                Budget
            </h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">Budget</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <table class="table table-bordered table-striped devtable">

                    <thead>
                        <tr>
                            <th>क्र. स.</th>
                            <th>मद</th>
                            <th>स्वीकृत बजट राशी</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr>
                            <td>1.</td>
                            <td>
                                ऋणों पर ब्याज भुगतान
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>2.</td>
                            <td>
                                बैंक प्रभार (Bank Charges)
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>3.</td>
                            <td>
                                वेतन
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>4.</td>
                            <td>
                                कर्मचारियों को अन्य भत्ते
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>5.</td>
                            <td>
                                यात्रा व्यय
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>6.</td>
                            <td>
                                स्टेशनरी एवं फोटो कॉपी व्यय
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>7.</td>
                            <td>
                                विद्युत व्यय
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>8.</td>
                            <td>
                                टेलीफोन व्यय
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>9.</td>
                            <td>
                                संचालक मंडल सिटींग फीस/ प्रशासक भत्ता
                            </td>
                            <td><input class="form-control" type="text"></td>
                        <tr>
                            <td>10.</td>
                            <td>
                                साधारण सभा खर्च
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>11.</td>
                            <td>
                                अतिथि सत्कार खर्च
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>12.</td>
                            <td>
                                कार्यालय/ गोदाम किराया
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>13.</td>
                            <td>
                                अन्य खर्च
                            </td>
                            <td><input class="form-control" type="text"></td>
                        <tr>
                            <td>14.</td>
                            <td>
                                अन्य प्रावधान से खर्च
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>15.</td>
                            <td>
                                मूल्य हास्
                            </td>
                            <td><input class="form-control" type="text"></td>
                        <tr>
                            <td>16.</td>
                            <td>
                                ऑडिट फीस प्रावधान
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        

                    </tbody>
                </table>


                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button class="btn btn-primary dev-btn text-center" ng-click="NextStep()">Click To Next Steup</button>
                    <button class="btn btn-primary dev-btn text-center">Submit</button>
                    <button class="btn btn-primary dev-btn text-center">Clear</button>
                    <button class="btn btn-primary dev-btn text-center" ng-click="BackTo()">Back To</button>
                </div>
            </div>
        </div>
    </div>
</div>


