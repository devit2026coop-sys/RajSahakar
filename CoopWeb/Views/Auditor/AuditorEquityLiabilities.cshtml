<script src="~/Scripts/AngularFramework/AuditorEquityLiabilities.js?v=@DateTime.Now.Ticks"></script>
<style>


    table.devtable thead tr th {
        background: #006159;
        text-align: center;
    }



    table.devtable tbody .add {
        display: inline-flex;
        border-radius: 50%;
        background-color: #198754;
        color: #fff;
        cursor: pointer;
        transition: background 0.2s ease;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
    }

        table.devtable tbody .add i, table.devtable tbody .remove i {
            color: white;
            font-size: 14px;
            font-weight: normal;
        }

    .remove {
        display: inline-flex;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
        background-color: #dc3545;
    }

    
   

    .section-row th {
        background: #e7f2f1;
        color: #075b55;
        font-weight: 800 !important;
        text-align: left;
        padding: 11px 14px;
        border-top: 2px solid #b5d7d3;
    }

    .total-row th, .total-row td {
        background: #006159;
        color: #fff;
        font-weight: 800;
        padding: 13px 12px;
    }

    .sub-item {
        padding-left: 34px !important;
    }
    
        .sub-item.sub-item-btn{
            display:flex;
            justify-content:space-between;
        }
            .sub-item.sub-item-btn div{
                display:flex;
                gap:10px;
            }
                .sub-item.sub-item-btn input{
                    max-width:300px;
                }

    .form-control.numeric{
        text-align:right;
    }


    .top-tbs-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }
    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

        .custom-tbls-tabs > li {
            margin-bottom: -2px;
        }

            .custom-tbls-tabs > li > a {
                color: #444;
                font-weight: 600;
                border: 1px solid transparent !important;
                border-bottom: 2px solid transparent !important;
                margin-right: 0;
                background: transparent;
                transition: all 0.3s ease;
                border-radius: 4px 4px 0 0;
                padding: 8px 20px;
                line-height: 24px;
                outline: none;
            }

                /* Hover */
                .custom-tbls-tabs > li > a:hover {
                    background: #e3e3e3;
                    color: #168f98;
                    border:1px solid transparent !important;
                    
                }

            /* Active Tab */
            .custom-tbls-tabs > li.active > a,
            .custom-tbls-tabs > li.active > a:hover,
            .custom-tbls-tabs > li.active > a:focus {
                color: #168f98;
                background: #fff;
                border: 1px solid #9f9f9f !important;
                border-bottom: 2px solid #fff !important;
                font-weight: 700;
            }

    .tab-content.custom-tbls-tab-content, .tab-content.custom-tbls-tab-content > .active {
        padding: 0px;
    }
</style>
<div ng-app="auditorEquityLiabilitiesMod" ng-controller="auditorEquityLiabilitiesCtrl"   ng-init="KVSSSocietyID = @Html.Raw(Json.Encode(ViewBag.KVSSId));SessionFinancialYear = @Html.Raw(Json.Encode(ViewBag.FinancialYear))"  ng-cloak="">
    <div class="page">
        <div class="col-md-12">
            <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">Opening Balance  </h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">Equity & Liabilities | Opening Balance </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">

                @*Table-Tabs-Start*@
                <div class="top-tbs-btn">

                    <ul class="nav nav-tabs custom-tbls-tabs" role="tablist">

                        <li ng-repeat="tab in TabList"
                            ng-class="{active: SelectedTabId == tab.TabId}">

                            <a href=""
                               ng-click="SelectAccountTab(tab.TabId)">
                                {{_language == 'hi-in'  ? tab.TabNameHindi : tab.TabNameEnglish}}
                            </a>

                        </li>
                    </ul>


                    <div class="form-inline"
                         style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">

                        <!-- Tab 1: Society Name + Dropdown -->
                        <div ng-show="SelectedTabId == 1"
                             style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">

                            <strong ng-if="KVSSSocietyID != '0'" style="color:#1899a0;">
                                {{GetSelectedSocietyName()}}
                            </strong>

                            <label for="ddlGSS" style="margin:0; white-space:nowrap;">
                                Name of KVSS <span style="color:red;">*</span>
                            </label>

                            <select class="form-control"
                                    style="width:300px;"
                                    id="ddlGSS"
                                    ng-model="KVSSSocietyID"
                                    ng-change="OnSocietyChange()"
                                    ng-options="item.SocietyID as item.SocietyName for item in SocietyList | filter:{SocietyName: SocietySearch}">

                                <option value="">--Select--</option>

                            </select>

                        </div>

                        <!-- Tab 2: Society Name Only -->
                        <div ng-show="SelectedTabId == 2">
                            <strong>Name of KVSS:</strong>
                            <span style="font-weight:bold; color:#1899a0;">
                                {{GetSelectedSocietyName()}}
                            </span>
                        </div>


                        <!-- Financial Year: Visible on Both Tabs -->
                        <div style="display:flex; align-items:center; gap:8px;">

                            <label for="ddlFinancialYear" style="margin:0;">
                                Financial Year <span style="color:red;">*</span>
                            </label>

                            <select class="form-control"
                                    id="ddlFinancialYear"
                                    style="width:140px;"
                                    ng-model="FinancialYear"
                                    ng-options="year for year in FinancialYearList"
                                    ng-change="OnFinancialYearChange()"
                                    ng-disabled="SelectedTabId == 2" >

                                <option value="">--Select FY--</option>
                            </select>

                        </div>

                        <!-- Save & Next: Always Visible -->
                        <button type="button"
                                class="btn btn-primary dev-btn text-center"
                                ng-click="SaveAndNext()">
                            Save & Next
                        </button>

                    </div>
                </div> 

                <div class="tab-content custom-tbls-tab-content" ng-if="KVSSSocietyID && KVSSSocietyID != 0" >
                    <div ng-repeat="tab in TabList"
                         ng-show="SelectedTabId == tab.TabId">

                        <table class="table table-bordered table-striped devtable">

                            <thead>
                                <tr>
                                    <th style="width:70%;">
                                        Particulars / विवरण
                                    </th>

                                    <th>
                                        Opening Balance (₹)
                                    </th>
                                </tr>
                            </thead>



                            <!-- One tbody for each Parent Heading -->
                            <tbody ng-repeat="parent in GetParentHeadersByTab(tab.TabId)" >

                                <!-- 1. Parent Heading -->
                                <tr class="section-row">

                                    <th>
                                        {{$index + 1}}.
                                        {{_language == 'hi-in' ? parent.HeaderNameHindi : parent.HeaderNameEnglish}}

                                        <button type="button"
                                                class="add"
                                                style="float:right;"
                                                ng-click="AddMainHeaderRow(parent)"
                                                title="Add Entry">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </th>

                                    <th>
                                        <div style="display:flex; justify-content:space-between;">
                                            <span>Total</span>
                                            <span>{{GetParentHeaderTotal(parent.HeaderId) | number:2}}</span>
                                        </div>
                                    </th>

                                </tr>

                                <!-- 2. Custom Entries Directly Under Parent -->
                                <tr ng-repeat="row in GetAdditionalRowsByHeader(parent.HeaderId)">

                                    <td class="sub-item sub-item-btn">

                                        <input type="text"
                                               class="form-control"
                                               placeholder="Enter particulars"
                                               ng-model="row.HeaderName" />

                                        <div>
                                            <button type="button"
                                                    class="add" 
                                                    ng-click="SaveAdditionalRow(parent.HeaderId, row)"
                                                    title="Save Row">
                                                <i class="fa fa-save"></i>
                                            </button>

                                            <button type="button"
                                                    class="remove"
                                                    ng-click="RemoveAdditionalRow(parent.HeaderId, $index)"
                                                    title="Remove Row">
                                                <i class="fa fa-trash-o"></i>
                                            </button>
                                        </div>

                                    </td>

                                    <td>
                                        <input type="number"
                                               min="0"
                                               step="0.01"
                                               class="form-control numeric"
                                               ng-model="row.OpeningBalance"
                                               placeholder="0.00" />
                                    </td>

                                </tr>

                                <!-- 3. Child, Grandchild and Further-Level Headings -->
                                <tr ng-repeat-start="node in GetAllDescendants(parent.HeaderId)">

                                    <td class="sub-item"
                                        ng-attr-style="padding-left: {{node.Level * 25}}px !important;">

                                        {{_language == 'hi-in' ? node.HeaderNameHindi : node.HeaderNameEnglish}}

                                        <div style="float:right;">

                                            <!-- Add Custom Entry -->
                                            <button type="button"
                                                    class="add"
                                                    ng-if=" node.FinalSubmit == 0 && node.SubHead==1"
                                                    ng-click="AddMainHeaderRow(node)"
                                                    title="Add Entry">
                                                <i class="fa fa-plus"></i>
                                            </button>

                                            <!-- Delete Custom Heading -->
                                            <button type="button"
                                                    class="remove"
                                                    ng-if="node.KVSSSocietyId > 0 && node.FinalSubmit == 0"
                                                    ng-click="RemoveAdditionalRowExist(node.ParentHeaderId, node)"
                                                    title="Delete Heading">
                                                <i class="fa fa-trash-o"></i>
                                            </button>

                                        </div>

                                    </td>

                                    <td>
                                        <input type="number"
                                               min="0"
                                               step="0.01"
                                               class="form-control numeric"
                                               ng-model="node.OpeningBalance"
                                               ng-change="UpdateParentTotal(parent.HeaderId)"
                                               placeholder="0.00" />
                                    </td>

                                </tr>

                                <!-- 4. Custom Entries Under Each Child / Grandchild -->
                                <tr ng-repeat="row in GetAdditionalRowsByHeader(node.HeaderId)">

                                    <td class="sub-item sub-item-btn"
                                        ng-style="{'padding-left': (15 + (node.Level * 15)) + 'px'}">

                                        <input type="text"
                                               class="form-control"
                                               placeholder="Enter particulars"
                                               ng-model="row.HeaderName" />

                                        <div>
                                            <button type="button"
                                                    class="add"
                                                    ng-click="SaveAdditionalRow(node.HeaderId, row)"
                                                    title="Save Row">
                                                <i class="fa fa-save"></i>
                                            </button>

                                            <button type="button"
                                                    class="remove"
                                                    ng-click="RemoveAdditionalRow(node.HeaderId, $index)"
                                                    title="Remove Row">
                                                <i class="fa fa-trash-o"></i>
                                            </button>
                                        </div>

                                    </td>

                                    <td>
                                        <input type="number"
                                               min="0"
                                               step="0.01"
                                               class="form-control numeric"
                                               ng-model="row.OpeningBalance"
                                               placeholder="0.00" />
                                    </td>

                                </tr>

                                <!-- End of this Heading Group -->
                                <tr ng-repeat-end style="display:none;">
                                    <td colspan="2"></td>
                                </tr>

                            </tbody>


                            <tfoot>

                                <tr class="total-row">

                                    <th>Grand Total / कुल योग</th>

                                    <td style="text-align:right;">
                                        {{GetGrandTotal() | number:2}}
                                    </td>

                                </tr>

                            </tfoot>

                        </table>

                    </div>
                </div>

                @*Table-Tabs-End*@


                <div style="display: flex; gap: 10px; justify-content: center;" ng-if="KVSSSocietyID && KVSSSocietyID != 0" >
                    <button class="btn btn-primary dev-btn text-center" ng-click="SaveAndNext()"  >Save & Next</button>
                    @*<button class="btn btn-primary dev-btn text-center">Save as Draft</button>*@
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    document.addEventListener('input', function (e) {

        if (e.target.classList.contains('numeric')) {

            // Only numbers allow and maximum 2 digits
          //  e.target.value = e.target.value.replace(/[^0-9]/g, '').substring(0, 2);

        }

    });
</script>