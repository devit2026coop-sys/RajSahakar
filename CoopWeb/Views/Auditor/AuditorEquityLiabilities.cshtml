<script src="~/Scripts/AngularFramework/AuditorEquityLiabilities.js?v=@DateTime.Now.Ticks"></script>
<style>


    table.devtable thead tr th {
        background: #006159;
        text-align: center;
    }



    table.devtable tbody .add {
        display: inline-flex;
        border-radius: 50%;
        background-color: #198754;
        color: #fff;
        cursor: pointer;
        transition: background 0.2s ease;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
    }

        table.devtable tbody .add i, table.devtable tbody .remove i {
            color: white;
            font-size: 14px;
            font-weight: normal;
        }

    .remove {
        display: inline-flex;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
        background-color: #dc3545;
    }

    
   

    .section-row th {
        background: #e7f2f1;
        color: #075b55;
        font-weight: 800 !important;
        text-align: left;
        padding: 11px 14px;
        border-top: 2px solid #b5d7d3;
    }

    .total-row th, .total-row td {
        background: #006159;
        color: #fff;
        font-weight: 800;
        padding: 13px 12px;
    }

    .sub-item {
        padding-left: 34px !important;
    }
        .sub-item.sub-item-btn{
            display:flex;
            justify-content:space-between;
        }
            .sub-item.sub-item-btn div{
                display:flex;
                gap:10px;
            }
                .sub-item.sub-item-btn input{
                    max-width:300px;
                }

    .form-control.numeric{
        text-align:right;
    }


    .top-tbs-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }
    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

        .custom-tbls-tabs > li {
            margin-bottom: -2px;
        }

            .custom-tbls-tabs > li > a {
                color: #444;
                font-weight: 600;
                border: 1px solid transparent !important;
                border-bottom: 2px solid transparent !important;
                margin-right: 0;
                background: transparent;
                transition: all 0.3s ease;
                border-radius: 4px 4px 0 0;
                padding: 8px 20px;
                line-height: 24px;
                outline: none;
            }

                /* Hover */
                .custom-tbls-tabs > li > a:hover {
                    background: #e3e3e3;
                    color: #168f98;
                    border:1px solid transparent !important;
                    
                }

            /* Active Tab */
            .custom-tbls-tabs > li.active > a,
            .custom-tbls-tabs > li.active > a:hover,
            .custom-tbls-tabs > li.active > a:focus {
                color: #168f98;
                background: #fff;
                border: 1px solid #9f9f9f !important;
                border-bottom: 2px solid #fff !important;
                font-weight: 700;
            }

    .tab-content.custom-tbls-tab-content, .tab-content.custom-tbls-tab-content > .active {
        padding: 0px;
    }
</style>
<div ng-app="auditorEquityLiabilitiesMod" ng-controller="auditorEquityLiabilitiesCtrl" ng-cloak="">
    <div class="page">
        <div class="col-md-12">
            <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">क्रय विक्रय सहकारी समिति लि. (KVSS), राजस्थान</h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">Equity & Liabilities | Opening Balance </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">

                @*Table-Tabs-Start*@
                <div class="top-tbs-btn">

                    <ul class="nav nav-tabs custom-tbls-tabs" role="tablist">
                        <li class="active">
                            <a href="#tab1" data-toggle="tab">
                                Equity And Liabilities
                            </a>
                        </li>
                        <li>
                            <a href="#tab2" data-toggle="tab">
                                Assets
                            </a>
                        </li>
                    </ul>
                    <div>
                        <button class="btn btn-primary dev-btn text-center" ng-click="NextStep()">Save & Next</button>
                        <button class="btn btn-primary dev-btn text-center">Save as Draft</button>
                    </div>
                </div> 

                <div class="tab-content custom-tbls-tab-content">
                    <div class="tab-pane fade in active" id="tab1">
                        <table class="table table-bordered table-striped devtable">
                            <thead>
                                <tr>
                                    <th style="width:70%;">Particulars / विवरण</th>
                                    <th>Opening Balance (₹)</th>
                                </tr>
                            </thead>
                            <tbody id="accountsBody">
                                <tr class="section-row">
                                    <th style="background-color: #168178; color: #fff; text-align: center;" colspan="4">1. EQUITY AND LIABILITIES (दायित्व एवं निधियां)</th>
                                </tr>
                                <tr class="section-row">
                                    <th>1. शेयर कैपिटल / अंश पूंजी (Share Capital)</th>
                                    <th> Total</th>
                                </tr>
                                <tr>
                                    <td class=" sub-item">प्राथमिक सहकारी समितियां / प्राथमिक भंडार (Primary Societies / Primary Bhandar)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr>
                                    <td class=" sub-item">व्यक्तिगत सदस्य (Individual Member)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr>
                                    <td class=" sub-item">सरकार (Govt)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr>
                                    <td class=" sub-item">राजफैड (RAJFED)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr>
                                    <td class=" sub-item sub-item-btn">Add More <button type="button" class="add" ng-click="shareCapitalAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr ng-repeat="row in ShareCapitalOtherRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="shareCapitalAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="shareCapitalRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                               
                                
                                <tr class="section-row">
                                    <th>2. रिज़र्व एंड फंड्स (Reserves &amp; Funds)</th>
                                    <th>Total</th>
                                </tr>
                                <tr data-group-row="reserves">
                                    <td class=" sub-item">सामान्य आरक्षित निधि (General Reserve Fund)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr data-group-row="reserves">
                                    <td class=" sub-item">सहकारी शिक्षा एवं विकास निधि (Co-op Education Fund)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr data-group-row="reserves">
                                    <td class=" sub-item">लाभांश कोष (Dividend Fund)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr data-group-row="reserves">
                                    <td class=" sub-item">मूल्य घटत बढ़त कोष (Price Fluctuation Fund)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr data-group-row="reserves">
                                    <td class=" sub-item">भूमि एवं भवन कोष (Land &amp; Building Fund)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr data-group-row="reserves">
                                    <td class=" sub-item">जनहितकारी कोष (Public Welfare Fund)</td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr data-group-row="reserves">
                                    <td class=" sub-item sub-item-btn">अन्य कोष (Other Funds)  <button type="button" class="add" ng-click="reservesFundsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr ng-repeat="row in ReservesFundsOtherRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="reservesFundsAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="reservesFundsRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                                <tr data-group-row="reserves">
                                    <td class=" sub-item sub-item-btn">अनुदान (Grants/Subsidies) <button type="button" class="add" ng-click="grantsSubsidiesAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td><input type="text" placeholder="0.00" class="form-control numeric" /></td>
                                </tr>
                                <tr ng-repeat="row in grantsSubsidiesOtherRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="grantsSubsidiesAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="grantsSubsidiesRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                                <tr class="section-row">
                                    <th>3. लाभ-हानि खाता (Profit &amp; Loss Account)</th>
                                    <th> Total</th>
                                </tr>
                                <tr data-group-row="profit">
                                    <td class=" sub-item">लाभ-हानि आधिक्य (Profit &amp; Loss / Surplus A/c)</td>
                                    <td></td>
                                </tr>
                                <tr class="section-row">
                                    <th>4. निक्षेप / जमाएं (Deposits)</th>
                                    <th>Total</th>
                                </tr>
                                <tr data-group-row="deposits">
                                    <td class=" sub-item">सदस्यों की अमानत (Members' Deposits)</td>
                                    <td></td>
                                </tr>
                                <tr data-group-row="deposits">
                                    <td class=" sub-item sub-item-btn">सुरक्षा निक्षेप / जमानत राशि (Security Deposits / Earnest Money) <button type="button" class="add" ng-click="memberDepositAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td>Sum <b ng-if="memberDepositOtherRows.length>0"> : {{amt.memberDepsoitAmt}}</b></td>
                                </tr>
                                <tr ng-repeat="row in memberDepositOtherRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="memberDepositAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="memberDepositRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control" ng-model="row.TotalAmt" placeholder="Sum" ng-change="calculateMemberDepositAmount()" />
                                    </td>
                                </tr>
                               
                                <tr data-group-row="deposits">
                                    <td class=" sub-item sub-item-btn">अन्य जमायें (Other Deposits) <button type="button" class="add" ng-click="otherDepositAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr ng-repeat="row in otherDepositRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="otherDepositAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="otherDepositRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control numeric" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                              
                                <tr class="custom-row" data-group-row="deposits">
                                    <td class=" sub-item"></td>
                                    <td><div class="row-actions"></div></td>
                                </tr>
                                <tr class="section-row">
                                    <th>5. ऋण / उधार (Borrowings)</th>
                                    <th>Total</th>
                                </tr>
                                <tr data-group-row="borrowings">
                                    <td class=" sub-item sub-item-btn">केंद्रीय सहकारी बैंक / अन्य सहकारी बैंक / राष्ट्रीयकृत बैंक से सीसी ऋण (CC Loan from Central/Other Co-op Banks/Nationalized Banks) <button type="button" class="add" ng-click="borrowingsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr ng-repeat="row in borrowingsRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="borrowingsAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="borrowingsRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control numeric" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                                <tr data-group-row="borrowings">
                                    <td class=" sub-item sub-item-btn">केंद्रीय सहकारी बैंक / अन्य सहकारी बैंक / राष्ट्रीयकृत बैंक से अन्य ऋण (Other Loans from Central/Other Co-op Banks/Nationalized Banks) <button type="button" class="add" ng-click="borrowingsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr ng-repeat="row in borrowingsRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="borrowingsAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="borrowingsRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control numeric" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                                <tr data-group-row="borrowings">
                                    <td class=" sub-item sub-item-btn">राज्य सरकार से ऋण (Loan from State Government) <button type="button" class="add" ng-click="borrowingsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr ng-repeat="row in borrowingsRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="borrowingsAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="borrowingsRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control numeric" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                                <tr data-group-row="borrowings">
                                    <td class=" sub-item sub-item-btn">आईसीडीपी से ऋण (Loan from ICDP) <button type="button" class="add" ng-click="borrowingsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr ng-repeat="row in borrowingsRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="borrowingsAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="borrowingsRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control numeric" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                                <tr data-group-row="borrowings">
                                    <td class=" sub-item sub-item-btn">अन्य संस्थाओं से ऋण (Loans from Other Institutions) <button type="button" class="add" ng-click="borrowingsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr ng-repeat="row in borrowingsRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="borrowingsAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="borrowingsRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control numeric" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                                <tr class="section-row">
                                    <th>6. प्रावधान (Provisions)</th>
                                    <th>Total</th>
                                </tr>
                                <tr data-group-row="provisions">
                                    <td class=" sub-item">ऑडिट फीस प्रावधान (Provision for Audit Fees)</td>
                                    <td></td>
                                </tr>
                                <tr data-group-row="provisions">
                                    <td class=" sub-item">करों के लिए प्रावधान (Provision for Taxes)</td>
                                    <td></td>
                                </tr>
                                <tr data-group-row="provisions">
                                    <td class=" sub-item">ग्रेच्युटी के लिए प्रावधान (Provision for Gratuity)</td>
                                    <td></td>
                                </tr>
                                <tr data-group-row="provisions">
                                    <td class=" sub-item">पीएल / लीव इनकैशमेंट प्रावधान (PL/Leave Encashment Provision)</td>
                                    <td></td>
                                </tr>
                                <tr data-group-row="provisions">
                                    <td class=" sub-item">बट्टा खाता प्रावधान (Provision for Bad &amp; Doubtful Debts)</td>
                                    <td></td>
                                </tr>
                                <tr data-group-row="provisions">
                                    <td class=" sub-item">अवधिपार ब्याज प्रावधान (Overdue Interest Provision)</td>
                                    <td></td>
                                </tr>
                                <tr data-group-row="provisions">
                                    <td class=" sub-item sub-item-btn">अन्य प्रावधान (Other Provisions) <button type="button" class="add" ng-click="borrowingsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr ng-repeat="row in borrowingsRows track by $index">
                                    <td class="sub-item sub-item-btn">
                                        <input type="text" class="form-control" ng-model="row.OtherName" placeholder="Enter Other Details" />
                                        <div>
                                            @*<button type="button" class="add" ng-click="borrowingsAddRow()" title="Add Row"> + </button>*@
                                            <button type="button" class="remove" ng-click="borrowingsRemoveRow($index)" title="Remove Row"> <i class="fa fa-trash-o"></i>  </button>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" min="0" class="form-control numeric" ng-model="row.TotalAmt" placeholder="Sum" />
                                    </td>
                                </tr>
                                <tr class="section-row">
                                    <th>7. अन्य दायित्व एवं लेनदार (Other Liabilities &amp; Sundry Creditors)</th>
                                    <th>Total</th>
                                </tr>
                                <tr>
                                    <td class=" sub-item sub-item-btn">व्यापारिक लेनदार - सप्लायर (Sundry Creditors for Goods) <button type="button" class="add" ng-click="borrowingsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td class=" sub-item sub-item-btn">व्यक्तिगत लेनदार (Personal Creditors) <button type="button" class="add" ng-click="borrowingsAddRow()"><i class="fa fa-plus"></i></button></td>
                                    <td></td>
                                </tr>
                                <tr>
