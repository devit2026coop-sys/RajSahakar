<script src="~/Scripts/AngularFramework/AuditorCurrentYearForm.js"></script>
<style>
    table.devtable tbody tr th.row-name {
        color: #fff !important;
        background-color: #1899a0;
    }

    table.devtable thead tr th {
        background: #1899a0;
        text-align: center;
    }

    table.devtable tfoot tr th, table.devtable tfoot td {
        background: #1899a0;
    }

    table.devtable tbody td.drkBg, table.devtable thead th.drkBg2 {
        background: #79c8cd;
    }

    table.devtable thead th.lgtBg {
        background: #fff;
        color: #000;
    }

    table.devtable tbody td input, table.devtable tfoot td input {
        text-align: right;
    }

    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

        .custom-tbls-tabs > li {
            margin-bottom: -2px;
        }

            .custom-tbls-tabs > li > button {
                color: #444;
                font-size: 16px;
                font-weight: bold;
                border: 1px solid transparent !important;
                border-bottom: 2px solid transparent !important;
                margin-right: 0;
                background: transparent;
                transition: all 0.3s ease;
                border-radius: 4px 4px 0 0;
                padding: 8px 20px;
                line-height: 24px;
                outline: none;
            }

                /* Hover */
                .custom-tbls-tabs > li > button:hover {
                    background: #e3e3e3;
                    color: #168f98;
                    border: 1px solid transparent !important;
                }

            /* Active Tab */
            .custom-tbls-tabs > li.active > button,
            .custom-tbls-tabs > li.active > button:hover,
            .custom-tbls-tabs > li.active > button:focus {
                color: #168f98;
                background: #fff;
                border: 1px solid #9f9f9f !important;
                border-bottom: 2px solid #fff !important;
                font-weight: 700;
            }
</style>


<div ng-app="ApplicationAuditorCurrentYearFormModule" ng-controller="CooperativeAuditorCurrentYearFormCont" ng-cloak="">
    @*--1st-table--*@
    <div class="col-md-12">
        <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">MPR Current Audit Year 2025-26</h4>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#">  {{translation.Home}}</a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.New}} </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> Auditor Current Year Form</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-12">
        <div class="citizen-dash-head">

            <ul class="nav nav-tabs custom-tbls-tabs" role="tablist" style="margin-bottom:15px;">
                <li class="active">
                    <button class="btn btn-light">Current Year</button>
                </li>
                <li>
                    <button class="btn btn-light" ng-click="GotoBackLog()">Back Log</button>
                </li>
                <li>
                    <button class="btn btn-primary" ng-click="GotoFees()">Audit Fees</button>
                </li>
            </ul>

            <div class="form-group pull-left">
                <label>Select Date</label>
                <input type="date" class="form-control" ng-model="SelectedDate" ng-change="LoadAuditMprForm()" />
            </div>
            <table class="table table-bordered table-striped devtable">
                <thead>
                    <tr class="year-heading">
                        <th colspan="14"> <b> चालू वर्ष  {{ PreviousMonth }} </b>  <span>({{ FinancialYearName }})</span></th>
                        <th style="text-align: left; min-width: 220px;"><b>District : </b>  <span>{{ DISTRICT_ENG }} </span></th>
                    </tr>
                    <tr>
                        <th rowspan="3" class="type-head">प्रकार</th>
                        <th rowspan="3" class="total-head lgtBg">कुल समितियां</th>
                        <th class="drkBg2" colspan="4">कुल आवंटित समितियां</th>
                        <th class="drkBg2" rowspan="3">प्रस्ताव आवंटन<br>से शेष</th>
                        <th class="lgtBg" colspan="4">गत माह तक ऑडिटेड</th>
                        <th class="drkBg2" colspan="4">माह में ऑडिटेड</th>
                    </tr>
                    <tr>
                        <th class="drkBg2" colspan="2">प्रस्ताव</th>
                        <th class="drkBg2" colspan="2">आवंटन</th>
                        <th class="lgtBg" colspan="2">प्रस्ताव</th>
                        <th class="lgtBg" colspan="2">आवंटन</th>
                        <th class="drkBg2" colspan="2">प्रस्ताव</th>
                        <th class="drkBg2" colspan="2">आवंटन</th>
                    </tr>
                    <tr>
                        <th class="drkBg2">विभाग</th>
                        <th class="drkBg2">चार्टर्ड<br>अकाउंटेंट</th>
                        <th class="drkBg2">विभाग</th>
                        <th class="drkBg2">चार्टर्ड<br>अकाउंटेंट</th>
                        <th class="lgtBg">विभाग</th>
                        <th class="lgtBg">चार्टर्ड<br>अकाउंटेंट</th>
                        <th class="lgtBg">विभाग</th>
                        <th class="lgtBg">चार्टर्ड<br>अकाउंटेंट</th>
                        <th class="drkBg2">विभाग</th>
                        <th class="drkBg2">चार्टर्ड<br>अकाउंटेंट</th>
                        <th class="drkBg2">विभाग</th>
                        <th class="drkBg2">चार्टर्ड<br>अकाउंटेंट</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in auditMprList track by item.CommitteeTypeId">
                        <th scope="row" class="row-name">{{item.CommitteeTypeName_Hin}}</th>
                        <td class="total-count">
                            <input class="form-control" type="number" min="0"
                                   ng-model="item.TotalCommitteesCurrentYear" ng-change="calculateProposalAllocationRemaining(item, 'TotalCommitteesCurrentYear')" />
                        </td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.ProposalDepartment" ng-change="calculateProposalAllocationRemaining(item, 'ProposalDepartment')" /></td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.ProposalCA" ng-change="calculateProposalAllocationRemaining(item, 'ProposalCA')" /></td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.AllocationDepartment" ng-change="calculateProposalAllocationRemaining(item, 'AllocationDepartment')" /></td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.AllocationCA" ng-change="calculateProposalAllocationRemaining(item, 'AllocationCA')" /></td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.ProposalAllocationRemaining" readonly /></td>
                        <td><input class="form-control" type="number" min="0" ng-model="item.PreviousAuditedProposalDepartment" ng-change="ValidateProposalDepartment(item, 'PreviousAuditedProposalDepartment')" /></td>
                        <td><input class="form-control" type="number" min="0" ng-model="item.PreviousAuditedProposalCA" ng-change="ValidateProposalCA(item, 'PreviousAuditedProposalCA')" /></td>
                        <td><input class="form-control" type="number" min="0" ng-model="item.PreviousAuditedAllocationDepartment" ng-change="ValidateAllocationDepartment(item, 'PreviousAuditedAllocationDepartment')" /></td>
                        <td><input class="form-control" type="number" min="0" ng-model="item.PreviousAuditedAllocationCA" ng-change="ValidateAllocationCA(item, 'PreviousAuditedAllocationCA')" /></td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.CurrentAuditedProposalDepartment" ng-change="ValidateProposalDepartment(item, 'CurrentAuditedProposalDepartment')" /></td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.CurrentAuditedProposalCA" ng-change="ValidateProposalCA(item, 'CurrentAuditedProposalCA')" /></td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.CurrentAuditedAllocationDepartment" ng-change="ValidateAllocationDepartment(item, 'CurrentAuditedAllocationDepartment')" /></td>
                        <td class="drkBg"><input class="form-control" type="number" min="0" ng-model="item.CurrentAuditedAllocationCA" ng-change="ValidateAllocationCA(item, 'CurrentAuditedAllocationCA')" /></td>
                    </tr>
                    <tr ng-if="!auditMprList || auditMprList.length === 0">
                        <td colspan="15" class="text-center">No committee records found.</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <th style="color:#fff;" scope="row">कुल योग</th>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('TotalCommitteesCurrentYear')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('ProposalDepartment')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('ProposalCA')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('AllocationDepartment')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('AllocationCA')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('ProposalAllocationRemaining')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('PreviousAuditedProposalDepartment')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('PreviousAuditedProposalCA')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('PreviousAuditedAllocationDepartment')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('PreviousAuditedAllocationCA')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('CurrentAuditedProposalDepartment')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('CurrentAuditedProposalCA')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('CurrentAuditedAllocationDepartment')" /></td>
                        <td><input class="form-control" type="number" readonly ng-value="getColumnTotal('CurrentAuditedAllocationCA')" /></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button type="button" class="btn btn-primary dev-btn text-center" ng-click="SaveAuditMprForm()">Submit & Next</button>
            <button type="button" class="btn btn-primary dev-btn text-center" ng-click="ClearAuditMprForm()">Clear</button>
        </div>
    </div>

