                        <td>
                            <a ng-if="Item.CertificateName!='' && Item.CertificateName!=null" href="~/Content/AuditReport/{{Item.CertificateName}}" target="_blank"><i class="fa fa-download"></i></a>
                        </td>
                        <td>
                            <a title="Edit" ng-click="AuditorEmpView(Item.AuditEmpanelledId)"><i class="fa fa-edit editicon-edit"></i></a>
                            @*<a title="VIEW" ng-click="AuditorEmpView(Item.AuditEmpanelledId)"><i class="fa fa-eye"></i></a>*@
                        </td>
                    </tr>
                    <tr>
                        <td colspan="13">
                            <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                    Total Records: {{DataPagingDetails.TotalRecords}}
                                </div>
                                <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                    <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                    <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetAuditorEmpanelledList)" style="cursor: pointer;">
                                        <span>«First</span>
                                    </li>
                                    <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetAuditorEmpanelledList)" style="cursor:pointer;">
                                        <span>« Previous</span>
                                    </li>
                                    <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetAuditorEmpanelledList)"><span>{{n}}</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetAuditorEmpanelledList)" style="cursor:pointer;">
                                        <span>Next »</span>
                                    </li>
                                    <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetAuditorEmpanelledList)" style="cursor:pointer;">
                                        <span>Last »</span>
                                    </li>
                                </ul>
                            </div>
                            <input type="button" id="btnExport" class="btn btn-primary dev-btn" style="" ng-click="ExportData()" value="Export" />
                            <input type="button" id="btnEsign" class="btn btn-primary dev-btn" style="" ng-click="EsignData()" value="Generate Letter" />
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
    <div style="display:none">
        @Html.Partial("_AddressControl", "MemberAdd")
    </div>

    @Html.Partial("_AadhaarValidation")
</div>


<input type="hidden" name="hdlang" id="hdlang" value="hi-IN" />

<script src="~/Scripts/google_hindi/google_transapi.js"></script>
<script type="text/javascript">
    google.load("elements", "1", {
        packages: "transliteration"
    });

    function onLoad() {
        var content = document.getElementById('content');
        if (document.getElementById('hdlang').value == "hi-IN") {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: true
            };
        }
        else {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: false
            }
        }
        var ids = ["EmpanelledRemark"];
        var control = new google.elements.transliteration.TransliterationControl(options);
        control.makeTransliteratable(ids);
    }
    google.setOnLoadCallback(onLoad);

</script>


<script src="~/Scripts/google_hindi/google_transliteration.js"></script>


