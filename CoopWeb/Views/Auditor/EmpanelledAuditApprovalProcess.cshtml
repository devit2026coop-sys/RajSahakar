<script type="text/javascript">
    var modal = document.getElementById('myModal');
    function printDiv() {
        var printContents = document.getElementById('divprintDetails').innerHTML;
        var originalContents = document.body.innerHTML;

        document.body.innerHTML = printContents;

        window.print();

        document.body.innerHTML = originalContents;
    }
    // When the user clicks anywhere outside of the modal, close it
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }

    function ValidateAlphaNumericAndSlash(evt) {
        // alert(evt.keyCode);
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        alert(keyCode);
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32) {
            //    alert("not cahr");
            if ((keyCode >= 48 && keyCode <= 57)) {   //   || keyCode == 47   for slash
                //     alert(" num or slash");
                return true;
            }
            else {
                //    alert("not cahr and num");
                return false;
            }
        } else {
            //    alert("cahr");
            return true;
        }
    };
</script>
