<script>
    document.addEventListener('input', function (e) {

        if (e.target.classList.contains('numeric')) {

            // Only numbers allow and maximum 2 digits
            e.target.value = e.target.value.replace(/[^0-9]/g, '').substring(0, 2);

        }

    });
</script>

