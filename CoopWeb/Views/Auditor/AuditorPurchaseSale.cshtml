<style>

    table.devtable thead tr th {
        background: #006159;
        text-align: center;
    }



    table.devtable tbody .add {
        display: inline-flex;
        border-radius: 50%;
        background-color: #198754;
        color: #fff;
        cursor: pointer;
        transition: background 0.2s ease;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
    }

        table.devtable tbody .add i, table.devtable tbody .remove i {
            color: white;
            font-size: 14px;
            font-weight: normal;
        }

    .remove {
        display: inline-flex;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
        background-color: #dc3545;
    }




    .section-row th {
        background: #e7f2f1;
        color: #075b55;
        font-weight: 800 !important;
        text-align: left;
        padding: 11px 14px;
        border-top: 2px solid #b5d7d3;
    }

    .total-row th, .total-row td {
        background: #006159;
        color: #fff;
        font-weight: 800;
        padding: 13px 12px;
    }

    .sub-item {
        padding-left: 34px !important;
    }

    .sub-item-btn {
        display: flex;
        justify-content: space-between;
        width: 300px;
    }

    .sub-item.sub-item-btn div {
        display: flex;
        gap: 10px;
    }

    .sub-item.sub-item-btn input {
        max-width: 300px;
    }

    .form-control numeric.numeric {
        text-align: right;
    }


    .top-tbs-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

        .custom-tbls-tabs > li {
            margin-bottom: -2px;
        }

            .custom-tbls-tabs > li > a {
                color: #444;
                font-weight: 600;
                border: 1px solid transparent !important;
                border-bottom: 2px solid transparent !important;
                margin-right: 0;
                background: transparent;
                transition: all 0.3s ease;
                border-radius: 4px 4px 0 0;
                padding: 8px 20px;
                line-height: 24px;
                outline: none;
            }

                /* Hover */
                .custom-tbls-tabs > li > a:hover {
                    background: #e3e3e3;
                    color: #168f98;
                    border: 1px solid transparent !important;
                }

            /* Active Tab */
            .custom-tbls-tabs > li.active > a,
            .custom-tbls-tabs > li.active > a:hover,
            .custom-tbls-tabs > li.active > a:focus {
                color: #168f98;
                background: #fff;
                border: 1px solid #9f9f9f !important;
                border-bottom: 2px solid #fff !important;
                font-weight: 700;
            }

   .sub-item-btn input {
        max-width: 200px;
    }

    .tab-content.custom-tbls-tab-content, .tab-content.custom-tbls-tab-content > .active {
        padding: 0px;
    }

</style>
