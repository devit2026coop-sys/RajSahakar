<script src="~/Scripts/AngularFramework/AuditorPurchaseSale.js"></script>
<style>

    table.devtable thead tr th {
        background: #006159;
        text-align: center;
    }

    table.devtable tbody .add {
        display: inline-flex;
        border-radius: 50%;
        background-color: #198754;
        color: #fff;
        cursor: pointer;
        transition: background 0.2s ease;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
    }

        table.devtable tbody .add i, table.devtable tbody .remove i {
            color: white;
            font-size: 14px;
            font-weight: normal;
        }

    .remove {
        display: inline-flex;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
        background-color: #dc3545;
    }

    .section-row th {
        background: #e7f2f1;
        color: #075b55;
        font-weight: 800 !important;
        text-align: left;
        padding: 11px 14px;
        border-top: 2px solid #b5d7d3;
    }

    .total-row th, .total-row td {
        background: #006159;
        color: #fff;
        font-weight: 800;
        padding: 13px 12px;
    }

    .sub-item {
        padding-left: 34px !important;
    }

    .sub-item-btn {
        display: flex;
        justify-content: space-between;
        width: 300px;
    }

    .sub-item.sub-item-btn div {
        display: flex;
        gap: 10px;
    }

    .sub-item.sub-item-btn input {
        max-width: 300px;
    }

    .form-control numeric.numeric {
        text-align: right;
    }

    .top-tbs-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

        .custom-tbls-tabs > li {
            margin-bottom: -2px;
        }

            .custom-tbls-tabs > li > a {
                color: #444;
                font-weight: 600;
                border: 1px solid transparent !important;
                border-bottom: 2px solid transparent !important;
                margin-right: 0;
                background: transparent;
                transition: all 0.3s ease;
                border-radius: 4px 4px 0 0;
                padding: 8px 20px;
                line-height: 24px;
                outline: none;
            }

                /* Hover */
                .custom-tbls-tabs > li > a:hover {
                    background: #e3e3e3;
                    color: #168f98;
                    border: 1px solid transparent !important;
                }

            /* Active Tab */
            .custom-tbls-tabs > li.active > a,
            .custom-tbls-tabs > li.active > a:hover,
            .custom-tbls-tabs > li.active > a:focus {
                color: #168f98;
                background: #fff;
                border: 1px solid #9f9f9f !important;
                border-bottom: 2px solid #fff !important;
                font-weight: 700;
            }

    .sub-item-btn input {
        max-width: 200px;
    }

    .tab-content.custom-tbls-tab-content, .tab-content.custom-tbls-tab-content > .active {
        padding: 0px;
    }
</style>
<div ng-app="auditorPurchaseSaleMod" ng-controller="auditorPurchaseSaleCtrl" ng-cloak="">
    <div class="page">

        <div class="col-md-12">
            <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">क्रय विक्रय सहकारी समिति लि. (KVSS), राजस्थान</h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> Auditor Purchase Sale </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">

                <div style="display: flex; gap: 10px; justify-content: end; margin-bottom: 15px;">

                    <div>
                        <strong>Name of KVSS:</strong>
                        <span style="font-weight:bold; color:#1899a0;">
                            <label>@Session["AuditKVSSName"]</label>
                        </span>
                    </div>

                    <div>
                        <strong>Financial Year:</strong>
                        <span style="font-weight:bold; color:#1899a0;">
                            <label>@Session["FinancialYear"]</label>
                        </span>
                    </div>
                     
                    @*<label for="ddlGSS"> Name of KVSS <span style="color:red;">*</span> </label>
                    <select class="form-control" style="width:20%;" id="ddlGSS" ng-model="KVSSSocietyID" ng-init="KVSSSocietyID ='0'" ng-change="OnSocietyChange()">
                        <option value="0" selected="selected" disabled>--Select--</option>
                        <option ng-repeat="item in SocietyList | filter:{SocietyName: SocietySearch}" value="{{item.SocietyID}}">
                            {{_language =='en-us' ?  item.SocietyName : item.SocietyName}}
                        </option>
                    </select>*@
                    @*<button class="btn btn-primary dev-btn text-center" ng-click="NextStep()"> Next</button>*@
                    @*<button class="btn btn-primary dev-btn text-center">Submit</button>*@
                    <button type="button" class="btn btn-primary dev-btn text-center" ng-click="SaveAuditSPData()">Submit</button>
                    @*<button class="btn btn-primary dev-btn text-center">Clear</button>*@
                    <button class="btn btn-primary dev-btn text-center" ng-click="GoBack()">Back </button>
                </div>

                <table class="table table-bordered table-striped devtable">
                    <thead>
                        <tr>
                            <th rowspan="2">वस्तु का नाम (Item Name)</th>
                            <th rowspan="2">इकाई (Unit)</th>

                            <th colspan="3">प्रारंभिक शेष (Opening)</th>
                            <th colspan="3">प्राप्त / क्रय (Receipts)</th>
                            <th colspan="3">बिक्री / जावक (Sales / Issued)</th>
                            <th colspan="3">अंतिम शेष (Closing)</th>
                        </tr>
                        <tr>
                            <th>मात्रा (Qty)</th>
                            <th>दर (Rate)</th>
                            <th>राशि (Amount)</th>
                            <th>मात्रा (Qty)</th>
                            <th>दर (Rate)</th>
                            <th>राशि (Amount)</th>
                            <th>मात्रा (Qty)</th>
                            <th>दर (Rate)</th>
                            <th>राशि (Amount)</th>
                            <th>मात्रा (Qty)</th>
                            <th>दर (Rate)</th>
                            <th>राशि (Amount)</th>
                        </tr>
                    </thead>
                    <tbody ng-repeat="parent in AuditSPGroups track by parent.ItemId">

                        <!-- Parent Item -->
                        <tr class="section-row">
                            <th>{{parent.ItemName_Hi}}</th>
                            <td>
                                <select class="form-control"
                                        ng-model="parent.ItemUnit">
                                    <option value="">-Select-</option>
                                    <option value="MT">MT</option>
                                    <option value="Quintal">Quintal</option>
                                    <option value="Kg">Kg</option>
                                    <option value="Liter">Liter</option>
                                    <option value="Bag">Bag</option>
                                    <option value="Number">Number</option>
                                </select>
                            </td>

                            <td><input class="form-control numeric" type="number" ng-model="parent.OpeningQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="parent.OpeningRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{parent.OpeningAmount | number:2}}</td>

                            <td><input class="form-control numeric" type="number" ng-model="parent.ReceiptQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="parent.ReceiptRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{parent.ReceiptAmount | number:2}}</td>

                            <td><input class="form-control numeric" type="number" ng-model="parent.SalesQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="parent.SalesRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{parent.SalesAmount | number:2}}</td>

                            <td><input class="form-control numeric" type="number" ng-model="parent.ClosingQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="parent.ClosingRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{parent.ClosingAmount | number:2}}</td>
                        </tr>

                        <!-- Child Items -->
                        <tr ng-repeat-start="item in parent.ChildItems track by item.ItemId">

                            <td class="item sub-item-btn">
                                {{item.ItemName_Hi}}

                                <button type="button" class="add"
                                        ng-click="addRow(item)">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </td>
                            <td>
                                <select class="form-control"
                                        ng-model="item.ItemUnit">
                                    <option value="">-Select-</option>
                                    <option value="MT">MT</option>
                                    <option value="Quintal">Quintal</option>
                                    <option value="Kg">Kg</option>
                                    <option value="Liter">Liter</option>
                                    <option value="Bag">Bag</option>
                                    <option value="Number">Number</option>
                                </select>
                            </td>

                            <td><input class="form-control numeric" type="number" ng-model="item.OpeningQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="item.OpeningRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{item.OpeningAmount | number:2}}</td>

                            <td><input class="form-control numeric" type="number" ng-model="item.ReceiptQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="item.ReceiptRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{item.ReceiptAmount | number:2}}</td>

                            <td><input class="form-control numeric" type="number" ng-model="item.SalesQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="item.SalesRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{item.SalesAmount | number:2}}</td>

                            <td><input class="form-control numeric" type="number" ng-model="item.ClosingQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="item.ClosingRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{item.ClosingAmount | number:2}}</td>
                        </tr>

                        <!-- Additional Dynamic Rows -->
                        <tr ng-repeat="row in item.AdditionalRows track by $index">

                            <td class="item sub-item-btn">

                                <input type="text"
                                       class="form-control"
                                       ng-model="row.ItemName_Hi"
                                       placeholder="Enter Item Name" />

                                <button type="button" class="remove"
                                        ng-click="removeRow(item, $index)"
                                        title="Delete">
                                    <i class="fa fa-trash"></i>
                                </button>

                            </td>
                            <td>
                                <select class="form-control"
                                        ng-model="row.ItemUnit">
                                    <option value="">-Select-</option>
                                    <option value="MT">MT</option>
                                    <option value="Quintal">Quintal</option>
                                    <option value="Kg">Kg</option>
                                    <option value="Liter">Liter</option>
                                    <option value="Bag">Bag</option>
                                    <option value="Number">Number</option>
                                </select>
                            </td>

                            <!-- Opening -->
                            <td><input class="form-control numeric" type="number" ng-model="row.OpeningQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="row.OpeningRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{row.OpeningAmount | number:2}}</td>

                            <!-- Receipts -->
                            <td><input class="form-control numeric" type="number" ng-model="row.ReceiptQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="row.ReceiptRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{row.ReceiptAmount | number:2}}</td>

                            <!-- Sales -->
                            <td><input class="form-control numeric" type="number" ng-model="row.SalesQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="row.SalesRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{row.SalesAmount | number:2}}</td>

                            <!-- Closing -->
                            <td><input class="form-control numeric" type="number" ng-model="row.ClosingQty" style="text-align:right;" /></td>
                            <td><input class="form-control" type="number" ng-model="row.ClosingRate" style="text-align:right;" /></td>
                            <td style="text-align:right;">{{row.ClosingAmount | number:2}}</td>
                        </tr>

                        <tr ng-repeat-end style="display:none;"></tr>

                    </tbody>

                    <tbody ng-if="!AuditSPGroups || AuditSPGroups.length == 0">
                        <tr>
                            <td colspan="13" class="text-center">No Data Found</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <th style="color: #fff;">कुल योग (Total)</th>
                            <td></td>

                            <td style="text-align:right;">{{getColumnTotal('OpeningQty') | number:2}}</td>
                            <td style="text-align:right;">{{getColumnTotal('OpeningRate') | number:2}}</td>
                            <td style="text-align:right;">{{getColumnTotal('OpeningAmount') | number:2}}</td>

                            <td style="text-align:right;">{{getColumnTotal('ReceiptQty') | number:2}}</td>
                            <td style="text-align:right;">{{getColumnTotal('ReceiptRate') | number:2}}</td>
                            <td style="text-align:right;">{{getColumnTotal('ReceiptAmount') | number:2}}</td>

                            <td style="text-align:right;">{{getColumnTotal('SalesQty') | number:2}}</td>
                            <td style="text-align:right;">{{getColumnTotal('SalesRate') | number:2}}</td>
                            <td style="text-align:right;">{{getColumnTotal('SalesAmount') | number:2}}</td>

                            <td style="text-align:right;">{{getColumnTotal('ClosingQty') | number:2}}</td>
                            <td style="text-align:right;">{{getColumnTotal('ClosingRate') | number:2}}</td>
                            <td style="text-align:right;">{{getColumnTotal('ClosingAmount') | number:2}}</td>
                        </tr>
                    </tfoot>
                </table>

                <div style="display: flex; gap: 10px; justify-content: center;">
                    @*<button class="btn btn-primary dev-btn text-center" ng-click="NextStep()">Next</button>*@
                    @*<button class="btn btn-primary dev-btn text-center">Save as Draft</button>*@
                    <button type="button" class="btn btn-primary dev-btn text-center" ng-click="SaveAuditSPData()">Submit</button>
                    @*<button class="btn btn-primary dev-btn text-center">Clear</button>*@
                    <button class="btn btn-primary dev-btn text-center" ng-click="GoBack()">Back </button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('input', function (e) {

        if (e.target.classList.contains('numeric')) {

            // Only numbers allow and maximum 2 digits
            e.target.value = e.target.value.replace(/[^0-9]/g, '').substring(0, 2);

        }

    });
</script>
