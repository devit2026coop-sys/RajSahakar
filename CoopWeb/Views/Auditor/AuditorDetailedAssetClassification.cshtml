<script src="~/Scripts/AngularFramework/AuditorDetailedAssetClassification.js?v=@DateTime.Now.Ticks"></script>

<style>
    table.devtable {
        min-width: 1600px;
    }

    table.devtable thead tr th {
        background: #006159;
        color: #fff;
        text-align: center;
        vertical-align: middle;
    }

    table.devtable tbody td {
        vertical-align: middle;
    }

    table.devtable tbody .add,
    table.devtable tbody .remove {
        display: inline-flex;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0;
    }

    table.devtable tbody .add {
        background-color: #198754;
    }

    table.devtable tbody .remove {
        background-color: #dc3545;
    }

    .section-row th {
        background: #e7f2f1;
        color: #075b55;
        font-weight: 800;
        text-align: left;
        padding: 11px 14px;
    }

    .total-row th, .total-row td {
        background: #006159;
        color: #fff;
        font-weight: 800;
        padding: 13px 12px;
    }

    .form-control.numeric {
        text-align: right;
        min-width: 100px;
    }

    .asset-input {
        min-width: 125px;
    }

    .top-tbs-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

    .custom-tbls-tabs > li {
        margin-bottom: -2px;
    }

    .custom-tbls-tabs > li > a {
        color: #444;
        font-weight: 600;
        border: 1px solid transparent !important;
        border-bottom: 2px solid transparent !important;
        margin-right: 0;
        background: transparent;
        border-radius: 4px 4px 0 0;
        padding: 8px 20px;
        line-height: 24px;
        cursor: pointer;
    }

    .custom-tbls-tabs > li.active > a,
    .custom-tbls-tabs > li.active > a:hover {
        color: #168f98;
        background: #fff;
        border: 1px solid #9f9f9f !important;
        border-bottom: 2px solid #fff !important;
        font-weight: 700;
    }

    .tab-content.custom-tbls-tab-content {
        padding: 0;
    }

    .asset-section-title {
        background: #e7f2f1;
        color: #075b55;
        font-weight: bold;
    }

    .asset-table-wrapper {
        overflow-x: auto;
        width: 100%;
    }

    .asset-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 20px;
    }
</style>

<div ng-app="assetClassificationMod"
     ng-controller="assetClassificationCtrl"
     ng-init="KVSSSocietyID = @Html.Raw(Json.Encode(ViewBag.KVSSId));
              FinancialYear = @Html.Raw(Json.Encode(ViewBag.FinancialYear))"
     ng-cloak>

    <div class="page">
        <div class="col-md-12">

            <h4 class="citizen-dash-head" style="font-weight:bold;">
                KRAY VIKRAY SAHAKARI SAMITI (KVSS) - क्रय-विक्रय सहकारी समिति
            </h4>

            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li>
                        <i class="fa fa-home"></i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"></i>
                    </li>
                    <li>
                        <span>{{translation.New}}</span>
                        <i class="fa fa-angle-right"></i>
                        <span>Detailed Asset Classification</span>
                    </li>
                </ul>
            </div>

            <div class="citizen-dash-head">

                <div class="top-tbs-btn">

                    <ul class="nav nav-tabs custom-tbls-tabs">
                        <li ng-class="{active: SelectedViewTab == 1}">
                            <a ng-click="SelectViewTab(1)">
                                Detailed Classification
                            </a>
                        </li>

                        <li ng-class="{active: SelectedViewTab == 2}">
                            <a ng-click="SelectViewTab(2)">
                                Classification Summary
                            </a>
                        </li>
                    </ul>

                    <div>
                        <button class="btn btn-primary dev-btn"
                                ng-click="SaveAndNext()">
                            Save & Next
                        </button>

                        <button class="btn btn-primary dev-btn"
                                ng-click="SaveAsDraft()">
                            Save as Draft
                        </button>

                        <button class="btn btn-primary dev-btn"
                                ng-click="BackTo()">
                            Back
                        </button>
                    </div>
                </div>

                <!-- TAB 1: DETAILED CLASSIFICATION -->
                <div class="tab-content custom-tbls-tab-content"
                     ng-show="SelectedViewTab == 1">

                    <h4>
                        Detailed Asset Classification & Provisioning
                        (Including Loans, Advances & Other Assets)
                        As on 31st March {{FinancialYearEnd}}
                    </h4>

                    <div class="asset-table-wrapper">

                        <table class="table table-bordered table-striped devtable">

                            <thead>
                                <tr>
                                    <th rowspan="2">S.No.<br />(क्र.सं.)</th>

                                    <th rowspan="2">
                                        Name of Borrower / Party / Asset Head
                                    </th>

                                    <th rowspan="2">Asset Type</th>

                                    <th rowspan="2">
                                        Nature of Facility<br />
                                        (सुविधा की प्रकृति)
                                    </th>

                                    <th rowspan="2">
                                        Date of Advance / Outstanding
                                    </th>

                                    <th colspan="2">
                                        Total Outstanding (₹)
                                    </th>

                                    <th rowspan="2">
                                        Total Overdue (₹)
                                    </th>

                                    <th rowspan="2">
                                        Period of Outstanding (Days)
                                    </th>

                                    <th colspan="6">
                                        Classification of Outstanding Amount
                                    </th>
                                </tr>

                                <tr>
                                    <th>Principal<br />(मूल राशि)</th>
                                    <th>Interest<br />(ब्याज)</th>  
                                    <th>Standard</th>
                                    <th>Sub-Standard</th>
                                    <th>Doubtful-I</th>
                                    <th>Doubtful-II</th>
                                    <th>Doubtful-III</th>
                                    <th>Loss Asset</th>
                                </tr>
                            </thead>

                            <tbody ng-repeat="parent in GetParentHeadersByTab(SelectedTabId) track by parent.HeaderId">

                                <!-- Main section heading -->
                                <tr class="section-row">
                                    <th>{{$index + 1}}</th>
                                    <th colspan="14">
                                        {{parent.HeaderNameEnglish}}
                                    </th>
                                </tr>

                                <!-- Dynamic leaf headings -->
                                <tr ng-repeat="row in GetLeafHeadersByParent(parent.HeaderId) track by row.HeaderId">

                                    <td>{{$parent.$index + 1}}.{{$index + 1}}</td>

                                    <td>
                                        {{row.HeaderNameEnglish}}
                                    </td>

                                    <td>
                                        {{GetAssetType(parent)}}
                                    </td>

                                    <td>
                                        <input type="text"
                                               class="form-control asset-input"
                                               ng-model="row.AssetDetail.NatureOfFacility"
                                               maxlength="250"
                                               placeholder="Nature of Facility" />
                                    </td>

                                    <td>
                                        <input type="date"
                                               class="form-control asset-input"
                                               ng-model="row.AssetDetail.DateOfAdvance" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.Principal"
                                               ng-change="CalculateRow(row)" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.Interest"
                                               ng-change="CalculateRow(row)" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.TotalOverdue" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="1"
                                               ng-model="row.AssetDetail.PeriodOfOutstanding" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.StandardAmount" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.SubStandardAmount" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.DoubtfulIAmount" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.DoubtfulIIAmount" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.DoubtfulIIIAmount" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control numeric"
                                               min="0"
                                               step="0.01"
                                               ng-model="row.AssetDetail.LossAssetAmount" />
                                    </td>
                                </tr>

                                <tr ng-if="GetLeafHeadersByParent(parent.HeaderId).length == 0">
                                    <td colspan="15" class="text-center">
                                        No detail headings found.
                                    </td>
                                </tr>

                            </tbody>

                            <tfoot>
                                <tr class="total-row">
                                    <th colspan="5" style="text-align:center;">
                                        TOTAL (कुल योग)
                                    </th>

                                    <th>{{GetGrandTotal('Principal') | number:2}}</th>
                                    <th>{{GetGrandTotal('Interest') | number:2}}</th>
                                    <th>{{GetGrandTotal('TotalOverdue') | number:2}}</th>
                                    <th></th>

                                    <th>{{GetGrandTotal('StandardAmount') | number:2}}</th>
                                    <th>{{GetGrandTotal('SubStandardAmount') | number:2}}</th>
                                    <th>{{GetGrandTotal('DoubtfulIAmount') | number:2}}</th>
                                    <th>{{GetGrandTotal('DoubtfulIIAmount') | number:2}}</th>
                                    <th>{{GetGrandTotal('DoubtfulIIIAmount') | number:2}}</th>
                                    <th>{{GetGrandTotal('LossAssetAmount') | number:2}}</th>
                                </tr>
                            </tfoot>

                        </table>
                    </div>
                </div>

                <!-- TAB 2: CLASSIFICATION SUMMARY -->
                <div class="tab-content custom-tbls-tab-content"
                     ng-show="SelectedViewTab == 2">

                    <h4>Abstract of Asset Classification & Provisioning</h4>

                    <div class="asset-table-wrapper">

                        <table class="table table-bordered table-striped devtable">

                            <thead>
                                <tr>
                                    <th>S.No.</th>
                                    <th>Category of Asset</th>
                                    <th>No. of Accounts</th>
                                    <th>Total Outstanding (₹)</th>
                                    <th>Provision Rate %</th>
                                    <th>Provision Required (₹)</th>
                                    <th>Old Provision (₹)</th>
                                    <th>Required Provision in Year (₹)</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in SummaryList">
                                    <td>{{$index + 1}}</td>
                                    <td>{{item.Category}}</td>
                                    <td>{{item.AccountCount}}</td>
                                    <td class="text-right">
                                        {{item.Outstanding | number:2}}
                                    </td>
                                    <td>{{item.Rate}}%</td>
                                    <td class="text-right">
                                        {{item.ProvisionRequired | number:2}}
                                    </td>
                                    <td class="text-right">
                                        {{item.OldProvision | number:2}}
                                    </td>
                                    <td class="text-right">
                                        {{item.RequiredProvision | number:2}}
                                    </td>
                                </tr>
                            </tbody>

                            <tfoot>
                                <tr class="total-row">
                                    <th colspan="2">GRAND TOTAL</th>
                                    <th>{{GetSummaryTotal('AccountCount')}}</th>
                                    <th>{{GetSummaryTotal('Outstanding') | number:2}}</th>
                                    <th></th>
                                    <th>{{GetSummaryTotal('ProvisionRequired') | number:2}}</th>
                                    <th>{{GetSummaryTotal('OldProvision') | number:2}}</th>
                                    <th>{{GetSummaryTotal('RequiredProvision') | number:2}}</th>
                                </tr>

                                <tr class="total-row">
                                    <th colspan="2">OD Interest Provision</th>
                                    <th></th>
                                    <th>{{GetGrandTotal('TotalOverdue') | number:2}}</th>
                                    <th>100%</th>
                                    <th>{{GetGrandTotal('TotalOverdue') | number:2}}</th>
                                    <th>0.00</th>
                                    <th>{{GetGrandTotal('TotalOverdue') | number:2}}</th>
                                </tr>
                            </tfoot>

                        </table>
                    </div>
                </div>

                <div class="asset-actions">
                    <button class="btn btn-primary dev-btn"
                            ng-click="SaveAndNext()">
                        Save & Next
                    </button>

                    <button class="btn btn-primary dev-btn"
                            ng-click="SaveAsDraft()">
                        Save as Draft
                    </button>

                    <button class="btn btn-primary dev-btn"
                            ng-click="BackTo()">
                        Back
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>