<script src="~/Scripts/AngularFramework/AuditorAuditFees.js?v=@DateTime.Now.Ticks"></script>
<style>
    .section-head {
        font-weight: 600;
        font-size: 16px;
        margin: 20px 0 10px 0;
        border-bottom: 1px solid #ddd;
        padding-bottom: 5px;
    }

    .field-label {
        font-weight: 500;
    }

    .db-value {
        color: #555;
        font-style: italic;
    }

    table.devtable tbody tr th.row-name {
        color: #fff !important;
        background-color: #1899a0;
    }

    table.devtable thead tr th {
        background: #1899a0;
        text-align: center;
    }

    table.devtable tfoot tr th, table.devtable tfoot td {
        background: #1899a0;
    }

    table.devtable tbody td.drkBg, table.devtable thead th.drkBg2 {
        background: #79c8cd;
    }

    table.devtable thead th.lgtBg {
        background: #fff;
        color: #000;
    }

    table.devtable tbody td input, table.devtable tfoot td input {
        text-align: right;
    }

    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

        .custom-tbls-tabs > li {
            margin-bottom: -2px;
        }

            .custom-tbls-tabs > li > button {
                color: #444;
                font-weight: 600;
                border: 1px solid transparent !important;
                border-bottom: 2px solid transparent !important;
                margin-right: 0;
                background: transparent;
                transition: all 0.3s ease;
                border-radius: 4px 4px 0 0;
                padding: 8px 20px;
                line-height: 24px;
                outline: none;
            }

                /* Hover */
                .custom-tbls-tabs > li > button:hover {
                    background: #e3e3e3;
                    color: #168f98;
                    border: 1px solid transparent !important;
                }

            /* Active Tab */
            .custom-tbls-tabs > li.active > button,
            .custom-tbls-tabs > li.active > button:hover,
            .custom-tbls-tabs > li.active > button:focus {
                color: #168f98;
                background: #fff;
                border: 1px solid #9f9f9f !important;
                border-bottom: 2px solid #fff !important;
                font-weight: 700;
            }
</style>
<div ng-app="AuditorAuditFeesModule">
    <div ng-controller="AuditorAuditFeesCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">Audit Fees</h3>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">Audit Fees</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">

                <ul class="nav nav-tabs custom-tbls-tabs" role="tablist">
                    <li>
                        <button class="btn btn-light " ng-click="GotoCurrent()">Current Year</button>
                    </li>
                    <li>
                        <button class="btn btn-light " ng-click="GotoBackLog()">Back Log</button>
                    </li>
                    <li class="active">
                        <button class="btn btn-primary ">Audit Fees</button>
                    </li>
                </ul>

                <div>
                    <div class="form-group  pull-left">
                        <label>Select Date</label>
                        <input type="date" class="form-control" ng-model="SelectedDate" ng-change="LoadAuditFeesForm()" />
                    </div>
                    <h2 style=" font-weight: bold; text-align: center; "> Audit Fees {{ DISTRICT_ENG }} {{ PreviousMonth }} ({{ FinancialYearName }}) </h2>
                    <div class="col-md-12">
                        <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                    </div>
                    <div class="citizen-dash-head">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped devtable bank-table">
                                <colgroup>
                                    <col style="width:5.5%" />
                                    <col style="width:12%" />
                                    <col style="width:12%" />
                                    <col style="width:12%" />
                                    <col style="width:12%" />
                                    <col style="width:12%" />
                                    <col style="width:12%" />
                                    <col style="width:11.25%" />
                                </colgroup>
                                <thead>
                                    <tr class="year-heading">
                                        <th colspan="8" class="main-title"> ऑडिट फीस (राशी लाखो में) </th>
                                    </tr>
                                    <tr>
                                        <th rowspan="3" class="type-head">प्रकार</th> 
                                        <th rowspan="3" class="total-head lgtBg">गत बकाया<br />(बैकलॉग)</th> 
                                        <th colspan="3" class="drkBg2">गत माह तक</th> 
                                        <th colspan="3" class="lgtBg">माह में</th>
                                    </tr>
                                    <tr>
                                        <th rowspan="2" class="drkBg2">चालू वर्ष में<br />निर्धारण</th>
                                        <th colspan="2" class="drkBg2">ऑडिट फीस वसूली</th>
                                        <th rowspan="2" class="lgtBg">चालू वर्ष में<br />निर्धारण</th>
                                        <th colspan="2" class="lgtBg">ऑडिट फीस वसूली</th>
                                    </tr>
                                    <tr>
                                        <th class="drkBg2">बैकलॉग<br />की वसूली</th>
                                        <th class="drkBg2">चालू वर्ष<br />की वसूली</th>
                                        <th class="lgtBg">बैकलॉग<br />की वसूली</th>
                                        <th class="lgtBg">चालू वर्ष<br />की वसूली</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @*<tr>
                                            <th>ग्राम सेवा</th>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                        </tr>
                                        <tr>
                                            <th>प्राथ. डेयरी</th>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                        </tr>
                                        <tr>
                                            <th>अन्य</th>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                        </tr>
                                        <tr>
                                            <th>कुल योग</th>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                            <td><input type="text" class="form-control" /></td>
                                        </tr>*@
                                    <tr ng-repeat="item in AuditFeesList track by item.CommitteeTypeId">
                                        <td class="type-cell"> {{item.CommitteeTypeName_Hin}} </td>
                                        <td> <input type="number" class="form-control" ng-model="item.PreviousOutstanding" min="0" ng-change="ValidateBackLog(item, 'PreviousOutstanding')" /> </td>
                                        <td> <input type="number" class="form-control" ng-model="item.PreviousMonthCurrentYearAssessment" min="0" ng-change="ValidateAssessmentRecovery(item, 'PreviousMonthCurrentYearAssessment')" /> </td>
                                        <td> <input type="number" class="form-control" ng-model="item.PreviousMonthBacklogRecovery" min="0" ng-change="ValidateBackLog(item, 'PreviousMonthBacklogRecovery')" /> </td>
                                        <td> <input type="number" class="form-control" ng-model="item.PreviousMonthCurrentYearRecovery" min="0" ng-change="ValidateAssessmentRecovery(item, 'PreviousMonthCurrentYearRecovery')" /> </td>
                                        @*<td> <input type="number" class="form-control" ng-model="item.CurrentMonthCurrentYearAssessment" min="0" ng-change="ValidateAssessmentRecovery(item, 'CurrentMonthCurrentYearAssessment')" /> </td>*@
                                        <td> <input type="number" class="form-control" ng-model="item.CurrentMonthCurrentYearAssessment" min="0" /> </td>
                                        <td> <input type="number" class="form-control" ng-model="item.CurrentMonthBacklogRecovery" min="0" ng-change="ValidateBackLog(item, 'CurrentMonthBacklogRecovery')" /> </td>
                                        <td> <input type="number" class="form-control" ng-model="item.CurrentMonthCurrentYearRecovery" min="0" ng-change="ValidateAssessmentRecovery(item, 'CurrentMonthCurrentYearRecovery')" /> </td>
                                    </tr>
                                    <tr ng-if="!AuditFeesList || AuditFeesList.length == 0">
                                        <td colspan="8" class="text-center">
                                            No Data Found
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="text-center" style="margin-top:20px;">
                        <button type="button" class="btn btn-primary dev-btn" ng-click="SaveAuditFeesForm()">
                            Submit
                        </button>
                    </div>
                </div>
                <div class="se-pre-con"></div>
            </div>
        </div>
    </div>
</div>