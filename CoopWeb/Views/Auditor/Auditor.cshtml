<script src="~/Scripts/AngularFramework/Auditor.js"></script>

<div ng-app="AuditorModule">
    <div ng-controller="AuditorCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">{{translation.Auditor}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.Auditor}} </span>
                        <i class="fa fa-angle-right"> </i>

                        <span style="margin: 0 5px;"> {{translation.Auditor}} </span>
                    </li>

                </ul>
            </div>
        </div>
       
        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearTemplateForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.Auditor}} </h4>
                    </div>
                    <div class="modal-body">                     
                    </div>
                </div>

            </div>
        </div>



        <div class="col-md-12">

            <div class="citizen-dash-head" style="overflow: hidden;">
                <div class="table-dropdown">
                    <div class="col-xs-4">
                        <label for="search">{{translation.Search}}:</label>
                        <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                    </div>
                    <div class="col-xs-4">
                        <label for="search">{{translation.ItemPerPage}}:</label>
                        <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                    </div>
                    <div class="col-xs-4">
                        <label>
                            {{translation.Auditor}} :
                        </label>
                        <select ng-model="UnitMaster.DepartmentId" class="form-control" ng-init="UnitMaster.DepartmentId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}-</option>
                            <option ng-repeat="item in Department" value="{{item.DEPTCODE}}">
                                {{_language =='en-us' ?  item.DEPTNAMEENGLISH : item.DEPTNAMEHINDI}}
                            </option>
                        </select>


                    </div>
                </div>
                
               
            <table class="table table-responsive devtable" style="margin-top:10px;padding-top:10px">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>

                        <th ng-click="sortData('Society')">
                            {{translation.Society}}
                            <div ng-class="getSortClass('Society')"></div>
                        </th>
                        <th ng-click="sortData('IsEmpanelledCA')">
                            {{translation.IsEmpanelledCA}}
                            <div ng-class="getSortClass('IsEmpanelledCA')"></div>
                        </th>
                        <th ng-click="sortData('IsFirm')">
                            {{translation.IsFirm}}
                            <div ng-class="getSortClass('IsFirm')"></div>
                        </th>
                        <th ng-click="sortData('AuditorId')">
                            {{translation.AuditorId}}
                            <div ng-class="getSortClass('AuditorId')"></div>
                        </th>
                        <th ng-click="sortData('DistrictId')">
                            {{translation.DistrictId}}
                            <div ng-class="getSortClass('DistrictId')"></div>
                        </th>
                        <th>
                            {{translation.IsActive}}
                        </th>
                        <th>
                            {{translation.Edit}}
                        </th>
                        <th>
                            {{translation.Delete}}
                        </th>
                    </tr>
                </thead>
                <tbody>

                    <tr dir-paginate="Class in AuditData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                        <td>{{ Class.SocietyId }}</td>
                        <td>{{ Class.IsEmpanelledCA }}</td>
                        <td>{{ Class.IsFirm }}</td>
                        <td>{{ Class.AuditorId }}</td>
                        <td>{{ Class.DistrictId }}</td>

                        <td>

                            <div class="dev-action">

                                <label class="switch">
                                    <input type="checkbox" ng-checked="Class.isactive == 1" ng-click="SetStatus(Class.UnitId,Class.isactive)">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                        </td>
                        <td>
                            <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Class)"></i>
                        </td>
                        <td>
                            <i class="fa fa-trash" ng-click="SetStatus(Class.UnitId,2)"></i>
                        </td>
                    </tr>
                </tbody>
            </table>
                    </div>
                </div>

                <div class="col-md-10">
                    <div class="text-center">
                        <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
                <div class="col-md-2">
                    <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                </div><div class="form-group col-md-12">
    <div class="dev-align-btn">

        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
    </div>



</div>
            </div>
        
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>

 
</div>

