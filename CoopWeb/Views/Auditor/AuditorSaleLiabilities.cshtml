        background-color: #198754;
        color: #fff;
        cursor: pointer;
        transition: background 0.2s ease;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
    }

        table.devtable tbody .add i, table.devtable tbody .remove i {
