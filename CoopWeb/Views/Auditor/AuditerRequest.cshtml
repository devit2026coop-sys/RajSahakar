<script src="~/Scripts/AngularFramework/AuditorRequest.js"></script>

<div ng-app="AuditorReqModule">
    <div ng-controller="AuditorReqCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.CaseRegistraion}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.CaseRegistraion}} </span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12">

            <div class="citizen-dash-head">

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.Court}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="CaseRegistration.Court" class="form-control" ng-init="CaseRegistration.Court='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in CourtListData" value="{{item.ID}}">
                                {{_language =='en-us' ?  item.VALUEENG : item.VALUENAMEHI}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{translation.Act}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="CaseRegistration.Act" class="form-control" ng-init="CaseRegistration.Act='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in CourtActListData" value="{{item.ID}}">
                                {{_language =='en-us' ?  item.valueeng : item.valuenamehi}}

                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.section}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="CaseRegistration.section" class="form-control" ng-init="CaseRegistration.section='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in CourtSectionListData" value="{{item.ID}}">
                                {{_language =='en-us' ?  item.valueeng : item.valuenamehi}}

                        </select>
                    </div>
                    <div class="col-lg-2">{{translation.Case}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="CaseRegistration.Case" class="form-control" ng-init="CaseRegistration.Case='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in CourtPurposeListData" value="{{item.ID}}">
                                {{_language =='en-us' ?  item.valueeng : item.valuenamehi}}
                        </select>

                    </div>

                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.TypeOfCase}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="CaseRegistration.TypeOfCase" class="form-control" ng-init="CaseRegistration.TypeOfCase='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in CourtCaseTypeListData" value="{{item.ID}}">
                                {{_language =='en-us' ?  item.valueeng : item.valuenamehi}}
                        </select>
                    </div>
                    <div class="col-lg-2" style="display:none;">{{translation.DateOfAffiliation}}<span class="error">*</span></div>
                    <div class="col-lg-4" style="display:none;">
                        <input type="date" name="Affiliation" id="txtAffiliationDate" dateformat="dd MM yyyy" style="display:inline; margin-top: 0px;" class="form-control" placeholder="{{translation.Affiliation}}" ng-model="CaseRegistration.DateOfAffiliation" autocomplete="off" /> &nbsp;
                    </div>
                </div>
                <div class="form-group col-md-12">
                    <div class="col-lg-2">
                        {{translation.UrbanRural}}
                    </div>
                    <div class="col-lg-4">
                        <label class="help-block-gender" style="width:40% !important;">
                            <input type="radio" id="sdfs" name="Rurals" value="0" ng-model="CaseRegistration.isruralurban" ng-change="RuralUrbanBlock()">{{translation.Urban}}
                        </label>
                        <label class="help-block-gender" style="width:40% !important;">
                            <input type="radio" id="sdf" value="1" name="Rural" ng-model="CaseRegistration.isruralurban" ng-change="RuralUrbanBlock()">{{translation.Rural}}
                        </label>
                    </div>
                </div>
                <div ng-show="UrbanDiv">
                    <div class="form-group col-md-12">
                        <div class="col-lg-2">
                            {{translation.CityType}}<span class="error">*</span>
                        </div>
                        <div class="col-lg-4">
                            <select id="staticall" ng-model="CaseRegistration.citytypeid" class="form-control" ng-init="CaseRegistration.citytypeid='0'" ng-change="GetCityListByCityTypes(1)" ng-disabled="allDisable">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option value="1">{{translation.NagarParisad}}</option>
                                <option value="2">{{translation.NagarPalika}}</option>
                                <option value="3">{{translation.NagarNigam}}</option>
                            </select>
                        </div>
                        <div class="col-lg-2">
                            {{translation.City}}<span class="error">*</span>
                        </div>
                        <div class="col-lg-4">
                            <select ng-model="CaseRegistration.cityblockid" class="form-control" ng-change="GetWardList(1)" ng-init="CaseRegistration.cityblockid='0'" ng-disabled="allDisable">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in CityListdata" value="{{item.CITY_ID}}">
                                    {{_language =='en-us' ?  item.CITY_ENG : item.CITY_MANGAL}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="col-lg-2">
                            {{translation.Ward}}<span class="error">*</span>
                        </div>
                        <div class="col-lg-4">
                            <select ng-model="CaseRegistration.wardgpid" class="form-control" ng-init="CaseRegistration.wardgpid='0'" ng-disabled="allDisable">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Ward" value="{{item.WARD_ID}}">
                                    {{_language =='en-us' ?  item.WARD_ENG : item.WARD_MANGAL}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
                <div ng-show="RuralDiv">
                    <div class="form-group col-md-12">
                        <div class="col-lg-2">
                            {{translation.DivisionHeading}}
                        </div>
                        <div class="col-lg-4">
                            <select ng-model="CaseRegistration.DIVISION_ID" id="ddlDivision" name="division" ng-change="GetDistrictList(1);DivisionList()" class="form-control" ng-init="CaseRegistration.DIVISION_ID ='0'" ng-disabled="allDisable">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Divisions" value="{{item.DIVISION_ID}}">
                                    {{_language =='en-us' ?  item.DIVISION_ENG : item.DIVISION_MANGAL}}
                                </option>
                            </select>
                        </div>
                        <div class="col-lg-2">
                            {{ translation.District}}<span class="error">*</span>
                        </div>
                        <div class="col-lg-4">
                            <select ng-model="CaseRegistration.districtid" class="form-control" ng-init="CaseRegistration.districtid='0'" ng-change="BlockListByOffAdd(1)" ng-disabled="allDisable">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                    {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="col-lg-2">
                            {{ translation.BlockHeading}}
                        </div>
                        <div class="col-lg-4">
                            <select ng-model="CaseRegistration.cityblockid" id="ddlblocki" class="form-control" ng-init="CaseRegistration.cityblockid='0'" ng-change="GramPanchayatList(1)" ng-disabled="allDisable">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Blocksdata | orderBy:'BLOCK_ENG'" value="{{item.BLOCK_ID}}">
                                    {{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}
                                </option>
                            </select>
                        </div>
                        <div class="col-lg-2">
                            {{ translation.GramPanchayatHeading}}
                        </div>
                        <div class="col-lg-4">
                            <select ng-model="CaseRegistration.wardgpid" id="ddlGP" class="form-control" ng-init="CaseRegistration.wardgpid='0'" ng-change="VillageList(1)" ng-disabled="allDisable">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in GramPanchayats | orderBy:'GramPanchayats'" value="{{item.GP_ID}}">
                                    {{_language =='en-us' ?  item.GP_ENG : item.GP_MANGAL}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="col-lg-2">
                            {{translation.Village}}
                        </div>
                        <div class="col-lg-4">
                            <select ng-model="CaseRegistration.villageid" id="ddlVillage" class="form-control" ng-init="CaseRegistration.villageid='0'" ng-disabled="allDisable">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Villages | orderBy:'VILLAGE_ENG'" value="{{item.VILLAGE_ID}}">
                                    {{_language =='en-us' ?  item.VILLAGE_ENG : item.VILLAGE_MANGAL}}
                                </option>
                            </select>
                        </div>
                    </div>

                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.CaseDescription}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <textarea rows="6" cols="131" style="margin: 0px; width: 1048px; height: 116px;" ng-model="CaseRegistration.CaseDescription"></textarea>
                    </div>
                </div>
                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveCaseRegister()">{{translation.SaveNxt}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearCaseRegister()">{{translation.Clear}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="BackToPage()">{{translation.Back}}</button>
                        <input type="hidden" ng-model="CaseRegistration.CaseRegID" value="0" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown" ng-show="Showgride">
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2" style="font-weight: 600 !important;">{{translation.DateOfAffiliation}}</div>
                        <div class="col-lg-4">
                            <input type="date" name="Affiliation" id="txtfAffiliationDate" ng-init="CaseRegistration.DateOfAffiliation=''" style="display:inline; margin-top: 0px;" class="form-control" ng-change="CaseRegDetailList()" placeholder="{{translation.Affiliation}}" ng-model="CaseRegistration.DateOfAffiliation" autocomplete="off" /> &nbsp;
                        </div>

                        <div class="col-lg-2" style="font-weight: 600 !important;">{{translation.CaseStatus}}:</div>
                        <div class="col-lg-4" style="padding-left: 0;">

                            <label class="help-block-gender"><input type="radio" id="casestatustype" name="CaseStatus" value="1" ng-model="CaseRegistration.CaseStatus" ng-change="CaseRegDetailList()">{{translation.Approvable}} </label>
                            <label class="help-block-gender"><input type="radio" id="casestatustype" name="CaseStatus" value="2" ng-model="CaseRegistration.CaseStatus" ng-change="CaseRegDetailList()">{{translation.UnderProc}}</label>

                        </div>
                    </div>
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2" style="font-weight: 600 !important;">{{translation.Search}}:</div>
                        <div class="col-lg-4">

                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.Court}}
                                    <div class="arrow-up" ng-click="sortData('Court')"></div>
                                    <div class="arrow-down" ng-click="sortData('Court')"></div>
                                    <div ng-class="getSortClass('Court')"></div>
                                </th>
                                <th>
                                    {{translation.Act}}
                                    <div class="arrow-up" ng-click="sortData('Act')"></div>
                                    <div class="arrow-down" ng-click="sortData('Act')"></div>
                                    <div ng-class="getSortClass('Act')"></div>
                                </th>
                                <th ng-click="sortData('TypeOfCase')">
                                    {{translation.TypeOfCase}}
                                    <div ng-class="getSortClass('TypeOfCase')"></div>
                                </th>
                                <th ng-click="sortData('DateOfAffiliation')">
                                    {{translation.DateOfAffiliation}}
                                    <div ng-class="getSortClass('DateOfAffiliation')"></div>
                                </th>
                                <th ng-click="sortData('CaseRegistraionNo')">
                                    {{translation.CaseRegistraionNo}}
                                    <div ng-class="getSortClass('CaseRegistraionNo')"></div>
                                </th>
                                <th>
                                    {{translation.Status}}
                                </th>
                                <th>
                                    {{translation.TakeAction}}
                                </th>

                            </tr>
                        </thead>

                        <tbody>
                            <tr dir-paginate="items in CaseRegDetailListData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="statePagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ items.courtname }}</td>
                                <td>{{ items.Act}}</td>
                                <td>{{ items.Casetype}}</td>
                                <td>{{ items.AffilationDate}}</td>
                                <td>{{ items.CaseRegNo}}</td>
                                <td>{{ items.CaseStatus}}</td>
                                <td>
                                    <a title="VIEW CASE" style="cursor:pointer;" ng-click="CaseApplicationView(items.ID)"><i class="fa fa-eye"></i></a>
                                    <a title="UPDATE CASE" style="cursor:pointer;" ng-show="(items.EnclouserCount == '0' || items.AppllantCount == '0' || items.ResponedCount == '0' || items.AdvocateCount == '0'  || items.OICCount == '0') ? true : false" ng-click="update(items)"><i class="fa fa-edit"></i></a>
                                    <a title="SUBMIT" style="cursor:pointer;" ng-show="(items.CaseRegNo == '' && items.EnclouserCount != '0' && items.AppllantCount != '0' && items.ResponedCount != '0' && items.AdvocateCount != '0'  && items.OICCount != '0') ? true : false" ng-click="GetCaseDetails(items.ID)"><i class="fa fa-arrow-right"></i></a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="col-md-10">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="statePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="dev-align-btn">

                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../Citizen/Index"> Back</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        
    </div>
</div>
<div class="se-pre-con"></div>
<div id="stop" class="scrollTop">
    <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
</div>


