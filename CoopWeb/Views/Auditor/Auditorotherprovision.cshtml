<script src="~/Scripts/AngularFramework/Auditorotherprovision.js?v=@DateTime.Now.Ticks"></script>

<style>
    table.devtable thead tr th {
        background: #006159;
        text-align: center;
    }



    table.devtable tbody .add {
        display: inline-flex;
        border-radius: 50%;
        background-color: #198754;
        color: #fff;
        cursor: pointer;
        transition: background 0.2s ease;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
    }

        table.devtable tbody .add i, table.devtable tbody .remove i {
            color: white;
            font-size: 14px;
            font-weight: normal;
        }

    .remove {
        display: inline-flex;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
        background-color: #dc3545;
    }




    .section-row th {
        background: #e7f2f1;
        color: #075b55;
        font-weight: 800 !important;
        text-align: left;
        padding: 11px 14px;
        border-top: 2px solid #b5d7d3;
    }

    .total-row th, .total-row td {
        background: #006159;
        color: #fff;
        font-weight: 800;
        padding: 13px 12px;
    }

    .sub-item {
        padding-left: 34px !important;
    }

        .sub-item.sub-item-btn {
            display: flex;
            justify-content: space-between;
        }

            .sub-item.sub-item-btn div {
                display: flex;
                gap: 10px;
            }

            .sub-item.sub-item-btn input {
                max-width: 300px;
            }

    .form-control.numeric {
        text-align: right;
    }


    .top-tbs-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

        .custom-tbls-tabs > li {
            margin-bottom: -2px;
        }

            .custom-tbls-tabs > li > a {
                color: #444;
                font-weight: 600;
                border: 1px solid transparent !important;
                border-bottom: 2px solid transparent !important;
                margin-right: 0;
                background: transparent;
                transition: all 0.3s ease;
                border-radius: 4px 4px 0 0;
                padding: 8px 20px;
                line-height: 24px;
                outline: none;
            }

                /* Hover */
                .custom-tbls-tabs > li > a:hover {
                    background: #e3e3e3;
                    color: #168f98;
                    border: 1px solid transparent !important;
                }

            /* Active Tab */
            .custom-tbls-tabs > li.active > a,
            .custom-tbls-tabs > li.active > a:hover,
            .custom-tbls-tabs > li.active > a:focus {
                color: #168f98;
                background: #fff;
                border: 1px solid #9f9f9f !important;
                border-bottom: 2px solid #fff !important;
                font-weight: 700;
            }

    .tab-content.custom-tbls-tab-content, .tab-content.custom-tbls-tab-content > .active {
        padding: 0px;
    }
</style>
<div ng-app="auditorotherprovisionMod" ng-controller="auditorotherprovisionCtrl" ng-cloak="">
    <div class="page">
        <div class="col-md-12">
            <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">
                Other Provision
            </h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">Other Provision</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">

                <div style="display: flex; gap: 10px; justify-content: end; margin-bottom: 15px;">
                    <button class="btn btn-primary dev-btn text-center" ng-click="NextStep()">Save & Next</button>
                    <button class="btn btn-primary dev-btn text-center">Save as Draft</button>
                    @*<button class="btn btn-primary dev-btn text-center">Clear</button>*@
                    <button class="btn btn-primary dev-btn text-center" ng-click="BackTo()">Back</button>
                </div>
                <table class="table table-bordered table-striped devtable">

                    <thead>
                        <tr>
                            <th>क्र. स.</th>
                            <th>नाम प्रावधान</th>
                            <th>राशि</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr>
                            <td>1.</td>
                            <td>
                                6. प्रावधान (Provisions)
                            </td>
                            <td><input class="form-control numeric" placeholder="0.00" type="text"></td>
                        </tr>
                        <tr>
                            <td>2.</td>
                            <td>
                                ऑडिट फीस प्रावधान (Provision for Audit Fees)
                            </td>
                            <td><input class="form-control numeric" placeholder="0.00" type="text"></td>
                        </tr>
                        <tr>
                            <td>3.</td>
                            <td>
                                करों के लिए प्रावधान (Provision for Taxes)
                            </td>
                            <td><input class="form-control numeric" placeholder="0.00" type="text"></td>
                        </tr>
                        <tr>
                            <td>4.</td>
                            <td>
                                ग्रेच्युटी के लिए प्रावधान (Provision for Gratuity)
                            </td>
                            <td><input class="form-control numeric" placeholder="0.00" type="text"></td>
                        </tr>
                        <tr>
                            <td>5.</td>
                            <td>
                                पीएल/ लीव इनकैशमेंट प्रावधान (PL/Leave Encashment Provision)
                            </td>
                            <td><input class="form-control numeric" placeholder="0.00" type="text"></td>
                        </tr>
                        <tr>
                            <td>6.</td>
                            <td>
                                अन्य प्रावधान (Other Provisions)
                            </td>
                            <td><input class="form-control numeric" placeholder="0.00" type="text"></td>
                        </tr>


                    </tbody>
                </table>


                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button class="btn btn-primary dev-btn text-center" ng-click="NextStep()">Save & Next</button>
                    <button class="btn btn-primary dev-btn text-center">Save as Draft</button>
                    @*<button class="btn btn-primary dev-btn text-center">Clear</button>*@
                    <button class="btn btn-primary dev-btn text-center" ng-click="BackTo()">Back</button>
                </div>
            </div>
        </div>
    </div>
</div>


