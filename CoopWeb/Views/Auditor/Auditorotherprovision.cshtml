<script src="~/Scripts/AngularFramework/Auditorotherprovision.js?v=@DateTime.Now.Ticks"></script>

<style>


    table.devtable thead tr th {
        background: #1899a0;
        text-align: center;
    }

    table.devtable tfoot tr th, table.devtable tfoot td {
        background: #1899a0;
    }

    table.devtable tbody .add {
        display: inline-block;
        padding: 6px 12px;
        border: 1px solid #006159;
        border-radius: 5px;
        background: #006159;
        color: #fff;
        font-weight: 700;
        font-size: 12px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        table.devtable tbody .add:hover {
            background: #168178;
        }
</style>
<div ng-app="auditorotherprovisionMod" ng-controller="auditorotherprovisionCtrl" ng-cloak="">
    <div class="page">
        <div class="col-md-12">
            <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">
                Other Provision
            </h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">Other Provision</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <table class="table table-bordered table-striped devtable">

                    <thead>
                        <tr>
                            <th>क्र. स.</th>
                            <th>नाम प्रावधान</th>
                            <th>राशि</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr>
                            <td>1.</td>
                            <td>
                                6. प्रावधान (Provisions)
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>2.</td>
                            <td>
                                ऑडिट फीस प्रावधान (Provision for Audit Fees)
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>3.</td>
                            <td>
                                करों के लिए प्रावधान (Provision for Taxes)
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>4.</td>
                            <td>
                                ग्रेच्युटी के लिए प्रावधान (Provision for Gratuity)
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>5.</td>
                            <td>
                                पीएल/ लीव इनकैशमेंट प्रावधान (PL/Leave Encashment Provision)
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>
                        <tr>
                            <td>6.</td>
                            <td>
                                अन्य प्रावधान (Other Provisions)
                            </td>
                            <td><input class="form-control" type="text"></td>
                        </tr>


                    </tbody>
                </table>


                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button class="btn btn-primary dev-btn text-center" ng-click="NextStep()">Click To Next Steup</button>
                    <button class="btn btn-primary dev-btn text-center">Submit</button>
                    <button class="btn btn-primary dev-btn text-center">Clear</button>
                    <button class="btn btn-primary dev-btn text-center" ng-click="BackTo()">Back To</button>
                </div>
            </div>
        </div>
    </div>
</div>


