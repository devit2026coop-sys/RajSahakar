<script type="text/javascript">
    function OnSuccess(data) {
        $(".se-pre-con").fadeOut("slow");
        if (data.UserType != 'K') {
            $('#FormPost').html(data.result);
            $('#FormPost').find('form').submit();
        }
        else {
            if (data.result == '1') {
                alert('Payment Successful Received');
                window.location = "../Citizen/SocietyPayments";
            }
            else {
                ShowModelAlert("Society Administrative Details", 'Issue in Payment Receiveing Please Try after Some time');
            }
        }
    }


    function OnFailure(data) {
        $(".se-pre-con").fadeOut("slow");
        $scope.showLoader = false;
        alert(JSON.stringify(data));

    }
    function OnBegin() {
        $(".se-pre-con").fadeIn("slow");
        //$scope.showLoader = true;
    }


</script>

