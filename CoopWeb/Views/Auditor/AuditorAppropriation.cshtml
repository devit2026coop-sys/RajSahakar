<script src="~/Scripts/AngularFramework/AuditorAppropriation.js?v=@DateTime.Now.Ticks"></script>

<style>

    table.devtable thead tr th {
        background: #006159;
        text-align: center;
    }

    table.devtable tbody .add {
        display: inline-flex;
        border-radius: 50%;
        background-color: #198754;
        color: #fff;
        cursor: pointer;
        transition: background 0.2s ease;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
    }

        table.devtable tbody .add i, table.devtable tbody .remove i {
            color: white;
            font-size: 14px;
            font-weight: normal;
        }

    .remove {
        display: inline-flex;
        border-radius: 50%;
        color: #fff;
        cursor: pointer;
        width: 35px;
        height: 35px;
        justify-content: center;
        align-items: center;
        border: 0px;
        background-color: #dc3545;
    }

    .section-row th {
        background: #e7f2f1;
        color: #075b55;
        font-weight: 800 !important;
        text-align: left;
        padding: 11px 14px;
        border-top: 2px solid #b5d7d3;
    }

    .total-row th, .total-row td {
        background: #006159;
        color: #fff;
        font-weight: 800;
        padding: 13px 12px;
    }

    .sub-item {
        padding-left: 34px !important;
    }

        .sub-item.sub-item-btn {
            display: flex;
            justify-content: space-between;
        }

            .sub-item.sub-item-btn div {
                display: flex;
                gap: 10px;
            }

            .sub-item.sub-item-btn input {
                max-width: 300px;
            }

    .form-control.numeric {
        text-align: right;
    }

    .top-tbs-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .custom-tbls-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid #9f9f9f;
        display: flex;
    }

        .custom-tbls-tabs > li {
            margin-bottom: -2px;
        }

            .custom-tbls-tabs > li > a {
                color: #444;
                font-weight: 600;
                border: 1px solid transparent !important;
                border-bottom: 2px solid transparent !important;
                margin-right: 0;
                background: transparent;
                transition: all 0.3s ease;
                border-radius: 4px 4px 0 0;
                padding: 8px 20px;
                line-height: 24px;
                outline: none;
            }

                /* Hover */
                .custom-tbls-tabs > li > a:hover {
                    background: #e3e3e3;
                    color: #168f98;
                    border: 1px solid transparent !important;
                }

            /* Active Tab */
            .custom-tbls-tabs > li.active > a,
            .custom-tbls-tabs > li.active > a:hover,
            .custom-tbls-tabs > li.active > a:focus {
                color: #168f98;
                background: #fff;
                border: 1px solid #9f9f9f !important;
                border-bottom: 2px solid #fff !important;
                font-weight: 700;
            }

    .tab-content.custom-tbls-tab-content, .tab-content.custom-tbls-tab-content > .active {
        padding: 0px;
    }
</style>

<div ng-app="auditorAppropriationMod" ng-controller="auditorAppropriationCtrl" ng-cloak="">
    <div class="page">
        <div class="col-md-12">
            <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">
                Appropriation
            </h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">Appropriation</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div style="display: flex; gap: 10px; justify-content: end; margin-bottom: 15px;">
                    <button class="btn btn-primary dev-btn text-center" ng-click="SaveAppropriationDetails()">Save & Next</button>
                    @*<button class="btn btn-primary dev-btn text-center">Save as Draft</button>*@
                    @*<button class="btn btn-primary dev-btn text-center">Clear</button>*@
                    <button class="btn btn-primary dev-btn text-center" ng-click="BackTo()">Back</button>
                </div>
                <table class="table table-bordered table-striped devtable">
                    <thead>
                        <tr>
                            <th colspan="5">लाभ-हानि नियोजन खाता (P&L Appropriation A/c) - 31 मार्च -------</th>
                        </tr>
                        <tr>
                            <th style="background-color: #168178; color: #fff; text-align: center;">विवरण (Particulars) [Dr.]</th>
                            <th style="background-color: #168178; color: #fff; text-align: center;">Percentage</th>
                            <th style="background-color: #168178; color: #fff; text-align: center;">चालू वर्ष राशि (Amount ₹)</th>
                            <th style="background-color: #168178; color: #fff; text-align: center;">विवरण (Particulars) [Cr.]</th>
                            <th style="background-color: #168178; color: #fff; text-align: center;">चालू वर्ष राशि (Amount ₹)</th>
                        </tr>
                    </thead>
                    <tbody>

                        <tr ng-repeat="dr in DrList track by dr.ParticularId">

                            <!-- Dr Particulars -->
                            <td>
                                {{dr.ParticularName_Hi}}
                                ({{dr.ParticularName_En}})
                            </td>

                            <!-- Dr Percentage -->
                            <td>
                                <span ng-if="dr.Percentage != null">
                                    {{dr.Percentage}}%
                                </span>
                            </td>

                            <!-- Dr Amount -->
                            @*<td style="text-align:right;">
                                    {{dr.CurrentYearAmount | number:2}}
                                </td>*@

                        <td> 
                            <input type="number"
                                   class="form-control numeric"
                                   ng-model="dr.CurrentYearAmount"
                                   min="0"
                                   step="0.01"
                                   style="text-align:right;" />
                        </td>

                            <!-- Cr Particulars -->
                            <td>
                                <span ng-if="CrList[$index]">
                                    {{CrList[$index].ParticularName_Hi}}
                                    ({{CrList[$index].ParticularName_En}})
                                </span>
                            </td>

                            <!-- Cr Amount -->
                            @*<td style="text-align:right;">
                                <span ng-if="CrList[$index]">
                                    {{CrList[$index].CurrentYearAmount | number:2}}
                                </span>
                            </td>*@

                        <td> 
                            <input ng-if="CrList[$index]"
                                   type="number"
                                   class="form-control numeric"
                                   ng-model="CrList[$index].CurrentYearAmount"
                                   min="0"
                                   step="0.01"
                                   style="text-align:right;" />
                        </td>

                        </tr>

                        <tr ng-if="DrList.length == 0 && CrList.length == 0">
                            <td colspan="5" class="text-center">
                                No Data Found
                            </td>
                        </tr>

                    </tbody>

                    <tfoot>
                        <tr class="total-row">

                            <th>योग (Total)</th>
                            <th></th>

                            <th style="text-align:right;">
                                {{getAppropriationTotal(DrList) | number:2}}
                            </th>

                            <th>योग (Total)</th>

                            <th style="text-align:right;">
                                {{getAppropriationTotal(CrList) | number:2}}
                            </th>

                        </tr>
                    </tfoot>

                    @*<tbody>
                            <tr>
                                <td>सामान्य आरक्षित निधि (General Reserve Fund) (25% of Net profit of year)</td>
                                <td>25%</td>
                                <td style="text-align:right;">0.00</td>
                                <td>शुद्ध लाभ (Net Profit from P&amp;L A/c)</td>
                                <td style="text-align:right;">0.00</td>
                            </tr>

                            <tr>
                                <td>सहकारी शिक्षा एवं विकास निधि (Co-op Education Fund) (1% of Net profit of year)</td>
                                <td>1%</td>
                                <td style="text-align:right;">0.00</td>
                                <td>पिछले वर्ष का शेष (Last Year Balance)</td>
                                <td style="text-align:right;">0.00</td>
                            </tr>

                            <tr>
                                <td>लाभांश कोष (Maximum 7% of Share Capital)</td>
                                <td></td>
                                <td style="text-align:right;">0.00</td>
                                <td></td>
                                <td></td>
                            </tr>

                            <tr>
                                <td>उक्त प्रावधान के पश्चात् शेष लाभ (Remaining Profit)</td>
                                <td></td>
                                <td style="text-align:right;">0.00</td>
                                <td></td>
                                <td></td>
                            </tr>

                            <tr>
                                <td>मूल्य घटत बढ़त कोष (20% of remaining Profit)</td>
                                <td></td>
                                <td style="text-align:right;">0.00</td>
                                <td></td>
                                <td></td>
                            </tr>

                            <tr>
                                <td>भूमि एवं भवन कोष (15% of remaining Profit)</td>
                                <td></td>
                                <td style="text-align:right;">0.00</td>
                                <td></td>
                                <td></td>
                            </tr>

                            <tr>
                                <td>जनहितकारी कोष (10% of remaining Profit)</td>
                                <td></td>
                                <td style="text-align:right;">0.00</td>
                                <td></td>
                                <td></td>
                            </tr>

                            <tr>
                                <td>अन्य कोष</td>
                                <td></td>
                                <td style="text-align:right;">0.00</td>
                                <td></td>
                                <td></td>
                            </tr>

                            <tr>
                                <td>आगामी वर्ष हेतु आधिक्य (Surplus carried to B/S)</td>
                                <td></td>
                                <td style="text-align:right;">0.00</td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tbody>

                        <tfoot>
                            <tr class="total-row">
                                <th>योग (Total)</th>
                                <th></th>
                                <th style="text-align:right;">0.00</th>
                                <th>योग (Total)</th>
                                <th style="text-align:right;">0.00</th>
                            </tr>
                        </tfoot>*@

                </table>


                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button class="btn btn-primary dev-btn text-center" ng-click="SaveAppropriationDetails()">Save & Next</button>
                    @*<button class="btn btn-primary dev-btn text-center">Save as Draft</button>*@
                    @*<button class="btn btn-primary dev-btn text-center">Clear</button>*@
                    <button class="btn btn-primary dev-btn text-center" ng-click="BackTo()">Back</button>
                </div>
            </div>
        </div>
    </div>
</div>


