<script src="~/Scripts/AngularFramework/AuditorAppropriation.js?v=@DateTime.Now.Ticks"></script>

<style>


    table.devtable thead tr th {
        background: #1899a0;
        text-align: center;
    }

    table.devtable tfoot tr th, table.devtable tfoot td {
        background: #1899a0;
    }

    table.devtable tbody .add {
        display: inline-block;
        padding: 6px 12px;
        border: 1px solid #006159;
        border-radius: 5px;
        background: #006159;
        color: #fff;
        font-weight: 700;
        font-size: 12px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        table.devtable tbody .add:hover {
            background: #168178;
        }
</style>
<div ng-app="auditorAppropriationMod" ng-controller="auditorAppropriationCtrl" ng-cloak="">
    <div class="page">
        <div class="col-md-12">
            <h4 class="citizen-dash-head ng-binding" style="font-weight:bold;">
                Appropriation
            </h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">Appropriation</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <table class="table table-bordered table-striped devtable">

                    <thead>
                        <tr>
                            <th colspan="5">लाभ-हानि नियोजन खाता (P&L Appropriation A/c) - 31 मार्च -------</th>
                        </tr>
                        <tr>
                            <th>विवरण (Particulars) [Dr.]</th>
                            <th>Percentage</th>
                            <th> चालू वर्ष राशि (Amount ₹)</th>
                            <th> विवरण (Particulars) [Cr.]</th>
                            <th> चालू वर्ष राशि (Amount ₹)</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>सामान्य आरक्षित निधि (General Reserve Fund) (25% of Net profit of year)</td>
                            <td>25%</td>
                            <td></td>
                            <td>शुद्ध लाभ (Net Profit from P&amp;L A/c)</td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>सहकारी शिक्षा एवं विकास निधि (Co-op Education Fund) (1% of Net profit of year)</td>
                            <td>1%</td>
                            <td></td>
                            <td>पिछले वर्ष का शेष (Last Year Balance)</td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>लाभांश कोष (Maximum 7% of Share Capital)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>उक्त प्रावधान के पश्चात् शेष लाभ (Remaining Profit)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>मूल्य घटत बढ़त कोष (20% of remaining Profit)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>भूमि एवं भवन कोष (15% of remaining Profit)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>जनहितकारी कोष (10% of remaining Profit)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>अन्य कोष</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>

                        <tr>
                            <td>आगामी वर्ष हेतु आधिक्य (Surplus carried to B/S)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>

                    <tfoot>
                        <tr style="font-weight:bold; background-color:#f2f2f2;">
                            <th>योग (Total)</th>
                            <th></th>
                            <th></th>
                            <th>योग (Total)</th>
                            <th></th>
                        </tr>
                    </tfoot>

                </table>


                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button class="btn btn-primary dev-btn text-center" ng-click="NextStep()">Click To Next Steup</button>
                    <button class="btn btn-primary dev-btn text-center">Submit</button>
                    <button class="btn btn-primary dev-btn text-center">Clear</button>
                    <button class="btn btn-primary dev-btn text-center" ng-click="BackTo()">Back To</button>
                </div>
            </div>
        </div>
    </div>
</div>


