<script src="~/Scripts/AngularFramework/Inspection.js"></script>
<script>
    $(document).ready(function () {
        if (('@ViewBag.InspectionIDEnc').length > 10)
           $('#btnautoclick').click();
    });
</script>

<div ng-app="InspectionModule" ng-controller="InspectionCont">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head"> {{ translation.InspectionQuestions}} </h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li>
                    <span style="margin: 0 5px;float: left"> {{translation.InspectionQuestions}} </span>

                    <span style="float:right;margin-left:50px;">Objection By Inspector </span>
                    <div style="height:20px;width:22px; background-color:#ffcccc;float:right;margin-right:0px;"></div>
                </li>
                @*<li style="float: right;" id="divAddBtn">
                        <i class="fa fa-angle-double-right" style="color: #025e63;"></i>
                        <a ng-click="AddNewSociety()" style="color: #025e63; cursor: pointer; text-decoration:none; font-weight: bold;" class="ng-binding">{{translation.AddNewSocietyProfile}}</a>
                    </li>*@
            </ul>
        </div>
    </div>
    {{QuestionData}}
    <button id="btnautoclick" style="display:none" ng-click="GetQuestionsForInspection('@ViewBag.InspectionIDEnc')">Click Me!</button>
    <div class="col-md-12">
        <div class="table-responsive citizen-dash-head" >         
            <div id="DIV1"></div>
            <div style="float:left ; margin-left:10px ; text-align:left" ng-show="IsCityzen">
                <div class="dev-menu-btn">
                    <label class="check-box" for="inlineRadio1" style="margin-right: 15px;"> {{translation.youwanttobeliquideter}} </label>
                    <input class="form-check-input" type="radio" id="idstrue" ng-model="Inspection.radioISliqtru" name="Isliquideter" value="true" />
                </div>
                <div class="dev-menu-btn">
                    <label class="check-box" for="inlineRadio1" style="margin-right: 15px;"> {{translation.continuousforinspection}} </label>
                    <input class="form-check-input" id="idsfalse" type="radio" ng-click="Onclickareahide()" ng-model="Inspection.radioISliqtru" name="Isliquideter" value="false" /> @*ng-checked="menuaction.IsActive == 1"*@
                </div>
            </div>
            <textarea ng-model="Inspection.textareaIsliq" id="txtarealiq" rows="3" cols="50" style="margin-left:20px;" ng-show="ShowArea"></textarea>
            <table width="100" class="table devtable" ng-show="IsCityzen">
                <tr>
                    <td>{{ translation.File_upload}} </td>
                    <td><input type="file" filetype='pdf' name="File" id="fluplod" class="form-control" ng-model="Inspection.InspectionFile" onchange="angular.element(this).scope().UploadInspectionDoc(this.files)" /></td>
                    <td>{{ translation.Remarks}}</td>
                    <td><textarea rows="2" cols="30" name="FileRemarks" ng-model="Inspection.InspectionFileRemark" id="fileremark" class="form-control" placeholder="{{ translation.Remarks}}" autocomplete="off"></textarea></td>
                    <td></td>
                    <td><button type="submit" class="btn btn-primary" ng-click="UploadInspectionFile()">{{translation.UploadFile}}</button></td>
                </tr>
            </table>


        </div>
    </div>

    <div class="form-group">
        <div class="dev-menu-btn">
            <button type="submit" class="btn btn-primary" ng-click="SaveInspectionAns()">{{translation.Submit}}</button>
            <button type="submit" class="btn btn-primary" ng-click="ClearInspectionForm()">{{translation.Clear}}</button>
            <button type="submit" class="btn btn-primary" ng-click="GoBackTo()">{{translation.Back}}</button>
        </div>
    </div>
</div>
