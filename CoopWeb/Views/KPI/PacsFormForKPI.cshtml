<script src="~/Scripts/AngularFramework/PacsFormForKPI.js?v=@DateTime.Today.Ticks"></script>
<link href="~/Content/Stylesheets/toastr.min.css" rel="stylesheet" />
<script src="~/Scripts/toastr.min.js?v=@DateTime.Today.Ticks"></script>
<style>
    .section-head {
    font-weight: 600;
    font-size: 16px;
    margin: 20px 0 10px 0;
    border-bottom: 1px solid #ddd;
    padding-bottom: 5px;
    }

    .field-label {
    font-weight: 500;
    }

    .db-value {
    color: #555;
    font-style: italic;
    }

    .table tbody td {
    color: #000 !important;
    }

    .table tbody td input,
    .table tbody td select {
    color: #000 !important;
    }

    .table tbody td label {
    color: #000 !important;
    }

    .form-group label {
    color: #333 !important;
    }
</style>
<div ng-app="KPIForPacsMod">
    <div ng-controller="KPIForPacsCtrl">
        <div class="col-md-12">
            <h3 class="citizen-dash-head" style="margin-top:30px;">
                KPI For PACS : <strong> {{ pacsDetail.PacsName }} </strong>
            </h3>
        </div>
        <input type="hidden" id="hdnGCCLoginId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).GccId)" />
        <input type="hidden" id="hdnLoginMappingId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserRoleDeptMappingId)" />
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
            <div class="citizen-dash-head">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 form-group">
                        <h3 style="text-align:center;color:#000;">
                            KPI For <strong>{{ pacsDetail.PacsName }}</strong> PACS
                        </h3>
                        <h4 style="text-align: center; font-weight: bold; color: #000;">
                            कार्य प्रदर्शन के आधार पर (KPI)
                        </h4>
                    </div>
                    @*<div class="col-md-3 form-group MarginTop20">
                        <label for="ddlGSS"><b> Society Name </b></label>
                        <select class="form-control" id="ddlGSS" ng-model="FormData.SocietyID" ng-init="FormData.SocietyID ='0'" ng-change="GetKPIResult()">
                            <option value="0" selected="selected" disabled>--चुनें--</option>
                            <option ng-repeat="item in SocietyList" value="{{item.SocietyID}}">
                                {{_language =='en-us' ?  item.SocietyName : item.SocietyName}}
                            </option>
                        </select>
                    </div>*@
                    <div class="col-md-3 form-group">
                        <label class="field-label"><b>{{ translation.District}}</b> </label>
                        <select ng-model="pacsDetail.DistrictId" class="form-control" ng-disabled="pacsDetail.DistrictId > 0 || IsFormDisabled">
                            <option value="0">{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Districts" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="field-label"><b>CCB Name</b> </label>
                        <input class="form-control" type="text" ng-model="pacsDetail.CCBName" readonly="readonly" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="field-label"><b>CCB {{translation.BranchName}}</b> </label>
                        <input class="form-control" type="text" ng-model="pacsDetail.CCBBranchName" readonly="readonly" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="field-label"><b>Pacs Name</b> </label>
                        <input class="form-control" type="text" ng-model="pacsDetail.PacsName" readonly="readonly" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="field-label"><b>Pacs Manager Name</b> </label>
                        <input class="form-control" type="text" ng-model="pacsDetail.PacsManagerName" readonly="readonly" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="field-label"><b>Pacs Registration No.</b> </label>
                        <input class="form-control" type="text" ng-model="pacsDetail.PacsRegistrationNo" placeholder="Enter Registration No." ng-disabled="IsFormDisabled" />
                    </div>

                    @*<div class="col-md-3  form-group">
                        <label class="field-label"><b> CCB {{translation.BranchName}} </b> </label>
                        <select name="ClassId" ng-model="CCBId" class="form-control" ng-init="CCBId == '0'" ng-disabled="IsFormDisabled">
                            <option value="">{{translation.SelectOption}}</option>
                            <option ng-repeat="itemBlock in BankMasterList | orderBy:'CCBNameEn'" value="{{itemBlock.CCBId}}">
                                {{_language =='en-us' ?  itemBlock.CCBNameEn : itemBlock.CCBNameHi}}
                            </option>
                        </select>
                    </div>*@
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped">
                        <thead>
                            <tr style="background:#64c0c5;color:white;text-align:center;">
                                <th style="width:3%">KPI No.</th>
                                <th style="width:15%">KPI Area</th>
                                <th style="width:30%">Indicator</th>
                                <th style="width:15%">Instructions to fill Indicators</th>
                                <th style="width:15%;" ng-if="isAgricultureColumnVisible()">
                                    Agriculture Distribution
                                </th>
                                <th style="width:6%;">Weight Marks</th>
                                <th style="width:8%;">Obtained</th>

                                @*display:none
                                display:none*@
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat-start="area in KPIAreas track by $index">
                                <td rowspan="{{area.Indicators.length}}">
                                    {{$index+1}}
                                </td>
                                <td rowspan="{{area.Indicators.length}}">
                                    {{area.KPIArea}}
                                </td>
                                <!-- First Indicator -->
                                <td>
                                    {{area.Indicators[0].KPIIndicators}}
                                </td>
                                <td>
                                    <div class="row" ng-if="isTextInput(area.Indicators[0])">
                                        <div class="col-lg-6">
                                            <span>Previous</span>
                                            <input type="number" class="form-control" ng-model="area.Indicators[0].MembershipPrevious" ng-change="isMembershipCalculate(area.Indicators[0])" placeholder="Please enter.." min="0" ng-disabled="IsFormDisabled" />
                                        </div>

                                        <div class="col-lg-6">
                                            <span>Current</span>
                                            <input type="number" class="form-control" ng-model="area.Indicators[0].MembershipCurrent" ng-change="isMembershipCalculate(area.Indicators[0])" placeholder="Please enter.." min="0" ng-disabled="IsFormDisabled" />
                                        </div>
                                    </div>

                                    <!-- Loan = Single Textbox -->
                                    <div ng-if="isLoanInput(area.Indicators[0])">
                                        <input type="number" min="0" class="form-control" style="max-width:250px" ng-model="area.Indicators[0].KCCLoanDisbursedAmt" placeholder="Enter Loan Amount" ng-change="Calculate(area.Indicators[0])" ng-disabled="IsFormDisabled" />
                                    </div>
                                    <div ng-if="!isTextInput(area.Indicators[0]) && !isLoanInput(area.Indicators[0])">
                                        <select class="form-control" style="max-width:250px" ng-model="area.Indicators[0].SelectedOption" ng-change="Calculate(area.Indicators[0]);setEPACSDependent()" ng-disabled="IsFormDisabled">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="item in area.Indicators[0].Options" value="{{item.KPI_KEYId}}">
                                                {{item.InputType}}
                                            </option>
                                        </select>
                                    </div>
                                    <div ng-if="area.Indicators[0].KPIIndicatorsId == 83 && isYesOption83(area.Indicators[0])">
                                        <select class="form-control" style="max-width:250px" ng-model="area.Indicators[0].SelectedOption2" ng-disabled="IsFormDisabled">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="item in area.Indicators[0].Options" value="{{item.KPI_KEYId}}">
                                                {{item.InputType}}
                                            </option>
                                        </select>
                                    </div>
                                    <div ng-if="area.Indicators[0].KPIIndicatorsId == 83 && isYesOption83(area.Indicators[0]) && isYesOption83Option3(area.Indicators[0])">
                                        <select class="form-control" style="max-width:250px" ng-model="area.Indicators[0].SelectedOption3" ng-disabled="IsFormDisabled">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="item in area.Indicators[0].Options" value="{{item.KPI_KEYId}}">
                                                {{item.InputType}}
                                            </option>
                                        </select>
                                    </div>

                                    @*<select class="form-control" style="max-width:250px" ng-model="area.Indicators[0].SelectedOption" ng-change="Calculate(area.Indicators[0])" ng-disabled="IsFormDisabled">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="item in area.Indicators[0].Options" value="{{item.KPI_KEYId}}">
                                            {{item.InputType}}
                                        </option>
                                    </select>*@
                                </td>
                                <td ng-if="isAgricultureColumnVisible()">
                                    <div ng-if="area.KPIAreaId == 34 && isYesOption(area.Indicators[0])">
                                        <input type="number" min="0" class="form-control" style="max-width:250px" ng-model="area.Indicators[0].AgricultureTrunOver" placeholder="Enter Turnover" ng-disabled="IsFormDisabled" />
                                    </div>
                                </td>
                                @*display: none*@
                                <td class="text-center" style=" vertical-align: middle;" ng-hide="isLoanInput(area.Indicators[0])">
                                    {{area.Indicators[0].WeightedMarks || 0}}
                                </td>
                                <td ng-hide="isLoanInput(area.Indicators[0])">
                                    @*style="display: none"*@
                                    <input type="text" class="form-control" ng-model="area.Indicators[0].MarksObtained" readonly />
                                </td>
                            </tr>

                            <!-- Remaining Indicators -->
                            <tr ng-repeat="indicator in area.Indicators.slice(1)" ng-repeat-end>
                                <td>
                                    {{indicator.KPIIndicators}}
                                </td>
                                <td>
                                    <div class="row" ng-if="isTextInput(indicator)">
                                        <div class="col-lg-6">
                                            <span>Previous</span>
                                            <input type="number" min="0" class="form-control" ng-model="indicator.ShareCapitalPrevious" placeholder="Please enter.." ng-change="isShareCapitalCalculate(indicator)" ng-disabled="IsFormDisabled" />
                                        </div>

                                        <div class="col-lg-6">
                                            <span>Current</span>
                                            <input type="number" min="0" class="form-control" ng-model="indicator.ShareCapitalCurrent" placeholder="Please enter.." ng-change="isShareCapitalCalculate(indicator)" ng-disabled="IsFormDisabled" />
                                        </div>
                                    </div>
                                    <div ng-if="isLoanInput(indicator)">
                                        <input type="number" min="0" class="form-control" style="max-width:250px" ng-model="indicator.KCCLoanDisbursedAmt" placeholder="Enter Loan Amount" ng-change="Calculate(indicator)" ng-disabled="IsFormDisabled" />
                                    </div>
                                    <div ng-if="!isTextInput(indicator) && !isLoanInput(indicator)">
                                        <select class="form-control" style="max-width:250px" ng-model="indicator.SelectedOption" ng-disabled="IsFormDisabled || isEPACSDependent(indicator)" ng-change="Calculate(indicator)">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="item in indicator.Options" value="{{item.KPI_KEYId}}">
                                                {{item.InputType}}
                                            </option>
                                        </select>
                                    </div>
                                    <!-- ==========================================
                                    KPI 83 - Any Other - Option 2
                                    ========================================== -->
                                    <div ng-if="indicator.KPIIndicatorsId == 83 && isYesOption83(indicator)" style="margin-top:10px">
                                        <span>Any other : Please Specify (2)</span>
                                        <select class="form-control" style="max-width:250px" ng-model="indicator.selectOptionAnyOther1" ng-disabled="IsFormDisabled" ng-change="Calculate(indicator)">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="item in indicator.Options" value="{{item.KPI_KEYId}}">
                                                {{item.InputType}}
                                            </option>
                                        </select>
                                    </div>


                                    <!-- ==========================================
                                    KPI 83 - Any Other - Option 3
                                    ========================================== -->
                                    <div ng-if="indicator.KPIIndicatorsId == 83 && isYesOption83(indicator) && isYesOption83Option2(indicator)" style="margin-top:10px">
                                        <span>Any other : Please Specify (3)</span>
                                        <select class="form-control" style="max-width:250px" ng-model="indicator.selectOptionAnyOther2" ng-disabled="IsFormDisabled" ng-change="Calculate(indicator)">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="item in indicator.Options" value="{{item.KPI_KEYId}}">
                                                {{item.InputType}}
                                            </option>

                                        </select>

                                    </div>
                                </td>
                                <td ng-if="isAgricultureColumnVisible()">
                                    <div ng-if="indicator.KPIAreaId == 34 && isYesOption(indicator)">
                                        <input type="number" min="0" class="form-control" style="max-width:250px" ng-model="indicator.AgricultureTrunOver" placeholder="Enter Turnover" ng-disabled="IsFormDisabled" />
                                    </div>
                                </td>

                                <td class="text-center" style=" vertical-align: middle;" ng-hide="isLoanInput(indicator)">
                                    {{indicator.WeightedMarks || 0}}
                                </td>
                                <td ng-hide="isLoanInput(indicator)">

                                    <!-- Normal KPI -->
                                    <input type="text" class="form-control" ng-if="indicator.KPIIndicatorsId != 83" ng-model="indicator.MarksObtained" readonly />

                                    <!-- KPI 83 - Any Other -->
                                    <div ng-if="indicator.KPIIndicatorsId == 83">
                                        <!-- First Yes -->
                                        <input type="text" class="form-control" ng-model="indicator.MarksObtained" readonly style="margin-bottom:5px;" />

                                        <!-- Second Yes -->
                                        <input type="text" class="form-control" ng-if="isYesOption83Option2(indicator)" ng-model="indicator.MarksObtained2" readonly style="margin-bottom:5px;" />

                                        <!-- Third Yes -->
                                        <input type="text" class="form-control" ng-if="isYesOption83Option3(indicator)" ng-model="indicator.MarksObtained3" readonly />
                                    </div>

                                </td>
                            </tr>
                            <tr ng-if="!KPIAreas || KPIAreas.length==0">
                                <td colspan="8" class="text-center">
                                    No Data Found
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-center">
                    <button type="button" class="btn btn-primary dev-btn" ng-disabled="IsFormDisabled" ng-click="IsUpdate ? UpdateKPIResult() : SaveKPIResult()">
                        {{ IsUpdate ? 'Update' : 'Save' }}
                    </button>
                </div>

            </div>
        </div>

    </div>
</div>