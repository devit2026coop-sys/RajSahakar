                    <div class="col-md-12">
                        <div ng-show="ShowTable">
                            <table class="table table-bordered table-hover table-striped">
                                <thead>

                                    <tr style="background-color: #64c0c5; font-size: 17px; color: #fff; text-align: center; ">
                                        <th style="width:5%;">KPI No.</th>
                                        <th style="width:20%;">Key Task / KPI Area</th>
                                        <th style="width:30%;">Details of Indicators</th>
                                        <th style="width:10%;">Target</th>
                                        <th style="width:10%;">Achievement</th>
                                        <th style="width:8%;">Progress %</th>
                                        <th style="width:8%;">Weighted Marks</th>
                                        <th style="width:9%;">Marks Obtained</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <tr ng-repeat-start="area in KPIAreas track by area.KPIAreaId">

                                        <td rowspan="{{area.Indicators.length}}" class="text-center">
                                            {{$index + 1}}
                                        </td>

                                        <td rowspan="{{area.Indicators.length}}" style="vertical-align:top;">
                                            {{area.KPIArea}}
                                        </td>

                                        <td>
                                            {{area.Indicators[0].KPIIndicators}}
                                        </td>

                                        <td ng-if="area.Indicators[0].KPIIndicatorsId != 97">
                                            <input type="number" class="form-control" ng-model="area.Indicators[0].Target" ng-change="Calculate(area.Indicators[0])" min="0" ng-disabled="IsTargetAchievementDisabled(area.Indicators[0])" />
                                        </td>

                                        <td ng-if="area.Indicators[0].KPIIndicatorsId != 97">

                                            <!-- Textbox for all other KPIs -->
                                            <input ng-if="area.Indicators[0].KPIIndicatorsId != 97" type="number" class="form-control" ng-model="area.Indicators[0].Achievement" ng-change="Calculate(area.Indicators[0])" min="0" ng-disabled="IsTargetAchievementDisabled(area.Indicators[0])" />
                                        </td>
                                        <td ng-if="area.Indicators[0].KPIIndicatorsId == 97" colspan="2">
                                            <!-- Dropdown only for KPIIndicatorsId = 97 -->
                                            <select ng-if="area.Indicators[0].KPIIndicatorsId == 97"
                                                    class="form-control" style="width:180px; margin:0 auto;"
                                                    ng-model="area.Indicators[0].SelectedOption"
                                                    ng-options="item.KPI_KEYId as item.InputType for item in area.Indicators[0].Options" ng-change="SetProgress(area.Indicators[0])" ng-disabled="IsTargetAchievementDisabled(area.Indicators[0])">

                                                <option value="">--Select--</option>

                                            </select>
                                        </td>

                                        <td>
                                            <input type="text" class="form-control" ng-model="area.Indicators[0].Progress" readonly tabindex="-1" />
                                        </td>

                                        <td class="text-center" style="vertical-align:middle;" tabindex="-1">
                                            {{area.Indicators[0].WeightedMarks}}
                                        </td>

                                        <td>
                                            <input type="text" class="form-control" ng-model="area.Indicators[0].MarksObtained" readonly tabindex="-1" />
                                        </td>

                                    </tr>

                                    <tr ng-repeat="indicator in area.Indicators.slice(1) track by indicator.KPIIndicatorsId" ng-repeat-end>

                                        <td>
                                            {{indicator.KPIIndicators}}
                                        </td>

                                        <td ng-if="indicator.KPIIndicatorsId != 97">
                                            <input type="number" class="form-control" ng-model="indicator.Target" ng-change="Calculate(indicator)" min="0" ng-disabled="IsTargetAchievementDisabled(indicator)" />
                                        </td>

                                        <td ng-if="indicator.KPIIndicatorsId != 97">
                                            <input ng-if="indicator.KPIIndicatorsId != 97" type="number" class="form-control" ng-model="indicator.Achievement" ng-change="Calculate(indicator)" min="0" ng-disabled="IsTargetAchievementDisabled(indicator)" />
                                        </td>
                                        <td ng-if="indicator.KPIIndicatorsId == 97" colspan="2">
                                            <select ng-if="indicator.KPIIndicatorsId == 97"
                                                    class="form-control" style="width:180px; margin:0 auto;"
                                                    ng-model="indicator.SelectedOption"
                                                    ng-options="item.KPI_KEYId as item.InputType for item in indicator.Options" ng-change="SetProgress(area.Indicators[0])" ng-disabled="IsTargetAchievementDisabled(area.Indicators[0])">

                                                <option value="">--Select--</option>

                                            </select>
                                        </td>

                                        <td>
                                            <input type="text" class="form-control" ng-model="indicator.Progress" readonly tabindex="-1" />
                                        </td>

                                        <td class="text-center" tabindex="-1">
                                            {{indicator.WeightedMarks}}
                                        </td>

                                        <td>
                                            <input type="text" class="form-control" ng-model="indicator.MarksObtained" readonly tabindex="-1" />
                                        </td>

                                    </tr>

                                    <tr ng-if="!KPIAreas || KPIAreas.length == 0">
                                        <td colspan="8" class="text-center">
                                            No Data Found
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center" style="margin-top:20px;" ng-show="ShowTable" ng-if="!IsKPIExpired">
                        @*<div class="text-center" style="margin-top:20px;" ng-show="ShowTable">*@
                            <button type="button" class="btn btn-primary dev-btn" ng-click="IsUpdate ? UpdateKPIResult() : SaveKPIResult()" ng-disabled="UserDetails.RoleId == 10188 && IsPLDBAdminLocked || !IsKPIExpired">
                                {{ isBtn }}
                            </button>
                        </div>
                    </div>
                </div>
