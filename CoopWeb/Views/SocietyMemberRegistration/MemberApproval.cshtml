                                        <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                            Total Records: {{DataPagingDetails.TotalRecords}}
                                        </div>
                                        <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetPLDBMemberApprovalData)" style="cursor: pointer;">
                                                <span>«First</span>
                                            </li>
                                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetPLDBMemberApprovalData)" style="cursor:pointer;">
                                                <span>« Previous</span>
                                            </li>
                                            <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetPLDBMemberApprovalData)"><span>{{n}}</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetPLDBMemberApprovalData)" style="cursor:pointer;">
                                                <span>Next »</span>
                                            </li>
                                            <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetPLDBMemberApprovalData)" style="cursor:pointer;">
                                                <span>Last »</span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

