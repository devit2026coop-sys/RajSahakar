@model Cooperative.Models.GopalCreditCardModel.GopalCreditCardFormModel
<script src="~/Scripts/AngularFramework/GopalCreditCardApplicationForm.js?v=1.19"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />
<script src="~/Scripts/AngularFramework/commonEsign.js?v=@DateTime.Now.Ticks"></script>
<style>
    input[type=file].form-control {
        border: 1px solid #cccccc !important;
    }

    .disabled input {
        background-color: #e0e0ef; /* Change background to indicate disabled state */
        /*pointer-events: none;*/
    }

    .instruction p {
        color: #222222
    }

        .instruction p b {
            color: #025e63
        }

    .instruction ul, .instruction ol {
        color: #222222;
        list-style-position: inside;
    }

    .gurantor-box {
        border: 1px solid #d0d0d0;
        border-radius: 4px;
        padding: 10px;
    }
</style>
@Html.Hidden("TemplateId")
<div ng-app="GopalCreditCardAppEntryForm" data-ng-init="init(@Newtonsoft.Json.JsonConvert.SerializeObject(Model))" ng-cloak="">
    <input type="hidden" id="hdnUserType" ng-model="UserType" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserType)" />

    <div ng-controller="GopalCreditCard">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.GopalCreditCardForm}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.EntryForm}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.GopalCreditCardApplicationForm}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn" ng-show="ActionId==1">
                            <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#modalInstruction" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                                <h5>&#187; {{translation.AddNewGopalCreditCardProfile}}</h5>
                            </button>
                        </li>
                        <li style="float: right;" id="divAddBtn" ng-show="ActionId==2">
                            <button type="button" ng-click="AddNewGopalCreditCardApp(1)" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                                <h5>&#187; {{translation.BackToGopalCreditCardProfile}}</h5>
                            </button>
                        </li>
                </ul>
            </div>
        </div>

        <div ng-show="divTabulation">
            <div class="col-md-12">
                <div class="table-responsive citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4" style="padding-left: 0;">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>

                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                    </div>
                    <table id="example" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('Name_ENG')">
                                    {{translation.ApplicantName}}
                                    <div ng-class="getSortClass('Name_ENG')"></div>
                                </th>
                                <th ng-click="sortData('RegistrationNo')">
                                    {{translation.ApplicationNo}}
                                    <div ng-class="getSortClass('RegistrationNo')"></div>
                                </th>
                                <th>
                                    {{translation.RegistrationDate}}
                                </th>
                                <th>
                                    {{translation.Status}}
                                </th>
                                <th>
                                    {{translation.Actions}}
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in TableData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SocietyIdForTbl">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{item.Name_ENG}}</td>
                                <td>{{item.RegistrationNo}}</td>
                                <td>{{item.RegistrationDate_DDMMYYYY}}  </td>
                                @*<td>{{item.ActivationStatus}} </td>*@
                                <td>{{item.ProceesStatusTextEn}} </td>
                                <td class="add-more-td">
                                    <a title="VIEW" ng-click="ApplicationView(item.EncGccId,item)"><i class="fa fa-eye"></i></a>
                                    @*<a title="VIEW" ng-click="ApplicationView(item.Encrypted_GopalCreditCardId, item.Encrypted_RegistrationNo)"><i class="fa fa-eye"></i></a>*@
                                    @*<a title="EDIT" ng-show="item.StatusId==1||item.StatusId==13||item.StatusId==14" ng-click="GetFormEditData(item.StatusId,item.Encrypted_GopalCreditCardId, item.Encrypted_RegistrationNo)"><i class="fa fa-edit"></i></a>*@
                                    <a title="EDIT" ng-show="item.StatusId==1||item.StatusId==12||item.StatusId==13||item.StatusId==14" ng-click="GetFormEditData(item.StatusId,item.EncGccId,item)"><i class="fa fa-edit"></i></a>
                                    @*<button type="button" class="btn btn-success btn-sm" ng-show="item.IsEligibleForRenewable == true && item.StatusId == 34 && item.HasReApplied == 0" ng-click="GetFormEditData(item.StatusId,item.EncGccId,item)">Re Apply</button>*@
                                    @*<a title="EDIT" ng-show="item.StatusId==1||item.StatusId==13||item.StatusId==14 || item.IsMahilaNidhi " ng-click="GetFormEditData(item.StatusId,item.EncGccId,item)"><i class="fa fa-edit"></i></a>*@
                                    <a title="E-sign" ng-show="item.StatusId==4 && item.IsApplicantSigned==false" class="btn btn-sm btn-success" ng-click="DocumentEsign(item.EncGccId,item)"><i class="fa fa-check-circle"></i> eSign Document</a>

                                </td>

                            </tr>
                        </tbody>
                    </table>
                    <div class="col-md-10">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="SocietyIdForTbl" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="ShowGopalCreditCardForm==true">
