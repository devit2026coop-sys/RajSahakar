                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.PANNo}}:</label>
                                            <input type="text" class="form-control disabled" ng-minlength="10" maxlength="10" onpaste="return false;" ondrop="return false;" placeholder="{{translation.PANNo}}" ng-model="GopalCreditCardModel.PANCardNo" ng-value="GopalCreditCardModel.PANCardNo | DEC" autocomplete="off" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.MobileNo}}<span class="error">*</span>:</label>
                                            <input type="text" ng-minlength="10" maxlength="10" onkeypress="return event.charCode >= 48 && event.charCode <= 57" onpaste="return false;" ondrop="return false;" class="form-control disabled" placeholder="{{translation.MobileNo}}" ng-model="GopalCreditCardModel.MobileNo" autocomplete="off" />
                                        </div>
                                        @*<div class="col-md-4 form-group">
                            <label for="uploadAadharDoc"> {{translation.AadharDoc}}:<span class="error">(Max size upto 2MB)</span></label>
                            <input type="file" class="form-control" accept="application/pdf" ng-model="GopalCreditCardModel.AadharDoc" id="uploadAadharDoc" name="uploadAadharDoc" checkmaxsize="2048" onchange="angular.element(this).scope().ValidateAndUploadFile(this.files, 'AadharDoc',2048)">
                            <a ng-show="AadharDoc!=''" target="_blank" href="~/Content/GopalCreditCard/{{AadharDoc}}" style="color: #337ab7;">View Aadhar Document<i class="fa fa-download"></i></a>
                            <div ng-if="GopalCreditCardModel.isValidAadharDoc" class="text-danger">
                                <p ng-if="GopalCreditCardModel.isValidAadharDoc"> {{ImageValidationMessage}}</p>
                            </div>
                            <div ng-if="GopalCreditCardModel.AadharDoc==''" class="text-danger">
                                <p>This field is required .!</p>
                            </div>
                        </div>*@
                                        <!--<div class="col-md-4 form-group">
                    <label for="uploadPanCardDoc"> {{translation.PanCardDoc}}:<span class="error">(Max size upto 2MB)</span></label>
                    <input type="file" class="form-control" accept="application/pdf" ng-model="GopalCreditCardModel.PanCardDoc" id="uploadPanCardDoc" name="uploadPanCardDoc" checkmaxsize="2048" onchange="angular.element(this).scope().ValidateAndUploadFile(this.files, 'PanCardDoc',2048)">
                    <a ng-show="PanCardDoc!=''" target="_blank" href="~/Content/GopalCreditCard/{{PanCardDoc}}" style="color: #337ab7;">View Pan Card Document<i class="fa fa-download"></i></a>-->
                                        @*<div ng-if="GopalCreditCardModel.isValidPanCardDoc" class="text-danger">
                            <p ng-if="GopalCreditCardModel.isValidPanCardDoc"> {{ImageValidationMessage}}</p>
                        </div>
                        <div ng-if="GopalCreditCardModel.PanCardDoc==''" class="text-danger">
                            <p>This field is required .!</p>
                        </div>*@
                                        <!--</div>-->
                                    </div>
                                </div>
                                <div class="col-md-2 form-group" ng-show="GopalCreditCardModel.MemberPhoto!=null && GopalCreditCardModel.MemberPhoto!=''">
                                    <img src="~/Content/GopalCreditCard/{{GopalCreditCardModel.MemberPhoto}}" width="100" />
                                </div>
                                <div class="col-md-2 form-group" ng-show="GopalCreditCardModel.MemberPhoto_Base64!=null && GopalCreditCardModel.MemberPhoto_Base64!=''">
                                    <img src="{{(GopalCreditCardModel.MemberPhoto_Base64!=null && GopalCreditCardModel.MemberPhoto_Base64!='')?'data:image/jpg;base64,' + GopalCreditCardModel.MemberPhoto_Base64:'../content/images/dummyImg.jpg'}}" width="100" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <h5 class="heading-hr ng-binding"> {{translation.PahupalkAddress}}</h5>
                            <label><input type="checkbox" ng-model="GopalCreditCardModel.IsAddressSameAsJanAadhar" id="IsAddressSameAsJanAadhar" name="chkAddressSameAsJanAadhar" ng-click="IsAddressSameAsJanAadhar_Changed(1)"> {{translation.AddressSameAsJanAadhar}}:</label>
                        </div>
                        <div class="col-lg-12" id="Address">
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.HouseBuildingNo}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="HouseBuildingNo" ng-model="GopalCreditCardModel.HouseBuildingNo" placeholder="{{translation.HouseBuildingNo}}" autocomplete="off">
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.LaneStreetName}}<span class="error">*</span></label>
