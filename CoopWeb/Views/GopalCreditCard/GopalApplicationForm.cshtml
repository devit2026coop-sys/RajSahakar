                            <label for="chkDIsTheCattleinsuredMMPBYNo"><input type="radio" ng-value="false" ng-model="GopalCreditCardModel.IsTheCattleinsuredMMPBY" name="chkIsTheCattleinsuredMMPBY" id="chkIsTheCattleinsuredMMPBYNo">{{translation.No}}</label>
