                                <label for="chkIsResideInPACSLAMPSAreaNo"><input type="radio" ng-value="false" ng-model="GopalCreditCardModel.IsResideInPACSLAMPSArea" name="chkIsResideInPACSLAMPSArea" id="chkIsResideInPACSLAMPSAreaNo"> {{translation.No}}</label>
