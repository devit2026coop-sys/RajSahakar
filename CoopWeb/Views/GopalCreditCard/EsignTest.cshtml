<script src="~/Scripts/AngularFramework/EsignTest.js?v=1.11"></script>

<div ng-app="GopalCreditCardAppEntryForm" ng-cloak="">
    
    <div ng-controller="GopalCreditCard">
        <br />
        <br />
        <br />
        X=<input type="text" class="text-muted" ng-model="llx" placeholder="llx" /><br />
        Y=<input type="text" class="text-muted" ng-model="lly" placeholder="lly" /><br />
        <a title="E-sign" class="btn btn-sm btn-success" ng-click="DocumentEsign(1)"><i class="fa fa-check-circle"></i> Citizen eSign Document</a>
        <a title="E-sign" class="btn btn-sm btn-success" ng-click="DocumentEsign(2)"><i class="fa fa-check-circle"></i> Gurantor 1eSign Document</a>
        <a title="E-sign" class="btn btn-sm btn-success" ng-click="DocumentEsign(3)"><i class="fa fa-check-circle"></i> Gurantor 2 eSign Document</a>
        <a title="E-sign" class="btn btn-sm btn-success" ng-click="DocumentEsign(4)"><i class="fa fa-check-circle"></i> eSign Document</a>

        <div class="modal fade" id="modelPopupOTP" tabindex="-1" role="dialog" aria-labelledby="otpVerifyLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" ng-click="clearOTPModel()">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <h4 style="color:#000 !important;" class="modal-title">OTP Verification</h4>
                    </div>

                    <div class="modal-body">
                        <form id="OTPVerificationForm" class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OTPVerificationForm">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label>{{translation.EnterOTP}}</label>
                                    <input type="text" class="form-control" max-length-and-validate placeholder="Enter The OTP" autocomplete="off" ng-model="ApplicationFlowMaster.OTP" />
                                </div>
                                <div class="text-center">
                                    <button type="button" class="btn btn-primary mr-2" ng-click="VerifyOTP()">Submit</button>
                                    <button type="button" class="btn btn-primary" ng-click="ApplicationEsign(GGG_Id)">Resend OTP</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("_JanAadhaarValidation")
</div>

