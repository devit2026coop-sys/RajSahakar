<script src="~/Scripts/AngularFramework/GopalCreditCardApplicationFormPart2.js"></script>
<style>
    input[type=file].form-control {
        border: 1px solid #cccccc !important;
    }
    label{
        font-weight:normal
    }
</style>
<div ng-app="gccApp" ng-controller="gccCtrl">
    <div class="citizen-dash-head" id="gccpart2">
        <div class="caseformShow">
            <div class="row">
                <div class="col-md-12">
                    <h3>{{translation.ApplicantDetails}}</h3>
                    <hr style="margin: 0;">
                    <br /><br />
                </div>
                <div class="col-md-4  form-group">
                    <label>{{translation.ApplicantName}}: <b>{{_language =='en-us' ?  objGCC.Name_ENG : objGCC.Name_HI}}</b></label><br />
                    <label>{{translation.LoanApplicationNo}}: <b>{{objGCC.RegistrationNo}}</b></label>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <h3>{{translation.LoanSecurityPoint}}</h3>
                    <hr style="margin: 0;">
                    <br /><br />
                </div>
                <div class="col-md-4  form-group">
                    <label>{{translation.TypesOfProperty}}<span class="error">*</span>:</label>
                    <select class="form-control" ng-model="gcc.TypesOfProperty" id="TypesOfProperty"  required>
                        <option value="" disabled>{{translation.SelectOption}}</option>
                        <option value="1">
                            {{_language =='en-us' ?  'Agricultural Land' : 'कृषि भूमि'}}
                        </option>
                        <option value="2">
                            {{_language =='en-us' ?  'Residential Plot' : 'आवासीय भुखण्ड'}}
                        </option>
                        <option value="3">
                            {{_language =='en-us' ?  'Residential House' : 'रहवासी मकान'}}
                        </option>
                        <option value="4">
                            {{_language =='en-us' ?  'Other' : 'अन्य'}}
                        </option>
                    </select>
                </div>
            </div>
            <div class="row" ng-show="gcc.TypesOfProperty==1">
                <div class="col-md-4 form-group">
                    <label>{{translation.KhasaraNo}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.KhasraNo" placeholder="{{translation.KhasaraNo}}" />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.KhataNo}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.KhataNo" placeholder="{{translation.KhataNo}}" />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.MeasurementOfLand}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.LandMeasurement" placeholder="{{translation.MeasurementOfLand}}" />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.TypesOfLand}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.LandType" placeholder="{{translation.TypesOfLand}}" />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.CopyOfJamabandi}}<span class="error">*</span>:</label>
                    <input type="file"  accept="application/pdf" class="form-control" checkmaxsize="5120" onchange="angular.element(this).scope().FileUploader(this.files,'CopyOfJamabandi')"  />
                    <a ng-show="CopyOfJamabandi_doc!=''" target="_blank" href="~/Content/GopalCreditCard/{{objGCC.GccDir}}/{{CopyOfJamabandi_doc}}" style="color: #337ab7; ">View Attached Document<i class="fa fa-download"></i></a>

                    <input type="hidden" ng-model="gcc.CopyOfJamabandi" id="CopyOfJamabandi" />
                </div>
            </div>
            <div class="row" ng-show="gcc.TypesOfProperty==2 || gcc.TypesOfProperty==3">
                <div class="col-md-4 form-group">
                    <label>{{translation.CompleteAddress}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.ResidentialPlotAddress" placeholder="{{translation.CompleteAddress}}" />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.EstimatedPrice}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.EstimatedPrice" placeholder="{{translation.EstimatedPrice}}" />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.CopyOfLease}}<span class="error">*</span>:</label>
                    <input type="file"  accept="application/pdf" class="form-control" checkmaxsize="5120" onchange="angular.element(this).scope().FileUploader(this.files,'CopyOfLease')" />
                    <a ng-show="CopyOfLease_doc!=''" target="_blank" href="~/Content/GopalCreditCard/{{objGCC.GccDir}}/{{CopyOfLease_doc}}" style="color: #337ab7; ">View Attached Document<i class="fa fa-download"></i></a>

                    <input type="hidden" ng-model="gcc.CopyOfLease" id="CopyOfLease" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label>{{translation.LoanAmountRecommendByPACS}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.LoanAmountRecommendByPACS" placeholder="{{translation.LoanAmountRecommendByPACS}}" maxlength="6" onkeypress='return event.charCode >= 48 && event.charCode <= 57' />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 form-group">
                    <label>{{translation.IsRegisteredBankFirstCharge}}<span class="error">*</span>:</label>
                    <label>
                        <input type="radio" name="irbfc" value="1" ng-model="gcc.IsRegisteredBankFirstCharge" ng-checked="true" /> {{translation.Yes}}
                    </label>
                    <label>
                        <input type="radio" name="irbfc" value="0" ng-model="gcc.IsRegisteredBankFirstCharge" />{{translation.No}}
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 form-group">
                    <label>{{translation.IsPropertyMortgagedEarlier}}<span class="error">*</span>:</label>
                    <label>
                        <input type="radio" name="ipme" value="1" ng-model="gcc.IsPropertyMortgagedEarlier" ng-checked="true" /> {{translation.Yes}}
                    </label>
                    <label>
                        <input type="radio" name="ipme" value="0" ng-model="gcc.IsPropertyMortgagedEarlier" />{{translation.No}}
                    </label>
                </div>
            </div>
            <div class="row" ng-show="gcc.IsPropertyMortgagedEarlier==1">
                <div class="col-md-12">
                    <h4><b>{{translation.DetailsOfPreviousLoanRecords}}</b></h4>
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.BankName}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.EarlierLoanFromBank" placeholder="{{translation.BankName}}" />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.AccountNumber}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.EarlierLoanAccountNo" placeholder="{{translation.AccountNumber}}" onkeypress='return event.charCode >= 48 && event.charCode <= 57' />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.Amount}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="gcc.EarlierLoanAmount" placeholder="{{translation.Amount}}" onkeypress='return event.charCode >= 48 && event.charCode <= 57' />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.LoanSanctionDate}}<span class="error">*</span>:</label>
                    <input type="date" class="form-control" ng-model="gcc.EarlierLoanSanctionDate" placeholder="{{translation.LoanSanctionDate}}" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 text-center pt-5">
                    <button  class="btn btn-primary dev-btn" ng-click="SaveGccApplicationPart2(false)">Save</button>
                    <button  class="btn btn-primary dev-btn" ng-click="SaveGccApplicationPart2(true)">Final Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>