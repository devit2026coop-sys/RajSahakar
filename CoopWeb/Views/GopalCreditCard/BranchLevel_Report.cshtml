<script src="~/Scripts/angular.js"></script>
<script src="~/Scripts/jquery-3.1.0.js"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />
<script src="~/Scripts/dirPagination.js"></script>
<script src="~/Scripts/AngularFramework/BranchLevel_Report.js?id=1"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
@{
    Layout = null;
}
<html>
<head>
    <meta charset="utf-8" />
    <title></title>
</head>
<body style="background:#808080;font-family:sans-serif">
    <div ng-app="MokaReportModule">
        <div ng-controller="MokaReportCont" ng-cloak="" style="display:flex;justify-content:center;align-items:center;flex-direction:column">

            <div id="MokaReportView">
                <style>

                    #MokaReportView {
                        padding: 50px;
                        display: inline-block;
                        background: #ffffff;
                    }

                    p {
                        line-height: 35px !important;
                        font-size: 16px;
                        color: #222;
                        padding: 10px;
                    }
                </style>
              
                <table width="100%" style="border-collapse: collapse; font-size: 20px; max-width: 800px " border="0" cellpadding="3" cellspacing="0">
                    <tr>
                        <td align="right" colspan="2">
                            <b style="line-height:40px">
                                शाखा स्तर
                            </b>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" colspan="2">
                            <sapn style="font-weight: 600; font-size: 1.65rem">
                                {{GopalCreditCardModel.LoanBankName_ENG}}, {{GopalCreditCardModel.LoanBranchName_ENG}}
                            </sapn>
                        </td>
                    </tr>
                    <tr>
                        <td align="right" colspan="2">
                            <span style="font-weight:800;font-size:1rem">
                                आवेदन संख्या:  {{GopalCreditCardModel.RegistrationNo}}
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td align="left" colspan="2">
                            <p style="line-height:40px">
                                आवेदक श्री/श्रीमती <b>{{GopalCreditCardModel.Name_HI}}</b> पुत्र/पुत्री/पत्नी श्री <b>{{GopalCreditCardModel.FatherName_HI}}</b> निवासी  <b>{{GopalCreditCardModel.HouseBuildingNo}}{{GopalCreditCardModel.LaneStreetName}} {{GopalCreditCardModel.Address_ENG}} {{GopalCreditCardModel.PinCode}} {{GopalCreditCardModel.Village_HI}} {{GopalCreditCardModel.DistrictName_HI}}</b>
                                के  पक्ष में श्री <b>{{GopalCreditCardModel.GuarantorDetailsList[0].Name}}</b> पुत्र  <b>{{GopalCreditCardModel.GuarantorDetailsList[0].FatherSpouseName}}</b>  एवं  श्री <b>{{GopalCreditCardModel.GuarantorDetailsList[1].Name}}</b>
                                पुत्र <b>{{GopalCreditCardModel.GuarantorDetailsList[1].FatherSpouseName}}</b> जमानत देना स्वीकार किया है।
                            </p>
                            <ul style="line-height: 40px; font-size: 1rem">
                                <li>आवेदक का सिबिल स्कोर........है।</li>
                                <li>आवेदक पक्ष में दो से अधिक ऋण बकाया है ( ) नहीं ( )</li>
                                <li>जमानतदारों का सिबिल स्कोर क्रमशः ............ , .....................</li>
                                <li>
                                    ऋण की सूरक्षा हेतु आवेदक/जमानतदार द्वारा रखी जाने वाली भूमि/भवन का विवरण <b>{{GopalCreditCardModel.GuarantorDetailsList[0].GuarranterLandProperty}}</b>
                                    एवं <b>{{GopalCreditCardModel.GuarantorDetailsList[1].GuarranterLandProperty}}</b>  ..........................
                                </li>
                            </ul>
                            <p style="line-height:40px">
                                राजस्थान सहकारी गोपाल क्रेडिट कार्ड ऋण योजनान्तर्गत उपरोक्तानुसार प्राप्त आवेदन पत्र की जांच एवं ग्राम
                                सेवा सहकारी समिति लि. की अनुशंषा अनुसार राशि रू ............................ की साख सीमा स्वीकृत करने  की
                                अनुशंषा की जाती है।
                            </p>
                        </td>

                    </tr>

                    <tr>
                        <td colspan="2">
                            <p style="line-height:40px; text-align:right">
                                <b>
                                    कार्यवाहक ऋण पर्यवेक्षक&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;शाखा प्रबन्धक<br />
                                    शाखा................................................
                                </b>
                            </p>
                        </td>
                    </tr>
                </table>


            </div>
          


        </div>
    </div>
</body>
</html>
<script>

    setTimeout(function () { window.print(); },
    5000)
</script>
