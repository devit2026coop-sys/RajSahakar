<script src="~/Scripts/AngularFramework/GccApplicationTransfer.js?id=1"></script>

<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />

<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td {
        padding: 1px;
        padding-right: 5px;
        padding-left: 5px;
    }
</style>
<div ng-app="ApplicationFlowModule">
    <div ng-controller="ApplicationFlowCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">Transfer Societies</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> {{translation.ApplicationFlow}} </span>
                    </li>
                </ul>
            </div>
        </div>



        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">
                        <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">
                            @*<input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />*@
                            <input type="hidden" id="hdnActId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).ActId)" />
                            <input type="hidden" id="hdnGccId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).GccId)" />
                            <input type="hidden" id="hdnLevelId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />
                            <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                            <input type="hidden" id="hdnUserId" ng-model="hdnUserId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId)" />

                            @if ((((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId) == 10228 || (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId) == 1)
                            {
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.BankName}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.LoanBankID" id="BankID" class="form-control" ng-init="GopalCreditCardModel.LoanBankID='0'" ng-change="Get_LoanBankBranch()">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in BankMasterList | orderBy:'BLOCK_ENG'" value="{{itemBlock.CCBId}}">
                                            {{_language =='en-us' ?  itemBlock.CCBNameEn : itemBlock.CCBNameHi}}
                                        </option>
                                    </select>
                                </div>
                            }

                            @if ((((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId) == 7 || (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId) == 1)
                            {
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.BankBranch}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.LoanBranchId" id="BranchId" class="form-control" ng-init="GopalCreditCardModel.LoanBranchId='0'" ng-change="Get_LoanBranch_PACS()">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in PLDBBranches | orderBy:'BLOCK_ENG'" value="{{itemBlock.Branch_ID}}">
                                            {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameEn}}
                                        </option>
                                    </select>
                                </div>
                            }
                            @if ((((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId) == 8 || (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId) == 1)
                            {
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.PACSName}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.PACS_ID" id="BranchId" class="form-control" ng-init="GopalCreditCardModel.PACS_ID='0'" ng-change="GetUserList()">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in PACSNameList | orderBy:'BLOCK_ENG'" value="{{itemBlock.PACS_ID}}">
                                            {{_language =='en-us' ?  itemBlock.PACSNameEn : itemBlock.PACSNameEn}}
                                        </option>
                                    </select>
                                </div>
                            }

                            <div class="col-md-4  margin-Top20">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-click="GetUserList()" class="btn btn-primary dev-btn ng-binding">Search User</button>
                            </div>
                            <div class="col-lg-12"></div>

                            <div class="col-md-2 margin-Top20" style="padding-left: 0;" id="ddrFromUser" ng-show="FromUserList.length>0">
                                <label>Select From User:</label>
                                <select name="StatusId" ng-model="ddrFromUser" class="form-control" ng-change="GetTransferToUserList()">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="sts in FromUserList" value="{{sts.UserId}}-{{sts.MappingID}}">
                                        {{_language =='en-us' ?  sts.OfficerNameEn : sts.OfficerNameHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-4  margin-Top20">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-show="ddrFromUser!=''" ng-click="GetUserGccList()" class="btn btn-primary dev-btn ng-binding">Get Gopal Credit Applications</button>
                            </div>
                            <div class="col-lg-12"></div>

                            <div class="col-md-2 margin-Top20" style="padding-left: 0;" id="ddrFromUser" ng-show="ToUserList.length>0">
                                <label>Select Transfer To User:</label>
                                <select name="StatusId" ng-model="ddrToUser" class="form-control">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="sts in ToUserList" value="{{sts.UserId}}">
                                        {{_language =='en-us' ?  sts.OfficerNameEn : sts.OfficerNameHi}}
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-4  margin-Top20" style="padding-left: 0;" ng-if="ApplicationFlowList.length>0">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-show="ddrToUser!=''" ng-click="TransferGcc()" class="btn btn-primary dev-btn ng-binding">Transfer Application</button>
                            </div>
                        </div>
                    </div>
                    <div style="overflow-x: auto;">
                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th>
                                        #
                                    </th>
                                    <th> <input type="checkbox" ng-model="CheckedAll" ng-change="SelectAllGcc()" /> </th>
                                    <th ng-click="sortData('SocietyName')">
                                        {{translation.SocietyName}}
                                        <div ng-class="getSortClass('SocietyName')"></div>
                                    </th>
                                    <th style=" min-width: 125px;">{{translation.RegistrationNo}} </th>
                                    <th>{{translation.AssignTo}}</th>
                                    <th> {{translation.Status}}</th>
                                    <th>{{translation.Actions}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="AppFlow in ApplicationFlowList">
                                    <td>{{$index+1}}</td>
                                    <td><input type="checkbox" ng-model="AppFlow.IsChecked" ng-change="SelectGcc()" /></td>
                                    <td> <b>{{AppFlow.Name_ENG }}</b></td>
                                    <td>{{AppFlow.RegistrationNo}}  </td>
                                    <td>{{AppFlow.OfficerNameEn}}  </td>
                                    <td>{{ _language =='en-us' ? AppFlow.ProceesStatusTextEn : AppFlow.ProceesStatusTextHi}}</td>
                                    <td>
                                        <a title="VIEW" ng-click="ApplicationView(AppFlow.GccIdDBEnc)"><i class="fa fa-eye"></i></a>
                                        @*<a title="{{translation.ShowDetails}}" style="color:#505050;" href="../ApplicationFlow/SocietyActionView?SocietyIDEnc={{AppFlow.SocietyIDEnc}}~_ApplicationFlow_ApplicationFlow" target="_blank"><i class="fa fa-info-circle infoicon-edit"></i></a>*@
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetUserSocietyList)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetUserSocietyList)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetUserSocietyList)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetUserSocietyList)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetUserSocietyList)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="se-pre-con"></div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>

    </div>




