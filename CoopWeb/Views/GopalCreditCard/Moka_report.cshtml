<script src="~/Scripts/angular.js"></script>
<script src="~/Scripts/jquery-3.1.0.js"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />
<script src="~/Scripts/dirPagination.js"></script>
<script src="~/Scripts/AngularFramework/Moka_Report.js?id=3"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
@{
    Layout = null;
}
<html>
<head>
    <meta charset="utf-8" />
    <title></title>
</head>
<body style="background:#808080">
    <div ng-app="MokaReportModule">
        <div ng-controller="MokaReportCont" ng-cloak="" style="display:flex;justify-content:center;align-items:center;flex-direction:column">

            <div id="MokaReportView">
                <style>

                    #MokaReportView {
                        padding: 20px 50px;
                        display: inline-block;
                        background: #ffffff;
                    }

                    p {
                        line-height: 30px !important;
                        font-size: 16px;
                        color: #222;
                        padding: 10px;
                    }
                </style>
                <table width="100%" style="border-collapse:collapse;font-size:20px; max-width:800px" border="0" cellpadding="3" cellspacing="0">

                    <tr>
                        <td align="center" colspan="2">
                            <b style="line-height:40px;color:#222;">
                                ग्राम सेवा सहकारी समिति लि. {{GopalCreditCardModel.PACSName_ENG}}<br />
                                मौका रिपोर्ट
                            </b>
                        </td>
                    </tr>
                    <tr>
                        <td align="right" colspan="2">
                            आवेदन संख्या:  {{GopalCreditCardModel.RegistrationNo}}&ensp;&ensp;
                        </td>
                    </tr>
                    <tr>
                        <td align="left" colspan="2">
                            <p>
                                आज दिनांक .............................. को आवेदक श्री/श्रीमती <b>{{GopalCreditCardModel.Name_HI}}</b> पुत्र श्री <b>{{GopalCreditCardModel.FatherName_HI}}</b>
                                निवासी <b>{{GopalCreditCardModel.HouseBuildingNo}}{{GopalCreditCardModel.LaneStreetName}} {{GopalCreditCardModel.Address_ENG}} {{GopalCreditCardModel.PinCode}} {{GopalCreditCardModel.Village_HI}} {{GopalCreditCardModel.DistrictName_HI}}</b> के  द्वारा गोपाल क्रेडिट कार्ड (GCC) योजनान्तर्गत समिति <b>{{GopalCreditCardModel.DCSName}}</b> में
                                राशि रू. <b><u>{{GopalCreditCardModel.LoanAmountRecommendedByDCS}}</u></b> के लिए प्रस्तुत आवेदन पत्र के आधार पर पशुओं  एवं   निवास स्थान का मेरे द्वारा मौका
                                देखा  गया है। जिसका विवरण निम्नानुसार है:-
                            </p>
                        </td>

                    </tr>
                    <tr>
                        <td colspan="2">
                            <p>
                                @*1. प्रार्थी श्री/श्रीमती <b>{{GopalCreditCardModel.Name_HI}}</b> ग्राम <b>{{GopalCreditCardModel.Village_HI}}</b> का मूल निवासी है तथा गत ..
        ............... वर्षो से ग्राम में निवासित है।<br />*@
                                1. आवेदक पैक्स कार्यक्षेत्र के ग्रामीण क्षेत्र का मूल निवासी है: हां/नहीं @*<b>{{GopalCreditCardModel.IsApplicantRuralResidence==true?'हां':'नहीं'}}</b>*@
                                <br />
                                @*2. प्रार्थी के पास <b>{{GopalCreditCardModel.NoOfbuffaloes}}</b> भैस (नस्ल) तथा <b>{{GopalCreditCardModel.NoOfCows}}</b> गाय (नस्ल) की है, तथा उक्त सभी पशु स्वस्थ है एवं  उन पर प्रार्थी का मालीकाना हक है।<br />*@
                                2. प्रार्थी के पास ................ भैस (नस्ल) तथा ................ गाय (नस्ल) की है, तथा उक्त सभी पशु स्वस्थ है एवं  उन पर प्रार्थी का मालीकाना हक है।<br />
                                3. प्रार्थी जीवित एवं स्वस्थ है तथा पशुओं की स्वयं देखभाल करता है।<br />
                                4. प्रार्थी के पास <b>{{GopalCreditCardModel.AgricultureLandDetailList[0].Irrigated}} hectares {{translation.Irrigated}} {{GopalCreditCardModel.AgricultureLandDetailList[0].NonIrrigated}} hectares {{translation.NonIrrigated}}</b> बीघा कृषि भूमि/मकान है।
                                जिसका वर्तमान मूल्य रू. ....................है, एवं स्वयं काबिज है।<br />
                                5. प्रार्थी द्वारा..................................दुग्ध उत्पादक सहकारी समिति लि.,..................................में नियमित रूप से  दुध दिया जा रहा है।<br />
                                6. श्री/श्रीमती <b>{{GopalCreditCardModel.GuarantorDetailsList[0].Name}}</b> पुत्र श्री <b>{{GopalCreditCardModel.GuarantorDetailsList[0].FatherSpouseName}}</b> निवासी <b>{{GopalCreditCardModel.GuarantorDetailsList[0].Address}}</b> एवं  श्री/श्रीमती <b>{{GopalCreditCardModel.GuarantorDetailsList[1].Name}}</b>
                                पुत्र श्री <b>{{GopalCreditCardModel.GuarantorDetailsList[1].FatherSpouseName}}</b> निवासी <b>{{GopalCreditCardModel.GuarantorDetailsList[1].Address}}</b> द्वारा उक्त ऋण, उसके ब्याज एवं अन्य खर्चो की पूर्ण चुकौती हेतु अपनी जमानत देने की सहमति दी गई है।
                                जिनकी सम्पत्ति क्रमशः ग्राम <b>{{GopalCreditCardModel.GuarantorDetailsList[0].GuarranterLandProperty}}</b> में
                                बीघा कृषि भूमि/मकान <b>{{GopalCreditCardModel.GuarantorDetailsList[1].GuarranterLandProperty}}</b> एवं ग्राम .......................................... में .................................... बीघा कृषि
                                भूमि/मकान है। जिसका अनुमानित मूल्य क्रमशः रू. ................................, रू. ................................ है एवं जमानतदार स्वयं काबिज है।<br />
                                7. प्राप्त जानकारी के अनुसार प्रार्थी एवं जमानदारों की साख एवं व्यवहार अच्छा है।<br />
                                8. अन्य..................................................................................................................................................................................................
                                ..................................................................................................................................................................................................................
                                ..............................................................
                            </p>

                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <p style="text-align:center">
                                <b>
                                    हस्ताक्षर मय सील<br /><br />
                                    नाम..................................................<br />
                                    व्यवस्थापक ग्राम सेवा सहकारी समिति लि
                                </b>
                            </p>
                        </td>
                    </tr>


                    <tr>
                        <td align="left" colspan="2">
                            <p style="line-height:40px">
                                पशुपालकों हेतु राजस्थान सहकारी गोपाल क्रेडिट कार्ड ऋण योजना अनुसार ऋण आवेदक के डेयरी स्थल का
                                मौका निरीक्षण दिनांक .............................. को किया गया, जिसमें योजनानुसार प्रस्तुत ऋण आवेदक  पत्र में प्रस्तुत
                                सम्पूर्ण विवरण का सत्यापन किया गया। आवेदक {{GopalCreditCardModel.Name_HI}} ग्राम सेवा सहकारी समिति का
                                सदस्य है तथा उपरोक्त प्रस्तुत विवरण अनुसार आवेदक के पक्ष में रू. ............................... की साख सीमा स्वीकृत
                                करने की अनुशंषा की जाती है। ऋण साख सीमा स्वीकृति उपरान्त ऋण सुरक्षा की दृष्टि से आवश्यक दस्तावेज
                                निष्पादन करवा लिये जायेंगे।
                            </p>
                        </td>

                    </tr>

                    <tr>
                        <td colspan="2">
                            <p style="line-height:40px; text-align:center">
                                <b>
                                    व्यवस्थापक&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;अध्यक्ष<br />
                                    .....................ग्राम सेवा सहकारी समिति लि.,.................<br />
                                    पंचायत समिति....................................(जयपुर)
                                </b>
                            </p>
                        </td>
                    </tr>
                </table>

            </div>
            @*<button id="download-pdf">Download as PDF</button>*@


        </div>
    </div>
</body>
</html>
<script>

    setTimeout(function () { window.print(); },
    5000)
</script>
@*<script>
        document.getElementById('download-pdf').addEventListener('click', function () {
            var element = document.getElementById('MokaReportView');
            html2pdf().from(element).save();
        });
    </script>*@
