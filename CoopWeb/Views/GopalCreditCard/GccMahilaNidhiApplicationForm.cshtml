                                            <input type="hidden" ng-model="GopalCreditCardModel.Name_ENG" />
                                            <input type="hidden" ng-model="GopalCreditCardModel.Name_HI" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.FatherSpouseName}}<span class="error">*</span>:</label>
                                            <input type="text" name="PashupalakFName" class="form-control disabled" disabled value="{{_language =='en-us' ?  GopalCreditCardModel.FatherName_ENG : GopalCreditCardModel.FatherName_HI}}" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.DOB}}/{{translation.Age}}<span class="error">*</span>:</label>
                                            <input type="text" name="PashupalakDOB" class="form-control disabled" disabled value="{{GopalCreditCardModel.DOB}}/{{GopalCreditCardModel.Age}}" autocomplete="off" />
                                        </div>
                                    </div>
