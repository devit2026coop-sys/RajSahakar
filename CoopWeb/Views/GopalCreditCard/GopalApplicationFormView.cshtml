                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in PLDBBranches | orderBy:'BLOCK_ENG'" value="{{itemBlock.Branch_ID}}">
                                            {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameEn}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.PACSName}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.PACS_ID" id="BranchId" class="form-control" ng-init="GopalCreditCardModel.PACS_ID='0'" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in PACSNameList | orderBy:'BLOCK_ENG'" value="{{itemBlock.PACS_ID}}">
                                            {{_language =='en-us' ?  itemBlock.PACSNameEn : itemBlock.PACSNameEn}}
                                        </option>
                                    </select>
