                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in ShgBlockList | orderBy:'BLOCK_ENG'" value="{{itemBlock.BLOCK_ID}}">
                                            {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label>
