                                <label for="IsMahilaNidhiMemberNo"><input type="radio" ng-value="false" disabled ng-model="GopalCreditCardModel.IsMahilaNidhiMember" name="chkIsMahilaNidhiMember" ng-click="MahilaNidhiMember(0)" checked>{{translation.No}}</label>
                            </h5>
