@{
    ViewBag.Title = "MAP GCC Application SSOID";
}
<script src="~/Scripts/AngularFramework/MapGcc.js?v=1.10"></script>
<script>
    function myFunctionsdsdsd() {
        confirm("Press a button!");
    }
    function getCapturedData(fpData) {
        alert(JSON.stringify(fpData));
        alert(fpData);
        $("#hdnFP").val(fpData.fpResult);
    }
    $(function () {
        $('.hide-show').show();
        $('.hide-show span').addClass('show')

        $('.hide-show span').click(function () {
            if ($(this).hasClass('show')) {
                $(this).text('Hide');
                $('input[name="login[password]"]').attr('type', 'text');
                $(this).removeClass('show');
            } else {
                $(this).text('Show');
                $('input[name="login[password]"]').attr('type', 'password');
                $(this).addClass('show');
            }
        });

        $('form button[type="submit"]').on('click', function () {
            $('.hide-show span').text('Show').addClass('show');
            $('.hide-show').parent().find('input[name="login[password]"]').attr('type', 'password');
        });
    });
</script>

<script type="text/javascript">
    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

    function AlphaNumericOnly(control) {
        var letterNumber = /^[0-9a-zA-Z]+$/;
        if ($(control).val().match(letterNumber)) {
            return true;
        }

        return true;
    }
</script>
<style type="text/css">
    .show {
        display: block;
        float: right;
        margin-left: -27px;
        margin-top: -19px;
        margin-right: 11px;
        position: relative;
        z-index: 2;
    }
</style>
<div ng-app="UserSocietyMappingValidModule">
    <input type="hidden" id="hdnFP" />
    <div ng-controller="UserSocietyMappingValidCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="../Citizen/Index"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">Gcc Mapping </span>
                    </li>

                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-lg-12 form-group">
                        @*<div class="col-md-2">
                                <label>
                                    {{translation.District}} :
                                </label>
                            </div>
                            <div class="col-md-2">
                                <select class="form-control" ng-model="ddlDistrct" ng-change="BlockList()" ng-options="_language == 'en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL for item in Districts">
                                    <option value="" disabled>{{translation.SelectOption}}-</option>
                                </select>
                            </div>*@
                        <div class="col-lg-2">
                            <label style="color:black">{{translation.Gcc}} {{translation.RegistrationNo}}:</label>
                        </div>
                        <div class="col-lg-4">
                            <input type="text" name="SocietyName" class="form-control" ng-model="MapRegistrationNo" placeholder="{{translation.RegistrationNo}}">
                        </div>

                        <button type="submit" class="btn btn-primary dev-btn" ng-click="GetGccForMap();">{{translation.Search}}</button>
                    </div>
                    <div class="col-lg-12" ng-if="SocietyDetails.length>0" style="margin-left:0px;">
                        <label style="font-size: 20px;    color: red;" ng-if="SocietyDetails[0].ssoid!=''">Society already mapped with SSO Id "{{SocietyDetails[0].ssoid}}"</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12" ng-show="RequestForMAPList!=null">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <table id="tblData" class="table devtable" style="margin-top: 10px;border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th class="info_news_slh_table_fix">Sr No.</th>
                                <th>Registration No</th>
                                <th>Name</th>
                                <th>FatherName</th>
                                <th>Address</th>
                                <th>SSOID</th>
                                <th>DOB</th>
                                <th>Status</th>
                                <th>Mobile No</th>
                                <th>Gender</th>
                                <th colspan="2" style="text-align:center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in RequestForMAPList">
                                <td>{{$index+1}}</td>
                                <td>{{item.RegistrationNo}}</td>
                                <td>{{item.Name_ENG}}</td>
                                <td>{{item.FatherName_ENG}}</td>
                                <td>{{item.Address_ENG}}</td>
                                <td>{{item.SSOID}}</td>
                                <td>{{item.DOB}}</td>
                                <td>{{item.ProceesStatusTextEn}}</td>
                                <td>{{item.MobileNo}}</td>
                                <td>{{item.Gender}}</td>
                                <td style="text-align:center"><a ng-click="ApplicationView(item.GccIdEnc)"><i class="fa fa-eye"></i> </a></td>
                                <td style="text-align:center"><a ng-click="showTransModel(item)"><i class="fa fa-edit"></i></a></td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="RequestForMAPList.length==0">
                            <tr>
                                <td colspan="12" align="center" class="text-danger">
                                    No record found.
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="dev-popup-body modal fade" id="transModals" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearMenuForm()">&times;</button>
                        <h4 class="modal-title"> SSO MAP Request </h4>
                        <input type="hidden" ng-modal="transCCSId" />
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" name="MySchemeForm" style="overflow: hidden;">
                            <div class="form-group col-md-12" style="margin-bottom: 5px;">
                                <label>SSO ID</label><br />
                                <input type="text" class="form-control" ng-model="SSOMAPRequest.MapSSOId" style=" width: 65%; float: left;" />
                            </div>
                            <div class="form-group col-md-12" style="margin-bottom: 5px;" ng-show="false">
                                <label>Status</label>
                                <select name="Status" ng-model="SSOMAPRequest.Status" class="form-control">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option value="1">Approve</option>
                                    <option value="2">Reject</option>
                                </select>
                            </div>
                            <div class="form-group col-md-12" style="margin-bottom: 5px;">
                                <div class="form-group">
                                    <label>{{translation.Remarks}}</label>
                                    <textarea name="AddressEn" id="textareaid" class="form-control validateNewAdd" rows="2" placeholder="description" ng-model="SSOMAPRequest.TransferRemarks" autocomplete="off"> </textarea>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <div class="dev-menu-btn">
                                        <button type="submit" class="btn btn-primary" ng-click="SubmitSSOMAPRequest()">{{translation.Submit}}</button>
                                        <button type="submit" class="btn btn-primary" ng-click="ClearTransFormForm()">{{translation.Clear}}</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>


