                                        <button type="button" class="btn btn-primary" ng-click="SaveGSSApplicationFlowStatus()">{{translation.Submit}}</button>
                                        <button type="button" class="btn btn-primary" ng-click="BackToPage()">{{translation.Back}}</button>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-md-6" ng-show="ShowOTPDiv">
                                    <label>{{translation.EnterOTP}}</label>
                                    <input type="text" class="form-control" name="Remarks" ng-bind="OTP" ng-model="ApplicationFlowMaster.OTP" placeholder={{translation.EnterOTP}} autocomplete="off" /><br />
                                    <button type="button" class="btn btn-primary" ng-click="VerifyOTP()">{{translation.Submit}}</button>
                                    <button type="button" class="btn btn-primary" ng-click="SaveGSSApplicationFlowStatus()">{{translation.ReSendOTP}}</button>

                                </div>
                            </div>
                        </form>
                    </div>
                </fieldset>

                <div class="dev-menu-btn" style="margin-top: 20px" ng-show="BaseUserId!=ApplicationFlowMaster.UserId || BaseRoleId!=ApplicationFlowMaster.RoleId">
                    <button type="button" class="btn btn-primary dev-btn" ng-click="BackToPage()">{{translation.Back}}</button>
                </div>
            </div>

        </div>

    </div>


</div>


