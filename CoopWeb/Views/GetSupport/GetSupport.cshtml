<script src="~/Scripts/AngularFramework/SupportData.js"></script>
<script type="text/javascript" src="~/Scripts/1.8.3.jquery.min.js"></script>

<style>
    .exportExcel {
        padding: 5px;
        border: 1px solid grey;
        margin: 5px;
        cursor: pointer;
    }
    .grid {
        font-family: "Trebuchet MS", Arial, Helvetica, sans-serif;
        border-collapse: collapse;
    }

        .grid td, #customers th {
            border: 1px solid #ddd;
            padding: 5px;
        }

        .grid tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .grid tr:hover {
            background-color: #ddd;
        }

        .grid th {
            padding: 10px;
            text-align: center;
            background-color: #f1574b;
            color: white;
            border: 1px solid #ddd;
        }
    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        padding: 8px;
        line-height: 1.42857143;
        vertical-align: top;
        border-top: 1px solid #ddd;
        color: black;
    }
</style>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>

<div ng-app="Support" ng-controller="SData">
    <div class="form-group">
        <div class="col-md-12">
            <table width="100%" class="table table-responsive devtable">
                <tr>
                    <td width="25%" style="text-align:left" >
                        Username
                    </td>
                    <td width="25%" style="text-align:left">
                        <input type="text" id="txtUsername" ng-model="SupportUsername" autocomplete="off" placeholder="User Name" />
                    </td>
                    <td width="25%" style="text-align:left">
                        Password
                    </td>
                    <td width="25%" style="text-align:left">
                       <input type="password" id="txtPassword" ng-model="SupportPassword" autocomplete="off" />
                    </td>
                </tr>
                <tr>
                    <td width="75%" colspan="3">
                        <textarea name="title" cols="12" ng-model="SupportList.WhereClause" style="width:100%; height:125px;" class="col-xs-10 col-sm-8 form-control"></textarea>
                    </td>
                    <td class="form-group col-md-4">
                        <button type="submit" class="btn btn-primary dev-btn" ng-click="Support()">EXECUTE</button>
                        <br />
                        <br />
                        <button type="submit" class="btn btn-primary dev-btn" ng-click="ClearForm()">CLEAR</button>
                    </td>
                </tr>
                <tr>
                    <td colspan="4" ng-show="ShowbtnExport">
                        <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                    </td>
                </tr>
            </table>
        </div>
    </div>
    {{SupportList.Data}}
    <div style="min-width:100%;overflow-x :scroll;" id="tblgetsuport">
        <table class="grid table table-responsive devtable" cellpadding="0" cellspacing="0" >
            <tr>
                <th data-ng-repeat="i in range">
                    {{i}}
                </th>
            </tr>
            <tr ng-repeat="item in myJson">
                <td data-ng-repeat="i in range">
                    {{item[i]}}
                </td>
            </tr>
        </table>
    </div>
</div>
