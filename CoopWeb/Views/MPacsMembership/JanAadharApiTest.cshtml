                            <div class="col-sm-6">
                                <label>
                                    {{translation.JanAadharNumberDetail}} :
                                </label>
                                <input type="text" id="txtJanAadharNo" ng-model="JanAadharNo" ng-value="JanAadharNo | DEC" class="form-control" placeholder="{{translation.JanAadharNumber}}" maxlength="10" />
