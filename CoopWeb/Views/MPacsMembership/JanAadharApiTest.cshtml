                                    </th>
                                    <th>
                                        {{translation.Name}}
                                    </th>
                                    <th width="120">
                                        {{translation.SelectMember}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @*<tr ng-repeat="li in JanMemberList | filter: filterByAge | orderBy:'NAME'">*@
                               
                                <tr ng-repeat="li in JanMemberList  | orderBy:'Name' ">
                                    <td>
                                        {{pageSize *(currentPage-1)+$index+1}}
