@{
    ViewBag.Title = "M.PACS Membership Registration";
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}

<script src="~/Scripts/AngularFramework/JanAadharApiTest.js?v=1.3"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>


<style>
    .citizen-dash-head {
        padding: 15px;
    }

    @@media print {

        .profile-d1 {
            color: #000 !important;
            background: #fff !important;
            border-radius: 5px !important;
            margin-bottom: 20px !important;
        }

        .profile-d1-hr {
            font-size: 17px !important;
            background: #025e63 !important;
            padding: 10px 15px !important;
            color: #fff !important;
            border-radius: 4px !important;
        }

        .dev-spancon {
            font-size: 13px !important;
            color: #424242 !important;
            font-weight: 500 !important;
        }

        label {
            color: #025e63 !important;
            font-size: 14px !important;
        }

        .devtable thead tr th {
            background: #64c0c5 !important;
            color: #fff !important;
        }

        .col-lg-12, .col-md-12, .col-sm-12, .col-xs-12 {
            display: block !important;
            width: auto !important;
            height: auto !important;
            overflow: visible !important;
        }

        .table-responsive {
            display: block !important;
            width: auto !important;
            height: auto !important;
            overflow: visible !important;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            border-top: unset !important;
        }

        .main-header {
            display: none !important;
        }

        .sidebar {
            display: none !important;
        }

        .dev-toggle-bg {
            display: none !important;
        }

        .printhideth {
            display: none !important;
        }

        .copydev {
            display: none !important;
        }

        .print {
            display: none !important;
        }

        .devpage-breadcrumb {
            display: none !important;
        }

        .visible-print {
            display: block !important;
        }

        table.visible-print {
            display: table !important;
        }

        tr.visible-print {
            display: table-row !important;
        }

        th.visible-print,
        td.visible-print {
            display: table-cell !important;
        }
    }

    @@media screen and (max-width: 767px) {
        body {
            font-size: 14px !important;
        }
    }
</style>

<style>
    @@media print {
        .visible-print {
            display: block !important
        }

        table.visible-print {
            display: table !important
        }

        tr.visible-print {
            display: table-row !important
        }

        td.visible-print, th.visible-print {
            display: table-cell !important
        }
    }

    .visible-print-block {
        display: none !important
    }

    @@media print {
        .visible-print-block {
            display: block !important
        }
    }

    .visible-print-inline {
        display: none !important
    }

    @@media print {
        .visible-print-inline {
            display: inline !important
        }
    }

    .visible-print-inline-block {
        display: none !important
    }

    @@media print {
        .visible-print-inline-block {
            display: inline-block !important
        }
    }

    @@media print {
        .hidden-print {
            display: none !important
        }
    }

    .profile-d1 {
        color: #000;
        background: #fff;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    .profile-d1-hr {
        font-size: 17px;
        background: #025e63;
        padding: 10px 15px;
        color: #fff;
        border-radius: 4px;
    }

    .dev-spancon {
        font-size: 13px;
        color: #424242;
        font-weight: 500;
    }

    label {
        color: #025e63;
        font-size: 14px;
    }

    .devtable thead tr th {
        background: #64c0c5;
        color: #fff;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        border-top: unset;
    }
</style>

<style>
    .radio-box {
        display: flex;
        gap: 10px;
        margin-top: 5px;
    }
</style>

<div ng-app="mPacsMod" ng-controller="mPacsCnt">
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h4 class="citizen-dash-head"> Co-operative Membership Campaign/सहकार सदस्यता अभियान </h4>
            <input type="hidden" id="EUserType" value="@ViewBag.usertype" />
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.OtherServices}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">M.PACS Member Registration Form </span>
                    </li>
                    <li style="float: right;" ng-hide="ShowMPacsForm||ShowJanAadharOTPValidation">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" ng-click="ShowForm()"> <h4>&#187; {{_language =='en-us' ? 'Click here for a new Membership':'नई सदस्यता के लिए यहां क्लिक करें'}}</h4> </button>
                    </li>
                    <li style="float: right;" ng-show="ShowMPacsForm||ShowJanAadharOTPValidation">
                        <button type="button" class="btn btn-primary btn-xs dev-btn" ng-click="ShowMPacsForm=false;mPacs={};ShowJanAadharOTPValidation=false;divGrid=true;"> Back </button>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divGrid">
            <div class="citizen-dash-head" id="search-filter">
                <div class="col-lg-4">
                    <label for="search" class="ng-binding">Search Member:</label>
                    <input type="text" id="search" name="searchText" class="form-control" ng-model="Filter.SearchText" placeholder="Search by member name, reference no." autocomplete="off">
                </div>

                <div class="col-lg-4">
                    <label>&nbsp;</label><br>
                    <button type="button" ng-click="GetMPacsApplicationDetailBySSO()" class="btn btn-primary dev-btn ng-binding"> {{translation.Search}} </button>
                    <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding"> {{translation.Clear}} </button>
                </div>
            </div>
            <div class="citizen-dash-head">
                <div class="table-responsive">
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.ApplicantName}}
                                </th>
                                <th>
                                    {{translation.FatherName}}
                                </th>
                                <th>
                                    {{translation.DOB}}
                                </th>
                                <th>
                                    {{translation.MobileNo}}
                                </th>
                                <th>
                                    {{translation.District}}
                                </th>
                                <th>
                                    {{translation.MembershipNo}}
                                </th>
                                <th>
                                    Submitted Date
                                </th>
                                <th>
                                    {{translation.Status}}
                                </th>
                                <th>
                                    {{translation.View}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="li in mPacsDataList">
                                <td>{{$index+1}}</td>
                                <td>{{ li.Name | uppercase }}</td>
                                <td>{{ li.FatherName | uppercase }}</td>
                                <td>{{ li.DOB }}</td>
                                <td>{{ li.MobileNo }}</td>
                                <td>{{ li.DistrictName }}</td>
                                <td>{{li.ReferenceNo}}</td>
                                <td>{{li.CreationDate|date:'dd-MM-yyyy'}}</td>
                                <td>{{li.Status}}</td>
                                <td>
                                    <i class="fa fa-eye" ng-click="ViewMemberApplication(li.EncId)"></i>
                                </td>
                            </tr>
                            <tr ng-show="mPacsDataList==null || mPacsDataList.length==0">
                                <td colspan="10">
                                    <div class="text-center text-danger">No record available.</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
    <div class="row">
        <div class="col-md-12" id="printpdf">
            <div class="table-responsive citizen-dash-head">
                <form id="mPacsForm" ng-submit="SaveMPacsMembershipData()" ng-show="ShowMPacsForm">
                    <div class="row" ng-show="divViewShow==false">
                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> Personal Detail </h5>
                        </div>
                        <div class="col-lg-12" id="PersonalDetail">
                            <div class="row">
                                <div class="col-md-10">
                                    <div class="row">
                                        <div class="col-md-4 form-group">
                                            <label for="memName">{{translation.Name}}<span class="error">*</span>:</label>
                                            <input type="text" id="memName" class="form-control disabled" disabled ng-model="mPacs.Name" autocomplete="off" required />
                                            <input type="hidden" ng-model="mPacs.Name" />
                                        </div>
                                        <div class="col-md-4">
                                            <label for="gender">{{translation.Gender}}<span class="error">*</span>:</label>
                                            <div class="radio-box" ng-init="mPacs.Gender='Male'">
                                                <label for="genderM">
                                                    <input type="radio" id="genderM" name="gender" value="Male" class="disabled" disabled ng-model="mPacs.Gender" required /> Male
                                                </label>
                                                <label for="genderF">
                                                    <input type="radio" id="genderF" name="gender" value="Female" class="disabled" disabled ng-model="mPacs.Gender" required />Female
                                                </label>
                                                <label for="genderO">
                                                    <input type="radio" id="genderO" name="gender" value="Other" class="disabled" disabled ng-model="mPacs.Gender" required />Other
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label for="memDOB">{{translation.DOB}}/{{translation.Age}}<span class="error">*</span>:</label>
                                                <div style="display:flex;gap:10px">
                                                    <input type="text" id="memDOB" class="form-control disabled" disabled value="{{mPacs.DOB}}" autocomplete="off" style="width:auto" required />
                                                    <input type="text" id="memAge" class="form-control disabled" disabled value="{{mPacs.Age}}" autocomplete="off" style="width:80px" required />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 form-group">
                                            <label for="memFName">{{translation.FatherSpouseName}}<span class="error">*</span>:</label>
                                            <input type="text" id="memFName" class="form-control disabled" disabled ng-model="mPacs.FatherName" autocomplete="off" required />
                                        </div>
                                        <div class="col-md-2 form-group">
                                            <label for="memCat">{{translation.Category}} <span class="error">*</span></label>
                                            <select class="form-control" id="memCat" ng-model="mPacs.CategoryId" ng-init="mPacs.CategoryId='0'" disabled required>
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item1 in CategoryList" value="{{item1.CODEID}}">
                                                    {{_language =='en-us' ?  item1.CODENAME : item1.CODENAME_MANGAL}}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="col-md-2 form-group">
                                            <label for="memMob">{{translation.MobileNo}}<span class="error">*</span>:</label>
                                            <input type="text" id="memMob" ng-minlength="10" maxlength="10" onkeypress="return event.charCode >= 48 && event.charCode <= 57" onpaste="return false;" ondrop="return false;" class="form-control disabled" placeholder="{{translation.MobileNo}}" ng-model="mPacs.MobileNo" disabled autocomplete="off" />
                                        </div>
                                        <div class="col-lg-4">
                                            <label>{{translation.EducationalQualification}}<span class="error">*</span></label>
                                            <select id="ddlEducationQualification" ng-model="mPacs.EducationalQualificationId" class="form-control" ng-init="mPacs.EducationalQualificationId='0'" required>
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item in EducationQualification | orderBy:'QualificationId'" value="{{item.QualificationId}}">
                                                    {{_language =='en-us' ?  item.QualificationEng : item.QualificationHi}}
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-4">
                                            <div class="form-group">
                                                <label>Nominee Name <span class="error">*</span></label>
                                                <input type="text" name="Business" class="form-control" placeholder="Nominee Name" ng-model="mPacs.NomineeName" autocomplete="off" required>
                                            </div>
                                        </div>
                                        <div class="col-lg-4">
                                            <div class="form-group">
                                                <label>Nominee Father/Husband Name <span class="error">*</span></label>
                                                <input type="text" name="Business" class="form-control" placeholder="Nominee Father Name" ng-model="mPacs.NomineeFatherName" autocomplete="off" required>
                                            </div>
                                        </div>
                                        <div class="col-lg-4">
                                            <div class="form-group">
                                                <label>{{translation.NomineeRelation}} <span class="error">*</span></label>
                                                <select id="ddlNomineeRelation" ng-model="mPacs.NomineeRelationId" class="form-control" ng-init="mPacs.NomineeRelationId='0'" required>
                                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                                    <option ng-repeat="item in BloodRelation | orderBy:'Id'" value="{{item.Id}}">
                                                        {{_language =='en-us' ? item.RelationEng : item.RelationHi}}
                                                    </option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2 text-center" ng-show="mPacs.PhotoPath!=null && mPacs.PhotoPath!=''">
                                    <img src="~/Content/MPacsMember/{{mPacs.MemberPhoto}}" style="border: 1px solid #cccccc; border-radius: 10px; height: 140px; width: 100px;" />
                                </div>
                                <div class="col-md-2 text-center" ng-show="mPacs.Photo_Base64!=null && mPacs.Photo_Base64!=''">
                                    <img src="{{(mPacs.Photo_Base64!=null && mPacs.Photo_Base64!='')?'data:image/jpg;base64,' + mPacs.Photo_Base64:'../content/images/dummyImg.jpg'}}" style="border: 1px solid #cccccc; border-radius: 10px; height: 140px; width: 100px;" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <h5 class="heading-hr ng-binding"> Permanent Address</h5>
                        </div>
                        <div class="col-lg-12" id="Address">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mt-2 mb-2" ng-init="mPacs.IsRural=1">
                                        <label class="">
                                            <input type="radio" name="IsRural" ng-value="0" ng-model="mPacs.IsRural" ng-change="RuralUrbanBlock(false)" ng-disabled="mPacs.IsAddressSameAsJanAadhar">{{translation.Urban}}
                                        </label>
                                        <label class="">
                                            <input type="radio" ng-value="1" name="IsRural" ng-model="mPacs.IsRural" ng-change="RuralUrbanBlock(true)" ng-disabled="mPacs.IsAddressSameAsJanAadhar">{{translation.Rural}}
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.HouseBuildingNo}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="HouseBuildingNo" ng-model="mPacs.HouseBuildingNo" placeholder="{{translation.HouseBuildingNo}}" autocomplete="off">
                                </div>
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.LaneStreetName}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="LaneStreetName" ng-model="mPacs.LaneStreetName" placeholder="{{translation.LaneStreetName}}" autocomplete="off">
                                </div>
                                <div class="col-md-4 form-group">
                                    <label>{{translation.Address}}<span class="error">*</span>:</label>
                                    <input type="text" class="form-control " ng-model="mPacs.Address" value="{{mPacs.Address}}" autocomplete="off" placeholder="{{translation.Address}}" ng-disabled="mPacs.IsAddressSameAsJanAadhar" required />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.Locality}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" ng-model="mPacs.Locality" placeholder="{{translation.Locality}}" autocomplete="off" required>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.District}}<span class="error">*</span></label>
                                    <select ng-model="mPacs.DistrictId" class="form-control" ng-init="mPacs.DistrictId='0'" ng-disabled="mPacs.IsAddressSameAsJanAadhar" ng-change="ResetDataForAddress(1,2)" required>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="row" ng-show="RuralDiv">
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.BlockHeading}}<span class="error">*</span> </label>
                                    <select ng-model="mPacs.BlockId" id="ddlblocki" class="form-control" ng-init="mPacs.BlockId='0'" ng-change="GetGramPanchayatList(mPacs.BlockId)" ng-disabled="mPacs.IsAddressSameAsJanAadhar" ng-required="mPacs.IsRural">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Blocksdata | orderBy:'BLOCK_ENG'" value="{{item.BLOCK_ID}}">
                                            {{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.GramPanchayatHeading}}<span class="error">*</span></label>
                                    <select ng-model="mPacs.GpId" id="ddlGP" class="form-control" ng-init="mPacs.GpId='0'" ng-change="GetVillageList(mPacs.GpId)" ng-disabled="mPacs.IsAddressSameAsJanAadhar" ng-required="mPacs.IsRural">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in GramPanchayats | orderBy:'GP_ENG'" value="{{item.GP_ID}}">
                                            {{_language =='en-us' ?  item.GP_ENG : item.GP_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label>{{translation.Village}}<span class="error">*</span></label>
                                    <select ng-model="mPacs.VillageId" id="ddlVillage" class="form-control" ng-init="mPacs.VillageId='0'" ng-disabled="mPacs.IsAddressSameAsJanAadhar" ng-required="mPacs.IsRural">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Villages | orderBy:'VILLAGE_ENG'" value="{{item.VILLAGE_ID}}">
                                            {{_language =='en-us' ?  item.VILLAGE_ENG : item.VILLAGE_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="row" ng-show="UrbanDiv">
                                <div class="col-md-4 form-group">
                                    <label>{{translation.City}}<span class="error">*</span></label>
                                    <select ng-model="mPacs.CityId" class="form-control" ng-change="GetWardList(mPacs.CityId)" ng-init="mPacs.CityId='0'" ng-disabled="mPacs.IsAddressSameAsJanAadhar" ng-required="mPacs.IsRural==false">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in CityList" value="{{item.CITY_ID}}">
                                            {{_language =='en-us' ?  item.CITY_ENG : item.CITY_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label>{{translation.Ward}}<span class="error">*</span></label>
                                    <select ng-model="mPacs.WardId" class="form-control" ng-init="mPacs.WardId='0'" ng-disabled="mPacs.IsAddressSameAsJanAadhar && mPacs.WardId!='0'" ng-required="mPacs.IsRural==false">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Ward" value="{{item.WARD_ID}}">
                                            {{_language =='en-us' ?  item.WARD_ENG : item.WARD_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label class="control-label">{{ translation.PIN}}<span class="error">*</span></label>
                                    <input type="text" name="PinCode" class="form-control" onpaste="return false" ng-model="mPacs.PinCode" ng-disabled="mPacs.IsAddressSameAsJanAadhar && mPacs.PinCode!=''" placeholder="{{translation.PIN}}" maxlength="6" ng-minlength="6" onkeypress='return event.charCode >= 48 && event.charCode <= 57' autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <h5 class="heading-hr ng-binding"> Present Address</h5>
                            <label><input type="checkbox" ng-model="mPacs.IsAddressSameAsPermanent" id="IsAddressSameAsPermanent" ng-click="IsAddressSameAsPermanent_Changed()"> Same as Permanent Address</label>
                        </div>
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mt-2 mb-2" ng-init="mPacs.PresentIsRural=1">
                                        <label class="">
                                            <input type="radio" name="PresentIsRural" ng-value="0" ng-model="mPacs.PresentIsRural" ng-change="PresentRuralUrbanBlock(false)" ng-disabled="mPacs.IsAddressSameAsPermanent">{{translation.Urban}}
                                        </label>
                                        <label class="">
                                            <input type="radio" ng-value="1" name="PresentIsRural" ng-model="mPacs.PresentIsRural" ng-change="PresentRuralUrbanBlock(true)" ng-disabled="mPacs.IsAddressSameAsPermanent">{{translation.Rural}}
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.HouseBuildingNo}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="PresentHouseBuildingNo" ng-model="mPacs.PresentHouseBuildingNo" ng-disabled="mPacs.IsAddressSameAsPermanent" placeholder="{{translation.HouseBuildingNo}}" autocomplete="off">
                                </div>
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.LaneStreetName}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="PresentLaneStreetName" ng-model="mPacs.PresentLaneStreetName" ng-disabled="mPacs.IsAddressSameAsPermanent" placeholder="{{translation.LaneStreetName}}" autocomplete="off">
                                </div>
                                <div class="col-md-4 form-group">
                                    <label>{{translation.Address}}<span class="error">*</span>:</label>
                                    <input type="text" class="form-control" ng-model="mPacs.PresentAddress" value="{{mPacs.PresentAddress}}" ng-disabled="mPacs.IsAddressSameAsPermanent" placeholder="{{translation.Address}}" autocomplete="off" required />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label>{{ translation.Locality}}<span class="error">*</span></label>
