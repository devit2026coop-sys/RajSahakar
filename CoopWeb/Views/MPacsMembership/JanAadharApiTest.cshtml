                                    <td>
                                        {{_language =='en-us' ?  li.NAME_EN : li.NAME_LL}}
                                    </td>
                                    <td align="center">
                                        <input type="radio" name="select"  ng-click="VerifyOTPViewPopup('',li.Encrypted_JAN_MEMBER_ID, li.Encrypted_JAN_AADHAR,li)" >

                                        @*<input type="radio" name="select" ng-disabled="li.Age<18 || li.Encrypted_MOBILE_NO==''" ng-click="VerifyOTPViewPopup(li.Masked_MOBILE_NO,li.Encrypted_JAN_MEMBER_ID, li.Encrypted_JAN_AADHAR,li)" title="{{li.Age==0?translation.GCCAge0Message:(li.Age<18?translation.GCCRegistrationMsg_Age_18:'')}}">*@
