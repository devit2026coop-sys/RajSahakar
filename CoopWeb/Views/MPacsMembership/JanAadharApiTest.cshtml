    </div>
    <div class="dev-popup-body modal fade" id="modelPopupVerifyOTP" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" ng-click="SendAndVerifyOTP={}">&times;</button>
                    <h4 class="modal-title"> {{translation.VerifyJanAadharOTP}} </h4>
                </div>
                <div class="modal-body">
                    <form id="otpVerifyForm" class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;">
                        <div class="col-md-12">
                            <label>
                                {{translation.MobileNo}} :
                            </label>
                            <input type="text" id="txtMasked_MOBILE_NO" ng-model="SendAndVerifyOTP.Masked_MOBILE_NO" class="form-control" disabled />
                        </div>
                        <div class="col-md-12 mt-4" ng-if="SendAndVerifyOTP.tid!=''">
                            <label>
                                {{translation.EnterOTP}} :
                            </label>
                            <input type="password" id="txtJanAadharOTP" placeholder="******" ng-if="SendAndVerifyOTP.tid!=''" ng-model="SendAndVerifyOTP.JanAadharOTP" class="form-control" onkeypress='return (event.charCode >= 48 && event.charCode <= 57)' maxlength="6" ng-minlength="6" required />
                        </div>
                        <div class="form-group mb-0">
                            <div class="dev-align-btn">
                                <span id="countdown" style="color:red" class="d-inline-block"></span>
                            </div>
                        </div>
                        <div class="col-md-12 text-center">
                            <button type="submit" id="btnSendOTP" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-disabled="SendAndVerifyOTP.Masked_MOBILE_NO==''" ng-if="SendAndVerifyOTP.tid==''" ng-click="GenrateJanAadharOTP()">{{translation.SendOTP}}</button>
                            <button type="submit" id="btnReSendOTP" class="btn btn-primary dev-btn" style="margin-top: 25px; display:none;" ng-click="GenrateJanAadharOTP()">{{translation.ReSendOTP}}</button>
                            <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-if="SendAndVerifyOTP.tid!=''" ng-click="ValidateJanAadharOTP()">{{translation.VerifyOTP}}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_JanAadhaarValidation")

<script>
    function printpage() {
        var divToPrint = document.getElementById("printTable");
        newWin = window.print();
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();
    }

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };
</script>