<div ng-app="mPacsMod" ng-controller="mPacsCnt">
    <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
    <input type="hidden" id="hdnLevelId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />
    <input type="hidden" id="hdnCcbId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).GccId)" />
    <input type="hidden" id="hdnUserId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId)" />
    <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />

    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h4 class="citizen-dash-head"> Co-operative Membership Campaign/सहकार सदस्यता अभियान </h4>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.OtherServices}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">M.PACS Membership Application List </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divViewShow==false">
            <div class="citizen-dash-head" id="search-filter">
                @*<div class="col-md-3">
                        <label>{{translation.District}}:</label>
                        <select ng-model="search.districtId" name="DistrictId" class="form-control" ng-disabled="isDistrictDisabled" ng-init="search.districtId='0'" ng-change="pagechange()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="li in DistrictList | orderBy:'DISTRICT_ENG'" value="{{li.DISTRICT_ID}}" ng-selected="li.DISTRICT_ID==selectedDistrictId">
                                {{_language =='en-us' ?  li.DISTRICT_ENG : li.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>*@
                <div class="col-md-3" ng-hide="hdnLevelId==9">
                    <label>
                        {{translation.BankName}}
                    </label>
                    <select ng-model="search.MPacsBankId" class="form-control" ng-init="search.MPacsBankId='0'" ng-disabled="isBankDisabled" ng-change="GetCcbBranchList()">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in BankList | orderBy:'CCBNameEn'" value="{{item.CCBId}}">
                            {{_language =='en-us' ?  item.CCBNameEn : item.CCBNameHi}}
                        </option>
                    </select>
                </div>
                <div class="col-md-3" ng-hide="hdnLevelId==9">
                    <label>
                        {{translation.BankBranch}}
                    </label>
                    <select ng-model="search.MPacsBranchId" class="form-control" ng-init="search.MPacsBranchId='0'" ng-disabled="isBranchDisabled" ng-change="pagechange()">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in BranchList | orderBy:'BranchNameEn'" value="{{item.Branch_ID}}">
                            {{_language =='en-us' ?  item.BranchNameEn : item.BranchNameHi}}
                        </option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="search" class="ng-binding">Search Member:</label>
                    <input type="text" id="search" name="searchText" class="form-control" ng-model="Filter.SearchText" placeholder="Search by member name, reference no." autocomplete="off">
                </div>

                <div class="col-md-3">
                    <label>&nbsp;</label><br>
                    <button type="button" ng-click="GetMPacsApplicationDetailByUser()" class="btn btn-primary dev-btn ng-binding"> {{translation.Search}} </button>
                    <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding"> {{translation.Clear}} </button>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-10 col-xs-7">
                    <div class="col-md-5">
                        <label><input type="radio" id="four" name="ApplicationStatus" ng-model="ApplicationStatus" value="PA" ng-init="ApplicationStatus='PS'" ng-click="GetMPacsApplicationDetailByUser();">Pending All&nbsp;</label>
                        <label><input type="radio" id="five" name="ApplicationStatus" ng-model="ApplicationStatus" checked="checked" value="PS" ng-click="GetMPacsApplicationDetailByUser();">Pending Self</label>
                    </div>

                </div>
                <div class="col-md-2 col-xs-5">
                    <label for="search">{{translation.ItemPerPage}}:</label>
                    <select ng-model="obj.pageSize" class="form-control" ng-change="pagechange()" ng-init="obj.pageSize='50'">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="500">500</option>
                        <option value="1000">1000</option>
                    </select>
                </div>
            </div>
            <div class="citizen-dash-head">
                <table class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.ApplicantName}}
                            </th>
                            <th>
                                {{translation.FatherName}}
                            </th>
                            <th>
                                {{translation.DOB}}
                            </th>
                            <th>
                                {{translation.MobileNo}}
                            </th>
                            <th>
                                {{translation.District}}
                            </th>
                            <th>
                                {{translation.ReferenceNo}}
                            </th>
                            <th>
                                Submitted Date
                            </th>
                            <th>
                                {{translation.Status}}
                            </th>
                            <th>
                                {{ ApplicationStatus=='PS' ? translation.TakeAction :   translation.View}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="li in mPacsDataList| filter:q | orderBy:colsort:reverseSort | itemsPerPage: obj.pageSize" current-page="currentPage" pagination-id="mpacsdatalist">
                            <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                            <td>{{ li.Name | uppercase }}</td>
                            <td>{{ li.FatherName | uppercase }}</td>
                            <td>{{ li.DOB }}</td>
                            <td>{{ li.MobileNo }}</td>
                            <td>{{ li.DistrictName }}</td>
                            <td>{{li.ReferenceNo}}</td>
                            <td>{{li.CreationDate|date:'dd-MM-yyyy'}}</td>
                            <td>{{li.Status}}</td>
                            <td>
                                @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId != 1)
                                {
                                    <i class="{{ApplicationStatus == 'PS' ?  'fa fa-edit' :'fa fa-eye'}}" ng-click="ViewMemberApplication(li.EncId)"></i>
                                }
                                else
                                {
                                    <i class="fa fa-eye" ng-click="ViewMemberApplication(li.EncId)"></i>
                                }
                            </td>
                        </tr>
                        <tr ng-show="mPacsDataList==null || mPacsDataList.length==0">
                            <td colspan="10">
                                <div class="text-center text-danger">No record available.</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate" style="display: flex; align-items: center; justify-content: space-between;">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important; margin:0">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Prev</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',SearchData)" style="cursor: pointer;">
                                    <span>« First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,SearchData)" style="cursor:pointer;">
                                    <span>« Prev</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,SearchData)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,SearchData)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,SearchData)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>


        </div>
