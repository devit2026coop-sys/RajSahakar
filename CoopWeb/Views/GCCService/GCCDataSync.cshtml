@{
    ViewBag.Title = "GCC-Service-Data-Sync";
}

<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }

    .tblthfont {
        font-weight: bold;
    }

    .button-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .button-group .btn {
            padding: 10px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
        }
</style>
<script src="~/Scripts/AngularFramework/GCCDataSync.js?v=1"></script>
<div ng-app="GCCSyncDataMod" ng-controller="GCCSyncDataCtrl" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; GCC Service Data Sync</b>
                <div class="text-right">
                    <button ng-click="Refresh()" class="btn btn-primary dev-btn">Refresh</button>
                </div>
            </div>
            <div class="panel-body">
                <div class="row g-12">
                    <div class="col-lg-4 col-md-4 col-sm-12">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title text-start mb-3">Master Sync Data</h4>
                                <div class="form-group">
                                    <label class="control-label">DCCB Name</label>
                                    <select ng-model="search.dccb_code" class="form-control" required>
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in dccbdataList" value="{{item.CCBId}}">
                                            {{item.DistrictName}}
                                        </option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="control-label">Jan MemberId</label>
                                    <input type="text" ng-model="search.jan_member_id" class="form-control" required placeholder="Enter jan member id" autocomplete="off" />
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-success w-100" ng-click="syncGCCData()">
                                        GCC Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8 col-md-8 col-sm-12">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title text-start mb-3">Master Data List</h4>
                                <div class="table-responsive devtable">
                                    <table class="table table-hover table-striped table-bordered mb-0">
                                        <thead>
                                            <tr>
                                                <th width="60">Sr.No</th>
                                                <th>Bank Name</th>
                                                <th>OD Status </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item in rsobdataList track by $index">
                                                <td><span ng-hide="item.BankName=='Total'">{{$index+1}}.</span></td>
                                                <td ng-style="(item.BankName == 'Total') && {'font-weight': 'bold', 'color': 'black'}">{{item.BankName}}</td>
                                                <td ng-style="(item.BankName == 'Total') && {'font-weight': 'bold', 'color': 'black'}">{{item.YesStatus}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>