@{
    ViewBag.Title = "KVSS Audit Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .kvss-page {
        padding: 12px;
        background: #f4f6f7;
        color: #222;
        font-family: Arial,'Noto Sans Devanagari',sans-serif;
    }

        .kvss-page * {
            box-sizing: border-box;
        }

    .kvss-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        padding: 10px;
        background: #fff;
        border: 1px solid #ddd;
        margin-bottom: 10px;
    }

        .kvss-toolbar label {
            margin: 0 6px 0 0;
            color: #222;
        }

        .kvss-toolbar input {
            width: 110px;
            height: 32px;
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 5px;
            color: #222;
        }

    .kvss-muted {
        margin-left: 12px;
        font-size: 12px;
        color: #555;
    }

    .kvss-tabs {
        display: flex;
        margin-bottom: 10px;
    }

    .kvss-tab {
        padding: 10px 15px;
        border: 1px solid #ccc;
        background: #fff;
        color: #222;
        cursor: pointer;
    }

        .kvss-tab.active {
            color: #007c83;
            font-weight: bold;
            border-bottom: 3px solid #007c83;
        }

    .kvss-actions {
        display: flex;
        gap: 7px;
    }

    .kvss-action {
        background: #0096a4;
        color: #fff;
        border: 0;
        border-radius: 3px;
        padding: 9px 13px;
        cursor: pointer;
    }

        .kvss-action:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .kvss-scroll {
        overflow-x: auto;
        background: #fff;
    }

    .kvss-table {
        border-collapse: collapse;
        table-layout: fixed;
        width: 100%;
        min-width: 850px;
    }

        .kvss-table th, .kvss-table td {
            border: 1px solid #d5d5d5;
        }

        .kvss-table thead th {
            background: #167f7e;
            color: #fff !important;
            padding: 11px 8px;
            text-align: center;
        }

        .kvss-table thead .kvss-title {
            background: #005e57;
            font-size: 15px;
        }

        .kvss-table tbody td {
            padding: 7px 8px;
            color: #222 !important;
            background: #fff;
            vertical-align: middle;
        }

    .kvss-main-row:nth-of-type(odd) td {
        background: #f3f5f5;
    }

    .kvss-particular {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 34px;
        gap: 8px;
    }

    .kvss-particular-name {
        flex: 1;
        color: #222 !important;
        overflow-wrap: anywhere;
    }

    .kvss-row-add {
        width: 35px;
        height: 35px;
        flex: 0 0 35px;
        border: 0;
        border-radius: 50%;
        background: #15945b;
        color: #fff;
        font-size: 22px;
        font-weight: 700;
        line-height: 35px;
        text-align: center;
        padding: 0;
        cursor: pointer;
    }

        .kvss-row-add:hover {
            background: #107847;
        }

        .kvss-row-add:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .kvss-particular-name strong {
        color: #005e57;
    }

    .kvss-english {
        color: #555;
        font-size: 12px;
    }

    .kvss-amount {
        width: 100%;
        height: 34px;
        padding: 5px 8px;
        border: 1px solid #cbd0d4;
        border-radius: 4px;
        text-align: right;
        background: #fff;
        color: #222;
    }

        .kvss-amount[readonly] {
            background: #eaf0ef;
            font-weight: bold;
        }

    .kvss-breakup-cell {
        padding: 0 !important;
        background: #fff !important;
        vertical-align: top !important;
    }

    .kvss-breakup-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ebebeb;
        padding: 8px 10px 8px 30px;
        color: #222;
    }

    .kvss-breakup-line {
        display: grid;
        grid-template-columns: minmax(0,70fr) minmax(0,30fr);
        gap: 0;
        padding: 8px 8px;
        background: #fff;
        align-items: center;
    }

    .kvss-breakup-name-wrap {
        min-width: 0;
        padding-left: 22px;
        padding-right: 8px;
    }

    .kvss-breakup-line .kvss-breakup-name {
        width: 100%;
        min-width: 0;
    }

    .kvss-breakup-amount-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .kvss-breakup-line .kvss-breakup-value {
        flex: 1 1 auto;
        width: 100%;
        min-width: 0;
        text-align: right;
    }

    .kvss-breakup-line input {
        height: 34px;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 6px 9px;
        color: #222;
        background: #fff;
    }

    .kvss-breakup-amount-wrap .kvss-circle.remove {
        flex: 0 0 34px;
    }

    .kvss-circle {
        border: 0;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        color: #fff;
        font-weight: bold;
        cursor: pointer;
    }

        .kvss-circle.add {
            background: #168c55;
            font-size: 21px;
        }

        .kvss-circle.remove {
            background: #dc3049;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

        .kvss-circle:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .kvss-breakup-total {
        text-align: right;
        padding: 5px 48px 7px 8px;
        font-size: 12px;
        color: #555;
    }

    .kvss-message {
        padding: 14px;
        color: #555;
        text-align: center;
    }

    .kvss-error {
        padding: 10px;
        background: #fff0f0;
        border: 1px solid #e6aaaa;
        color: #9c2222;
        margin-bottom: 10px;
    }

    @@media (max-width:700px) {
        .kvss-breakup-name-wrap {
            padding-left: 8px;
        }

        .kvss-breakup-line {
            padding: 7px 4px;
        }

        .kvss-breakup-amount-wrap {
            gap: 4px;
        }

            .kvss-breakup-amount-wrap .kvss-circle.remove {
                width: 28px;
                height: 28px;
                flex-basis: 28px;
            }
    }

    /* Reference screenshot: page title, breadcrumb, white card and tab/action toolbar */
    .kvss-page {
        padding: 10px 14px 16px;
        background: #ebedef;
    }

    .kvss-page-title {
        background: #fff;
        border-radius: 5px;
        padding: 8px 10px;
        margin-bottom: 14px;
        color: #111;
        font-size: 19px;
        font-weight: 700;
        line-height: 1.35;
    }

    .kvss-breadcrumb {
        display: flex;
        align-items: center;
        gap: 9px;
        background: #fff;
        border-radius: 5px;
        padding: 12px 10px;
        margin-bottom: 15px;
        color: #9aa0aa;
        font-size: 13px;
    }

    .kvss-home-icon {
        font-size: 19px;
        color: #9aa0aa;
        line-height: 1;
    }

    .kvss-chevron {
        font-size: 19px;
        color: #b4bac1;
    }

    .kvss-content-card {
        background: #fff;
        border-radius: 5px;
        padding: 10px;
    }

    .kvss-card-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 13px;
        border-bottom: 1px solid #e5e5e5;
    }

        .kvss-card-toolbar .kvss-tabs {
            display: flex;
            align-items: flex-end;
            margin-bottom: -1px;
        }

        .kvss-card-toolbar .kvss-tab {
            border: 1px solid transparent;
            border-bottom: 1px solid transparent;
            background: transparent;
            padding: 13px 19px;
            font-size: 13px;
            color: #222;
        }

            .kvss-card-toolbar .kvss-tab.active {
                border-color: #b8b8b8;
                border-bottom-color: #fff;
                border-radius: 4px 4px 0 0;
                color: #00818b;
                font-weight: 700;
            }

        .kvss-card-toolbar .kvss-actions {
            padding-bottom: 12px;
        }

        .kvss-card-toolbar .kvss-action {
            padding: 9px 15px;
            background: #1196a0;
            border-radius: 3px;
            font-size: 12px;
        }

    .kvss-year-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        color: #555;
        font-size: 12px;
        padding: 0 0 10px;
    }

        .kvss-year-meta label {
            margin: 0;
            font-weight: 600;
        }

        .kvss-year-meta input {
            width: 95px;
            height: 29px;
            border: 1px solid #d1d1d1;
            border-radius: 4px;
            padding: 4px 7px;
            color: #222;
            background: #fff;
        }

        .kvss-year-meta span {
            margin-left: 8px;
        }

    .kvss-table {
        margin: 0;
    }

        .kvss-table thead .kvss-title {
            background: #005e57;
            font-size: 13px;
            padding: 10px 8px;
        }

        .kvss-table thead th {
            background: #187f7d;
            padding: 10px 8px;
            font-size: 13px;
        }

        .kvss-table tbody td {
            padding: 7px 8px;
        }

    .kvss-main-row:nth-of-type(odd) td {
        background: #ebebeb;
    }
    /* Bottom total row and second set of action buttons */
    .kvss-table tfoot .kvss-total-row td {
        background: #005e57 !important;
        color: #fff !important;
        border: 1px solid #0c6961;
        padding: 10px 8px;
        font-size: 13px;
        font-weight: 700;
        text-align: left;
    }

        /* Debit & Credit Total Amount Right Align */
        .kvss-table tfoot .kvss-total-row td.kvss-total-amount {
            text-align: right !important;
            padding-right: 12px;
        }

    .kvss-bottom-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
        padding: 20px 12px 2px;
    }

        .kvss-bottom-actions .kvss-action {
            background: #1196a0;
            padding: 10px 16px;
            font-size: 12px;
        }

    @@media(max-width:767px) {
        .kvss-page-title {
            font-size: 16px;
        }

        .kvss-card-toolbar {
            align-items: stretch;
        }

            .kvss-card-toolbar .kvss-actions {
                width: 100%;
                justify-content: flex-end;
            }
    }

    /* One dedicated + column between Debit Amount and Credit Particulars */
    .kvss-table .kvss-add-column,
    .kvss-table .kvss-add-header,
    .kvss-table .kvss-breakup-spacer {
        text-align: center;
        padding: 4px 2px;
        vertical-align: middle;
    }

        .kvss-table .kvss-add-column .kvss-row-add {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 32px;
            height: 32px;
            min-width: 32px;
            line-height: 1;
            font-size: 22px;
        }

    .kvss-table .kvss-total-spacer {
        background: #005e57 !important;
    }

    /* Same-height Dr / Delete / Cr breakup rows */
    .kvss-table tbody td.kvss-paired-delete-cell {
        padding: 0 2px !important;
        background: #fff !important;
        vertical-align: top;
    }

    .kvss-paired-input-row {
        display: grid;
        grid-template-columns: minmax(0,70fr) minmax(0,30fr);
        align-items: center;
        min-height: 51px;
        padding: 8px 8px;
        gap: 0;
        border-bottom: 1px solid #eee;
    }

        .kvss-paired-input-row .kvss-breakup-name-wrap {
            padding-left: 22px;
            padding-right: 8px;
        }

        .kvss-paired-input-row .kvss-breakup-name,
        .kvss-paired-input-row .kvss-breakup-value {
            width: 100%;
            min-width: 0;
            height: 34px;
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 6px 9px;
            background: #fff;
            color: #222;
        }

        .kvss-paired-input-row .kvss-breakup-value {
            text-align: right;
        }

    .kvss-paired-delete-row {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 51px;
        border-bottom: 1px solid #eee;
    }

        .kvss-paired-delete-row .kvss-circle.remove {
            width: 30px;
            height: 30px;
            flex: 0 0 30px;
        }

    /* FINAL ALIGNMENT FIX: paired breakup grid follows the real table colgroup.
       Dr/Cr each span 34% Particular + 14% Amount. */
    .kvss-table .kvss-paired-breakup-row .kvss-paired-input-row {
        display: grid !important;
        grid-template-columns: minmax(0, 34fr) minmax(0, 14fr) !important;
        width: 100% !important;
        box-sizing: border-box !important;
        padding: 7px 0 !important;
        column-gap: 0 !important;
        align-items: center;
    }

    .kvss-table .kvss-paired-breakup-row .kvss-breakup-name-wrap {
        box-sizing: border-box !important;
        width: 100% !important;
        min-width: 0 !important;
        padding: 0 8px 0 30px !important;
    }

    .kvss-table .kvss-paired-breakup-row .kvss-breakup-amount-wrap {
        display: block !important;
        box-sizing: border-box !important;
        width: 100% !important;
        min-width: 0 !important;
        padding: 0 8px !important;
        margin: 0 !important;
    }

    .kvss-table .kvss-paired-breakup-row input.kvss-breakup-name,
    .kvss-table .kvss-paired-breakup-row input.kvss-breakup-value {
        display: block !important;
        box-sizing: border-box !important;
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        height: 34px !important;
        margin: 0 !important;
        float: none !important;
    }

    .kvss-table .kvss-paired-breakup-row input.kvss-breakup-value {
        text-align: right !important;
        flex: none !important;
    }
</style>

<input type="hidden" id="hdnSocietyId" value="@ViewBag.SocietyId" />
<input type="hidden" id="hdnFinancialYear" value="@ViewBag.FinancialYear" />

<div style="display:none">@Html.AntiForgeryToken()</div>

<div class="kvss-page" ng-app="KVSSAuditAccountModule" ng-controller="KVSSAuditAccountCont" ng-cloak>
    <!-- Page title and breadcrumb: matching the requested reference layout -->
    <div class="kvss-page-title">क्रय विक्रय सहकारी समिति लि. (KVSS), राजस्थान</div>
    <div class="kvss-breadcrumb">
        <span class="kvss-home-icon" aria-hidden="true">⌂</span>
        <span>Home</span><span class="kvss-chevron">›</span>
        <span>New</span><span class="kvss-chevron">›</span>
        <span class="kvss-current-page" ng-bind="AccountId === 1 ? 'Trading Account' : 'Profit & Loss Account'"></span>
    </div>

    <div class="kvss-content-card">
        <div class="kvss-card-toolbar">
            <div class="kvss-tabs">
                <button type="button" class="kvss-tab" ng-class="{'active':AccountId === 1}" ng-click="ChangeAccount(1)">Trading Account</button>
                <button type="button" class="kvss-tab" ng-class="{'active':AccountId === 2}" ng-click="ChangeAccount(2)">Profit &amp; Loss Account</button>
            </div>
            <div class="kvss-actions">
                <div>
                    <strong>Name of KVSS:</strong>
                    <span style="font-weight:bold; color:#1899a0;">
                        <label>@Session["AuditKVSSName"]</label>
                    </span>
                </div>
                <div>
                    <strong>Financial Year:</strong>
                    <span style="font-weight:bold; color:#1899a0;">
                        <label>@Session["FinancialYear"]</label>
                    </span>
                </div>
                <button type="button" class="kvss-action" ng-click="SaveAndNext()" ng-disabled="IsSaving || IsLoading || EntryStatus === 'Final'">Save &amp; Next</button>
                @*<button type="button" class="kvss-action" ng-click="SaveAsDraft()" ng-disabled="IsSaving || IsLoading || EntryStatus === 'Final'">Save as Draft</button>*@
                <button type="button" class="kvss-action" ng-show="AccountId == 2" ng-click="ChangeAccount(1)">Back</button>
                <button type="button" class="kvss-action" ng-show="AccountId == 1" ng-click="GoBack()">Back</button>
            </div>
        </div>
        @*<div class="kvss-year-meta">
                <label for="kvssReportingFY">Financial Year (Reporting):</label>
                <input id="kvssReportingFY" type="text" ng-model="ReportingFY" ng-change="OnReportingFYChange()" placeholder="2026-27" />
                <span>Amount Year: <strong>{{FinancialYear}}</strong></span>
                <span>Status: <strong>{{EntryStatus}}</strong></span>
            </div>*@
        <div class="kvss-error" ng-if="ErrorMessage">{{ErrorMessage}}</div>
        @*<div class="kvss-message" ng-if="IsLoading">Loading account particulars...</div>*@
        <div class="kvss-scroll">
            <table class="kvss-table" id="tblKVSSAccount">
                <colgroup><col style="width:34%" /><col style="width:14%" /><col style="width:4%" /><col style="width:34%" /><col style="width:14%" /></colgroup>
                <thead>
                    <tr><th colspan="5" class="kvss-title"><span ng-if="AccountId === 1">व्यापार खाता (Trading Account)</span><span ng-if="AccountId === 2">लाभ एवं हानि खाता (Profit &amp; Loss Account)</span></th></tr>
                    <tr><th>विवरण (Particulars) [Dr.]</th><th>गत वर्ष राशि (₹)</th><th class="kvss-add-header"></th><th>विवरण (Particulars) [Cr.]</th><th>गत वर्ष राशि (₹)</th></tr>
                </thead>
                <tbody>
                    <tr class="kvss-main-row" ng-repeat-start="row in AccountRows track by $index" ng-hide="(row.Debit && (row.Debit.ParticularNameEnglish || '').toLowerCase().trim() === 'total') || (row.Credit && (row.Credit.ParticularNameEnglish || '').toLowerCase().trim() === 'total') || (row.Debit && (row.Debit.ParticularNameEnglish || '').toLowerCase().trim() === 'grand total') || (row.Credit && (row.Credit.ParticularNameEnglish || '').toLowerCase().trim() === 'grand total')">
                        <td><div ng-if="row.Debit" class="kvss-particular" ng-style="{'padding-left':((row.Debit.Level || 0)*18)+'px'}"><span class="kvss-particular-name"><strong ng-if="row.Debit.IsCalculated">{{row.Debit.ParticularNameHindi}}</strong><span ng-if="!row.Debit.IsCalculated">{{row.Debit.ParticularNameHindi}}</span> <span class="kvss-english">({{row.Debit.ParticularNameEnglish}})</span></span></div></td>
                        <td><input ng-if="row.Debit && row.Debit.IsAmountApplicable" class="kvss-amount" type="number" min="0" step="0.01" ng-model="row.Debit.Amount" ng-change="OnAmountChange(row.Debit)" ng-readonly="IsAmountReadonly(row.Debit)" /></td>
                        <td class="kvss-add-column"><button type="button" class="kvss-row-add" ng-if="CanAddBothSideBreakup(row)" ng-disabled="EntryStatus === 'Final' || IsSaving || IsLoading" ng-click="AddBothSideBreakup(row)" title="Add Debit & Credit breakup">+</button></td>
                        <td><div ng-if="row.Credit" class="kvss-particular" ng-style="{'padding-left':((row.Credit.Level || 0)*18)+'px'}"><span class="kvss-particular-name"><strong ng-if="row.Credit.IsCalculated">{{row.Credit.ParticularNameHindi}}</strong><span ng-if="!row.Credit.IsCalculated">{{row.Credit.ParticularNameHindi}}</span> <span class="kvss-english">({{row.Credit.ParticularNameEnglish}})</span></span></div></td>
                        <td><input ng-if="row.Credit && row.Credit.IsAmountApplicable" class="kvss-amount" type="number" min="0" step="0.01" ng-model="row.Credit.Amount" ng-change="OnAmountChange(row.Credit)" ng-readonly="IsAmountReadonly(row.Credit)" /></td>
                    </tr>
                    <!-- Paired breakup: one delete button per index, between Dr and Cr -->
                    <tr ng-repeat-end ng-if="GetPairedBreakups(row).length > 0" class="kvss-paired-breakup-row">
                        <td colspan="2" class="kvss-breakup-cell">
                            <div class="kvss-paired-input-row" ng-repeat="b in GetPairedBreakups(row) track by $index">
                                <div class="kvss-breakup-name-wrap" ng-if="row.Debit && row.Debit.Breakups[$index]">
                                    <input class="kvss-breakup-name" type="text" placeholder="Enter Other Details"
                                           ng-model="row.Debit.Breakups[$index].BreakupName" ng-readonly="EntryStatus === 'Final'" />
                                </div>
                                <div class="kvss-breakup-amount-wrap" ng-if="row.Debit && row.Debit.Breakups[$index]">
                                    <input class="kvss-breakup-value" type="number" min="0" step="0.01" placeholder="Amount"
                                           ng-model="row.Debit.Breakups[$index].Amount"
                                           ng-change="UpdateInlineTotal(row.Debit)" ng-readonly="EntryStatus === 'Final'" />
                                </div>
                            </div>
                        </td>
                        <td class="kvss-breakup-spacer kvss-paired-delete-cell">
                            <div class="kvss-paired-delete-row" ng-repeat="b in GetPairedBreakups(row) track by $index">
                                <button type="button" class="kvss-circle remove" title="Delete Dr & Cr breakup row"
                                        ng-click="RemoveBothSideBreakup(row,$index)"
                                        ng-disabled="EntryStatus === 'Final' || IsSaving || IsLoading">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                        <td colspan="2" class="kvss-breakup-cell">
                            <div class="kvss-paired-input-row" ng-repeat="b in GetPairedBreakups(row) track by $index">
                                <div class="kvss-breakup-name-wrap" ng-if="row.Credit && row.Credit.Breakups[$index]">
                                    <input class="kvss-breakup-name" type="text" placeholder="Enter Other Details"
                                           ng-model="row.Credit.Breakups[$index].BreakupName" ng-readonly="EntryStatus === 'Final'" />
                                </div>
                                <div class="kvss-breakup-amount-wrap" ng-if="row.Credit && row.Credit.Breakups[$index]">
                                    <input class="kvss-breakup-value" type="number" min="0" step="0.01" placeholder="Amount"
                                           ng-model="row.Credit.Breakups[$index].Amount"
                                           ng-change="UpdateInlineTotal(row.Credit)" ng-readonly="EntryStatus === 'Final'" />
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr ng-if="!IsLoading && AccountRows.length === 0"><td colspan="5" class="kvss-message">No account particulars found.</td></tr>
                </tbody>
                <tfoot>
                    <tr class="kvss-total-row">
                        <td>योग (Total)</td>
                        <td class="kvss-total-amount">
                            {{TotalDebit | number:2}}
                        </td>
                        <td class="kvss-total-spacer"></td>
                        <td>योग (Total)</td>
                        <td class="kvss-total-amount">
                            {{TotalCredit | number:2}}
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="kvss-bottom-actions">
            <button type="button" class="kvss-action" ng-click="SaveAndNext()" ng-disabled="IsSaving || IsLoading || EntryStatus === 'Final'">Save &amp; Next</button>
            @*<button type="button" class="kvss-action" ng-click="SaveAsDraft()" ng-disabled="IsSaving || IsLoading || EntryStatus === 'Final'">Save as Draft</button>*@
            <button type="button" class="kvss-action" ng-click="GoBack()">Back</button>
        </div>
    </div><!-- /kvss-content-card -->
</div>
<script src="~/Scripts/AngularFramework/KVSSAuditAccount.js?v=@DateTime.Now.Ticks"></script>
