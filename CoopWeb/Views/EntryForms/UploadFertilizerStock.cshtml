
@{
    ViewBag.Title = "Upload Fertilizer Stock";
}

<script src="~/Scripts/AngularFramework/UploadFertilizerStock.js"></script>
<style>
    .UploadDate input {
        float: left;
        width: 90%;
    }

    .UploadDate button {
        float: left;
    }
</style>
<script>
    $(document).ready(function () {
        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            minDate: '-90'
        });
    });
</script>
<div ng-app="ExlUploadForSTLoanMod" ng-controller="ExlUploadForSTLoanCnt">
    <div class="col-md-12">
        <h3 class="citizen-dash-head"> {{translation.UploadFertilizerStock}}  </h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.Home}}</a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">   
                    <span style="margin: 0 5px;"> {{translation.UploadFertilizerStock}} </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-12 form-group">
        <div class="citizen-dash-head">
            <div class="col-md-2 UploadDate">
                <label>
                    {{translation.UploadDate}}<span class="error">*</span>
                </label>
                <input id="UploadDate" name="UploadDate" disabled="disabled" class="form-control SetCalender" placeholder="DD/MM/YYYY" autocomplete="off">
            </div>
            <div class="clearfix"></div>
            <br />
            <div class="col-md-4">
                <label>
                    {{translation.FertilizerOpeningStockExcel}}<span class="error">*</span>
                </label>
                <input type="file" style="width:680px; border:1px solid blue;" filetype='excel' name="File" id="fluBulkInsert" class="btn btn-outline-primary btn-lg active" ng-model="BulkInsert.BulkInsertFile" onchange="angular.element(this).scope().UploadBulkInsertFile(this.files)">
            </div>
            <div class="clearfix"></div>
            <br />
            <div class="col-md-4">
                <label>

                </label>
                <a id="ExlSampleLink" href="~/Content/EntryForms/StockData.xlsx">DownLoad Sample</a>
            </div>
        </div>
    </div>

    <div class="form-group col-md-12">
        <div class="dev-align-btn">
            <button type="submit" class="btn btn-primary dev-btn" ng-click="SaveBulkInsert()">{{ translation.Submit}}</button>
            <button type="button" class="btn btn-primary dev-btn" ng-click="ClearBulkInsertForm()">{{ translation.Clear}}</button>
            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back </a>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div class="form-group col-md-12" ng-show="ExlFileShow">
        <div class="citizen-dash-head table-responsive">
            <table class="table table-responsive devtable" style="margin-top: 30px;color:black" id="a">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                        <th>
                            {{translation.File}}
                        </th>
                        <th>
                            {{translation.CreationDate}}
                        </th>
                        <th>
                            {{translation.Total}}
                        </th>
                        @*<th>
                                {{translation.FailedRecord}}
                            </th>*@
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="itemm in SocityExcelDetailsData">
                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                        <td>
                            <a href="~/Content/SocietyExcel/{{itemm.ExcelSheetName}}">View File</a>
                        </td>
                        <td>{{itemm.CreationDate}}</td>
                        @*<td><a href="#" ng-click="GetExlSociety(itemm.Id,1)">{{itemm.TotSocieties}}{{itemm.FaildRecord}}</a></td>*@
                        <td><a href="#">{{itemm.FaildRecord}}</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

