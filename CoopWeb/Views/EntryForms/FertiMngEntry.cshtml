                                                <td>{{ items.TotStockEnd }}</td>
                                                <td><i class="fa fa-trash btn btn btn-xs tooltips" id="Remove_1" ng-click="DeleteFertiMNGReport(items.FertiMNGReportId)"></i></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="text-center">
                                    <dir-pagination-controls boundary-links="true" pagination-id="VillagePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>



