                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="FertiMng.TotReceipt" ng-change="AddStockVal()" onkeypress='return ((event.charCode >= 48 && event.charCode <= 57)|| event.which ==8 || event.keyCode ==8 || event.charCode==8 || event.keyCode ==46 || event.charCode==46)' >
                    </div>
                    <div class="col-lg-2">{{translation.TotSale}}</div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="FertiMng.TotSale"  ng-change="AddStockVal()" onkeypress='return ((event.charCode >= 48 && event.charCode <= 57)|| event.which ==8 || event.keyCode ==8 || event.charCode==8 || event.keyCode ==46 || event.charCode==46)' >
                    </div>
                </div>
