                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.FertilizerMNGReport}} </span>
                    </li>
                    <li style="float: right;">
                        <button type="button" ng-click="ShowEntryForm()" class="btn btn-info btn-lg dev-popup-btn" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;"> <h5>&#187; {{translation.AddNew}}</h5> </button>
                    </li>
