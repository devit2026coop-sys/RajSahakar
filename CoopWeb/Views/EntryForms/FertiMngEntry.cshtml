                    <div class="col-lg-2">{{translation.StockInHand}}</div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-disabled="StockHaveValue" ng-model="FertiMng.TotStockEnd" onkeypress='return ((event.charCode >= 48 && event.charCode <= 57)|| event.which ==8 || event.keyCode ==8 || event.charCode==8 || event.keyCode ==46 || event.charCode==46)' >
                    </div>
                </div>
