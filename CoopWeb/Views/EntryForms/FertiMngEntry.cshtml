                    </div>
                    <div class="col-lg-2">{{translation.BlockHeading}}</div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="FertiMng.BlockId" ng-change="GramPanchayatList(); GSSList();SetFertId();">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Blocks" value="{{item.BLOCK_ID}}">
                                {{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.KVSSMPRForm}}</div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="FertiMng.KVSSId" ng-change="SetFertId();">
