<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/AngularFramework/_AddressControl.js"></script>
<link href="~/Content/Stylesheets/ssoauth_style.min.css" rel="stylesheet" />
<script src="~/Scripts/ssoauth_inline.min.js"></script>
@model string

<div class="col-lg-12 form-group ng-scope" id="addr_@Model">
    <div class="form-group col-md-6">
        <label class="ng-binding"><span class="HOUSE_BUILDING_NUMBER_TXT">House/Building Number</span><span class="error">*</span></label>
        <input type="text" class="form-control" id="HouseBuildingNo_@Model" name="HouseBuildingNo" placeholder="House/Building Number">
    </div>
    <div class="form-group col-md-6">
        <label class="ng-binding"><span class="LANE_STREET_NAME_TXT"> Lane/Street Name</span><span class="error">*</span></label>
        <input type="text" class="form-control ng-pristine ng-untouched ng-valid ng-empty" id="LaneStreetName_@Model" name="LaneStreetName" placeholder="Lane/Street Name" autocomplete="off">
    </div>
    <div class="form-group col-md-6">
        <label class="ng-binding"><span class="LOCALITY_TXT">Locality</span><span class="error">*</span></label>
        <input type="text" class="form-control ng-pristine ng-untouched ng-valid ng-empty" id="Locality_@Model" name="Locality" placeholder="Locality" autocomplete="off">
    </div>
    <div class="form-group col-md-6">
        <label class="ng-binding"><span class="STATE_TXT">State</span><span class="error">*</span></label>
        <select id="ddlstate_@Model" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty">
            <option value="0" class="ng-binding">--- Select ---</option>
            <option value="6" class="ng-binding ng-scope">
                Rajasthan
            </option>
        </select>
    </div>
    <div class="form-group col-md-6">
        <label class="ng-binding"><span class="DIVISION_TXT">Division</span></label>
        <select id="ddlDivision_@Model" name="division" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty">
            <option value="0" class="ng-binding">--- Select ---</option>
            <option value="1" class="ng-binding ng-scope">
                Ajmer
            </option>
            <option value="2" class="ng-binding ng-scope">
                Bharatpur
            </option>
            <option value="3" class="ng-binding ng-scope">
                Bikaner
            </option>
            <option value="4" class="ng-binding ng-scope">
                Jaipur
            </option>
            <option value="5" class="ng-binding ng-scope">
                Jodhpur
            </option>
            <option value="6" class="ng-binding ng-scope">
                Kota
            </option>
            <option value="7" class="ng-binding ng-scope">
                Udaipur
            </option>
        </select>
    </div>
    <div class="form-group col-md-6">
        <label class="ng-binding"><span class="DISTRICT_TXT">District</span><span class="error">*</span></label>
        <select id="district_@Model" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty">
            <option value="0" disabled="" class="ng-binding">--- Select ---</option>
        </select>
    </div>
    <div class="form-group col-md-6">
   
            <label class="help-block-gender ng-binding" style="width:15% !important;">
                <input type="radio" id="sdfs" name="Rurals" value="1" onchange="getUrban()" class="ng-pristine ng-untouched ng-valid ng-empty"><span class="URBAN_TXT">Urban</span>
            </label>
            <label class="help-block-gender ng-binding" style="width:15% !important;">
                <input type="radio" id="sdf" value="2" name="Rurals" onchange="getRural()"><span class="RURAL_TXT">Rural</span>
            </label>
      
    </div>
    <div class="form-group col-md-6 Rurals_@Model">
        <label><span class="BLOCK_TXT"> Block </span></label>
        <select id="ddlblocki_@Model" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty"></select>
    </div>
    <div class="form-group col-md-6 Rurals_@Model">
        <label><span class="GRAMPANCHAYAT_TXT">GramPanchayat</span></label>
        <select id="ddlGP_@Model" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty"></select>
    </div>
    <div class="form-group col-md-6 Rurals_@Model">
        <label><span class="VILLAGE_TXT">Village</span></label>
        <select id="ddlVillage_@Model" class="form-control"></select>
    </div>
    <div class="form-group col-md-6 cityward_@Model">
        <label><span class="CITY_TXT">City</span><span class="error">*</span></label>
        <select id="ddlcity_@Model" class="form-control"></select>
    </div>
    <div class="form-group col-md-6 cityward_@Model">
        <label><span class="WARD_TXT">Ward</span><span class="error">*</span></label>
        <select id="ddlward_@Model" class="form-control"></select>
    </div>
    <div class="form-group col-md-6">
        <label class="control-label ng-binding"><span class="PIN_TXT">PIN</span><span class="error">*</span></label>
        <input type="text" name="PinCode" class="form-control ng-pristine ng-untouched ng-valid ng-empty ng-valid-minlength ng-valid-maxlength" id="pincode_@Model" placeholder="PIN" maxlength="6" ng-minlength="6" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
    </div>
</div>
