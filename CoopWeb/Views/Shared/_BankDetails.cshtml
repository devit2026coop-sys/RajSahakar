



        <div class="col-md-12 citizen-dash-head" ng-show="ShowAddNew">



            <div class="col-lg-12 form-group">
                <div class="col-md-6" ng-if="SocietyType==2">
                    <label>
                        {{translation.SocietyName}}
                    </label>
                    @*@Html.DropDownListFor(m => m.BankDetails.SocietyID, new SelectList(ViewBag.SocietyMasterList, "SocietyID", "SocietyName"), "--Select PLDB--", new { id = "SocietyID", @class = "form-control" })*@
                    <select ng-model="BankMaster.SocietyID" ng-disabled="IsSubmiApplication" id="SocietyID" class="form-control" ng-init="BankMaster.SocietyID='0'" >
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="itemPLDB in SocietyList | orderBy:'SocietyName'" value="{{itemPLDB.SocietyID}}">
                            {{itemPLDB.SocietyName}}
                        </option>
                    </select>
                </div>
                
                <div class="col-md-6" ng-if="SocietyType==1">
                    <label>
                        {{translation.PLDB}}
                    </label>
                    @*@Html.DropDownListFor(m => m.BankDetails.SocietyID, new SelectList(ViewBag.SocietyMasterList, "SocietyID", "SocietyName"), "--Select PLDB--", new { id = "SocietyID", @class = "form-control" })*@
                    <select ng-model="BankMaster.SocietyID" ng-disabled="IsSubmiApplication" id="SocietyID" class="form-control" ng-init="BankMaster.SocietyID='0'" ng-change="PLDBBranchList('0')">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="itemPLDB in PLDB | orderBy:'PldbId'" value="{{itemPLDB.PldbId}}">
                            {{itemPLDB.PLDBName}}
                        </option>
                    </select>
                </div>

                <div class="col-md-6" ng-if="SocietyType==1">
                    <label>
                        {{translation.PLDB}} {{translation.Branch}}
                    </label>
                    @*@Html.DropDownListFor(m => m.BankDetails.BranchId, new SelectList(ViewBag.PLDBBranch, "SocietyID", "SocietyName"), "--Select PLDB Branch--", new { id = "BranchId", @class = "form-control" })*@
                    <select ng-model="BankMaster.BranchId"  id="BranchId" class="form-control" ng-init="BankMaster.BranchId='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="itemBlock in PLDBBranches | orderBy:'BLOCK_ENG'" value="{{itemBlock.BLOCK_ID}}">
                            {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                        </option>
                    </select>
                </div>


                <div class="col-md-6">
                    <label>
                        {{translation.BankName}}
                    </label>
                    @*@Html.DropDownListFor(m => m.BankDetails.BankID, new SelectList(ViewBag.BankMasterList, "BankId", "BankName"), "--Select Bank--", new { id = "BankID", @class = "form-control" })*@
                    <select ng-model="BankMaster.BankID" ng-disabled="IsSubmiApplication" id="BankID" class="form-control" ng-init="BankMaster.BankID='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="itemBlock in BankMasterList | orderBy:'BLOCK_ENG'" value="{{itemBlock.BankId}}">
                            {{_language =='en-us' ?  itemBlock.BankName : itemBlock.BankName}}
                        </option>
                    </select>
                </div>
            </div>

            <div class="col-lg-12 form-group">
                <div class="col-md-6">
                    <label>
                        {{translation.BankBranch}}
                    </label>
                    @*@Html.TextBoxFor(m => m.BankDetails.BankBranch, new { @class = "form-control", id = "BankBranch", autocomplete = "off" })*@
                    <input type="text" id="BankBranch" class="form-control" placeholder="{{translation.BankBranch}}" ng-model="BankMaster.BankBranch" autocomplete="off">

                </div>
                <div class="col-md-6">
                    <label>
                        {{translation.IFSCCode}}
                    </label>
                    @*@Html.TextBoxFor(m => m.BankDetails.IFSCCode, new { @class = "form-control", id = "IFSCCode", autocomplete = "off" })*@
                    <input type="text" id="IFSCCode" class="form-control" placeholder="{{translation.IFSCCode}}" ng-model="BankMaster.IFSCCode" autocomplete="off">
                </div>
            </div>

            <div class="col-lg-12 form-group">
                <div class="col-md-6">
                    <label>
                        {{translation.BankAccountNo}}
                    </label>
                    @*@Html.TextBoxFor(m => m.BankDetails.BankAccountNo, new { @class = "form-control", id = "BankAccountNo", autocomplete = "off" })*@
                    <input type="text" id="BankAccountNo" class="form-control" placeholder="{{translation.BankAccountNo}}" ng-model="BankMaster.BankAccountNo" autocomplete="off">
                </div>
                <div class="col-md-6">
                    <label>
                        {{translation.AccountHolderName}}
                    </label>
                    @*@Html.TextBoxFor(m => m.BankDetails.AccHolderName, new { @class = "form-control", id = "AccHolderName", autocomplete = "off" })*@
                    <input type="text" id="AccHolderName" class="form-control" placeholder="{{translation.AccountHolderName}}" ng-model="BankMaster.AccHolderName" autocomplete="off">
                </div>
            </div>

            <div class="col-lg-12 form-group">
                <div class="col-md-6">
                    <label>
                        {{translation.IsActive}}
                    </label>
                    @*@Html.CheckBoxFor(m => m.BankDetails.IsActive, new { id = "IsActive" })*@
                    <input type="checkbox" id="IsActive" ng-model="BankMaster.IsActive" />
                </div>
            </div>


            <div class="col-lg-12" style="margin-top:20px;">
                <div class="form-group">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="Insert()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="BackToShow()">{{translation.Back}}</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="!ShowAddNew">
            <div class="citizen-dash-head">
                <table class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th ng-if="SocietyType==2">
                                {{translation.SocietyName}}
                            </th>
                            <th ng-if="SocietyType==1">
                                {{translation.PLDB}}
                            </th>

                            <th ng-if="SocietyType==1">
                                {{translation.PLDB}} {{translation.Branch}}
                            </th>

                            <th>
                                {{translation.BankName}}
                            </th>
                            <th>
                                {{translation.BankBranch}}
                            </th>
                            <th>
                                {{translation.IFSCCode}}
                            </th>
                            <th>
                                {{translation.BankAccountNo}}
                            </th>
                            <th>
                                {{translation.AccountHolderName}}
                            </th>
                            <th>
                                {{translation.Status}}
                            </th>

                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="Item in BankDetailList">
                            <td>{{$index+1}}</td>


                            <td ng-if="SocietyType==2">
                                {{Item.SocietyName}}
                            </td>
                            <td ng-if="SocietyType==1">
                                {{Item.PLDBName}}
                            </td>
                            <td ng-if="SocietyType==1">
                                {{Item.PLDBBranchName}}
                            </td>

                            <td>
                                {{Item.BankMaster_Name}}
                            </td>

                            <td>
                                {{Item.BankBranch}}
                            </td>

                            <td>
                                {{Item.IFSCCode}}
                            </td>

                            <td>
                                {{Item.BankAccountNo}}
                            </td>
                            <td>
                                {{Item.AccHolderName}}
                            </td>
                            <td>
                                <div class="dev-action">
                                    <label class="switch">
                                        <input type="checkbox" ng-checked="Item.IsActive == 1" ng-click="deleteDetails(Item.Id,Item.IsActive,'active')">
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </td>
                            <td class="add-more-td">
                                <a href="javascript:void(0);" name="editText" ng-click="update(Item)"><i class="fa fa-edit"></i></a>
                                <a href="javascript:void(0);" ng-click="deleteDetails(Item.Id,2,'delete')"><i class="fa fa-trash"></i></a>
                            </td>
                        </tr>
                        <tr ng-if="DataPagingDetails.TotalPages>1">
                            <td colspan="8">
                                <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                    <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                        Total Records: {{DataPagingDetails.TotalRecords}}
                                    </div>
                                    <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetGrievanceList)" style="cursor: pointer;">
                                            <span>«First</span>
                                        </li>
                                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetGrievanceList)" style="cursor:pointer;">
                                            <span>« Previous</span>
                                        </li>
                                        <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetGrievanceList)"><span>{{n}}</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetGrievanceList)" style="cursor:pointer;">
                                            <span>Next »</span>
                                        </li>
                                        <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetGrievanceList)" style="cursor:pointer;">
                                            <span>Last »</span>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
