
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <h4 class="citizen-dash-head"> {{translation.GrievanceRegistration}}</h4>
    <input type="hidden" id="EUserType" value="@ViewBag.usertype" />
</div>
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <div class="devpage-breadcrumb">
        <ul class="page-breadcrumb">
            <li class="dev-page-br">
                <i class="fa fa-home"> </i>
                <a href="#"> {{translation.OtherServices}} </a>
                <i class="fa fa-angle-right"> </i>
            </li>
            <li style="float: left">
                <span style="margin: 0 5px;">{{translation.GrievanceRegistration}} </span>

            </li>
            <li style="float: right;">
                <button type="button" class="btn btn-info btn-lg dev-popup-btn" ng-click="ShowForm()"> <h5>&#187; {{translation.AddNewGrievance}}</h5> </button>
            </li>
        </ul>
    </div>
</div>

<div class="col-lg-12" ng-show="divRegistration">
    <div class="table-responsive citizen-dash-head">
        <div id="divUserRegistration1">

            <form class="dev-masters" name="MyUserForm">
                <div class="col-lg-12 form-group">
                    <h4 class="heading-hr ng-binding">  {{translation.NewGrievance}}</h4>
                </div>
                <div ng-show="divParentDataSelection">
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2">{{ translation.SocietyName}} <span class="error">*</span></div>
                        <div class="col-lg-4">
                            <select class="form-control" ng-model="Grievance.SocietyIdENC" ng-init="Grievance.SocietyIdENC='0'">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in SocietyList" value="{{item.SocietyIdENC}}">
                                    {{item.SocietyName}}
                                </option>
                            </select>
                        </div>
                        <div class="col-lg-2">{{ translation.GrievanceCategory}} <span class="error">*</span></div>

                        <div class="col-lg-4">
                            <select ng-model="Grievance.GCategoryId" class="form-control" ng-init="Grievance.GCategoryId='0'">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in GrievanceCategoryList | orderBy:'CategoryNameEn'" value="{{item.GCategoryId}}">
                                    {{_language =='en-us' ?  item.CategoryNameEn : item.CategoryNameHi}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">
                        {{translation.Description}} <span class="error">*</span>
                    </div>
                    <div class="col-lg-4">
                        <textarea id="txtDescription" rows="6" cols="125" style="margin: 0px; width: 341px; height: 74px;resize:none;" placeholder="{{translation.Description}}" ng-model="Grievance.Description" maxlength="80" ng-minlength="1" autocomplete="off" onKeyPress="return ValidateAlpha(event);"> </textarea>
                    </div>
                    <div class="col-lg-2">
                        {{translation.AttachmentifAny}} <span class="error">*</span>
                    </div>
                    <div class="col-lg-4">
                        <input type="file" filetype='pdf' name="File" id="flAttachmentFile" class="form-control" ng-model="Grievance.AttachmentFile" onchange="angular.element(this).scope().UploadAttachmentFile(this.files)">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">
                        {{translation.MobileNo}} <span class="error">*</span>
                    </div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" placeholder="{{translation.MobileNo}}" ng-model="Grievance.MobileNo" ng-bind='@ViewBag.MobileNo' autocomplete="off" required ng-disabled="true" onkeypress='return ((event.charCode >= 48 && event.charCode <= 57)|| event.which ==8 || event.keyCode ==8 || event.charCode==8)' maxlength="10">
                    </div>
                   
                </div>
                <div class="form-group col-md-12" style="text-align:center;">
                    <button type="submit" class="btn btn-success" ng-click="SaveGrievance()">&nbsp;&nbsp;{{translation.Submit}}</button>
                </div>
            </form>
        </div>
    </div>
</div>



<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divGrid">

    <div class="citizen-dash-head">
        <table class="table table-responsive devtable">
            <thead>
                <tr>
                    <th>
                        {{translation.SRNO}}
                    </th>
                    <th>
                        {{translation.SocietyName}}
                    </th>
                    <th>
                        {{translation.GrievanceCategory}}
                    </th>
                    <th>
                        {{translation.SSOID}}
                    </th>
                    <th>
                        {{translation.MobileNo}}
                    </th>
                    <th>
                        {{translation.ComplaintNo}}
                    </th>
                    <th>
                        {{translation.Description}}
                    </th>
                    <th>
                        {{translation.Date}}
                    </th>

                    <th>
                        {{translation.File}}
                    </th>
                    <th>
                        {{translation.TakeAction}}
                    </th>
                </tr>
            </thead>           
            <tbody>
                <tr ng-repeat="Item in GrievanceDetailList">
                    <td>{{$index+1}}</td>
                    <td>{{ Item.SocietyName | uppercase }}</td>
                    <td>{{ Item.CategoryNameEn | uppercase }}</td>
                    <td>{{ Item.SSO_ID | uppercase }}</td>
                    <td>{{ Item.MobileNo | uppercase }}</td>
                    <td>{{ Item.ComplaintNo | uppercase }}</td>
                    <td>{{ Item.Discription | uppercase }}</td>
                    <td>{{ Item.CreationDate }}</td>
                                                
                                    
                    <td>
                        <a target="_blank" href="{{Item.AttachmentFileName}}"><i class="fa fa-eye"></i></a>
                    </td>
                    <td>
                        <i class="fa fa-eye" data-target="#myModal" data-toggle="modal" ng-click="ViewMemberApplication(Item.GrievanceId)"></i>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>



