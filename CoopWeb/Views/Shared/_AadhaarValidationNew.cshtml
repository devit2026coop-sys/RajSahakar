
@{
    Layout = null;
}


<style>
    .help-block-gender {
        margin-top: 5px;
        margin-bottom: 10px;
        color: #737373;
    }

    .modal-title {
        line-height: 30px;
    }

    .modal-body {
        background: #fff;
    }


        .modal-body span {
            color: #fff;
            padding-top: 10px;
            display: inline-block;
        }

    .pd30 {
        padding: 30px 0px;
    }

    .modal-footer {
        padding: 20px;
        text-align: center;
    }

    #ssoauth {
        background: transparent !important;
    }


    .modal-body .switch-field input:checked + label {
        background-color: #4caf50 !important;
        box-shadow: none;
    }
</style>

<script src="~/Scripts/AngularFramework/_AadhaarValidationNew.js?v=1"></script>
<link href="~/Content/Stylesheets/ssoauth_style.min.css" rel="stylesheet" />
<script src="~/Scripts/ssoauth_inline.min.js"></script>

<div style="display:none" id="dvAadhaarValidation">
    <div class="messagebox_overlay" id="dvAuthAllow" style="display:none; position: fixed; left: 0px; top: 0px; width: 100%; height: 100%; z-index: 99999999; background: rgba(0, 0, 0, 0.5);">
        <div class="messagebox" style="color: rgb(51, 51, 51); font-size: 14px; background: rgb(254, 254, 254); position: absolute; margin: auto; width: auto; max-width: 360px; min-width: 280px; left: 50%; top: 50%; border-radius: 5px; transform: translate(-50%, -50%); box-shadow: rgba(0, 0, 0, 0.4) 0px 0px 16px 2px;">
            <div class="messagebox_header" style="background: rgb(245, 245, 245); padding: 10px 15px; font-size: 16px; font-weight: bold; border-radius: 4px;">AADHAAR AUTH/ EKYC</div><div class="messagebox_content" style="padding: 12px; overflow-y: auto; border: 1px solid rgb(228, 228, 228); min-height: 60px;">
                <p id="AuthAllowMessage">Please allow system for your AADHAAR based Authentication/ eKYC.</p>
                <div class="messagebox_content_error" style="box-sizing: border-box; display: none;"></div>
            </div>
            <div class="messagebox_buttons" style="background: rgb(245, 245, 245); padding: 8px 15px; text-align: center; border-radius: 4px;">
                <button onclick="$('#dvAuthAllow').hide()" data-dismiss="messagebox_overlay" class="messagebox_button_done" style="box-sizing: border-box; min-width: 65px; background: rgb(48, 115, 173); color: rgb(255, 255, 255); padding: 5px 15px; border: 1px solid rgb(48, 115, 173); cursor: pointer; transition: all 0.3s ease-in-out 0s; box-shadow: rgba(156, 39, 176, 0.42) 0px 14px 26px -12px, rgba(0, 0, 0, 0.12) 0px 4px 23px 0px, rgba(156, 39, 176, 0.2) 0px 8px 10px -5px;">OK</button>
            </div>
        </div>
    </div>
    <div id="ssoauth_container" class="ssoauth_container" style="z-index: 9999999;">
        <div id="ssoauth" data-lang="en-US" class="loading-container-new ">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="switch-field pull-right" id="SSOAuth_rbtnListLang">
                            <input type="radio" id="SSOAuth_toggle_hindi" name="SSOAuth_ToggleLang" value="hi-in" checked />
                            <label for="SSOAuth_toggle_hindi">हिन्दी</label>
                            <input type="radio" id="SSOAuth_toggle_english" name="SSOAuth_ToggleLang" value="en-us" />
                            <label for="SSOAuth_toggle_english">Eng</label>
                        </div>
                        <h4 class="modal-title" id="aadharMask" style="color: #000;"></h4>
                    </div>
                    <div class="modal-body clearfix">
                        <div class="switch-field">
                            <input id="SSOAuth_rbtnListType_1" ng-model="Auth" type="radio" name="SSOAuth_rbtnListType" value="otp" checked class="ng-valid-parse">
                            <label id="lblSSOAuth_rbtnListType_1" style="width:100%;" for="SSOAuth_rbtnListType_1" onclick="OtpType('otp')"><div class="ssoauth-icon pd30"><img src="~/Content/Images/OTP.png"><br /><span>OTP</span></div></label>
                            @*Remove Bionmetric*@
                            @*<input id="SSOAuth_rbtnListType_2" ng-model="Auth" type="radio" name="SSOAuth_rbtnListType" value="BYO">
                                <label id="lblSSOAuth_rbtnListType_2" style="width:100%;" for="SSOAuth_rbtnListType_2" onclick="OtpType('BYO')"><div class="ssoauth-icon pd30"><img src="~/Content/Images/biometric.png"><br /><span>Aadhar Biometric</span></div></label>*@
                        </div>
                        @*<div id="Div_SSOAuth_chkConsent" class="checkbox-input"><span class="check-box"><input id="SSOAuth_chkConsent" type="checkbox" name="SSOAuth_chkConsent"><label for="SSOAuth_chkConsent">I hereby state that I have no objection in authenticating myself with AADHAAR based authentication system and consent to providing my AADHAAR Number, Biometric and/or OTP for AADHAAR based Authantication/ eKYC. I also give my explicit consent for accessing the mobile number and email address from AADHAAR System.</label></span></div>*@
                        <div id="Div_SSOAuth_chkConsent" class="checkbox-input"><span class="check-box"><input id="SSOAuth_chkConsent" type="checkbox" name="SSOAuth_chkConsent"><label for="SSOAuth_chkConsent">I hereby state that I have no objection in authenticating myself with AADHAAR based authentication system and consent to providing my AADHAAR Number, OTP for AADHAAR based Authantication/ eKYC. I also give my explicit consent for accessing the mobile number and email address from AADHAAR System.</label></span></div>

                        <div id="SSOAuth_OTP" style="text-align: center; display:none;"><input style="color: #000;" id="SSOAuth_OtpText" type="tel" class="ssoauth-otp-box" maxlength="6" placeholder="OTP (One Time Password)"></div>
                    </div>
                    <div class="modal-footer" id="SSOAuth_Buttons">
                        @*<div id="biosect" style="display:none;color: #000;">
                                <button onclick="VerifyOTPByBIO()" id="btnSSOAuth_Capture" type="button" class="btn btn-outline-primary" causesvalidation="false">Capture</button>
                                <button id="btnSSOAuth_Cancel" onclick="CloseOtpPopUp()" type="button" class="btnSSOAuth_Cancel btn btn-outline-primary" causesvalidation="false" data-dismiss="modal">Cancel</button>
                            </div>*@
                        <div id="otpsect" style="color: #000;">
                            <button onclick="GenrateOTP()" id="btnSSOAuth_SendOTP" type="button" class="btn btn-outline-primary" causesvalidation="false" style="">Send OTP</button>
                            <button onclick="VarifyOTP()" id="btnSSOAuth_ValidateOTP" type="button" class="btn btn-outline-primary" causesvalidation="false">Validate OTP</button>
                            <button onclick="GenrateOTP()" id="btnSSOAuth_ReSendOTP" type="button" class="btn btn-outline-primary" causesvalidation="false" style="display: none;">Resend OTP</button>
                            <button id="btnSSOAuth_Cancel" onclick="CloseOtpPopUp()" type="button" class="btnSSOAuth_Cancel btn btn-outline-primary" causesvalidation="false" data-dismiss="modal">Cancel</button>
                        </div>
                        <button id="btnSSOAuth_download" type="button" class="btn btn-outline-primary" style="display:none" causesvalidation="false">Download</button>
                        <a id="lnkSSOAuthDownload" class="btn btn-outline-primary" href="https://ssoauth.rajasthan.gov.in/auth/downloads" target="_blank" title="Downloads" style="text-decoration: none; display: none;">Downloads</a>
                    </div>
                    <div id="ssoauthloading" class="img-loading backdrop" style="display: none;"><div class="loading-container-new"><div class="loader-img"><img id="FPImage" src="~/Content/Images/prog.gif" alt="Loading..." style="width: 75px; height: 75px; vertical-align: middle;"></div></div></div>
                </div>
            </div>
        </div>
    </div>
</div>


