            font-size: 1.5rem;
        }

        .main-header {
            position: fixed;
            width: 100%;
            z-index: 99;
        }

        ::-webkit-scrollbar {
            width: 6px; /* width of the entire scrollbar */
        }

        ::-webkit-scrollbar-track {
            background: #1c4d3f; /* color of the tracking area */
        }

        ::-webkit-scrollbar-thumb {
            background-color: cadetblue; /* color of the scroll thumb */
            border-radius: 20px; /* roundness of the scroll thumb */
