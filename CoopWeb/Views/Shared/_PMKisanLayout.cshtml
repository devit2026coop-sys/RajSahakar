    <script type="text/javascript">

        window.history.forward();
        function noBack() {
            window.history.forward();
            window.onhashchange = function () { window.location.hash = "no-back-button"; }
        }
    </script>

    <script type="text/javascript">

        function ReadCookie(control) {

            if ($(control).children().first().attr('class') == "plus minus") {
                window.location = $(control).children().first().children().first().attr('href');
            }
            else {
                window.location = $(control).children().first().children().first().siblings().attr('href')
            }
        };

        function UserProfileChangeByRoleId(role) {
            $.ajax({
                url: "../Login/UserProfileChangeByRoleId",
                method: "POST",
                data: {
                    UserRoleDeptMappingId: role
                },
                dataType: "json",
                success: function (data) {
                    window.location = "../User/DashBoard";
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    window.location = "~/Error/General";
                }
            });
        }



        $(document).ready(function () {
            setInterval(function () {
                $.get("../login/CheckUserSession", function (data, status) {
                    if (data.Status == false) {
                        if (window.location.href.indexOf("DashBoard") > -1) {
                            window.location = "http://sso.rajasthan.gov.in/";
                        } else {
                            ShowOkMessage("", _language == 'en-us' ? "Your current session is logged out " : "आपका वर्तमान सेशन लॉग आउट हो गया  है", function () { window.location = "http://sso.rajasthan.gov.in/" });
                        }

                    }
                })
            }, 90000);
        });




        function getUrlVars() {
            var vars = [], hash;
            var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
            for (var i = 0; i < hashes.length; i++) {
                hash = hashes[i].split('=');
                vars.push(hash[0]);
                vars[hash[0]] = hash[1];
            }
            return vars;
        }

    </script>

    <script type="text/javascript">
        var _language = getlanguagefromcookie();
        var _translationData;
        if (_language === undefined)
            _language = 'en-us';

        _language = _language.toLowerCase();
        $.getJSON("/Scripts/Translations/" + (_language == 'hi-in' ? 'Translation_HI.json' : 'Translation_EN.json') + " ", function (data) {
            _translationData = data
        });
        $(document).ready(function () {



            // var _language = navigator.language || navigator.userLanguage; // get value from browser culture
            if (_language == 'en-us') {
                $('#LanguageToggle').text('Hindi Translation Link');
                $('#English').show();
                $('#Hindi').hide();
            }
            else if (_language == 'hi-in') {
                $('#LanguageToggle').text('हिन्दी अनुवाद लिंक');
                $('#English').hide();
                $('#Hindi').show();
            }
        });
        function NoBack() {
            window.history.forward();
        }
    </script>
    <style>
        .ErrorText {
