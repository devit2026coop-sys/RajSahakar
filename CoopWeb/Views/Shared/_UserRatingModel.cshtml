@*<script src="~/Scripts/jquery-1.7.1.js"></script>*@
<script src="~/Scripts/AngularFramework/ApplicationRating.js?ID=3"></script>

<style>
    .help-block-gender {
        margin-top: 5px;
        margin-bottom: 10px;
        color: #737373;
    }

    .modal-title {
        line-height: 30px;
    }

    .modal-body {
        background: #fff;
    }

        .modal-body span {
            color: #fff;
            padding-top: 10px;
            display: inline-block;
        }

    .pd30 {
        padding: 30px 0px;
    }


    #ssoauth {
        background: transparent !important;
    }


    .modal-body .switch-field input:checked + label {
        background-color: #4caf50 !important;
        box-shadow: none;
    }

    .pointer {
        cursor: pointer;
    }

    .setho:hover {
        font-size: 25px;
    }

    .ssoauth_container {
        background: rgba(0,0,0,.7);
        width: 100%;
        height: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 999;
    }

    #note {
        list-style: none;
        position: absolute;
        top: 57%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin: 0px;
        padding: 0px;
        z-index: 99;
    }

    #img1 {
        background: url("~/images/emojirating.png") no-repeat;
        display: inline-block;
    }
    /*.hoverset {
    }
    .hoverset:hover {
        background: url("~/images/green2emoji.jpg") no-repeat;
    }*/
    .new_model {
        text-align: center;
    }

        .new_model .col-auto {
            display: inline-table;
        }

            .new_model .col-auto input {
                position: relative;
                z-index: -9;
            }

            .new_model .col-auto img:hover {
                transform: scale(1.2);
            }

        .new_model .modal-footer {
            text-align: left;
            padding: 10px;
            background: rgb(238, 238, 238);
            margin-top: 15px;
        }

        .new_model h5 {
            color: #000;
            font-size: 24px;
        }

    .modal-dialog {
        margin-top: 10%;
    }

    .new_model strong {
        display: inline-block;
        max-width: 100%;
        margin-bottom: 5px;
        font-weight: 700;
        color: #000000;
        float: left;
        margin-bottom: 5px;
        text-align: left;
    }

    .new_model button.close {
        z-index: 99;
        width: 35px;
        height: 35px;
        position: absolute;
        background: #000;
        border-radius: 50px 50px 50px 50px;
        top: 5px;
        right: 0;
        opacity: 1;
    }

        .new_model button.close span {
            padding-top: 0;
        }

    .new_model .radio-inline {
        padding: 0 10px;
    }

    .new_model .col-auto p {
        color: #000;
        font-weight: 600;
    }

    .activesmil {
        border: 1px solid gray;
        border-radius: 36px;
        padding: 0px;
        padding-right: 1px;
        padding-top: 2px;
        padding-bottom: 1px;
        transform: scale(1.2);
    }

</style>

<script type="text/javascript">
    $(document).ready(function () {
        $(".clsrate").click(function () {
            $(".clsrate").removeClass("activesmil");
            $(this).addClass("activesmil");
        })
    });
</script>


<div id="Ratingmodel" class="modal ssoauth_container" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content" id="InnerModelPopup">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 style="margin: 0; line-height: 1.42857143;color: rebeccapurple;" id="modelHeader">Rating User</h4>
            </div>
            <div class="modal-body">
                <p style="margin: 0 12 10px;color: brown;font-size: 18px;" id="modelAlertMessage1">  </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" onclick="Closepopupsecuss()" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>

<div class="container">
    <!-- Button trigger modal -->
    <div class="row my-btn" style="display:none">
        <div class="col text-center "> <button type="button" id="btnShowPopUp" class="btn btn-primary " data-toggle="modal" data-target="#modelId">Launch Modal</button> </div>
    </div> <!-- Modal -->
    <div class="modal fade" id="modelId" tabindex="-1" role="dialog" aria-labelledby="modelTitleId" data-backdrop="static" data-keyboard="false" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content new_model">
                <div class="modal-body pl-5 mt-3">
                    <div class="col-lg-12" style="background-color:#18989F;">
                        <button type="button" class="close" onclick="closepopup()" data-dismiss="modal">×</button>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                        <h4 style="line-height: 1.42857143; color:#fff; float:left;" id="modelHeader">{{translation.HelpUs}}</h4>
                    </div>
                    <div class="row">
                        <div class="col text-center">

                            <p class="text-muted ">{{translation.Howyourexperience}}</p>
                        </div>

                    </div>
                    <div class="row justify-content-center">
                        <div class="col-auto example-block text-center">
                            <div class="col-auto example-block text-center"> <label class="radio-inline"> <input type="radio" name="emotion" id="happy" onclick="changeRate('1')" class="input-hidden" /> <img class="clsrate" src="~/Content/Images/angry.png" width="65" height="65"> </label> <p class="text-center">Very Poor</p></div>
                            <div class="col-auto example-block text-center"> <label class="radio-inline"> <input type="radio" name="emotion" id="sad" onclick="changeRate('2')" class="input-hidden" /><img class="clsrate" src="~/Content/Images/sad.png" width="65" height="65"></label><p class="text-center">Poor</p></div>
                            <div class="col-auto example-block text-center"> <label class="radio-inline"> <input type="radio" name="emotion" id="boring" onclick="changeRate('3')" class="input-hidden" /> <img class="clsrate" src="~/Content/Images/boring.png" width="65" height="65"> </label> <p class="text-center">Average</p></div>
                            <div class="col-auto example-block text-center"> <label class="radio-inline"> <input type="radio" name="emotion" id="happy" onclick="changeRate('4')" class="input-hidden" /> <img class="clsrate" src="~/Content/Images/happy.png " width="65" height="65"> </label> <p class="text-center">Good</p></div>
                            <div class="col-auto example-block text-center"> <label class="radio-inline"> <input type="radio" name="emotion" id="smiling" onclick="changeRate('5')" class="input-hidden" /> <img class="clsrate" src="~/Content/Images/smiling.png " width="65" height="65"> </label> <p class="text-center">Excellent</p></div>
                            <div class="col-lg-12" style="margin-top:15px;">
                                <div class="col-lg-3" style="color:#000000;float:left;margin-bottom:5px;text-align:left;"><label>Comment:</label></div>
                                <div class="col-lg-12">
                                    <textarea id="Remark" name="message" class="form-control" placeholder="Comment"></textarea>
                                </div>
                            </div>
                            <div class="col-lg-12" style="margin-top:15px;">
                                <div class="col-lg-3" style="color:#000000;float:left;margin-bottom:5px;text-align:left;"><label>Mobile:</label></div>
                                <div class="col-lg-12">
                                    <input type="text"  class="form-control" id="txtMobile" style="position: initial;" placeholder="Mobile No" oninput="this.value=this.value.replace(/[^0-9]/g,'')"  maxlength="10"/>
                                </div>
                            </div>
                            <div class="col-lg-12" style="margin-top:15px;">
                                <div class="col-lg-3" style="color:#000000;float:left;margin-bottom:5px;text-align:left;"><label>Email:</label></div>
                                <div class="col-lg-12">
                                    <input type="email" class="form-control" id="txtEmail" style="position: initial;" placeholder="Email" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-between">
                         
                        <button type="button" id="saveratingbtn" onclick="SaveRating()" class="btn dev-btn pull-right">Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>