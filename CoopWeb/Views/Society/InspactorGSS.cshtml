    <div id="Actionmodal_AGMF" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-lg-custom">
            <div class="modal-content">
                <div class="modal-header">
                    <b class="text-info">AGM FORMATION</b>
                    <a data-dismiss="modal" class="pull-right"><i class="fa fa-times"></i></a>
                </div>
                <div class="modal-body">
                    <form id="paymentForm" ng-submit="SaveAGMFormation()">
                        <table class="payment-table">
                            <thead>
                                <tr>
                                    <td><label>AGM Conducted</label></td>
                                    <td>
                                        <input type="radio" name="AGMConducted" ng-model="actionObjAGMF.IsAGMConduct" value="1"> YES
                                        <input type="radio" name="AGMConducted" ng-model="actionObjAGMF.IsAGMConduct" value="0"> NO
                                    </td>
                                </tr>
                                <tr ng-show="actionObjAGMF.IsAGMConduct==1">
                                    <td><label>Conducted Date</label></td>
                                    <td>
                                        <input type="date" class="form-control" ng-model="actionObjAGMF.AGMConductDate" />
                                    </td>
                                </tr>
                                <tr ng-show="actionObjAGMF.IsAGMConduct==0">
                                    <td><label>Reasons</label></td>
                                    <td>
                                        <textarea name="AGMReasons" id="AGMReasons" class="form-control" ng-model="actionObjAGMF.AGMReasons" placeholder="AGM Not Conducted Reasons" rows="4"></textarea>
                                    </td>
                                </tr>
                                <tr ng-show="actionObjAGMF.IsAGMConduct==1">
                                    <td><label>{{translation.action}}</label></td>
                                    <td>
                                        <select name="StatusId" id="CaseStatusId" class="form-control" ng-init="actionObjAGMF.StatusId" ng-model="actionObjAGMF.StatusId">
                                            <option value="0" disabled>{{translation.SelectOption}}</option>
                                            <option ng-repeat="itm in GSSStatusList" value="{{itm.GSSSStatusId}}">
                                                {{_language =='en-us' ?  itm.StatusNameEn : itm.StatusNameHi}}
                                            </option>
                                        </select>
                                    </td>
                                </tr>
                                <tr ng-show="actionObjAGMF.IsAGMConduct==1">
                                    <td><label>Remark</label></td>
                                    <td>
                                        <textarea name="Remarks" id="Remarks" class="form-control" ng-model="actionObjAGMF.Remarks" placeholder="Remark" rows="3"></textarea>
                                    </td>
                                </tr>
                                <tr ng-show="actionObjAGMF.IsAGMConduct==1">
                                    <td><label>Upload Document</label></td>
                                    <td>
                                        <div style="display:flex; align-items:center; gap:10px;">
                                            <input type="file" accept="application/pdf" class="form-control" id="flReportFiles" ng-model="actionObjAGMF.UploadDocument"
                                                   onchange="angular.element(this).scope().SelectReceiptFile(this.files)">

                                            <!-- View -->
                                            <a target="_blank" ng-if="actionObjAGMF.UploadDocument" href="../Content/AGMDocument/UploadDocument/{{actionObjAGMF.UploadDocument}}" title="View Document">
                                                <i class="fa fa-eye" style="font-size:18px;"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <td colspan="2" align="center">
                                        <input type="submit" class="btn btn-primary dev-btn" value="Submit" />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div id="otpmodal" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <b class="text-info">Verify OTP</b>
                    <a data-dismiss="modal" class="pull-right"><i class="fa fa-times"></i></a>
                </div>
