                            <div class="form-group col-md-6">
                                <div class="form-group">
                                    <label>{{translation.EnterOTP}}</label>
                                    <input type="text" class="form-control" name="Remarks" ng-bind="OTP" ng-model="ApplicationFlowMaster.OTP" placeholder={{translation.EnterOTP}} autocomplete="off" /><br />
                                    <button type="button" class="btn btn-primary" ng-click="VerifyOTP(true)">{{translation.Submit}}</button>
                                    <button type="button" class="btn btn-primary" ng-click="SaveGSSApplicationFlowStatus(false)">{{translation.ReSendOTP}}</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>


