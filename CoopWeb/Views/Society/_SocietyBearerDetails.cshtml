
<form class="dev-masters" name="SocietyBearerForm">
    <div class="col-md-12">
        <h3> {{translation.SocietyBearerDetails}}  </h3>
        <hr style="margin: 0;">
    </div>
    <div class="col-md-12">
        <div class="master-detail">
            <h5>
                @ViewBag.BreadCrumbPath
            </h5>
        </div>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.Name}}<span class="error">*</span></label>
        <input type="text" name="Name" class="form-control" ng-model="SocietyBearer.Name" placeholder="{{translation.Name}}" ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.AADHAARNo}} </label>
        <input type="text" name="Aadhaar" class="form-control" ng-model="SocietyBearer.Aadhaar" placeholder="{{translation.AADHAARNo}}" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyBearerForm.MobileNo.$invalid && !SocietyBearerForm.MobileNo.$pristine }">
        <label>{{ translation.GenderHeading}} </label>
        <select ng-model="SocietyBearer.GenderId" class="form-control" ng-init="SocietyBearer.GenderId='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in GenderList" value="{{item.GENDER_ID}}">
                {{_language =='en-us' ?  item.GENDER_DESC_ENG : item.GENDER_DESC_HIN}}
            </option>
        </select>
    </div>

    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyBearerForm.PhoneNo.$invalid && !SocietyBearerForm.PhoneNo.$pristine }">
        <label>{{ translation.DOB}} </label>
        <input type="date" name="DOB" class="form-control" ng-model="SocietyBearer.DOB" ng-required="true" autocomplete="off">
    </div>


    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyBearerForm.AddressEn.$invalid && !SocietyBearerForm.AddressEn.$pristine }">
        <label class="control-label">{{ translation.Occupation}} </label>
        <select ng-model="SocietyBearer.OccupationId" class="form-control" ng-init="SocietyBearer.OccupationId='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in OccupationList" value="{{item.OccupationId}}">
                {{_language =='en-us' ?  item.OccupationNameEn : item.OccupationNameHi}}
            </option>
        </select>
    </div>

    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyBearerForm.AddressEn.$invalid && !SocietyBearerForm.AddressEn.$pristine }">
        <label class="control-label">{{ translation.MemberType}} </label>
        <select ng-model="SocietyBearer.MemberTypeId" class="form-control" ng-init="SocietyBearer.MemberTypeId='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in MemberTypelistList" value="{{item.MemberTypeId}}">
                {{_language =='en-us' ?  item.MemberTypeEn : item.MemberTypeHi}}
            </option>
        </select>
    </div>


    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyBearerForm.email.$invalid && !SocietyBearerForm.email.$pristine }">
        <label>{{ translation.AddressEn}}</label>
        <input type="text" name="MAddress" class="form-control" ng-model="SocietyBearer.MAddress" placeholder="{{translation.AddressEn}}" ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyBearerForm.AddressEn.$invalid && !SocietyBearerForm.AddressEn.$pristine }">
        <label class="control-label"> {{ translation.Photo}} </label>
        <input type="file" name="Photo" class="form-control" ng-model="SocietyBearer.Photo" onchange="angular.element(this).scope().UploadBearerFile(this.files)">
    </div>


    <div class="form-group col-md-12">
        <div class="dev-align-btn">
            <button type="submit" class="btn btn-primary dev-btn" ng-click="SaveSocietyBearer()">{{translation.Submit}}</button>
            <button type="button" class="btn btn-primary dev-btn" ng-click="ClearSocietyBearerDetailsForm()">{{translation.Clear}}</button>
        </div>

    </div>

</form>
