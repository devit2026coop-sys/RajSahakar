
<script src="~/Scripts/AngularFramework/DataIntigration.js"></script>
<style>
    .has-error {
        border: #F00;
    }
</style>
<div ng-app="LovMod" ng-controller="LovCnt">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head"> Production Data intigration</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                @if (ViewBag.BreadCrumbPath != null)
                {
                    <h5> @ViewBag.BreadCrumbPath </h5>
                }
            </ul>
        </div>
    </div>
    <form class="dev-masters" name="lovno">

      

        <div class="form-group col-md-6" ng-class="{ 'has-error' : lovno.LOVCode.$invalid && !lovno.LOVCode.$pristine }">
            <label>Enter RegistrationNO</label>
            <input type="text" class="form-control" name="LOVCode" ng-model="LOV.ListCode" placeholder="{{translation.LOVCode}}" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
            <label ng-show="lovno.LOVCode.$error.required && !lovno.LOVCode.$pristine" class="help-block">{{translation.LOVCode}} - {{translation.Required}}</label>
            <input type="hidden" ng-model="LOV.LovListId" value="{{LOV.LovListId}}" />
        </div>


        <div class="form-group col-md-12">
            <div class="dev-align-btn">
                <button type="submit" class="btn btn-primary dev-btn"  ng-click="GetDataFromProd(LOV.ListCode)">{{translation.Submit}}</button>
            </div>
        </div>

    </form>

</div>



