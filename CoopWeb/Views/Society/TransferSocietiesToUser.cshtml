
<script src="~/Scripts/AngularFramework/TransferSocietiesToUser.js?id=5"></script>

<link href="~/Content/Stylesheets/bootstrap-multiselect.css" rel="stylesheet" type="text/css" />
<script src="~/Scripts/bootstrap-multiselect.js" type="text/javascript"></script>


<div ng-app="UserTransAddiChargeRequestModule">
    <div ng-controller="UserTransAddiChargeRequestCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">Transfer Societies To User</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> Home </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> User </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> Transfer Societies ToUser </span>
                    </li>

                </ul>
            </div>
        </div>
        @*<div class="col-md-12">
            <div class="master-detail" style="margin-left:15px;">
                @if (ViewBag.BreadCrumbPath != null)
                {
                <h5> @ViewBag.BreadCrumbPath </h5>
                }
            </div>
        </div>*@

        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <form class="citizen-dash-head" name="MyUserForm" style="overflow: hidden;">

                        <div class="col-md-12">                              
                            @*<div class="col-lg-6 form-group">
                                <div>
                                    <label>{{translation.District}}</label>
                                    <select ng-model="UserRegistration.DistrictId" id="ddlDistrict" class="form-control" ng-init="UserRegistration.DistrictId=''" ng-change="GetCityList();">
                                        <option value="0">{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Districts" value="{{item.DISTRICT_ID}}">
                                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>*@  
                            <div class="col-lg-12 form-group">
                                <div class="col-lg-6">
                                    <label>
                                        {{translation.Act}} :
                                    </label>
                                    <select id="ddlCategory" ng-model="transferSocietiesToUser.ActId" class="form-control" ng-init="transferSocietiesToUser.ActId='0'" ng-disabled="IsActdisabled">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Acts | orderBy:'ActNameHi'" value="{{item.ActId}}">
                                            {{_language =='en-us' ?  item.ActNameEn : item.ActNameHi}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label>
                                        {{translation.RoleHeading}} :
                                    </label>
                                    <select ng-model="transferSocietiesToUser.RoleId" class="form-control" ng-init="transferSocietiesToUser.RoleId='0'" ng-change="UserList()">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Roles" value="{{item.RoleID}}">
                                            {{_language =='en-us' ?  item.RoleName_EN : item.RoleName_HI}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label>From User</label>
                                    <select class="form-control" id="ddFromUser" ng-model="transferSocietiesToUser.FromUser" ng-init="transferSocietiesToUser.FromUser='0'">
                                        <option value="0" disabled>{{translation.SelectUser}}</option>
                                        <option ng-repeat="item in Users" value="{{item.UserId}}">
                                            {{_language =='en-us' ?  item.OfficerNameEn : item.OfficerNameHi}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label>To User</label>
                                    <select class="form-control" id="ddToUser" ng-model="transferSocietiesToUser.ToUser" ng-init="transferSocietiesToUser.ToUser='0'">
                                        <option value="0" disabled>{{translation.SelectUser}}</option>
                                        <option ng-repeat="item in Users" value="{{item.UserId}}">
                                            {{_language =='en-us' ?  item.OfficerNameEn : item.OfficerNameHi}}
                                        </option>
                                    </select>
                                </div>

                            </div>
                            <div class="form-group col-md-12">
                                <div class="dev-align-btn">
                                    <button type="submit" class="btn btn-primary dev-btn" ng-disabled="MyUserForm.$invalid" ng-click="SaveUser()">{{translation.Submit}}</button>
                                    <button type="button" class="btn btn-primary dev-btn" ng-click="ClearForm()">{{translation.Clear}}</button>
                                    <input type="hidden" ng-model="UserRegistration.USERID" />
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="" ng-show="ShowGrids">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="col-md-12">
                        <div class="table-dropdown">
                            <div class="col-md-4">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-md-4">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                            </div>
                        </div>
                        <div style="overflow-x:auto;">
                            <table class="table table-responsive devtable">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th ng-click="sortData('SubClassNameEn')">
                                            {{translation.OfficerNameEn}}
                                            <div ng-class="getSortClass('SubClassNameEn')"></div>
                                        </th>
                                        <th>
                                            {{translation.MobileNo}}
                                        </th>
                                        <th>
                                            {{translation.SSOID}}
                                        </th>
                                        <th ng-click="sortData(_language =='en-us' ? 'DEPTNAMEENGLISH' : 'DEPTNAMEHINDI')">
                                            {{translation.DepartmentHeading}}
                                            <div ng-class="getSortClass(_language =='en-us' ? 'DEPTNAMEENGLISH' : 'DEPTNAMEHINDI')"></div>
                                        </th>
                                        <th ng-click="sortData(_language =='en-us' ? 'OrganisationNameEn' : 'OrganisationNameHi')">
                                            {{translation.Organisation}}
                                            <div ng-class="getSortClass(_language =='en-us' ? 'OrganisationNameEn' : 'OrganisationNameHi')"></div>
                                        </th>
                                        <th ng-click="sortData(_language =='en-us' ? 'LevelNameEn' : 'LevelNameHi')">
                                            {{translation.Level}}
                                            <div ng-class="getSortClass(_language =='en-us' ? 'LevelNameEn' : 'LevelNameHi')"></div>
                                        </th>
                                        <th ng-click="sortData(_language =='en-us' ? 'OfficeNameEn' : 'OfficeNameHi')">
                                            {{translation.Office}}
                                            <div ng-class="getSortClass(_language =='en-us' ? 'OfficeNameEn' : 'OfficeNameHi')"></div>
                                        </th>
                                        <th ng-click="sortData(_language =='en-us' ? 'DESIGNATIONDESCENGLISH' : 'DESIGNATIONDESCHINDI')">
                                            {{translation.Designation}}
                                            <div ng-class="getSortClass(_language =='en-us' ? 'DESIGNATIONDESCENGLISH' : 'DESIGNATIONDESCHINDI')"></div>
                                        </th>
                                        <th>
                                            {{translation.Place}}
                                        </th>
                                        <th>
                                            {{translation.UserRequest}}
                                        </th>
                                    </tr>

                                </thead>
                                <tbody>
                                    <tr dir-paginate="Class in UserReqData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">

                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ Class.OfficerNameEn }}</td>

                                        <td>{{Class.MobileNo}} </td>
                                        <td>{{Class.SSO_ID}}</td>
                                        <td>{{_language =='en-us' ?  Class.DEPTNAMEENGLISH : Class.DEPTNAMEHINDI}}</td>
                                        <td>{{_language =='en-us' ?  Class.OrganisationNameEn : Class.OrganisationNameHi}}</td>
                                        <td>{{_language =='en-us' ?  Class.LevelNameEn : Class.LevelNameHi}}</td>
                                        <td>{{_language =='en-us' ?  Class.OfficeNameEn : Class.OfficeNameHi}}</td>
                                        <td>{{_language =='en-us' ?  Class.DESIGNATIONDESCENGLISH : Class.DESIGNATIONDESCHINDI}}</td>
                                        <td ng-show="Class.LevelId==1">{{translation.Rajasthan}}</td>
                                        <td ng-show="Class.LevelId==2">{{_language =='en-us' ?  Class.DIVISION_ENG : Class.DIVISION_MANGAL}} </td>
                                        <td ng-show="Class.LevelId==3">{{_language =='en-us' ?  Class.DISTRICT_ENG : Class.DISTRICT_MANGAL}} </td>
                                        <td ng-show="Class.LevelId==4 && Class.BLOCK_ENG==''">{{_language =='en-us' ?  Class.DISTRICT_ENG : Class.DISTRICT_MANGAL}}, {{_language =='en-us' ?  Class.CITY_ENG : Class.CITY_MANGAL}} </td>
                                        <td ng-show="Class.LevelId==4 && Class.BLOCK_ENG!=''">{{_language =='en-us' ?  Class.DISTRICT_ENG : Class.DISTRICT_MANGAL}}, {{_language =='en-us' ?  Class.BLOCK_ENG : Class.BLOCK_MANGAL}} </td>

                                        <td ng-show="Class.LevelId==5">{{_language =='en-us' ?  Class.DISTRICT_ENG : Class.DISTRICT_MANGAL}}, {{_language =='en-us' ?  Class.BLOCK_ENG : Class.BLOCK_MANGAL}} {{_language =='en-us' ?  Class.GP_ENG : Class.GP_MANGAL}} </td>
                                        <td>{{Class.RequestType}} </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>

    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

