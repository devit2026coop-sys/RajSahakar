<script src="~/Scripts/AngularFramework/AuditorDataClient.js"></script>

<div ng-app="AuditorMod" ng-controller="AuditorCont">

    <div class="col-md-12">
        <h3 class="citizen-dash-head">{{ translation.AuditorData}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">

                    <span style="margin: 0 5px;">{{translation.AuditorData}} </span>
                </li>

            </ul>
        </div>
    </div>

    <div class="col-md-12 ">
        <form class="citizen-dash-head" style="overflow: hidden; margin-bottom: 35px;" name="block1">
            <div class="form-group col-md-6" style="margin-top: 15px;">
                <div class="form-check form-check-inline col-md-4" style="padding: 0;">
                    <label>{{translation.AuditorData}}</label>
                </div>

                <div class="form-check form-check-inline col-md-4">
                    <div class="radio-item">
                        <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="true" ng-model="Auditor.IsIndividual" ng-checked="Auditor.IsIndividual">
                        <label class="form-check-label option_value" for="inlineRadio1">{{translation.AuditFirm}}</label>
                    </div>
                </div>


                <div class="form-check form-check-inline col-md-4">
                    <div class="radio-item">
                        <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="false" ng-model="Auditor.IsIndividual" ng-checked="Auditor.IsIndividual">
                        <label class="form-check-label option_value" for="inlineRadio2">{{translation.AuditIndividual}}</label>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-disabled="block1.$invalid" ng-click="GetAuditData()">{{translation.Show}}</button>
            </div>
        </form>
    </div>

    <div class="col-md-12" ng-show="divAuditorData">
        <div class="citizen-dash-head">
            <div class="table-dropdown">
                <div class="col-md-12">

                    <div class="col-md-12 dev-search-form">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                        </div>
                    </div>



                    <div class="table-responsive citizen-dash-head">
                        <table class="table devtable" style="margin-top: 30px;">
                         
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th ng-click="sortData('FirmName')">
                                        {{translation.FirmName}}
                                        <div ng-class="getSortClass('FirmName')"></div>
                                    </th>
                                    <th ng-click="sortData('FirmAddress')">
                                        {{translation.FirmAddress}}
                                        <div ng-class="getSortClass('FirmAddress')"></div>
                                    </th>
                                    <th ng-click="sortData('State')">
                                        {{translation.State}}
                                        <div ng-class="getSortClass('State')"></div>
                                    </th>
                                    <th ng-click="sortData('District')">
                                        {{translation.District}}
                                        <div ng-class="getSortClass('District')"></div>
                                    </th>
                                    <th ng-click="sortData('PINCode')">
                                        {{translation.PIN}}
                                        <div ng-class="getSortClass('PINCode')"></div>
                                    </th>
                                    <th ng-click="sortData('ICFAIRegistrationNo')">
                                        {{translation.ICFAIRegistrationNo}}
                                        <div ng-class="getSortClass('ICFAIRegistrationNo')"></div>
                                    </th>
                                    <th ng-click="sortData('RegistrationDate')">
                                        {{translation.ICFAIRegistrationDate}}
                                        <div ng-class="getSortClass('RegistrationDate')"></div>
                                    </th>
                                    <th ng-click="sortData('PhoneNumber')">
                                        {{translation.PhoneNo}}
                                        <div ng-class="getSortClass('PhoneNumber')"></div>
                                    </th>
                                    <th ng-click="sortData('FirmType')">
                                        {{translation.FirmType}}
                                        <div ng-class="getSortClass('FirmType')"></div>
                                    </th>
                                    <th ng-click="sortData('NoOfPartners')">
                                        {{translation.NoOfPartners}}
                                        <div ng-class="getSortClass('NoOfPartners')"></div>
                                    </th>
                                    <th ng-click="sortData('BranchAddress')">
                                        {{translation.BranchAddress}}
                                        <div ng-class="getSortClass('BranchAddress')"></div>
                                    </th>

                                    <th ng-click="sortData('RBIPanelUniqueCode')">
                                        {{translation.RBIPanelUniqueCode}}
                                        <div ng-class="getSortClass('RBIPanelUniqueCode')"></div>
                                    </th>
                                    <th ng-click="sortData('EnrollmentNo')">
                                        {{translation.EnrollmentNo}}
                                        <div ng-class="getSortClass('EnrollmentNo')"></div>
                                    </th>
                                </tr>                         
                            </thead>
                            <tbody>
                                <tr dir-paginate="items in AuditorDataForRender | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="AuditDataPagination">
                                    <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                    <td>{{ items.FirmName }}</td>
                                    <td>{{ items.FirmAddress }}</td>
                                    <td>{{ items.State }}</td>
                                    <td>{{ items.District }}</td>
                                    <td>{{ items.PINCode }}</td>
                                    <td>{{ items.ICFAIRegistrationNo }}</td>
                                    <td>{{ items.RegistrationDate }}</td>
                                    <td>{{ items.PhoneNumber }}</td>
                                    <td>{{ items.FirmType }}</td>
                                    <td>{{ items.NoOfPartners }}</td>
                                    <td>{{ items.BranchAddress }}</td>
                                    <td>{{ items.RBIPanelUniqueCode }}</td>
                                    <td>{{ items.EnrollmentNo }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="col-md-12">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="AuditDataPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>
                </div>


                <div class="col-md-2">
                    <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                </div>
            </div>
        </div>

    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
