            <div class="form-group col-md-12">
                <div class="form-group col-md-3" style="padding: 20px;">
                    <label class="control-label">{{ translation.TotalNoofMembers}}</label>
                  
                </div>
                <div class="form-group col-md-3"  ng-class="{ 'has-error' : MyUserForm.TotalMembersClassA.$invalid && !MyUserForm.TotalMembersClassA.$pristine }">
                    <label>{{ translation.TotalMembersClassA}}<span class="error">*</span></label>
                    <input type="text" name="Total No of Members Class A" class="form-control" ng-model="SocietyRegistration.TotalMembersClassA" placeholder="{{translation.TotalMembersClassA}}" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">

