            <div class="form-group col-md-12">
                <div class="dev-align-btn">
                    <button type="submit" class="btn btn-primary dev-btn" ng-disabled="MyUserForm.$invalid" ng-click="SaveSocietyAdministrativeDetails()">{{translation.Submit}}</button>
                    <button type="button" class="btn btn-primary dev-btn" ng-click="ClearSocietyAdministrativeDetails()">{{translation.Clear}}</button>
