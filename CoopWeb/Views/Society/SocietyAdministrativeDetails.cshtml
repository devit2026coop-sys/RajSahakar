
@{
    <script src="~/Scripts/AngularFramework/SocietyClient.js"></script>
    <div ng-app="SocietyRegistrationMod" ng-controller="SocietyRegistrationCnt">
        <form class="dev-masters" name="MyUserForm">
            <div class="col-md-12">
                <h3> {{translation.UserRegistration}}  </h3>
                <hr style="margin: 0;">
            </div>
           
            <div class="col-md-12">
                <div class="head-section">{{translation.SocietyAdministrativeDetails}} </div>
                <div class="bottom-padding"></div>

                <div class="form-group col-md-6">
                    <label>{{translation.CEOName}}<span class="error">*</span></label>
                    <input type="text" name="CEOName" class="form-control" placeholder="{{translation.CEOName}}" ng-model="SocietyRegistration.CEOName" autocomplete="off" required>
                    <label ng-show="MyUserForm.CEOName.$touched && MyUserForm.CEOName.$invalid" class="help-block"> {{translation.CEOName}}</label>
                </div>

                <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.CEOContactNo.$invalid && !MyUserForm.CEOContactNo.$pristine }">
                    <label>{{translation.ContactNo}}<span class="error">*</span></label>
                    <input type="text" name="CEOContactNo" class="form-control" ng-model="SocietyRegistration.CEOContactNo" placeholder="{{translation.ContactNo}}" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
                    <label ng-show="MyUserForm.CEOContactNo.$error.minlength && !MyUserForm.CEOContactNo.$pristine" class="help-block">{{translation.ContactNo}} - {{translation.MobileNoLimit}}</label>
                </div>

                <div class="form-group col-md-6">
                    <label>{{translation.ChairmanName}}<span class="error">*</span></label>
                    <input type="text" name="ChairmanName" class="form-control" placeholder="{{translation.ChairmanName}}" ng-model="SocietyRegistration.ChairmanName" autocomplete="off" required>
                    <label ng-show="MyUserForm.ChairmanName.$error.required && !MyUserForm.ChairmanName.$pristine" class="help-block"> {{translation.ChairmanName}}</label>
                </div>
                <div class="form-group col-md-6"  ng-class="{ 'has-error' : MyUserForm.ChairmanContactNo.$invalid && !MyUserForm.ChairmanContactNo.$pristine }">
                    <label>{{translation.ContactNo}}<span class="error">*</span></label>
                    <input type="text" name="ContactNo" class="form-control" placeholder="{{translation.ContactNo}}" ng-model="SocietyRegistration.ChairmanContactNo" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
                    <label ng-show="MyUserForm.ChairmanContactNo.$error.required && !MyUserForm.ChairmanContactNo.$pristine" class="help-block"> {{translation.ContactNo}}</label>
                </div>


            </div>




