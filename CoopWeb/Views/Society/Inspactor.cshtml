<script src="~/Scripts/AngularFramework/Inspactor.js"></script>

<div ng-app="UnitMastersModule">
    <div ng-controller="UnitMasterCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.Inspector}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">        
                        <span style="margin: 0 5px;"> {{translation.Inspector}} </span>
                    </li>
                </ul>
            </div>
        </div> 
        <div class="col-md-12">
            <div class="citizen-dash-head" style="overflow: hidden;">
                <div class="col-md-12">
                    <div class="col-xs-4">
                        <label for="search">{{translation.Search}}:</label>
                        <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                    </div>
                    <div class="col-xs-4">
                        <label for="search">{{translation.ItemPerPage}}:</label>
                        <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                    </div>
                </div>
                <br>


                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-responsive devtable" style="margin-top: 30px;">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th>
                                        {{translation.SocietyName}}
                                    </th>
                                    <th>
                                        {{translation.AuditBy}}
                                    </th>
                                    <th>
                                        {{translation.AuditType}}
                                    </th>

                                    <th>
                                        {{translation.District}}
                                    </th>
                                    <th>
                                        {{translation.AuditorData}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="items in InspacorData">
                                    <td>{{$index+1}}</td>
                                    <td>{{ items.SocietyName }}</td>
                                    <td>{{ items.IsEmpanelledCA == 'True' ? translation.ByEmpanelledAgency : translation.ByDepartment}}</td>
                                    <td ng-show="items.IsFirm == 0">{{  translation.Firm }}</td>
                                    <td ng-show="items.IsFirm == 1">{{ translation.Individual}}</td>
                                    <td ng-show="items.IsFirm == 2">{{ translation.ByDepartment }}</td>
                                    <td>{{ _language == 'en-us' ?  items.DISTRICT_ENG : items.DISTRICT_MANGAL }}</td>
                                    <td>{{ items.FirmName }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-md-10">
                    <div class="text-center">
                        <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
                <div class="col-md-2">
                    <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                </div>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

