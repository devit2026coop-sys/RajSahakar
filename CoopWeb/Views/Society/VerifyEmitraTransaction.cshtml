<script src="~/Scripts/AngularFramework/VerifyEmitraTransaction.js"></script>
<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }
</style>
<div ng-app="ApplicationStatusModule">
    <div ng-controller="ApplicationStatusCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">Verify Emitra Transaction and Update Application Status</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>

                        <span style="margin: 0 5px;">Verify Emitra Transaction and Update Application Status</span>
                    </li>

                </ul>
            </div>
        </div>
        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter">

                        <div class="col-lg-12" style="margin-bottom: 10px; padding-left: 0;">
                            <div class="col-md-4">
                                <label for="search">Service</label>
                                <select class="form-control" ng-model="Filter.ServiceType">
                                    <option value="">Select Service</option>
                                    <option value="5531">Society Registration</option>
                                    <option value="7392">Auditor Empaneled Registration</option>
                                    <option value="7670">PLDB Membership Registration</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="search">User Type</label>
                                <select class="form-control" ng-model="Filter.UserType">
                                    <option value="">Select Service</option>
                                    <option value="0">--select--</option>
                                    <option value="C">Payment Gatway</option>
                                    <option value="K">Kiosk</option>
                                </select>
                            </div>
                            <div class="col-md-4" ng-if="Filter.ServiceType==5531">
                                <label for="search">Registration Number/BRN Number/Society Name *</label>
                                <input ng-model="Filter.SearchText" name="SearchText" id="search" class="form-control" placeholder="Registration Number/BRN Number/Society Name" autocomplete="off">
                            </div>
                            <div class="col-md-4" ng-if="Filter.ServiceType==7392">
                                <label for="search">Registration Number/SSO ID *</label>
                                <input ng-model="Filter.SearchText" name="SearchText" id="search" class="form-control" placeholder="Registration Number/BRN Number/Society Name" autocomplete="off">
                            </div>
                            <div class="col-md-4" ng-if="Filter.ServiceType==7670">
                                <label for="search">Application Number *</label>
                                <input ng-model="Filter.SearchText" name="SearchText" id="search" class="form-control" placeholder="Application Number" autocomplete="off">
                            </div>
                            <div class="col-md-4  margin-Top20">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-click="GetApplication()" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                            </div>
                        </div>                          
                    </div>
                    <div class="col-md-12 table-responsive ">
                        <table class="table table-responsive devtable" style="" ng-if="Filter.ServiceType==5531">
                            <thead>
                                <tr>
                                    <th class="info_news_slh_table_fix">Sr No.</th>
                                    <th>Society Name</th>
                                    <th>RegistrationNo</th>
                                    <th>Status Msg</th>
                                    <th>Request String</th>
                                    <th>Response String</th>                                  
                                    <th>Submission Date</th>                                  
                                    <th>Action</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in ApplicationList">
                                    <td>{{$index+1}}</td>
                                    <td>{{item.SocietyName}}</td>
                                    <td>{{item.RegistrationNo}}</td>
                                    <td>{{item.StatusMsg}}</td>
                                    <td style="word-break:break-all;word-wrap:break-word">{{item.RequestString}}</td>
                                    <td style="word-break:break-all;word-wrap:break-word">{{item.ResponseString}}</td>
                                    <td>{{item.CreationDate}}</td>
                                    <td> <a ng-click="GetFeeVerification(item.SocietyIdENC, item.EMitraAppRequestID, item.SERICEID, item.SocietyId, item.RegistrationNo,item.ApplicationStatus)" class="btn btn-primary dev-btn ng-binding">VERIFY TRANSACTION</a></td>
                                    <td>
                                        <a title="{{translation.ShowDetails}}" style="color:#505050;"><i ng-click="SocietyView(item)" class="fa fa-info-circle infoicon-edit"></i></a>
                                    </td>
                                </tr>
                                    </tbody>
                                </table>

                        <table class="table table-responsive devtable" ng-if="Filter.ServiceType==7392">
                            <thead>
                                <tr>
                                    <th class="info_news_slh_table_fix">Sr No.</th>
                                    <th>Applicant Name </th>
                                    <th>RegistrationNo</th>
                                    <th>SSOID</th>
                                    <th>Application Status</th>  
                                    <th>Transaction Status</th>
                                    <th>Request String</th>
                                    <th>Response String</th>      
                                    <th>Submission Date</th>
                                    <th>Action</th>
                                    @*<th></th>*@
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in ApplicationList">
                                    <td>{{$index+1}}</td>
                                    <td>{{item.ApplicantNameEn}}</td>
                                    <td>{{item.RegistrationNo}}</td>
                                    <td>{{item.SSOID}}</td>                                
                                    <td>{{item.StatusText}}</td>
                                    <td>{{item.StatusMsg}}</td>
                                    <td style="word-break:break-all;word-wrap:break-word">{{item.RequestString}}</td>
                                    <td style="word-break:break-all;word-wrap:break-word">{{item.ResponseString}}</td>
                                    <td>{{item.CreationDate}}</td>
                                    <td> <a ng-click="GetFeeVerification7392(item.AuditEmpanelledId,item.EMitraAppRequestID,item.SERICEID,item.UniqueId)" class="btn btn-primary dev-btn ng-binding">VERIFY TRANSACTION</a></td>
                                    @*<td>
                                        <a title="{{translation.ShowDetails}}" style="color:#505050;"><i ng-click="SocietyView(item)" class="fa fa-info-circle infoicon-edit"></i></a>
                                    </td>*@
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-responsive devtable" ng-if="Filter.ServiceType==7670">
                            <thead>
                                <tr>
                                    <th class="info_news_slh_table_fix">Sr No.</th>
                                    <th>Applicant Name </th>
                                    <th>ApplicationNo</th>                                 
                                    <th>Application Status</th>
                                    <th>Transaction Status</th>
                                    <th>Request String</th>
                                    <th>Response String</th>
                                    <th>Submission Date</th>
                                    <th>Action</th>                                
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in ApplicationList">
                                    <td>{{$index+1}}</td>
                                    <td>{{item.Name}}</td>
                                    <td>{{item.ApplicationNo}}</td>                                 
                                    <td>{{item.StatusText}}</td>
                                    <td>{{item.StatusMsg}}</td>
                                    <td style="word-break:break-all;word-wrap:break-word">{{item.RequestString}}</td>
                                    <td style="word-break:break-all;word-wrap:break-word">{{item.ResponseString}}</td>
                                    <td>{{item.CreationDate}}</td>
                                    <td> <a ng-click="GetFeeVerification7670(item.RequestIdENC,item.EMitraAppRequestID,item.EMitraAppRequestID,item.SERICEID,item.UniqueId)" class="btn btn-primary dev-btn ng-binding">VERIFY TRANSACTION</a></td>                                  
                                </tr>
                            </tbody>
                        </table>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="se-pre-con"></div>
                <div id="stop" class="scrollTop">
                    <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
                </div>
            </div>

        </div>
