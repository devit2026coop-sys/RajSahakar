                                        <th>{{translation.CCSName1}}</th>
                                        <th>{{translation.District1}}</th>
                                        <th>{{translation.Date}}</th>
                                        <th>Submit BY</th>
                                        <th>{{translation.Status1}}</th>
                                        <th>Remark</th>
                                        <th>Approved by</th>
                                        
