<script src="~/Scripts/AngularFramework/BankDetailsVerify.js"></script>


<div ng-app="CCSComplainMod" >
    <div ng-controller="CCSComplainCnt">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.BankDetailsVerification}} </h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="../Citizen/Index"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.BankDetailsVerification}} </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="citizen-dash-head">
            <div class="table-responsive">
                <table class="table devtable">
                    <thead>
                        <tr>
                            <th>Sr.No</th>
                            <th>ApplicationNo</th>
                            <th>Bank Name</th>
                            <th>BankBranch</th>
                            <th>IFSCCode</th>
                            <th>BankAccountNo</th>
                            <th>AccHolderName</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="items in BankData">
                            <td>{{$index}}</td>
                            <td>{{items.ApplicationNo}}</td>
                            <td>{{items.BankName}}</td>
                            <td>{{items.BankBranch}}</td>
                            <td>{{items.IFSCCode}}</td>
                            <td>{{items.BankAccountNo}}</td>
                            <td>{{items.AccHolderName}}</td>
                            <td>{{items.CreatedDate}}</td>
                            <td><input type="button" name="name"  ng-click="Verify(items.Id)" value="{{items.CheckVerify}}" class="btn dev-btn btn-primary" /></td>

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>




    </div>
    </div>


