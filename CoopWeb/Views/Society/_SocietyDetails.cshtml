
<script src="~/Scripts/AngularFramework/AuditorAssignmentByDepartment.js"></script>

<form class="dev-masters" name="SocietyRegistrationForm">
    <div class="col-md-12">
        <h3> {{translation.SocietyDetails}}  </h3>
        <hr style="margin: 0;">
    </div>
    <div class="form-group col-md-6">
        <label>{{ translation.BRN}}<span class="error">*</span></label>
        <input type="text" name="BRN" class="form-control" ng-model="SocietyRegistration.BRN" placeholder="{{translation.BRN}}" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.SocietyRegistrationNo}}<span class="error">*</span></label>
        <input type="text" name="SocietyRegistrationNo" class="form-control" ng-model="SocietyRegistration.SocietyRegistrationNo" placeholder="{{translation.SocietyRegistrationNo}}" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.ProposedSocietyName}} <span class="error">*</span></label>
        <input type="text" name="SocietyName" class="form-control" ng-model="SocietyRegistration.SocietyName" placeholder="{{translation.ProposedSocietyName}}" ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.SocietyType}}<span class="error">*</span></label>
        <select ng-model="SocietyRegistration.SocietyTypeId" class="form-control" ng-init="SocietyRegistration.SocietyTypeId='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in SocietyTypeList" value="{{item.SocietyTypeId}}">
                {{_language =='en-us' ?  item.TypeameEng : item.TypeNameHin}}
            </option>
        </select>
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyRegistrationForm.OfficerNameEn.$invalid && !SocietyRegistrationForm.OfficerNameEn.$pristine }">
        <label>{{ translation.Business}}<span class="error">*</span></label>
        <select ng-model="SocietyRegistration.BusinessId" class="form-control" ng-init="SocietyRegistration.BusinessId='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in BusinessTypeList" value="{{item.BusinessId}}">
                {{_language =='en-us' ?  item.BusinessNameEn : item.BusinessNameHi}}
            </option>
        </select>
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyRegistrationForm.OfficerNameHi.$invalid && !SocietyRegistrationForm.OfficerNameHi.$pristine }">
        <label>{{ translation.Liability}}<span class="error">*</span></label>
        <select ng-model="SocietyRegistration.LiablityId" class="form-control" ng-init="SocietyRegistration.LiablityId='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in LiabilityTypeList" value="{{item.LiablityId}}">
                {{_language =='en-us' ?  item.LiablityNameEn : item.LiablityNameHi}}
            </option>
        </select>
    </div>

    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyRegistrationForm.PhoneNo.$invalid && !SocietyRegistrationForm.PhoneNo.$pristine }">
        <label>{{ translation.LTDSocietyLiablityMember}}<span class="error">*</span></label>
        <input type="text" name="LTDSocietyLiablityMember" class="form-control" ng-model="SocietyRegistration.MemberLiablity" placeholder="{{translation.LTDSocietyLiablityMember}}">
        <label ng-show="SocietyRegistrationForm.PhoneNo.$error.minlength && !SocietyRegistrationForm.PhoneNo.$pristine" class="help-block">{{translation.PhoneNo}} - {{translation.MobileNoLimit}}</label>
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyRegistrationForm.MobileNo.$invalid && !SocietyRegistrationForm.MobileNo.$pristine }">
        <label>{{ translation.ProposedSocietyClass}}<span class="error">*</span></label>
        <select ng-model="SocietyRegistration.ClassId" class="form-control" ng-init="SocietyRegistration.ClassId='0'" ng-change="GetSubClass()">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in SocietyClassList" value="{{item.ClassId}}">
                {{_language =='en-us' ?  item.ClassNameEn : item.ClassNameHi}}
            </option>
        </select>
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyRegistrationForm.email.$invalid && !SocietyRegistrationForm.email.$pristine }">
        <label>{{ translation.ProposedSocietySubClass}}<span class="error">*</span></label>
        <select ng-model="SocietyRegistration.SubClassId" class="form-control" ng-init="SocietyRegistration.SubClassId='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in SocietySubClassList" value="{{item.SubClassId}}">
                {{_language =='en-us' ?  item.SubClassNameEn : item.SubClassNameHi}}
            </option>
        </select>
    </div>
    <div class="form-group col-md-6">
        <label>{{ translation.SocietyApplyingTotalMember}}<span class="error">*</span></label>
        <input type="text" name="SocietyApplyingTotalMember" class="form-control" ng-model="SocietyRegistration.TotalMembersApplyingForSocociety" placeholder="{{translation.SocietyApplyingTotalMember}}" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">

    </div>

    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyRegistrationForm.AddressEn.$invalid && !SocietyRegistrationForm.AddressEn.$pristine }">
        <label class="control-label">{{ translation.EntranceFeesCollected}} <span class="error">*</span> </label>
        <input type="text" name="EntranceFeesCollected" class="form-control" ng-model="SocietyRegistration.EntranceFeesCollected" placeholder="{{translation.EntranceFeesCollected}}" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyRegistrationForm.AddressHi.$invalid && !SocietyRegistrationForm.AddressHi.$pristine }">
        <label class="control-label">{{ translation.OneShareValue}} <span class="error">*</span></label>
        <input type="text" name="SingleShareValue" class="form-control" ng-model="SocietyRegistration.SingleShareValue" placeholder="{{translation.OneShareValue}}" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.PaidUpShareCapital}} <span class="error">*</span></label>
        <input type="text" name="PaidUpShareCapital" class="form-control" ng-model="SocietyRegistration.PaidUpShareCapital" placeholder="{{translation.PaidUpShareCapital}}" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyRegistrationForm.PIN.$invalid && !SocietyRegistrationForm.PIN.$pristine }">
        <label>{{ translation.ByeLawsOfSociety}} (PDF upto 5MB)<span class="error">*</span></label>
        <input type="file" name="File" class="form-control" ng-model="SocietyRegistration.ByeLawsSocietyFile" onchange="angular.element(this).scope().UploadByeLawsSocietyFile(this.files)">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.SocietyWorkPlanEconomicViability}} (PDF upto 5MB)<span class="error">*</span></label>
        <input type="file" name="File" class="form-control" ng-model="SocietyRegistration.WorkPlanShowingEconomicViabilityFile" onchange="angular.element(this).scope().UploadEconomyViabilityFile(this.files)">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.GeneralMeetingDate}} <span class="error">*</span></label>
        <input type="date" name="GeneralMeetingDate" class="form-control" placeholder="{{translation.GeneralMeetingDate}}" ng-model="SocietyRegistration.GeneralMeetingDate" autocomplete="off" required>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.GeneralMeetingParticipant}}<span class="error">*</span></label>
        <input type="text" name="GeneralMeetingParticipant" class="form-control" placeholder="{{translation.GeneralMeetingParticipant}}" ng-model="SocietyRegistration.MembersParticipatingGeneralMeeting" maxlength="10" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off" />
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.GeneralMeetingProcedure}} (PDF upto 5MB)<span class="error">*</span></label>
        <input type="file" name="File" class="form-control" ng-model="SocietyRegistration.GeneralMeetingProceedingFile" onchange="angular.element(this).scope().UploadGeneralMeetingProceedingFile(this.files)">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.BalanceSheetUpload}}(File Type - EXCEL upto 5MB)<span class="error">*</span></label>
        <input type="file" name="File" class="form-control" ng-model="SocietyRegistration.BalanceSheetFile" onchange="angular.element(this).scope().UploadBalanceSheetFile(this.files)">
    </div>

   

    <div class="form-group col-md-12">
        <div class="dev-align-btn">
            <button type="submit" class="btn btn-primary dev-btn" ng-click="SaveSocietyProfiling()">{{ translation.Submit}}</button>
            <button type="button" class="btn btn-primary dev-btn" ng-click="ClearSocietyDetailsForm()">{{ translation.Clear}}</button>
        </div>
    </div>

</form>
