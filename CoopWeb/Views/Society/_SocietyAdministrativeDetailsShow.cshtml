                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="form-group col-md-12">
        <div class="form-group col-md-3" style="padding: 20px;">
            <label class="control-label">{{ translation.TotalNoofMembers}}</label>

        </div>
        <div class="form-group col-md-3">
            <label>{{ translation.TotalMembersClassA}}</label>
            <label class="form-control-label" ng-model="SocietyRegistration.TotalMembersClassA"></label>

        </div>

        <div class="form-group col-md-3">
            <label class="control-label">{{ translation.TotalMembersClassB}}  </label>
            <label  class="form-control-label" ng-model="SocietyRegistration.TotalMembersClassB" />
        </div>

        <div class="form-group col-md-3">
            <label class="control-label">{{ translation.TotalMembersClassC}} </label>
            <label class="form-control-label" ng-model="SocietyRegistration.TotalMembersClassC"></label>
        </div>
    </div>
    <div class="form-group col-md-12">
        <div class="dev-align-btn">
            <div class="dev-menu-btn" style="margin-top: 20px;">
                <a ng-click="BackToPage()" data-toggle="modal" style="color:#ef0707;float:right;text-decoration:none;cursor:pointer" class="ng-binding">» {{translation.Back}}</a>
            </div>
        </div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>
    </div>
</form>
