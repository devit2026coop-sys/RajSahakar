                            <label class="form-control-label"  ng-model="SocietyRegistration.DirectorsName3"/>
                           
                        </td>
                        <td>
                            <label  class="form-control-label"   ng-model="SocietyRegistration.ContactNo3"/>
                        
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
