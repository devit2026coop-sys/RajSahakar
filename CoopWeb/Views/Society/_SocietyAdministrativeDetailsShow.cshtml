                            <label class="form-control-label"  ng-model="SocietyRegistration.DirectorsName4"/>
                          
                        </td>
                        <td>
                            <label  class="form-control-label"   ng-model="SocietyRegistration.ContactNo4"/>
                          
                        </td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>
                            <label class="form-control-label"  ng-model="SocietyRegistration.DirectorsName5"/>
                          
                        </td>
                        <td>
                            <label  class="form-control-label"   ng-model="SocietyRegistration.ContactNo5"/>
                           
                        </td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>
                            <label class="form-control-label"  ng-model="SocietyRegistration.DirectorsName6"/>
                          
                        </td>
                        <td>
                            <label  class="form-control-label"   ng-model="SocietyRegistration.ContactNo6"/>
                       
                        </td>
                    </tr>
                    <tr>
                        <td>7</td>
                        <td>
                            <label class="form-control-label"  ng-model="SocietyRegistration.DirectorsName7"/>
                         
                        </td>
                        <td>
