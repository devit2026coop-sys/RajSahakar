
<style>
    .form-control-label {
        display: block;
        width: 100%;
        height: 34px;
        padding: 6px 12px;
        font-size: 14px;
        line-height: 1.42857143;
        color: #555;
    }
</style>
<form class="dev-masters" name="MyUserForm">
    <div class="col-md-12">
        <div class="form-group col-md-6">
            <label>{{translation.CEOName}}</label>
            <label  class="form-control-label"  ng-model="SocietyRegistration.CEOName"/>
          
        </div>

        <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.CEOContactNo.$invalid && !MyUserForm.CEOContactNo.$pristine }">
            <label>{{translation.ContactNo}}</label>
            <label class="form-control-label" ng-model="SocietyRegistration.CEOContactNo"  />
          
        </div>

        <div class="form-group col-md-6">
            <label>{{translation.ChairmanName}}</label>
            <label  class="form-control-label"  ng-model="SocietyRegistration.ChairmanName"/>
          
        </div>
        <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.ChairmanContactNo.$invalid && !MyUserForm.ChairmanContactNo.$pristine }">
            <label>{{translation.ContactNo}}</label>
            <label  class="form-control-label"   ng-model="SocietyRegistration.ChairmanContactNo"/>
           
        </div>
    </div>




    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table dev-table" style="margin-top: 30px;">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>

                        <th>
                            {{translation.DirectorsName}}
                        </th>
                        <th>
                            {{translation.ContactNo}}
                        </th>

                    </tr>
                </thead>
                <tbody id="myTable">
                    <tr>
                        <td>1</td>
                        <td>
                            <label class="form-control-label"  ng-model="SocietyRegistration.DirectorsName1"/>
                           
                        </td>
                        <td>
                            <label  class="form-control-label"   ng-model="SocietyRegistration.ContactNo1"/>
                         
                        </td>
                    </tr>
