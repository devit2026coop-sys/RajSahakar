

<script src="~/Scripts/AngularFramework/UpdateRegistrationDetails.js"></script>
<div ng-app="UserRole">
    <div ng-controller="Role">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">Update Registration Details</h3>
        </div>
        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title"> Update Registration Details </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" name="MyRoleForm" style="overflow: hidden;">
                            <div class="form-group" ng-class="{ 'has-error' : MyRoleForm.RoleNameEn.$invalid && !MyRoleForm.RoleNameEn.$pristine }">
                                <label>Registration</label>
                                <input type="text" name="name" value="" class="form-control" ng-model="Registration" />
                            </div>
                            <div class="form-group">
                                <div class="dev-align-btn">
                                    <button type="submit" class="btn btn-primary dev-btn" ng-click="InsertSave()" style="margin-right:15px;">{{translation.Submit}}</button>
                                    <button type="button" class="btn btn-primary dev-btn" ng-click="ClearRoleForm()">{{translation.Clear}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown" id="search-filter">
                        <div class="col-md-2 NewMemberdob">
                            <label>
                                {{translation.SearchText}}
                            </label>
                            <input id="txtFromDate" name="searchText" class="form-control" autocomplete="off">
                        </div>
                        <div class="col-md-2">
                            <label>&nbsp;</label><br>
                            <button type="button" ng-click="searchRequest(GetGodownlist)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                            <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                        </div>
                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>RegistrationNo</th>
                                <th>SocietyName</th>
                                <th>SocietyType</th>
                                <th>Act</th>
                                <th>{{translation.TakeAction}}</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in SocietySetall | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="rolePagination">
                                <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                                <td>{{ item.RegistrationNo}}  </td>
                                <td>{{ item.SocietyName | uppercase }}</td>
                                <td>{{ item.TypeameEng | uppercase }}</td>
                                <td>{{ item.ActNameEn | uppercase }}</td>
                                <td>
                                    <input type="button" name="name" value="Action" ng-click="AddClick(item.SocietyId,item.ActId,item);ClearRoleForm()" data-toggle="modal" data-target="#myModal" class="btn btn-primary" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetGodownlist)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetGodownlist)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetGodownlist)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetGodownlist)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetGodownlist)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show='IsVisible'>
            <div class="devpage-breadcrumb">
                <div class="citizen-dash-head">
                    <label>{{translation.ParentMenu}} </label>
                    <select style="width:200px" ng-model="menu.ParentId" data-val-required="Parent Menu field is required." ng-init="menu.ParentId='0'" ng-change="MenuListbyparent()">
                        <option value="0" disabled>{{translation.SelectMasterMenu}}</option>
                        <option ng-repeat="Menu in Menus" ng-show="Menu.ParentId==0" value="{{Menu.MenuId}}">
                            {{_language =='en-us' ?  Menu.MenuNameEn : Menu.MenuNameHi}}
                        </option>
                    </select>
                </div>
            </div>
        </div>
        <div ng-show='IsVisible'>
            <div class="form-group">
                <div class="col-md-12">
                    <div class="table-responsive citizen-dash-head">
                        <table class="table table-responsive devtable">
                            <thead>
                                <tr>
                                    <th style="width:50%"><i ng-click="ShowHideAllRoles()" class="fa {{MenuClass}}"></i>  Menu</th>
                                    <th style="width:30%" ng-click="sortData('MenuUrl')">
                                        {{translation.MenuUrl}}
                                        <div ng-class="getSortClass('MenuUrl')"></div>
                                    </th>
                                    <th style="width:20%">{{translation.MenueAction}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="Menu in AllMenus" current-page="currentPage" pagination-id="MenuPagination" dat-val="{{Menu.ParentId}}" class="_{{Menu.ParentId}}" ng-if="Menu.IsShow">
                                    <td>
                                        <div><i ng-if="Menu.Level1En!='' && Menu.IsChild" ng-click="ShowHideRoles($index,Menu.MenuId,MenuLevel)" class="fa {{Menu.Class}}" dat-val="Menu.ParentId"></i><input style="margin-left: {{Menu.Level1En!='' && Menu.IsChild?15:30}}px;" ng-if="Menu.Level1En!=''" type="checkbox" name="{{AllMenu.MenuId}}" ng-model="Menu.IsChecked" ng-change="optionToggled()" ng-checked="Menu.IsChecked" ng-click="SetUncheckStatus(Menu.MenuId,Menu.IsChecked)" />   {{ Menu.Level1En | uppercase }}</div>
                                        <div style="margin-left:50px;"><i ng-if="Menu.Level2En!='' && Menu.Level1En=='' && Menu.IsChild" ng-click="ShowHideRoles($index,Menu.MenuId,MenuLevel)" class="fa {{Menu.Class}}"></i><input style="margin-left: {{Menu.Level2En!='' && Menu.Level1En=='' && Menu.IsChild?15:30}}px;" ng-if="Menu.Level2En!='' && Menu.Level1En==''" type="checkbox" name="{{AllMenu.MenuId}}" ng-model="Menu.IsChecked" ng-change="optionToggled()" ng-checked="Menu.IsChecked" ng-click="SetUncheckStatus(Menu,AllMenu.MenuIdChecked,Menu.IsChecked)" />{{ Menu.Level2En | uppercase }}</div>
                                        <div style="margin-left:150px;"><input ng-if="Menu.Level2En=='' && Menu.Level3En!=''" type="checkbox" name="{{AllMenu.MenuId}}" ng-model="Menu.IsChecked" ng-change="optionToggled()" ng-checked="Menu.IsChecked" ng-click="SetUncheckStatus(AllMenu,AllMenu.MenuIdChecked,Menu.IsChecked)" />{{ Menu.Level3En | uppercase }}</div>
                                    </td>                                   
                                    <td>{{ Menu.MenuUrl }}</td>
                                    <td>
                                        <ul style="list-style:none;">
                                            <li style="display: inline-block;margin-right:5px; " ng-repeat="item in Menu.MenuActionList"><input type="checkbox" name="Actionchecked{{item.Key}}" ng-model="item.RoleMenuActionCheck" ng-checked="item.RoleMenuActionCheck || (Menu.IsChecked && item.Value=='Add')" value="item.Key" /> {{item.Value}}</li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="dev-align-btn">
                        <button type="button" class="btn btn-primary dev-btn" ng-click="SaveAssignRights()" style="margin-right:15px;">{{translation.Submit}}</button>
                        <button type="button" id="btnShow" ng-click="btnShowClick()" style="margin-right:15px;display:none"></button>
                        <button type="button" class="btn btn-primary dev-btn" ng-click="ClearAssignRightsForm()">{{translation.Clear}}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
