<script src="~/Scripts/AngularFramework/SocietyProfile.js"></script>
<style>
    .form-control-label {
        display: block;
        width: 100%;
        height: 34px;
        padding: 6px 12px;
        font-size: 14px;
        line-height: 1.42857143;
        color: #555;
    }
</style>
<form class="dev-masters" name="SocietyProfileForm">

    <div class="form-group col-md-6">
        <label>{{ translation.Act}} <span></span> </label>
        <label class="form-control-label" ng-model="SocietyRegistration.BRN">
            Registration of  NGOs/ non-profitable charitable societies under the Rajasthan Societies Registration Act, 1958
        </label>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.BRN}}</label>
        <label name="BRN" class="form-control-label" ng-model="SocietyRegistration.BRN">Dinesh</label>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.SocietyRegistrationNo}}</label>
        <label class="form-control-label" ng-model="SocietyRegistration.RegistrationNo"></label>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.SocietyName}} </label>
        <label class="form-control-label" ng-model="SocietyRegistration.SocietyName"></label>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.RegistrationDate}} </label>
        <label class="form-control-label" ng-model="SocietyRegistration.RegistrationDate"></label>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.SocietyType}}</label>
        <label ng-model="SocietyRegistration.SocietyTypeId" class="form-control-label"></label>
    </div>


    <div class="form-group col-md-6">
        <label>{{ translation.SocietyClass}}</label>
        @*<select ng-model="SocietyRegistration.ClassId" class="form-control-label" ng-init="SocietyRegistration.ClassId='0'" ng-change="GetSubClass()">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in SocietyClassList" value="{{item.ClassId}}">
                {{_language =='en-us' ?  item.ClassNameEn : item.ClassNameHi}}
            </option>
        </select>*@
    </div>
    <div class="form-group col-md-6">
        <label>{{ translation.SocietySubClass}}</label>
        <label ng-model="SocietyRegistration.SubClassId" class="form-control-label"> </label>
    </div>


    <div class="form-group col-md-6">
        <label>{{ translation.RegistrationCertificate}} (PDF upto 5MB)</label>
        @*<input type="file" name="File" class="form-control-label" ng-model="SocietyRegistration.RegistrationCertificateFile" onchange="angular.element(this).scope().UploadRegistrationCertificateFile(this.files)">*@
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.Bylaws}} (PDF upto 5MB)@**@</label>
        @*<input type="file" name="File" class="form-control-label" ng-model="SocietyRegistration.BylawsFile" onchange="angular.element(this).scope().UploadBylawsFile(this.files)">*@
    </div>


    <div class="form-group col-md-6">
        <label>{{ translation.RulesAndRegulation}}(File Type - EXCEL upto 5MB)@**@</label>
        @*<input type="file" name="File" class="form-control-label" ng-model="SocietyRegistration.RulesAndRegulation" onchange="angular.element(this).scope().UploadRulesAndRegulationFile(this.files)">*@
    </div>

    <div class="form-group col-md-12">
        <div class="dev-menu-btn" style="margin-top: 20px;">
            <a ng-click="BackToPage()" data-toggle="modal" style="color:#ef0707;float:right;text-decoration:none;cursor:pointer" class="ng-binding">» {{translation.Back}}</a>
        </div>
    </div>

</form>




