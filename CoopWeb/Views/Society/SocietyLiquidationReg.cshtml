<script src="~/Scripts/Excel/myexcel.js"></script>


@Html.Hidden("TemplateId")
<div ng-app="AppEntryFormLiqudation">
    <div ng-controller="Liqudationcnt">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.MonthlyProgressReportofLiquidationFund}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.EntryForm}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.MonthlyProgressReportofLiquidationFund}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowLiqudationContent()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" data-target="#myModal">
                            <h5>&#187; {{translation.NewEntry}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>


        <div class="citizen-dash-head" ng-show="showEntryForm">
            <form>
                <div class="col-lg-12 form-group">
                    <input type="hidden" ng-model="Liqudation.LiqudationDataId" />
                    <div class="col-lg-2">{{translation.DistrictHeading}}</div>
                    <div class="col-lg-4">
                        @*<input type="text" class="form-control" style="text-transform: uppercase" ng-bind="ProgrammeNameEn" ng-model="Liqudation.NameUnit" placeholder="" autocomplete="off" ng-init="Liqudation.NameUnit='0'" />*@
                        <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                        <select name="DISTRICT_ID" ng-model="DistrictId" class="form-control" ng-init="DistrictId=''" id="ddrDistrictId">
                            <option value="">{{translation.SelectOption}}</option>
                            <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                {{_language =='en-us' ?  district.DISTRICT_MANGAL : district.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>

                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.Month}}</div>
                    <div class="col-lg-4">
                        <input id="txtFromMonth" value="date" type="month" class="form-control" autocomplete="off" onkeypress="return false;" />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.DetailsOfAcceptatnce}}</div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Liqudation.DetailsOfAcceptatnce" placeholder="" autocomplete="off" />
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.AcceptedAmount}}</div>
                    <div class="col-lg-4">
                        <input type="number" class="form-control" ng-model="Liqudation.AcceptedAmount" autocomplete="off" />
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.AmountOfRecoveryPrincipal}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Liqudation.PrincipalAmountOfRecovery" placeholder={{translation.BlanckAmount}} autocomplete="off" />
                    </div>

                </div>

                <div class="col-lg-12 form-group">

                    <div class="col-lg-2">{{translation.AmountOfRecoveryInterest}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="number" class="form-control" name="ProgrammeNameHi" ng-bind="ProgrammeNameHi" ng-model="Liqudation.InterestAmountOfRecovery" placeholder={{translation.BlanckAmount}} autocomplete="off" />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.RecoveryBalance}}</div>
                    <div class="col-lg-4">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Liqudation.RecoveryBalance" placeholder="" autocomplete="off" />

                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.FdAmount}}</div>
                    <div class="col-lg-4">
                        <input type='number' ng-model="Liqudation.FdAmount" class="form-control devcalender" placeholder="{{translation.BlanckAmount}}" />
                    </div>
                </div>



                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.FundSavingAccount}}</div>
                    <div class="col-lg-4">
                        <input type='number' ng-model="Liqudation.FundSavingAccount" class="form-control devcalender" placeholder="{{translation.BlanckAmount}}" />
                    </div>
                </div>

                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveLiquidation(true)">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="HideLiqudationContent()">{{translation.Back}}</button>
                    </div>
                </div>
            </form>
        </div>
        <div ng-show="!showEntryForm">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        @*<div class="col-md-4">
                            <label>
                                {{translation.YEAR}} :
                            </label>
                            <select class="form-control" id="ddlFYearId" ng-model="Liqudation.FYearId" ng-init="Liqudation.FYearId='0'">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_MASTR_ID}}">
                                    {{item.FIN_YEAR_NAME}}
                                </option>
                            </select>
                        </div>*@

                        <div class="col-lg-4 form-group">
                            <label>{{translation.Month}}</label>
                            <input id="txtMonth" value="date" type="month" class="form-control" autocomplete="off" onkeypress="return false;" />
                        </div>

                        <div class="col-lg-4 form-group">
                            <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="GridData2()">{{translation.Show}}</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th rowspan="2">
                                    {{translation.SRNO}}
                                </th>

                                <th rowspan="2" style="text-align: left !important;vertical-align:middle">
                                    {{translation.Month}}

                                </th>

                                <th rowspan="2" style="text-align:left !important;vertical-align:middle">
                                    {{translation.DetailsOfAcceptatnce}}

                                </th>

                                <th rowspan="2" style="text-align:center !important;vertical-align:middle">
                                    {{translation.AcceptedAmount}}

                                </th>

                                <th colspan="3" style="text-align:center !important;vertical-align:middle">
                                    {{translation.AmountOfRecovery}}

                                </th>

                                <th rowspan="2" style="text-align:center !important;vertical-align:middle">
                                    {{translation.RecoveryBalance}}
                                </th>
                                <th colspan="3" style="text-align:center !important;vertical-align:middle">
                                    {{translation.TotalAmountInFund}}
                                </th>
                                <th rowspan="3" style="text-align:center !important;vertical-align:middle">
                                    Action
                                </th>
                            </tr>
                            <tr>
                                <th style="text-align:center !important">{{translation.Principal}}</th>
                                <th style="text-align:center !important">{{translation.Interest}}</th>
                                <th style="text-align:center !important">{{translation.Yog}} (5+6)</th>
                                <th style="text-align:center !important">{{translation.FD}}</th>
                                <th style="text-align:center !important">{{translation.SavingAccount}}</th>
                                <th style="text-align:center !important">{{translation.Yog}} (9+10)</th>
                                @*
                                <th rowspan="2" style="text-align:center !important">{{translation.Status}}</th>*@
                                @*
                                <th style="text-align:center !important">{{translation.Edit}}</th>*@
                                @*
                                <th rowspan="3" style="text-align:center !important">{{translation.Delete}}</th>*@

                            </tr>

                            <tr>
                                <th style="text-align:center !important">1</th>
                                <th style="text-align:center !important">2</th>
                                <th style="text-align:center !important">3</th>
                                <th style="text-align:center !important">4</th>
                                <th style="text-align:center !important">5</th>
                                <th style="text-align:center !important">6</th>
                                <th style="text-align:center !important">7</th>
                                <th style="text-align:center !important">8</th>
                                <th style="text-align:center !important">9</th>
                                <th style="text-align:center !important">10</th>
                                <th style="text-align:center !important">11</th>
                            </tr>




                        </thead>
                        <tbody>
                            <tr dir-paginate="BData in LiqudationData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td style="text-align:left !important">
                                    {{ BData.Month}}
                                </td>
                                <td style="text-align:left !important">
                                    {{BData.DetailsOfAcceptatnce}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.AcceptedAmount}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.PrincipalAmountOfRecovery}}
                                </td>

                                <td style="text-align:center !important">
                                    {{BData.InterestAmountOfRecovery}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.PITotal}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.RecoveryBalance}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.FdAmount}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.FundSavingAccount}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.FSTotal}}
                                </td>

                                @*
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="BData.IsActive == 1" ng-click="SetStatus(BData)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>*@

                                <td ng-show="true" style="text-align:center !important">
                                    <i class="fa fa-edit" data-target="#myModalFeedback" data-toggle="modal" ng-click="update(BData)"></i>
                                </td>

                                @*
                                <td ng-show="true" style="text-align:center !important">
                                    <i class="fa fa-trash" data-target="#myModalFeedback" data-toggle="modal" ng-click="SetStatusTrash(BData)"></i>
                                </td>*@


                            </tr>
                        </tbody>
                        <tfoot><tr><td colspan="12"><input type="button" class="btn btn-primary dev-btn" ng-click="ExportData()" value="Export to Excel"></td></tr></tfoot>
                    </table>
                </div>
            </div>



        </div>
    </div>

</div>