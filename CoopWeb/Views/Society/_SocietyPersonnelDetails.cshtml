
<form class="dev-masters" name="SocietyPeronnelDetailsForm">
    <div class="col-md-12">
        <h3> {{translation.SocietyAuthorizedPersonnelDetaails}}  </h3>
        <hr style="margin: 0;">
    </div>
    <div class="form-group col-md-6">
        <label>{{ translation.FirstName}} <span class="error">*</span></label>
        <input type="text" name="FirstName" class="form-control" ng-model="SocietyPersonnel.FirstName" placeholder="{{translation.FirstName}}" ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.LastName}}</label>
        <input type="text" name="LastName" class="form-control" ng-model="SocietyPersonnel.LastName" placeholder="{{translation.LastName}}" ng-required="true" autocomplete="off">
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.OfficerNameEn.$invalid && !MyUserForm.OfficerNameEn.$pristine }">
        <label>{{ translation.DOB}}</label>
        <input type="date" class="form-control" name="DOB" ng-model="SocietyPersonnel.DOB" ng-required="true" autocomplete="off">
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.OfficerNameHi.$invalid && !MyUserForm.OfficerNameHi.$pristine }">
        <label>{{ translation.GenderHeading}}</label>
        <select class="form-control" ng-model="SocietyPersonnel.GENDER_ID" ng-init="SocietyPersonnel.GENDER_ID='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in GenderList" value="{{item.GENDER_ID}}">
                {{_language =='en-us' ?  item.GENDER_DESC_ENG : item.GENDER_DESC_HIN}}
            </option>
        </select>
    </div>
    
    <div class="form-group col-md-6" style="margin-top: 15px;">
        <div class="form-check form-check-inline col-md-4" style="padding: 0;">
            <label class="form-check-label" for="inlineRadio1">{{translation.UrbanRural}}</label>
        </div>

        <div class="form-check form-check-inline col-md-4">
            <div class="radio-item">
                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="true" ng-model="SocietyPersonnel.IsRural" ng-checked="SocietyPersonnel.IsRural">
                <label class="form-check-label option_value" for="inlineRadio1">{{translation.Urban}}</label>
            </div>
        </div>


        <div class="form-check form-check-inline col-md-4">
            <div class="radio-item">
                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="false" ng-model="SocietyPersonnel.IsRural" ng-checked="SocietyPersonnel.IsRural">
                <label class="form-check-label option_value" for="inlineRadio2">{{translation.Rural}}</label>
            </div>
        </div>
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.MobileNo.$invalid && !MyUserForm.MobileNo.$pristine }">
        <label>{{ translation.HouseBuildingNo}}</label>
        <input type="text" name="HouseBuildingNo" class="form-control" ng-model="SocietyPersonnel.HouseBuildingNo" placeholder="{{translation.HouseBuildingNo}}" ng-required="true" autocomplete="off">
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.email.$invalid && !MyUserForm.email.$pristine }">
        <label>{{ translation.LaneStreetName}}</label>
        <input type="text" name="LaneStreetName" class="form-control" ng-model="SocietyPersonnel.LaneStreetName" placeholder="{{translation.LaneStreetName}}" ng-required="true" autocomplete="off">
    </div>
    <div class="form-group col-md-6">
        <label>{{ translation.Locality}}</label>
        <input type="text" name="Locality" class="form-control" ng-model="SocietyPersonnel.Locality" placeholder="{{translation.Locality}}"  ng-required="true" autocomplete="off">

    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.AddressEn.$invalid && !MyUserForm.AddressEn.$pristine }">
        <label class="control-label">{{ translation.State}} </label>
        <select ng-model="StateId" class="form-control" ng-init="StateId='0'" ng-change="GetDistrictList()">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in Statelist" value="{{item.STATE_ID}}">
                {{_language =='en-us' ?  item.STATE_ENG : item.STATE_MANGAL}}
            </option>
        </select>
    </div>

    <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.AddressHi.$invalid && !MyUserForm.AddressHi.$pristine }">
        <label class="control-label">{{ translation.District}} </label>
        <select ng-model="DistrictId" class="form-control" ng-init="DistrictId='0'" ng-change="GetCityList()">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
            </option>
        </select>
    </div>

    <div class="form-group col-md-6">
        <label> {{ translation.City}}</label>
        <select ng-model="CityId" class="form-control" ng-init="CityId='0'" ng-change="GetWardList()">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in CityList" value="{{item.CITY_ID}}">
                {{_language =='en-us' ?  item.CITY_ENG : item.CITY_MANGAL}}
            </option>
        </select>
    </div>
    <div class="form-group col-md-6" ng-class="{ 'has-error' : MyUserForm.PIN.$invalid && !MyUserForm.PIN.$pristine }">
        <label>{{ translation.Ward}}</label>
        <select ng-model="SocietyPersonnel.WARD_ID" class="form-control" ng-init="SocietyPersonnel.WARD_ID='0'">
            <option value="0" disabled>{{translation.SelectOption}}</option>
            <option ng-repeat="item in WardList" value="{{item.WARD_ID}}">
                {{_language =='en-us' ?  item.WARD_ENG : item.WARD_MANGAL}}
            </option>
        </select>
    </div>
    <div class="form-group col-md-6">
        <label>{{ translation.PIN}}</label>
        <input type="text" name="PinCode" class="form-control" ng-model="SocietyPersonnel.PinCode" placeholder="{{translation.PIN}}" maxlength="6" ng-minlength="6" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-required="true" autocomplete="off">
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.TelePhoneWithSTDCode}}</label>
        <input type="text" name="TelNoWithSTDCode" class="form-control" placeholder="{{translation.TelePhoneWithSTDCode}}" ng-model="SocietyPersonnel.TelNoWithSTDCode" autocomplete="off" required onkeypress='return event.charCode >= 48 && event.charCode <= 57'>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.FAXWithSTDCode}}</label>
        <input type="text" name="FaxNoWithSTDCode" class="form-control" placeholder="{{translation.FAXWithSTDCode}}" ng-model="SocietyPersonnel.FaxNoWithSTDCode" autocomplete="off" required onkeypress='return event.charCode >= 48 && event.charCode <= 57'>
        <label ng-show="MyUserForm.Password.$error.required && !MyUserForm.Password.$pristine" class="help-block"> {{translation.PasswordMessage}}</label>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.MobileNo}}</label>
        <input type="text" name="MobileNo" class="form-control" placeholder="{{translation.MobileNo}}" ng-model="SocietyPersonnel.MobileNo" autocomplete="off" required onkeypress='return event.charCode >= 48 && event.charCode <= 57'>
    </div>

    <div class="form-group col-md-6">
        <label>{{ translation.EmailId}}</label>
        <input type="email" name="EmaiId" class="form-control" placeholder="{{translation.EmailId}}" ng-model="SocietyPersonnel.EmaiId" autocomplete="off" required>
    </div>
    <div class="form-group col-md-12">
        <div class="dev-align-btn">
            <button type="submit" class="btn btn-primary dev-btn"  ng-click="SaveSocietyAuthorizedPersonnelDetails()">{{translation.Submit}}</button>
            <button type="button" class="btn btn-primary dev-btn" ng-click="ClearSocietyPersonnelDetailsForm()">{{translation.Clear}}</button>
        </div>
    </div>

</form>

