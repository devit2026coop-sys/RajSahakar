<script src="~/Scripts/AngularFramework/ElectionForm.js?v=1.2"></script>
<style>

    input.picker[type="date"] {
        position: relative;
    }

        input.picker[type="date"]::-webkit-calendar-picker-indicator {
            position: absolute;  
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            padding: 0;
            color: transparent;
            background: transparent;
        }

    .d-flex-cont .form-group {
        position: relative;
    }

        .d-flex-cont .form-group .input-af {
        }

    .d-flex-cont {
        display: flex;
        gap: 15px;
        align-items: end;
    }

        .d-flex-cont .w-100 {
            width: 100%;
        }

        .d-flex-cont .form-group .input-af {
            position: absolute;
            right: 0;
            top: 34px;
            right: 10px;
        }
    .z-position{
        position:relative;
        z-index:9999;
        cursor:pointer;
        text-decoration:none !important;
    }
</style>
<div ng-app="ElectionRole">
    <div ng-controller="Election">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">Add Election Form</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">{{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                </ul>
            </div>
        </div>

        <style>
            .flex {
                display: flex;
            }

            .flexEqual {
                justify-content: space-between;
            }

            .flexMiddel {
                align-items: center;
            }

            .panelCollapsebtn, .panelCollapsebtn:hover, .panelCollapsebtn:focus {
                background: none;
                border: 0px;
                box-shadow: none;
                outline: none;
            }

            .maxHeight {
                max-height: calc(100vh - 164px);
                overflow: auto;
            }

            .MarginTop20 {
                margin-top: 20px;
            }

            .input-file-box input {
                border: 1px solid #ccc;
            }

            .flexForm {
                display: flex;
                flex-wrap: wrap;
            }


            .dvfieldset {
                border: 1px solid #b0adad;
                border-radius: 5px;
                padding-bottom: 10px;
                margin-bottom: 20px;
                background: #fff;
                width: 100%;
            }

            .dvlegend {
                width: auto;
                padding: 24px;
                margin-left: 11px;
                border: 1px solid gray;
                padding: 5px;
                border-radius: 14px;
                font-size: 16px;
                padding-left: 14px;
                padding-right: 15px;
                background: #025e63;
                color: #fff;
            }

            .profile-d1 {
                color: #000;
                background: #fff;
                border-radius: 5px;
            }

            .devtable {
                border: 1px solid rgb(222, 221, 221);
            }

                .devtable thead tr th {
                    background: #64c0c5;
                    color: #fff;
                }

            .clear {
                clear: both;
            }
            input[type=file] {
                -webkit-box-shadow: none;
                box-shadow: none;
                border: 1px solid #ccc !important;
            }
            .download-edt {
                display: flex;
                align-items: center;
                gap: 10px;
                /* justify-content: space-between; */
            }
            a.download-btn { 
/*                border: 1px solid #ccc !important;*/
                padding: 6px 10px;
                border-radius: 4px;
                font-weight: 700;  
                white-space:nowrap;
            }
            .checkbxRow{
                display:flex;
                gap:40px;
                align-items:center;
            }
            .checkbxRow .checkbox{
                margin:0px;
            }

            .devtable thead tr th {
                background: #64c0c5;
                color: #fff;
            }
        </style>     
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="row">
                    <div class="col-md-12">
                        <form>
                            <div class="row">
                                <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                                <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                                <input type="hidden" id="hdnUserIdId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId)" />

                                <div class="col-lg-12 form-group">
                                    <div id="divAddress">
                                        <div class="col-lg-12 form-group MarginTop20">
                                            <h4 class="heading-hr ng-binding"> Election Form <a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_1" class="fa fa-plus-circle expandDetails ng-hide" style="float:right;font-size: 25px;"></a></h4>
                                        </div>

                                        <div class="col-lg-12 form-group MarginTop20 flexForm">
                                            <input type="hidden" ng-model="election.ElectionId" />

                                            <div class="col-md-3 MarginTop20">
                                                <label for="ddlGSS"> संस्था का वर्ग <span style="color:red;">*</span></label>
                                                <select class="form-control" id="SocietyCategoryId" ng-model="election.SocietyCategoryId" ng-init="election.SocietyCategoryId ='0'" ng-disabled="IsSocietyDisabled || isViewMode">
                                                    <option value="0" selected="selected" disabled>--चुनें--</option>
                                                    <option ng-repeat="item in ElectionSocietyCatgoryList" value="{{item.Id}}">
                                                        {{_language =='en-us' ?  item.SocietyCategoryNameHindi : item.SocietyCategoryNameHindi}}
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="col-md-3 MarginTop20">
                                                <label for="ddlGSS"> संस्था का नाम <span style="color:red;">*</span> </label>
                                                <select class="form-control" id="ddlGSS" ng-model="election.SocietyID" ng-init="election.SocietyID ='0'" ng-disabled="IsSocietyDisabled || isViewMode" ng-change="OnSocietyChange()">
                                                    <option value="0" selected="selected" disabled>--चुनें--</option>
                                                    <option ng-repeat="item in SocietyList" value="{{item.SocietyID}}">
                                                        {{_language =='en-us' ?  item.SocietyName : item.SocietyName}}
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> पंजीयन क्रमांक <span style="color:red;">*</span> </label>
                                                <input type="text" class="form-control" ng-model="election.RegistrationNo" maxlength="20" placeholder="Enter Registration No" ng-readonly="IsFreeze" />
                                            </div>

                                            <div class="form-group col-md-3 MarginTop20">
                                                <label for="txtApplicantName"> पंजीयन दिनांक <span style="color:red;">*</span></label>
                                                <input id="RegistrationDate" type="text" class="form-control" ng-model="election.RegistrationDate | date:'dd-MM-yyyy'" placeholder="DD/MM/YYYY" ng-readonly="IsFreeze" />
                                            </div>

                                            <div class="col-md-3 MarginTop20">
                                                <label>क्या संस्था नवगठित है ? <span style="color:red">*</span></label>
                                                <div>
                                                    <label style="margin-right:15px;">
                                                        <input type="radio" ng-model="election.IsNewSociety" ng-value="true" ng-disabled="isViewMode" ng-change="SocietyTypeChanged()" />  हाँ
                                                    </label>

                                                    <label>
                                                        <input type="radio" ng-model="election.IsNewSociety" ng-value="false" ng-disabled="isViewMode"  ng-change="SocietyTypeChanged()"/> नहीं
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-md-3 MarginTop20">
                                                <label>  यदि संस्था नवगठित है, तो प्रथम संचालक मंडल की मनोनयन दिनांक </label>
                                                <input type="date" class="form-control" ng-model="election.FirstBoardNominationDate" ng-change="CalculateDueDate()" max="{{todayDate}}" ng-disabled="!election.IsNewSociety || isViewMode" />
                                            </div>

                                            <div class="form-group col-md-3 MarginTop20">
                                                <label>संचालक मंडल की गत निर्वाचन की दिनांक </label>
                                                <input type="date" class="form-control" ng-model="election.LastElectionDate" max="{{todayDate}}"  ng-change="CalculateDueDate()"  ng-disabled="election.IsNewSociety || isViewMode" />
                                            </div>

                                            <div class="form-group col-md-3 MarginTop20">
                                                <label>निर्वाचन की ड्यू दिनांक </label>
                                                <input type="date" class="form-control" ng-model="election.ElectionDate" ng-change="CalculateDueDate()" ng-disabled="isViewMode" readonly />
                                            </div>

                                            @*<div class="form-group col-md-6 MarginTop20">
                                                <label>निर्वाचन ड्यू होने पर भी निर्वाचन नहीं होने का कारण <span style="color:red;">*</span> </label>
                                                <textarea class="form-control" ng-model="election.ReasonForNonElection" rows="3" ng-disabled="isViewMode" placeholder="निर्वाचन नहीं होने का कारण दर्ज करें"> </textarea>
                                            </div>*@

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>प्रशासक नियुक्ति दिनांक  </label>
                                                <input type="date" class="form-control" ng-model="election.AdminAppointmentDate" max="{{todayDate}}"  ng-disabled="isViewMode" />
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>अवसायन  दिनांक  </label>
                                                <input type="date" class="form-control" ng-model="election.DeputyAdminAppointmentDate" max="{{todayDate}}"  ng-disabled="isViewMode" />
                                            </div>

                                            <div class="col-md-3 MarginTop20">
                                                <label>क्या संस्था के संचालक मंडल में कोई पद रिक्त है? <span style="color:red">*</span></label>

                                                <div>
                                                    <label style="margin-right:15px;">
                                                        <input type="radio" ng-model="election.IsVacantPost" ng-value="true" ng-disabled="isViewMode" />
                                                        हाँ
                                                    </label>

                                                    <label>
                                                        <input type="radio" ng-model="election.IsVacantPost" ng-value="false" ng-disabled="isViewMode" />
                                                        नहीं
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-md-12 MarginTop20" ng-show="election.IsVacantPost">

                                                <table class="table table-bordered table-striped devtable">
                                                    <thead>
                                                        <tr>
                                                            <th>S. No.</th>
                                                            <th><label>रिक्त पद का विवरण </label></th>
                                                            <th><label>रिक्ति दिनांक </label></th>
                                                            <th><label>रिक्ति का कारण </label></th>
                                                            <th> <label>अन्य विवरण</label>  </th>
                                                            <th></th>

                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="vacancy in VacancyList track by $index">

                                                            <input type="hidden" ng-model="vacancy.VacancyId" />
                                                            <td>{{$index + 1}}.</td>
                                                            <td>
                                                                <select class="form-control" ng-model="vacancy.VacantPostId" ng-disabled="isViewMode">
                                                                    <option value="">--चुनें--</option>
                                                                    <option ng-repeat="vacantpost in GodownVacantPostList" value="{{vacantpost.LovValuesId}}" ng-disabled="IsPostSelected(vacantpost.LovValuesId, vacancy)">
                                                                        {{vacantpost.Lovdescription}}
                                                                    </option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="date" class="form-control" ng-model="vacancy.VacancyDate" max="{{todayDate}}"  ng-disabled="isViewMode" />
                                                            </td>
                                                            <td>
                                                                <select class="form-control" ng-model="vacancy.ReasonForVacancyId" ng-disabled="isViewMode">
                                                                    <option value="">--चुनें--</option>
                                                                    <option ng-repeat="reason in ReasonForVacancyList" value="{{reason.LovValuesId}}">
                                                                        {{reason.Lovdescription}}
                                                                    </option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control" ng-model="vacancy.OtherReason" ng-disabled="vacancy.ReasonForVacancyId!=20108 || isViewMode " />
                                                            </td>
                                                            <td>
                                                                <button type="button" class="btn btn-light" ng-click="RemoveVacancy($index)" ng-show="VacancyList.length > 1">
                                                                    <i style="color: #ff5858" class="fa fa-trash "></i>
                                                                </button>

                                                                <button type="button" class="btn btn-success dev-btn" ng-disabled="isViewMode" ng-click="AddVacancy()" ng-show="$last">
                                                                    <i style="color:#fff" class="fa fa-plus"></i> Add
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>


                                            @*<div class="col-md-4 form-group MarginTop20">
            <label style="white-space: break-spaces;"> संस्था द्वारा भेजी गई अपवर्जना मत सूची / विलोपित रिटर्न अधिकारी को अभिप्रेषित <span style="color:red;">*</span> </label>
            <div class="download-edt">
                <input type="file" accept="application/pdf" class="form-control" id="ExcludedVoterListDocument" ng-model="election.ExcludedVoterListDocument" ng-hide="isViewMode"
                       onchange="angular.element(this).scope().SelectExcludedVoterListDocument(this.files)">
                <a class="download-btn" ng-show="election.ExcludedVoterListDocument" href="/Content/Election/VoterDocuments/{{election.ExcludedVoterListDocument}}" target="_blank">
                    <i class="fa fa-download fa-lg"></i> Download File
                </a>
            </div>
        </div>*@

                                            <div class="col-md-4 form-group MarginTop20">
                                                <label> संस्था के उपनियम <span style="color:red;">*</span> </label>
                                                <div class="download-edt">
                                                    <input type="file" accept="application/pdf" class="form-control" id="BylawsDocument" ng-model="election.BylawsDocument" ng-hide="isViewMode"
                                                           onchange="angular.element(this).scope().SelectRelatedUploadBylawsDocument(this.files)">
                                                    <a class="download-btn" ng-show="election.BylawsDocument" href="/Content/Election/BylawsDocument/{{election.BylawsDocument}}" target="_blank">
                                                        <i class="fa fa-download fa-lg"></i> Download File
                                                    </a>
                                                </div>
                                            </div>

                                            <div class="col-md-4 form-group MarginTop20">
                                                <label>संस्था के मुख्य कार्यकारी अधिकारी द्वारा प्रेषित अभ्यर्थना / इकाई / आंचलिक रिटर्निंग अधिकारी की अभिशंसा  <span style="color:red">*</span> </label>
                                                <div class="download-edt">
                                                    <input type="file" accept="application/pdf" class="form-control" id="RecommendationDocument" ng-model="election.RecommendationDocument"
                                                           ng-hide="isViewMode" onchange="angular.element(this).scope().SelectRecommendationDocument(this.files)" />
                                                    <a class="download-btn" ng-show="election.RecommendationDocument" href="/Content/Election/RecommendationDocument/{{election.RecommendationDocument}}" target="_blank">
                                                        <i class="fa fa-download fa-lg"></i>
                                                        Download File
                                                    </a>
                                                </div>
                                            </div>

                                            <div class="clear"></div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <div class="panel-footer" ng-if="!isViewMode" id="divFooter">
                            <div class="dev-align-btn">
                                <button type="submit" class="btn btn-primary dev-btn"  ng-click="InsertElectionForm()" style="margin-right:15px;"> {{election.ElectionId > 0 ? 'Update' : 'Save'}}</button>
                            </div>
                        </div>

                        <!-- Election List Start -->

                        <div class="col-md-12 MarginTop20">
                            <h4 class="heading-hr ng-binding">Election List</h4>

                            <div class="dev-search-form">
                                <div class="col-md-3">
                                    <label for="search">{{translation.Search}}:</label>
                                    <input ng-model="q" id="search" class="form-control" placeholder="Filter text">
                                </div>
                                <div class="col-md-3">
                                    <label for="search">{{translation.ItemPerPage}}:</label>
                                    <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                                </div>
                                <div class="clear"></div>
                            </div>
                            <div class="clear"></div>
                            <div class="col-md-12">
                                <table class="table table-bordered table-striped devtable MarginTop20">

                                    <thead>
                                        <tr>
                                            <th>S.No.</th>
                                            <th>Society Category Name</th>
                                            <th>Society Name</th>
                                            <th>Registration No</th>
                                            <th>Election Date</th>                                           
                                            <th>Action</th>
                                            @*<th>Post(?)</th>*@
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr dir-paginate="item in ElectionList | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="lovPagination">
                                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                            <td>{{item.SocietyCategoryNameHindi}}</td>
                                            <td>{{item.SocietyName}}</td>
                                            <td>{{item.RegistrationNo}}</td>
                                            <td>{{item.ElectionDateV | date:'dd/MM/yyyy'}}</td>
                                            <td>
                                                <a class="z-position" ng-click="EditElection(item)"> <i class="fa fa-edit"></i> </a>
                                                <a class="z-position" ng-click="ViewElection(item)"> <i class="fa fa-eye"></i>  </a>
                                                <a class="z-position" ng-click="DeleteElection(item.ElectionId)"><i class="fa fa-trash"></i> </a>
                                            </td>                                    
                                            @*<td class="text-center">
                                                <input type="checkbox"  ng-model="item.IsPosted" ng-disabled="isViewMode" />
                                            </td>*@
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="text-center">
                                <dir-pagination-controls boundary-links="true" pagination-id="lovPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
    <script>
        function js_PanleCollapse(elem) {
            //alert(1);
            $(elem).parents('.panel').find('.panel-body').slideToggle();
            $(elem).find('i.fa').toggleClass('fa-minus fa-plus');
        }
    </script>
</div>

