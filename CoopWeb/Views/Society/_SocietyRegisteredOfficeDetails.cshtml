                <label>{{ translation.HouseBuildingNo}}<span class="error">*</span></label>
                <input type="text" class="form-control" name="HouseBuildingNoTreasurer" ng-model="SocietyRegisteredOffice.HouseBuildingNoTreasurer" placeholder="{{translation.HouseBuildingNo}}" autocomplete="off">
            </div>
            <div class="form-group col-md-6">
                <label>{{ translation.LaneStreetName}}<span class="error">*</span></label>
                <input type="text" class="form-control" name="LaneStreetNameTreasurer" ng-model="SocietyRegisteredOffice.LaneStreetNameTreasurer" placeholder="{{translation.LaneStreetName}}" autocomplete="off">
            </div>
            <div class="form-group col-md-6">
                <label>{{ translation.Locality}}<span class="error">*</span></label>
                <input type="text" class="form-control" name="LocalityTreasurer" ng-model="SocietyRegisteredOffice.LocalityTreasurer" placeholder="{{translation.Locality}}" autocomplete="off">
            </div>

            <div class="form-group col-md-6">
                <label>{{ translation.State}}<span class="error">*</span></label>
                <select ng-model="SocietyRegisteredOffice.STATE_IDTreasurer" class="form-control" ng-change="GetDivisionList()">
                    <option value="0" disabled>{{translation.SelectOption}}</option>
                    <option ng-repeat="item in Statelist" value="{{item.STATE_ID}}">
                        {{_language =='en-us' ?  item.STATE_ENG : item.STATE_MANGAL}}
                    </option>
                </select>
            </div>

            <div class="form-group col-md-6">
                <label ng-model="SocietyRegisteredOffice.SocietyIdTreasurer"></label>
                <div class="form-check form-check-inline col-md-4" style="padding: 0;">
                    <label class="form-check-label" for="inlineRadio1">{{translation.UrbanRural}}</label>
                </div>


                <div>

                    <div>

                        <div class="col-lg-4">
                            <label class="help-block-gender" style="width:40% !important;">
                                <input type="radio" name="stateMM" id="Idtrueter1" value="True" ng-model="SocietyRegisteredOffice.IsRuralTreasurer" ng-change="IsTreasurer()">{{translation.Urban}}
                            </label>
                            <label class="help-block-gender" style="width:40% !important;">
                                <input type="radio" name="stateFF" id="Iddfalseter2" value="False" ng-model="SocietyRegisteredOffice.IsRuralTreasurer" ng-change="IsTreasurer()">{{translation.Rural}}
                            </label>
                        </div>
                    </div>
                </div>

            </div>
            <div ng-show="UrbanDivTreasurer">
                <div class="form-group col-md-6">
                    <label>{{translation.CityType}}<span class="error">*</span></label>
                    <select ng-model="SocietyRegisteredOffice.CityTypesTreasurer" class="form-control" ng-init="SocietyRegisteredOffice.CityTypesTreasurer='0'" ng-change="GetCityListByCityTypes(4)">
                        {{SocietyRegisteredOffice.CityTypesTreasurer}}
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option value="1">{{translation.NagarParisad}}</option>
                        <option value="2">{{translation.NagarPalika}}</option>
                        <option value="3">{{translation.NagarNigam}}</option>
                    </select>

                </div>

                <div class="form-group col-md-6">
                    <label>{{translation.City}}<span class="error">*</span></label>
                    <select ng-model="SocietyRegisteredOffice.CITY_IDTreasurer" class="form-control" ng-change="GetWardList(4)" ng-init="SocietyRegisteredOffice.CITY_IDTreasurer='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in CityListdataTreasurer" value="{{item.CITY_ID}}">
                            {{_language =='en-us' ?  item.CITY_ENG : item.CITY_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="form-group col-md-6">
                    <label>{{translation.Ward}}<span class="error">*</span></label>
                    <select ng-model="SocietyRegisteredOffice.WARD_IDTreasurer" class="form-control" ng-init="SocietyRegisteredOffice.WARD_IDTreasurer='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in WardTreasurer" value="{{item.WARD_ID}}">
                            {{_language =='en-us' ?  item.WARD_ENG : item.WARD_MANGAL}}
                        </option>
                    </select>
                </div>

            </div>


            <div ng-show="RuralDivTreasurer">
                <div class="form-group col-md-6">
                    <label>{{translation.DivisionHeading}}</label>
                    <select ng-model="SocietyRegisteredOffice.DIVISION_IDTreasurer" id="ddlDivision" name="divisionTreasurer" ng-change="GetDistrictList(4)" class="form-control" ng-init="SocietyRegisteredOffice.DIVISION_IDTreasurer ='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in Divisions" value="{{item.DIVISION_ID}}">
                            {{_language =='en-us' ?  item.DIVISION_ENG : item.DIVISION_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="form-group col-md-6">
                    <label>{{ translation.District}}<span class="error">*</span></label>
                    <select ng-model="SocietyRegisteredOffice.DISTRICT_IDTreasurer" class="form-control" ng-init="SocietyRegisteredOffice.DISTRICT_IDTreasurer='0'" ng-change="BlockListByOffAdd(4)">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in DistrictListTreasurer" value="{{item.DISTRICT_ID}}">
                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="form-group col-md-6">
                    <label>{{ translation.BlockHeading}} </label>
                    <select ng-model="SocietyRegisteredOffice.BLOCK_IDTreasurer" class="form-control" ng-init="SocietyRegisteredOffice.BLOCK_IDTreasurer='0'" ng-change="GramPanchayatList(4)">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in BlocksdataTreasurer | orderBy:'BLOCK_ENG'" value="{{item.BLOCK_ID}}">
                            {{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="form-group col-md-6">
                    <label>{{ translation.GramPanchayatHeading}}</label>

                    <select ng-model="SocietyRegisteredOffice.GP_IDTreasurer" class="form-control" ng-init="SocietyRegisteredOffice.GP_IDTreasurer='0'" ng-change="VillageList(4)">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in GramPanchayatsTreasurer | orderBy:'GramPanchayats'" value="{{item.GP_ID}}">
                            {{_language =='en-us' ?  item.GP_ENG : item.GP_MANGAL}}
                        </option>
                    </select>
                </div>



                <div class="form-group col-md-6">
                    <label>{{translation.Village}}</label>

                    <select ng-model="SocietyRegisteredOffice.VILLAGE_IDTreasurer" class="form-control" ng-init="SocietyRegisteredOffice.VILLAGE_IDTreasurer='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in VillagesTreasurer | orderBy:'VILLAGE_ENG'" value="{{item.VILLAGE_ID}}">
                            {{_language =='en-us' ?  item.VILLAGE_ENG : item.VILLAGE_MANGAL}}
                        </option>
                    </select>
                </div>

            </div>


            <div class="form-group col-md-6">
                <label class="control-label">{{ translation.PIN}}<span class="error">*</span></label>
                <input type="text" name="PinCodeTreasurer" class="form-control" ng-model="SocietyRegisteredOffice.PinCodeTreasurer" placeholder="{{translation.PIN}}" maxlength="6" ng-minlength="6" onkeypress='return event.charCode >= 48 && event.charCode <= 57' autocomplete="off">
            </div>

        </div>
        <br />
        <div class="form-group col-md-12" style="margin-left:10px;">
            <ul>
                <li>{{translation.herebyfirst}} -</li>
                <li>{{translation.herebyTwo}}</li>
                <li>{{translation.herebyThree}}</li>
                <li>{{translation.herebyFour}}</li>
                <li>{{translation.herebyFive}}</li>
                <li ng-show="SocietyRegisteredOffice.ActId=='3'">{{translation.herebySix}}</li>
                <li ng-show="SocietyRegisteredOffice.ActId=='3'">{{translation.herebySeven}}</li>
                <li ng-show="SocietyRegisteredOffice.ActId=='3'">{{translation.herebyEight}}</li>
            </ul>
            <div class="form-group col-md-12">
                <input class="form-check-input" type="checkbox" name="inlinecheckOptions" id="inlinechk1" value="" ng-model="SocietyRegisteredOffice.herebyAccept"> {{translation.herebyNine}}
                <h5 style="margin-top:0px"></h5>
            </div>
        </div>


        <div class="form-group col-md-12">
            <div class="dev-align-btn">
                <button type="submit" ng-if="IsPermanentSave==0" class="btn btn-primary" ng-click="SaveRegisteredOfficeDetails(0)">{{translation.PayPartialSubmit}}</button>
                <button type="submit" ng-if="IsPermanentSave==0" class="btn btn-success" ng-click="SaveRegisteredOfficeDetails(1)">{{translation.Submit}}</button>

                <button type="button" class="btn btn-primary dev-btn" ng-click="ClearSocietyOfficeDetailsForm()">{{translation.Clear}}</button>
                @*<a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../Citizen/Index">{{ translation.Back}}</a>*@
                <button type="submit" ng-if="IsPermanentSave==1" class="btn btn-success" ng-click="SaveRegisteredOfficeDetails(1)">{{translation.Next}}</button>
                <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackClipk()">{{ translation.Back}}</a>
            </div>

        </div>

</form>

