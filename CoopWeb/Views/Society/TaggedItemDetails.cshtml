<script src="~/Scripts/AngularFramework/TaggedItemDetails.js?v=@DateTime.Now.Ticks"></script>
<style>
    .society-dropdown {
        position: absolute;
        top: 80%;
        left: 50%;
        background: #fff;
        border: 1px solid #ccc;
        max-height: 250px;
        overflow-y: auto;
        z-index: 9999;
        width: calc(100% - 30px);
        transform: translateX(-50%);
    }

    .society-option {
        padding: 8px 12px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
        background: #fff;
    }

        .society-option:hover {
            background: #f5f5f5;
        }


    input.picker[type="date"] {
        position: relative;
    }

        input.picker[type="date"]::-webkit-calendar-picker-indicator {
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            padding: 0;
            color: transparent;
            background: transparent;
        }

    .d-flex-cont .form-group {
        position: relative;
    }

        .d-flex-cont .form-group .input-af {
        }

    .d-flex-cont {
        display: flex;
        gap: 15px;
        align-items: end;
    }

        .d-flex-cont .w-100 {
            width: 100%;
        }

        .d-flex-cont .form-group .input-af {
            position: absolute;
            right: 0;
            top: 34px;
            right: 10px;
        }

    .z-position {
        position: relative;
        z-index: 9999;
        cursor: pointer;
        text-decoration: none !important;
    }
</style>
<div ng-app="TaggedItemCnt">
    <div ng-controller="TaggedItemMod">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">Tagged Item Details</h3>
        </div>

        <style>
            .flex {
                display: flex;
            }

            .flexEqual {
                justify-content: space-between;
            }

            .flexMiddel {
                align-items: center;
            }

            .panelCollapsebtn, .panelCollapsebtn:hover, .panelCollapsebtn:focus {
                background: none;
                border: 0px;
                box-shadow: none;
                outline: none;
            }

            .maxHeight {
                max-height: calc(100vh - 164px);
                overflow: auto;
            }

            .MarginTop20 {
                margin-top: 20px;
            }

            .input-file-box input {
                border: 1px solid #ccc;
            }

            .flexForm {
                display: flex;
                flex-wrap: wrap;
            }


            .dvfieldset {
                border: 1px solid #b0adad;
                border-radius: 5px;
                padding-bottom: 10px;
                margin-bottom: 20px;
                background: #fff;
                width: 100%;
            }

            .dvlegend {
                width: auto;
                padding: 24px;
                margin-left: 11px;
                border: 1px solid gray;
                padding: 5px;
                border-radius: 14px;
                font-size: 16px;
                padding-left: 14px;
                padding-right: 15px;
                background: #025e63;
                color: #fff;
            }

            .profile-d1 {
                color: #000;
                background: #fff;
                border-radius: 5px;
            }

            .devtable {
                border: 1px solid rgb(222, 221, 221);
            }

                .devtable thead tr th {
                    background: #64c0c5;
                    color: #fff;
                }

            .clear {
                clear: both;
            }

            input[type=file] {
                -webkit-box-shadow: none;
                box-shadow: none;
                border: 1px solid #ccc !important;
            }

            .download-edt {
                display: flex;
                align-items: center;
                gap: 10px;
                /* justify-content: space-between; */
            }

            a.download-btn {
                /*                border: 1px solid #ccc !important;*/
                padding: 6px 10px;
                border-radius: 4px;
                font-weight: 700;
                white-space: nowrap;
            }

            .checkbxRow {
                display: flex;
                gap: 40px;
                align-items: center;
            }

                .checkbxRow .checkbox {
                    margin: 0px;
                }

            .devtable thead tr th {
                background: #64c0c5;
                color: #fff;
            }
        </style>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="row">
                    <div class="col-md-12">
                        <form>
                            <div class="row">
                                <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                                <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                                <input type="hidden" id="hdnUserIdId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId)" />

                                <div class="col-lg-12 form-group">
                                    <div id="divAddress">
                                        <div class="col-lg-12 form-group MarginTop20">
                                            <h4 class="heading-hr ng-binding">Remaining Tagged Item <a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_1" class="fa fa-plus-circle expandDetails ng-hide" style="float:right;font-size: 25px;"></a></h4>
                                        </div>

                                        <div class="col-lg-12 form-group MarginTop20 flexForm">
                                            <input type="hidden" ng-model="TagData.TagId" />

                                            <!--  new added -->

                                            <div class="col-md-3 MarginTop20">
                                                <label> Name of KVSS/GSS <span style="color:red;">*</span> </label>
                                                <div class="position-relative" style="width:100%;">
                                                    <input type="text" class="form-control" placeholder="Search Society Name/RegNo" ng-model="SocietySearch" ng-change="OnSocietySearchChange()" ng-click="OpenSocietyDropdown()" ng-focus="OpenSocietyDropdown()" autocomplete="off">
                                                    <div class="society-dropdown" ng-show="IsSocietyDropdownOpen">
                                                        <div class="society-option" ng-if="(SocietyList | filter:SocietyFilter).length == 0">
                                                            No Society Found
                                                        </div>

                                                        <div class="society-option" ng-repeat="item in SocietyList | filter:SocietyFilter" ng-click="SelectSociety(item)">
                                                            {{ item.SocietyName }} <span ng-if="item.RegistrationNo">  </span>
                                                            @*- {{ item.RegistrationNo }}*@
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <input type="hidden" ng-model="TagData.DistrictFID" />
                                                <label> District <span style="color:red;">*</span> </label>
                                                <input type="text" class="form-control" ng-model="TagData.DistrictName" maxlength="20" placeholder="Enter District Name" ng-readonly="IsFreeze" />
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> Registration No <span style="color:red;">*</span> </label>
                                                <input type="text" class="form-control" ng-model="TagData.RegistrationNo" maxlength="20" placeholder="Enter Registration No" ng-readonly="IsFreeze" />
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>Society Type<span style="color:red;">*</span> </label>
                                                <select class="form-control" ng-model="TagData.SocietyType">
                                                    <option value="">--Select--</option>
                                                    <option value="KVSS">KVSS</option>
                                                    <option value="GSS">GSS</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>Block<span style="color:red;">*</span> </label>
                                                <select ng-model="TagData.BlockId" class="form-control">
                                                    <option value="0">--Select--</option>
                                                    <option ng-repeat="item in BlockDataList" value="{{item.BLOCK_ID}}">
                                                        {{item.BLOCK_ENG}}
                                                    </option>
                                                </select>
                                            </div>
                                            <!--  end -->

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>Product Type<span style="color:red;">*</span> </label>
                                                <select ng-model="TagData.ProductTypeId" class="form-control" ng-change="GetProduct(TagData.ProductTypeId)">
                                                    <option value="0">--Select--</option>
                                                    <option ng-repeat="item in ProductTypeDataList" value="{{item.ProductTypeId}}">
                                                        {{item.ProductType}}
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>Product</label>
                                                <select ng-model="TagData.ProductId" class="form-control">
                                                    <option value="0">--Select--</option>
                                                    <option ng-repeat="item in ProductDataList" value="{{item.ProductId}}">
                                                        {{item.ProductName}}
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>Company Name<span style="color:red;">*</span> </label>
                                                <select ng-model="TagData.CompanyId" class="form-control" ng-if="IsCompanyName != true">
                                                    <option value="0">--Select--</option>
                                                    <option ng-repeat="item in CompanyDataList" value="{{item.CompanyId}}">
                                                        {{item.CompanyName}}
                                                    </option>
                                                </select>
                                                <input type="text" class="form-control" ng-model="TagData.CompanyName" ng-if="IsCompanyName == true" />
                                            </div>
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> Date of Purchase/Tagging <span style="color:red;">*</span> </label>
                                                <input type="date" class="form-control" ng-model="TagData.PurchaseDate" min="{{ today | date:'yyyy-MM-dd' }}" />
                                            </div>
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> Date of Expiration <span style="color:red;">*</span> </label>
                                                <input type="date" class="form-control" ng-model="TagData.ExpirationDate" min="{{ today | date:'yyyy-MM-dd' }}" />
                                            </div>
                                            @*<div class="col-md-3 form-group MarginTop20">
                                                    <label>Packaging Type<span style="color:red;">*</span> </label>
                                                    <select class="form-control" ng-model="TagData.PackagingType">
                                                        <option value="">--Select--</option>
                                                        <option value="Bottle">Bottle</option>
                                                        <option value="Packet/Bag">Packet/Bag</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-3 form-group MarginTop20">
                                                    <label>Measurement Unit<span style="color:red;">*</span> </label>
                                                    <select class="form-control" ng-model="TagData.MeasurementUnit">
                                                        <option value="">--Select--</option>
                                                        <option value="Ml">ML/Liter</option>
                                                        <option value="Liter">ML/Liter</option>
                                                        <option value="Mg">Mg/Kg</option>
                                                        <option value="Kg">Mg/Kg</option>
                                                    </select>
                                                </div>*@
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>Packaging Type <span style="color:red;">*</span></label>
                                                <select class="form-control" ng-model="TagData.PackagingType" ng-change="TagData.MeasurementUnit = ''">
                                                    <option value="">--Select--</option>
                                                    <option value="Bottle">Bottle</option>
                                                    <option value="Packet/Bag">Packet/Bag</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>Measurement Unit <span style="color:red;">*</span></label>
                                                <select class="form-control" ng-model="TagData.MeasurementUnit">
                                                    <option value="">--Select--</option>
                                                    <!-- Bottle selected -->
                                                    <option value="Ml" ng-if="TagData.PackagingType == 'Bottle'">ML</option>
                                                    <option value="Liter" ng-if="TagData.PackagingType == 'Bottle'">Liter</option>
                                                    <!-- Packet/Bag selected -->
                                                    <option value="Mg" ng-if="TagData.PackagingType == 'Packet/Bag'">Mg</option>
                                                    <option value="Kg" ng-if="TagData.PackagingType == 'Packet/Bag'">Kg</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> Enter Quantity <span style="color:red;">*</span> </label>
                                                <input type="number" class="form-control" ng-model="TagData.ItemQuantity" autocomplete="off" min="0" ng-change="calculateAmount(TagData.ItemQuantity,TagData.ItemPrice)" />
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> Price Per Unit <span style="color:red;">*</span> </label>
                                                <input type="number" class="form-control" ng-model="TagData.ItemPrice" autocomplete="off" min="0" ng-change="calculateAmount(TagData.ItemQuantity,TagData.ItemPrice)" />
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> Total Purchase Price<span style="color:red;">*</span> </label>
                                                <input type="text" class="form-control" ng-model="TagData.TotalPrice" autocomplete="off" min="0" readonly="readonly" />
                                            </div>

                                            <div class="clear"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <div class="panel-footer" ng-if="!isViewMode" id="divFooter">
                            <div class="dev-align-btn">
                                <button type="submit" class="btn btn-primary dev-btn" ng-click="InsertTagDataForm()" style="margin-right:15px;"> {{TagData.TagId > 0 ? 'Update' : 'Save'}}</button>
                            </div>
                        </div>
                    </div>

                    <div class="panel-body">
                        <table class="table table-responsive devtable mb-2">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">Sr.No</th>
                                    <th class="text-center">Society Name</th>
                                    <th class="text-center">Registration No</th>
                                    <th class="text-center">Product Type</th>
                                    <th class="text-center">Product Name</th>
                                    <th class="text-center">Company</th>
                                    <th class="text-center">Purchase Date</th>
                                    <th class="text-center">Expiration Date</th>
                                    <th class="text-center">Packaging Type</th>
                                    <th class="text-center">Measurement Unit</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-center">Price</th>
                                    <th class="text-center">Total Price</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat-start="item in TaggingItemDataList track by $index">
                                    <td> <span>{{$index + 1 + ((currentPage - 1) * pageSize)}}</span> </td>
                                    <td> {{item.SocietyName}} </td>
                                    <td> {{item.RegistrationNo}} </td>
                                    <td> {{item.ProductType}} </td>
                                    <td> {{item.ProductName}} </td>
                                    <td> {{item.CompanyName}} </td>
                                    <td> {{item.PurchaseDate}} </td>
                                    <td> {{item.ExpirationDate}} </td>
                                    <td> {{item.PackagingType}} </td>
                                    <td> {{item.MeasurementUnit}} </td>
                                    <td> {{item.ItemQuantity}} </td>
                                    <td> {{item.ItemPrice}} </td>
                                    <td> {{item.TotalPrice}} </td>
                                    <td>
                                        @*<a href="javascript:void(0);" class="action-icon text-primary" title="Edit" ng-click="updateTaggedItem(item.TagId)">
                <i class="fa fa-pencil-square"></i>
            </a>*@
                                        <a href="javascript:void(0);" class="action-icon text-primary" title="Delete" ng-click="deleteTaggedItem(item.TagId)">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                <tr ng-repeat-end></tr>
                                <tr ng-if="!TaggingItemDataList || TaggingItemDataList.length == 0">
                                    <td colspan="11" class="text-center">
                                        Record Not found
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

