<script src="~/Scripts/AngularFramework/AddGodownForm.js?v=1.2"></script>
<style>

    input.picker[type="date"] {
        position: relative;
    }

        input.picker[type="date"]::-webkit-calendar-picker-indicator {
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            padding: 0;
            color: transparent;
            background: transparent;
        }

    .d-flex-cont .form-group {
        position: relative;
    }

        .d-flex-cont .form-group .input-af {
        }

    .d-flex-cont {
        display: flex;
        gap: 15px;
        align-items: end;
    }

        .d-flex-cont .w-100 {
            width: 100%;
        }

        .d-flex-cont .form-group .input-af {
            position: absolute;
            right: 0;
            top: 34px;
            right: 10px;
        }
</style>
<div ng-app="GodownRole">
    <div ng-controller="Godown">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">Add Godown</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                </ul>
            </div>
        </div>

        <style>
            .flex {
                display: flex;
            }

            .flexEqual {
                justify-content: space-between;
            }

            .flexMiddel {
                align-items: center;
            }

            .panelCollapsebtn, .panelCollapsebtn:hover, .panelCollapsebtn:focus {
                background: none;
                border: 0px;
                box-shadow: none;
                outline: none;
            }

            .maxHeight {
                max-height: calc(100vh - 164px);
                overflow: auto;
            }

            .MarginTop20 {
                margin-top: 20px;
            }

            .input-file-box input {
                border: 1px solid #ccc;
            }

            .flexForm {
                display: flex;
                flex-wrap: wrap;
            }



            .dvfieldset {
                border: 1px solid #b0adad;
                border-radius: 5px;
                padding-bottom: 10px;
                margin-bottom: 20px;
                background: #fff;
                width: 100%;
            }

            .dvlegend {
                width: auto;
                padding: 24px;
                margin-left: 11px;
                border: 1px solid gray;
                padding: 5px;
                border-radius: 14px;
                font-size: 16px;
                padding-left: 14px;
                padding-right: 15px;
                background: #025e63;
                color: #fff;
            }

            .profile-d1 {
                color: #000;
                background: #fff;
                border-radius: 5px;
            }

            .devtable {
                border: 1px solid rgb(222, 221, 221);
            }

                .devtable thead tr th {
                    background: #64c0c5;
                    color: #fff;
                }
        </style>
        @*start from here GoDown Form*@
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="row">
                    <div class="col-md-12">
                        <form>
                            <div class="row">
                                <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                                <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                                <input type="hidden" id="hdnUserIdId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId)" />

                                <div class="col-lg-12 form-group">
                                    <div id="divAddress">
                                        <div class="col-lg-12 form-group MarginTop20">
                                            <h4 class="heading-hr ng-binding"> New Godown Formation<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_1" class="fa fa-plus-circle expandDetails ng-hide" style="float:right;font-size: 25px;"></a></h4>
                                        </div>                                        

                                        <div class="col-lg-12 form-group MarginTop20 flexForm">
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> Godown Metric Ton</label>
                                                <select class="form-control" id="ddlMT" ng-model="godown.MTCapacityId">
                                                    <option value="">Select Capacity (MT)</option>
                                                    <option ng-repeat="item in MTCapacityList" value="{{item.LovValuesId}}">
                                                        {{item.Lovdescription}}
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="col-md-3 MarginTop20">
                                                <label for="ddlGSS"> Society</label>
                                                <select class="form-control" id="ddlGSS" ng-model="godown.SocietyID" ng-disabled="IsSocietyDisabled || isViewMode" ng-change="OnSocietyChange()">
                                                    <option value="" selected="selected" disabled>{{translation.SelectOption}}</option>
                                                    <option ng-repeat="item in SocietyList" value="{{item.SocietyID}}">
                                                        {{_language =='en-us' ?  item.SocietyName : item.SocietyName}}
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="form-group1 col-md-3 MarginTop20">
                                                <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                                                <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                                                <label class="ng-binding"><span class="DISTRICT_TXT">District</span><span class="error">*</span></label>
                                                <select id="district_MemberAdd" ng-model="district_MemberAdd" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty" ng-change="GetConstituencyList()" ng-disabled="true">
                                                    <option value="">{{translation.SelectOption}}</option>
                                                    <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                                        {{_language =='en-us' ?  district.DISTRICT_ENG : district.DISTRICT_MANGAL}}
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="form-group1 col-md-3 Rurals_MemberAdd  MarginTop20">
                                                <label><span class="BLOCK_TXT"> Block </span><span class="error">*</span></label>
                                                <select id="ddlblocki_MemberAdd" ng-model="ddlblocki_MemberAdd" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty" ng-change="getGrampanchyat(ddlblocki_MemberAdd)" ng-disabled="true">
                                                    <option value="">{{translation.SelectOption}}</option>
                                                    <option ng-repeat="block in BlockDataList" value="{{block.BLOCK_ID}}">
                                                        {{_language =='en-us' ?  block.BLOCK_ENG : block.BLOCK_MANGAL}}
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="form-group1 col-md-3 Rurals_MemberAdd  MarginTop20">
                                                <label><span class="GRAMPANCHAYAT_TXT">Gram Panchayat</span><span class="error">*</span></label>
                                                <select id="ddlGP_MemberAdd" ng-model="ddlGP_MemberAdd" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty" ng-change="getvillage(ddlGP_MemberAdd)" ng-disabled="true">
                                                    <option value="">{{translation.SelectOption}}</option>
                                                    <option ng-repeat="gp in GramPancyatList" value="{{gp.GP_ID}}">
                                                        {{_language =='en-us' ?  gp.GP_ENG : gp.GP_MANGAL}}
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="form-group1 col-md-3 Rurals_MemberAdd  MarginTop20">
                                                <label><span class="VILLAGE_TXT">Village</span><span class="error">*</span></label>
                                                <select id="ddlVillage_MemberAdd" ng-model="ddlVillage_MemberAdd" class="form-control" ng-disabled="true">
                                                    <option value="">{{translation.SelectOption}}</option>
                                                    <option ng-repeat="vill in VillageList" value="{{vill.VILLAGE_ID}}">
                                                        {{_language =='en-us' ?  vill.VILLAGE_ENG : vill.VILLAGE_MANGAL}}
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="form-group col-md-3 MarginTop20">
                                                <label for="txtApplicantName"> Chairman Name <span class="error">*</span></label>
                                                <input type="text" id="txtApplicantName" class="form-control" ng-model="godown.ApplicantName" placeholder="Enter Chairman Name" ng-readonly="IsFreeze" />
                                            </div>

                                            <div class="form-group col-md-3 MarginTop20">
                                                <label for="ddlGdf">Select CCB</label>
                                                <select class="form-control" id="ddlCCB" ng-model="godown.CCB" ng-init="godown.CCB=''" ng-change="GetCcbBranchList('0')">
                                                    <option value="">{{translation.SelectOption}}</option>
                                                    <option ng-repeat="item in CCBdataset" value="{{item.CCBId}}">
                                                        {{_language =='en-us' ?  item.CCBNameEn : item.CCBNameHi}}
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>
                                                    {{translation.BankBranch}}
                                                </label>
                                                <select ng-model="godown.CCBBranchId" id="BranchId" class="form-control" ng-init="godown.CCBBranchId='0'">
                                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                                    <option ng-repeat="itemBlock in BranchList | orderBy:'BranchNameEn'" value="{{itemBlock.Branch_ID}}">
                                                        {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameHi}}
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label> IFSC Code <span style="color:red">*</span> </label>
                                                <input type="text" class="form-control" ng-model="godown.IFSCCode" maxlength="11" placeholder="Enter IFSC Code" />
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>  Account Number <span style="color:red">*</span> </label>
                                                <input type="text" class="form-control" ng-model="godown.AccountNumber" maxlength="20" placeholder="Enter Account Number" />
                                            </div>

                                            <div class="col-md-3 form-group MarginTop20">
                                                <label>Availability of Society</label>
                                                <select class="form-control" id="ddlMT" ng-model="godown.SocietyAvailabilityId">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="item in GodownLandList" value="{{item.LovValuesId}}">
                                                        {{item.Lovdescription}}
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="col-md-3 MarginTop20" ng-show="godown.SocietyAvailabilityId == '20080'">
                                                <label>Please Specify <span class="error">*</span></label>
                                                <input type="text" class="form-control" ng-model="godown.SocietyAvailabilityRemark" placeholder="Enter Details">
                                            </div>

                                            <div class="clear"></div>

                                            <div class="col-lg-12 form-group">
                                                <h4 class="heading-hr ng-binding">Godown Details<a href="javascript:void(0);" dat-val="panal_1" class="fa fa-plus-circle expandDetails ng-hide" style="float:right;font-size: 25px;"></a></h4>
                                                <div class="form-group1 col-md-3 MarginTop20">
                                                    <label>Sanction Amt<span class="error">*</span></label>
                                                    <input type="number" class="form-control" name="SanctionAmt" ng-model="godown.Amt" placeholder="Amount" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                                </div>

                                                <div class="form-group col-md-4">
                                                    <div class="d-flex-cont">
                                                        <div class="form-group   w-100 mb-0 MarginTop20">
                                                            <label>Land Size </label>
                                                            <input type="number" class="form-control" ng-model="godown.LandSize1" placeholder="Enter Number Land" min="0">
                                                            <span class="input-af">फीट</span>
                                                        </div>
                                                        <div class="" style="display:flex; align-items:center; justify-content:center;  ">
                                                            <label style="font-size:20px; font-weight:bold; color:#333;">✖</label>
                                                        </div>
                                                        <div class="form-group  w-100 mb-0 MarginTop20">
                                                            <label style="opacity:0;">Total </label>
                                                            <input type="number" class="form-control" ng-model="godown.LandSize2" placeholder="Enter Number" min="0">
                                                            <span class="input-af">फीट</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-5  ">
                                                    <div class="d-flex-cont">
                                                        <div class="form-group w-100 mb-0 MarginTop20">
                                                            <label>Total </label>
                                                            <input type="number" class="form-control" ng-model="godown.TotalLandSize1" placeholder="Enter Number" min="0">
                                                            <span class="input-af">वर्ग मीटर</span>
                                                        </div>
                                                        <div class="" style="display:flex; align-items:center; justify-content:center;  ">
                                                            <label style="font-size:20px; font-weight:bold; color:#333;">✖</label>
                                                        </div>
                                                        <div class="form-group  w-100 mb-0 MarginTop20">
                                                            <label style="opacity:0;">Total </label>
                                                            <input type="number" class="form-control" ng-model="godown.TotalLandSize2" placeholder="Enter Number" min="0"> <span class="input-af">वर्ग मीटर</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <fieldset class="dvfieldset">
                                                <legend class="dvlegend">Documents Upload:</legend>
                                                <div class="col-lg-12 profile-d1">
                                                    <div class="col-lg-12 table-responsive">
                                                        <table class="table devtable" style="margin-bottom: 0px;">
                                                            <thead>
                                                                <tr>
                                                                    <th>Document Name</th>
                                                                    <th>Upload File</th>
                                                                    <th>File View</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="doc in GodownDocList" ng-show="(godown.MTCapacityId == '20068') || (doc.LovValuesId != '20075' && doc.LovValuesId  != '20076')">
                                                                    <td>{{doc.Lovdescription}}</td>
                                                                    <td>
                                                                        <input type="file" class="form-control" onchange="angular.element(this).scope().$parent.GodownUploadDocument(this.files, this.getAttribute('data-docid'))" data-docid="{{doc.LovValuesId}}" />
                                                                    </td>
                                                                    <td>
                                                                        <span ng-repeat="item in GodownDocuments" ng-if="item.DocId == doc.LovValuesId">
                                                                            <a href="/Content/Godown/Documents/{{item.FilePath}}" target="_blank" style="color:#505050;">  <i class="fa fa-download"></i>  View File </a>
                                                                        </span>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </fieldset>

                                            <div class="col-md-3 form-group MarginTop20" ng-show="godown.MTCapacityId == '20064'">
                                                <label> No. of Godown <span style="color:red">*</span> </label>
                                                <input type="number" class="form-control" ng-model="godown.NoOfGodown" min="1" placeholder="Enter No. of Godown"  ng-change="GenerateGodownRows()" />
                                            </div>

                                            <div class="col-lg-12 form-group" ng-show="godown.MTCapacityId == '20064' && godown.NoOfGodown > 0">
                                                <table class="table table-bordered mb-0 table-responsive devtable">
                                                    <thead>
                                                        <tr>
                                                            <th>SNo.</th>
                                                            <th>Society</th>
                                                            <th>MT Capacity</th>
                                                            <th>Scheme</th>
                                                            <th>Financial Year</th>
                                                            <th>&nbsp;</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="item in TblGodownTimeBoundDetails">
                                                            <input type="hidden" ng-model="item.ID" />
                                                            <td>{{$index + 1}}</td>

                                                            <td>
                                                                <select class="form-control" ng-model="item.SocietyID">
                                                                    <option value="">--Select Society--</option>
                                                                    <option ng-repeat="soc in SocietyList" value="{{soc.SocietyID}}">  {{soc.SocietyName}} </option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <select class="form-control" ng-model="item.MTCapacityId">
                                                                    <option value="">--Select MT--</option>
                                                                    <option ng-repeat="mt in MTCapacityList" value="{{mt.LovValuesId}}">  {{mt.Lovdescription}}  </option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <select class="form-control" ng-model="item.SchemeId">
                                                                    <option value="">--Select Scheme--</option>
                                                                    <option ng-repeat="scheme in SchemeList" value="{{scheme.LovValuesId}}"> {{scheme.Lovdescription}} </option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <select class="form-control" ng-model="item.FinancialYearID">
                                                                    <option value="">--Select Financial Year--</option>
                                                                    <option ng-repeat="item in FinancialYears" value="{{item.FIN_YEAR_MASTR_ID}}">
                                                                        {{item.FIN_YEAR_NAME}}
                                                                    </option>
                                                                </select>
                                                            </td>
                                                            <td style="text-align:right">
                                                                <button ng-if="TblGodownTimeBoundDetails.length > 1" class="btn btn-primary dev-btn" ng-click="RemoveRow($index)">  Remove Row  </button>
                                                            </td>
                                                        </tr>                                                        
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <div class="panel-footer" id="divFooter">
                            <div class="dev-align-btn">
                                <button type="submit" class="btn btn-primary dev-btn" ng-click="InsertGodownForm()" style="margin-right:15px;"> {{godown.ProposalId > 0 ? 'Update' : 'Save'}}</button>
                                <a href="javascript:void(0);" class="btn btn-primary dev-btn" ng-click="GoBack()"><i class="fa fa-angle-left"></i>&nbsp;Back</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
    <script>
        function js_PanleCollapse(elem) {
            //alert(1);
            $(elem).parents('.panel').find('.panel-body').slideToggle();
            $(elem).find('i.fa').toggleClass('fa-minus fa-plus');
        }
    </script>
</div>

