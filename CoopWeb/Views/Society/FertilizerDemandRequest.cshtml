                                                        <th>Fertilizer Name</th>
                                                        <th>Fertilizer Sale</th>
                                                        <th>Fertilizer Quantity</th>
                                                        @*<th>Fertilizer Rate</th>
                                                            <th>Fertilizer Cost</th>*@
                                                        <th>Present Availability</th>
                                                        <th>Credit Limit</th>
                                                        @*<th>Other Fertilizer Name</th>*@
                                                        <th>Year</th>
                                                        <th>Month</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="credit in FertilizerCreditList track by $index" ng-style="credit.FertilizerName == 'Grand Total' && {'font-weight':'bold','color':'black'}">
                                                        <td><span ng-hide="demand.FertilizerName == 'Grand Total'">{{$index + 1 }}</span></td>
                                                        <td>
                                                            {{credit.FertilizerName}}
                                                        </td>
                                                        <td>
                                                            {{credit.FertilizerSale | number}}
                                                        </td>
                                                        <td>
                                                            {{credit.FertilizerQuantity | number}}
                                                        </td>
                                                        @*<td>
                                                                {{credit.FertilizerRate | number}}
                                                            </td>
                                                            <td>
                                                                {{credit.FertilizerCost | number}}
                                                            </td>*@
                                                        <td>
                                                            {{credit.PresentAvailability | number}}
                                                        </td>
                                                        <td>
                                                            {{credit.CreditLimit | number}}
                                                        </td>
                                                        @*<td>
                                                                {{credit.OtherFertilizerName}}
                                                            </td>*@
                                                        <td>
                                                            {{credit.YearName}}
                                                        </td>
                                                        <td>
                                                            {{credit.MonthsName}}
                                                        </td>
                                                    </tr>
                                                    <tr ng-if="!FertilizerCreditList || FertilizerCreditList.length == 0">
                                                        <td colspan="9" class="text-center">
                                                            No Credit Facility Details Found
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
