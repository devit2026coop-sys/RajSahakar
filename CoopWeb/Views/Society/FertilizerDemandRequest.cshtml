                                        <a href="javascript:void(0);" class="action-icon text-success me-2" title="View Demand Details" ng-click="ViewDemandRequest(item)">
                                            <i class="fa" ng-class="item.ShowDemandDetails ? 'fa-minus' : 'fa-plus'"></i>
                                        </a>
                                        <a ng-if="item.IsCreditFacility == 'No'" href="javascript:void(0);" class="action-icon text-info me-2" title="View Credit Facility" ng-click="ViewCreditRequest(item)">
                                            <i class="fa" ng-class="item.ShowCreditDetails ? 'fa-minus' : 'fa-plus'"></i>
                                        </a>
                                        <a href="javascript:void(0);" class="action-icon text-success me-2" title="View Purchase Details" ng-click="ViewPurchaseRequest(item)">
                                            <i class="fa" ng-class="item.ShowPurchaseDetails ? 'fa-minus' : 'fa-plus'"></i>
                                        </a>
                                        <a href="javascript:void(0);" class="action-icon text-primary" title="Edit" ng-click="updateFertilizer(item)">
                                            <i class="fa fa-pencil-square"></i>
                                        </a>
                                    </td>
                                </tr>
                                <tr ng-if="item.ShowDemandDetails || item.ShowCreditDetails || item.ShowPurchaseDetails">
                                    <td colspan="11">
                                        <div ng-if="item.ShowDemandDetails">
                                            <table class="table table-bordered table-striped mb-2">
                                                <thead>
                                                    <tr>
                                                        <th>Sr.No</th>
                                                        <th>Fertilizer Name</th>
                                                        <th>Fertilizer Company</th>
                                                        <th>Quantity</th>
                                                        <th>Year</th>
                                                        <th>Month</th>
