                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="demand in FertilizerDemandList track by $index" ng-style="demand.FertilizerName == 'Grand Total' && {'font-weight':'bold','color':'black'}">
                                                        <td><span ng-hide="demand.FertilizerName == 'Grand Total'">{{$index + 1 }}</span></td>

                                                        <td>
                                                            {{demand.FertilizerName}}
                                                        </td>
                                                        <td><span ng-hide="demand.FertilizerCompany == 'Grand Total' && demand.FertilizerCompany == ''"> {{demand.FertilizerCompany}}</span></td>
                                                        <td>
                                                            {{demand.FertilizerQuantity | number}}
                                                        </td>
                                                        <td>
                                                            {{demand.YearName}}
                                                        </td>
                                                        <td>
                                                            {{demand.MonthsName}}
                                                        </td>
                                                        @*<td>
                                                                    {{demand.FertilizerRate | number}}
                                                                </td>
                                                                <td>
                                                                    {{demand.FertilizerCost | number}}
                                                                </td>
                                                            <td ng-if="demand.OtherFertilizerName!=null || item.OtherFertilizerName!=''">
                                                                {{demand.OtherFertilizerName}}
                                                            </td>*@
                                                    </tr>
                                                    <tr ng-if="!FertilizerDemandList || FertilizerDemandList.length == 0">
                                                        <td colspan="9" class="text-center">
                                                            No Demand Details Found
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
