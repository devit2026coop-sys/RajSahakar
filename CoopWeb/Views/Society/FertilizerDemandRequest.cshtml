                                                        <th>Sr.No</th>
                                                        <th>Fertilizer Name</th>
                                                        <th>Quantity</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="purchase in FertilizerPurchaseList track by $index" ng-style="purchase.FertilizerName == 'Grand Total' && {'font-weight':'bold','color':'black'}">
                                                        <td><span ng-hide="purchase.FertilizerName == 'Grand Total'">{{$index + 1 }}</span></td>
                                                        <td>
                                                            {{purchase.FertilizerName}}
                                                        </td>
                                                        <td>
                                                            {{purchase.FertilizerQuantity | number}}
                                                        </td>
                                                    </tr>
                                                    <tr ng-if="!FertilizerPurchaseList || FertilizerPurchaseList.length == 0">
                                                        <td colspan="9" class="text-center">
                                                            No Purchase Details Found
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                                <tr ng-repeat-end></tr>
                                <tr ng-if="!FertilizerDataList || FertilizerDataList.length == 0">
                                    <td colspan="11" class="text-center">
                                        Record Not found
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

