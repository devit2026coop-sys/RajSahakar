<script src="~/Scripts/AngularFramework/ApexBankSocietyDetail.js"></script>

<div ng-app="ApexBankSocietyDetailMod" ng-controller="ApexBankSocietyDetailCont">

    <div class="col-md-12">
        <h3 class="citizen-dash-head">{{ translation.ApexBankSocietyDetail}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.ApexBankSocietyDetail}} </span>
                </li>
            </ul>
        </div>
    </div>


    <div class="col-md-12">
        <div class="table-responsive citizen-dash-head">
            <div class="table-dropdown">
                <div class="col-md-4" style="padding-left: 0;">
                    <label for="search">{{translation.Search}}:</label>
                    <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                </div>

                <div class="col-md-4">
                    <label for="search">{{translation.ItemPerPage}}:</label>
                    <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                </div>
            </div>
            <table id="example" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                        @*<th>
            {{translation.SocietyName}}
        </th>*@
                        <th ng-click="sortData('SocietyName')">
                            {{translation.SocietyName}}
                            <div ng-class="getSortClass('SocietyName')"></div>
                        </th>
                        <th ng-click="sortData('RegistrationNo')">
                            {{translation.SocietyRegistrationNo}}
                            <div ng-class="getSortClass('RegistrationNo')"></div>
                        </th>
                        <th>
                            {{translation.RegistrationDate}}
                        </th>
                        <th ng-click="sortData('DISTRICT_ENG')">
                            {{translation.District}}
                            <div ng-class="getSortClass('DISTRICT_ENG')"></div>
                        </th>
                        @*<th>
            {{translation.SocietyRegistrationNo}}
        </th>
        <th>
            {{translation.SocietyType}}
        </th>
                            <th>
            {{translation.Status}}
        </th>*@
                        <th>
                            {{translation.Actions}}
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <tr dir-paginate="item in TableData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SocietyIdForTbl">
                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                        <td>{{item.SocietyName}}</td>
                        <td>{{item.RegistrationNo}}</td>
                        <td>{{item.RegistrationDate}}  </td>
                        <td>{{item.DISTRICT_ENG}}  </td>
                        @*<td>{{item.Status}}</td>*@
                        <td class="add-more-td">
                            @*<a class="add-more" ng-if="item.IsPermanentSave==0" title="{{translation.AddMoreDetails}}" ng-click="AddAdministrativeDetails(item.SocietyIdENC,'AddMoreDetails',item.SocietyName,item.IsAdministrativeDetails,item.RegistrationNo,item.ActId)"> <i class="fa fa-edit editicon-edit"></i> </a>*@
                            <a title="{{translation.ShowDetails}}" ng-click="ShowDetails(item.SocietyIdENC)"><i class="fa fa-eye"></i></a>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="SocietyIdForTbl" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>


            <div class="col-md-2" >
                    <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                </div>
        </div>
    </div>

</div>
