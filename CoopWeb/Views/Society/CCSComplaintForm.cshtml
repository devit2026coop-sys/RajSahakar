<script type="text/javascript">
    function sum() {
        var txtFirstNumberValue = document.getElementById('NumberCCB').value;
        var txtSecondNumberValue = document.getElementById('NumberOtherBank').value;
        var txtThridNumberValue = document.getElementById('NumberShare').value;
        var input = document.getElementsByName('array[]');
        if (txtFirstNumberValue == "")
            txtFirstNumberValue = 0;
        if (txtSecondNumberValue == "")
            txtSecondNumberValue = 0;
        if (txtThridNumberValue == "")
            txtThridNumberValue = 0;
        var tot = parseInt(txtFirstNumberValue) + parseInt(txtSecondNumberValue) + parseInt(txtThridNumberValue);
        for (var i = 0; i < input.length; i++) {
            var a = input[i];
            tot = tot + parseInt(a.value);
        }
        document.getElementById('NumberTotal').value = tot;
    }
</script>
