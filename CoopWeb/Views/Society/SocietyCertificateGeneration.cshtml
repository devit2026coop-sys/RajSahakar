

<script src="~/Scripts/AngularFramework/SocietyCertificateGeneration.js"></script>



<div ng-app="SocietyCertificateGenerationModule">
    <div ng-controller="SocietyCertificateGenerationCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.SocietyCertificateGeneration}}</h3>
        </div>
      
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{ translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{ translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">{{ translation.SocietyCertificateGeneration}} </span>
                    </li>

                </ul>
            </div>
        </div>
        @*<form class="dev-search-form citizen-dash-head " style="overflow: hidden;" name="block1">
        </form>*@
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4" style="padding-left: 0;">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder="Filter text" autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                        </div>
                    </div>
                    <table class="table table-responsive devtable" >
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.SocietyName}}

                                </th>
                                <th>
                                    {{translation.Act}}
                                </th>
                                <th>
                                    {{translation.SocietyRegistrationNo}}

                                </th>
                                <th>
                                    {{translation.SocietyTyped}}
                                </th>
                                <th>
                                    {{translation.PaymentStatus}}
                                </th>
                                <th>
                                {{translation.CertificateGenrate}}
                            </th>

                            </tr>
                        </thead>
                        <tbody>

                            <tr dir-paginate="items in Societycertificatedata | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="statePagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ items.SocietyName }}</td>
                                <td>{{ items.ActNameEn }}</td>
                                <td>{{ items.RegistrationNo }}</td>
                                <td>{{ items.TypeameEng }}</td>
                                <td>{{ items.ProceesStatusTextEn }}</td>
                               <td>

                                   <button type="submit" class="btn btn-primary dev-btn" ng-click="msg()" >{{translation.CertificateGenrate}}</button>
                               </td>


                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>


    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
