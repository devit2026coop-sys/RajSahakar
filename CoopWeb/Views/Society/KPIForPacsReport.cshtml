@{
    ViewBag.Title = "Bank Wise GCC Recovery";
}
<script src="~/Scripts/AngularFramework/KPIForPacsReport.js?v=1.1"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />

<style>

.table > tbody > tr > td,
.table > tbody > tr > th,
.table > thead > tr > th{
    padding:5px;
    vertical-align:middle;
}

.kpi-table{
    border-collapse:collapse;
    width:100%;
}

.kpi-table th{
    background:#e8eeee;
    text-align:center;
    border:1px solid #999;
}

.kpi-table td{
    border:1px solid #999;
}

.focusArea{
    background:#eef5f5;
    text-align:center;
    font-weight:bold;
}

.totalRow{
    background:#466b6d;
    color:#fff;
    font-weight:bold;
}

.sectionRow{
    background:#d9e7e7;
    font-weight:bold;
}

</style>

