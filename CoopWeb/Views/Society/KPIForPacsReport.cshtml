  <div ng-app="ApplicationFlowKPIPacsModule" ng-controller="ApplicationKPIPacsFlowCont" ng-cloak="">
      <div>
          <div class="col-md-12">
              <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">KPI for PACS</h3>
          </div>
          <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
              <div class="devpage-breadcrumb">
                  <ul class="page-breadcrumb">
                      <li class="dev-page-br">
                          <i class="fa fa-home"> </i>
                          <a href="#">  {{translation.Home}}</a> <i class="fa fa-angle-right"> </i>
                      </li>
                      <li style="float: left">
                          <span style="margin: 0 5px;"> {{translation.New}} </span>
                          <i class="fa fa-angle-right"> </i>
                          <span style="margin: 0 5px;"> KPI for PACS List </span>
                      </li>
                  </ul>
              </div>
          </div>
          <div style="margin-top:30px;padding-top:30px">
              <div class="col-md-12">
                  <div class="citizen-dash-head" style="overflow: hidden;">
                      <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">
                          <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">
                              <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                              <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                              <input type="hidden" id="hdnLevelIdId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />
                              <input type="hidden" id="hdnUserRoleMappingId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserRoleDeptMappingId)" />



                              <div class="col-md-3 MarginTop20">
                                  <label for="ddlGSS"> Society</label>
                                  <select class="form-control" id="ddlGSS" ng-model="godown.SocietyID" ng-disabled="IsSocietyDisabled || isViewMode" ng-change="OnSocietyChange()">
                                      <option value="" selected="selected" disabled>{{translation.SelectOption}}</option>
                                      <option ng-repeat="item in SocietyList" value="{{item.SocietyID}}">
                                          {{_language =='en-us' ?  item.SocietyName : item.SocietyName}}
                                      </option>
                                  </select>
                              </div>

                              <div class="col-md-4 margin-Top20">
                                  <label>&nbsp;</label><br>
                                  <button type="button" ng-click="searchRequest()" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                                  <button type="button" ng-show="showClearButton" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                                  @*<button type="button" ng-click="SaveScoreSheet()" class="btn btn-success dev-btn ng-binding">
                                      <i class="fa fa-save"></i> {{translation.Save}}
                                  </button>*@
                                  <button type="button" onclick="tableToExcel('KpiPacsTable', 'KPI for PACS');" class="btn btn-success dev-btn">
                                      <i class="fa fa-file-excel-o"></i> Export Excel
                                  </button>
                              </div>


                          </div>
                      </div>
                      <div style="overflow-x: auto;">
                          <table id="KpiPacsTable" class="table table-responsive devtable kpi" style="">
                              <thead>
                                  <tr>
                                      <th style="min-width: 160px;"> Focus Area </th>
                                      <th width="50"> {{translation.SRNO}} </th>
                                      <th style="min-width: 250px;"> Measurable Key Performance Indicator </th>
                                      <th style="min-width: 220px;"> Instructions to Fill Indicators </th>
                                      <th width="90"> Weighted Marks </th>
                                      <th width="100"> Obtained Marks </th>
                                  </tr>
                              </thead>

                              <tbody>
                                  <tr ng-repeat="item in kpiList" }">

                                      <td>{{item.focusarea_eng}}</td>
                                      <td width="50">{{ $index + 1 }}</td>
                                      <td>{{item.MeasurableKey }}</td>
                                      <td>{{item.inputtype }}</td>
                                      <td>{{item.TotalPenalInterestAmount }}</td>
                                      <td>{{item.marks }}</td>
                                  </tr>
                              </tbody>
                          </table>
                      </div>
                  </div>
              </div>
          </div>
          @*<div class="se-pre-con"></div>*@
      </div>
  </div>


