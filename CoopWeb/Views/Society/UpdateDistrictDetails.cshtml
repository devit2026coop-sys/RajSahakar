        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title"> Update District </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" name="MyRoleForm" style="overflow: hidden;">
                            <div class="form-group" ng-class="{ 'has-error' : MyRoleForm.RoleNameEn.$invalid && !MyRoleForm.RoleNameEn.$pristine }">
                                <label>District</label>
                                <select name="DISTRICT_ID" ng-model="DistrictId" ng-change="GetDistrictRegion()" class="form-control">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                        {{_language =='en-us' ?  district.DISTRICT_MANGAL : district.DISTRICT_ENG}}
                                    </option>
                                </select>
                            </div>
                            <div class="form-group" ng-class="{ 'has-error' : MyRoleForm.RoleNameEn.$invalid && !MyRoleForm.RoleNameEn.$pristine }">
                                <label>Registration</label>
                                <input type="text" name="name" value="" class="form-control" ng-model="Registration" />
                            </div>
                            <div class="form-group">
                                <div class="dev-align-btn">
                                    <button type="submit" class="btn btn-primary dev-btn" ng-click="InsertSave()" style="margin-right:15px;">{{translation.Submit}}</button>
                                    <button type="button" class="btn btn-primary dev-btn" ng-click="ClearRoleForm()">{{translation.Clear}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown" id="search-filter">
                        <div class="col-md-2 NewMemberdob">
                            <label>
                                {{translation.SearchText}}
                            </label>
                            <input id="txtFromDate" name="searchText" class="form-control" autocomplete="off">
                        </div>
                        <div class="col-md-2">
                            <label>&nbsp;</label><br>
                            <button type="button" ng-click="searchRequest(GSocietyListdata)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                            <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                        </div>

                    </div>


                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>RegistrationNo</th>
                                <th>SocietyName</th>
                                <th>District</th>
                                <th>{{translation.TakeAction}}</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in SocietyDistrictdataset">
                                <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                                <td>{{ item.RegistrationNo}}  </td>
                                <td>{{ item.SocietyName | uppercase }}</td>
                                <td>{{ item.DISTRICT_ID | uppercase }}</td>


                                <td>
                                    <input type="button" name="name" value="Action" ng-click="AddClick(item.SocietyID,item.RegistrationNo);ClearRoleForm()" data-toggle="modal" data-target="#myModal" class="btn btn-primary" />

                                </td>

                            </tr>
                        </tbody>
                    </table>
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GSocietyListdata)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GSocietyListdata)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GSocietyListdata)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GSocietyListdata)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GSocietyListdata)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
