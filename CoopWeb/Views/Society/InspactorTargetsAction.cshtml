    }

    .modal-content {
        height: 100%;
    }

    .multiSelectDDL {
        position: absolute;
        visibility: hidden;
    }

    .multiselect-container li a {
        padding-left: 30px !important;
    }

    .multiselect-container li.active a {
        background: none !important;
        color: #1b40cf !important;
    }

    .radio label:has(input[type="radio"]:checked)::after {
        content: '';
        width: 15px;
        height: 15px;
        border: 5px solid #025e63;
        position: absolute;
        left: 0;
        top: 1px;
