        }

    .agm-table {
        width: 100%;
    }

        .agm-table td {
            padding: 5px;
        }

    .modal-dialog {
        color: #444;
    }

    .text-black {
        color: #000 !important;
    }

    .modal-dialog.modal-lg-custom {
        max-width: 80%; /* increase width (default is ~500px) */
        width: 80%;
        height: 90vh; /* viewport height for taller modal */
