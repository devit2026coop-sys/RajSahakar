    function ValidateNumaric(th, evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if (keyCode != 8 && keyCode != 0 && (keyCode < 48 || keyCode > 57))

            return false;
        return true;
    };


    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };
    function ValidateFloat(th, e) {
        if (isNaN(th.value + "" + String.fromCharCode(e.charCode)))
            return false;
        return true;
    }
    //function ValidateFloat(th, e) {
    //    if (isNaN(th.value + "" + String.fromCharCode(e.charCode)))
    //        return false;
    //    return true;
    //}

    function ValidateTodate(th) {
        //$(".Todate").datepicker("option", "minDate", $('.Fromdate').val());

        var newdate = $("#Valid_From_Date").val().split('/')[2] + '/' + $("#Valid_From_Date").val().split('/')[1] + '/' + $("#Valid_From_Date").val().split('/')[0];

        var toDate = getTodate(new Date(newdate));//new Date(fromDate.setMonth(fromDate.getMonth() + 3));
        $("#Valid_To_Date").val(toDate);
    }
    function getTodate(newdate) {

        //var newdate = new Date();

        newdate.setDate(newdate.getDate() - 1);


        newdate.setMonth(newdate.getMonth() + 3)

        var dd = newdate.getDate();
        var mm = newdate.getMonth() + 1;
        var y = newdate.getFullYear();

        dd = dd.toString().length == 1 ? "0" + dd : dd;
        mm = mm.toString().length == 1 ? "0" + mm : mm;

        return dd + '/' + mm + '/' + y;

        //document.getElementById('follow_Date').value = someFormattedDate;
    }

    function getMinDate(newdate) {

        //var newdate = new Date();

        newdate.setDate(newdate.getDate() - 1);


        // newdate.setMonth(newdate.getMonth() + 3)

        var dd = newdate.getDate();
        var mm = newdate.getMonth() + 1;
        var y = newdate.getFullYear();

        dd = dd.toString().length == 1 ? "0" + dd : dd;
        mm = mm.toString().length == 1 ? "0" + mm : mm;

        return dd + '/' + mm + '/' + y;

        //document.getElementById('follow_Date').value = someFormattedDate;
    }
    var serverdate = $("#mindateserver").val();

    $(document).ready(function () {

        serverdate = $("#mindateserver").val();

        var toDayDate = $("#fromdateserver").val().split('/')[2] + '/' + $("#fromdateserver").val().split('/')[1] + '/' + $("#fromdateserver").val().split('/')[0];


        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            //minDate: getMinDate(new Date(serverdate)),
           // maxDate: (new Date(serverdate)).getDate() + '/' + ((new Date(serverdate)).getMonth() + 1) + '/' + ((new Date(serverdate)).getFullYear()).toString()
        });

        //$("#Valid_From_Date").val(((new Date(serverdate)).getDate()) + '/' + ((new Date(serverdate)).getMonth() + 1) + '/' + ((new Date(serverdate)).getFullYear()).toString())

        var fromDate = new Date(serverdate);
        fromDate.setDate(fromDate.getDate() + 1);
        var toDate = getTodate(new Date(serverdate));//new Date(fromDate.setMonth(fromDate.getMonth() + 3));
        //$("#Valid_To_Date").val(toDate);

        $('.Fromdate').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            minDate: new Date(serverdate),
            maxDate: new Date(toDayDate)
        });
        $('.Todate').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            minDate: $('.Fromdate').val(),
            //defaultDate: (new Date()).getDate() + '/' + ((new Date()).getMonth() + 1) + '/' + ((new Date()).getFullYear()).toString(),
        });





    });


    function PrintWRPrivew() {
        var contents = $("#dvpintdv").html();
        var frame1 = $('<iframe />');
        frame1[0].name = "frame1";
        frame1.css({ "position": "absolute", "top": "-1000000px" });
        $("body").append(frame1);
        var frameDoc = frame1[0].contentWindow ? frame1[0].contentWindow : frame1[0].contentDocument.document ? frame1[0].contentDocument.document : frame1[0].contentDocument;
        frameDoc.document.open();
        //Create a new HTML document.
        frameDoc.document.write('<html><head><title>WR Preview</title>');
        frameDoc.document.write('</head><body>');
        //Append the external CSS file.
        //Append the DIV contents.
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            frame1.remove();
        }, 500);
    }


</script>

