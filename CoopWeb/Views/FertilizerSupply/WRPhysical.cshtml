                                                <td style='text-align:center;'>{{item.Packages_Lots}} </td>
                                                <td style='text-align:center;'>{{GetNameFromList(UnitList,item.Packages_Quantity_Unit,'Unit')}} </td>
                                                <td style='text-align:center;'>{{item.OtherNetQuantity}}  </td>
                                                <td style='text-align:center;'>{{item.NameOfSampler}} </td>
                                                <td style='text-align:center;'>{{GetNameFromList(GodownList,item.Godown_Id,'Godown')}}/{{item.Stack_No}} </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <table id='content' border='0' style='width:100%; font-size: 14px;color: black;' cellpadding='5' cellspacing='0'>
                                <tr>
                                    <td style='text-align:left;width:60%;'>Condition of Goods -(1) Good (2) Fair (3) Average<br /> माल की स्थिति - (1) उत्तम (2) सुंदर (3) साधारण  </td>
                                    <td colspan='3' style='text-align:left;'><b> {{AddNewModel.ConditionOfGoods=='1'?'Good':AddNewModel.ConditionOfGoods=='2'?'Fair':'Average'}} </b> </td>
                                </tr>
                                <tr>
                                    <td style='text-align:left;'>Private marks of the depositor on the packages if any<br /> यदि हो तो बंडलों  पर जमाकर्ता  के निजी चिन्ह </td>
                                    <td colspan='3' style='text-align:left;'><b> {{AddNewModel.PrivateMarkofDepositor}} </b> </td>
                                </tr>
                                <tr>
                                    <td style='text-align:left;'>Rate of storage and other charges (भंडारण की दर और अन्य शुल्क) </td>
                                    <td colspan='3' style='text-align:left;'><b> {{AddNewModel.StorageRateCharge}} </b> </td>
                                </tr>
                                <tr>
                                    <td style='text-align:left;'>Indemnified / Insured for Fire /Theft/Riots / Other Contingency with<br /> आग / चोरी / दंगों / आदि अन्य  आपत्तियों  के लिये बीमा </td>
                                    <td colspan='3' style='text-align:left;'><b> {{AddNewModel.IndemnifiedInsuranceType=='Self'?'Self': AddNewModel.IndemnifiedInsurance}}  </b> </td>
                                </tr>
                                <tr>
                                    <td style='text-align:left;'>If Insured (Name Of Insurance Co.) (साथ यदि बीमा कराया  गया हो (बीमा समवाय का नाम)) </td>
                                    <td colspan='3' style='text-align:left;'><b> {{AddNewModel.InsuredName}} </b> </td>
                                </tr>
                                <tr>
                                    <td style='text-align:left;'>Remarks (टिप्पणी) </td>
                                    <td colspan='3' style='text-align:left;'><b> {{AddNewModel.QuantityNote}} </b> </td>
                                </tr>
                                <tr>
                                    <td style='text-align:left;'>Done for an amount of Rs. (रुपये की राशि के लिए किया गया) </td>
                                    <td colspan='3' style='text-align:left;'><b> Rs. {{totalPrice}} </b> </td>
                                </tr>
                                <tr>
                                    <td style='text-align:left;'>The goods are accepted for storage from (भण्डारण  के लिए  माल स्वीकार किया  जाता  हैं)  </td>
                                    <td style='text-align:left;'><b>{{AddNewModel.Valid_From_Date}}</b> </td>
                                    <td style='text-align:left;'>to (से) </td>
                                    <td style='text-align:left;'><b>{{AddNewModel.Valid_To_Date}} </b> </td>
                                </tr>
                                <tr>
                                    <td style='text-align:left;'>Market rate at the time of deposit (भण्डारण के समय मंडी का भाव) </td>
                                    <td style='text-align:left;'><b> Rs.  {{GetNameFromList(ItemList,AddNewModel.Item_Kind,'CommodityPrice')}} </b> </td>
                                    <td style='text-align:left;'>Valuation<br> मूल्यांकन </td>
                                    <td style='text-align:left;'><b>Rs. {{totalPrice}} </b></td>
                                </tr>
                            </table>

                        </div>
