                            <input type="text" id="normal_interest_rate" name="normal_interest_rate" class="form-control number-only" placeholder="{{translation.Quantity}}" ng-model="MasterModel.Quantity" maxlength="10" onkeypress='return ValidateFloat(this,event);' autocomplete="off">
                        </div>

                        <div class="col-md-12" style="margin-top: 10px;">
                            <div class="dev-menu-btn">
                                <button type="submit" class="btn btn-primary" ng-click="SaveDemand()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="ResetAddNew()">{{translation.Clear}}</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>





    <div class="dev-popup-body modal fade" id="myOTPModal" data-backdrop="static" data-keyboard="false" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content citizen-dash-head">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    @*<h4 class="modal-title"> {{translation.AddOffice}} </h4>*@
                    <label id="lbltrn" style="display:none;"></label>
                    <label id="lblElectionMasterId" style="display:none;"></label>
                    <label id="lblSocietyIdEnc" style="display:none;"></label>
                    <label id="MemberId" style="display:none;"></label>
                    <label id="CertIndex" style="display:none;"></label>
                </div>
                <div class="modal-body">
                    <div class="form-group col-md-6">
                        <label>{{translation.EnterOTP}}</label>
                        <input type="text" class="form-control" name="OTP" ng-bind="OTP" ng-model="OTP" placeholder={{translation.EnterOTP}} autocomplete="off" /><br />
                        <button type="submit" class="btn btn-primary" ng-click="VerifyOTP()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" style="margin-left:50px;" ng-click="GenerateRequest()">{{translation.ReSendOTP}}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>




