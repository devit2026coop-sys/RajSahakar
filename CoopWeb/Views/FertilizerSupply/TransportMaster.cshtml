                                <label>
                                    {{translation.Transport}} {{translation.Name}} (Hindi)
                                </label>
                                <input type="text" id="TransportNameHi" name="TransportNameHi" class="form-control" placeholder="ट्रांसपोर्ट नाम" ng-model="MasterModel.TransportNameHi" autocomplete="off" onKeyPress="return ValidateAlpha(event);">
                            </div>

                            <div class="col-md-12">
                                <label>
                                    {{translation.Address}} (English)
                                </label>
                                <textarea type="text" id="AddressEn" name="AddressEn" class="form-control" placeholder="Address" ng-model="MasterModel.AddressEn" autocomplete="off" onKeyPress="return ValidateAlpha(event);"></textarea>
                            </div>

                            <div class="col-md-12">
                                <label>
                                    {{translation.Address}} (Hindi)
                                </label>
                                <textarea type="text" id="AddressHi" name="AddressHi" class="form-control" placeholder="पता" ng-model="MasterModel.AddressHi" autocomplete="off" onKeyPress="return ValidateAlpha(event);"></textarea>
                            </div>
                            <div class="col-md-12">
                                <label>
                                    {{translation.EmailId}}
                                </label>
                                <input type="text" id="Email" name="Email" class="form-control" placeholder="Email" ng-model="MasterModel.Email" autocomplete="off" onKeyPress="return ValidateAlpha(event);">
                            </div>
                        </div>
                        <div class="col-md-12" style="margin-top: 10px;">
                            <div class="dev-menu-btn">
                                <button type="submit" class="btn btn-primary" ng-click="SaveMasterData()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="ResetModel()">{{translation.Clear}}</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" name="hdlang" id="hdlang" value="hi-IN" />
<script src="~/Scripts/google_hindi/google_transapi.js"></script>
<script type="text/javascript">
    google.load("elements", "1", {
        packages: "transliteration"
    });

    function onLoad() {
        var content = document.getElementById('content');
        if (document.getElementById('hdlang').value == "hi-IN") {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: true
            };
        }
        else {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: false
            }
        }
        var ids = ["AddressHi","TransportNameHi"];
        var control = new google.elements.transliteration.TransliterationControl(options);
        control.makeTransliteratable(ids);
    }
    google.setOnLoadCallback(onLoad);

</script>


<script src="~/Scripts/google_hindi/google_transliteration.js"></script>