@if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]) != null)
{
    if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserType == "C")
    {
        Layout = "~/Views/Shared/_CitizenLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}
else
{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/Scripts/AngularFramework/GSSDemand.js"></script>
<script type="text/javascript" src="~/Scripts/1.8.3.jquery.min.js"></script>
<script type="text/javascript" src="~/Scripts/pdfmake.min.js"></script>
<script type="text/javascript" src="~/Scripts/html2canvas.min.js"></script>


<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }
</style>

<style type="text/css">
    body {
        font-family: Arial;
        font-size: 10pt;
    }

    table {
        border: 1px solid #ccc;
        border-collapse: collapse;
    }

        table th {
            background-color: #F7F7F7;
            color: #333;
            font-weight: bold;
        }

        table th, table td {
            padding: 5px;
            border: 1px solid #ccc;
        }

    .NewMemberdob input {
        float: left;
        width: 90%;
    }

    .NewMemberdob button {
        float: left;
    }

    .notValid {
        border: solid 1px red !important
    }
</style>


<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };
    function ValidateFloat(th, e) {
        if (isNaN(th.value + "" + String.fromCharCode(e.charCode)))
            return false;
        return true;
    }
    $(document).ready(function () {
        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            minDate: '01/01/2000'
        });
    });
</script>

<div ng-app="GSSDemandMod" ng-controller="GSSDemandCnt">

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head">{{translation.GSSDemand}} </h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.GSSDemand}} </span>
                </li>

                <li style="float: right;" id="divAddBtn">
                    <i class="fa fa-angle-double-right" style="color: #025e63;"></i>
                    <a ng-click="AddNew()" style="color: #025e63; cursor: pointer; text-decoration:none; font-weight: bold;" class="ng-binding">{{translation.AddNew}}</a>
                </li>


            </ul>
        </div>
    </div>
    @*MEMBERS*@
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div class="table-dropdown" id="search-filter">
                <div class="col-lg-4">
                    <label for="search" class="ng-binding">{{translation.FilterType}}:</label>
                    <select name="FilterType" class="form-control ng-pristine ng-valid ng-not-empty ng-touched" ng-model="Filter.FilterType" ng-change="FilterTypeChange()" ng-init="Filter.FilterType=''">
                        <option value="">{{translation.SelectOption}}</option>
                        <option value="SocietyName">{{translation.SocietyName}}</option>
                        <option value="SRO.AddressFor">{{translation.Address}}</option>
                        <option value="quantity">{{translation.Quantity}}</option>
                        <option value="created_dated">{{translation.DemandDate}}</option>
                    </select>
                </div>
                <div class="col-md-4" ng-show="showSearchText">
                    <label for="search" class="ng-binding">Search:</label>
                    <input name="searchText" id="search" class="form-control ng-pristine ng-valid ng-empty ng-touched" ng-model="Filter.SearchText" placeholder="Filter Text" autocomplete="off">
                </div>

                <div class="col-md-2 NewMemberdob" ng-show="showSearchDate">
                    <label>
                        {{translation.FromDate}}
                    </label>
                    <input id="txtFromDate" name="FromDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.FromDate" placeholder="{{translation.FromDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                </div>
                <div class="col-md-2 NewMemberdob" ng-show="showSearchDate">
                    <label>
                        {{translation.ToDate}}
                    </label>
                    <input id="txtToDate" name="ToDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.ToDate" placeholder="{{translation.ToDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                </div>

                <div class="col-md-4">
                    <label>&nbsp;</label><br>
                    <button type="button" ng-click="searchRequest(GSSDemandList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                    <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                </div>
            </div>

            <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                <thead>
                    <tr>
                        <th>
                            #
                            @*{{translation.SRNO}}*@
                        </th>
                        <th>
                            {{translation.SocityName}}
                        </th>
                        <th>
                            {{translation.KVSSName}}
                        </th>
                        <th>
                            {{translation.Quantity}} ({{MasterModel.Unit}})
                        </th>
                        <th>
                            {{translation.DemandDate}}
                        </th>
                        <th>
                            {{translation.Status}}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in DemandList">
                        <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                        <td>
                            {{item.SocietyName }}
                        </td>
                        <td>
                            {{_language =='en-us' ?  item.KvssNameEn : item.KvssNameHi}}
                        </td>
                        <td>
                            {{item.quantity}}
                        </td>
                        <td>
                            {{item.DemandDate}}
                        </td>
                        <td>{{item.status}}</td>

                    </tr>
                </tbody>
            </table>

            <div class="col-md-12">
                <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                    <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                        Total Records: {{DataPagingDetails.TotalRecords}}
                    </div>
                    <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GSSDemandList)" style="cursor: pointer;">
                            <span>«First</span>
                        </li>
                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GSSDemandList)" style="cursor:pointer;">
                            <span>« Previous</span>
                        </li>
                        <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GSSDemandList)"><span>{{n}}</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                        <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GSSDemandList)" style="cursor:pointer;">
                            <span>Next »</span>
                        </li>
                        <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GSSDemandList)" style="cursor:pointer;">
                            <span>Last »</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div id="PrintDiv" style="display:none">
            <div class="table-responsive citizen-dash-head" id="tblCustomers">
                <div style="text-align:center">
                    <h5><u>{{translation.rajsarkas}}</u></h5>
                    <p>{{translation.EleImpDateHeader}}</p>
                    <p>{{translation.EleImpDateHeader1}}</p>
                    <p>{{translation.EleImpDateHeader2}}</p>
                    <p style="text-align:left">{{translation.PublishHeading}}</p><br />
                    <p>{{translation.CandidateList}}</p>
                    <table id="content" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.Photo}}
                                </th>
                                <th>
                                    {{translation.Name}}
                                </th>
                                <th>
                                    {{translation.FatherHusbandName}}
                                </th>
                                <th>
                                    {{translation.Address}}
                                </th>
                                <th>
                                    {{translation.GenderHeading}}
                                </th>
                                <th>
                                    {{translation.CategoryHeading}}
                                </th>
                                <th>
                                    {{translation.ContactNo}}
                                </th>
                                <th>
                                    {{translation.AADHAARNo}}
                                </th>
                                <th>
                                    {{translation.DOB}}
                                </th>
                                <th style="display:none">
                                    {{translation.PostHeading}}
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in EMemberDetailsData   | itemsPerPage: 9000">
                                <td>{{$index+1}}</td>
                                <td> <img src="~/Content/SocietyProfiling/{{item.SocietyDirectory}}/{{item.Photo}}" style="width: 35px;" ng-if="item.Photo!=''" onerror='onUserImageLoadError(this);' /></td>
                                <td>{{item.Name}}</td>
                                <td>{{item.FHName}}</td>
                                <td>{{item.Address}}  </td>
                                <td>{{item.Gender}}  </td>
                                <td>{{item.CODENAME}}  </td>
                                <td>{{item.ContactNo}}</td>
                                <td>{{item.AadharNo2}}  </td>
                                <td>{{item.DOB}}</td>
                                <td style="display:none">{{item.CAD_NAME}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


    </div>
    <div class="dev-popup-body modal fade" id="addModal" data-backdrop="static" data-keyboard="false" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"> {{translation.AddNewRequest}}</h4>
                </div>
                <div class="modal-body">
                    <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OfficeForm">
                        <input type="hidden" ng-model="MasterModel.master_id" />

                        <div class="col-md-12">
                            <label>
                                {{translation.Society}}
                            </label>
                            <select ng-model="MasterModel.SocietyID" id="SocietyID" class="form-control" ng-init="MasterModel.SocietyID='0'">
                                <option value="0" selected="selected">{{translation.SelectOption}}</option>
                                <option ng-repeat="itm in SocietyList" value="{{itm.SocietyID}}">
                                    {{_language =='en-us' ?  itm.SocietyName : itm.SocietyName}}
                                </option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label>
                                {{translation.Fertilizer}}
                            </label>
                            <select ng-model="MasterModel.FertilizerId" id="FertilizerId" class="form-control" ng-init="MasterModel.FertilizerId='0'" ng-change="ChangeFertilizer()">
                                <option value="0" selected="selected">{{translation.SelectOption}}</option>
                                <option ng-repeat="itm in FertilizerList" value="{{itm.fertilizer_id}}">
                                    {{_language =='en-us' ?  itm.name_en : itm.name_hi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label>
                                {{translation.Quantity}} ({{MasterModel.Unit}})
                            </label>
                            <input type="text" id="Quantity" name="Quantity" class="form-control number-only" placeholder="{{translation.Quantity}}" ng-model="MasterModel.Quantity" maxlength="10" onkeypress='return ValidateFloat(this,event);' autocomplete="off">
                        </div>
                        <div class="col-md-12">
                            <label>
                                {{translation.RoutChart}}
                            </label>
                            <textarea type="text" id="RoutChart" name="RoutChart" class="form-control number-only" maxlength="150" placeholder="{{translation.RoutChart}}" ng-model="MasterModel.RoutChart"   autocomplete="off"></textarea>
                        </div>


                        <div class="col-md-12" style="margin-top: 10px;">
                            <div class="dev-menu-btn">
                                <button type="submit" class="btn btn-primary" ng-click="SaveDemand()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="ResetAddNew()">{{translation.Clear}}</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
