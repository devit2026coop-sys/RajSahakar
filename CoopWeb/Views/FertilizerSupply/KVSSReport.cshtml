<style type="text/css">
    body {
        font-family: Arial;
        font-size: 10pt;
    }

    table {
        border: 1px solid #ccc;
        border-collapse: collapse;
    }

        table th {
            background-color: #F7F7F7;
            color: #333;
            font-weight: bold;
        }

        table th, table td {
            padding: 5px;
            border: 1px solid #ccc;
        }

    .NewMemberdob input {
        float: left;
        width: 90%;
    }

    .NewMemberdob button {
        float: left;
    }

    .notValid {
        border: solid 1px red !important
    }
</style>


<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };
    function ValidateFloat(th, e) {
        if (isNaN(th.value + "" + String.fromCharCode(e.charCode)))
            return false;
        return true;
    }
    $(document).ready(function () {
        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            minDate: '01/01/2000'
        });
    });
</script>

<div ng-app="KVSSReportMod" ng-controller="KVSSReportCnt">

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head">{{translation.GSSDemandReport}} </h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.GSSDemandReport}} </span>
                </li>

                @*<li style="float: right;" id="divAddBtn">
                        <i class="fa fa-angle-double-right" style="color: #025e63;"></i>
                        <a ng-click="AddNew()" style="color: #025e63; cursor: pointer; text-decoration:none; font-weight: bold;" class="ng-binding">{{translation.AddNew}}</a>
                    </li>*@
            </ul>
        </div>
    </div>
    @*MEMBERS*@
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div class="table-dropdown" id="search-filter">
                <div class="col-lg-12" style="margin-bottom: 10px;">

                    <input type="radio" style="" ng-click="SelectReportType('Quantity')" checked="checked" name="Type" value="New" />{{translation.QuantityWiseReport}}
                    <input style="" type="radio" ng-click="SelectReportType('GSSWise')" name="Type" value="Generate" />{{translation.GSSWiseReport}}

                </div>


                <div class="col-lg-2">
                    <label for="search" class="ng-binding">{{translation.Report}} {{translation.Type}}:</label>
                    <select class="form-control ng-pristine ng-valid ng-not-empty ng-touched" ng-model="Type" ng-change="ReportTypeChange()" ng-init="Filter.Type=''">
                        <option value="">{{translation.SelectOption}}</option>
                        <option value="FY">{{translation.FinancialYear}}</option>
                        <option value="Year">{{translation.Yearly}}</option>
                        <option value="Month">{{translation.Monthly}}</option>
                        <option value="Date">{{translation.Date}}</option>
                    </select>
                </div>
                <div class="col-lg-2" ng-if="Type=='Month'||Type=='Year'">
                    <label for="search" class="ng-binding">{{translation.YEAR}}:</label>
                    <select name="year(created_dated)" class="form-control ng-pristine ng-valid ng-not-empty ng-touched" ng-model="Filter.Year" ng-init="Filter.Year=''">
                        <option value="">{{translation.SelectOption}}</option>
                        <option value="{{itm.year}}" ng-repeat="itm in YearList">{{itm.year}}</option>
                    </select>
                </div>
                <div class="col-lg-2" ng-if="Type=='Month'&&ReportType=='GSSWise'">
                    <label for="search" class="ng-binding">{{translation.Month}}:</label>
                    <select name="month(created_dated)" class="form-control ng-pristine ng-valid ng-not-empty ng-touched" ng-model="Filter.Month" ng-init="Filter.Month=''">
                        <option value="">{{translation.SelectOption}}</option>
                        <option value="01">January</option>
                        <option value="02">February</option>
                        <option value="03">March</option>
                        <option value="04">April</option>
                        <option value="05">May</option>
                        <option value="06">June</option>
                        <option value="07">July</option>
                        <option value="08">August</option>
                        <option value="09">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>

                <div class="col-lg-2" ng-if="Type=='FY'">
                    <label for="search" class="ng-binding">{{translation.YEAR}}:</label>
                    <select name="FY" class="form-control ng-pristine ng-valid ng-not-empty ng-touched" ng-model="Filter.Year" ng-init="Filter.Year=''">
                        <option value="">{{translation.SelectOption}}</option>
                        <option value="{{itm.FinancialYear}}" ng-repeat="itm in FinancialYear">{{itm.FinancialYear}}</option>
                    </select>
                </div>


                <div class="col-md-2">
                    <label>
                        {{translation.GSS}}
                    </label>
                    <select name="ss.SocietyID" ng-model="Filter.SocietyID" id="SocietyID" class="form-control" ng-init="Filter.SocietyID=''">
                        <option value="" selected="selected">{{translation.SelectOption}}</option>
                        <option ng-repeat="itm in GSSList" value="{{itm.SocietyID}}">
                            {{_language =='en-us' ?  itm.SocietyName : itm.SocietyName}}
                        </option>
                    </select>
                </div>



                @*<div class="col-lg-2">
            <label for="search" class="ng-binding">{{translation.FilterType}}:</label>
            <select name="FilterType" class="form-control ng-pristine ng-valid ng-not-empty ng-touched" ng-model="Filter.FilterType" ng-change="FilterTypeChange()" ng-init="Filter.FilterType=''">
                <option value="">{{translation.SelectOption}}</option>
                <option value="SocietyName">{{translation.SocietyName}}</option>
                <option value="SRO.AddressFor">{{translation.Address}}</option>
                <option value="quantity">{{translation.Quantity}}</option>
                <option value="created_dated">{{translation.DemandDate}}</option>
            </select>
        </div>*@




                @*<div class="col-md-4" ng-show="showSearchText">
            <label for="search" class="ng-binding">Search:</label>
            <input name="searchText" id="search" class="form-control ng-pristine ng-valid ng-empty ng-touched" ng-model="Filter.SearchText" placeholder="Filter Text" autocomplete="off">
        </div>*@

                <div class="col-md-2 NewMemberdob" ng-show="showSearchDate">
                    <label>
                        {{translation.FromDate}}
                    </label>
                    <input id="txtFromDate" name="FromDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.FromDate" placeholder="{{translation.FromDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                </div>
                <div class="col-md-2 NewMemberdob" ng-show="showSearchDate">
                    <label>
                        {{translation.ToDate}}
                    </label>
                    <input id="txtToDate" name="ToDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.ToDate" placeholder="{{translation.ToDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                </div>

                <div class="col-md-4">
                    <label>&nbsp;</label><br>
                    <button type="button" ng-click="searchRequest(GetReportListList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                    <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                </div>
            </div>

            <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                <thead>
                    <tr>
                        <th>
                            #
                            @*{{translation.SRNO}}*@
                        </th>
                        <th ng-if="ReportType=='Quantity'">
                            {{Type=='FY'? translation.FinancialYear:Type=='Year'? translation.YEAR:Type=='Month'? translation.Month:translation.Date}}
                        </th>
                        <th ng-if="ReportType!='Quantity'">
                            {{translation.SocietyName}}
                        </th>
                        <th ng-if="ReportType!='Quantity' && Type=='Date'">
                            {{translation.Date}}
                        </th>
                        <th>
                            {{translation.Fertilizer}}
                        </th>
                        <th>
                            {{translation.Quantity}}
                        </th>
                        <th>
                            {{translation.Unit}}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in ReportList">
                        <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>

                        <td ng-if="ReportType=='Quantity'">
                            {{item.FY }}
                        </td>
                        <td ng-if="ReportType!='Quantity' && Type=='Date'">
                            {{item.FY }}
                        </td>
                        <td ng-if="ReportType!='Quantity'">
                            {{item.SocietyName}}
                        </td>
                        <td>
                            {{_language =='en-us' ?  item.name_en : item.name_hi}}
                        </td>
                        <td>
                            {{item.quantity}}
                        </td>
                        <td>
                            {{_language =='en-us' ?  item.unit_en : item.unit_hi}}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="col-md-12">
                <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                    <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                        Total Records: {{DataPagingDetails.TotalRecords}}
                    </div>
                    <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetReportListList)" style="cursor: pointer;">
                            <span>«First</span>
                        </li>
                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetReportListList)" style="cursor:pointer;">
                            <span>« Previous</span>
                        </li>
                        <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetReportListList)"><span>{{n}}</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                        <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetReportListList)" style="cursor:pointer;">
                            <span>Next »</span>
                        </li>
                        <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetReportListList)" style="cursor:pointer;">
                            <span>Last »</span>
                        </li>
                    </ul>
                </div>
                <input ng-if="ReportList.length>0" type="button" id="btnExport" class="btn btn-primary dev-btn" style="" ng-click="ExportData()" value="Export" />
            </div>
        </div>
    </div>
</div>
