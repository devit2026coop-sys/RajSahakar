<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };
    function ValidateFloat(th, e) {
        if (isNaN(th.value + "" + String.fromCharCode(e.charCode)))
            return false;
        return true;
    }
    function ValidateFloat(th, e) {
        if (isNaN(th.value + "" + String.fromCharCode(e.charCode)))
            return false;
        return true;
    }

    function ValidateTodate(th) {
        $(".Todate").datepicker("option", "minDate", $('.Fromdate').val());
    }

    $(document).ready(function () {
        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            minDate: '01/01/2000'
        });

        //$("#Valid_From_Date").val((new Date()).getDate() + '/' + ((new Date()).getMonth() + 1) + '/' + ((new Date()).getFullYear()).toString())

        $('.Fromdate').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            minDate: (new Date()).getDate() + '/' + ((new Date()).getMonth()+1) + '/' + ((new Date()).getFullYear()).toString(),
            //defaultDate: (new Date()).getDate() + '/' + ((new Date()).getMonth() + 1) + '/' + ((new Date()).getFullYear()).toString(),
        });
        $('.Todate').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            minDate: $('.Fromdate').val(),
            //defaultDate: (new Date()).getDate() + '/' + ((new Date()).getMonth() + 1) + '/' + ((new Date()).getFullYear()).toString(),
        });





    });
</script>

<div ng-app="WarehouseLoanMod" ng-controller="WarehouseLoanCnt">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head">{{translation.WarehouseingLoan}} </h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.WarehouseingLoan}} </span>
                </li>
                @*<li style="float: right;" id="divAddBtn">
                    <i class="fa fa-angle-double-right" style="color: #025e63;"></i>
                    <a ng-click="AddNew()" style="color: #025e63; cursor: pointer; text-decoration:none; font-weight: bold;" class="ng-binding">{{translation.AddNew}}</a>
                </li>*@
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">

            <div ng-if="!ShowOrderDetails">
                <div class="table-dropdown" id="search-filter">
                    <div class="col-lg-4">
                        <label for="search" class="ng-binding">{{translation.FilterType}}:</label>
                        <select name="FilterType" class="form-control ng-pristine ng-valid ng-not-empty ng-touched" ng-model="Filter.FilterType" ng-change="FilterTypeChange()" ng-init="Filter.FilterType=''">
                            <option value="">{{translation.SelectOption}}</option>
                            <option value="receipt_no">{{translation.ReceiptNo}}</option>
                            <option value="receipt_serial_no">{{translation.SrNoOfPhysicalReceipt}}</option>
                            <option value="DISTRICT_ENG">{{translation.District}}</option>
                            <option value="CommodityNameEn">{{translation.Commodity}}</option>
                            <option value="PurchaseCenterName_En">{{translation.DemandDate}}</option>
                        </select>
                    </div>
                    <div class="col-md-4" ng-show="showSearchText">
                        <label for="search" class="ng-binding">Search:</label>
                        <input name="searchText" id="search" class="form-control ng-pristine ng-valid ng-empty ng-touched" ng-model="Filter.SearchText" placeholder="Filter Text" autocomplete="off">
                    </div>

                    <div class="col-md-2 NewMemberdob" ng-show="showSearchDate">
                        <label>
                            {{translation.FromDate}}
                        </label>
                        <input id="txtFromDate" name="FromDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.FromDate" placeholder="{{translation.FromDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                    </div>
                    <div class="col-md-2 NewMemberdob" ng-show="showSearchDate">
                        <label>
                            {{translation.ToDate}}
                        </label>
                        <input id="txtToDate" name="ToDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.ToDate" placeholder="{{translation.ToDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                    </div>

                    <div class="col-md-4">
                        <label>&nbsp;</label><br>
                        <button type="button" ng-click="searchRequest(GetWarehouseList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                        <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                    </div>
                </div>

                <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                {{translation.ReceiptNo}}
                            </th>
                            <th>
                                {{translation.SrNoOfPhysicalReceipt}}
                            </th>
                            <th>
                                {{translation.District}}
                            </th>
                            <th>
                                {{translation.KVSSMPRForm}}
                            </th>
                            <th>
                                {{translation.Commodity}}
                            </th>
                            <th>
                                {{translation.PurchaseCenter}}
                            </th>
                            <th>{{translation.FromDate}}</th>
                            <th>{{translation.ToDate}}</th>
                            <th>
                                {{translation.Price}}
                            </th>
                            <th>{{translation.PackagesLots}}</th>
                            <th>{{translation.NetQuantity}}</th>
                            <th>{{translation.TotalValue}}</th>
                            <th>{{translation.LoanStartDate}}</th>
                            <th>{{translation.LoanCloasedDate}}</th>

                            @*<th>{{translation.PrivateMarkofDepositor}}</th>
        <th>{{translation.StorageRateCharge}}</th>
        <th>{{translation.IndemnifiedInsurance}}</th>
        <th>{{translation.InsuredName}}</th>*@
                            <th>

                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in RSWCViewList">
                            <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                            <td>
                                {{item.receipt_no}}
                            </td>
                            <td>
                                {{item.receipt_serial_no}}
                            </td>
                            <td>
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </td>
                            <td>
                                {{ item.SocietyName}}
                            </td>
                            <td>
                                {{_language =='en-us' ?  item.CommodityNameEn : item.CommodityNameHi}}
                            </td>
                            <td>
                                {{_language =='en-us' ?  item.PurchaseCenterEng : item.PurchaseCenterHi}}
                            </td>
                            <td>{{item.from_date}}</td>
                            <td>{{item.to_date}}</td>
                            <td>{{item.Price}}</td>
                            <td>{{item.packages_lots}}</td>
                            <td>{{item.net_quantity}}</td>
                            <td>{{item.TotalProce}}</td>
                            <td>{{item.Loan_start}}</td>
                            <td>{{item.Loan_closed}}</td>
                            @*<td>{{item.PrivateMarkofDepositor}}</td>
        <td>{{item.StorageRateCharge}}</td>
        <td>{{item.IndemnifiedInsurance}}</td>
        <td>{{item.InsuredName}}</td>*@

                            <td>
                                @*<a style="color:#505050;" ng-if="item.EntryFile!=''" target="_blank" href="../Content/RSWC/{{item.EntryFile}}"><i class="fa fa-download"></i></a>*@
                                <a style="color:#505050;" ng-if="item.Loan_start=='' || item.Loan_closed==''" ng-click="AddNew(item);" href="javascript:void(0);"><i class="fa fa-edit"></i></a>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="col-md-12">
                    <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                        <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                            Total Records: {{DataPagingDetails.TotalRecords}}
                        </div>
                        <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetWarehouseList)" style="cursor: pointer;">
                                <span>«First</span>
                            </li>
                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetWarehouseList)" style="cursor:pointer;">
                                <span>« Previous</span>
                            </li>
                            <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetWarehouseList)"><span>{{n}}</span></li>
                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                            <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetWarehouseList)" style="cursor:pointer;">
                                <span>Next »</span>
                            </li>
                            <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetWarehouseList)" style="cursor:pointer;">
                                <span>Last »</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>



        </div>

    </div>
