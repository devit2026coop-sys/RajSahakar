@{
    ViewBag.Title = "MPR Article 30 Form";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .report-table th,
    .report-table td {
        text-align: center;
        vertical-align: middle;
        font-size: 13px;
    }

    .report-table th {
        background: #f8f9fa;
        font-weight: bold;
        border: 1px solid #dee2e6;
    }

    .report-table td {
        border: 1px solid #dee2e6;
    }

    .total-row {
        background-color: #f4f4f4;
        font-weight: bold;
    }

    h2.report-title {
        text-align: center;
        margin-top: 15px;
        margin-bottom: 20px;
        font-weight: bold;
        text-decoration: underline;
    }
</style>

<script src="~/Scripts/AngularFramework/MPRArticle30Form.js"></script>

<div ng-app="MPRArticle30FormCnt">
    <div ng-controller="MPRArticle30FormMod">
        <div class="container-fluid citizen-dash-head">
            <div class="panel panel-default">
                <div class="panel-heading flexEqualCenter">
                    <b><i class="fa fa-th-list"></i>&nbsp; धारा 30 के अंतर्गत दर्ज प्रकरणों की प्रगति का खण्डवार विवरण</b>
                </div>

                <div class="panel-body">
                    <h2 class="report-title">धारा 30 के अंतर्गत दर्ज प्रकरणों की प्रगति का खण्डवार विवरण</h2>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <form class="citizen-dash-head">
                            <div class="col-lg-12 form-group">
                                <div class="col-md-4">
                                    <label class="ng-binding">वित्तीय वर्ष</label>
                                    <select class="form-control ng-pristine ng-valid ng-empty ng-touched" ng-model="MPRArticleData.FinYearId" ng-init="MPRArticleData.FinYearId='0'">
                                        <option value="0">--वित्तीय वर्ष--</option>
                                        <option ng-repeat="year in FinancialYearList" value="{{year.FIN_YEAR_MASTR_ID}}">
                                            {{year.FIN_YEAR_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="ng-binding">माह</label>
                                    <select class="form-control" ng-model="MPRArticleData.MonthId" ng-init="MPRArticleData.MonthId='0'">
                                        <option value="0">--माह--</option>
                                        <option ng-repeat="month in MonthList" value="{{month.Month_Id}}">
                                            {{ month.Month_En }}
                                        </option>
                                    </select>
                                </div>

                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding"></label>
                                </div>

                                <div class="col-lg-12 form-group">

                                    <div class="col-lg-1 ng-binding">वर्ष के प्रारंभ में बकाया रहे प्रकरण</div>
                                    @*<div class="col-lg-1 ng-binding">Pending cases at the start of the year</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.InYearPendingCase" placeholder="" autocomplete="off" min="0">
                                    </div>
                                    <div class="col-lg-1"></div>
                                    <div class="col-lg-1 ng-binding">गत माह तक प्राप्त प्रकरण</div>
                                    @*<div class="col-lg-1 ng-binding">Cases received up to last month</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.LastMonthCaseReceived" placeholder="" autocomplete="off" min="0">

                                    </div>
                                    <div class="col-lg-1"></div>
                                    <div class="col-lg-1 ng-binding">माह में प्राप्त प्रकरण</div>
                                    @*<div class="col-lg-1 ng-binding">Cases received in the month</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.InMonthCaseReceived" placeholder="" autocomplete="off" min="0">
                                    </div>
                                </div>

                                <div class="col-lg-12 form-group">
                                    <div class="col-lg-1 ng-binding">गत माह तक निस्तारित प्रकरण</div>
                                    @*<div class="col-lg-1 ng-binding">Cases disposed of up to last month</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.LastMonthCaseDisposed" placeholder="" autocomplete="off" min="0">
                                    </div>
                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">माह में निस्तारित प्रकरण</div>
                                    @*<div class="col-lg-1 ng-binding">Cases disposed of in the month</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.InMonthCaseDisposed" placeholder="" autocomplete="off" min="0">
                                    </div>

                                    <div class="col-lg-1"></div>

                                </div>
                                <div class="form-group col-md-12">
                                    <div class="dev-menu-btn">
                                        <button type="submit" class="btn btn-primary ng-binding" ng-disabled="MyClassForm.$invalid" ng-click="SaveArticle()">{{translation.Submit}}</button>
                                        <button type="submit" class="btn btn-primary ng-binding" ng-click="ClearArticleForm()">Clear</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive devtable">
                        <table class="table table-bordered report-table" ng-if="MPRArticle30List.length > 0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>कार्यालय का नाम</th>
                                    <th>वर्ष के प्रारंभ में बकाया रहे प्रकरण</th>
                                    <th>गत माह तक प्राप्त प्रकरण</th>
                                    <th>माह में प्राप्त प्रकरण</th>
                                    <th>माह तक कुल प्रकरण</th>
                                    <th>गत माह तक निस्तारित प्रकरण</th>
                                    <th>माह में निस्तारित प्रकरण</th>
                                    <th>कुल निस्तारित प्रकरण</th>
                                    <th>माह के अन्त में शेष प्रकरण</th>
                                    <th>एक्शन</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in MPRArticle30List">
                                    <td>{{$index + 1}}</td>
                                    <td>{{item.DISTRICT_ENG}}</td>

                                    <td>{{item.InYearPendingCase}}</td>
                                    <td>{{item.LastMonthCaseReceived}}</td>
                                    <td>{{item.InMonthCaseReceived}}</td>
                                    <td>{{item.TotalReceived}}</td>

                                    <td>{{item.LastMonthCaseDisposed}}</td>
                                    <td>{{item.InMonthCaseDisposed}}</td>
                                    <td>{{item.TotalDisposed}}</td>
                                    <td>{{item.TotalPending}}</td>

                                    <td> <i class="fa fa-edit" style="cursor:pointer; color:#337ab7; font-size:18px;" ng-show="{{item.IsEditFlag}}" ng-click="EditRow(item)"></i></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="total-row">
                                    <td colspan="2">योग (Total)</td>
                                    <td>{{InYearPendingCase}}</td>
                                    <td>{{LastMonthCaseReceived}}</td>
                                    <td>{{InMonthCaseReceived}}</td>
                                    <td>{{TotalReceived}}</td>
                                    <td>{{LastMonthCaseDisposed}}</td>
                                    <td>{{InMonthCaseDisposed}}</td>
                                    <td>{{TotalDisposed}}</td>
                                    <td>{{TotalPending}}</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
