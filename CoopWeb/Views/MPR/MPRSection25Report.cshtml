@{
    ViewBag.Title = "Section 25 District Wise Report";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .report-table th,
    .report-table td {
        text-align: center;
        vertical-align: middle;
        font-size: 13px;
    }

    .report-table th {
        background: #f8f9fa;
        font-weight: bold;
        border: 1px solid #dee2e6;
    }

    .report-table td {
        border: 1px solid #dee2e6;
    }

    .total-row {
        background-color: #f4f4f4;
        font-weight: bold;
    }

    h2.report-title {
        text-align: center;
        margin-top: 15px;
        margin-bottom: 20px;
        font-weight: bold;
        text-decoration: underline;
    }

    input[type="number"] {
        width: 70px;
        text-align: center;
    }

    .signature-block {
        margin-top: 40px;
        text-align: right;
        font-size: 13px;
    }
</style>

<script src="~/Scripts/AngularFramework/MPRSection25Report.js"></script>

<div ng-app="mprMod" ng-controller="mprCtrl" ng-cloak>
    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; धारा 25 के अन्तर्गत साधारण सभा आयोजित करने की प्रगति का खण्डवार विवरण माह</b>
            </div>

            <div class="panel-body">
                <h2 class="report-title">धारा 25 के अन्तर्गत साधारण सभा आयोजित करने की प्रगति का खण्डवार विवरण माह</h2>

                <div class="table-responsive devtable">
                    <table class="table table-bordered report-table">
                        <thead>
                            <tr>
                                <th rowspan="3">कार्यालय का नाम</th>
                                <th colspan="4">कुल पंजीकृत सहकारी संस्थाओं की संख्या</th>
                                <th colspan="4">गत माह तक आयोजित की गई साधारण सभाओं की संख्या</th>
                                <th colspan="4">वर्तमान माह में आयोजित साधारण सभाओं की संख्या</th>
                                <th colspan="4">माह के अन्त में साधारण सभा आयोजन से शेष संस्थाओं की संख्या</th>
                                <th rowspan="3">कुल मापन सीमा</th>
                            </tr>
                            <tr>
                                <th>सक्रिय</th>
                                <th>निष्क्रिय</th>
                                <th>परिसमाप्त / नाधीन</th>
                                <th>कुल</th>

                                <th>सक्रिय</th>
                                <th>निष्क्रिय</th>
                                <th>परिसमाप्त / नाधीन</th>
                                <th>कुल</th>

                                <th>सक्रिय</th>
                                <th>निष्क्रिय</th>
                                <th>परिसमाप्त / नाधीन</th>
                                <th>कुल</th>

                                <th>सक्रिय</th>
                                <th>निष्क्रिय</th>
                                <th>परिसमाप्त / नाधीन</th>
                                <th>कुल</th>
                            </tr>
                            <tr>
                                <th>1</th>
                                <th>2</th>
                                <th>3</th>
                                <th>4</th>
                                <th>5</th>
                                <th>6</th>
                                <th>7</th>
                                <th>8</th>
                                <th>9</th>
                                <th>10</th>
                                <th>11</th>
                                <th>12</th>
                                <th>13</th>
                                <th>14</th>
                                <th>15</th>
                                <th>16</th>
                                
                            </tr>
                        </thead>

                        <tbody>
                            <tr >
                                <td></td>

                                <td><input class="form-control" type="number" min="0"/></td>
                                <td><input class="form-control" type="number" min="0" /></td>
                                <td><input class="form-control" type="number" min="0" /></td>
                                <td></td>

                                <td><input class="form-control" type="number" min="0" /></td>
                                <td><input class="form-control" type="number" min="0"  /></td>
                                <td><input class="form-control" type="number" min="0" /></td>
                                <td></td>

                                <td><input class="form-control" type="number" min="0" /></td>
                                <td><input class="form-control" type="number" min="0"/></td>
                                <td><input class="form-control" type="number" min="0"  /></td>
                                <td></td>

                                <td><input class="form-control" type="number" min="0" /></td>
                                <td><input  class="form-control" type="number" min="0" /></td>
                                <td><input class="form-control" type="number"  min="0" /></td>
                                <td></td>

                                <td><input class="form-control" type="number" min="0"  /></td>
                            </tr>
                        </tbody>

                        <tfoot>
                            <tr class="total-row">
                                <td>योग (Total)</td>
                                <td colspan="17" class="text-left">
                                    <strong></strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

               
            </div>
        </div>
    </div>
</div>
