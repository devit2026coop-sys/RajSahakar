@{
    ViewBag.Title = "MPR Article 61 Form";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .report-table th,
    .report-table td {
        text-align: center;
        vertical-align: middle;
        font-size: 13px;
    }

    .report-table th {
        background: #f8f9fa;
        font-weight: bold;
        border: 1px solid #dee2e6;
    }

    .report-table td {
        border: 1px solid #dee2e6;
    }

    .total-row {
        background-color: #f4f4f4;
        font-weight: bold;
    }

    h2.report-title {
        text-align: center;
        margin-top: 15px;
        margin-bottom: 20px;
        font-weight: bold;
        text-decoration: underline;
    }
</style>

<script src="~/Scripts/AngularFramework/MPRArticle61Form.js"></script>

<div ng-app="MPRArticle61FormCnt">
    <div ng-controller="MPRArticle61FormMod">
        <h3 class="citizen-dash-head" style="margin:10px 0px;">धारा 61 के अंतर्गत परिसमापन कार्य की प्रगति का विवरण</h3>
        <div class="container-fluid citizen-dash-head">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <form>
                        <div class="row">
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">वित्तीय वर्ष</label>
                                <select class="form-control ng-pristine ng-valid ng-empty ng-touched" ng-model="MPRArticleData.FinYearId" ng-init="MPRArticleData.FinYearId='0'">
                                    <option value="0">--वित्तीय वर्ष--</option>
                                    <option ng-repeat="year in FinancialYearList" value="{{year.FIN_YEAR_MASTR_ID}}">
                                        {{year.FIN_YEAR_NAME}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">माह</label>
                                <select class="form-control" ng-model="MPRArticleData.MonthId" ng-init="MPRArticleData.MonthId='0'">
                                    <option value="0">--माह--</option>
                                    <option ng-repeat="month in MonthList" value="{{month.Month_Id}}">
                                        {{ month.Month_En }}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">वर्ष के प्रारंभ में परिसमापन सोसाइटियों की संख्या</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.InYearPendingCase" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">गत माह तक जारी परिसमापन आदेश</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.LastMonthCaseReceived" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">माह में जारी परिसमापन आदेश</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.InMonthCaseReceived" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">गत माह तक निस्तारित सोसाइटियों की संख्या</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.LastMonthCaseDisposed" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">माह में निस्तारित सोसाइटियों की संख्या</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.InMonthCaseDisposed" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">एक वर्ष से कम लंबित जांचों की संख्या</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.No1YearPending" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">एक वर्ष से तीन वर्ष तक लंबित जांचों की संख्या</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.No1to3YearPending" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">तीन वर्ष से पांच वर्ष तक लंबित जांचों की संख्या</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.No3to5YearPending" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="ng-binding">पांच वर्ष से अधिक लंबित जांचों की संख्या</label>
                                <input type="number" class="form-control" ng-model="MPRArticleData.No5YearPending" placeholder="" autocomplete="off" min="0">
                            </div>
                            <div class="form-group col-md-12">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary ng-binding" ng-disabled="MyClassForm.$invalid" ng-click="SaveArticle()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary ng-binding" ng-click="ClearArticleForm()">Clear</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="table-responsive devtable">
                        <table class="table table-bordered report-table" ng-if="MPRArticle61List.length > 0" style="margin:0px;">
                            <thead>
                                <tr>
                                    <th rowspan="2">#</th>
                                    <th rowspan="2">कार्यालय का नाम</th>
                                    <th rowspan="2">वर्ष के प्रारंभ में परिसमापन सोसाइटियों की संख्या</th>
                                    <th rowspan="2">गत माह तक जारी परिसमापन आदेश</th>
                                    <th rowspan="2">माह में जारी परिसमापन आदेश</th>
                                    <th rowspan="2">माह तक कुल परिसमापनाधीन सोसाइटियों</th>
                                    <th rowspan="2">गत माह तक निस्तारित सोसाइटियों की संख्या</th>
                                    <th rowspan="2">माह में निस्तारित सोसाइटियों की संख्या</th>
                                    <th rowspan="2">कुल निस्तारित सोसाइटियों की संख्या</th>
                                    <th rowspan="2">माह के अन्त में परिसमापन से शेष </th>
                                    <th colspan="4">परिसमापनाधीन सोसाइटियों का वर्गीकरण अवधि के आधार पर</th>
                                    <th rowspan="2">एक्शन</th>
                                </tr>
                                <tr>
                                    <th>एक वर्ष से कम</th>
                                    <th>एक वर्ष से तीन वर्ष</th>
                                    <th>तीन वर्ष से पांच वर्ष</th>
                                    <th>पांच वर्ष से अधिक</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in MPRArticle61List">
                                    <td>{{$index + 1}}</td>
                                    <td>{{item.DISTRICT_ENG}}</td>

                                    <td>{{item.InYearPendingCase}}</td>
                                    <td>{{item.LastMonthCaseReceived}}</td>
                                    <td>{{item.InMonthCaseReceived}}</td>
                                    <td>{{item.TotalReceived}}</td>

                                    <td>{{item.LastMonthCaseDisposed}}</td>
                                    <td>{{item.InMonthCaseDisposed}}</td>
                                    <td>{{item.TotalDisposed}}</td>
                                    <td>{{item.TotalPending}}</td>

                                    <td>{{item.No1YearPending}}</td>
                                    <td>{{item.No1to3YearPending}}</td>
                                    <td>{{item.No3to5YearPending}}</td>
                                    <td>{{item.No5YearPending}}</td>

                                    <td> <i class="fa fa-edit" style="cursor:pointer; color:#337ab7; font-size:18px;" ng-show="{{item.IsEditFlag}}" ng-click="EditRow(item)"></i></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="total-row">
                                    <td colspan="2">योग (Total)</td>
                                    <td>{{InYearPendingCase}}</td>
                                    <td>{{LastMonthCaseReceived}}</td>
                                    <td>{{InMonthCaseReceived}}</td>
                                    <td>{{TotalReceived}}</td>
                                    <td>{{LastMonthCaseDisposed}}</td>
                                    <td>{{InMonthCaseDisposed}}</td>
                                    <td>{{TotalDisposed}}</td>
                                    <td>{{TotalPending}}</td>

                                    <td>{{No1YearPending}}</td>
                                    <td>{{No1to3YearPending}}</td>
                                    <td>{{No3to5YearPending}}</td>
                                    <td>{{No5YearPending}}</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
