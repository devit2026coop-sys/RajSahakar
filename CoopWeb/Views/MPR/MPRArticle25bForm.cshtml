@{
    ViewBag.Title = "MPR Article 25b Form";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .report-table th,
    .report-table td {
        text-align: center;
        vertical-align: middle;
        font-size: 13px;
    }

    .report-table th {
        background: #f8f9fa;
        font-weight: bold;
        border: 1px solid #dee2e6;
    }

    .report-table td {
        border: 1px solid #dee2e6;
    }

    .total-row {
        background-color: #f4f4f4;
        font-weight: bold;
    }

    h2.report-title {
        text-align: center;
        margin-top: 15px;
        margin-bottom: 20px;
        font-weight: bold;
        text-decoration: underline;
    }
</style>

<script src="~/Scripts/AngularFramework/MPRArticle25bForm.js"></script>

<div ng-app="MPRArticle25bFormCnt">
    <div ng-controller="MPRArticle25bFormMod">
        <div class="container-fluid citizen-dash-head">
            <div class="panel panel-default">
                <div class="panel-heading flexEqualCenter">
                    <b><i class="fa fa-th-list"></i>&nbsp; गत वर्ष तक की साधारण सभा आयोजन से शेष सोसायटियों का विवरण</b>
                </div>

                <div class="panel-body">
                    <h2 class="report-title">गत वर्ष तक की साधारण सभा आयोजन से शेष सोसायटियों का विवरण</h2>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <form class="citizen-dash-head">
                            <div class="col-lg-12 form-group">
                                <div class="col-md-4">
                                    <label class="ng-binding">वित्तीय वर्ष</label>
                                    <select class="form-control ng-pristine ng-valid ng-empty ng-touched" ng-model="MPRArticlebData.FinYearId" ng-init="MPRArticlebData.FinYearId='0'">
                                        <option value="0">--वित्तीय वर्ष--</option>
                                        <option ng-repeat="year in FinancialYearList" value="{{year.FIN_YEAR_MASTR_ID}}">
                                            {{year.FIN_YEAR_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="ng-binding">माह</label>
                                    <select class="form-control" ng-model="MPRArticlebData.MonthId" ng-init="MPRArticlebData.MonthId='0'">
                                        <option value="0">--माह--</option>
                                        <option ng-repeat="month in MonthList" value="{{month.Month_Id}}">
                                            {{ month.Month_En }}
                                        </option>
                                    </select>
                                </div>

                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding"></label>
                                </div>

                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding">गत वर्ष तक साधारण सभा आयोजन से शेष सोसायटियों की संख्या</label>
                                    @*<label class="ng-binding">Number of societies remaining for General Body Meeting (GBM) as of the end of the previous year</label>*@
                                </div>

                                <div class="col-lg-12 form-group">

                                    <div class="col-lg-1 ng-binding">सक्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Active</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticlebData.PyActive" placeholder="" autocomplete="off" min="0">
                                    </div>
                                    <div class="col-lg-1"></div>
                                    <div class="col-lg-1 ng-binding">निष्क्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Inactive</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticlebData.PyInactive" placeholder="" autocomplete="off" min="0">

                                    </div>
                                    <div class="col-lg-1"></div>
                                    <div class="col-lg-1 ng-binding">परिसमापनाधीन</div>
                                    @*<div class="col-lg-1 ng-binding">Under Liquidation</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticlebData.PyUnderLiquidation" placeholder="" autocomplete="off" min="0">
                                    </div>
                                </div>
                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding">माह तक सोसायटियों की संख्या जिनमें साधारण सभा का आयोजन किया गया</label>
                                    @*<label class="ng-binding">Number of societies in which the General Body Meeting has been conducted up to the month</label>*@
                                </div>
                                <div class="col-lg-12 form-group">
                                    <div class="col-lg-1 ng-binding">सक्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Active</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticlebData.CmgmActive" placeholder="" autocomplete="off" min="0">
                                    </div>
                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">निष्क्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Inactive</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticlebData.CmgmInactive" placeholder="" autocomplete="off" min="0">
                                    </div>

                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">परिसमापनाधीन</div>
                                    @*<div class="col-lg-1 ng-binding">Under Liquidation</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticlebData.CmgmUnderLiquidation" placeholder="" autocomplete="off" min="0">

                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    <div class="dev-menu-btn">
                                        <button type="submit" class="btn btn-primary ng-binding" ng-disabled="MyClassForm.$invalid" ng-click="SaveArticle()">{{translation.Submit}}</button>
                                        <button type="submit" class="btn btn-primary ng-binding" ng-click="ClearArticleForm()">Clear</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive devtable">
                        <table class="table table-bordered report-table" ng-if="MPRArticle25bList.length > 0">
                            <thead>
                                <tr>
                                    <th rowspan="3">#</th>
                                    <th rowspan="3">कार्यालय का नाम</th>
                                    <th colspan="4">गत वर्ष तक साधारण सभा आयोजन से शेष सोसायटियों की संख्या</th>
                                    <th colspan="4">माह तक सोसायटियों की संख्या जिनमें साधारण सभा का आयोजन किया गया</th>
                                    <th colspan="4">माह के अन्त में साधारण सभा आयोजन से शेष सोसायटियों की संख्या</th>
                                    <th rowspan="3">एक्शन</th>
                                </tr>
                                <tr>
                                    <th>सक्रिय</th>
                                    <th>निष्क्रिय</th>
                                    <th>परिसमापनाधीन</th>
                                    <th>कुल</th>

                                    <th>सक्रिय</th>
                                    <th>निष्क्रिय</th>
                                    <th>परिसमापनाधीन</th>
                                    <th>कुल</th>

                                    <th>सक्रिय</th>
                                    <th>निष्क्रिय</th>
                                    <th>परिसमापनाधीन</th>
                                    <th>कुल</th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in MPRArticle25bList">
                                    <td>{{$index + 1}}</td>
                                    <td>{{item.DISTRICT_ENG}}</td>

                                    <td>{{item.PyActive}}</td>
                                    <td>{{item.PyInactive}}</td>
                                    <td>{{item.PyUnderLiquidation}}</td>
                                    <td>{{item.PyTotal}}</td>

                                    <td>{{item.CmgmActive}}</td>
                                    <td>{{item.CmgmInactive}}</td>
                                    <td>{{item.CmgmUnderLiquidation}}</td>
                                    <td>{{item.CmTotal}}</td>

                                    <td>{{item.EmgmActive}}</td>
                                    <td>{{item.EmgmInactive}}</td>
                                    <td>{{item.EmgmUnderLiquidation}}</td>
                                    <td>{{item.EmTotal}}</td>

                                    <td> <i class="fa fa-edit" style="cursor:pointer; color:#337ab7; font-size:18px;" ng-show="{{item.IsEditFlag}}" ng-click="EditRow(item)"></i></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="total-row">
                                    <td colspan="2">योग (Total)</td>
                                    <td>{{PyActive}}</td>
                                    <td>{{PyInactive}}</td>
                                    <td>{{PyUnderLiquidation}}</td>
                                    <td>{{PyTotal}}</td>
                                    <td>{{CmgmActive}}</td>
                                    <td>{{CmgmInactive}}</td>
                                    <td>{{CmgmUnderLiquidation}}</td>
                                    <td>{{CmTotal}}</td>
                                    <td>{{EmgmActive}}</td>
                                    <td>{{EmgmInactive}}</td>
                                    <td>{{EmgmUnderLiquidation}}</td>
                                    <td>{{EmTotal}}</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
