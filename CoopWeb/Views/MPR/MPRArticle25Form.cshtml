@{
    ViewBag.Title = "MPR Article 25 Form";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .report-table th,
    .report-table td {
        text-align: center;
        vertical-align: middle;
        font-size: 13px;
    }

    .report-table th {
        background: #f8f9fa;
        font-weight: bold;
        border: 1px solid #dee2e6;
    }

    .report-table td {
        border: 1px solid #dee2e6;
    }

    .total-row {
        background-color: #f4f4f4;
        font-weight: bold;
    }

    h2.report-title {
        text-align: center;
        margin-top: 15px;
        margin-bottom: 20px;
        font-weight: bold;
        text-decoration: underline;
    }
</style>

<script src="~/Scripts/AngularFramework/MPRArticle25Form.js"></script>

<div ng-app="MPRArticle25FormCnt">
    <div ng-controller="MPRArticle25FormMod">
        <div class="container-fluid citizen-dash-head">
            <div class="panel panel-default">
                <div class="panel-heading flexEqualCenter">
                    <b><i class="fa fa-th-list"></i>&nbsp; धारा 25 के अन्तर्गत साधारण सभा आयोजित करने की प्रगति का खण्डवार विवरण</b>
                </div>

                <div class="panel-body">
                    <h2 class="report-title">धारा 25 के अन्तर्गत साधारण सभा आयोजित करने की प्रगति का खण्डवार विवरण</h2>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <form class="citizen-dash-head">
                            <div class="col-lg-12 form-group">
                                <div class="col-md-4">
                                    <label class="ng-binding">वित्तीय वर्ष</label>
                                    <select class="form-control ng-pristine ng-valid ng-empty ng-touched" ng-model="MPRArticleData.FinYearId" ng-init="MPRArticleData.FinYearId='0'">
                                        <option value="0">--वित्तीय वर्ष--</option>
                                        <option ng-repeat="year in FinancialYearList" value="{{year.FIN_YEAR_MASTR_ID}}">
                                            {{year.FIN_YEAR_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="ng-binding">माह</label>
                                    <select class="form-control" ng-model="MPRArticleData.MonthId" ng-init="MPRArticleData.MonthId='0'">
                                        <option value="0">--माह--</option>
                                        <option ng-repeat="month in MonthList" value="{{month.Month_Id}}">
                                            {{ month.Month_En }}
                                        </option>
                                    </select>
                                </div>
                                @*<div class="col-md-4">
                                        <label class="ng-binding">
                                            District
                                        </label>
                                        <select class="form-control ng-pristine ng-valid ng-empty ng-touched" id="ddldistrictId1" ng-model="MPRArticleData.District">
                                            <option value="">-- Choose Option --</option>
                                            <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                                {{district.DISTRICT_ENG}}
                                            </option>
                                        </select>
                                    </div>*@

                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding"></label>
                                </div>

                                <div class="col-lg-12 form-group">
                                    @*<input type="hidden" ng-model="MPRArticleData.LoanDataId" class="ng-pristine ng-untouched ng-valid ng-not-empty">*@
                                    <label class="ng-binding">कुल पंजीकृत सहकारी सोसाइटियों की संख्या</label>
                                    @*<label class="ng-binding">Total number of registered cooperative societies</label>*@
                                </div>

                                <div class="col-lg-12 form-group">

                                    <div class="col-lg-1 ng-binding">सक्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Active</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.TsActive" placeholder="" autocomplete="off" min="0">
                                    </div>
                                    <div class="col-lg-1"></div>
                                    <div class="col-lg-1 ng-binding">निष्क्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Inactive</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.TsInactive" placeholder="" autocomplete="off" min="0">

                                    </div>
                                    <div class="col-lg-1"></div>
                                    <div class="col-lg-1 ng-binding">परिसमापनाधीन</div>
                                    @*<div class="col-lg-1 ng-binding">Under Liquidation</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.TsUnderLiquidation" placeholder="" autocomplete="off" min="0">
                                    </div>
                                </div>
                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding">गत माह तक आयोजित की गई साधारण सभाओं की संख्या</label>
                                    @*<label class="ng-binding">Number of general meetings held up to the previous month</label>*@
                                </div>
                                <div class="col-lg-12 form-group">
                                    <div class="col-lg-1 ng-binding">सक्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Active</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.PmgmActive" placeholder="" autocomplete="off" min="0">
                                    </div>
                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">निष्क्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Inactive</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.PmgmInactive" placeholder="" autocomplete="off" min="0">
                                    </div>

                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">परिसमापनाधीन</div>
                                    @*<div class="col-lg-1 ng-binding">Under Liquidation</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.PmgmUnderLiquidation" placeholder="" autocomplete="off" min="0">

                                    </div>
                                </div>
                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding">वर्तमान माह में आयोजित साधारण सभाओं की संख्या</label>
                                    @*<label class="ng-binding">Number of general meetings held during the current month</label>*@
                                </div>
                                <div class="col-lg-12 form-group">
                                    <div class="col-lg-1 ng-binding">सक्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Active</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.CmgmActive" placeholder="" autocomplete="off" min="0">
                                    </div>
                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">निष्क्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Inactive</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.CmgmInactive" placeholder="" autocomplete="off" min="0">
                                    </div>

                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">परिसमापनाधीन</div>
                                    @*<div class="col-lg-1 ng-binding">Under Liquidation</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.CmgmUnderLiquidation" placeholder="" autocomplete="off" min="0">
                                    </div>
                                </div>
                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding">माह तक आयोजित साधारण सभाओं की संख्या</label>
                                    @*<label class="ng-binding">Number of General Meetings Held up to the Month</label>*@
                                </div>
                                <div class="col-lg-12 form-group">
                                    <div class="col-lg-1 ng-binding">कुल संख्या</div>
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.TmgmCount" placeholder="" autocomplete="off" min="0">
                                    </div>
                                </div>
                                <div class="col-lg-12 form-group">
                                    <label class="ng-binding">माह के अंत में साधारण सभा आयोजन से शेष सोसाइटियों की संख्या</label>
                                    @*<label class="ng-binding">Number of societies pending to conduct the General Meeting as of the end of the month</label>*@
                                </div>
                                <div class="col-lg-12 form-group">
                                    <div class="col-lg-1 ng-binding">सक्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Active</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.EmgmActive" placeholder="" autocomplete="off" min="0">
                                    </div>
                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">निष्क्रिय</div>
                                    @*<div class="col-lg-1 ng-binding">Inactive</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.EmgmInactive" placeholder="" autocomplete="off" min="0">
                                    </div>

                                    <div class="col-lg-1"></div>

                                    <div class="col-lg-1 ng-binding">परिसमापनाधीन</div>
                                    @*<div class="col-lg-1 ng-binding">Under Liquidation</div>*@
                                    <div class="col-lg-2">
                                        <input type="number" class="form-control" ng-model="MPRArticleData.EmgmUnderLiquidation" placeholder="" autocomplete="off" min="0">
                                    </div>
                                </div>
                                <div class="form-group col-md-12">
                                    <div class="dev-menu-btn">
                                        <button type="submit" class="btn btn-primary ng-binding" ng-disabled="MyClassForm.$invalid" ng-click="SaveArticle()">{{translation.Submit}}</button>
                                        <button type="submit" class="btn btn-primary ng-binding" ng-click="ClearArticleForm()">Clear</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive devtable">
                        <table class="table table-bordered report-table" ng-if="MPRArticle25List.length > 0">
                            <thead>
                                <tr>
                                    <th rowspan="3">#</th>
                                    <th rowspan="3">कार्यालय का नाम</th>
                                    <th colspan="4">कुल पंजीकृत सहकारी सोसाइटियों की संख्या</th>
                                    <th colspan="4">गत माह तक आयोजित की गई साधारण सभाओं की संख्या</th>
                                    <th colspan="4">वर्तमान माह में आयोजित साधारण सभाओं की संख्या</th>
                                    <th colspan="4">माह के अन्त में साधारण सभा आयोजन से शेष सोसाइटियों की संख्या</th>
                                    <th rowspan="3">माह तक आयोजित साधारण सभाओं की संख्या</th>
                                    <th rowspan="3">एक्शन</th>
                                </tr>
                                <tr>
                                    <th>सक्रिय</th>
                                    <th>निष्क्रिय</th>
                                    <th>परिसमापनाधीन</th>
                                    <th>कुल</th>

                                    <th>सक्रिय</th>
                                    <th>निष्क्रिय</th>
                                    <th>परिसमापनाधीन</th>
                                    <th>कुल</th>

                                    <th>सक्रिय</th>
                                    <th>निष्क्रिय</th>
                                    <th>परिसमापनाधीन</th>
                                    <th>कुल</th>

                                    <th>सक्रिय</th>
                                    <th>निष्क्रिय</th>
                                    <th>परिसमापनाधीन</th>
                                    <th>कुल</th>
                                </tr>
                                @*<tr>
                                        <th>1</th>
                                        <th>2</th>
                                        <th>3</th>
                                        <th>4</th>
                                        <th>5</th>
                                        <th>6</th>
                                        <th>7</th>
                                        <th>8</th>
                                        <th>9</th>
                                        <th>10</th>
                                        <th>11</th>
                                        <th>12</th>
                                        <th>13</th>
                                        <th>14</th>
                                        <th>15</th>
                                        <th>16</th>
                                    </tr>*@
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in MPRArticle25List">
                                    <td>{{$index + 1}}</td>
                                    <td>{{item.DISTRICT_ENG}}</td>

                                    <td>{{item.TsActive}}</td>
                                    <td>{{item.TsInactive}}</td>
                                    <td>{{item.TsUnderLiquidation}}</td>
                                    <td>{{item.TsTotal}}</td>

                                    <td>{{item.PmgmActive}}</td>
                                    <td>{{item.PmgmInactive}}</td>
                                    <td>{{item.PmgmUnderLiquidation}}</td>
                                    <td>{{item.PmTotal}}</td>

                                    <td>{{item.CmgmActive}}</td>
                                    <td>{{item.CmgmInactive}}</td>
                                    <td>{{item.CmgmUnderLiquidation}}</td>
                                    <td>{{item.CmTotal}}</td>

                                    <td>{{item.EmgmActive}}</td>
                                    <td>{{item.EmgmInactive}}</td>
                                    <td>{{item.EmgmUnderLiquidation}}</td>
                                    <td>{{item.EmTotal}}</td>

                                    <td>{{item.TmgmCount}}</td>

                                    <td> <i class="fa fa-edit" style="cursor:pointer; color:#337ab7; font-size:18px;" ng-show="{{item.IsEditFlag}}" ng-click="EditRow(item)"></i></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="total-row">
                                    <td colspan="2">योग (Total)</td>
                                    <td>{{TsActive}}</td>
                                    <td>{{TsInactive}}</td>
                                    <td>{{TsUnderLiquidation}}</td>
                                    <td>{{TsTotal}}</td>
                                    <td>{{PmgmActive}}</td>
                                    <td>{{PmgmInactive}}</td>
                                    <td>{{PmgmUnderLiquidation}}</td>
                                    <td>{{PmTotal}}</td>
                                    <td>{{CmgmActive}}</td>
                                    <td>{{CmgmInactive}}</td>
                                    <td>{{CmgmUnderLiquidation}}</td>
                                    <td>{{CmTotal}}</td>
                                    <td>{{EmgmActive}}</td>
                                    <td>{{EmgmInactive}}</td>
                                    <td>{{EmgmUnderLiquidation}}</td>
                                    <td>{{EmTotal}}</td>
                                    <td>{{TmgmCount}}</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
