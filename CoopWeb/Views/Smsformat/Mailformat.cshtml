<script src="~/Scripts/AngularFramework/SmsFormat.js"></script>
@Html.Hidden("TemplateId")
<div ng-app="AppSmsFormat">
    <div ng-controller="SmsFormat">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.Mail}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-md-12">
            <div class="master-detail" style="margin-left:15px;">
                @if (ViewBag.BreadCrumbPath != null)
                {
                    <h5> @ViewBag.BreadCrumbPath </h5>
                }
            </div>
        </div>
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> Home </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> New </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> Mail Formate </span>
                </li>
                <li style="float: right;" id="divAddBtn">
                    <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal"> <h5>&#187; {{translation.AddMailModel}}</h5> </button>
                        
                    </li>
            </ul>
        </div>
        <!-- Trigger the modal with a button -->
       

        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearTemplateForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.Mail}} </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" name="MyMailForm" style="overflow: hidden; margin-bottom:35px;">
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : MyMailForm.TemplateHeadingEN.$invalid && !MyMailForm.TemplateHeadingEN.$pristine }">
                                <label>{{translation.MailFormatEng}}</label>
                                <input type="text" class="form-control" name="TemplateHeadingEN" ng-bind="TemplateHeadingEN" ng-model="Smsformat.TemplateHeadingEN" placeholder="Mail Format English Heading" ng-required="true" autocomplete="off" />
                                <label ng-show="MyMailForm.TemplateHeadingEN.$error.required && !MyMailForm.TemplateHeadingEN.$pristine" class="help-block">{{translation.TemplateHeadingEN}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : MyMailForm.TemplateHeadingHI.$invalid && !MyMailForm.TemplateHeadingHI.$pristine }">
                                <label>{{translation.MailFormatHin}}</label>
                                <input type="text" class="form-control" name="TemplateHeadingHI" ng-bind="TemplateHeadingHI" ng-model="Smsformat.TemplateHeadingHI" placeholder="Mail Format Hindi Heading" ng-required="true" autocomplete="off" />
                                <label ng-show="MyMailForm.TemplateHeadingHI.$error.required && !MyMailForm.TemplateHeadingHI.$pristine" class="help-block">{{translation.TemplateHeadingHI}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : MyMailForm.TemplateBodyEN.$invalid && !MyMailForm.TemplateBodyEN.$pristine }">
                                <label>{{translation.MailBodyEng}}</label>
                                <textarea name="TemplateBodyEN" class="form-control" ng-bind="TemplateBodyEN" ng-model="Smsformat.TemplateBodyEN" placeholder="Mail Format English Body" ng-required="true" autocomplete="off"></textarea>
                                <label ng-show="MyMailForm.TemplateBodyEN.$error.required && !MyMailForm.TemplateBodyEN.$pristine" class="help-block">{{translation.TemplateBodyEN}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : MyMailForm.TemplateHeadingEN.$invalid && !MyMailForm.TemplateHeadingEN.$pristine }">
                                <label>{{translation.MailBodyHin}}</label>
                                <textarea name="TemplateBodyHI" class="form-control" ng-bind="TemplateBodyHI" ng-model="Smsformat.TemplateBodyHI" placeholder="Mail Format Hindi Body" ng-required="true" autocomplete="off"></textarea>
                                <label ng-show="MyMailForm.TemplateBodyHI.$error.required && !MyMailForm.TemplateBodyHI.$pristine" class="help-block">{{translation.TemplateBodyHI}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6">
                                <div class="form-check form-check-inline col-md-2" style="padding: 0;">
                                    <label class="check-box" for="inlineRadio1"> {{translation.IsActive}} </label>
                                </div>
                                <div class="check-item col-md-2">
                                    <input class="form-check-input" type="checkbox" id="inlineCheckbox1" value="option1" ng-true-value="1" ng-false-value="0" ng-model="Smsformat.IsActive" /> @*ng-checked="menuaction.IsActive == 1"*@
                                </div>
                            </div>

                            <div class="form-group col-md-12">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-disabled="MyMailForm.$invalid" ng-click="SaveMailFormat()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearTemplateForm()">{{translation.Clear}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
        <div>


        </div>
        <div class="" ng-show="DivSms">

            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder="Filter text" autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="table-responsive citizen-dash-head">
                            <table class="table devtable">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th ng-click="sortData('TemplateHeadingEN')">
                                            {{translation.TemplateHeadingEN}}
                                            <div ng-class="getSortClass('TemplateHeadingEN')"></div>
                                        </th>
                                        <th ng-click="sortData('TemplateHeadingHI')">
                                            {{translation.TemplateHeadingHI}}
                                            <div ng-class="getSortClass('TemplateHeadingHI')"></div>
                                        </th>
                                        <th ng-click="sortData('TemplateBodyEN')">
                                            {{translation.TemplateBodyEN}}
                                            <div ng-class="getSortClass('TemplateBodyEN')"></div>
                                        </th>
                                        <th ng-click="sortData('TemplateBodyHI')">
                                            {{translation.TemplateBodyHI}}
                                            <div ng-class="getSortClass('TemplateBodyHI')"></div>
                                        </th>
                                        <th>
                                            {{translation.CreationDate}}
                                        </th>
                                        <th>
                                            {{translation.IsActive}}
                                        </th>
                                        <th>
                                            {{translation.Edit}}
                                        </th>
                                        <th>
                                            {{translation.Delete}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="sms in MailData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SmsFormatPagination">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>
                                            {{sms.TemplateHeadingEN}}
                                        </td>
                                        <td>
                                            {{sms.TemplateHeadingHI}}
                                        </td>
                                        <td>
                                            {{sms.TemplateBodyEN}}
                                        </td>
                                        <td>
                                            {{sms.TemplateBodyHI}}
                                        </td>
                                        <td>{{ (sms.CreateDate).toMSDate()  }}</td>
                                        <td>
                                            <div class="dev-action">
                                                @*<input  type="text" value="{{sms.IsActive}}"/>*@
                                                <label class="switch">
                                                    <input type="checkbox" ng-checked="sms.IsActive == 1" ng-click="SetStatus(sms.TemplateId,sms.IsActive)">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                            @*{{sms.IsActive === 1 ? "Active" : "In Active"}}*@
                                        </td>
                                        <td>
                                            <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(sms)"></i>
                                        </td>
                                        <td>
                                            <i class="fa fa-trash" ng-click="SetStatus(sms.TemplateId,2)"></i>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-10">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="SmsFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

