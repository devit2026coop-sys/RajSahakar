<script src="~/Scripts/AngularFramework/Preproduction.js?id=10"></script>
<div class="hk-pg-wrapper" ng-app="myApp">
    <div ng-controller="myCtrl">
        <!-- Breadcrumb -->
        <nav class="hk-breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-light bg-transparent">
                <li class="breadcrumb-item"><a href="#"><i class="glyphicon glyphicon-th"></i></a></li>
                <li class="breadcrumb-item">Emitra</li>
                <li class="breadcrumb-item active" aria-current="page">Payment Status</li>
            </ol>
        </nav>
        <!-- /Breadcrumb -->
        <!-- Container -->
        <div class="container">
            <!-- Title -->
            <!-- Row -->
            <div class="row">
                <div class="col-xl-12">
                    <div class="card">
                        <div class="card-body col-sm row mb-0">
                            <div class="col-md-4">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-md-4">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="1000" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                            </div>
                            <div class="col-md-4" style="padding-top: 25px; ">
                                <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="table-wrap">
                            <table class="table table-bordered w-100 display pb-0 mb-0" id="tblgetsuport">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.TableName}}
                                        </th>
                                        <th>
                                            {{translation.DataCount}}
                                        </th>
                                        <th>
                                            Column Count
                                        </th>
                                        @*<th>
                                            {{translation.TableCreateDate}}
                                        </th>
                                        <th>
                                            {{translation.TableUpdateDate}}
                                        </th>*@
                                        <th>
                                            {{translation.Update}}
                                        </th>
                                        <th>
                                            {{translation.Action}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>                                    
                                    <tr ng-repeat="Table in TableSchema track by $index" current-page="currentPage" pagination-id="ClassesFormatPagination">
                                        <td>{{$index+1}}</td>                                       
                                        <td>{{Table.TableName}}</td>
                                        <td>{{Table.DataCount}}</td>
                                        <td>{{Table.ColumnCount}}</td>
                                        @*<td>{{Table.TableCreateDate}}</td>
                                        <td>{{Table.TableUpdateDate}}</td>*@
                                        <td>{{Table.PushDataDate}}</td>
                                        
                                        <td>
                                            <div class="btn-group">
                                                <a class="btn btn-primary btn-sm text-white mnw-100p" ng-show="true" ng-click="PushTable(Table)">{{translation.PushData}}</a>
                                                @*<a class="btn btn-secondary btn-md text-white mnw-100p" ng-show="true" ng-click="TruncateTable(Table)">{{translation.Truncate}}</a>*@
                                            </div> </td>

                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="row">
                            <div class="col-sm">
                                <nav class="pagination-wrap  justify-content-end mb-25" aria-label="Page navigation example">
                                    <nav class="pagination-wrap d-inline-block mr-40 mt-15" aria-label="Page navigation example">
                                        <ul class="pagination">
                                            <dir-pagination-controls boundary-links="true" pagination-id="BlockPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                                        </ul>
                                    </nav>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /Row -->


        </div>
        <!-- /Container -->
    </div>
</div>

