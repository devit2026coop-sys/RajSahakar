<script src="~/Scripts/AngularFramework/UserRoleDeptMappingClient.js?id=3"></script>
<div ng-app="UserRoleDeptMapping">
    <div ng-controller="UserRoleDept">

        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">{{translation.UserRoleDeptHeading}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.UserRoleDeptHeading}}</span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        @*<i class="fa fa-angle-double-right" style="color: #025e63;"></i>
                            <a ng-click="AdduserRoleDeptClick()" data-toggle="modal" data-target="#myModal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" class="ng-binding" ng-click="ClearUserRoleDeptMappingForm()">{{translation.AdduserRoleDept}}</a>*@
                    </li>

                </ul>
            </div>
        </div>

        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearUserRoleDeptMappingForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.UserRoleDeptHeading}} </h4>
                    </div>
                    <div class="modal-body">

                        <form class="dev-search-form" name="form1" style="overflow: hidden;">


                            <div class="form-group col-md-6">

                                <label>{{translation.UserHeading}}</label>

                                <select class="form-control" ng-model="UserRoleDept.UserId" ng-init="UserRoleDept.UserId='0'">
                                    <option value="0" disabled>{{translation.SelectUser}}</option>
                                    <option ng-repeat="item in Users" value="{{item.UserId}}">
                                        {{_language =='en-us' ?  item.OfficerNameEn : item.OfficerNameHi}}

                                    </option>
                                </select>

                            </div>




                            <div class="form-group col-md-6">
                                <label>{{translation.DepartmentHeading}}</label>
                                <select class="form-control" ng-model="UserRoleDept.DEPTCODE" ng-init="UserRoleDept.DEPTCODE='0'">
                                    <option value="0" disabled>{{translation.SelectDept}}</option>
                                    <option ng-repeat="item in Departments" value="{{item.DEPTCODE}}">
                                        {{_language =='en-us' ?  item.DEPTNAMEENGLISH : item.DEPTNAMEHINDI}}

                                    </option>
                                </select>
                            </div>


                            <div class="form-group col-md-6">
                                <label>{{translation.DesignationHeading}}</label>
                                <select class="form-control" ng-model="UserRoleDept.DESIGNATIONCODE" ng-init="UserRoleDept.DESIGNATIONCODE='0'">
                                    <option selected value="0" disabled>{{translation.SelectDesig}}</option>
                                    <option ng-repeat="item in Designations" value="{{item.DESIGNATIONCODE}}">
                                        {{_language =='en-us' ?  item.DESIGNATIONDESCENGLISH : item.DESIGNATIONDESCHINDI}}
                                    </option>
                                </select>
                            </div>

                            <div class="form-group col-md-6">
                                <label>{{translation.PostHeading}}</label>
                                <select class="form-control" ng-model="UserRoleDept.PostId" ng-init="UserRoleDept.PostId='0'">
                                    <option value="0" disabled>{{translation.SelectPost}}</option>
                                    <option ng-repeat="item in Posts" value="{{item.CAD_ID}}">
                                        {{_language =='en-us' ?  item.CAD_NAME : item.CAD_NAME}}
                                    </option>
                                </select>
                            </div>


                            <div class="form-group col-md-6">
                                <label>{{translation.RoleHeading}}</label>
                                <select class="form-control" ng-model="UserRoleDept.RoleID" ng-init="UserRoleDept.RoleID='0'">
                                    <option value="0" disabled>{{translation.SelectRole}}</option>
                                    <option ng-repeat="item in Roles" value="{{item.RoleID}}">
                                        {{_language =='en-us' ?  item.RoleName_EN : item.RoleName_HI}}
                                    </option>
                                </select>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="check-box" for="inlineRadio1" style="margin-right: 15px;"> {{translation.IsActive}} </label>
                                <input class="form-check-input" type="checkbox" id="inlineCheckbox1" value="option1" ng-true-value="1"
                                       ng-false-value="0" ng-checked="UserRoleDept.IsActive == 1" ng-model="UserRoleDept.IsActive" />
                            </div>

                            <div class="form-group col-md-12">
                                <div class="dev-align-btn">
                                    <button type="submit" ng-disabled="form1.$invalid" ng-click="SaveUserRoleDeptMapping()" class="btn btn-primary dev-btn">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary dev-btn" ng-click="ClearUserRoleDeptMappingForm()">{{translation.Clear}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    @*<div class="table-dropdown">
            <div class="col-md-4">
                <label for="search">{{translation.Search}}:</label>
                <input ng-model="q" id="search" class="form-control" placeholder="Filter text" autocomplete="off">
            </div>
            <div class="col-md-4">
                <label for="search">{{translation.ItemPerPage}}:</label>
                <input type="number" min="1" max="100" class="form-control" ng-model="pageSize" autocomplete="off">
            </div>
        </div>*@
                    <div class="table-dropdown" id="search-filter">
                        <div class="col-lg-12" style="margin-bottom: 10px; padding-left: 0;">
                            <div class="col-md-4">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="Filter.SearchText" name="SearchText" id="search" placeholder="Filter text" class="form-control" autocomplete="off">
                            </div>
                            <div class="col-md-4">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" ng-model="pageSize" autocomplete="off">
                            </div>
                            <div class="col-md-4  margin-Top20">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-click="searchRequest(UserRoleDeptMapping)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                            </div>
                        </div>
                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('OfficerNameEn')">
                                    {{translation.UserHeading}}
                                    <div ng-class="getSortClass('OfficerNameEn')"></div>
                                </th>
                                <th ng-click="sortData('DEPTNAMEENGLISH')">
                                    {{translation.DepartmentHeading}}
                                    <div ng-class="getSortClass('DEPTNAMEENGLISH')"></div>
                                </th>
                                <th ng-click="sortData('OrganisationNameEn')">
                                    {{translation.Organisation}}
                                    <div ng-class="getSortClass('OrganisationNameEn')"></div>
                                </th>
                                <th ng-click="sortData('DESIGNATIONDESCENGLISH')">
                                    {{translation.DesignationHeading}}
                                    <div ng-class="getSortClass('DESIGNATIONDESCENGLISH')"></div>
                                </th>
                                <th ng-click="sortData('RoleName_EN')">
                                    {{translation.RoleHeading}}
                                    <div ng-class="getSortClass('RoleName_EN')"></div>
                                </th>
                                <th ng-click="sortData('LevelNameEn')">
                                    {{translation.Level}}
                                    <div ng-class="getSortClass('LevelNameEn')"></div>
                                </th>
                                <th>
                                    {{translation.Place}}
                                </th>
                                <th ng-click="sortData('IsActive')">
                                    {{translation.Status}}
                                    <div ng-class="getSortClass('IsActive')"></div>
                                </th>
                                @*<th>{{translation.Edit}}</th>*@
                                <th>{{translation.Delete}}</th>
                                <th>{{translation.AssignRights}}</th>


                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="URDM in GetUserRoleDeptMapping">
                            @*<tr dir-paginate="URDM in GetUserRoleDeptMapping |    orderBy:colsort:reverseSort  | itemsPerPage: pageSize" current-page="DataPaging.currentPageID" pagination-id="URDMPagination">*@
                                @*<td>{{pageSize *(currentPage-1)+$index+1}}</td>*@
                                <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                                <td>{{ _language =='en-us' ? URDM.OfficerNameEn  : URDM.OfficerNameHi }}</td>
                                <td>{{ _language =='en-us' ? URDM.DEPTNAMEENGLISH : URDM.DEPTNAMEHINDI  }}</td>
                                <td>{{ _language =='en-us' ? URDM.OrganisationNameEn : URDM.OrganisationNameHi  }}</td>
                                <td>{{ _language =='en-us' ? URDM.DESIGNATIONDESCENGLISH : URDM.DESIGNATIONDESCHINDI  }}</td>
                                <td>{{ _language =='en-us' ? URDM.RoleName_EN : URDM.RoleName_HI  }}</td>
                                <td>{{ _language =='en-us' ? URDM.LevelNameEn : URDM.LevelNameHi  }}</td>
                                <td>
                                    <span ng-show="URDM.LevelId==1">{{translation.State}}</span>
                                    <span ng-show="URDM.LevelId==2">{{ _language =='en-us' ? URDM.DIVISION_ENG : URDM.DIVISION_MANGAL }}</span>
                                    <span ng-show="URDM.LevelId==3">{{ _language =='en-us' ? URDM.DISTRICT_ENG : URDM.DISTRICT_MANGAL  }}</span>
                                    <span ng-show="URDM.LevelId==4 && URDM.CityId!=0">{{ _language =='en-us' ? URDM.DISTRICT_ENG - URDM.CITY_ENG : URDM.DISTRICT_MANGAL - URDM.CITY_MANGAL  }}</span>
                                    <span ng-show="URDM.LevelId==4 && URDM.PanchayatSamitiId!=0">{{ _language =='en-us' ? URDM.DISTRICT_ENG - URDM.BLOCK_ENG : URDM.DISTRICT_MANGAL - URDM.BLOCK_MANGAL  }}</span>
                                    <span ng-show="URDM.LevelId==4 && URDM.PLDBId!=0">{{ URDM.place  }}</span>
                                    <span ng-show="URDM.LevelId==7||URDM.LevelId==8||URDM.LevelId==9">{{URDM.place}}</span>
                                    <span ng-show="URDM.LevelId==''"></span>
                                </td>
                                <td>
                                    <div class="dev-action">
                                        <label ng-show="URDM.RoleId!=1" class="switch">
                                            <input type="checkbox" ng-checked="URDM.IsActive == 1" ng-click="SetStatus(URDM.MappingID,URDM.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                @*<td>
                <i class="fa fa-edit"  ng-show="URDM.RoleId!=1" data-target="#myModal" data-toggle="modal" ng-click="updateURDM(URDM)"></i>
            </td>*@
                                <td>
                                    <i class="fa fa-trash" ng-show="URDM.RoleId!=1" ng-click="SetStatus(URDM.MappingID,2)"></i>

                                </td>
                                <td>


                                    <div class="dev-action">

                                        <input type="radio" name="SingleChoise" ng-model="SingleChoise" value="1" ng-click="AssignMoreRightsFunction(URDM)">

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',UserRoleDeptMapping)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,UserRoleDeptMapping)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,UserRoleDeptMapping)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,UserRoleDeptMapping)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,UserRoleDeptMapping)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
       
            </div>


            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="URDMPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>


        <div ng-show='IsVisible'>
            <div class="form-group">





                <div class="col-md-12">
                    <div class="table-responsive citizen-dash-head">
                        <table class="table devtable">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SrNo}}
                                    </th>
                                    <th align="center">
                                        <input id="CheckAll" type="checkbox" ng-click="toggleAll()" ng-model="isAllSelected" />
                                    </th>
                                    <th ng-click="sortData('Parent_Name_En')">
                                        {{translation.ParentMenuNameEn}}
                                        <div ng-class="getSortClass('Parent_Name_En')"></div>
                                    </th>
                                    <th ng-click="sortData('Parent_Name_Hi')">
                                        {{translation.ParentMenuNameHi}}
                                        <div ng-class="getSortClass('Parent_Name_Hi')"></div>
                                    </th>
                                    <th ng-click="sortData('MenuNameEn')">
                                        {{translation.MenuNameEn}}
                                        <div ng-class="getSortClass('MenuNameEn')"></div>
                                    </th>
                                    <th ng-click="sortData('MenuNameHi')">
                                        {{translation.MenuNameHi}}
                                        <div ng-class="getSortClass('MenuNameHi')"></div>
                                    </th>
                                    <th ng-click="sortData('MenuNameHi')">
                                        {{translation.MenueAction}}
                                        <div ng-class="getSortClass('MenuNameHi')"></div>
                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="AllMenu in AssignMoreRights | filter: AllMenu.MenuId | orderBy:colsort:reverseSort | itemsPerPage: 400">                                                                      
                                    <td>{{$index+1}}</td>
                                    @*<td>{{pageSize *(currentPage-1)+$index+1}}</td>*@
                                    <td align="center">
                                        <input type="checkbox" name="{{AllMenu.MenuId}}" ng-checked="AllMenu.MenuIdChecked == 1" ng-model="AllMenu.Checked" ng-change="optionToggled()" ng-click="SetUncheckStatus(AllMenu,AllMenu.MenuIdChecked,AllMenu.Checked)" />

                                    </td>
                                    <td>{{ AllMenu.Parent_Name_En | uppercase }}</td>
                                    <td>{{ AllMenu.Parent_Name_Hi | uppercase }}</td>
                                    <td>{{ AllMenu.MenuNameEn | uppercase }}</td>
                                    <td>{{ AllMenu.MenuNameHi | uppercase }}</td>
                                    <td>

                                        <div ng-repeat="item in AllMenu.MenuActionList">

                                            <input type="checkbox" name="Actionchecked{{item.Key}}" ng-model="item.RoleMenuActionCheck" ng-checked="item.RoleMenuActionCheck" value="item.Key" /> {{item.Value}}

                                        </div>


                                    </td>


                                </tr>


                            </tbody>
                        </table>
                    </div>

                </div>




                <div class="col-md-12">
                    <div class="dev-align-btn">
                        <button type="button" class="btn btn-primary dev-btn" ng-click="SaveAssignMoreRights()" style="margin-right:15px;">{{translation.AssignMoreRights}}</button>
                        <button type="button" class="btn btn-primary dev-btn" ng-click="ClearAssignMoreRightsForm()">{{translation.Clear}}</button>
                    </div>
                </div>





            </div>

        </div>

    </div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>


