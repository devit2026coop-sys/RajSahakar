<script src="~/Scripts/AngularFramework/Index.js"></script>
<script src="~/Scripts/zingchart.min.js"></script>
<script src="~/Scripts/zingchart-angularjs.js"></script>
<script src="~/Scripts/canvasjs.min.js"></script>
<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="~/Scripts/AngularFramework/ng-google-chart.min.js"></script>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.5/jspdf.min.js"></script>
<script>
window.onload = function () {

var chart = new CanvasJS.Chart("chartContainer", {
	animationEnabled: true,
	theme: "light2", // "light1", "dark1", "dark2"
	exportEnabled: true,
	title: {
		text: ""
	},
	data: [{
		type: "column",
		dataPoints:  @Html.Raw(ViewBag.DataPoints),
	}]
});
chart.render();

}
</script>
<style>
    a.canvasjs-chart-credit {
        display: none;
    }
</style>
<div ng-app="Indexmod">
    <div ng-controller="IndexCont">
        <style>
            .board .panel {
                padding: 15px 40px;
                border: none;
                background: #fff;
            }

            .panel-primary {
                display: inline-block;
                margin-bottom: 30px;
                width: 100%;
            }

            /*.panel {
                border-radius: 0px;
            }*/

            .panel-primary {
                border-color: #337ab7;
            }

            .panel {
                margin-bottom: 20px;
                background-color: #fff;
                border: 1px solid transparent;
                border-radius: 4px;
                -webkit-box-shadow: 0 1px 1px rgba(0,0,0,.05);
                box-shadow: 0 1px 1px rgba(0,0,0,.05);
            }

            .board .number {
                float: left;
            }

            .number h3 {
                font-size: 32px;
                color: #676767;
            }

            .number small {
                font-size: 16px;
                font-weight: 600;
                text-transform: uppercase;
                margin: 8px 5px;
                display: inline-block;
            }

            .board .icon {
                float: right;
            }

            .board .panel .icon .fa {
                font-size: 35px;
                color: #FFFFFF;
                background: #30A5FF;
                padding: 35px;
                border-radius: 50%;
            }

            .dred {
                background: linear-gradient(60deg,#ffa726,#fb8c00) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(255,152,0,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(255,152,0,.4);
            }

            .red-txt {
                color: #f29918;
            }

            .green {
                background: linear-gradient(60deg,#66bb6a,#43a047) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(76,175,80,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(76,175,80,.4);
            }

            .green-txt {
                color: #5ab360;
            }

            .blue {
                background: linear-gradient(60deg,#ef5350,#e53935) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(244,67,54,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(244,67,54,.4);
            }

            .blue-txt {
                color: #e94442;
            }

            .sky {
                background: linear-gradient(60deg,#26c6da,#00acc1) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(0,188,212,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(0,188,212,.4);
            }

            .sky-txt {
                color: #53c0d4;
            }

            .lyt-green {
                background: linear-gradient(60deg,#dd70d4,#bd29e5) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(244, 166, 248);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(244, 166, 248);
            }

            .lyt-green-txt {
                color: #c43ae1;
            }

            .dark-blue {
                background: linear-gradient(60deg,#4208f4,#6354d3) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(148, 124, 240);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(148, 124, 240);
            }

            .dark-blue-txt {
                color: #4920ec;
            }

            .red1:hover .panel {
                background: #f1930f;
                transition: 0.5s all;
            }

            .red1:hover .red-txt, .red1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .red1:hover .dred {
                background: #fff !important;
                transition: 0.5s all;
            }

            .red1:hover .icon .fa {
                color: #f1930f;
                transition: 0.5s all;
            }

            .green1:hover .panel {
                background: #66bb6a;
                transition: 0.5s all;
            }

            .green1:hover .green-txt, .green1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .green1:hover .green {
                background: #fff !important;
                transition: 0.5s all;
            }

            .green1:hover .icon .fa {
                color: #66bb6a;
                transition: 0.5s all;
            }

            .blue1:hover .panel {
                background: #ef5350;
                transition: 0.5s all;
            }

            .blue1:hover .blue-txt, .blue1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .blue1:hover .blue {
                background: #fff !important;
                transition: 0.5s all;
            }

            .blue1:hover .icon .fa {
                color: #ef5350;
                transition: 0.5s all;
            }

            .sky1:hover .panel {
                background: #26c6da;
                transition: 0.5s all;
            }

            .sky1:hover .sky-txt, .sky1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .sky1:hover .sky {
                background: #fff !important;
                transition: 0.5s all;
            }

            .sky1:hover .icon .fa {
                color: #26c6da;
                transition: 0.5s all;
            }

            .lyt-green1:hover .panel {
                background: #bd29e5;
                transition: 0.5s all;
            }

            .lyt-green1:hover .lyt-green-txt, .lyt-green1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .lyt-green1:hover .lyt-green {
                background: #fff !important;
                transition: 0.5s all;
            }

            .lyt-green1:hover .icon .fa {
                color: #bd29e5;
                transition: 0.5s all;
            }

            .dark-blue1:hover .panel {
                background: #4208f4;
                transition: 0.5s all;
            }

            .dark-blue1:hover .dark-blue-txt, .dark-blue1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .dark-blue1:hover .dark-blue {
                background: #fff !important;
                transition: 0.5s all;
            }

            .dark-blue1:hover .icon .fa {
                color: #4208f4;
                transition: 0.5s all;
            }
        </style>

        <!-- start main-content -->
        <div class="row">
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="card card-stats">
                    <div class="card-header card-header-warning card-header-icon">
                        <div class="card-icon">
                            <i class="material-icons Sports"></i>
                        </div>
                        <p class="card-category">{{translation.ACT2005}}</p>
                        <h3 class="card-title">
                            <label>{{ACT2005}}</label>
                            @*<small>GB</small>*@
                        </h3>
                    </div>
                   
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="card card-stats">
                    <div class="card-header card-header-success card-header-icon">
                        <div class="card-icon">
                            <i class="material-icons fa fa-tasks"></i>
                        </div>
                        <p class="card-category">{{translation.ACT1958}}</p>
                        <h3 class="card-title">
                            <label>
                                <label>{{ACT1958}}</label>
                            </label>
                        </h3>
                    </div>                   
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="card card-stats">
                    <div class="card-header card-header-danger card-header-icon">
                        <div class="card-icon">
                            <i class="material-icons fa fa-thumbs-up"></i>
                        </div>
                        <p class="card-category">{{translation.ACT2001}}</p>
                        <h3 class="card-title">
                            <label>{{ACT2001}}</label>
                        </h3>
                    </div>
                </div>
            </div> 

            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="card card-stats">
                    <div class="card-header card-header-info card-header-icon">
                        <div class="card-icon">
                            <i class="material-icons fa fa-external-link "></i>
                        </div>
                        <p class="card-category">{{translation.Total}}</p>
                        <h3 class="card-title">
                            <label>{{TOTAL}}</label>
                        </h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header card-header-warning">{{translation.SocietyTasksPanel}}</div>
                    <div class="card-image">
                        <div class="collection">
                            <a href="#!" class="collection-item">Society<span class="new badge2" ng-model="RegisteredSociety">{{Society}} | {{SocietyApprove}} | {{SocietyNotApprove}}</span></a>
                            <a href="#!" class="collection-item">Society Inspections<span class="new badge2 red" data-badge-caption="" ng-model="SUBMITTED">{{SocietyInspectionsAppr}} | {{SocietyInspectionsNotAppr}}</span></a>
                            <a href="#!" class="collection-item">Society Audit<span class="new badge2" data-badge-caption="" ng-model="PartialSubmit">{{SocietyAuditAppr}} | {{SocietyAuditNotAppr}}</span></a>
                            <a href="#!" class="collection-item">Society Election<span class="new badge2 brown" data-badge-caption="" ng-model="UNDERPROCESS">{{SocietyElectionAppr}} | {{SocietyElectionNotAppr}}</span></a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header card-header-warning">{{translation.SocietyStatustaskpenal}}</div>
                    <div class="card-image">
                        <div class="collection">
                            <a href="../ApplicationFlow/ApplicationFlow?StatusID=TS" class="collection-item">{{translation.TotalSociety}}<span class="new badge2" ng-model="RegisteredSociety">{{TOTAL}}</span></a>
                            <a href="#" class="collection-item">Online Total Appli<span class="new badge2 blue" ng-model="OnlineTotalAppli">{{OnlineTotalAppli}}</span></a>
                            <a href="#" class="collection-item">Offline Total Appli<span class="new badge2 blue" ng-model="OfflineTotalAppli">{{OfflineTotalAppli}}</span></a>
                            <a href="#" class="collection-item">Online Regi Appli<span class="new badge2 blue" ng-model="OnlineRegiAppli">{{OnlineRegiAppli}}</span></a>
                            <a href="#" class="collection-item">Offline Regi Appli<span class="new badge2 blue" ng-model="OfflineRegiAppli">{{OfflineRegiAppli}}</span></a>
                            <a href="../ApplicationFlow/ApplicationFlow?StatusID=RS" class="collection-item">{{translation.RegisteredSociety}}<span class="new badge2 red" data-badge-caption="" ng-model="APPROVED">{{APPROVED}}</span></a>
                            <a href="../ApplicationFlow/ApplicationFlow?StatusID=PS" class="collection-item">{{translation.PartialSubmit}}<span class="badge2" data-badge-caption="" ng-model="PartialSubmit">{{PartialSubmit}}</span></a>
                            <a href="../ApplicationFlow/ApplicationFlow?StatusID=UP" class="collection-item">{{translation.UnderProcess}}<span class="new badge2 brown" data-badge-caption="" ng-model="UNDERPROCESS">{{UNDERPROCESS}}</span></a>
                            <a href="../ApplicationFlow/ApplicationFlow?StatusID=PP" class="collection-item">{{translation.PandingforPayment}}<span class="new badge2 green" ng-model="PandingforPayment">{{PandingforPayment}}</span></a>
                            <a href="../ApplicationFlow/ApplicationFlow?StatusID=RejS" class="collection-item">{{translation.RejectedSociety}}<span class="new badge2 blue" ng-model="RejectedSociety">{{REJECTED}}</span></a>

                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header card-header-warning"> {{translation.SocietyCountTypesWise}}</div>
                    <div class="card-image">
                        <div id="chartContainer" style="height: 266px; width: 100%;"></div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header card-header-warning"> {{translation.SocietyStatusGraph}}</div>
                    <div class="card-image2">
                        <div style="height: 300px; width: 100%;" id="divChart1">
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="se-pre-con"></div>
            <div id="stop" class="scrollTop">
                <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
            </div>
        </div>
        <!-- end main-content -->
    </div>

</div>
