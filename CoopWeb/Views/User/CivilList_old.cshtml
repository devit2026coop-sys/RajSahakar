<script src="~/Scripts/AngularFramework/CivilList.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />
<script>
    $(function () {
        $(".datePick").click(function () {
            $(this).val("");
        });
        $(".datePick").datepicker({
            changeMonth: true,
            changeYear: true
        });
    });
    $(function () {
        $('body').on('focus', ".datePick", function () {
            $(this).datepicker({
                changeMonth: true,
                changeYear: true
            });
        });
    });
    function js_DatePickers(elem) {
        $(elem).datepicker({
            changeMonth: true,
            changeYear: true
        });
    }
</script>
<style>
    .form-group {
        border: 0px !important;
    }
</style>
<div ng-app="IndexModule">
    <div ng-controller="IndexCont">
        <div id="skip-content">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="devpage-breadcrumb">
                    <ul class="page-breadcrumb">
                        <li class="dev-page-br">
                            <i class="fa fa-home"> </i>
                            <a href="#">Admin</a>
                            <i class="fa fa-angle-right"></i>
                        </li>
                        <li style="float: left">
                            <span style="margin: 0 5px;">CivilList</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <form class="citizen-dash-head">
                    <div class="dev-search-form">
                        <div class="panel panel-warning" style="color:black">
                            <div style="color:black" class="heading-hr ng-binding">
                                <b>BIODATA OF OFFICERS OF RAJASTHAN COOPERATIVE SERVICES</b>
                            </div>
                            <div class="panel-body form-horizontal civilFormBox" style="padding-top:30px;padding-bottom:30px;">
                                <input type="hidden" value="0" ng-model="BiodataListId" />
                                <div class="row">

                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Name Title</label>
                                        <div class="col-md-8">
                                            <input type="text" ng-model="NameTitle" placeholder="SHRI/SMT./MR./MS." class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">First Name</label>
                                        <div class="col-md-8">
                                            <input type="text" ng-model="FirstName" placeholder="Enter First Name" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Last Name</label>
                                        <div class="col-md-8">
                                            <input type="text" ng-model="LastName" placeholder="Enter Last Name" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Officer's Type</label>
                                        <div class="col-md-8">
                                            <select class="form-control" ng-model="OfficerType">
                                                <option value="">{{translation.SelectOption}}</option>
                                                <option ng-repeat="items in GetCivilOfficerTypeData" value="{{items.OfficerTypeId}}">
                                                    {{items.OfficerTypeName}}
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">DOB</label>
                                        <div class="col-md-8">
                                            <input type="text" id="DateOfBirth" placeholder="Enter Date Of Birth" ng-model="DateOfBirth" class="form-control datePick">
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">DOJ</label>
                                        <div class="col-md-8">
                                            <input type="text" id="DateOfJoining" placeholder="Enter Date Of Joining" ng-model="DateOfJoining" class="form-control datePick">
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">DOR</label>
                                        <div class="col-md-8">
                                            <input type="text" id="DateOfRetirement" placeholder="Enter Date Of Retirement" ng-model="DateOfRetirement" class="form-control datePick">
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Title</label>
                                        <div class="col-md-8">
                                            <input type="text" ng-model="Title" placeholder="Enter Title" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Home District</label>
                                        <div class="col-md-8">
                                            <select class="form-control" id="HomeDistrict" ng-model="HomeDistrict">
                                                <option value="">{{translation.SelectOption}}</option>
                                                <option ng-repeat="items in GetDistrictListData" value="{{items.DISTRICT_ENG}}">
                                                    {{items.DISTRICT_ENG}}
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Qualification</label>
                                        <div class="col-md-8">
                                            <input type="text" ng-model="Qualification" placeholder="Enter Qualification" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Post Name</label>
                                        <div class="col-md-8">
                                            <input type="text" ng-model="PostName" placeholder="Enter Post Name" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Present Posting</label>
                                        <div class="col-md-8">
                                            <input type="text" ng-model="PresentPosting" placeholder="Enter Present Posting" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">From Date</label>
                                        <div class="col-md-8">
                                            <input type="text" id="FromDate" ng-model="FromDate" placeholder="Enter Date" class="form-control datePick">
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Officer Photo</label>
                                        <div class="col-md-8">
                                            <input type="file" name="OfficerImage" filetype="Upload" accept="image/*" id="OfficerImage" class="form-control" ng-model="OfficerImage">
                                            <a href="{{OfficerImage}}" target="_blank">{{OfficerImage}}</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label col-md-4">Add History</label>
                                    <div class="col-md-8">
                                        <input type="radio" ng-model="Addhistory" value="1" />Yes
                                        <input type="radio" ng-model="Addhistory" value="0" />No
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 form-group panel-body form-horizontal civilFormBox" ng-show="Addhistory ==1">
                                <table id="Civillisthistory" class="table table-bordered mb-0 table-responsive devtable">
                                    <thead>
                                        <tr>
                                            <th><label> District</label></th>
                                            <th><label> Joing Date </label></th>
                                            <th><label> Reliving Date</label></th>
                                            <th><label> Post Name</label></th>
                                            <th><label> &nbsp;</label></th>
                                            @*<th><label> &nbsp;</label></th>*@
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in TblCivilHisttoryDetails">

                                            <td>
                                                <select class="form-control"ng-model="item.District">
                                                    <option value="">{{translation.SelectOption}}</option>
                                                    <option ng-repeat="items in GetDistrictListData" value="{{items.DISTRICT_ENG}}">
                                                        {{items.DISTRICT_ENG}}
                                                    </option>
                                                </select>
                                            </td>
                                            <td><input type="text" onclick="js_DatePickers(this);" ng-model="item.JoingDateCivilList" placeholder="Enter Joing Date" class="form-control datePick"/></td>
                                            <td><input type="text" onclick="js_DatePickers(this);" ng-model="item.RelivingDateCivilList" placeholder="Enter Reliving Date" class="form-control datePick"/></td>
                                            <td><input type="text"  placeholder="Post Name" class="form-control" ng-model="item.PostName1"></td>                                          
                                            <td style="text-align:right">
                                                <input type="hidden" value={{item.BiodateOfOffihistoryID}} ng-model="item.BiodateOfOffihistoryID">
                                                <button class="btn btn-primary dev-btn" ng-click="RemoveRow($index)">Remove Row</button>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="8" style="text-align:right;"><button type="button" class="btn btn-primary dev-btn" ng-click="AddMoreRow()">Add New Row</button></td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>
                            @*<div ng-show="Addhistory ==1" class="panel-body form-horizontal civilFormBox" style="padding-top:30px;padding-bottom:30px;">
                                <input type="hidden" value="0" ng-model="BiodateOfOffihistoryID" />
                                <div class="row">
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">District</label>
                                        <div class="col-md-8">
                                            <select class="form-control" id="District" ng-model="District">
                                                <option value="">{{translation.SelectOption}}</option>
                                                <option ng-repeat="items in GetDistrictListData" value="{{items.DISTRICT_ENG}}">
                                                    {{items.DISTRICT_ENG}}
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Joing Date</label>
                                        <div class="col-md-8">
                                            <input type="text" id="JoingDateCivilList" ng-model="JoingDateCivilList" placeholder="Enter Joing Date" class="form-control datePick" />

                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Reliving Date</label>
                                        <div class="col-md-8">
                                            <input type="text" id="RelivingDateCivilList" ng-model="RelivingDateCivilList" placeholder="Enter Joing Date" class="form-control datePick" />
                                        </div>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label class="control-label col-md-4">Post Name</label>
                                        <div class="col-md-8">
                                            <input type="text" id="PostName" filetype="text" name="Post Name" placeholder="Post Name" class="form-control" ng-model="PostName1">
                                        </div>
                                    </div>

                                </div>
                            </div>*@

                            <div class="panel-footer">
                                <div class="row">
                                    <div class="col-sm-12 text-right">
                                        <button type="reset" class="btn btn-primary dev-btn" ng-click="RestCivilList()"><i class="fa fa-refresh"></i>&nbsp;Reset</button>
                                        <button type="button" class="btn btn-primary dev-btn" ng-click="SaveCivilList()"><i class="fa fa-check"></i>&nbsp;Save</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div style="color:black" class="heading-hr ng-binding">
                            <b>Officer List</b>
                        </div>
                        <div class="citizen-dash-head">
                            <div class="col-lg-12">
                                <div>
                                    <table class="table table-responsive devtable">
                                        <thead>
                                            <tr>
                                                <th width="70">Sr. No.</th>
                                                <th>Officer Name/Title/Type</th>
                                                <th class="text-center">Date of Birth</th>
                                                <th class="text-center">Date of Joining</th>
                                                <th class="text-center">Date of Retirement</th>
                                                <th>Home District</th>
                                                <th>Qualification</th>
                                                <th>Post Name</th>
                                                <th>Present Posting</th>
                                                <th class="text-center">From Date</th>
                                                <th>Action</th>
                                                <th>Delete</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr dir-paginate="items in GetOfficerCivilList | filter:q | itemsPerPage: pageSize" current-page="currentPage" pagination-id="statePagination">
                                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                                <td>
                                                    <div class="flex flexMiddel CivilOfficerPhotoBox">
                                                        <img src="~/Content/CivilOfficerPhoto/{{items.OfficerImage}}" class="CivilOfficerPhoto" />
                                                        <div class="CivilOfficerContent">
                                                            <p>{{items.NameTitle}}&nbsp;{{items.FirstName}}&nbsp;{{items.LastName}}</p>
                                                            <span><b>{{items.Title}}</b> - {{items.officerNames}}</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center">{{items.DateOfBirth}}</td>
                                                <td class="text-center">{{items.DateOfJoining}}</td>
                                                <td class="text-center">{{items.DateOfRetirement}}</td>
                                                <td>{{items.HomeDistrict}}</td>
                                                <td>{{items.Qualification}}</td>
                                                <td>{{items.PostName}}</td>
                                                <td>{{items.POSTINGOFF_NAME}}&nbsp;-&nbsp;{{items.PresentPosting}}</td>
                                                <td class="text-center">{{items.FromDate}}</td>
                                                <td>
                                                    <a href="javascript:void(0);" ng-click="EditCivilList(items.BiodataListId)" class="btn btn-default btn-xs"><i class="fa fa-edit"></i></a>
                                                </td>
                                                <td>
                                                    <a href="javascript:void(0);" ng-click="DeleteCivilList(items.BiodataListId)" class="btn btn-default btn-xs"><i class="fa fa-trash-o"></i></a>
                                                </td>
                                            </tr>
                                            <tr ng-if="GetOfficerCivilList.length==0">
                                                <td colspan="13" class="text-center">
                                                    No record Found!
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <div class="col-md-12">
                                <div class="text-center">
                                    <dir-pagination-controls boundary-links="true" pagination-id="statePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

            </div>

            <div id="ErroBox" class="modal fade" role="dialog">
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                            <h4 class="modal-title">Form Error</h4>
                        </div>
                        <div class="modal-body">

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


