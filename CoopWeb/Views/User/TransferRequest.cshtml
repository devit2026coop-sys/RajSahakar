

    <script src="~/Scripts/AngularFramework/TransferRequest.js"></script>

    <div ng-app="TransferRequestMod" ng-controller="TransferRequestCnt">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">{{translation.UserRole}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.UserRole}}</span>
                    </li>
                    

                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
         
                        <table class="table dev-table" style="margin-top: 30px;">
                            <caption>
                                <h3>{{translation.TransferRequestList}} :  </h3>
                            </caption>
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th>
                                        {{translation.DepartmentHeading}}
                                    </th>
                                    <th>
                                        {{translation.RoleHeading}}
                                    </th>
                                    <th>
                                        {{translation.Unit}}
                                    </th>
                                    <th>
                                        {{translation.Level}}
                                    </th>
                                    <th>
                                        {{translation.DesignationHeading}}
                                    </th>
                                    <th>
                                        {{translation.Division}}
                                    </th>
                                    <th>
                                        {{translation.PostHeading}}
                                    </th>
                                    <th>
                                        {{translation.District}}
                                    </th>
                                    <th>
                                        Action
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="items in TransferRequestData">
                                    <td>{{$index+1}}</td>
                                    <td>{{ items.DEPTNAMEENGLISH }}</td>
                                    <td>{{ items.RoleName_EN }}</td>
                                    <td>{{ items.UnitNameEn }}</td>
                                    <td>{{ items.LevelNameEn }}</td>
                                    <td>{{ items.DESIGNATIONDESCENGLISH }}</td>
                                    <td>{{ items.DIVISION_ENG }}</td>
                                    <td>{{ items.CAD_NAME }}</td>
                                    <td>{{ items.DISTRICT_ENG }}</td>
                                    <td>
                                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" ng-click="AddRoleClick(items.MappingID)" data-toggle="modal" data-target="#myModal"> <h5>&#187; View Details</h5> </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="dev-popup-body modal fade" id="myModal" role="dialog">
                    <div class="modal-dialog">
                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" id="btnClose" data-dismiss="modal">&times;</button>
                                <h4 class="modal-title">Transfer Request Details </h4>
                            </div>
                            <div class="modal-body">

                                <form class="dev-search-form" name="MyRoleForm" style="overflow: hidden;">

                                    <div class="bottom-padding"></div>

                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <div class="se-pre-con"></div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>

</div>