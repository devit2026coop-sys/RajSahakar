<!-- start main-content -->
<div class="row">
    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-warning card-header-icon">
                <div class="card-icon">
                    <i class="material-icons fa fa-glass"></i>
                </div>
                <p class="card-category">Used Space</p>
                <h3 class="card-title">
                    49/50
                    <small>GB</small>
                </h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons fa fa-users"></i>
                    Get More Space
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-success card-header-icon">
                <div class="card-icon">
                    <i class="material-icons fa fa-tasks"></i>
                </div>
                <p class="card-category">Revenue</p>
                <h3 class="card-title">
                    ₹ 5,225
                </h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons fa fa-calendar"></i>
                    Last 24 Hours
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-danger card-header-icon">
                <div class="card-icon">
                    <i class="material-icons fa fa-thumbs-up"></i>
                </div>
                <p class="card-category">Fixed Issues</p>
                <h3 class="card-title">
                    55
                </h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons fa fa-tag"></i>
                    Tracked from Github
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-info card-header-icon">
                <div class="card-icon">
                    <i class="material-icons fa fa-external-link "></i>
                </div>
                <p class="card-category">Followers</p>
                <h3 class="card-title">
                    +450
                </h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons fa fa-clock-o"></i>
                    Just Updated
                </div>
            </div>
        </div>
    </div>
</div>

