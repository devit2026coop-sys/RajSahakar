<div ng-app="SocietyIndexmod">
    <div ng-controller="SocietyIndexCont">
        <style>
            .board .panel {
                padding: 15px 40px;
                border: none;
                background: #fff;
            }

            .panel-primary {
                display: inline-block;
                margin-bottom: 30px;
                width: 100%;
            }

            /*.panel {
                border-radius: 0px;
            }*/

            .panel-primary {
                border-color: #337ab7;
            }

            .panel {
                margin-bottom: 20px;
                background-color: #fff;
                border: 1px solid transparent;
                border-radius: 4px;
                -webkit-box-shadow: 0 1px 1px rgba(0,0,0,.05);
                box-shadow: 0 1px 1px rgba(0,0,0,.05);
            }

            .board .number {
                float: left;
            }

            .number h3 {
                font-size: 32px;
                color: #676767;
            }

            .number small {
                font-size: 16px;
                font-weight: 600;
                text-transform: uppercase;
                margin: 8px 5px;
                display: inline-block;
            }

            .board .icon {
                float: right;
            }

            .board .panel .icon .fa {
                font-size: 35px;
                color: #FFFFFF;
                background: #30A5FF;
                padding: 35px;
                border-radius: 50%;
            }

            .dred {
                background: linear-gradient(60deg,#ffa726,#fb8c00) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(255,152,0,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(255,152,0,.4);
            }

            .red-txt {
                color: #f29918;
            }

            .green {
                background: linear-gradient(60deg,#66bb6a,#43a047) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(76,175,80,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(76,175,80,.4);
            }

            .green-txt {
                color: #5ab360;
            }

            .blue {
                background: linear-gradient(60deg,#ef5350,#e53935) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(244,67,54,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(244,67,54,.4);
            }

            .blue-txt {
                color: #e94442;
            }

            .sky {
                background: linear-gradient(60deg,#26c6da,#00acc1) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(0,188,212,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(0,188,212,.4);
            }

            .sky-txt {
                color: #53c0d4;
            }

            .lyt-green {
                background: linear-gradient(60deg,#dd70d4,#bd29e5) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(244, 166, 248);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(244, 166, 248);
            }

            .lyt-green-txt {
                color: #c43ae1;
            }

            .dark-blue {
                background: linear-gradient(60deg,#4208f4,#6354d3) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(148, 124, 240);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(148, 124, 240);
            }

            .dark-blue-txt {
                color: #4920ec;
            }

            .red1:hover .panel {
                background: #f1930f;
                transition: 0.5s all;
            }

            .red1:hover .red-txt, .red1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .red1:hover .dred {
                background: #fff !important;
                transition: 0.5s all;
            }

            .red1:hover .icon .fa {
                color: #f1930f;
                transition: 0.5s all;
            }

            .green1:hover .panel {
                background: #66bb6a;
                transition: 0.5s all;
            }

            .green1:hover .green-txt, .green1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .green1:hover .green {
                background: #fff !important;
                transition: 0.5s all;
            }

            .green1:hover .icon .fa {
                color: #66bb6a;
                transition: 0.5s all;
            }

            .blue1:hover .panel {
                background: #ef5350;
                transition: 0.5s all;
            }

            .blue1:hover .blue-txt, .blue1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .blue1:hover .blue {
                background: #fff !important;
                transition: 0.5s all;
            }

            .blue1:hover .icon .fa {
                color: #ef5350;
                transition: 0.5s all;
            }

            .sky1:hover .panel {
                background: #26c6da;
                transition: 0.5s all;
            }

            .sky1:hover .sky-txt, .sky1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .sky1:hover .sky {
                background: #fff !important;
                transition: 0.5s all;
            }

            .sky1:hover .icon .fa {
                color: #26c6da;
                transition: 0.5s all;
            }

            .lyt-green1:hover .panel {
                background: #bd29e5;
                transition: 0.5s all;
            }

            .lyt-green1:hover .lyt-green-txt, .lyt-green1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .lyt-green1:hover .lyt-green {
                background: #fff !important;
                transition: 0.5s all;
            }

            .lyt-green1:hover .icon .fa {
                color: #bd29e5;
                transition: 0.5s all;
            }

            .dark-blue1:hover .panel {
                background: #4208f4;
                transition: 0.5s all;
            }

            .dark-blue1:hover .dark-blue-txt, .dark-blue1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .dark-blue1:hover .dark-blue {
                background: #fff !important;
                transition: 0.5s all;
            }

            .dark-blue1:hover .icon .fa {
                color: #4208f4;
                transition: 0.5s all;
            }
        </style>

