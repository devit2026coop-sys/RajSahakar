                                        <td>{{item.SocietyName}}</td>
                                        <td>{{item.SocietyAddress}}</td>
                                        <td>{{item.ServiceName}}</td>
                                        <td>{{item.CEO}}</td>
                                        <td>{{item.CEOContactNo}}</td>
                                        <td>{{item.District}}</td>
                                        <td>{{item.ssoid}}</td>
                                        <td>{{item.UploadedByExcel}}</td>
                                        <td>{{item.Department}}</td>
                                        <td>{{item.ApplicationNo}}</td>
                                        <td>{{item.SubmissionDate}}</td>
                                        <td>{{item.Status}}</td>
                                        <td ng-if="item.CertificateFile!=''"><a target="_blank" href="/Content/SocietyProfiling/{{item.CertificateFile}}"><i class="fa fa-download"></i></a></td>
                                        <td ng-if="item.BankOpeningCertificate!=''"><a target="_blank" href="/Content/SocietyProfiling/{{item.BankOpeningCertificate}}"><i class="fa fa-download"></i></a></td>
                                        <td ng-if="item.BylawsFile!=''"><a target="_blank" href="/Content/SocietyProfiling/{{item.BylawsFile}}"><i class="fa fa-download"></i></a></td>
                                        <td ng-if="item.RulesRegulationFile!=''"><a target="_blank" href="/Content/SocietyProfiling/{{item.RulesRegulationFile}}"><i class="fa fa-download"></i></a></td>
                                        <td><a href="#!" ng-click="Societyapplicationview(item.SocietyIDInc)"><i class="fa fa-eye"></i></a></td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>

                    </div>
                </div>
            </div>
        </div>


    </div>
    <!-- end main-content -->
</div>

