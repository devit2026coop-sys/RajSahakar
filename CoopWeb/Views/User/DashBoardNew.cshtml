<div ng-app="myApp" ng-controller="myController">
    <div class="coop_drop">
        <input type="hidden" id="DivisionId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DivisionId)" />
        <input type="hidden" id="hdnActId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).ActId)" />
        <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />

        <p class="card-title" onclick="tooltip.pop(this, '#tip32');">
            <div class="col-md-3 dashFilter" style="display:none;">
                <select ng-model="SocietyRegistration.DIVISION_ID" id="ddlDivision" name="division" ng-change="GetSocietyDistrictList()" class="form-control" ng-init="SocietyRegistration.DIVISION_ID ='0'">
                    <option value="0">{{translation.Division}}</option>
                    <option ng-repeat="itemDivs in Divisions" value="{{itemDivs.DIVISION_ID}}">
                        {{_language =='en-us' ?  itemDivs.DIVISION_ENG : itemDivs.DIVISION_MANGAL}}
                    </option>
                </select>
            </div>

            <div class="col-md-3 dashFilter" style="display:none;">
                <select ng-model="SocietyRegistration.DISTRICT_ID" id="ddlDistrict" class="form-control" ng-init="SocietyRegistration.DISTRICT_ID='0'" ng-change="GetNewdashboard()">
                    <option value="0">{{translation.District}}</option>
                    <option ng-repeat="itemDist in DistrictList | orderBy:'DISTRICT_ENG'" value="{{itemDist.DISTRICT_ID}}">
                        {{_language =='en-us' ?  itemDist.DISTRICT_ENG : itemDist.DISTRICT_MANGAL}}
                    </option>
                </select>
            </div>
            <div class="col-md-3 dashFilter search-container">

                <input type="text" id="txtSearch" name="RegistrationNo" class="form-control search" placeholder="Search {{translation.SocietyRegistrationNo}}" style="width: 100%;
color: #000;
background-color: #ffffff;
border: 1px solid #d9e2e8;
padding: 7px;
border-radius: 10px;
box-shadow: 0 1px 5px 0 rgba(0,0,0,.1);
height: 45px;float: left;">
                <button type="submit" ng-click="GetCertificate()" style="float: left;
padding: 6px 10px;
margin-left: -37px;
background: #d7d7d7;
font-size: 17px;
border: none;
cursor: pointer;
height: 45px;
border-radius: 0px 10px 10px 0px;">
                    <i class="fa fa-search"></i>
                </button>

            </div>

            <div class="clearfix"></div>
        </p>

        <div>
        </div>

    </div>

    <div class="dev-popup-body modal fade" id="addModal" data-backdrop="static" data-keyboard="false" role="dialog">
        <div class="modal-dialog" style="width: 50%;">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <div class="col-md-12 margin-Top20 text-center">
                        <lable style="color:black;"><b>Application Status</b></lable>
                    </div>
                </div>
                <div class="modal-body">
                    <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OfficeForm">

                        <table id="tblData" class="table devtable " style="margin-top: 10px;border:1px solid rgb(222, 221, 221); float: left;color: black;">
                            <thead>
                                <tr>
                                    <th class="info_news_slh_table_fix">Sr No.</th>
                                    <th style="min-width: 96px;">Society Name</th>
                                    <th style="min-width: 200px;">Act</th>
                                    <th style="text-align: center">Registration No/App Id</th>
                                    @*
                                        <th style="text-align: center">Submission Date</th>*@
                                    <th style="min-width: 95px;">Current Status</th>

                                    @*
                                        <th ng-if="CertificateList[0].CertificateFile!=''">Registration Certificate</th>
                                        <th ng-if="CertificateList[0].BankOpeningCertificate!=''">Bank Account Open Certificate</th>*@
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in CertificateList">
                                    <td>{{$index+1}}</td>
                                    <td>{{item.SocietyName}}</td>
                                    <td>{{item.ServiceName}}</td>
                                    <td>{{item.ApplicationNo}}</td>
                                    @*
                                        <td>{{item.SubmissionDate}}</td>*@
                                    <td>{{item.Status}}</td>


                                    @*
                                        <td ng-if="item.CertificateFile!=''"><a target="_blank" href="~/Content/SocietyProfiling/{{item.CertificateFile}}"><i class="fa fa-download"></i></a></td>
                                        <td ng-if="item.BankOpeningCertificate!=''"><a target="_blank" href="~/Content/SocietyProfiling/{{item.BankOpeningCertificate}}"><i class="fa fa-download"></i></a></td>*@
                                </tr>
                            </tbody>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>

