
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; ;
}

<script src="~/Scripts/AngularFramework/UserPermission.js?id=1"></script>


<div ng-app="MoveFileModule">
    <div ng-controller="MoveFileCont">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">DIRECTORY Move and Copy</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> Directory  </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <form class="dev-search-form citizen-dash-head " style="overflow: hidden;" name="Myauditform">
                <div class="col-lg-12 form-group">
                    <div class="col-md-12">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

                            <div class="col-lg-12 form-group">
                                <div class="col-lg-2">Menu Name<span class="error">*</span></div>
                                <div class="col-lg-4">
                                    <input type="text" name="SourceDirectory" class="form-control" id="SourceDirectoryName" ng-model="permissions.SourceDirName" placeholder="Menu Name" autocomplete="off">
                                    <label><input type="checkbox" ng-model="permissions.Read" title="Read">Read</label>
                                    <label><input type="checkbox" ng-model="permissions.Write" title="Write">Write </label>
                                    <label><input type="checkbox" ng-model="permissions.Modify" title="Modify">Modify</label>
                                    <label><input type="checkbox" ng-model="permissions.FullAccess" ng-change="updateFullAccess(permissions.FullAccess)" title="Full Access">Full Access</label>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="form-group">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary" ng-click="submitPermissions(1)">Add</button>           
                            <button type="submit" class="btn btn-primary" ng-click="submitPermissions(0)">Remove</button>           
                        </div>
                    </div>
                </div>



            </form>



        </div>

    </div>
</div>
