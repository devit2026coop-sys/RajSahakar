                        <div class="">
                            <div class="col-md-12">
                                <div class="citizen-dash-head" style="overflow: hidden;">
                                    <div class="table-dropdown">
                                        <div class="col-xs-4">
                                            <label for="search">{{translation.Search}}:</label>
                                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                                        </div>
                                        <div class="col-xs-4">
                                            <label for="search">{{translation.ItemPerPage}}:</label>
                                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                                        </div><div class="col-md-4">
                                            <label>
                                                {{translation.DepartmentHeading}} :
                                            </label>

                                            <select ng-model="UserRegistrationSearch.DepartmentId" class="form-control" ng-init="UserRegistrationSearch.DepartmentId='0'" ng-change="GetOrganisations()">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item in Departments" value="{{item.ID}}">
                                                    {{_language =='en-us' ?  item.DEPTNAMEENGLISH : item.DEPTNAMEHINDI}}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label>
                                                {{translation.Organisation}} :
                                            </label>
                                            <select ng-model="UserRegistrationSearch.OrganisationId" class="form-control" ng-init="UserRegistrationSearch.OrganisationId='0'" ng-change="GetLevels()">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item in Organisations" value="{{item.OrganisationId}}">
                                                    {{_language =='en-us' ?  item.OrganisationNameEn : item.OrganisationNameHi}}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label>
                                                {{translation.Level}} :
                                            </label>
                                            <select ng-model="UserRegistrationSearch.OrganizationLevelsMappingID" class="form-control" ng-init="UserRegistrationSearch.OrganizationLevelsMappingID='0'" ng-change="GetOfficeList();GetRoleList()">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item in Levels" value="{{item.MappingID}}">
                                                    {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label>
                                                {{translation.Office}} :
                                            </label>
                                            <select ng-model="UserRegistrationSearch.OfficeId" class="form-control" ng-init="UserRegistrationSearch.OfficeId='0'" ng-change="GetRoleList()">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item in OfficeListData" value="{{item.OfficeId}}">
                                                    {{_language =='en-us' ?  item.OfficeNameEn : item.OfficeNameHi}}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label>
                                                {{translation.RoleHeading}} :
                                            </label>
                                            <select ng-model="UserRegistrationSearch.RoleId" class="form-control" ng-init="UserRegistrationSearch.RoleId='0'">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item in RoleListData" value="{{item.RoleID}}">
                                                    {{_language =='en-us' ?  item.RoleName_EN : item.RoleName_HI}}
                                                </option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <button type="submit" class="btn btn-primary" style="margin-top:10px;padding-top:10px" ng-click="ShowUserSearchList()">{{translation.Search}}</button>
                                        </div>
                                    </div>
                                    <table class="table table-responsive devtable">
                                        <thead>
                                            <tr>
                                                <th>
                                                    {{translation.SRNO}}
                                                </th>
                                                <th ng-click="sortData('SubClassNameEn')">
                                                    {{translation.OfficerNameEn}}
