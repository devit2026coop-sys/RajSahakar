
<script src="~/Scripts/AngularFramework/RoleRightsClient.js"></script>


<div ng-app="RoleRights">
    <div ng-controller="RoleRightsController">
        <div class="form-group clearfix">
            <label class="col-sm-3 control-label no-padding-right">Role Name</label>
            <div class="col-sm-9">

                <label class="col-sm-3 control-label no-padding-right">Role Name</label>
            </div>
        </div>
        <form class="dev-search-form">

            <div class="form-group">
                <label>Parent Menu </label>
                <select style="width:200px" ng-model="AllMenu.ParentId" data-val-required="Parent Menu field is required." ng-init="AllMenu.ParentId='0'">
                    <option value="0" disabled>{{translation.SelectMasterMenu}}</option>
                    <option ng-repeat="AllMenu in AllMenuList" ng-show="RoleRights.ParentId==0" value="{{AllMenu.ParentId}}">
                        {{AllMenu.MenuNameEn}}
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label>Menu Name </label>
                <select style="width:200px" ng-model="AllMenu.MenuId" data-val-required="Menu field is required.">
                    <option value="0" disabled>{{translation.SelectMasterMenu}}</option>
                    <option ng-repeat="AllMenu in AllMenuList" ng-show="AllMenu.MenuId<>0" value="{{AllMenu.MenuId}}">
                        {{AllMenu.MenuNameEn}}
                    </option>
                </select>
            </div>


        </form>
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table dev-table" style="margin-top: 30px;">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SrNo}}
                            </th>
                            <th align="center">
                                <input id="CheckAll" type="checkbox" />
                            </th>
                            <th ng-click="sortData('Parent_Name_En')">
                                {{translation.ParentMenuNameEn}}
                                <div ng-class="getSortClass('Parent_Name_En')"></div>
                            </th>
                            <th ng-click="sortData('Parent_Name_Hi')">
                                {{translation.ParentMenuNameHi}}
                                <div ng-class="getSortClass('Parent_Name_Hi')"></div>
                            </th>
                            <th ng-click="sortData('MenuNameEn')">
                                {{translation.MenuNameEn}}
                                <div ng-class="getSortClass('MenuNameEn')"></div>
                            </th>
                            <th ng-click="sortData('MenuNameHi')">
                                {{translation.MenuNameHi}}
                                <div ng-class="getSortClass('MenuNameHi')"></div>
                            </th>
                            <th ng-click="sortData('MenuNameHi')">
                                Actions
                                <div ng-class="getSortClass('MenuNameHi')"></div>
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        {{ABC}}
                        <tr dir-paginate="AllMenu in AllMenuList | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="RoleRightsPagination">


                            <td>{{ $index+1 }}</td>
                            <td align="center">
                                <input type="checkbox" ID="chkSelect" runat="server" />
                            </td>
                            <td>{{ AllMenu.Parent_Name_En | uppercase }}</td>
                            <td>{{ AllMenu.Parent_Name_Hi | uppercase }}</td>
                            <td>{{ AllMenu.MenuNameEn | uppercase }}</td>
                            <td>{{ AllMenu.MenuNameHi | uppercase }}</td>
                            <td>
                                @*<div ng-repeat="item in RoleRights.MenuActionList">
                                    <input type="checkbox" value="item.key" /> {{item.value}}
                                </div>*@

                                <div ng-repeat="item in AllMenu.MenuActionList">

                                    <input type="checkbox" value="item.key" /> {{item.value}}

                                </div>

                            </td>


                        </tr>


                    </tbody>
                </table>
            </div>
        </div>
        </div>
        <div class="col-xs-12 other-controller">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="RoleRightsPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-9">
                <input type="submit" value="Assign Rights" ng-disabled="Lov.$invalid" ng-click="SaveUserRole()" class="btn btn-primary" />
                <input type="button" value="Clear" ng-click="ClearRoleForm()" class="btn btn-primary" />
            </div>
        </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
    </div>
