<style type="text/css">
    .cont-m1 {
        background-color: transparent;
        height: 275px;
        perspective: 1000px;
    }

    #card {
        width: 100%;
        height: 100%;
        position: absolute;
        transform-style: preserve-3d;
        transition: transform 1s;
        color: white;
    }

        #card figure {
            margin: 0;
            display: block;
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            z-index: 999;
        }

        #card .back {
            transform: rotateY( 180deg);
        }

        #card.flipped {
            transform: rotateY( 180deg);
        }

    .line-clamp-1 {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
    }
</style>
