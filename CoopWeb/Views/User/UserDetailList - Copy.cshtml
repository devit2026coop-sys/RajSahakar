<script src="http://cdn.rawgit.com/davidstutz/bootstrap-multiselect/master/dist/js/bootstrap-multiselect.js" type="text/javascript"></script>


<div ng-app="UserDetailListModule">
    <div ng-controller="UserDetailListCont">
        <div class="loader"> </div>
        <div class="col-md-12">


            @*<h3 class="citizen-dash-head"> {{ translation.UserRequest}} <a target="_blank" style="float:right; font-size:12px" href="~/Content/UserManual/req_approve.pdf">उपयोगकर्ता पुस्तिका</a></h3>*@
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">{{translation.UserDetailList}} </span>
                    </li>

                </ul>
            </div>
        </div>

        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearOrganisationForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.UserRegistrationRequestApprovable}} </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OrganisationForm">
                            <div class="col-md-12">
                                <b><span id="spanUserDetail" style="color:black"></span></b>
                            </div>
                            @*<div class="col-md-6">
                                <label>{{translation.RoleHeading}}</label>
                                <select class="form-control" id="ddlRole" ng-model="UserRegistrationAppr.RoleID" ng-init="UserRegistrationAppr.RoleID='0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Roles" value="{{item.RoleID}}">
                                        {{_language =='en-us' ?  item.RoleName_EN : item.RoleName_HI}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-check-label">{{translation.Status}}</label>

                                <div class="form-check form-check-inline col-md-12" style="padding: 0;">
                                    <div class="form-check form-check-inline col-md-7">
                                        <div class="radio-item">
                                            <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="true" ng-model="UserRegistrationAppr.approval" ng-checked="UserRegistrationAppr.approval">
                                            <label class="form-check-label option_value" for="inlineRadio1">{{translation.Approvable}}</label>
                                        </div>
                                    </div>


                                    <div class="form-check form-check-inline col-md-5">
                                        <div class="radio-item">
                                            <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="false" ng-model="UserRegistrationAppr.approval" ng-checked="UserRegistrationAppr.approval">
                                            <label class="form-check-label option_value" for="inlineRadio2">{{translation.Rejection}}</label>
                                        </div>
                                    </div>
                                </div>
                            </div>*@

                            <div class="form-group col-md-12" >
                                <br />
                                @*<div class="col-lg-2">{{ translation.Act}}<span class="error">*</span></div>*@
                                <label>{{translation.Act}}</label>
                                <select multiple="multiple" id="ddlAct" class="form-control form-control">
                                    @*
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in ActList" value="{{item.ActId}}">
                                        {{_language =='en-us' ?  item.ActNameEn : item.ActNameHi}}
                                    </option>*@
                                </select>
                            </div>

                            <div class="col-lg-6 form-group">
                                <br />
                                <div>
                                    <label>{{translation.WorkScope}}</label>
                                    <select multiple="multiple" id="ddlPrimaryResion" class="form-control">
                                        @*
                                        <option value="0">{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemm in ResionList" value="{{itemm.ResionId}}">
                                            {{_language =='en-us' ?   itemm.ResionName : itemm.ResionName}}
                                        </option>*@
                                    </select><br />
                                </div>
                            </div>
                            <div class="col-lg-6 form-group">
                                <div style="display:none">
                                    <label>{{translation.DAIRY}} {{translation.WorkScope}}</label>
                                    <select multiple ng-model="UserRegistration.DairyResionId" id="ddlDairyResion" class="form-control" ng-init="UserRegistration.DairyResionId='0'">
                                        <option value="0">{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemm in ResionList" value="{{itemm.ResionId}}">
                                            {{_language =='en-us' ?  itemm.DairyResionNameEn : itemm.DairyResionNameEn}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">&nbsp; </div>
                            <div class="col-md-6" style="margin-top: 15px;">
                                <button type="submit" class="btn btn-primary" ng-click="SaveUserRegiApprFun()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="ClearOrganisationForm()">{{translation.Clear}}</button><br />
                                <button type="submit" class="btn btn-primary" style="margin-top:5px;padding-top:5px" ng-click="CheckRoleAtCuttentLocation()">Check User On Location</button>
                                <input type="hidden" ng-model="UserRegistrationAppr.MappingID" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('SubClassNameEn')">
                                    {{translation.OfficerNameEn}}
                                    <div ng-class="getSortClass('SubClassNameEn')"></div>
                                </th>
                                <th>
                                    {{translation.MobileNo}}
                                </th>
                                <th>
                                    {{translation.SSOID}}
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'DEPTNAMEENGLISH' : 'DEPTNAMEHINDI')">
                                    {{translation.DepartmentHeading}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'DEPTNAMEENGLISH' : 'DEPTNAMEHINDI')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'OrganisationNameEn' : 'OrganisationNameHi')">
                                    {{translation.Organisation}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'OrganisationNameEn' : 'OrganisationNameHi')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'LevelNameEn' : 'LevelNameHi')">
                                    {{translation.Level}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'LevelNameEn' : 'LevelNameHi')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'OfficeNameEn' : 'OfficeNameHi')">
                                    {{translation.Office}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'OfficeNameEn' : 'OfficeNameHi')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'DESIGNATIONDESCENGLISH' : 'DESIGNATIONDESCHINDI')">
                                    {{translation.Designation}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'DESIGNATIONDESCENGLISH' : 'DESIGNATIONDESCHINDI')"></div>
                                </th>
                                <th>
                                    {{translation.RoleHeading}}
                                </th>
                                <th>
                                    {{translation.Place}}
                                </th>
                                <th>
                                    {{translation.UserRequest}}
                                </th>
                                <th>
                                    {{translation.Act}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                            </tr>

                        </thead>
                        <tbody>
                            <tr dir-paginate="Class in UserReqData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">

                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ Class.OfficerNameEn }}</td>

                                <td>{{Class.MobileNo}} </td>
                                <td>{{Class.SSO_ID}}</td>
                                <td>{{_language =='en-us' ?  Class.DEPTNAMEENGLISH : Class.DEPTNAMEHINDI}}</td>
                                <td>{{_language =='en-us' ?  Class.OrganisationNameEn : Class.OrganisationNameHi}}</td>
                                <td>{{_language =='en-us' ?  Class.LevelNameEn : Class.LevelNameHi}}</td>
                                <td>{{_language =='en-us' ?  Class.OfficeNameEn : Class.OfficeNameHi}}</td>
                                <td>{{_language =='en-us' ?  Class.DESIGNATIONDESCENGLISH : Class.DESIGNATIONDESCHINDI}}</td>
                                <td>{{_language =='en-us' ?  Class.RoleName_EN : Class.RoleName_HI}}</td>
                                <td ng-show="Class.LevelId==1">{{translation.Rajasthan}}</td>
                                <td ng-show="Class.LevelId==2">{{_language =='en-us' ?  Class.DIVISION_ENG : Class.DIVISION_MANGAL}} </td>
                                <td ng-show="Class.LevelId==3">{{_language =='en-us' ?  Class.DISTRICT_ENG : Class.DISTRICT_MANGAL}} </td>
                                <td ng-show="Class.LevelId==4 && Class.BLOCK_ENG==''">{{_language =='en-us' ?  Class.DISTRICT_ENG : Class.DISTRICT_MANGAL}}, {{_language =='en-us' ?  Class.CITY_ENG : Class.CITY_MANGAL}} </td>
                                <td ng-show="Class.LevelId==4 && Class.BLOCK_ENG!=''">{{_language =='en-us' ?  Class.DISTRICT_ENG : Class.DISTRICT_MANGAL}}, {{_language =='en-us' ?  Class.BLOCK_ENG : Class.BLOCK_MANGAL}} </td>
                                <td ng-show="Class.LevelId==5 && Class.IsRuralArban=='False'">{{_language =='en-us' ?  Class.DISTRICT_ENG : Class.DISTRICT_MANGAL}}, {{_language =='en-us' ?  Class.BLOCK_ENG : Class.BLOCK_MANGAL}} {{_language =='en-us' ?  Class.GP_ENG : Class.GP_MANGAL}} </td>
                                <td>
                                    <div class="dev-action" ng-show="Class.UserId!=1">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Class.IsActive == 1" ng-click="MappingChangeStatus(Class.MappingID,Class.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td><span ng-show="Class.ActId.indexOf('1') >= 0"> 1958 </span> 
                               <span ng-show="Class.ActId.indexOf('3') >= 0"> <span ng-show="Class.ActId.indexOf('1') >= 0"> , </span>  2001 </span>  
                               <span ng-show="Class.ActId.indexOf('7') >= 0"> <span ng-show="Class.ActId.indexOf('1') >= 0 || Class.ActId.indexOf('3') >= 0"> , </span>  2005 </span></td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Class)"></i>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>


            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">

                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                </div>
            </div>

            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>



