            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearOrganisationForm()">&times;</button>
                        <h4 class="modal-title"> Transfer To User </h4>
                    </div>
                    <div class="modal-body" id="DvEditUser">
                        <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OrganisationForm">
                            <div class="col-md-12">
                                <b><span id="spanUserDetailActiveusr111" style="color:black">{{translation.SocietyAllocated}}</span></b>
                            </div>
                            <div class="col-md-12" style="margin-top:15px;" ng-show="NewOfficeId1=='3'||NewOfficeId1=='41'">
                            <div class="col-md-8" style="padding-left:0px;">
                                <label>Transfer to user</label>
                                <select  ng-model="UserRegistrationAppr.UserId" id="ddldesination" class="form-control" ng-init="UserRegistrationAppr.UserId='0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in UserListActive" value="{{item.UserId}}">
                                        {{_language =='en-us' ?  item.OfficerNameEn : item.OfficerNameHi}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12" style="margin-top: 15px;text-align:center;">
                            <button type="submit" class="btn btn-primary" ng-click="SaveUserInactive(false)">{{translation.Submit}}</button>
                            <button type="submit" class="btn btn-primary" ng-click="Cancelpopup()">{{translation.Cancel}}</button>
                            <input type="hidden" ng-model="UserRegistrationAppr.MappingID" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


        <div class="dev-popup-body modal fade" id="myModal_inactive" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearOrganisationForm()">&times;</button>
                        <h4 class="modal-title"> Transfer To User Confirm  </h4>
                    </div>
                    <div class="modal-body" id="DvEditUser">
                        <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OrganisationForm">
                            <div class="col-md-12" style="margin-top:15px;">
                                <h5 style="color:black;">Are you sure want to inactive user.and allocated to society another user. </h5>
                            </div>
                            
                            <div class="col-md-12" style="margin-top: 15px;text-align:center;">
                                <button type="submit" class="btn btn-primary" ng-click="SubmitFinal(true)">{{translation.Submit}}</button>
                               
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>



