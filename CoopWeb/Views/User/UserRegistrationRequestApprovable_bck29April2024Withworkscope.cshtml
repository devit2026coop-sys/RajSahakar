<script>
    function ResetActs() {
        // alert(1);
        var th = $("#ddlAct").find('input[type="checkbox"]').eq(0);
        $.each($("#ddlAct").find('input[type="checkbox"]'), function (index) {
            if (index == 0 && $(this).is(":checked")) {
                //th = $(this);
                $(this).prop("checked", true);
            } else {
                if (th.is(":checked")) {
                    $(this).prop("checked", false).attr("disabled", "disabled");
                } else {
                    $(this).prop("checked", false).removeAttr("disabled");
                }
            }
        });
    }
</script>
