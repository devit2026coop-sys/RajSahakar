<script src="~/Scripts/AngularFramework/UserRoleClient.js?v=1.1"></script>

<div ng-app="UserRole">
    <div ng-controller="Role">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">{{translation.AddRole}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.UserRoleAssignmentRights}}</span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <i class="fa fa-angle-double-right" style="color: #025e63;"></i>
                        <a ng-click="AddRoleClick();ClearRoleForm()" data-toggle="modal" data-target="#myModal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" class="ng-binding">{{translation.AddRole}}</a>
                    </li>

                </ul>
            </div>
        </div>
        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title"> {{translation.AddRole}} </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" name="MyRoleForm" style="overflow: hidden;">
                            <div class="form-group" ng-class="{ 'has-error' : MyRoleForm.RoleNameEn.$invalid && !MyRoleForm.RoleNameEn.$pristine }">
                                <label>{{translation.RoleNameEn}}</label>
                                <input type="text" class="form-control" only-letters-input name="RoleNameEn" ng-model="userrole.RoleName_EN" placeholder="{{translation.RoleNameEn}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                <label ng-show="MyRoleForm.RoleNameEn.$error.required && !MyRoleForm.RoleNameEn.$pristine" class="help-block">{{translation.RoleNameEn}} - {{translation.Required}}</label>

                            </div>
                            <div class="form-group" ng-class="{ 'has-error' : MyRoleForm.RoleNameHi.$invalid && !MyRoleForm.RoleNameHi.$pristine }">
                                <label>{{translation.RoleNameHi}}</label>
                                <input type="text" class="form-control" name="RoleNameHi" ng-model="userrole.RoleName_HI" placeholder="{{translation.RoleNameHi}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                <label ng-show="MyRoleForm.RoleNameHi.$error.required && !MyRoleForm.RoleNameHi.$pristine" class="help-block">{{translation.RoleNameHi}} - {{translation.Required}}</label>

                            </div>
                            <div class="form-group" ng-class="{ 'has-error' : MyRoleForm.RoleShortNameEn.$invalid && !MyRoleForm.RoleShortNameEn.$pristine }">
                                <label>{{translation.RoleShortNameEn}}</label>
                                <input type="text" class="form-control" only-letters-input name="RoleShortNameEn" ng-model="userrole.RoleShortName_EN" placeholder="{{translation.RoleShortNameEn}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                <label ng-show="MyRoleForm.RoleShortNameEn.$error.required && !MyRoleForm.RoleShortNameEn.$pristine" class="help-block">{{translation.RoleShortNameEn}} - {{translation.Required}}</label>

                            </div>
                            <div class="form-group" ng-class="{ 'has-error' : MyRoleForm.RoleShortNameHi.$invalid && !MyRoleForm.RoleShortNameHi.$pristine }">
                                <label>{{translation.RoleShortNameHi}}</label>
                                <input type="text" class="form-control" name="RoleShortNameHi" ng-model="userrole.RoleShortName_HI" placeholder="{{translation.RoleShortNameHi}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                <label ng-show="MyRoleForm.RoleShortNameHi.$error.required && !MyRoleForm.RoleShortNameHi.$pristine" class="help-block">{{translation.RoleShortNameHi}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group">
                                <label>{{translation.Level}} </label>
                                <select ng-model="userrole.LevelID" class="form-control" ng-init="userrole.LevelID='1'">
                                    <option value="0" disabled>{{translation.SelectOption}}-</option>
                                    <option ng-repeat="item in LevelListItem" value="{{item.LevelId}}">
                                        {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                                    </option>
                                </select>
                                <label ng-show="MyRoleForm.LeveID.$error.required && !MyRoleForm.LeveID.$pristine" class="help-block">{{translation.Level}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group">
                                <div class="form-check form-check-inline">
                                    <label class="check-box" for="inlineRadio1" style="margin-right: 15px;"> {{translation.IsActive}} </label>
                                    <input class="form-check-input" type="checkbox" id="inlineCheckbox1" value="option1" ng-true-value="1" ng-false-value="0" ng-checked="userrole.IsActive == 1" ng-model="userrole.IsActive" /> @*ng-checked="menuaction.IsActive == 1"*@
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="dev-align-btn">
                                    <button type="submit" class="btn btn-primary dev-btn" ng-disabled="MyRoleForm.$invalid" ng-click="SaveUserRole()" style="margin-right:15px;">{{translation.Submit}}</button>
                                    <button type="button" class="btn btn-primary dev-btn" ng-click="ClearRoleForm()">{{translation.Clear}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                        </div>
                        <div class="col-md-4">
                            <label>{{translation.Level}} </label>
                            <select ng-model="userrole.LevelID" class="form-control" ng-init="userrole.LevelID='0'" ng-change="RoleListByLevel()">
                                <option value="0" disabled>{{translation.SelectOption}}-</option>
                                <option ng-repeat="item in LevelListItem" value="{{item.LevelId}}">
                                    {{_language =='en-us' ?  item.LevelNameHi : item.LevelNameHi}}
                                </option>
                            </select>
                        </div>
                    </div>


                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('RoleName_EN')">
                                    {{translation.RoleNameEn}}
                                    <div ng-class="getSortClass('RoleName_EN')"></div>
                                </th>
                                <th ng-click="sortData('RoleName_HI')">
                                    {{translation.RoleNameHi}}
                                    <div ng-class="getSortClass('RoleName_HI')"></div>
                                </th>
                                <th ng-click="sortData('RoleShortName_EN')">
                                    {{translation.RoleShortNameEn}}
                                    <div ng-class="getSortClass('RoleShortName_EN')"></div>
                                </th>
                                <th ng-click="sortData('RoleShortName_HI')">
                                    {{translation.RoleShortNameHi}}
                                    <div ng-class="getSortClass('RoleShortName_HI')"></div>
                                </th>
                                <th ng-click="sortData('LevelID')">
                                    {{translation.Level}}
                                    <div ng-class="getSortClass('LevelID')"></div>
                                </th>

                                <th ng-click="sortData('IsActive')">
                                    {{translation.Status}}
                                    <div ng-class="getSortClass('IsActive')"></div>
                                </th>
                                <th>{{translation.Edit}}</th>
                                <th>{{translation.Delete}}</th>
                                <th>{{translation.AssignRights}}</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in Roles | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="rolePagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ item.RoleName_EN | uppercase }}</td>
                                <td>{{ item.RoleName_HI | uppercase }}</td>
                                <td>{{ item.RoleShortName_EN | uppercase }}</td>
                                <td>{{ item.RoleShortName_HI | uppercase }}</td>
                                <td>{{ item.LevelNameEn | uppercase }}</td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="item.IsActive == 1" ng-click="SetStatus(item.RoleID,item.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(item)"></i>

                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(item.RoleID,2)"></i>

                                </td>
                                <td>
                                    <div class="dev-action">

                                        <input type="radio" name="SingleChoise" ng-model="SingleChoise" value="1" ng-click="AssignRights(item)">

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="rolePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show='IsVisible'>
            <div class="devpage-breadcrumb">
                <div class="citizen-dash-head">
                    <label>{{translation.ParentMenu}} </label>
                    <select style="width:200px" ng-model="menu.ParentId" data-val-required="Parent Menu field is required." ng-init="menu.ParentId='0'" ng-change="MenuListbyparent()">
                        <option value="0" disabled>{{translation.SelectMasterMenu}}</option>
                        <option ng-repeat="Menu in Menus" ng-show="Menu.ParentId==0" value="{{Menu.MenuId}}">
                            {{_language =='en-us' ?  Menu.MenuNameEn : Menu.MenuNameHi}}
                        </option>
                    </select>
                </div>
            </div>
        </div>
        <div ng-show='IsVisible'>
            <div class="form-group">
                <div class="col-md-12">
                    <div class="table-responsive citizen-dash-head">        
                        <table class="table table-responsive devtable">
                            <thead>
                                <tr>
                                    @*<th>
                                        {{translation.SRNO}}
                                    </th>*@
                                    <th style="width:50%"><i  ng-click="ShowHideAllRoles()" class="fa {{MenuClass}}"></i>  Menu</th>
                                    @*<th style="width:15%">Level 2</th>
                                    <th>Level 3</th>*@                                   
                                    <th style="width:30%" ng-click="sortData('MenuUrl')">
                                        {{translation.MenuUrl}}
                                        <div ng-class="getSortClass('MenuUrl')"></div>
                                    </th>
                                    <th  style="width:20%">{{translation.MenueAction}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="Menu in AllMenus" current-page="currentPage" pagination-id="MenuPagination" dat-val="{{Menu.ParentId}}" class="_{{Menu.ParentId}}" ng-if="Menu.IsShow">
                                    @*<td>{{pageSize *(currentPage-1)+$index+1}}</td>*@
                                    
                                    <td>
                                        <div><i ng-if="Menu.Level1En!='' && Menu.IsChild" ng-click="ShowHideRoles($index,Menu.MenuId,MenuLevel)" class="fa {{Menu.Class}}" dat-val="Menu.ParentId"></i><input style="margin-left: {{Menu.Level1En!='' && Menu.IsChild?15:30}}px;" ng-if="Menu.Level1En!=''" type="checkbox" name="{{AllMenu.MenuId}}" ng-model="Menu.IsChecked" ng-change="optionToggled()" ng-checked="Menu.IsChecked" ng-click="SetUncheckStatus(Menu.MenuId,Menu.IsChecked)" />   {{ Menu.Level1En | uppercase }}</div>
                                        <div style="margin-left:50px;"><i ng-if="Menu.Level2En!='' && Menu.Level1En=='' && Menu.IsChild" ng-click="ShowHideRoles($index,Menu.MenuId,MenuLevel)" class="fa {{Menu.Class}}"></i><input style="margin-left: {{Menu.Level2En!='' && Menu.Level1En=='' && Menu.IsChild?15:30}}px;" ng-if="Menu.Level2En!='' && Menu.Level1En==''" type="checkbox" name="{{AllMenu.MenuId}}" ng-model="Menu.IsChecked" ng-change="optionToggled()" ng-checked="Menu.IsChecked" ng-click="SetUncheckStatus(Menu,AllMenu.MenuIdChecked,Menu.IsChecked)" />{{ Menu.Level2En | uppercase }}</div>
                                        <div style="margin-left:150px;"><input ng-if="Menu.Level2En=='' && Menu.Level3En!=''" type="checkbox" name="{{AllMenu.MenuId}}" ng-model="Menu.IsChecked" ng-change="optionToggled()" ng-checked="Menu.IsChecked" ng-click="SetUncheckStatus(AllMenu,AllMenu.MenuIdChecked,Menu.IsChecked)" />{{ Menu.Level3En | uppercase }}</div>
                                    </td>
                                    @*<td><i  ng-if="Menu.Level1En!='' && Menu.IsChild"   ng-click="ShowHideRoles($index,Menu.MenuId,MenuLevel)" class="fa {{Menu.Class}}" dat-val="Menu.ParentId"></i><input style="margin-left: {{Menu.Level1En!='' && Menu.IsChild?15:30}}px;" ng-if="Menu.Level1En!=''" type="checkbox" name="{{AllMenu.MenuId}}" ng-model="AllMenu.Checked" ng-change="optionToggled()" ng-checked="AllMenu.MenuIdChecked == 1" ng-click="SetUncheckStatus(AllMenu,AllMenu.MenuIdChecked,AllMenu.Checked)" />   {{ Menu.Level1En | uppercase }}</td>
                                    <td><i  ng-if="Menu.Level2En!='' && Menu.Level1En=='' && Menu.IsChild"   ng-click="ShowHideRoles($index,Menu.MenuId,MenuLevel)" class="fa {{Menu.Class}}" ></i><input style="margin-left: {{Menu.Level2En!='' && Menu.Level1En=='' && Menu.IsChild?15:30}}px;" ng-if="Menu.Level2En!='' && Menu.Level1En==''" type="checkbox" name="{{AllMenu.MenuId}}" ng-model="AllMenu.Checked" ng-change="optionToggled()" ng-checked="AllMenu.MenuIdChecked == 1" ng-click="SetUncheckStatus(AllMenu,AllMenu.MenuIdChecked,AllMenu.Checked)" />{{ Menu.Level2En | uppercase }}</td>
                                    <td><input ng-if="Menu.Level2En=='' && Menu.Level3En!=''"     type="checkbox" name="{{AllMenu.MenuId}}" ng-model="AllMenu.Checked" ng-change="optionToggled()" ng-checked="AllMenu.MenuIdChecked == 1" ng-click="SetUncheckStatus(AllMenu,AllMenu.MenuIdChecked,AllMenu.Checked)" />{{ Menu.Level3En | uppercase }}</td>*@
                                    <td>{{ Menu.MenuUrl }}</td>
                                   <td>
                                       <ul style="list-style:none;">
                                           <li style="display: inline-block;margin-right:5px; "  ng-repeat="item in Menu.MenuActionList"><input type="checkbox" name="Actionchecked{{item.Key}}" ng-model="item.RoleMenuActionCheck" ng-checked="item.RoleMenuActionCheck || (Menu.IsChecked && item.Value=='Add')" value="item.Key" /> {{item.Value}}</li>                                          
                                       </ul>
                                   </td>
                                </tr>
                            </tbody>
                        </table>

                        @*<table class="table devtable">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th align="center">
                                        <input id="CheckAll" type="checkbox" ng-click="toggleAll()" ng-model="isAllSelected" />
                                    </th>
                                    <th ng-click="sortData('Parent_Name_En')">
                                        {{translation.ParentMenuNameEn}}
                                        <div ng-class="getSortClass('Parent_Name_En')"></div>
                                    </th>
                                    <th ng-click="sortData('Parent_Name_Hi')">
                                        {{translation.ParentMenuNameHi}}
                                        <div ng-class="getSortClass('Parent_Name_Hi')"></div>
                                    </th>
                                    <th ng-click="sortData('MenuNameEn')">
                                        {{translation.MenuNameEn}}
                                        <div ng-class="getSortClass('MenuNameEn')"></div>
                                    </th>
                                    <th ng-click="sortData('MenuNameHi')">
                                        {{translation.MenuNameHi}}
                                        <div ng-class="getSortClass('MenuNameHi')"></div>
                                    </th>
                                    <th>
                                        {{translation.MenuUrl}}
                                    </th>
                                    <th ng-click="sortData('MenuNameHi')">
                                        {{translation.MenueAction}}
                                        <div ng-class="getSortClass('MenuNameHi')"></div>
                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="AllMenu in AllMenuList  | orderBy:colsort:reverseSort | itemsPerPage:250">
                                    <td>{{ $index+1 }}</td>
                                    <td align="center">
                                        <input type="checkbox" name="{{AllMenu.MenuId}}" ng-model="AllMenu.Checked" ng-change="optionToggled()" ng-checked="AllMenu.MenuIdChecked == 1" ng-click="SetUncheckStatus(AllMenu,AllMenu.MenuIdChecked,AllMenu.Checked)" />
                                    </td>
                                    <td>{{ AllMenu.Parent_Name_En | uppercase }}</td>
                                    <td>{{ AllMenu.Parent_Name_Hi | uppercase }}</td>
                                    <td>{{ AllMenu.MenuNameEn | uppercase }}</td>
                                    <td>{{ AllMenu.MenuNameHi | uppercase }}</td>
                                    <td>{{ AllMenu.MenuUrl }}</td>
                                    <td>
                                        <div ng-repeat="item in AllMenu.MenuActionList">
                                            <input type="checkbox" name="Actionchecked{{item.Key}}" ng-model="item.RoleMenuActionCheck" ng-checked="item.RoleMenuActionCheck" value="item.Key" /> {{item.Value}}
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>*@
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="dev-align-btn">
                        <button type="button" class="btn btn-primary dev-btn" ng-click="SaveAssignRights()" style="margin-right:15px;">{{translation.Submit}}</button>
                        <button type="button" id="btnShow" ng-click="btnShowClick()" style="margin-right:15px;display:none"></button>
                        <button type="button" class="btn btn-primary dev-btn" ng-click="ClearAssignRightsForm()">{{translation.Clear}}</button>
                    </div>
                </div>

            </div>

        </div>

    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
