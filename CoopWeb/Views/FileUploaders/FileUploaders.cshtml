
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; ;
}

<script src="~/Scripts/AngularFramework/Uploaders.js"></script>


<div ng-app="UploadModule">
    <div ng-controller="UploadCont">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">DIRECTORY CREATOR AND UPLOADER</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> Directory  </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <form class="dev-search-form citizen-dash-head " style="overflow: hidden;" name="Myauditform">
                <div class="col-lg-12 form-group">
                    <div class="col-md-12">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="col-lg-12 form-group">
                                <div class="col-lg-2">WEB CONFIG<span class="error">*</span></div>
                                <div class="col-lg-4">
                                    <label class="help-block-gender" style="width:40% !important;">
                                        <input type="radio" id="sdfs" name="Rurals" value="true" ng-model="Directory.IsWeb" ng-change="ShowWebConfig(Directory.IsWeb)" ng-disabled="allDisable"> YES
                                    </label>
                                </div>
                            </div>
                            <div class="col-lg-12 form-group">
                                <div class="col-lg-2">Directory<span class="error">*</span></div>
                                <div class="col-lg-4">
                                    <select ng-model="Directory.ID" class="form-control form-control" ng-change="GetSubDir(Directory.ID)" ng-init="Directory.ID='0'" ng-disabled="all">
                                        <option value="0" disabled>SELECT</option>
                                        <option ng-repeat="item in PDirectoryList" value="{{item.ID}}">
                                            {{item.NAME}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-12 form-group" ng-show="IsRootDir">
                                <div>
                                    <div class="col-lg-2">Directory Name<span class="error">*</span></div>
                                    <div class="col-lg-4">
                                        <input type="text" name="DIR" class="form-control" ng-model="Directory.DIR" placeholder="{{translation.DIR}}" autocomplete="off">
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 form-group" ng-show="IsSubDir">
                                <div class="col-lg-2">Directory Name<span class="error">*</span></div>
                                <div class="col-lg-4">
                                    <select ng-model="Directory.IsDirectory2" ng-change="IsDirectoryShowHide(Directory)" class="form-control form-control" ng-init="Directory.SID='0'" ng-disabled="all">
                                        <option value="0" disabled>SELECT</option>
                                        <option ng-repeat="item in SDirectoryList" value="{{item.IsDirectory2}}">
                                            {{item.NAME}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-12 form-group">
                                <div>
                                    <div ng-show="labelheading" class="col-lg-2">File Upload/Directory Name<span class="error">*</span></div>
                                    <div class="col-lg-4">
                                        <input type="text" ng-show="IsDirectoryYes" name="SUBDIR" class="form-control" ng-model="Directory.SubDirectoryName" placeholder="{{translation.SUBDIR}}" autocomplete="off">
                                        <input type="file" filetype="Upload" ng-show="IsDirectoryNO" name="SUBDIR" class="form-control" ng-model="Directory.DirectoryFile" onchange="angular.element(this).scope().UploadFile(this.files)" placeholder="{{translation.SUBDIR}}" autocomplete="off">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary" ng-disabled="Directory.$invalid" ng-click="SaveDir()">{{translation.Submit}}</button>
                            <button type="submit" class="btn btn-primary" ng-click="ClearForm()">{{translation.Clear}}</button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-12 form-group" ng-show="IsWebConfig">
                    <div class="col-md-12">
                        <textarea ng-model="Directory.WebConfigText" rows="15" cols="270"></textarea>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
