@{
    ViewBag.Title = "Society Location Status List";
}
<script src="~/Scripts/AngularFramework/SocietyLocationStatusApprovedList.js?v=1.13"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />
<script src="~/Scripts/xlsx.full.min.js"></script>

<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td {
        padding: 1px;
        padding-right: 5px;
        padding-left: 5px;
    }
</style>
<div ng-app="SocietyLocationStatusModule" ng-controller="SocietyLocationStatusCont" ng-cloak="">
    <div>
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">Society Location Status List</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> Society Location Status List </span>
                    </li>

                </ul>
            </div>
        </div>
        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">
                        <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">                           
                        </div>
                    </div>

                    <div style="overflow-x: auto;">
                        <table id="SocietyLocationStatusList" class="table table-responsive devtable" style="">

                            <thead>
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Society Name</th>
                                    <th>District Name</th>
                                    <th>Chairman/Administrative Name</th>
                                    <th>Chairman/Administrative Contact </th>
                                    <th>CEO Name</th>
                                    <th>CEO Contact </th>
                                    <th>Charge Type </th>
                                    <th>Status</th>
                                    <th>Latitude</th>
                                    <th>Longitude</th>
                                    <th>Location By GEO</th>
                                    <th>Image</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in SocietyLocationStatusList">
                                    <td>{{($index + 1 )}}</td>
                                    <td>{{item.SocietyName}}</td>
                                    <td>{{item.DISTRICT_ENG }}</td>
                                    <td>{{item.PresidentName}}</td>
                                    <td>{{item.PresidentContact}}</td>
                                    <td>{{item.SecretaryName}}</td>
                                    <td>{{item.SecretaryContact}}</td>
                                    <td>{{item.ChargeType}}</td>
                                    <td>{{item.Status}}</td>
                                    <td>{{item.Latitude}}</td>
                                    <td>{{item.Longitude}}</td>
                                    <td>{{item.locationbygeo}}</td>
                                    <td class="text-center">
                                        <a ng-if="item.Imageurl" ng-href="{{item.Imageurl}}" target="_blank" title="View Image">
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                        </a>
                                        <span ng-if="!item.Imageurl">-</span>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-primary btn-sm" ng-click="OpenApprovalPopup(item)">
                                            Approved
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Approval Modal -->
                        <div class="modal fade"  id="ApprovalModal" tabindex="-1" role="dialog" aria-labelledby="ApprovalModalLabel">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button"  class="close" data-dismiss="modal"> <span>&times;</span> </button>
                                        <h4 class="modal-title" id="ApprovalModalLabel">  Society Location Status </h4>
                                    </div>

                                    <div class="modal-body">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <label> Status <span style="color:red">*</span> </label>
                                                    <select class="form-control" ng-model="ApprovalModel.IsApproved">
                                                        <option value="">-- Select Status -- </option>
                                                        <option value="1">Approved</option>
                                                        <option value="2">Revert</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <label> Remark <span style="color:red">*</span> </label>
                                                    <textarea class="form-control" rows="4"  maxlength="500"  placeholder="Enter remark" ng-model="ApprovalModel.Remark"> </textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-default"  data-dismiss="modal">  Close </button>
                                        <button type="button"  class="btn btn-primary" ng-click="SaveSocietyLocationApproval()"> Submit </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="se-pre-con"></div>
    </div>
</div>

