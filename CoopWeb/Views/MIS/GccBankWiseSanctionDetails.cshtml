<script>
    $(function () {
        $(".datepicker").each(function () {
            if ($(this).hasClass("hasDatepicker")) {
                $(this).datepicker("destroy");
            }

            $(this).datepicker({
                dateFormat: "dd/mm/yy",
                changeMonth: true,
                changeYear: true,
                yearRange: "1950:2050"
            });
        });

    });
</script>
