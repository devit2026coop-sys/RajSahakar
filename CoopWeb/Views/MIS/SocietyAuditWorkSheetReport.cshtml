@model List<Cooperative.Models.SocietyRegistrationEntity>

    <script type="text/javascript">

        function ValidateAlpha(evt) {
            var keyCode = (evt.which) ? evt.which : evt.keyCode
            if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)
                return false;
            return true;
        };
        function ValidateFloat(th, e) {
            if (isNaN(th.value + "" + String.fromCharCode(e.charCode)))
                return false;
            return true;
        }
        function ValidateFloat(th, e) {
            if (isNaN(th.value + "" + String.fromCharCode(e.charCode)))
                return false;
            return true;
        }
        

        $(document).ready(function () {

            var dt = new Date();
            var year = dt.getFullYear();
            var day = dt.getDate();
            var month = dt.getMonth() + 1;


            $("#StartDates").val(day + "/" + month + "/" + year);
            $("#EndDates").val(day + "/" + month + "/" + year)

         

            //$('#txtTime2').timepicker({
            //    showOn: "both",
            //    buttonImage: "../images/Time.png",
            //    buttonImageOnly: true,
            //    showPeriod: true,
            //    showLeadingZero: true
            //});

            $('.devcalender').datepicker({
                showOn: "both",
                changeMonth: true,
                buttonImage: "../images/calender.png",
                changeYear: true,
                dateFormat: "dd/mm/yy",
                maxDate: new Date(),
                yearRange: "c-10:c+0"
            });

        });
    </script>

    <div ng-app="CitizenSocietyAuditMod" ng-controller="CitizenSocietyAuditCnt">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">Society Audit Work Sheet Rreport</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="../Citizen/Index"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">

                        <span style="margin: 0 5px;">Society Audit Work Sheet Rreport</span>
                    </li>

                </ul>
            </div>
        </div>

        <div >
            <div class="col-md-12">
                <div class="table-responsive citizen-dash-head">
                    <div class="table-dropdown" id="search-filter">
                        <div class="col-md-2 margin-Top20" style="padding-left: 0;">
                            <label>{{ translation.DistrictHeading}}</label>
                            <select name="DistrictId" id="ddlDistrictId" class="form-control" ng-model="FilterSearch.DistrictId">
                                <option value="">{{translation.SelectOption}}</option>
                                <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                    {{_language =='en-us' ?  district.DISTRICT_ENG : district.DISTRICT_MANGAL}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4" style="padding-left: 0;">
                            <label>{{ translation.Society}}</label>
                            <select ng-model="SocietyRegistration.ActId" class="form-control" ng-change="getSocietyfilter()" ng-init="SocietyRegistration.ActId='0'">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in ActList" value="{{item.ActId}}">
                                    {{_language =='en-us' ?  item.ActNameEn : item.ActNameHi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4" style="padding-left: 0;">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder="{{translation.filttertext}}" autocomplete="off">
                        </div>
                        <div class="col-md-2  margin-Top20">
                            <label>&nbsp;</label><br>
                            <button type="button" ng-click="searchRequest(GetAuditWorkSheetReport)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                            <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                        </div>
                    </div>
                    <table id="example" class="table devtable" style="margin-top: 10px;border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.SocietyName}}
                                </th>
                                <th>
                                    {{translation.SocietyRegistrationNo}}
                                </th>
                                <th>
                                    {{translation.DistrictHeading}}
                                </th>
                                <th>
                                    {{translation.FincialYearHeading}}
                                </th>
                                <th>Audit By</th>
                                <th>
                                    {{translation.Date}}
                                </th>
                                <th>
                                    {{translation.AuditStartTime}}
                                </th>
                                <th>
                                    {{translation.AuditEndTime}}
                                </th>
                                <th>
                                  Total Hours
                                </th>
                                <th>
                                    Work Details
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in AuditWorkSheetList">
                                <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                                <td>{{item.SocietyName}}</td>
                                <td>{{item.RegistrationNo}}</td>
                                <td>{{item.DISTRICT_ENG}}</td>
                                <td>{{item.FIN_YEAR_NAME}} </td>
                                <td>{{item.OfficerNameEn}}({{item.RoleName_EN}})</td>
                                <td>
                                    {{item.AuditDate}}
                                </td>
                                <td>
                                    {{item.StartTime}}
                                </td>
                                <td>
                                    {{item.EndTime}}
                                </td>
                                <td>
                                    {{item.TotalHours}}
                                </td>
                                <th>
                                    {{item.AuditWorkDetails}}
                                </th>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7">
                                    <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                        <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                            {{translation.TotalRecords}}: {{DataPagingDetails.TotalRecords}}
                                        </div>
                                        <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« {{translation.First}}</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« {{translation.Previous}}</span></li>

                                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetAuditWorkSheetReport)" style="cursor: pointer;">
                                                <span>
                                                    «{{translation.First}}
                                                </span>
                                            </li>
                                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetAuditWorkSheetReport)" style="cursor:pointer;">
                                                <span>
                                                    «{{translation.Previous}}
                                                </span>
                                            </li>
                                            <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetAuditWorkSheetReport)"><span>{{n}}</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« {{translation.Next}}</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>«{{translation.Last}} </span></li>
                                            <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetAuditWorkSheetReport)" style="cursor:pointer;">
                                                <span>{{translation.Next}} »</span>
                                            </li>
                                            <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetAuditWorkSheetReport)" style="cursor:pointer;">
                                                <span>{{translation.Last}} »</span>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>               
            </div>
        </div>



  
        <div class="dev-popup-body modal fade" id="addModal" data-backdrop="static" data-keyboard="false" role="dialog">
            <div class="modal-dialog" style="width: 50%;">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <h3 style="color:black">Audit Schedule information</h3>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OfficeForm">
