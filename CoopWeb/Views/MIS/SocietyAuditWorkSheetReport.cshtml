                                                <option value="AM">AM</option>
                                                <option value="PM">PM</option>
                                            </select>
                                       
                                    </div>
                                </div>

                            </div>
                            <div class="col-lg-12 margin-Top20" style="margin-top:20px;" ">

                                <div class="col-lg-2">
                                    <label>{{translation.AuditEndTime}}</label>
                                </div>
                                <div class="col-lg-8">
                                    <div class="col-lg-4" style="padding-left: 0px;">
                                        <input name="RegistrationDates" ng-disabled="true" id="EndDates" class="form-control" placeholder="{{translation.AuditEndDate}}" ng-model="LetterData.AuditEndDate" autocomplete="off" />
                                    </div>
                                    <div class="col-lg-8">
                                       

                                            <select class="form-control validateNewAdd" ng-model="LetterData.EndTime_HHs" ng-change="TimeCheck()" style="float: left;width: 75px;margin-top: -3px;" id="EndTime_HHs">
                                                <option value="">HH</option>
                                                <option value="01">01</option>
                                                <option value="02">02</option>
                                                <option value="03">03</option>
                                                <option value="04">04</option>
                                                <option value="05">05</option>
                                                <option value="06">06</option>
                                                <option value="07">07</option>
                                                <option value="08">08</option>
                                                <option value="09">09</option>
                                                <option value="10">10</option>
                                                <option value="11">11</option>
                                                <option value="12">12</option>
                                            </select>&nbsp;&nbsp;
                                            <select class="form-control validateNewAdd"  ng-model="LetterData.EndTime_MMs"  ng-change="TimeCheck()"style="float: left;width: 75px;margin-top: -3px;" id="EndTime_MMs">
                                                <option value="">MM</option>
                                                <option value="00">00</option>
                                                <option value="05">05</option>
                                                <option value="10">10</option>
                                                <option value="15">15</option>
                                                <option value="20">20</option>
                                                <option value="25">25</option>
                                                <option value="30">30</option>
                                                <option value="35">35</option>
                                                <option value="40">40</option>
                                                <option value="45">45</option>
                                                <option value="50">50</option>
                                                <option value="55">55</option>
                                            </select>&nbsp;
                                            <select class="form-control validateNewAdd" ng-model="LetterData.EndTime_APs" ng-init="LetterData.EndTime_APs='AM'" ng-change="TimeCheck()" style="float: left;width: 75px;margin-top: -3px;" id="EndTime_APs">
                                                <option value="AM">AM</option>
                                                <option value="PM">PM</option>
                                            </select>

                                        </div>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <div class="col-md-12" style="margin-top:20px;">
                                <div class="col-md-2">
                                    <label>{{translation.Time}}(Hours) </label>
                                </div>
                                <div class="col-md-8">
                                    <input Id="ttime" ng-disabled="true" class="form-control" ng-model="LetterData.Time">
                                </div>
                            </div>

                            <div class="clearfix"></div>
                            <div class="col-md-12 margin-Top20" style="margin-top:20px;">
                                <div class="col-md-2">
                                    <label>Audit Work Details </label>
                                </div>
                                <div class="col-md-8 ">
                                    <textarea class="form-control" id="ddetails" ng-model="LetterData.Details"></textarea>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top: 20px;">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-click="SaveDataLetter()">{{translation.Submit}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>



        <div class="se-pre-con"></div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>
    </div>
