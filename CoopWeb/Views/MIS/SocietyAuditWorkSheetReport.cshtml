                                <div class="col-md-2">
                                    <label>{{translation.SocietyName}} </label>
                                </div>
                                <div class="col-md-8" style="color:black">
                                    <b>  {{AuditSociety}}</b>
                                </div>

                            </div>

                            <div class="clearfix"></div>
                            <div class="col-lg-12 margin-Top20" style="margin-top:20px;" ">
                                <div class="col-lg-2">
                                    <label>{{translation.AuditStartTime}}</label>
                                </div>
                                <div class="col-lg-8" style="padding-left: 0px;">
                                    <div class="col-lg-4">
