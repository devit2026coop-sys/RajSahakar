    }

    .outstanding-row {
        background: #7d9631 !important;
    }

    .tble-main-row {
        display: flex;
        align-items: start;
        gap: 20px;
    }

    #PLDBReportDetails {
        border-collapse: collapse !important;
        border: 1px solid #555 !important;
    }

        #PLDBReportDetails th,
        #PLDBReportDetails td {
            border: 1px solid #8aa6b8 !important;
        }

    #KPIReportExport {
        font-family: "Noto Sans Devanagari", Arial, sans-serif;
    }

        #KPIReportExport table {
            border-collapse: collapse !important;
        }

        #KPIReportExport th,
        #KPIReportExport td {
            /*            white-space: normal !important;*/
            word-break: normal !important;
            overflow-wrap: break-word !important;
        }
</style>
<div ng-app="SocietyKPIReportModule" ng-controller="SocietKPIReportECont" ng-cloak="">
    <div>
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">KPI Report List</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> KPI Report List </span>
                    </li>
                </ul>
            </div>
        </div>
        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">
                        <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">
                            <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                            <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                            <input type="hidden" id="hdnPldbId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
                            <input type="hidden" id="hdnPldbBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />
                            <input type="hidden" id="hdnLevelId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />

                            <div class="TpInptCrd">
                                <div class="form-group" ng-show="ShowSummary">
                                    <label for="search" class="ng-binding">{{translation.FincialYearHeading}}:</label>
                                    <select ng-model="FinYear" class="form-control" ng-init="FinYear='0'">
                                        <option value="0">--Select--</option>
                                        <option value="{{FinYear.FinYearId}}" ng-repeat="FinYear in FinancialYearList">{{FinYear.FinYearName}}</option>
                                    </select>
                                </div>
                                <div class="form-group" ng-show="ShowSummary">
                                    <label for="search">Month:</label>
                                    <select class="form-control" ng-model="Month">
                                        <option value="">--Month--</option>
                                        <option value="1">January</option>
                                        <option value="2">February</option>
                                        <option value="3">March</option>
                                        <option value="4">April</option>
                                        <option value="5">May</option>
                                        <option value="6">June</option>
                                        <option value="7">July</option>
                                        <option value="8">August</option>
                                        <option value="9">September</option>
                                        <option value="10">October</option>
                                        <option value="11">November</option>
                                        <option value="12">December</option>
                                    </select>
                                </div>
                                <div class="form-group" ng-show="ShowSummary">
                                    <label for="search">KPI Report Type:</label>
                                    <select class="form-control" ng-model="KPIFor" ng-change="KPIChanged()">
                                        <option value="">--Select KPI--</option>
                                        <option value="RAO"> RAO KPI </option>
                                        <option value="SA">SAO KPI </option>
                                        <option value="UpbhoktaBhandars">  Upbhokta Bhandars KPI  </option>
                                        <option value="PACS"> KPI For Pacs  </option>
                                        <option value="PLDB">  KPI For PLDB  </option>
                                        <option value="UnitOffice">  KPI For Unit Office  </option>
                                    </select>
                                </div>

                                <div class="text-center">
                                    <label>&nbsp;</label><br>
                                    <button type="button" ng-show="ShowSummary" ng-click="KPITypeChanged()" class="btn btn-primary dev-btn ng-binding text-center">{{translation.Search}}</button>
                                    <button type="button" ng-show="ShowSummary" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding text-center">{{translation.Clear}}</button>
                                    <!-- NEW EXPORT BUTTON -->
                                    <button type="button" ng-show="ShowSummary && Offices.length > 0" onclick="ExportKPIReportListToExcel()" class="btn btn-success dev-btn">
                                        <i class="fa fa-file-excel-o"></i>
                                        Export Excel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div style="overflow-x:auto" ng-show="ShowSummary && Offices.length > 0">
                        <table id="KPIReportListTable" class="table table-bordered table-striped devtable">
                            <thead>
                                <tr>
                                    <th style="background: #6f31a1;">Sr.No</th>
                                    <th style="background: #6f31a1;" ng-if="KPIFor  == 'UpbhoktaBhandars'">District</th>
                                    <th style="background: #6f31a1;" ng-if="KPIFor  == 'PACS'">Pacs Name</th>
                                    <th style="background: #6f31a1;" ng-if="KPIFor  == 'PLDB'">PLDB Name</th>
                                    <th style="background: #6f31a1;" ng-if="KPIFor  != 'UpbhoktaBhandars' && KPIFor  != 'PACS' && KPIFor  != 'PLDB' ">Office</th>
                                    <th style="background: #6f31a1;">Total Weight Marks</th>
                                    <th style="background: #6f31a1;">Total Marks Obtained</th>
                                    <th style="background: #6f31a1;">Percentage</th>
                                    <th style="background: #6f31a1;">Performance</th>
                                    <th style="background: #6f31a1;">Category</th>
                                    <th style="background: #6f31a1;">Rank</th>
                                    <th style="background: #6f31a1;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in Offices" ng-class="{'outstanding-row': item.Category == 'A+', 'very-good-row': item.Category == 'A', 'good-row': item.Category == 'B', 'average-row': item.Category == 'C', 'unsatisfactory-row': item.Category == 'D'}">
                                    <td>{{$index+1}}</td>
                                    <th ng-if="KPIFor  == 'UpbhoktaBhandars'">{{item.DistrictName}}</th>
                                    <th ng-if="KPIFor  == 'PACS'">{{item.PACSNameEn}}</th>
                                    <th ng-if="KPIFor  == 'PLDB'">{{item.PLDBName}}</th>
                                    <td ng-if="KPIFor  != 'UpbhoktaBhandars' && KPIFor  != 'PACS' && KPIFor  != 'PLDB' ">{{item.OfficeNameEn}}</td>
                                    <td>{{item.TotalWeightedMarks}}</td>
                                    <td>{{item.TotalMarksObtained}}</td>
                                    <td>{{item.TotalPercentage}}</td>
                                    <td>{{item.Performance}}</td>
                                    <td>{{item.Category}}</td>
                                    <td>{{item.Rank}}</td>
                                    <td ng-if="KPIFor != 'PLDB'">
                                        <button class="btn btn-primary btn-sm" ng-click="ViewReport(item)"> View </button>
                                    </td>
                                    <td ng-if="KPIFor == 'PLDB'">
                                        <button type="button" class="btn btn-primary" ng-click="ViewPLDB(item)">View</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div ng-show="ShowDetails && KPIFor != 'PLDB'" id="KPIReportExport">

                        <div class="row" ng-show="ShowDetails">

                            <div class="col-md-10 text-center">
                                <h3 style="font-weight:bold; margin-top:10px;">
                                    {{ReportHeading}}
                                </h3>
                            </div>

                            <div class="col-md-2 text-right">
                                <button type="button" class="btn btn-success" onclick="ExportKPIReportToExcel();">
                                    <i class="fa fa-file-excel-o"></i>
                                    Export Excel
                                </button>
                                <button type="button" class="btn btn-danger" onclick="ExportKPIReportToPDF();">
                                    <i class="fa fa-file-pdf-o"></i>  Export PDF
                                </button>
                            </div>

                        </div>

                        <table class="table devtable kpi-detail-table mt-4" id="KPIDetailTable">
                            <thead>
                                <tr>
                                    <th>Sr.No</th>
                                    <th>KPI Area</th>
                                    <th>Indicator</th>
                                    <th ng-if="KPIFor != 'PACS' && KPIFor != 'UpbhoktaBhandars'">Target</th>
                                    <th ng-if="KPIFor != 'PACS' && KPIFor != 'UpbhoktaBhandars'">Achievement</th>
                                    <th ng-if="KPIFor != 'PACS' && KPIFor != 'UpbhoktaBhandars'">Progress</th>
                                    <!-- For PACS & Upbhokta -->
                                    <th ng-if="KPIFor == 'PACS' || KPIFor == 'UpbhoktaBhandars'">  Instructions to fill Indicators </th>
                                    <th>Weighted Marks</th>
                                    <th>Marks Obtained</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in ReportData">

                                    <td ng-if="$index == 0 || item.KPIAreaId != ReportData[$index - 1].KPIAreaId" ng-attr-rowspan="{{getKPIAreaRowSpan(item.KPIAreaId, $index)}}">
                                        {{getKPINumber(item.KPIAreaId, $index)}}
                                    </td>

                                    <td ng-if="$index == 0 || item.KPIAreaId != ReportData[$index - 1].KPIAreaId" ng-attr-rowspan="{{getKPIAreaRowSpan(item.KPIAreaId, $index)}}">
                                        {{item.KPIArea}}
                                    </td>

                                    <td>{{item.KPIIndicators}}</td>

                                    <td class="text-right" ng-if="item.KPIFor != 'PACS'    && item.KPIFor != 'UpbhoktaBhandars'    && !(item.KPIFor == 'PLDB' && item.KPIIndicatorsId == 97)">
                                        {{item.Target}}
                                    </td>

                                    <td class="text-right" ng-if="item.KPIFor == 'PLDB' && item.KPIIndicatorsId == 97">
                                        @*{{item.inputtype}}*@
                                    </td>

                                    <td class="text-right" ng-if="(item.KPIAreaId == 9 || item.KPIIndicatorsId == 19 && item.KPIFor == 'RAO')">
                                        {{GetAchievementText(item.Achievement)}}
                                    </td>

                                    <td class="text-right" ng-if="(item.KPIAreaId == 19 || item.KPIIndicatorsId == 39 && item.KPIFor == 'SA')">
                                        {{GetAchievementText(item.Achievement)}}
                                    </td>

                                    <td class="text-right" ng-if="item.KPIFor != 'PACS' && item.KPIFor != 'UpbhoktaBhandars'  && !((item.KPIFor == 'RAO' && item.KPIAreaId == 9 || item.KPIIndicatorsId == 19) || (item.KPIFor == 'SA' && item.KPIAreaId == 19 || item.KPIIndicatorsId == 39) )" ng-class="{'no-left-border': item.KPIFor == 'PLDB' && item.KPIIndicatorsId == 97}">
                                        <span ng-if="item.KPIFor == 'PLDB' && item.KPIIndicatorsId == 97">
                                            {{item.inputtype}}
                                        </span>

                                        <span ng-if="!(item.KPIFor == 'PLDB' && item.KPIIndicatorsId == 97)">
                                            {{item.Achievement}}
                                        </span>
                                    </td>

                                    <td ng-if="item.KPIFor != 'PACS' && item.KPIFor != 'UpbhoktaBhandars'">{{item.Progress}}</td>
                                    <!-- PACS & Upbhokta -->
                                    <td class="text-right" ng-if="KPIFor == 'PACS' || KPIFor == 'UpbhoktaBhandars'">

                                        <div ng-if="item.KPIIndicatorsId == 40 || item.KPIIndicatorsId == 42">
                                            <strong>Target:</strong> {{item.Target}} <br />
                                            <strong>Achievement:</strong> {{item.Achievement}}
                                        </div>

                                        {{item.inputtype}}
                                    </td>

                                    <td class="text-right">{{item.WeightedMarks}}</td>
                                    <td class="text-right">{{item.MarksObtained}}</td>
                                </tr>

                                <tr class="bg-info">
                                    <td colspan="{{ (KPIFor == 'PACS' || KPIFor == 'UpbhoktaBhandars' ) ? 4 : 6 }}" class="text-center"><b>Total</b></td>
                                    <td class="text-right"><b>{{OverallRating.TotalWeightedMarks}}</b></td>
                                    <td class="text-right"><b>{{OverallRating.TotalMarksObtained}}</b></td>
                                </tr>

                            </tbody>
                        </table>

                        <div ng-if="OverallRating" ng-show="ShowDetails" class="tble-main-row">
                            <div class="performance-tble" style="width:100%;">
                                <table class="table table-responsive devtable mt-0" id="KPIPerformanceTable">
                                    <thead>
                                        <tr>
                                            <th style="background: #6f31a1;">Work Performance Evaluation</th>
                                            <th style="background: #6f31a1;">Total Weight Marks</th>
                                            <th style="background: #6f31a1;">Total Marks Obtained</th>
                                            <th style="background: #6f31a1;">Total Percentage</th>
                                            <th style="background: #6f31a1;">Performance</th>
                                            <th style="background: #6f31a1;">Category</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-class="{'outstanding-row': OverallRating.Category === 'A+','very-good-row': OverallRating.Category === 'A', 'good-row': OverallRating.Category === 'B','average-row': OverallRating.Category === 'C', 'unsatisfactory-row': OverallRating.Category === 'D'}">
                                            <td><b>Marks Obtained</b></td>
                                            <td><b>{{OverallRating.TotalWeightedMarks}}</b></td>
                                            <td><b>{{OverallRating.TotalMarksObtained | number:2}}</b></td>
                                            <td><b>{{OverallRating.PercentageObtained}}</b></td>
                                            <td><b>{{OverallRating.Performance}}</b></td>
                                            <td><b>{{OverallRating.Category}}</b></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="rating-criteria" style="width:100%;">
                                <table class="table table-bordered table-striped devtable" id="KPICriteriaTable">
                                    <thead>
                                        <tr>
                                            <th style="background: #6f31a1;">Criteria</th>
                                            <th style="background: #6f31a1;">Performance</th>
                                            <th style="background: #6f31a1;">Category</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr ng-repeat="item in PerformanceCriteria" ng-class="{'outstanding-row': item.Category == 'A+', 'very-good-row': item.Category == 'A', 'good-row': item.Category == 'B','average-row': item.Category == 'C', 'unsatisfactory-row': item.Category == 'D' }">
                                            <td><b>{{item.Criteria}}</b></td>
                                            <td><b>{{item.Performance}}</b></td>
                                            <td><b>{{item.Category}}</b></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                    <div ng-if="ShowPLDBDetails" id="PLDBReportExport">

                        <div class="row">
                            <div class="col-md-10 text-center">
                                <h3 style="font-weight:bold;">
                                    PLDB {{SelectedPLDBName}} {{PreviousMonth}} 2026 तक प्रगति रिपोर्ट
                                </h3>
                            </div>

                            <div class="col-md-2 text-right">
                                <button type="button" class="btn btn-success" onclick="ExportKPIPLDBReportToExcel()">
                                    <i class="fa fa-file-excel-o"></i>  Export Excel
                                </button>
                                <button type="button" class="btn btn-danger" onclick="ExportKPIPLDBReportToPDF();">
                                    <i class="fa fa-file-pdf-o"></i>  Export PDF
                                </button>
                            </div>
                        </div>

                        <!-- PLDB Details Table -->

                        <table id="PLDBReportDetails" class="table table-bordered table-striped devtable">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="background:#0070C0; color:white;"> KPI No.  </th>
                                    <th rowspan="2" style="background:#0070C0; color:white;"> Key Task / KPI Area </th>
                                    <th rowspan="2" style="background:#0070C0; color:white;"> Details of Indicators </th>
                                    <th rowspan="2" style="background:#0070C0; color:white;"> Target </th>
                                    <th rowspan="2" style="background:#0070C0; color:white;"> Achievement </th>
                                    <th rowspan="2" style="background:#0070C0; color:white;"> Progress % </th>
                                    <th colspan="2" style="background:#0070C0; color:white;"> SUB TOTAL  </th>
                                </tr>
                                <tr>
                                    <th style="background:#0070C0; color:white;"> WEIGHTED<br />MARKS  </th>
                                    <th style="background:#0070C0; color:white;"> MARKS<br />OBTAINED </th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr ng-repeat="item in PLDBReportData" style="background:#FFDA6A;">

                                    <td class="text-center" ng-if="$index == 0 || item.KPIAreaId != PLDBReportData[$index - 1].KPIAreaId" ng-attr-rowspan="{{getPLDBKPIAreaRowSpan(item.KPIAreaId, $index)}}">
                                        {{getPLDBKPINumber(item.KPIAreaId, $index)}}
                                    </td>
                                    <td ng-if="$index == 0 || item.KPIAreaId != PLDBReportData[$index - 1].KPIAreaId" ng-attr-rowspan="{{getPLDBKPIAreaRowSpan(item.KPIAreaId, $index)}}">
                                        {{item.KPIArea}}
                                    </td>
                                    <td>{{item.KPIIndicators}} </td>
                                    <td class="text-right">
                                        <span ng-if="item.inputtype">{{item.inputtype}}</span>
                                        <span ng-if="!item.inputtype">{{item.Target}}</span>
                                    </td>

                                    <td class="text-right">
                                        <span ng-if="!item.inputtype">{{item.Achievement}}</span>
                                    </td>

                                    <td class="text-right">
                                        {{item.Progress}}
                                    </td>

                                    <td class="text-right">
                                        {{item.WeightedMarks}}
                                    </td>

                                    <td class="text-right">
                                        {{item.MarksObtained}}
                                    </td>
                                </tr>

                                <!-- Records Not Found -->
                                <tr ng-if="!PLDBReportData || PLDBReportData.length == 0">
                                    <td colspan="9" class="text-center" style="font-weight:bold; padding:15px;">
                                        Records Not Found
                                    </td>
                                </tr>

                                <!-- Total -->
                                <tr class="bg-info" ng-if="PLDBReportData && PLDBReportData.length > 0" style="background:#0070C0; color:white;">
                                    <td colspan="6" class="text-center">  <b>Total</b> </td>
                                    <td class="text-right"> <b>{{PLDBTotalWeightedMarks}}</b></td>
                                    <td class="text-right"> <b>{{PLDBTotalMarksObtained}}</b> </td>
                                </tr>

                            </tbody>

                        </table>

                        <div ng-if="PLDBOverallRating" class="tble-main-row">

                            <!-- Performance -->
                            <div class="performance-tble" style="width:100%;">

                                <table class="table table-responsive devtable mt-0" id="PLDBOverRating">

                                    <thead>
                                        <tr>
                                            <th style="background:#6f31a1;"> Work Performance Evaluation </th>
                                            <th style="background:#6f31a1;"> Total Weight Marks </th>
                                            <th style="background:#6f31a1;"> Total Marks Obtained  </th>
                                            <th style="background:#6f31a1;"> Total Percentage </th>
                                            <th style="background:#6f31a1;">  Performance   </th>
                                            <th style="background:#6f31a1;"> Category  </th>
                                            <th style="background:#6f31a1;"> Rank  </th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        <tr ng-class="{'outstanding-row': PLDBOverallRating.Category === 'A+','very-good-row': PLDBOverallRating.Category === 'A', 'good-row': PLDBOverallRating.Category === 'B', 'average-row': PLDBOverallRating.Category === 'C', 'unsatisfactory-row': PLDBOverallRating.Category === 'D'}">
                                            <td> <b>Marks Obtained</b> </td>
                                            <td> <b>{{PLDBOverallRating.TotalWeightedMarks}}</b> </td>
                                            <td> <b>{{PLDBOverallRating.TotalMarksObtained | number:2}}</b> </td>
                                            <td> <b>{{PLDBOverallRating.PercentageObtained}}</b> </td>
                                            <td> <b>{{PLDBOverallRating.Performance}}</b></td>
                                            <td> <b>{{PLDBOverallRating.Category}}</b> </td>
                                            <td> <b>{{PLDBOverallRating.Rank}}</b> </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>


                            <!-- Criteria -->
                            <div class="rating-criteria" style="width:100%;">
                                <table class="table table-bordered table-striped devtable" id="PLDBCriteria">
                                    <thead>
                                        <tr>
                                            <th style="background:#6f31a1;"> Criteria </th>
                                            <th style="background:#6f31a1;">  Performance </th>
                                            <th style="background:#6f31a1;">  Category  </th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <tr ng-repeat="item in PerformanceCriteria" ng-class="{'outstanding-row': item.Category == 'A+', 'very-good-row': item.Category == 'A','good-row': item.Category == 'B','average-row': item.Category == 'C','unsatisfactory-row': item.Category == 'D'}">
                                            <td><b>{{item.Criteria}}</b></td>
                                            <td><b>{{item.Performance}}</b></td>
                                            <td><b>{{item.Category}}</b></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="button" class="btn btn-primary" ng-click="BackFromPLDB()">
                                Back
                            </button>
                        </div>

                    </div>
                    <div class="text-center mt-3">
                        <button type="button" ng-show="ShowDetails" ng-click="BackToSummary()" class="btn btn-primary dev-btn ng-binding">Back</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="se-pre-con"></div>
    </div>
</div>

