<script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    //For All KPI'S Expect PLDB KPI (Excel)
    async function ExportKPIReportToExcel() {

        var report = document.getElementById("KPIReportExport");

        if (!report) {
            alert("Report not found.");
            return;
        }

        if (typeof ExcelJS === "undefined") {
            alert("ExcelJS library is not loaded.");
            return;
        }

        var workbook = new ExcelJS.Workbook();
        var worksheet = workbook.addWorksheet("KPI Report");
        worksheet.views = [{ showGridLines: false }];

        var COLORS = {
            BLUE: "FF0070C0",
            YELLOW: "FFFFD966",
            PURPLE: "FF6F31A1",
            A_PLUS: "FF7D9631",
            A: "FF92D051",
            B: "FFFFFF01",
            C: "FFFDC100",
            D: "FFC11D1C",
            WHITE: "FFFFFFFF",
            BLACK: "FF000000",
            BORDER: "FF1F4E78"
        };

        function applyBorder(cell) {
            cell.border = {
                top: { style: "thin", color: { argb: COLORS.BORDER } },
                bottom: { style: "thin", color: { argb: COLORS.BORDER } },
                left: { style: "thin", color: { argb: COLORS.BORDER } },
                right: { style: "thin", color: { argb: COLORS.BORDER } }
            };
        }

        function applyCellStyle(cell, backgroundColor, fontColor, bold) {

            cell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: backgroundColor } };

            cell.font = { name: "Calibri", size: 11, bold: bold === true, color: { argb: fontColor || COLORS.BLACK } };

            cell.alignment = { horizontal: "left", vertical: "middle", wrapText: true };

            applyBorder(cell);
        }

        function getCriteriaColor(category) {

            category = (category || "").trim();

            switch (category) {

                case "A+":
                    return COLORS.A_PLUS;

                case "A":
                    return COLORS.A;

                case "B":
                    return COLORS.B;

                case "C":
                    return COLORS.C;

                case "D":
                    return COLORS.D;

                default:
                    return COLORS.WHITE;
            }
        }

        function addTableToExcel(table, startRow, tableType) {

            var rows = table.querySelectorAll("tr");

            var currentRow = startRow;

            var occupied = {};

            rows.forEach(function (htmlRow) {

                var cells = htmlRow.querySelectorAll(":scope > th, :scope > td");
                var currentColumn = 1;

                cells.forEach(function (htmlCell) {

                    while (occupied[currentRow + "_" + currentColumn]) {
                        currentColumn++;
                    }

                    var rowspan = parseInt(htmlCell.getAttribute("rowspan") || "1", 10);
                    var colspan = parseInt(htmlCell.getAttribute("colspan") || "1", 10);
                    var startColumn = currentColumn;
                    var endColumn = startColumn + colspan - 1;
                    var startExcelRow = currentRow;
                    var endExcelRow = startExcelRow + rowspan - 1;
                    var excelCell = worksheet.getCell(startExcelRow, startColumn);
                    excelCell.value = htmlCell.innerText.replace(/\s+/g, " ").trim();
                    var isHeader = htmlCell.tagName.toLowerCase() === "th";
                    var backgroundColor = COLORS.WHITE;
                    var fontColor = COLORS.BLACK;

                    if (tableType === "detail") {

                        // Header
                        if (isHeader) {
                            backgroundColor = COLORS.BLUE;
                            fontColor = COLORS.WHITE;
                        }

                        // Total row
                        else if (htmlRow.classList.contains("bg-info")) {
                            backgroundColor = COLORS.BLUE;
                            fontColor = COLORS.WHITE;
                        }

                        // Normal rows
                        else {
                            backgroundColor = COLORS.YELLOW;
                            fontColor = COLORS.BLACK;
                        }
                    }

                    else if (tableType === "performance") {

                        // Header
                        if (isHeader) {

                            backgroundColor = COLORS.PURPLE;
                            fontColor = COLORS.WHITE;
                        }

                        // Data row - Category Wise Color
                        else {

                            var performanceCells = htmlRow.querySelectorAll(":scope > td");

                            var performanceCategory = "";

                            // Category is the 6th column
                            if (performanceCells.length >= 6) {
                                performanceCategory = performanceCells[5].innerText.trim();
                            }

                            // Apply category-wise color
                            if (performanceCategory === "A+") {
                                backgroundColor = COLORS.A_PLUS;
                                fontColor = COLORS.WHITE;

                            }
                            else if (performanceCategory === "A") {
                                backgroundColor = COLORS.A;
                                fontColor = COLORS.BLACK;

                            }
                            else if (performanceCategory === "B") {
                                backgroundColor = COLORS.B;
                                fontColor = COLORS.BLACK;
                            }
                            else if (performanceCategory === "C") {
                                backgroundColor = COLORS.C;
                                fontColor = COLORS.BLACK;
                            }
                            else if (performanceCategory === "D") {
                                backgroundColor = COLORS.D;
                                fontColor = COLORS.WHITE;
                            }
                            else {
                                backgroundColor = COLORS.WHITE;
                                fontColor = COLORS.BLACK;
                            }
                        }
                    }

                    else if (tableType === "criteria") {

                        // Header
                        if (isHeader) {
                            backgroundColor = COLORS.PURPLE;
                            fontColor = COLORS.WHITE;
                        }

                        else {
                            var rowCells = htmlRow.querySelectorAll(":scope > td");

                            var category = "";

                            if (rowCells.length >= 3) {
                                category = rowCells[2].innerText.trim();
                            }

                            backgroundColor = getCriteriaColor(category);
                            if (category === "D") {
                                fontColor = COLORS.WHITE;
                            }
                        }
                    }

                    applyCellStyle(excelCell, backgroundColor, fontColor, isHeader);

                    if (rowspan > 1 || colspan > 1) {
                        worksheet.mergeCells(startExcelRow, startColumn, endExcelRow, endColumn);
                    }

                    for (var r = startExcelRow; r <= endExcelRow; r++) {
                        for (var c = startColumn; c <= endColumn; c++) {
                            occupied[r + "_" + c] = true;
                        }
                    }
                    currentColumn = endColumn + 1;
                });

                worksheet.getRow(currentRow).height = 32;
                currentRow++;
            });

            return currentRow;
        }

        var heading = report.querySelector("h3");
        var currentRow = 1;

        if (heading) {
            var headingCell = worksheet.getCell(currentRow, 1);
            headingCell.value = heading.innerText.trim();
            headingCell.font = { name: "Calibri", size: 16, bold: true, color: { argb: COLORS.BLACK } };
            headingCell.alignment = { horizontal: "center", vertical: "middle" };
            worksheet.mergeCells(currentRow, 1, currentRow, 8);
            worksheet.getRow(currentRow).height = 30;
            currentRow += 2;
        }

        var detailTable = report.querySelector("#KPIDetailTable");

        if (detailTable) {
            currentRow = addTableToExcel(detailTable, currentRow, "detail");
            currentRow += 1;
        }

        var performanceTable = report.querySelector("#KPIPerformanceTable");

        if (performanceTable) {
            currentRow = addTableToExcel(performanceTable, currentRow, "performance");
            currentRow += 1;
        }

        var criteriaTable = report.querySelector("#KPICriteriaTable");

        if (criteriaTable) {
            currentRow = addTableToExcel(criteriaTable, currentRow, "criteria");
        }

        worksheet.getColumn(1).width = 10;
        worksheet.getColumn(2).width = 38;
        worksheet.getColumn(3).width = 48;
        worksheet.getColumn(4).width = 28;
        worksheet.getColumn(5).width = 20;
        worksheet.getColumn(6).width = 20;
        worksheet.getColumn(7).width = 20;
        worksheet.getColumn(8).width = 20;

        worksheet.views = [{ state: "frozen", ySplit: 3, showGridLines: false }];
        var buffer = await workbook.xlsx.writeBuffer();
        var blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
        var url = window.URL.createObjectURL(blob);
        var link = document.createElement("a");
        link.href = url;
        link.download = "KPI_Report.xlsx";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.URL.revokeObjectURL(url);
    }
    //For All KPI'S Expect PLDB KPI (PDF)
    async function ExportKPIReportToPDFold() {

        var report = document.getElementById("KPIReportExport");

        if (!report) {
            alert("Report not found.");
            return;
        }

        if (typeof html2canvas === "undefined") {
            alert("html2canvas library is not loaded.");
            return;
        }

        if (typeof window.jspdf === "undefined") {
            alert("jsPDF library is not loaded.");
            return;
        }

        try {

            if (document.fonts && document.fonts.ready) {
                await document.fonts.ready;
            }

            var reportWidth = report.clientWidth;
            var reportHeight = report.scrollHeight;

            var canvas = await html2canvas(report, {
                scale: 2,
                useCORS: true,
                allowTaint: false,
                backgroundColor: "#ffffff",
                logging: false,
                width: reportWidth,
                height: reportHeight,
                windowWidth: reportWidth,
                windowHeight: reportHeight,
                scrollX: 0,
                scrollY: 0,
                onclone: function (clonedDocument) {

                    var clonedReport = clonedDocument.getElementById("KPIReportExport");

                    if (!clonedReport) {
                        return;
                    }

                    clonedReport.style.width = reportWidth + "px";
                    clonedReport.style.maxWidth = "none";
                    clonedReport.style.minWidth = reportWidth + "px";
                    clonedReport.style.margin = "0";
                    clonedReport.style.padding = "0";
                    clonedReport.style.boxSizing = "border-box";

                    clonedReport.querySelectorAll("table, .table-responsive, .container, .container-fluid").forEach(function (element) {
                        element.style.width = "100%";
                        element.style.maxWidth = "100%";
                        element.style.minWidth = "100%";
                        element.style.marginLeft = "0";
                        element.style.marginRight = "0";
                        element.style.boxSizing = "border-box";
                    });

                    clonedReport.querySelectorAll(".row").forEach(function (row) {
                        row.style.width = "100%";
                        row.style.maxWidth = "100%";
                        row.style.marginLeft = "0";
                        row.style.marginRight = "0";
                        row.style.boxSizing = "border-box";
                    });

                    clonedReport.querySelectorAll("button").forEach(function (button) {
                        button.style.display = "none";
                    });

                    var table = clonedReport.querySelector("#KPIDetailTable");

                    if (!table) {
                        return;
                    }

                    table.style.width = "100%";
                    table.style.maxWidth = "100%";
                    table.style.minWidth = "100%";
                    table.style.marginLeft = "0";
                    table.style.marginRight = "0";
                    table.style.boxSizing = "border-box";

                    var tbody = table.querySelector("tbody");

                    if (!tbody) {
                        return;
                    }

                    var rows = Array.from(tbody.querySelectorAll("tr"));
                    var rowIndex = 0;

                    while (rowIndex < rows.length) {

                        var currentRow = rows[rowIndex];

                        if (currentRow.classList.contains("bg-info")) {
                            rowIndex++;
                            continue;
                        }

                        var cells = Array.from(currentRow.children);

                        if (cells.length < 2) {
                            rowIndex++;
                            continue;
                        }

                        var srNoCell = cells[0];
                        var kpiAreaCell = cells[1];
                        srNoCell.style.textAlign = "right";
                        srNoCell.style.paddingRight = "5px";

                        if (!kpiAreaCell.hasAttribute("rowspan")) {
                            rowIndex++;
                            continue;
                        }

                        var rowspan = parseInt(kpiAreaCell.getAttribute("rowspan"), 10) || 1;
                        srNoCell.removeAttribute("rowspan");
                        kpiAreaCell.removeAttribute("rowspan");
                        kpiAreaCell.style.backgroundColor = "#FFD966";
                        kpiAreaCell.style.background = "#FFD966";
                        kpiAreaCell.style.verticalAlign = "middle";
                        kpiAreaCell.style.border = "1px solid #1F4E78";
                        srNoCell.style.backgroundColor = "#FFD966";
                        srNoCell.style.background = "#FFD966";
                        srNoCell.style.verticalAlign = "middle";
                        srNoCell.style.textAlign = "right";
                        srNoCell.style.paddingRight = "5px";
                        srNoCell.style.border = "1px solid #1F4E78";

                        for (var i = 1; i < rowspan; i++) {

                            var nextRow = rows[rowIndex + i];


                            if (!nextRow) {
                                break;
                            }

                            var blankSrNo = clonedDocument.createElement("td");
                            blankSrNo.innerHTML = "";

                            blankSrNo.style.backgroundColor = "#FFD966";
                            blankSrNo.style.background = "#FFD966";
                            blankSrNo.style.textAlign = "right";
                            blankSrNo.style.paddingRight = "5px";
                            blankSrNo.style.borderLeft = "1px solid #1F4E78";
                            blankSrNo.style.borderRight = "1px solid #1F4E78";
                            blankSrNo.style.borderTop = "none";
                            blankSrNo.style.borderBottom = "none";
                            var blankKpiArea = clonedDocument.createElement("td");
                            blankKpiArea.innerHTML = "";
                            blankKpiArea.style.backgroundColor = "#FFD966";
                            blankKpiArea.style.background = "#FFD966";
                            blankKpiArea.style.borderLeft = "1px solid #1F4E78";
                            blankKpiArea.style.borderRight = "1px solid #1F4E78";
                            blankKpiArea.style.borderTop = "none";
                            blankKpiArea.style.borderBottom = "none";
                            nextRow.insertBefore(blankSrNo, nextRow.firstChild);
                            nextRow.insertBefore(blankKpiArea, nextRow.children[1]);
                        }

                        var lastRow = rows[Math.min(rowIndex + rowspan - 1, rows.length - 1)];


                        if (lastRow) {

                            var lastCells = Array.from(lastRow.children);

                            if (lastCells.length >= 2) {
                                lastCells[0].style.borderBottom = "1px solid #1F4E78";
                                lastCells[1].style.borderBottom = "1px solid #1F4E78";
                            }
                        }
                        rowIndex += rowspan;
                    }
                }
            });

            var { jsPDF } = window.jspdf;

            var pdf = new jsPDF({
                orientation: "landscape",
                unit: "mm",
                format: "a4",
                compress: true
            });

            var pageWidth = 297;
            var pageHeight = 210;
            var margin = 5;
            var availableWidth = pageWidth - (margin * 2);
            var availableHeight = pageHeight - (margin * 2);
            var imageWidth = canvas.width;
            var imageHeight = canvas.height;
            var widthRatio = availableWidth / imageWidth;
            var heightRatio = availableHeight / imageHeight;
            var fitRatio = Math.min(widthRatio, heightRatio);
            var pdfImageWidth = imageWidth * fitRatio;
            var pdfImageHeight = imageHeight * fitRatio;
            var x = (pageWidth - pdfImageWidth) / 2;
            var y = (pageHeight - pdfImageHeight) / 2;
            var pageImage = canvas.toDataURL("image/jpeg", 0.95);
            pdf.addImage(pageImage, "JPEG", x, y, pdfImageWidth, pdfImageHeight);
            pdf.save("KPI_Report.pdf");


        }
        catch (error) {
            console.error("PDF Export Error:", error);
            alert("Unable to generate PDF.");
        }
    }
    //For All KPI'S Expect PLDB KPI (PDFNEw)
    async function ExportKPIReportToPDF() {

        var report = document.getElementById("KPIReportExport");

        if (!report) {
            alert("Report not found.");
            return;
        }

        if (typeof html2canvas === "undefined") {
            alert("html2canvas library is not loaded.");
            return;
        }

        if (typeof window.jspdf === "undefined") {
            alert("jsPDF library is not loaded.");
            return;
        }

        try {

            if (document.fonts && document.fonts.ready) {
                await document.fonts.ready;
            }

            var reportWidth = report.clientWidth;
            var reportHeight = report.scrollHeight;
            var scale = 2;

            // Row boundaries captured from the cloned HTML.
            var rowBoundaries = [];

            var canvas = await html2canvas(report, {
                scale: scale,
                useCORS: true,
                allowTaint: false,
                backgroundColor: "#ffffff",
                logging: false,
                width: reportWidth,
                height: reportHeight,
                windowWidth: reportWidth,
                windowHeight: reportHeight,
                scrollX: 0,
                scrollY: 0,

                onclone: function (clonedDocument) {

                    var clonedReport =
                        clonedDocument.getElementById("KPIReportExport");

                    if (!clonedReport) {
                        return;
                    }

                    clonedReport.style.width = reportWidth + "px";
                    clonedReport.style.maxWidth = "none";
                    clonedReport.style.minWidth = reportWidth + "px";
                    clonedReport.style.margin = "0";
                    clonedReport.style.padding = "0";
                    clonedReport.style.boxSizing = "border-box";

                    clonedReport.querySelectorAll(
                        "table, .table-responsive, .container, .container-fluid"
                    ).forEach(function (element) {

                        element.style.width = "100%";
                        element.style.maxWidth = "100%";
                        element.style.minWidth = "100%";
                        element.style.marginLeft = "0";
                        element.style.marginRight = "0";
                        element.style.boxSizing = "border-box";
                    });

                    clonedReport.querySelectorAll(".row").forEach(function (row) {

                        row.style.width = "100%";
                        row.style.maxWidth = "100%";
                        row.style.marginLeft = "0";
                        row.style.marginRight = "0";
                        row.style.boxSizing = "border-box";
                    });

                    clonedReport.querySelectorAll("button").forEach(function (button) {
                        button.style.display = "none";
                    });

                    var table =
                        clonedReport.querySelector("#KPIDetailTable");

                    if (table) {

                        table.style.width = "100%";
                        table.style.maxWidth = "100%";
                        table.style.minWidth = "100%";
                        table.style.marginLeft = "0";
                        table.style.marginRight = "0";
                        table.style.boxSizing = "border-box";

                        var tbody = table.querySelector("tbody");

                        if (tbody) {

                            var rows = Array.from(
                                tbody.querySelectorAll("tr")
                            );

                            var rowIndex = 0;

                            while (rowIndex < rows.length) {

                                var currentRow = rows[rowIndex];

                                if (currentRow.classList.contains("bg-info")) {
                                    rowIndex++;
                                    continue;
                                }

                                var cells = Array.from(
                                    currentRow.children
                                );

                                if (cells.length < 2) {
                                    rowIndex++;
                                    continue;
                                }

                                var srNoCell = cells[0];
                                var kpiAreaCell = cells[1];

                                srNoCell.style.textAlign = "right";
                                srNoCell.style.paddingRight = "5px";

                                if (!kpiAreaCell.hasAttribute("rowspan")) {
                                    rowIndex++;
                                    continue;
                                }

                                var rowspan =
                                    parseInt(
                                        kpiAreaCell.getAttribute("rowspan"),
                                        10
                                    ) || 1;

                                srNoCell.removeAttribute("rowspan");
                                kpiAreaCell.removeAttribute("rowspan");

                                kpiAreaCell.style.backgroundColor = "#FFD966";
                                kpiAreaCell.style.background = "#FFD966";
                                kpiAreaCell.style.verticalAlign = "middle";
                                kpiAreaCell.style.border =
                                    "1px solid #1F4E78";

                                srNoCell.style.backgroundColor = "#FFD966";
                                srNoCell.style.background = "#FFD966";
                                srNoCell.style.verticalAlign = "middle";
                                srNoCell.style.textAlign = "right";
                                srNoCell.style.paddingRight = "5px";
                                srNoCell.style.border =
                                    "1px solid #1F4E78";

                                for (var i = 1; i < rowspan; i++) {

                                    var nextRow = rows[rowIndex + i];

                                    if (!nextRow) {
                                        break;
                                    }

                                    var blankSrNo =
                                        clonedDocument.createElement("td");

                                    blankSrNo.innerHTML = "";
                                    blankSrNo.style.backgroundColor = "#FFD966";
                                    blankSrNo.style.background = "#FFD966";
                                    blankSrNo.style.textAlign = "right";
                                    blankSrNo.style.paddingRight = "5px";
                                    blankSrNo.style.borderLeft =
                                        "1px solid #1F4E78";
                                    blankSrNo.style.borderRight =
                                        "1px solid #1F4E78";
                                    blankSrNo.style.borderTop = "none";
                                    blankSrNo.style.borderBottom = "none";

                                    var blankKpiArea =
                                        clonedDocument.createElement("td");

                                    blankKpiArea.innerHTML = "";
                                    blankKpiArea.style.backgroundColor = "#FFD966";
                                    blankKpiArea.style.background = "#FFD966";
                                    blankKpiArea.style.borderLeft =
                                        "1px solid #1F4E78";
                                    blankKpiArea.style.borderRight =
                                        "1px solid #1F4E78";
                                    blankKpiArea.style.borderTop = "none";
                                    blankKpiArea.style.borderBottom = "none";

                                    nextRow.insertBefore(
                                        blankSrNo,
                                        nextRow.firstChild
                                    );

                                    nextRow.insertBefore(
                                        blankKpiArea,
                                        nextRow.children[1]
                                    );
                                }

                                var lastRow = rows[
                                    Math.min(
                                        rowIndex + rowspan - 1,
                                        rows.length - 1
                                    )
                                ];

                                if (lastRow) {

                                    var lastCells =
                                        Array.from(lastRow.children);

                                    if (lastCells.length >= 2) {
                                        lastCells[0].style.borderBottom =
                                            "1px solid #1F4E78";

                                        lastCells[1].style.borderBottom =
                                            "1px solid #1F4E78";
                                    }
                                }

                                rowIndex += rowspan;
                            }
                        }
                    }

                    // Capture actual row boundaries AFTER formatting.
                    var reportRect =
                        clonedReport.getBoundingClientRect();

                    var reportTop = reportRect.top;

                    rowBoundaries = Array.from(
                        clonedReport.querySelectorAll("#KPIDetailTable tr")
                    ).map(function (row) {

                        var rect = row.getBoundingClientRect();

                        return {
                            top: Math.round(
                                (rect.top - reportTop) * scale
                            ),
                            bottom: Math.round(
                                (rect.bottom - reportTop) * scale
                            )
                        };

                    }).filter(function (boundary) {
                        return boundary.bottom > boundary.top;
                    });

                }
            });

            var { jsPDF } = window.jspdf;

            var pdf = new jsPDF({
                orientation: "landscape",
                unit: "mm",
                format: "a4",
                compress: true
            });

            var pageWidth = 297;
            var pageHeight = 210;
            var margin = 5;

            var availableWidth = pageWidth - (margin * 2);
            var availableHeight = pageHeight - (margin * 2);

            var imageWidth = canvas.width;
            var imageHeight = canvas.height;

            var widthRatio = availableWidth / imageWidth;

            // Maximum image height that fits on one PDF page.
            var maxSliceHeight = Math.floor(
                availableHeight / widthRatio
            );

            // If the complete report fits, export a single page.
            if (imageHeight <= maxSliceHeight) {

                var fitRatio = Math.min(
                    availableWidth / imageWidth,
                    availableHeight / imageHeight
                );

                var pdfImageWidth = imageWidth * fitRatio;
                var pdfImageHeight = imageHeight * fitRatio;

                var x = (pageWidth - pdfImageWidth) / 2;
                var y = (pageHeight - pdfImageHeight) / 2;

                pdf.addImage(
                    canvas.toDataURL("image/jpeg", 0.95),
                    "JPEG",
                    x,
                    y,
                    pdfImageWidth,
                    pdfImageHeight
                );

            } else {

                var currentY = 0;
                var pageNumber = 0;

                // Avoid cutting a table row across page boundaries.
                while (currentY < imageHeight) {

                    var targetY = Math.min(
                        currentY + maxSliceHeight,
                        imageHeight
                    );

                    var sliceEnd = targetY;

                    if (targetY < imageHeight) {

                        // Find rows that cross the proposed page boundary.
                        var crossingRows = rowBoundaries.filter(
                            function (boundary) {
                                return boundary.top < targetY &&
                                    boundary.bottom > targetY;
                            }
                        );

                        if (crossingRows.length > 0) {

                            // Move the boundary to the start of the
                            // first row crossing the proposed boundary.
                            var safeBoundary = Math.min.apply(
                                null,
                                crossingRows.map(function (boundary) {
                                    return boundary.top;
                                })
                            );

                            if (safeBoundary > currentY) {
                                sliceEnd = safeBoundary;
                            } else {

                                // A single row is taller than the page.
                                // It cannot fit intact on a normal page.
                                sliceEnd = targetY;
                            }
                        }
                    }

                    // Ensure forward progress.
                    if (sliceEnd <= currentY) {
                        sliceEnd = Math.min(
                            currentY + maxSliceHeight,
                            imageHeight
                        );
                    }

                    var sliceHeight = sliceEnd - currentY;

                    var pageCanvas =
                        document.createElement("canvas");

                    pageCanvas.width = imageWidth;
                    pageCanvas.height = sliceHeight;

                    var ctx = pageCanvas.getContext("2d");

                    if (!ctx) {
                        throw new Error(
                            "Unable to create page canvas."
                        );
                    }

                    ctx.fillStyle = "#ffffff";
                    ctx.fillRect(
                        0,
                        0,
                        pageCanvas.width,
                        pageCanvas.height
                    );

                    ctx.drawImage(
                        canvas,
                        0,
                        currentY,
                        imageWidth,
                        sliceHeight,
                        0,
                        0,
                        imageWidth,
                        sliceHeight
                    );

                    if (pageNumber > 0) {
                        pdf.addPage("a4", "landscape");
                    }

                    var pageImage =
                        pageCanvas.toDataURL("image/jpeg", 0.95);

                    pdf.addImage(
                        pageImage,
                        "JPEG",
                        margin,
                        margin,
                        availableWidth,
                        sliceHeight * widthRatio
                    );

                    currentY = sliceEnd;
                    pageNumber++;

                    pageCanvas.width = 0;
                    pageCanvas.height = 0;
                }
            }

            pdf.save("KPI_Report.pdf");

            canvas.width = 0;
            canvas.height = 0;

        }
        catch (error) {

            console.error("PDF Export Error:", error);
            alert("Unable to generate PDF.");
        }
    }
    //For PLDB KPI (Excel)
    async function ExportKPIPLDBReportToExcel() {

        var report = document.getElementById("PLDBReportExport");

        if (!report) {
            alert("Report not found.");
            return;
        }

        if (typeof ExcelJS === "undefined") {
            alert("ExcelJS library is not loaded.");
            return;
        }

        var workbook = new ExcelJS.Workbook();
        var worksheet = workbook.addWorksheet("KPI Report");

        worksheet.views = [{
            showGridLines: false
        }];

        var COLORS = {
            BLUE: "FF0070C0",
            YELLOW: "FFFFD966",
            PURPLE: "FF6F31A1",
            A_PLUS: "FF7D9631",
            A: "FF92D051",
            B: "FFFFFF01",
            C: "FFFDC100",
            D: "FFC11D1C",
            WHITE: "FFFFFFFF",
            BLACK: "FF000000",
            BORDER: "FF1F4E78"
        };

        function applyBorder(cell) {

            cell.border = {
                top: { style: "thin", color: { argb: COLORS.BORDER } },
                bottom: { style: "thin", color: { argb: COLORS.BORDER } },
                left: { style: "thin", color: { argb: COLORS.BORDER } },
                right: { style: "thin", color: { argb: COLORS.BORDER } }
            };
        }

        function applyCellStyle(cell, backgroundColor, fontColor, bold) {

            cell.fill = {
                type: "pattern", pattern: "solid", fgColor: { argb: backgroundColor }
            };

            cell.font = {
                name: "Calibri", size: 11, bold: bold === true, color: { argb: fontColor || COLORS.BLACK }
            };

            cell.alignment = {
                horizontal: "left", vertical: "middle", wrapText: true
            };

            applyBorder(cell);
        }

        function getCriteriaColor(category) {

            category = (category || "").trim();

            switch (category) {

                case "A+":
                    return COLORS.A_PLUS;

                case "A":
                    return COLORS.A;

                case "B":
                    return COLORS.B;

                case "C":
                    return COLORS.C;

                case "D":
                    return COLORS.D;

                default:
                    return COLORS.WHITE;
            }
        }

        function addTableToExcel(table, startRow, tableType) {

            var rows = table.querySelectorAll("tr");
            var currentRow = startRow;
            var occupied = {};

            rows.forEach(function (htmlRow) {

                var cells = htmlRow.querySelectorAll(":scope > th, :scope > td");
                var currentColumn = 1;

                cells.forEach(function (htmlCell) {

                    while (occupied[currentRow + "_" + currentColumn]) {
                        currentColumn++;
                    }

                    var rowspan = parseInt(htmlCell.getAttribute("rowspan") || "1", 10);
                    var colspan = parseInt(htmlCell.getAttribute("colspan") || "1", 10);

                    var startColumn = currentColumn;
                    var endColumn = startColumn + colspan - 1;
                    var startExcelRow = currentRow;
                    var endExcelRow = startExcelRow + rowspan - 1;
                    var excelCell = worksheet.getCell(startExcelRow, startColumn);
                    excelCell.value = htmlCell.innerText.replace(/\s+/g, " ").trim();
                    var isHeader = htmlCell.tagName.toLowerCase() === "th";
                    var backgroundColor = COLORS.WHITE;
                    var fontColor = COLORS.BLACK;

                    if (tableType === "detail") {

                        if (isHeader) {
                            backgroundColor = COLORS.BLUE;
                            fontColor = COLORS.WHITE;
                        }
                        else if (htmlRow.classList.contains("bg-info")) {
                            backgroundColor = COLORS.BLUE;
                            fontColor = COLORS.WHITE;
                        }
                        else {
                            backgroundColor = COLORS.YELLOW;
                            fontColor = COLORS.BLACK;
                        }
                    }
                    else if (tableType === "performance") {

                        if (isHeader) {
                            backgroundColor = COLORS.PURPLE;
                            fontColor = COLORS.WHITE;
                        }
                        else {
                            var performanceCells = htmlRow.querySelectorAll(":scope > td");

                            var performanceCategory = "";

                            if (performanceCells.length >= 6) {
                                performanceCategory = performanceCells[5].innerText.trim();
                            }

                            if (performanceCategory === "A+") {
                                backgroundColor = COLORS.A_PLUS;
                                fontColor = COLORS.WHITE;
                            }
                            else if (performanceCategory === "A") {
                                backgroundColor = COLORS.A;
                                fontColor = COLORS.BLACK;
                            }
                            else if (performanceCategory === "B") {
                                backgroundColor = COLORS.B;
                                fontColor = COLORS.BLACK;
                            }
                            else if (performanceCategory === "C") {
                                backgroundColor = COLORS.C;
                                fontColor = COLORS.BLACK;
                            }
                            else if (performanceCategory === "D") {
                                backgroundColor = COLORS.D;
                                fontColor = COLORS.WHITE;
                            }
                            else {

                                backgroundColor = COLORS.WHITE;
                                fontColor = COLORS.BLACK;
                            }
                        }
                    }
                    else if (tableType === "criteria") {

                        if (isHeader) {
                            backgroundColor = COLORS.PURPLE;
                            fontColor = COLORS.WHITE;
                        }
                        else {

                            var rowCells = htmlRow.querySelectorAll(":scope > td");
                            var category = "";
                            if (rowCells.length >= 3) {
                                category = rowCells[2].innerText.trim();
                            }
                            backgroundColor = getCriteriaColor(category);
                            if (category === "D") {
                                fontColor = COLORS.WHITE;
                            }
                        }
                    }

                    applyCellStyle(excelCell, backgroundColor, fontColor, isHeader);

                    if (rowspan > 1 || colspan > 1) {
                        worksheet.mergeCells(startExcelRow, startColumn, endExcelRow, endColumn);
                    }

                    for (var r = startExcelRow; r <= endExcelRow; r++) {
                        for (var c = startColumn; c <= endColumn; c++) {
                            occupied[r + "_" + c] = true;
                        }
                    }

                    currentColumn = endColumn + 1;
                });

                worksheet.getRow(currentRow).height = 32;

                currentRow++;
            });

            return currentRow;
        }

        var heading = report.querySelector("h3");
        var currentRow = 1;

        var TOTAL_COLUMNS = 8;

        if (heading) {
            var headingCell = worksheet.getCell(currentRow, 1);
            headingCell.value = heading.innerText.trim();
            headingCell.font = { name: "Calibri", size: 16, bold: true, color: { argb: COLORS.BLACK } };
            headingCell.alignment = { horizontal: "center", vertical: "middle" };
            worksheet.mergeCells(currentRow, 1, currentRow, TOTAL_COLUMNS);
            worksheet.getRow(currentRow).height = 30;
            currentRow += 2;
        }

        var detailTable = report.querySelector("#PLDBReportDetails");

        if (detailTable) {
            currentRow = addTableToExcel(detailTable, currentRow, "detail");
            currentRow += 1;
        }

        var performanceTable = report.querySelector("#PLDBOverRating");

        if (performanceTable) {
            currentRow = addTableToExcel(performanceTable, currentRow, "performance");
            currentRow += 1;
        }

        var criteriaTable = report.querySelector("#PLDBCriteria");

        if (criteriaTable) {
            currentRow = addTableToExcel(criteriaTable, currentRow, "criteria");
        }

        worksheet.getColumn(1).width = 10;
        worksheet.getColumn(2).width = 38;
        worksheet.getColumn(3).width = 48;
        worksheet.getColumn(4).width = 28;
        worksheet.getColumn(5).width = 20;
        worksheet.getColumn(6).width = 20;
        worksheet.getColumn(7).width = 20;
        worksheet.getColumn(8).width = 20;

        worksheet.pageSetup = {
            paperSize: 9, // A4
            orientation: "landscape",
            fitToPage: true,
            fitToWidth: 1,
            fitToHeight: 0,
            margins: {
                left: 0.25,
                right: 0.25,
                top: 0.5,
                bottom: 0.5,
                header: 0.2,
                footer: 0.2
            }
        };

        worksheet.pageSetup.printArea = "A1:H" + (currentRow - 1);
        worksheet.views = [{ state: "frozen", ySplit: 3, showGridLines: false }];
        var buffer = await workbook.xlsx.writeBuffer();
        var blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
        var url = window.URL.createObjectURL(blob);
        var link = document.createElement("a");
        link.href = url;
        link.download = "KPI_Report.xlsx";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.URL.revokeObjectURL(url);
    }
    //For PLDB KPI (PDF)
    async function ExportKPIPLDBReportToPDF() {

        var report = document.getElementById("PLDBReportExport");

        if (!report) {
            alert("Report not found.");
            return;
        }

        if (typeof html2canvas === "undefined") {
            alert("html2canvas library is not loaded.");
            return;
        }

        if (typeof window.jspdf === "undefined") {
            alert("jsPDF library is not loaded.");
            return;
        }

        try {

            if (document.fonts && document.fonts.ready) {
                await document.fonts.ready;
            }

            var reportWidth = report.clientWidth;
            var reportHeight = report.scrollHeight;

            var canvas = await html2canvas(report, {
                scale: 2,
                useCORS: true,
                allowTaint: false,
                backgroundColor: "#ffffff",
                logging: false,
                width: reportWidth,
                height: reportHeight,
                windowWidth: reportWidth,
                windowHeight: reportHeight,
                scrollX: 0,
                scrollY: 0,
                onclone: function (clonedDocument) {

                    var clonedReport = clonedDocument.getElementById("PLDBReportExport");

                    if (!clonedReport) {
                        return;
                    }

                    clonedReport.style.width = reportWidth + "px";
                    clonedReport.style.maxWidth = "none";
                    clonedReport.style.minWidth = reportWidth + "px";
                    clonedReport.style.margin = "0";
                    clonedReport.style.padding = "0";
                    clonedReport.style.boxSizing = "border-box";

                    clonedReport.querySelectorAll("table, .table-responsive, .container, .container-fluid").forEach(function (element) {
                        element.style.width = "100%";
                        element.style.maxWidth = "100%";
                        element.style.minWidth = "100%";
                        element.style.marginLeft = "0";
                        element.style.marginRight = "0";
                        element.style.boxSizing = "border-box";
                    });

                    clonedReport.querySelectorAll(".row").forEach(function (row) {
                        row.style.width = "100%";
                        row.style.maxWidth = "100%";
                        row.style.marginLeft = "0";
                        row.style.marginRight = "0";
                        row.style.boxSizing = "border-box";
                    });

                    clonedReport.querySelectorAll("button").forEach(function (button) {
                        button.style.display = "none";
                    });

                    var table = clonedReport.querySelector("#PLDBReportDetails");

                    if (!table) {
                        return;
                    }

                    table.style.width = "100%";
                    table.style.maxWidth = "100%";
                    table.style.minWidth = "100%";
                    table.style.marginLeft = "0";
                    table.style.marginRight = "0";
                    table.style.boxSizing = "border-box";

                    var tbody = table.querySelector("tbody");

                    if (!tbody) {
                        return;
                    }

                    var rows = Array.from(tbody.querySelectorAll("tr"));
                    var rowIndex = 0;

                    while (rowIndex < rows.length) {

                        var currentRow = rows[rowIndex];

                        if (currentRow.classList.contains("bg-info")) {
                            rowIndex++;
                            continue;
                        }

                        var cells = Array.from(currentRow.children);

                        if (cells.length < 2) {
                            rowIndex++;
                            continue;
                        }

                        var srNoCell = cells[0];
                        var kpiAreaCell = cells[1];
                        srNoCell.style.textAlign = "right";
                        srNoCell.style.paddingRight = "5px";

                        if (!kpiAreaCell.hasAttribute("rowspan")) {
                            rowIndex++;
                            continue;
                        }

                        var rowspan = parseInt(kpiAreaCell.getAttribute("rowspan"), 10) || 1;
                        srNoCell.removeAttribute("rowspan");
                        kpiAreaCell.removeAttribute("rowspan");
                        kpiAreaCell.style.backgroundColor = "#FFD966";
                        kpiAreaCell.style.background = "#FFD966";
                        kpiAreaCell.style.verticalAlign = "middle";
                        kpiAreaCell.style.border = "1px solid #1F4E78";
                        srNoCell.style.backgroundColor = "#FFD966";
                        srNoCell.style.background = "#FFD966";
                        srNoCell.style.verticalAlign = "middle";
                        srNoCell.style.textAlign = "right";
                        srNoCell.style.paddingRight = "5px";
                        srNoCell.style.border = "1px solid #1F4E78";

                        for (var i = 1; i < rowspan; i++) {

                            var nextRow = rows[rowIndex + i];


                            if (!nextRow) {
                                break;
                            }

                            var blankSrNo = clonedDocument.createElement("td");
                            blankSrNo.innerHTML = "";

                            blankSrNo.style.backgroundColor = "#FFD966";
                            blankSrNo.style.background = "#FFD966";
                            blankSrNo.style.textAlign = "right";
                            blankSrNo.style.paddingRight = "5px";
                            blankSrNo.style.borderLeft = "1px solid #1F4E78";
                            blankSrNo.style.borderRight = "1px solid #1F4E78";
                            blankSrNo.style.borderTop = "none";
                            blankSrNo.style.borderBottom = "none";
                            var blankKpiArea = clonedDocument.createElement("td");
                            blankKpiArea.innerHTML = "";
                            blankKpiArea.style.backgroundColor = "#FFD966";
                            blankKpiArea.style.background = "#FFD966";
                            blankKpiArea.style.borderLeft = "1px solid #1F4E78";
                            blankKpiArea.style.borderRight = "1px solid #1F4E78";
                            blankKpiArea.style.borderTop = "none";
                            blankKpiArea.style.borderBottom = "none";
                            nextRow.insertBefore(blankSrNo, nextRow.firstChild);
                            nextRow.insertBefore(blankKpiArea, nextRow.children[1]);
                        }

                        var lastRow = rows[Math.min(rowIndex + rowspan - 1, rows.length - 1)];


                        if (lastRow) {

                            var lastCells = Array.from(lastRow.children);

                            if (lastCells.length >= 2) {
                                lastCells[0].style.borderBottom = "1px solid #1F4E78";
                                lastCells[1].style.borderBottom = "1px solid #1F4E78";
                            }
                        }
                        rowIndex += rowspan;
                    }
                }
            });

            var { jsPDF } = window.jspdf;

            var pdf = new jsPDF({
                orientation: "landscape",
                unit: "mm",
                format: "a4",
                compress: true
            });

            var pageWidth = 297;
            var pageHeight = 210;
            var margin = 5;
            var availableWidth = pageWidth - (margin * 2);
            var availableHeight = pageHeight - (margin * 2);
            var imageWidth = canvas.width;
            var imageHeight = canvas.height;
            var widthRatio = availableWidth / imageWidth;
            var heightRatio = availableHeight / imageHeight;
            var fitRatio = Math.min(widthRatio, heightRatio);
            var pdfImageWidth = imageWidth * fitRatio;
            var pdfImageHeight = imageHeight * fitRatio;
            var x = (pageWidth - pdfImageWidth) / 2;
            var y = (pageHeight - pdfImageHeight) / 2;
            var pageImage = canvas.toDataURL("image/jpeg", 0.95);
            pdf.addImage(pageImage, "JPEG", x, y, pdfImageWidth, pdfImageHeight);
            pdf.save("KPI_Report.pdf");


        }
        catch (error) {
            console.error("PDF Export Error:", error);
            alert("Unable to generate PDF.");
        }
    }
    //Offices Excel
    async function ExportKPIReportListToExcel() {

        var table = document.getElementById("KPIReportListTable");

        if (!table) {
            alert("KPI Report List table not found.");
            return;
        }

        if (typeof ExcelJS === "undefined") {
            alert("ExcelJS library is not loaded.");
            return;
        }

        try {

            var workbook = new ExcelJS.Workbook();

            var worksheet = workbook.addWorksheet("KPI Report List");

            worksheet.views = [{ showGridLines: false }];

            var COLORS = { PURPLE: "FF6F31A1", WHITE: "FFFFFFFF", BLACK: "FF000000", BORDER: "FF1F4E78", A_PLUS: "FF7D9631", A: "FF92D051", B: "FFFFFF01", C: "FFFDC100", D: "FFC11D1C" };

            function applyBorder(cell) {

                cell.border = {
                    top: {
                        style: "thin",
                        color: {
                            argb: COLORS.BORDER
                        }
                    },
                    bottom: {
                        style: "thin",
                        color: {
                            argb: COLORS.BORDER
                        }
                    },
                    left: {
                        style: "thin",
                        color: {
                            argb: COLORS.BORDER
                        }
                    },
                    right: {
                        style: "thin",
                        color: {
                            argb: COLORS.BORDER
                        }
                    }
                };
            }

            var currentRow = 1;

            var titleCell = worksheet.getCell(currentRow, 1);

            titleCell.value = "KPI Report List";

            titleCell.font = {
                name: "Calibri",
                size: 16,
                bold: true,
                color: {
                    argb: COLORS.BLACK
                }
            };

            titleCell.alignment = {
                horizontal: "center",
                vertical: "middle"
            };

            worksheet.mergeCells(currentRow, 1, currentRow, 8);

            worksheet.getRow(currentRow).height = 30;

            currentRow += 2;

            var rows = table.querySelectorAll("tr");

            rows.forEach(function (htmlRow) {

                var cells = htmlRow.querySelectorAll(
                    ":scope > th, :scope > td"
                );

                var cellsToExport = [];

                for (var i = 0; i < cells.length - 1; i++) {

                    cellsToExport.push(cells[i]);

                }

                var excelRow = worksheet.getRow(currentRow);

                cellsToExport.forEach(function (htmlCell, index) {

                    var cell = excelRow.getCell(index + 1);

                    var value = htmlCell.innerText.replace(/\s+/g, " ").trim();

                    cell.value = value;


                    // Header
                    if (htmlCell.tagName.toLowerCase() === "th") {

                        cell.fill = {
                            type: "pattern",
                            pattern: "solid",
                            fgColor: {
                                argb: COLORS.PURPLE
                            }
                        };

                        cell.font = {
                            name: "Calibri",
                            size: 11,
                            bold: true,
                            color: {
                                argb: COLORS.WHITE
                            }
                        };

                        cell.alignment = {
                            horizontal: "center",
                            vertical: "middle",
                            wrapText: true
                        };

                    }

                    // Data
                    else {

                        cell.font = {
                            name: "Calibri",
                            size: 11,
                            color: {
                                argb: COLORS.BLACK
                            }
                        };

                        cell.alignment = {
                            horizontal: "center",
                            vertical: "middle",
                            wrapText: true
                        };


                        // Category based row color
                        var category = "";

                        var rowCells = htmlRow.querySelectorAll(":scope > th, :scope > td");

                        // Category is second-last column before Action
                        if (rowCells.length >= 2) {

                            category = rowCells[rowCells.length - 2].innerText.trim();

                        }


                        switch (category) {

                            case "A+":

                                cell.fill = {
                                    type: "pattern",
                                    pattern: "solid",
                                    fgColor: {
                                        argb: COLORS.A_PLUS
                                    }
                                };

                                break;


                            case "A":

                                cell.fill = {
                                    type: "pattern",
                                    pattern: "solid",
                                    fgColor: {
                                        argb: COLORS.A
                                    }
                                };

                                break;


                            case "B":

                                cell.fill = {
                                    type: "pattern",
                                    pattern: "solid",
                                    fgColor: {
                                        argb: COLORS.B
                                    }
                                };

                                break;


                            case "C":

                                cell.fill = {
                                    type: "pattern",
                                    pattern: "solid",
                                    fgColor: {
                                        argb: COLORS.C
                                    }
                                };

                                break;


                            case "D":

                                cell.fill = {
                                    type: "pattern",
                                    pattern: "solid",
                                    fgColor: {
                                        argb: COLORS.D
                                    }
                                };

                                cell.font = {
                                    name: "Calibri",
                                    size: 11,
                                    color: {
                                        argb: COLORS.WHITE
                                    }
                                };

                                break;
                        }
                    }

                    applyBorder(cell);

                });

                excelRow.height = 25;
                currentRow++;
            });

            worksheet.getColumn(1).width = 10;
            worksheet.getColumn(2).width = 30;
            worksheet.getColumn(3).width = 20;
            worksheet.getColumn(4).width = 22;
            worksheet.getColumn(5).width = 15;
            worksheet.getColumn(6).width = 20;
            worksheet.getColumn(7).width = 15;
            worksheet.getColumn(8).width = 10;


            // Freeze header row
            worksheet.views = [{ state: "frozen", ySplit: 3, showGridLines: false }];

            var buffer = await workbook.xlsx.writeBuffer();

            var blob = new Blob(
                [buffer],
                {
                    type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                }
            );

            var url = window.URL.createObjectURL(blob);
            var link = document.createElement("a");
            link.href = url;
            link.download = "KPI_Report_List.xlsx";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(url);

        }
        catch (error) {
            console.error("KPI Report List Excel Export Error:", error);
            alert("Unable to export KPI Report List.");
        }
    }
