                        <td><input type="number" class="form-control" placeholder="Number" ng-model="Coop.OmStN1" /></td>
                        <td><input type="number" class="form-control" placeholder="In Thousands" ng-model="Coop.OmStR" /></td>
                    </tr>

                </tbody>
            </table>
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 text-center">
                    <button type="submit" class="btn btn-primary dev-btn" ng-click="MainCooperativeSocieties()">Save</button>
                    <button type="button" class="btn btn-primary dev-btn">Reset</button>
                    <button type="submit" class="btn btn-primary dev-btn" ng-click="back()">Back</button>
                </div>
            </div>
        </div>
    </div>
</div>