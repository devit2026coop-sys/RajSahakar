@{
    ViewBag.Title = "NI Act Report";
}
<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }

    .tblthfont {
        font-weight: bold;
    }
</style>
<script src="~/Scripts/AngularFramework/NiActReport.js?v=1"></script>
<div ng-app="niactPRMod" ng-controller="niactPRCtrl" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
        <input type="hidden" id="hdnPldbId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
        <input type="hidden" id="hdnPldbBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />

        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; NI Act Report</b>
                <div class="text-right">
                    @*<button ng-click="BackToPage()" class="btn btn-primary dev-btn">Back To List</button>*@
                    <button ng-show="NIActSummary!=null && NIActSummary.length>0" ng-click="ReportDownload()" class="btn btn-primary dev-btn">Export Excel</button>
                </div>
            </div>
            <div class="panel-body">
                <input type="hidden" id="hdnDistrictId" ng-model="search.LoanDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                <div class="row">

                    <div class="col-md-2 form-group" ng-show="false">
                        <label>{{ translation.District}}<span class="error">*</span></label>
                        <select id="DISTRICT_ID" ng-model="search.DISTRICT_ID" class="form-control" ng-init="search.DISTRICT_ID='0'" ng-change="PLDBListData(0)">
                            <option value="0">{{translation.SelectOption}}</option>
                            <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>

                    <div class="col-lg-2 form-group " id="ddlPLDBID">
                        <label for="PLDB_ID">{{ translation.PLDB}} </label>
                        <select id="PLDB_ID" name="PLDB_ID" ng-model="search.PLDB_ID" class="form-control" ng-init="PLDB_ID='0'" ng-change="PLDBBranchList('0')">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemPLDB in PLDBList  track by itemPLDB.PldbId " value="{{itemPLDB.PldbId}}">
                                {{itemPLDB.PLDBName}}
                            </option>
                        </select>
                    </div>

                    <div class="col-lg-2 form-group" id="ddlPldbBranchID">
                        <label for="PLDB_Branch_ID">{{ translation.Branch}}</label>
                        <select ng-model="search.PLDB_Branch_ID" name="PLDB_Branch_ID" id="PLDB_Branch_ID" class="form-control" ng-init="PLDB_Branch_ID='0'" ng-change="GetPldbNIActDetails('0')">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemBlock in PLDBBranches " value="{{itemBlock.BLOCK_ID}}">
                                {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="table-responsive devtable">
                    <table class="table table-hover table-striped table-bordered mb-0" id="{{NIACTReport}}">
                        <thead>
                            <tr>
                                <th width="60">{{translation.SRNO}}</th>
                                <th>{{translation.PLDB }}</th>
                                <th>Recoverable From Loanee</th>
                                <th>Relief Amount </th>
                                <th>Total Amount</th>
                                <th>Legal Action Taken NI Act</th>
                                <th>Recovery Amount</th>
                            </tr>

                        </thead>
                        <tbody>
                            <tr ng-if="NIActSummary && NIActSummary.length > 0" ng-repeat="item in NIActSummary">
                                <td><span ng-hide="item.PLDBName=='Total'">{{$index+1}}.</span></td>
                                <td ng-style="(item.PLDBName == 'Total') && {'font-weight': 'bold', 'color': 'black'}">{{item.PLDBName}}</td>
                                <td ng-style="(item.PLDBName == 'Total') && {'font-weight': 'bold', 'color': 'black'}">{{item.RecoverableFromLoanee|inrCurrency}}</td>
                                <td ng-style="(item.PLDBName == 'Total') && {'font-weight': 'bold', 'color': 'black'}">{{item.ReliefAmount|inrCurrency}}</td>
                                <td ng-style="(item.PLDBName == 'Total') && {'font-weight': 'bold', 'color': 'black'}">{{item.TotalAmount|inrCurrency}}</td>
                                <td ng-style="(item.PLDBName == 'Total') && {'font-weight': 'bold', 'color': 'black'}">{{item.LegalActiontakenNIAct}}</td>
                                <td ng-style="(item.PLDBName == 'Total') && {'font-weight': 'bold', 'color': 'black'}">{{item.RecoveryAmount|inrCurrency}}</td>
                            </tr>
                            <tr ng-if="(!NIActSummary || NIActSummary.length === 0)">
                                <td colspan="{{colspan}}" style="text-align: center;">No Records</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>
