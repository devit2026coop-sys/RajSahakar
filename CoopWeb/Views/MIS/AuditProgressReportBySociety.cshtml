
<script src="~/Scripts/AngularFramework/AuditProgressReportBySociety.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />

<style>
    .footer-bold td {
        font-weight: bold;
    }
</style>

@Html.Hidden("TemplateId")
<div ng-app="AuditProgressReportBySociety" ng-controller="AuditProgressReportBySocietycnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">सहकारी सोसाइटी से प्राप्त प्रस्तावों के आधार पर ऑडिट प्रगति की स्थिति क्षेत्रिय अंकेष्ण अधिकारी / विशेष लेखा परीक्षक-</h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.AuditProgressReportBySociety}}   </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div class="table-dropdown" id="search-filter" style="overflow:inherit; float:left;width: 100%;margin-bottom: 10px;">
                @*<div class="col-lg-3 form-group">
                    <label>{{translation.YEAR}}</label>
                    <select class="form-control" id="ddlFYearId" ng-model="Liqudation.FYearId" ng-init="Liqudation.FYearId='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_END}}">
                            {{item.FIN_YEAR_END}}
                        </option>
                    </select>
                </div>*@
              
                <div class="col-md-2 margin-Top20 y_dropdown" style="padding-left: 0;">
                    <label for="search" class="ng-binding">{{translation.Month}}:</label>
                    <input id="txtFromMonth" value="month" @*ng-model="monthD"*@ type="month" class="form-control" autocomplete="off" onkeypress="return false;" />
                </div>

                <div class="col-lg-3 form-group">
                    <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="GridData2()">{{translation.Show}}</button>
                </div>
            </div>
            <table class="table table-responsive devtable" style="overflow-x:auto;">
                <thead>
                    <tr>
                        <th rowspan="2" style="text-align: center !important;vertical-align:middle;">
                            क्र.स
                        </th>
                        <th rowspan="2" style="text-align: center !important;vertical-align:middle;">
                            नाम खण्ड / इकाई
                        </th>
                        <th rowspan="2"  style="text-align: center !important;vertical-align:middle;">
                            ऑडिट योग्य समितियाँ
                        </th>
                        <th colspan="3"  style="text-align: center !important;vertical-align:middle;">
                            समितियाँ जिनके प्रस्ताव प्राप्त हो चुके है |
                        </th>
                        <th colspan="3" style="text-align: center !important;vertical-align:middle;">
                            {{dateummu}} तक आडिटेड समितियां
                        </th>
                        <th colspan="3"  style="text-align: center !important;vertical-align:middle;">
                            समितियाँ जिनके प्रस्ताव प्राप्त किन्तु ऑडिट नहीं हुआ
                        </th>
                    </tr>
                    <tr>
                        <th style="text-align: center !important;vertical-align:middle;">विभागीय निरीक्षक </th>
                        <th style="text-align: center !important;vertical-align:middle;">चार्टेड एकाउं.</th>
                        <th style="text-align: center !important;vertical-align:middle;">कुल</th>
                        <th style="text-align: center !important;vertical-align:middle;">विभागीय निरीक्षक </th>
                        <th style="text-align: center !important;vertical-align:middle;">चार्टेड एकाउं.</th>
                        <th style="text-align: center !important;vertical-align:middle;">कुल</th>
                        <th style="text-align: center !important;vertical-align:middle;">विभागीय निरीक्षक </th>
                        <th style="text-align: center !important;vertical-align:middle;">चार्टेड एकाउं.</th>
                        <th style="text-align: center !important;vertical-align:middle;">कुल</th>
                    </tr>                   
                </thead>
                <tbody>
                    <tr ng-repeat="BData in DataList"  ng-class="{'footer-bold': BData.IsFooter == 1}">
                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>

                        <td style="text-align:left !important">
                            @*{{BData.ResionNameHi}}*@
                            {{BData.DISTRICT}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.TotalSociety}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.DepAuditor}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.CAAuditor}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.TotalDepAuditor}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.DepAuditComplete}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.CAAuditComplete}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.TotalAuditComplete}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.DepAuditor-BData.DepAuditComplete}}
                          
                        </td>
                        <td style="text-align:center !important">
                            {{BData.CAAuditor-BData.CAAuditComplete}}
                          
                        </td>
                        <td style="text-align:center !important">
                            {{BData.TotalDepAuditor-BData.TotalAuditComplete}}
                           
                        </td>
                        @*
                        <td style="text-align:center !important">
                            {{BData.DepAuditNotComplete}}
                        </td>
                        <td style="text-align:center !important">
                            {{ BData.CAAuditNotComplete}}
                        </td>
                        <td style="text-align:center !important">
                            {{ BData.TotalAuditNotComplete}}
                        </td>*@
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
