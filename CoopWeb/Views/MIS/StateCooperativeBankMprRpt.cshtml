
<script src="~/Scripts/AngularFramework/StateCooperativeBankMprRpt.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />



@Html.Hidden("TemplateId")
<div ng-app="AppEntryFormStateCoopBankMpr">
    <div ng-controller="StateCoopBankMprcnt">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.StateCooperativeBankMprRpt}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.EntryForm}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.StateCooperativeBankMprRpt}} </span>
                    </li>
                    <!--
                        <li style="float: right;" id="divAddBtn">
                            <button type="button" ng-click="ShowLiqudationContent()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" data-target="#myModal">
                                <h5>&#187; {{translation.NewEntry}}</h5>
                            </button>
                        </li>
                            -->
                </ul>
            </div>
        </div>


        <div class="citizen-dash-head" ng-show="showtringdiv">
            <form>

                <div class="col-lg-12 form-group">
                    <input type="hidden" ng-model="Loan.LoanDataId" />
                    <label>{{ translation.LoanAdvancement}}</label>
                </div>

                <div class="col-lg-12 form-group">

                    <div class="col-lg-1">{{translation.Stamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.AprStamt" placeholder="" autocomplete="off" />
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-1">{{translation.Mtamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.AprMtamt" placeholder="" autocomplete="off" />

                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-1">{{translation.ltamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.Aprltamt" placeholder="" autocomplete="off" />

                    </div>
                    
                </div>
                
                <div class="col-lg-12 form-group" >
                    <label>{{ translation.LoanRecovered}}</label>
                </div>

                <div class="col-lg-12 form-group">

                    <div class="col-lg-1">{{translation.Stamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.RecStamt" placeholder="" autocomplete="off" ng-init="Liqudation.NameUnit='0'" />
                    </div>
                    <div class="col-lg-1"></div>

                    <div class="col-lg-1">{{translation.Mtamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.RecMtamt" placeholder="" autocomplete="off" />
                    </div>

                    <div class="col-lg-1"></div>

                    <div class="col-lg-1">{{translation.ltamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.Recltamt" placeholder="" autocomplete="off" />

                    </div>
                </div>


                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveLoan(true)">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearLoanForm()">{{translation.Clear}}</button>
                    </div>
                </div>
            </form>
        </div>

        <div  ng-show="DivtringGrid">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label>
                                {{translation.YEAR}} :
                            </label>
                            <select class="form-control" id="ddlFYearId"  ng-model="Liqudation.FYearId" ng-init="Liqudation.FYearId='0'" required>
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_MASTR_ID}}">
                                    {{item.FIN_YEAR_NAME}}
                                </option>
                            </select>
                        </div>
                        <div class="col-lg-4">
                            <label>{{translation.Month}}:</label>
                            <select class="form-control" ng-model="Liqudation.MonthId" ng-init="Liqudation.MonthId='0'">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in MonthList" value="{{item.Month_Id}}">
                                    {{_language =='en-us' ?  item.Month_En : item.Month_Hi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-disabled="Liqudation.MonthId.$invalid" ng-click="GridData()">{{translation.Show}}</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">                
                <div class="citizen-dash-head">
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th colspan="4" style="text-align: center !important">
                                    {{translation.StateCooperativeBankMprRpt}}
                                </th>
                            </tr>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>

                                <th style="text-align: center !important">
                                    {{translation.Item}}

                                </th>

                                <th style="text-align:center !important">
                                    {{translation.Unit}}

                                </th>

                                <th style="text-align:center !important">
                                    {{translation.YearEnding}}

                                </th>



                            </tr>
                            <!--

                             <tr>
                                 <th style="text-align:center !important">{{translation.Number}}</th>
                                 <th style="text-align:center !important">{{translation.Member1}}</th>
                                 <th style="text-align:center !important">{{translation.Number}}</th>
                                 <th style="text-align:center !important">{{translation.Member1}}</th>
                                 <th style="text-align:center !important">{{translation.Number}}</th>
                                 <th style="text-align:center !important">{{translation.Member1}}</th>
                                 <th style="text-align:center !important">{{translation.Number}}</th>
                                 <th style="text-align:center !important">{{translation.Member1}}</th>


                             </tr>
                                -->

                        </thead>

                        <tbody>

                            <tr dir-paginate="BData in CoopBankMprData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>

                                <td style="text-align:center !important">
                                    {{ BData.DISTRICT_ENG}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.AprStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.AprMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Aprltamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.RecStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.RecMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Recltamt}}
                                </td>

                                <td style="text-align:center !important">
                                    {{BData.OptStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.OptMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Optltamt}}
                                </td>
                                <!--
    <td>
        <div class="dev-action">
            <label class="switch">
                <input type="checkbox" ng-checked="BData.IsActive == 1" ng-click="SetStatus(BData)">
                <span class="slider round"></span>
            </label>
        </div>
    </td>

    <td ng-show="true" style="text-align:center !important">
        <i class="fa fa-edit" data-target="#myModalFeedback" data-toggle="modal" ng-click="update(BData)"></i>
    </td>

    <td ng-show="true" style="text-align:center !important">
        <i class="fa fa-trash" data-target="#myModalFeedback" data-toggle="modal" ng-click="SetStatusTrash(BData)"></i>
    </td>

    -->
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="TrainningFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">
                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                </div>
            </div>
        </div>
    </div>

</div>