                                <th style="text-align:center">{{_language =='en-us'?'Recoverable From The Debtor':'ऋणी से वसूली योग्य '}}</th>
                                <th style="text-align:center">{{_language =='en-us'?'Amount of relief paid':'राहत राशि '}}</th>
                                <th style="text-align:center">{{translation.Yog}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in GetPldbSummary">
                                <td>{{$index+1}}.</td>
                                <td align="center"><a href="" ng-click="PldbBranchNameChange(item)">{{item.BranchName_En}}</a></td>

                                <td align="center">{{item.TotalApplication}}</td>
                                <td align="center">{{item.RemainingAmt}}</td>
                                <td align="center">{{item.ReliefAmount}}</td>
                                <td align="center">{{item.Yog}}</td>

                                <td align="center">{{item.TotalTaamil}}</td>
                                <td align="center">{{item.TaamilRemainingAmt}}</td>
                                <td align="center">{{item.TaamilReliefAmount}}</td>
                                <td align="center">{{item.TaamilYog}}</td>
                            </tr>
                        </tbody>
