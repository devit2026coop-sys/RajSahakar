@{
    ViewBag.Title = "Month Wise OTS Recovery";
}
<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }

    .tblthfont {
        font-weight: bold;
    }
</style>
<script src="~/Scripts/xlsx.full.min.js"></script>
<script src="~/Scripts/AngularFramework/MonthWiseOTSRecovery.js?v=1.4"></script>
<div ng-app="mwotsMod" ng-controller="mwotsCtrl" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
        <input type="hidden" id="hdnPldbId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
        <input type="hidden" id="hdnPldbBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />

        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; Month Wise OTS Recovery</b>
                <div class="text-right">
                    <button class="btn btn-primary dev-btn" ng-show="MonthWiseOtsData!=null && MonthWiseOtsData.length>0" ng-click="ReportDownload(MonthWiseOTSRecovery)">Export Excel</button>
                </div>
            </div>
            <div class="panel-body">
                <input type="hidden" id="hdnDistrictId" ng-model="search.LoanDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                <div class="row" id="search-filter">

                    <div class="col-md-2 form-group">
                        <label>{{ translation.District}}<span class="error">*</span></label>
                        <select id="DISTRICT_ID" ng-model="search.DISTRICT_ID" class="form-control" ng-init="search.DISTRICT_ID='0'" ng-change="PLDBListData(0); GetConstituencyList('0')">
                            <option value="0">{{translation.SelectOption}}</option>
                            <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>


                    @*<div class="col-md-2 form-group">
                     <label>{{ translation.District}}<span class="error">*</span></label>
                     <select id="DISTRICT_ID" ng-model="search.DISTRICT_ID" class="form-control" ng-init="search.DISTRICT_ID='0'" ng-change="GetConstituencyList(0)">
                        <option value="0">{{translation.SelectOption}}</option>
                         <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                       {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                        </option>
                        </select>
                     </div>*@

                    

                    <div class="col-lg-2 form-group">
                    <label for="ConstituencyId">Constituency<span class="error">*</span></label>
                    <select id="ConstituencyId" ng-model="search.ConstituencyId" class="form-control" ng-init="ConstituencyId='0'" ng-change="PLDBBranchList('0')">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in ConstituencyList" value="{{item.Id}}">
                            {{item.Constituency}}
                        </option>
                     </select>
                     </div>

                    <div class="col-lg-2 form-group " id="ddlPLDBID">
                        <label for="PLDB_ID">{{ translation.PLDB}} </label>
                        <select id="PLDB_ID" name="PLDB_ID" ng-model="search.PLDB_ID" class="form-control" ng-init="PLDB_ID='0'" ng-change="PLDBBranchList('0')">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemPLDB in PLDBList  track by itemPLDB.PldbId " value="{{itemPLDB.PldbId}}">
                                {{itemPLDB.PLDBName}}
                            </option>
                        </select>
                    </div>

                    <div class="col-lg-2 form-group" id="ddlPldbBranchID">
                        <label for="PLDB_Branch_ID">{{ translation.Branch}}</label>
                        <select ng-model="search.PLDB_Branch_ID" name="PLDB_Branch_ID" id="PLDB_Branch_ID" class="form-control" ng-init="PLDB_Branch_ID='0'" ng-change="GetMonthWiseOtsRecoveryDetails()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemBlock in PLDBBranches " value="{{itemBlock.BLOCK_ID}}">
                                {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                            </option>
                        </select>
                    </div>



                    @*<div class="col-lg-2 margin-Top20" style="padding-left:30px;">
            <label>{{translation.Assembly}}</label>
            <select ng-model="AssemblyId" id="ddlAssembly" class="form-control" ng-init="AssemblyId='0'" ng-disabled="isEditMode">
                <option value="0">{{translation.SelectOption}}</option>
                <option ng-repeat="item in AssemblyList " value="{{item.ASSEMBLY_ID}}">
                    {{_language =='en-us' ?  item.AC_ENG : item.AC_MANGAL}}
                </option>
            </select>
        </div>*@


                    <div class="col-md-2">
                        <label for="search">{{translation.ItemPerPage}}:</label>
                        <select ng-model="search.pageSize" class="form-control" ng-change="pagechange()" ng-init="search.pageSize='50'">
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="200">200</option>
                            <option value="500">500</option>
                            <option value="1000">1000</option>
                            <option value="10000">10000</option>
                            <option value="50000">50000</option>
                        </select>
                    </div>


                </div>
                <div class="table-responsive devtable">
                    <table class="table table-hover table-striped table-bordered mb-0" id="{{MonthWiseOTSRecovery}}">
                        <thead>
                            <tr>
                                <th width="60">{{translation.SRNO}}</th>
                                <th>{{translation.PLDB }}</th>
                                <th>{{translation.PLDBBranch }}</th>
                                <th>{{translation.ApplicantName}}</th>
                                <th>{{translation.FatherHasbandName}}</th>
                                <th>{{translation.Category }}</th>
                                <th>{{translation.Sector }}</th>
                                <th>{{translation.Purpose}}</th>
                                <th>{{translation.Village}}</th>
                                <th>{{translation.LoanApplicationNo}}</th>
                                <th>First Disbursement Date</th>
                                <th>Total Disbursed Amt</th>
                                <th>FR Receipt No.</th>
                                <th>FR Generation Date</th>
                                <th>Total Received Amount </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-if="MonthWiseOtsData && MonthWiseOtsData.length > 0"dir-paginate="item in MonthWiseOtsData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: search.pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                                <td><span>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}.</span></td>
                                <td>{{item.PLDBName}}</td>
                                <td>{{item.PLDBBranch}}</td>
                                <td>{{item.ApplicantName}}</td>
                                <td>{{item.FatherHusbandName}}</td>
                                <td>{{item.CategoryName}}</td>
                                <td>{{item.Sector}}</td>
                                <td>{{item.Purpose}}</td>
                                <td>{{item.Village}}</td>
                                <td>{{item.LoanAccNo}}</td>
                                <td>{{item.DateOfFirstDisbursement}}</td>
                                <td>{{item.TotalDisbursedAmt}}</td>
                                <td>{{item.FRReceiptNo}}</td>
                                <td>{{item.FRDate}}</td>
                                <td>{{item.ReceivedAmount}}</td>
                            </tr>
                            <tr ng-if="(!MonthWiseOtsData || MonthWiseOtsData.length === 0)">
                                <td colspan="{{colspan}}" style="text-align: center;">No Records</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate" style="display: flex; align-items: center; justify-content: space-between;">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important; margin:0">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',SearchData)" style="cursor: pointer;">
                                    <span>« First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,SearchData)" style="cursor:pointer;">
                                    <span>« Prev</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,SearchData)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,SearchData)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,SearchData)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>
