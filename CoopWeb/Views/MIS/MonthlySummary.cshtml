<script type="text/javascript">
    $(document).ready(function () {

        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            //minDate: (new Date()).getDate() + '/' + ((new Date()).getMonth()+1) + '/' + ((new Date()).getFullYear()).toString(),
            //defaultDate: (new Date()).getDate() + '/' + ((new Date()).getMonth() + 1) + '/' + ((new Date()).getFullYear()).toString(),
        });

        var monthStartDate = "01/" + ((new Date().getMonth() + 1).toString().length <= 1 ? "0" + (new Date().getMonth() + 1).toString() : (new Date().getMonth() + 1).toString()) + "/" + new Date().getFullYear();
        var currentDate = (new Date().getDate().toString().length <= 1 ? "0" + new Date().getDate().toString() : new Date().getDate().toString()) + "/" + ((new Date().getMonth() + 1).toString().length <= 1 ? "0" + (new Date().getMonth() + 1).toString() : (new Date().getMonth() + 1).toString()) + "/" + new Date().getFullYear();

        $("#txtFromDate").val(monthStartDate);
        $("#txtToDate").val(currentDate);
    });

    function SelectListElement(id, type) {

        var values = "";
        $('#' + id).find('input[type="checkbox"]:checked').each(function () {
            values += (values != "" ? "," : "") + $(this).attr("dat-val");
        });
        if (values != "") {
            $("#" + type).find("span").eq(1).html("");
            $("#" + type).find("span").eq(1).html(values.length <= 20 ? values : values.substring(0, 20) + "...");
            $("#" + type).find("span").eq(0).hide();
            $('#' + type).attr("title", values);
        } else {
            $("#" + type).find("span").eq(1).html("");
            $("#" + type).find("span").eq(0).show();
            $('#' + type).attr("title", "");
        }

    }

</script>

