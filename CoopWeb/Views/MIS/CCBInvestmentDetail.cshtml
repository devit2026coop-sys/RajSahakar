
<script src="~/Scripts/AngularFramework/CCBInvestmentDetail.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>

<div ng-app="CCBInvestmentReportCnt">
    <div ng-controller="CCBInvestmentReportMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.CCBInvestmentDetailReportHeading}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.MIS}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.CCBInvestmentDetailReportHeading}} </span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <form class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Division}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select id="ddlDistrict" ng-model="DivisionId" class="form-control" ng-init="DivisionId='0'" ng-change="DistrictList()">
                            <option value="0">{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Divisions" value="{{item.DIVISION_ID}}">
                                {{_language =='en-us' ?  item.DIVISION_ENG : item.DIVISION_MANGAL}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.District}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select id="ddlDistrict" ng-model="DistrictId" class="form-control" ng-init="DistrictId='0'">
                            <option value="0">{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Districts" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="button" class="btn btn-primary" ng-click="ShowSearchData()">{{translation.Show}}</button>
                        <button type="button" class="btn btn-primary" ng-click="Clear()">{{translation.Clear}}</button>
                    </div>
                </div>
            </form>

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divSearchResult">
                <div class="citizen-dash-head">
                    <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('divExcelDownload', 'AuditReportDistrictWise')" value="{{translation.ExportToExcel}}">
                </div>
                <div id="divExcelDownload" style="padding:20px 0px;">
                    <div class="citizen-dash-head">

                        <table class="table table-responsive devtable" style="overflow-x:auto;">

                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th>
                                        {{translation.UnitName}}
                                    </th>
                                    <th>
                                        {{translation.TotalCCS}}
                                    </th>
                                    <th>
                                        {{translation.InForce}}
                                    </th>
                                    <th>
                                        {{translation.Ideal}}
                                    </th>
                                    <th>
                                        {{translation.Liquadation}}
                                    </th>
                                    <th>
                                        {{translation.AccountsInCCB}}
                                    </th>
                                    <th>
                                        {{translation.InvestedInCCB}}
                                    </th>
                                    <th>
                                        {{translation.InvestedAmountInCCB}}
                                    </th>
                                </tr>

                            </thead>
                            <tbody>
                                <tr ng-repeat="item in SearchData track by $index">
                                    <td>{{$index+1}}</td>
                                    <td>
                                        {{item.DISTRICT_MANGAL }}
                                    </td>
                                    <td>
                                        {{item.TotalSocieties }}
                                    </td>
                                    <td>
                                        {{item.ActiveSocieties }}
                                    </td>
                                    <td>
                                        {{ item.InActiveSocieties }}
                                    </td>
                                    <td>
                                        {{item.LiquadationSocieties }}
                                    </td>

                                    <td>
                                        {{ item.AccountOpenInCCB }}
                                    </td>

                                    <td>
                                        {{item.InvestedInCCB }}
                                    </td>
                                    <td>
                                        {{ item.InvestmentAmount }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>


                    </div>
                </div>
            </div>


        </div>
    </div>

</div>

