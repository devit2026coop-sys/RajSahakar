
@{
    // ViewBag.Title = "OICDashbordReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/Scripts/AngularFramework/OICDashbord.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>
<div ng-app="OICDashbordModule">
    <div ng-controller="OICDashbordCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.OICDashbord}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-md-12">

        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.PanchayatSamiti}} </span>
                    </li>

                </ul>
            </div>

        </div>
        <div class="col-md-12">
            <form class="citizen-dash-head" style="overflow: hidden; margin-bottom: 20px;">
                <div class="col-md-3">
                    <label>
                        {{translation.Act}} :
                    </label>
                    <select ng-model="ActId" class="form-control">
                        <option value="0">{{translation.SelectOption}}-</option>
                        <option ng-repeat="item in Acts" value="{{item.ActId}}">
                            {{_language =='en-us' ?  item.ActNameEn : item.ActNameHi}}
                        </option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>
                        {{translation.District}} :
                    </label>
                    <select ng-model="DistrictId" class="form-control">
                        <option value="0">{{translation.SelectOption}}-</option>
                        <option ng-repeat="item in Districts" value="{{item.DISTRICT_ID}}">
                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-disabled="block1.$invalid" ng-click="GetOICDashbordData()">{{translation.Show}}</button>
                </div>
            </form>
        </div>



        <div class="col-md-12" ng-show="divAct">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-md-12">

                        <div class="col-md-12 dev-search-form">
                            @* <div class="col-xs-4">
                                    <label for="search">{{translation.Search}}:</label>
                                    <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                                </div>*@
                            @*<div class="col-xs-4">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                            </div>*@
                            <div class="col-md-12" >                                
                                <i style="float:right" value="Export to Excel" class="fa fa-file-excel-o" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" aria-hidden="true"></i>
                            </div>
                        </div>

                        <div class="table-responsive citizen-dash-head">
                            <table class="table devtable" id="tblgetsuport">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.YEAR}}
                                        </th>
                                        <th>
                                            {{translation.Month}}
                                        </th>
                                        <th>
                                            {{translation.District}}
                                        </th>
                                        <th>
                                            {{translation.Unit}}
                                        </th>
                                        <th>
                                            {{translation.Act}}
                                        </th>
                                        <th>
                                            {{translation.SocietyType}}
                                        </th>
                                        <th>{{ translation.TotReceived }}</th>
                                        <th>{{ translation.TotRegistered }}</th>
                                        <th>{{ translation.TotPendingCiti }}</th>
                                        <th>{{ translation.TotPendingDept }}</th>
                                        <th>{{ translation.TotRejected }}</th>
                                        <th>{{ translation.TotAutoCloue }}</th>
                                        <th>{{ translation.TotAmountReceived }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="items in OICDashbordData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="BlockPagination">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ items.YearValue }}</td>
                                        <td>{{ items.MonthNameEn }}</td>
                                        <td>{{ items.DISTRICT_ENG }}</td>
                                        <td>{{ items.ResionNameEn }}</td>
                                        <td>{{ items.ActNameEn }}</td>
                                        <td>{{ items.TypeameEng }}</td>
                                        <td>{{ items.TotReceived }}</td>
                                        <td>{{ items.TotRegistered }}</td>
                                        <td>{{ items.TotPendingCiti }}</td>
                                        <td>{{ items.TotPendingDept }}</td>
                                        <td>{{ items.TotRejected }}</td>
                                        <td>{{ items.TotAutoCloue }}</td>
                                        <td>{{ items.TotAmountReceived }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>



                <div class="col-md-12">
                    <div class="text-center">
                        <dir-pagination-controls boundary-links="true" pagination-id="BlockPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
                <div class="form-group col-md-12">
                    <div class="dev-align-btn">

                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                    </div>

                </div>
               
            </div>
        </div>
    </div>

    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

