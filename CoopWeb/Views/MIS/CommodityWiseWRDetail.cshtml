<script src="~/Scripts/AngularFramework/CommodityWiseWRDetail.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />



<div ng-app="CommodityWiseWRDetailMod" ng-controller="CommodityWiseWRDetailCont">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.CommodityWiseWRDetail}}<a target="_blank" style="float:right; font-size:12px" href="~/Content/UserManual/CEO_Audit_Report_Upload.pdf">उपयोगकर्ता पुस्तिका</a></h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.CommodityWiseWRDetail}}   </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-12">
        <div class="table-responsive citizen-dash-head">
            <h5 class="heading-hr ng-binding"> {{translation.CommodityWiseWRDetail}} </h5>
            <table class="table devtable">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                        <th>
                            {{translation.SocietyName}}
                        </th>
                       
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="items in WRDetails">
                        <td>{{$index+1}}</td>
                        <td>{{ items.receipt_no }}</td>
                    </tr>
                </tbody>
            </table>
        </div>


    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
