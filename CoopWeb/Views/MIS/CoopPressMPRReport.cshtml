<script src="~/Scripts/AngularFramework/CoopPressMPRReport.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />

<div ng-app="CoopPressMPRRPTMod" ng-controller="CoopPressMPRRPTCont">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.CooperativePressMPRReport}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#">Home</a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.CooperativePressMPRReport}}</span>
                </li>
            </ul>
        </div>

    </div>

    <div class="col-md-12">
        <form class="dev-search-form citizen-dash-head " style="overflow: hidden;" name="Myauditform">

            <div class="col-lg-12 form-group" id="search-filter">

                <div class="col-md-2 margin-Top20" style="padding-left: 0;">
                    <label>{{ translation.Search}}</label>
                    <input name="serachText" class="form-control" ng-model="Filter.SerachText" />
                </div>
                <div class="col-md-2  margin-Top20" ng-show="showSearchText">
                    <label>&nbsp;</label><br>

                    <button type="button" class="btn btn-primary dev-btn mt-20" ng-click="GetWomanSavingCreditSociety()">{{translation.Search}}</button>
                    <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                </div>
            </div>

        </form>
        <h5 class="font-16 d-inline" id="lblHeading"></h5>

    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">

                <li style="float: left">
                    <span style="margin: 0 5px;">1. Progress Statement</span>
                </li>
            </ul>
        </div>

    </div>
    <div class="table-responsive citizen-dash-head">

        <table class="table devtable">
            <thead>
                <tr>
                    <th>
                        SR. NO.
                    </th>
                    <th>
                        Job Description
                    </th>
                    <th>
                        Target for the Year 2021-22
                    </th>
                    <th>
                        Last Month's Fulfillment
                    </th>
                    <th>
                        Target in the Month
                    </th>
                    <th>
                        Total Fulfillment
                    </th>
                    <th>
                        Percentage of fulfillment
                    </th>

                </tr>
            </thead>
            <tbody>

                <tr ng-repeat="items in WomanSavingCreditSociety">
                    <td>{{$index+1}}</td>
                    <td>{{items.SocietyName}}</td>
                    <td>{{items.Address}}</td>
                    <td>{{items.RegistrationNo}}</td>
                    <td>{{items.RegistrationDate}}</td>
                    <td>{{items.PresidentNameAddress}}</td>
                    <td>{{items.MemberCount}}</td>
                    <td>{{items.ShareCapitalAmount}}</td>
                    <td>{{items.Trust}}</td>
                    <td>{{items.Working}}</td>
                    <td>{{items.Loan}}</td>
                    <td>{{items.Business}}</td>
                    <td>{{items.Status}}</td>
                </tr>
            </tbody>
        </table>
        <div class="col-md-10">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="rolePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="col-md-2">
            <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">

                <li style="float: left">
                    <span style="margin: 0 5px;">2. Arrears Recovery</span>
                </li>
            </ul>
        </div>

    </div>

    <div class="table-responsive citizen-dash-head">

        <table class="table devtable">
            <thead>
                <tr>
                    <th>
                        SR. NO.
                    </th>
                    <th>
                        Name Department
                    </th>
                    <th>
                        Dues from 01.04.2021 till Last Month
                    </th>
                    <th>
                        Recovery Till Last Month
                    </th>
                    <th>
                        Recovery in the Current Month
                    </th>
                    <th>
                        Total Recovery
                    </th>
                    <th>
                        Remanent
                    </th>

                </tr>
            </thead>
            <tbody>
                @* <tr dir-paginate="item in WomanSavingCreditSociety | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="rolePagination">*@

                <tr ng-repeat="items in WomanSavingCreditSociety">
                    <td>{{$index+1}}</td>
                    <td>{{items.SocietyName}}</td>
                    <td>{{items.Address}}</td>
                    <td>{{items.RegistrationNo}}</td>
                    <td>{{items.RegistrationDate}}</td>
                    <td>{{items.PresidentNameAddress}}</td>
                    <td>{{items.MemberCount}}</td>
                    <td>{{items.ShareCapitalAmount}}</td>
                    <td>{{items.Trust}}</td>
                    <td>{{items.Working}}</td>
                    <td>{{items.Loan}}</td>
                    <td>{{items.Business}}</td>
                    <td>{{items.Status}}</td>
                </tr>
            </tbody>
        </table>
        <div class="col-md-10">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="rolePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="col-md-2">
            <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
        </div>
    </div>

</div>