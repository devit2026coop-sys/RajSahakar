<script src="~/Scripts/AngularFramework/WomanSavingCreditSocietyRPT.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />
<script src="~/Scripts/Excel/jszip_v1.js"></script>
<script src="~/Scripts/Excel/xlsx.js"></script>
<script src="~/Scripts/Excel/jszip.js"></script>
<script src="~/Scripts/Excel/FileSaver.js"></script>
<script src="~/Scripts/Excel/myexcel.js"></script>
<div ng-app="WomanSavingCreditSocietyRPTMod" ng-controller="WomanSavingCreditSocietyRPTCont">

    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.WomenSavingCreditSocietyReport}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.WomenSavingCreditSocietyReport}}   </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div class="table-dropdown" id="search-filter" style="overflow:inherit; float:left;width: 100%;margin-bottom: 10px;">
                <div class="col-md-2 margin-Top20 y_dropdown" style="padding-left: 0;">
                    <label for="search" class="ng-binding">{{translation.Month}}:</label>
                    <input id="txtFromMonth" value="date" type="month" class="form-control" autocomplete="off" onkeypress="return false;" />
                </div>
                <div class="col-md-2 margin-Top20 y_dropdown" style="padding-left: 0;">
                    <label>{{ translation.DistrictHeading}}:</label>
                    <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />

                    <select name="Districtdll" ng-model="DistrictId" class="form-control" ng-init="DistrictId='0'" id="ddrDistrictId">
                        <option value="0">{{translation.SelectOption}}</option>
                        <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                            {{_language =='en-us' ?  district.DISTRICT_MANGAL : district.DISTRICT_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="col-md-2 margin-Top20 y_dropdown" style="padding-left: 0;">
                    <br />
                    <button type="submit" class="btn btn-primary dev-btn" ng-click="searchRequest(GetWomanSavingCreditSociety)()">{{translation.Search}}</button>
                    <input type="button" class="btn btn-primary dev-btn" ng-click="ExportData()" value="Export to Excel">
                </div>
            </div>
            <table class="table devtable">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
<th>
{{translation.NameOfSociety}}
</th>
<th>
{{translation.SocietyAddressPhoneNoEmail}}
</th>
<th>
{{translation.RegistrationNo}}
</th>
<th>
{{translation.RegistrationDate}}
</th>
<th>
{{translation.PresidentNameAddressPhoneno}}
</th>
<th>
{{translation.NumberofMembers}}
</th>
<th>
{{translation.SocietyShareAmount}}
<th>
{{translation.SecurityDeposit}}
</th>
<th>
{{translation.WorkingCapital}}
</th>
<th>
{{translation.LoanAmountAndSource}}
</th>
<th>
{{translation.BusinessOfTheSociety}}
</th>
<th>
{{translation.Specifications}}<br />({{translation.Active}}/{{translation.InActive}})
</th>
                    </tr>
                </thead>
                <tbody>
                    @* <tr dir-paginate="item in WomanSavingCreditSociety | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="rolePagination">*@

                    <tr ng-repeat="items in WomanSavingCreditSociety">
                        <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                        <td>{{items.SocietyName}}</td>
                        <td>{{items.SocietyAddress}}</td>
                        <td>{{items.RegistrationNo}}</td>
                        <td>{{items.RegistrationDate}}</td>
                        <td>{{items.CEOName}}, {{items.CEOAddress}}, {{items.CEOContactNo}}</td>
                        <td>{{items.TotalMember}}</td>
                        <td>{{items.TotalShareAmount}}</td>
                        <td>{{items.SecurityDeposit}}</td>
                        <td>{{items.WorkingCapital}}</td>
                        <td>{{items.TotalLoan}} {{items.LoanSourse}}</td>
                        <td>{{items.BusinessNameHi}}</td>
                        <td>{{items.IsActive?translation.Active:translation.InActive}}</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr><td colspan="13">
                            <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                    Total Records: {{DataPagingDetails.TotalRecords}}
                                </div>
                                <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                    <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                    <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetWomanSavingCreditSociety)" style="cursor: pointer;">
                                        <span>«First</span>
                                    </li>
                                    <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetWomanSavingCreditSociety)" style="cursor:pointer;">
                                        <span>« Previous</span>
                                    </li>
                                    <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetWomanSavingCreditSociety)"><span>{{n}}</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetWomanSavingCreditSociety)" style="cursor:pointer;">
                                        <span>Next »</span>
                                    </li>
                                    <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetWomanSavingCreditSociety)" style="cursor:pointer;">
                                        <span>Last »</span>
                                    </li>
                                </ul>
                            </div>
</td></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
