<style type="text/css">
    body {
        font-family: Arial;
        font-size: 10pt;
    }

    table {
        border: 1px solid #ccc;
        border-collapse: collapse;
    }

        table th {
            background-color: #F7F7F7;
            color: #333;
            font-weight: bold;
        }

        table th, table td {
            padding: 5px;
            border: 1px solid #ccc;
        }

    .NewMemberdob input {
        float: left;
        width: 90%;
    }

    .NewMemberdob button {
        float: left;
    }

    .notValid {
        border: solid 1px red !important
    }
</style>


<script type="text/javascript">
    $(document).ready(function () {

        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            //minDate: (new Date()).getDate() + '/' + ((new Date()).getMonth()+1) + '/' + ((new Date()).getFullYear()).toString(),
            //defaultDate: (new Date()).getDate() + '/' + ((new Date()).getMonth() + 1) + '/' + ((new Date()).getFullYear()).toString(),
        });
 var dd = new Date().getDate()
        var mm = new Date().getMonth() + 1;
        var yy = new Date().getFullYear();

        var toDaydate = (dd.toString().length == 1 ? ("0" + dd.toString()) : dd.toString()) + "/" + (mm.toString().length == 1 ? ("0" + mm.toString()) : mm.toString()) + "/" + yy.toString();
    $("#txtToDate").val(toDaydate);
   // alert($("#txtToDate").val());//
        //var monthStartDate = "01/" + ((new Date().getMonth() + 1).toString().length <= 1 ? "0" + (new Date().getMonth() + 1).toString() : (new Date().getMonth() + 1).toString()) + "/" + new Date().getFullYear();
        //var currentDate = (new Date().getDate().toString().length <= 1 ? "0" + new Date().getDate().toString() : new Date().getDate().toString()) + "/" + ((new Date().getMonth() + 1).toString().length <= 1 ? "0" + (new Date().getMonth() + 1).toString() : (new Date().getMonth() + 1).toString()) + "/" + new Date().getFullYear();

        //$("#txtFromDate").val(monthStartDate);
        //$("#txtToDate").val(currentDate);
    });
    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };

</script>

<div ng-app="WRAmmountReportMOD" ng-controller="WRAmmountReportCONT">

    <div class="col-md-12">
        <h3 class="citizen-dash-head">WR Quantity Report</h3>
        <hr style="margin: 0;">
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">WR Quantity Report</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="">
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown" id="search-filter">
                    <div class="col-md-2 margin-Top20">
                        <label for="search" class="ng-binding">{{translation.FincialYearHeading}}:</label>
                        <select name="fy" id="ddFy" style="" class="form-control" ng-model="Filter.FinancialYear" ng-init="Filter.FinancialYear=''">
                            <option value="">{{translation.SelectOption}}</option>
                            <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_NAME}}">
                                {{item.FIN_YEAR_NAME}}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-2 margin-Top20">
                        <label>Commodity Type</label>
                        <select name="commoditytype" ng-model="Filter.commoditytype" class="form-control" ng-init="Filter.commoditytype=''">
                            <option value="">{{translation.SelectOption}}</option>
                            <option value="1">खरीफ</option>
                            <option value="0">रबी </option>
                        </select>
                    </div>
                    <div class="col-md-4 NewMemberdob margin-Top20">
                        <label>
                            {{translation.ToDate}}
                        </label>
                        <input id="txtToDate" name="ToDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.ToDate" placeholder="{{translation.ToDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                    </div>
                    <div class="col-md-4  margin-Top20">
                        <label>&nbsp;</label><br>
                        <button type="button" ng-click="GetWRReport()" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                        <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                    </div>
                </div>
                <table id="tblExport" class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>District</th>
                            <th>Name Of Warehouse</th>
                            <th>Commodity </th>
                            <th  style="width:150px;">Quantity (MT) Deposited in Warehouse till yesterday</th>
                            <th  style="width:150px;">Value in crore rupees of quantity in column No 5</th>
                            <th colspan="3" style="text-align:center;">WR's issued till today</th>                            
                            <th>Reasons of delay</th>
                        </tr>
                        <tr>
                            <th rowspan="2" style="text-align:center;vertical-align:central;">
                                1
                            </th>
                            <th rowspan="2" style="text-align:center;vertical-align:central;">2</th>
                            <th rowspan="2" style="text-align:center;vertical-align:central;">3</th>
                            <th rowspan="2" style="text-align:center;vertical-align:central;">4 </th>
                            <th rowspan="2" style="text-align:center;vertical-align:central;">5</th>
                            <th rowspan="2" style="text-align:center;vertical-align:central;">6</th>
                            <th colspan="3" style="text-align:center;vertical-align:central;">7</th>
                            <th rowspan="2" style="text-align:center;vertical-align:central;">8</th>
                        </tr>     
                        <tr>
                            <th style="text-align:center;">Till of which date<br />(A)</th>
                            <th style="text-align:center;">of what quantity<br />(B)</th>
                            <th style="text-align:center;">of what value(in Crore)<br />(C)</th>
                        </tr>

                    </thead>
                    <tbody>
                        <tr ng-repeat="item in DataSet">
                            <td>{{$index+1}}</td>

                            <td>
                                {{item.DISTRICT_ENG }}
                            </td>
                            <td>
                                {{item.WareHouseName }}
                            </td>
                            <td>
                                {{item.CommodityName }}
                            </td>
                            <td style="text-align:right">
                                {{item.net_quantity }}
                            </td>
                            <td style="text-align:right">
                                {{item.TotalValue }}
                            </td>
                            <td style="text-align:right">
                                {{item.LastWrDate }}
                            </td>

                            <td style="text-align:right">
                                {{item.net_quantity }}
                            </td>
                            <td style="text-align:right">
                                {{item.TotalValue }}
                            </td>
<td></td>
                        </tr>
                        <tr ng-if="DataSet.length>0">

                            <th colspan="4" style="text-align:right">Total</th>
                            <th style="text-align:right">
                                {{net_quantity }}
                            </th>
                            <th style="text-align:right">
                                {{TotalValue }}
                            </th>
                            <th style="text-align:right">
                                {{TotalWR }}
                            </th>

                            <th style="text-align:right">
                                {{net_quantity }}
                            </th>
                            <th style="text-align:right">
                                {{TotalValue }}
                            </th>
<th></th>
                        </tr>




                    </tbody>
                </table>
              <input ng-if="DataSet.length>0" type="button" id="btnExport" class="btn btn-primary dev-btn" style="" ng-click="ExportData()" value="Export" />
   
        </div>
    </div>
</div>
</div>

