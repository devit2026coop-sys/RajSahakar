@{
    ViewBag.Title = "Aadhaar ServiceLog Report Application List";
}
<script src="~/Scripts/AngularFramework/AadhaarServiceLogReport.js?v=1.14"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />

<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }

    .view-btn i {
        color: #fff;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td {
        padding: 1px;
        padding-right: 5px;
        padding-left: 5px;
    }
</style>
<div ng-app="PLDBApplicationListModule" ng-controller="AadhaarServiceLogCtrl" ng-cloak="">

    @*<div ng-show="isLoading" class="loader"></div>*@
    <div class="col-md-12">
        <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">Aadhaar ServiceLog Report Application List </h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#">  {{translation.Home}}</a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.New}} </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> Aadhaar ServiceLog Report Application List </span>
                </li>

            </ul>
        </div>
    </div>
    <div style="margin-top:30px;padding-top:30px">
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">


                    <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">
                        <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                        <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                        <input type="hidden" id="hdnPldbId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
                        <input type="hidden" id="hdnPldbBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />
                        <input type="hidden" id="hdnLevelId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />

                        @*<div class="form-group col-md-3">
                                <label for="">PLDB</label>
                                <select ng-model="PLDB.PldbId"
                                        name="PLDB_ID"
                                        id="ddlDistrict"
                                        class="form-control"
                                        ng-change="PLDBBranchList('0')"
                                        ng-disabled="IsPLDBFreezed">
                                    <option value="" disabled>--चुनें--</option>
                                    <option ng-repeat="itemPLDB in PLDBList | orderBy:'PLDBName' track by itemPLDB.PldbId " value="{{itemPLDB.PldbId}}">
                                        {{itemPLDB.PLDBName}}
                                    </option>
                                </select>
                            </div>

                            <div class="form-group col-md-3">
                                <label for="">PLDB Branch</label>
                                <select ng-model="PLDB.BranchId"
                                        id="branchid"
                                        name="BLOCK_ID"
                                        class="form-control"
                                        ng-init="PLDB.BranchId='0'" ng-disabled="IsBranchFreezed">
                                    <option value="0" disabled>--चुनें--</option>
                                    <option ng-repeat="itemBlock in PLDBBranches | orderBy:'BLOCK_ENG'" value="{{itemBlock.BLOCK_ID}}">
                                        {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                                    </option>
                                </select>
                            </div>*@

                        <div class="col-md-2">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" name="SearchText" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>

                        <div class="col-md-1">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="1000" class="form-control" ng-model="pageSize">

                        </div>



                        @*<div class="col-md-3 mt-2">
                                <br />
                                <button type="button" ng-click="searchRequest(GetOTSList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                                <button type="button" ng-show="showClearButton" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                                <a href="~/PLDB/PLDBLoanApplicationForm" class="btn btn-primary dev-btn">
                                    <i class="fa fa-plus"></i> Add Application
                                </a>
                            </div>*@


                    </div>
                    <div>
                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    @*<th ng-click="sortData('ApplicantName')">
                                         {{translation.ApplicantName}}
                                        </th>*@
                                    <th style=" min-width: 125px;">
                                        Aadhar No.
                                    </th>
                                    <th style=" min-width: 125px;">
                                        Service Type
                                    </th>
                                    <th style=" min-width: 125px;">
                                        RequestXML
                                    </th>
                                    <th style=" min-width: 125px;">
                                        ResponseXML
                                    </th>
                                    <th style=" min-width: 125px;">
                                        Status
                                    </th>
                                    <th style=" min-width: 125px;">
                                        TxtId
                                    </th>
                                    <th>
                                        Created date
                                    </th>
                                    <th>
                                        error Code
                                    </th>
                                    @*<th>
                                          Module Naqme
                                        </th>*@

                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in OTSList">
                                    <td>
                                            {{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}
                                        </td>
                                    <td style="text-transform:uppercase;">
                                        <b> <i>{{item.Aadhaar }}</i></b><br />

                                    </td>
                                    <td>  {{item.ServiceType}}</td>
                                    <td>{{item.RequestXML}}  </td>
                                    <td>{{item.ResponceXML}}  </td>
                                    <td>{{item.Status}}  </td>
                                    <td>{{item.TxnId}}  </td>
                                    <td>{{item.CreateDate }}</td>
                                    <td>{{item.ErrorCode }}</td>
                                    @*<td>{{item.ModuleName }}</td>*@
                                    @*<td>{{item.LoanAccNo }}</td>*@
                                    <!-- ACTION BUTTONS -->
                                    <!--<td style="width:120px;">-->
                                    @*Edit*@
                                    <!--<button ng-if="item.IsFinalSubmit == 0 " type="button" class="btn btn-sm "
                                            ng-click="EditLoanApplication(item.encGccid)">
                                        <i class="fa fa-edit"></i>
                                    </button>-->
                                    @*View*@
                                    <!--<button type="button" class="btn btn-sm view-btn btn-primary"
                                                ng-click="ViewLoanApplication(item.encGccid)">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                    </td>-->
                                </tr>

                                <!-- SHOW "RECORD NOT FOUND" WHEN LIST EMPTY -->
                                <tr ng-if="OTSList.length === 0">
                                    <td colspan="11" class="text-center text-danger">
                                        Record not found
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-12">

                            <div ng-if="DataPagingDetails.TotalPages >1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                    Total Records: {{DataPagingDetails.TotalRecords}}
                                </div>
                                <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                    <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                    <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetOTSList)" style="cursor: pointer;">
                                        <span>«First</span>
                                    </li>
                                    <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetOTSList)" style="cursor:pointer;">
                                        <span>« Previous</span>
                                    </li>
                                    <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetOTSList)"><span>{{n}}</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetOTSList)" style="cursor:pointer;">
                                        <span>Next »</span>
                                    </li>
                                    <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetOTSList)" style="cursor:pointer;">
                                        <span>Last »</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                </div>
            </div>

        </div>
    </div>
</div>

