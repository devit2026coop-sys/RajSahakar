<script>
    $(document).ready(function () {
        $("#ddrYear").val(new Date().getFullYear());
        $("#ddrMonth").val((new Date().getMonth() + 1));
    });

</script>

<div ng-app="SocietyDetails_MPR_RPTMod" ng-controller="SocietyDetails_MPR_RPTCnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">Society Details</h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">Society Details</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div>
                <div class="table-dropdown" id="search-filter">




                    @*Madhuri*@

                    <div class="col-lg-12 form-group">


                        <div class="col-sm-4 margin-Top20 y_dropdown">
                            <label>{{ translation.Division}}:</label>
                            <select name="Divisondll" id="DivisionId" ng-model="DivisionId" class="form-control" ng-init="DivisionId=''" ng-change="DivisonChange()">
                                <option value="">{{translation.SelectOption}}</option>
                                <option ng-repeat="district in DivisionList" value="{{district.DIVISION_ID}}">
                                    {{_language =='en-us' ?  district.DIVISION_ENG : district.DIVISION_MANGAL}}
                                </option>
                            </select>
                        </div>
                        <div class="col-sm-4 margin-Top20 Distri" style="padding-left: 0; display:none">
                            <label>{{ translation.DistrictHeading}}</label>
                            <select name="DistrictId" id="ddlDistrictId" class="form-control" ng-model="FilterSearch.DistrictId" ng-change="DistrictChange() " ng-init="FilterSearch.DistrictId='0'">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                    {{_language =='en-us' ?  district.DISTRICT_ENG : district.DISTRICT_MANGAL}}
                                </option>
                            </select>
                        </div>
                        <div class="form-group1 col-sm-4 UrbRur" style="margin-top: 25px; display: none; min-height: 54px;">
                            <label class="help-block-gender ng-binding" style="width:15% !important;">
                                <input type="radio" id="sdfs" name="Rurals" ng-model="UralUrban" value="1" ng-click="getUrban()" class="ng-pristine ng-untouched ng-valid ng-empty"><span class="URBAN_TXT">Urban</span>
                            </label>
                            <label class="help-block-gender ng-binding" style="width:15% !important;">
                                <input type="radio" id="sdf" value="2" name="Rurals" ng-model="UralUrban" ng-click="getRural()"><span class="RURAL_TXT">Rural</span>
                            </label>
                        </div>

                        <div class="form-group1 col-sm-4 Rurals_MemberAdd  margin-Top20" style="display:none">
                            <label><span class="BLOCK_TXT"> Block </span><span class="error">*</span></label>
                            <select id="ddlblocki_MemberAdd" ng-model="ddlblocki_MemberAdd" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty" ng-change="getGrampanchyat()" ng-init="ddlblocki_MemberAdd='0'">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option ng-repeat="block in BlockDataList" value="{{block.BLOCK_ID}}">
                                    {{_language =='en-us' ?  block.BLOCK_ENG : block.BLOCK_MANGAL}}
                                </option>
                            </select>
                        </div>
                        <div class="form-group1 col-sm-4 Rurals_MemberAdd  margin-Top20" style="display:none">
                            <label><span class="GRAMPANCHAYAT_TXT">Gram Panchayat</span><span class="error">*</span></label>
                            <select id="ddlGP_MemberAdd" ng-model="ddlGP_MemberAdd" class="form-control ng-pristine ng-untouched ng-valid ng-not-empty" ng-change="getvillage()" ng-init="ddlGP_MemberAdd='0'">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option ng-repeat="gp in GramPancyatList" value="{{gp.GP_ID}}">
                                    {{_language =='en-us' ?  gp.GP_ENG : gp.GP_MANGAL}}
                                </option>
                            </select>
                        </div>
                        <div class="form-group1 col-sm-4 Rurals_MemberAdd  margin-Top20" style="display:none">
                            <label><span class="VILLAGE_TXT">Village</span><span class="error">*</span></label>
                            <select id="ddlVillage_MemberAdd" ng-model="ddlVillage_MemberAdd" class="form-control" ng-init="ddlVillage_MemberAdd='0'">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option ng-repeat="vill in VillageList" value="{{vill.VILLAGE_ID}}">
                                    {{_language =='en-us' ?  vill.VILLAGE_ENG : vill.VILLAGE_MANGAL}}
                                </option>
                            </select>
                        </div>

                        <div class="form-group1 col-sm-4 cityward_MemberAdd  margin-Top20" style="display:none">
                            <label><span class="CITY_TXT">City</span><span class="error">*</span></label>
                            <select id="ddlcity_MemberAdd" ng-model="ddlcity_MemberAdd" class="form-control" ng-change="getward()" ng-init="ddlcity_MemberAdd='0'">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option ng-repeat="city in Citylist" value="{{city.CITY_ID}}">
                                    {{_language =='en-us' ?  city.CITY_ENG : city.CITY_MANGAL}}
                                </option>
                            </select>
                        </div>
                        <div class=" col-sm-4 y_dropdown  margin-Top20">
                            <label><span class="CITY_TXT">Act</span><span class="error">*</span></label>
                            <select id="ActID" ng-model="ActID" class="form-control" ng-init="ActID='0'">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option value="1">
                                    Society Registration Act 1958 (NGO, School etc)
                                </option>
                                <option value="3">
                                    Society Registration Act 2001 (Rajasthan Coperative act 2001)
                                </option>
                                <option value="7">
                                    Registration of Sports associations under the Rajasthan Sports Act ,2005

                                </option>

                            </select>
                        </div>




                        <div class="col-sm-4 margin-Top20 ">
                            <label>&nbsp;</label><br>

                            <button type="button" ng-click="GetGridData()" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                            <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                        </div>
                    </div>



                    <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>


                                <th>{{translation.Society}} Name</th>

                                <th>{{translation.RegistrationNo}}</th>
                                <th>{{translation.RegistrationDate}}</th>
                                <th>
                                    {{translation.District}}
                                </th>
                                <th>{{translation.Address}}</th>
                                <th>CEO Name</th>
                                <th>Status</th>


                                <th>{{translation.View}}</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in SocietyList | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">


                                <td>{{$index+1}}</td>




                                <td>
                                    {{item.SocietyName}}
                                </td>

                                <td>{{item.RegistrationNo}}</td>
                                <td>
                                    {{ item.RegistrationDate}}
                                </td>
                                <td>{{_language =='en-us' ?  item.DISTRICT_ENG: item.DISTRICT_MANGAL}}</td>
                                <td>
                                    {{ item.Address}}
                                </td>
                                <td>
                                    {{item.Name}}
                                </td>
                                <td>
                                    {{ item.Status}}
                                </td>

                                <td ng-show="true" style="text-align:center !important">

                                    <i class="fa fa-info-circle" data-target="#popupDetailView" data-toggle="modal" ng-click="GetSocietydetail(item.SocietyId)"></i>
                                </td>

                            </tr>
                        </tbody>

                    </table>

                    <input ng-if="WRDetails.length>0" type="button" id="btnExport" class="btn btn-primary dev-btn" style="" ng-click="ExportData()" value="Export" />
                </div>
            </div>
            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>

        </div>
</div>

    </div>

