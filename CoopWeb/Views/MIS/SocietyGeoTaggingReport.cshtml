@{
    ViewBag.Title = " Societies Geo-Tagging Report ";
}

<script src="~/Scripts/AngularFramework/SocietyGeoTaggingReport.js?v=@DateTime.Now.Ticks"></script>
<div ng-app="TaggingMod" ng-controller="TaggingCtrl" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b>
                    <i class="fa fa-th-list"></i>&nbsp;  Societies Geo-Tagging Report
                </b>
            </div>
            <div class="panel-body">
                <div class="row mb-4">
                    <div class="col-md-4 mt-2">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2"> Total Functional Cooperative Societies </h6>
                                <h3 class="mb-0">{{TotalCooperativeSocieties | number}}</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mt-2">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2"> Geo-Tagging Done </h6>
                                <h3 class="mb-0">{{GeoTaggingDone | number}}</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mt-2">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">  Geo-Tagging Done (%) </h6>
                                <h3 class="mb-0">{{Ratio}}</h3>
                            </div>
                        </div>
                    </div>

                </div>
                <table class="table table-responsive devtable mb-2">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">Sr.No</th>
                            <th class="text-center"> District Name </th>
                            <th class="text-center">Total Cooperative Societies</th>
                            <th class="text-center">Non Functional Societies</th>
                            <th class="text-center">Total Functional Cooperative Societies</th>
                            <th class="text-center">Geo Tagging Done</th>
                            <th class="text-center">Pending Geo Tagging Societies</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in getPagedData() track by $index"
                            ng-style="item.DistrictName == 'Grand Total' && {'font-weight':'bold','color':'black'}">
                            <td><span ng-hide="item.DistrictName == 'Grand Total'">{{$index + 1 + ((currentPage - 1) * pageSize)}}</span></td>
                            <td>
                                {{item.DistrictName}}
                            </td>
                            <td>
                                {{item.TotalSocieties | number}}
                            </td>
                            <td>
                                {{item.TotalNonFunctional | number}}
                            </td>
                            <td>
                                {{item.TotalFunctional | number}}
                            </td>
                            <td>
                                {{item.GeoTaggingDone | number}}
                            </td>
                            <td>
                                {{item.PendingGeoTagging | number}}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="text-right mt-2" ng-if="totalPages > 1" style="margin:15px!important">
                <ul class="pagination justify-content-center">
                    <li class="page-item" ng-class="{disabled: currentPage == 1}">
                        <a class="page-link" href="javascript:void(0)" ng-click="goToPage(1)"> « First  </a>
                    </li>
                    <li class="page-item" ng-class="{disabled: currentPage == 1}">
                        <a class="page-link" href="javascript:void(0)" ng-click="previousPage()"> « Previous </a>
                    </li>
                    <li class="page-item" ng-repeat="page in getPages()" ng-class="{active: currentPage == page}">
                        <a class="page-link" href="javascript:void(0)" ng-click="goToPage(page)">  {{page}} </a>
                    </li>
                    <li class="page-item" ng-class="{disabled: currentPage == totalPages}">
                        <a class="page-link" href="javascript:void(0)" ng-click="nextPage()">  Next » </a>
                    </li>
                    <li class="page-item" ng-class="{disabled: currentPage == totalPages}">
                        <a class="page-link" href="javascript:void(0)" ng-click="goToPage(totalPages)">
                            Last »
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>