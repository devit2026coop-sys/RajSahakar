                                <th ng-repeat-start="indicator in KPIIndicators" style="text-align:center;background:#1899a0;color:#fff;">  TARGET </th>
                                <th style="text-align:center;background:#1899a0;color:#fff;"> ACHIEVEMENT </th>
                                <th style="text-align:center;background:#1899a0;color:#fff;">  WEIGHTED MARKS </th>
                                <th ng-repeat-end style="text-align:center;background:#1899a0;color:#fff;">  MARKS OBTAINED </th>
                            </tr>

                        </thead>

                        <tbody>
                            <tr ng-repeat="pldb in PLDBReportData">
                                <td class="text-center">  {{$index + 1}} </td>
                                <td> {{pldb.PLDBName}}  </td>
                                <td ng-repeat-start="indicator in KPIIndicators" class="text-center">
                                    <span colspan="5" ng-if="indicator.KPIIndicatorsId == 97"> {{getKPIData(pldb, indicator.KPIIndicatorsId).inputtype}} </span>
                                    <span ng-if="indicator.KPIIndicatorsId != 97"> {{getKPIData(pldb, indicator.KPIIndicatorsId).Target}}  </span>
                                </td>
                                <td class="text-center">
                                    <span colspan="5" ng-if="indicator.KPIIndicatorsId == 97"> - </span>
                                    <span ng-if="indicator.KPIIndicatorsId != 97"> {{getKPIData(pldb, indicator.KPIIndicatorsId).Achievement}} </span>
                                </td>
                                <td class="text-center"> {{getKPIData(pldb, indicator.KPIIndicatorsId).WeightedMarks}} </td>
                                <td ng-repeat-end class="text-center">  {{getKPIData(pldb, indicator.KPIIndicatorsId).MarksObtained}} </td>
                                <td class="text-center"> {{pldb.SubTotalWeightedMarks}} </td>
                                <td class="text-center"> {{pldb.SubTotalMarksObtained}}  </td>
                                <td class="text-center">  {{pldb.SubTotalRank}}  </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

