@{
    ViewBag.Title = "GSS Mpacs Target List";
}
<script src="~/Scripts/AngularFramework/GSSMpacsTargetList.js?v=1.2"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />

<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td {
        padding-right: 5px;
        padding-left: 5px;
    }

    .freeze-select {
        pointer-events: none; 
        background-color: #ffffff !important; 
        color: #000 !important; 
        border: 1px solid #ced4da !important; 
        cursor: default !important; 
    }
</style>

<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>


<div ng-app="ApplicationFlowGSSMpacModule" ng-controller="ApplicationGSSMpacFlowCont" ng-cloak="">
    <div>
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">GSS Mpacs Target List</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}}</a> <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> GSS Mpacs Target List </span>
                    </li>
                </ul>
            </div>
        </div>
        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">
                        <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">
                            <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                            <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                            <input type="hidden" id="hdnPldbId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
                            <input type="hidden" id="hdnPldbBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />
                            <input type="hidden" id="hdnUserId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId)" />
                            <input type="hidden" id="hdnLevelId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />



                            <div class="form-group col-md-3">
                                <label>{{ translation.DistrictHeading}}:</label>
                                <select name="DISTRICT_ID" ng-model="DISTRICT_ID" class="form-control">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                        {{_language =='en-us' ?  district.DISTRICT_ENG : district.DISTRICT_MANGAL}}
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-4 ">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-click="searchRequest(GetGSSMpacsTargetList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                                <button type="button" ng-show="showClearButton" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                                <button type="button" onclick="tableToExcel('GSSMpacsTarget', 'GSS Mpacs Target List');" class="btn btn-success dev-btn">
                                    <i class="fa fa-file-excel-o"></i> Export Excel
                                </button>
                            </div>
                        </div>
                    </div>
                   
                    <div style="overflow-x: auto;" >
                        <table id="GSSMpacsTarget" class="table table-responsive devtable">
                            <thead>
                                <tr>
                                    <th width="80">Sr No.</th>
                                    <th style="min-width:125px; text-align:center;">District</th>
                                    <th style="min-width:125px; text-align:center;">Total Alloted</th>
                                    <th style="min-width:125px; text-align:center;">Inspactor Pending</th>
                                    <th style="min-width:125px; text-align:center;">DR Level Pending</th>
                                    <th style="min-width:125px; text-align:center;">JR Plan Self Pending</th>
                                    <th style="min-width:125px; text-align:center;">JR Plan Overall Pending</th>
                                    <th style="min-width:125px; text-align:center;">RCS Level Pending</th>
                                    <th style="min-width:125px; text-align:center;">Sanctioned</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in GSSMpacsTargetSummaryList" ng-style="item.DISTRICT_ENG == 'Total' && {'font-weight':'bold','background':'#466b6d','color':'white'}">
                                    <td style="text-align:center;"> <span ng-if="item.DISTRICT_ENG != 'Total'"> {{$index + 1}} </span> </td>
                                    <td style="text-transform:uppercase;"> {{item.DISTRICT_ENG}} </td>
                                    <td>
                                        <a href="" ng-if="item.DISTRICT_ENG != 'Total'" ng-click="OpenDetails(item.DISTRICT_ID,'TotalAlloted')"> {{item.TotalAlloted}} </a>
                                        <span ng-if="item.DISTRICT_ENG == 'Total'">
                                            {{item.TotalAlloted}}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="" ng-if="item.DISTRICT_ENG != 'Total'" ng-click="OpenDetails(item.DISTRICT_ID,'InspectorPending')"> {{item.InspectorPending}} </a>
                                        <span ng-if="item.DISTRICT_ENG == 'Total'">
                                            {{item.InspectorPending}}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="" ng-if="item.DISTRICT_ENG != 'Total'" ng-click="OpenDetails(item.DISTRICT_ID,'DRLevelPending')"> {{item.DRLevelPending}} </a>
                                        <span ng-if="item.DISTRICT_ENG == 'Total'">
                                            {{item.DRLevelPending}}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="" ng-if="item.DISTRICT_ENG != 'Total'" ng-click="OpenDetails(item.DISTRICT_ID,'JRPlanSelfPending')"> {{item.JRPlanSelfPending}} </a> 
                                        <span ng-if="item.DISTRICT_ENG == 'Total'">
                                            {{item.JRPlanSelfPending}}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="" ng-if="item.DISTRICT_ENG != 'Total'" ng-click="OpenDetails(item.DISTRICT_ID,'JRPlanOverallPending')"> {{item.JRPlanOverallPending}} </a>
                                        <span ng-if="item.DISTRICT_ENG == 'Total'">
                                            {{item.JRPlanOverallPending}}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="" ng-if="item.DISTRICT_ENG != 'Total'" ng-click="OpenDetails(item.DISTRICT_ID,'RCSLevelPending')"> {{item.RCSLevelPending}} </a>
                                        <span ng-if="item.DISTRICT_ENG == 'Total'">
                                            {{item.RCSLevelPending}}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="" ng-if="item.DISTRICT_ENG != 'Total'" ng-click="OpenDetails(item.DISTRICT_ID,'Sanctioned')"> {{item.Sanctioned}} </a>
                                        <span ng-if="item.DISTRICT_ENG == 'Total'">
                                            {{item.Sanctioned}}
                                        </span>
                                    </td>                                    
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="se-pre-con"></div>
    </div>
</div>

