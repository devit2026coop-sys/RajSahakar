
<script src="~/Scripts/AngularFramework/WRCountReport.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />

<script>
    $(document).ready(function () {
        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
        });
    });
</script>
<style type="text/css">
    body {
        font-family: Arial;
        font-size: 10pt;
    }

    table {
        border: 1px solid #ccc;
        border-collapse: collapse;
    }

        table th {
            background-color: #F7F7F7;
            color: #333;
            font-weight: bold;
        }

        table th, table td {
            padding: 5px;
            border: 1px solid #ccc;
        }

    .NewMemberdob input {
        float: left;
        width: 90%;
    }

    .NewMemberdob select {
        float: left;
        width: 90%;
    }

    .NewMemberdob button {
        float: left;
    }

    .notValid {
        border: solid 1px red !important
    }

    .NewRequestList td {
        color: black !important;
    }

    .rowdeleteBtn {
        color: #fff !important;
        font-weight: bold !important;
        font-size: 12px !important;
    }

    .margin-Top20 {
        margin-top: 20px;
    }
</style>
<div ng-app="WRReportMod" ng-controller="WRReportCont">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.WRReport}}</h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.WRReport}}   </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">

            <div>
                <div class="table-dropdown" id="search-filter">

                    <div class="col-md-2" style="padding-left: 0;">
                        <label>{{ translation.Commodity}}</label>
                        <select name="item_kind" ng-model="WrSearch.CommodityId" class="form-control" ng-init="WrSearch.CommodityId=''">
                            <option value="">{{translation.SelectOption}}</option>
                            <option ng-repeat="commodity in Commodities" value="{{commodity.CommodityId}}">
                                {{_language =='en-us' ?  commodity.CommodityNameEn : commodity.CommodityNameHi}}
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2 NewMemberdob">
                        <label>
                            {{translation.FromDate}}
                        </label>
                        <input id="txtFromDate" name="FromDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.FromDate" placeholder="{{translation.FromDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                    </div>
                    <div class="col-md-2 NewMemberdob">
                        <label>
                            {{translation.ToDate}}
                        </label>
                        <input id="txtToDate" name="ToDate" disabled="disabled" class="form-control SetCalender" ng-model="Filter.ToDate" placeholder="{{translation.ToDate}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                    </div>


                    <div class="col-md-4">
                        <label>&nbsp;</label><br>
                        <button type="button" ng-click="searchRequest(SearchData)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                        <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                    </div>
                </div>

                <div class="col-md-12" style="max-width: 98%;overflow: auto;">
                    <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    #
                                </th>
                                <th  style="text-align:center;">{{translation.Date}}</th>
                                <th ng-repeat="col in Column"  style="text-align:center;">{{col}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in WRDetails" ng-if="$index>0">
                                <td  style="text-align:center;">{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index-1}}</td>
                                <td  style="text-align:center;">{{item.dt}}</td>
                                <td ng-repeat="cl in Column"  style="text-align:center;">
                                    {{item['name'+($index+1)]}}
                                </td>
                            </tr>
                            <tr>
                                <th colspan="2" style="text-align:right;">Total</th>
                                <th ng-repeat="ttl in ColumnTotal"  style="text-align:center;">{{ttl.Count}}</th>
                            </tr>
                        </tbody>

                    </table>
                </div>
                <div class="col-md-12">
                    <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                        <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                            Total Records: {{DataPagingDetails.TotalRecords}}
                        </div>
                        <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',searchRequest)" style="cursor: pointer;">
                                <span>«First</span>
                            </li>
                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,searchRequest)" style="cursor:pointer;">
                                <span>« Previous</span>
                            </li>
                            <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,searchRequest)"><span>{{n}}</span></li>
                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                            <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,searchRequest)" style="cursor:pointer;">
                                <span>Next »</span>
                            </li>
                            <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,searchRequest)" style="cursor:pointer;">
                                <span>Last »</span>
                            </li>
                        </ul>
                    </div>
                </div>


                <div class="col-md-12">
                    <input ng-if="WRDetails.length>0" type="button" id="btnExport" class="btn btn-primary dev-btn" style="" ng-click="ExportData()" value="Export" /> 
                </div>


  

                </div>
        </div>
        <input type="hidden" value="@ViewBag.FromDate" id="fromdateserver" />
        <input type="hidden" value="@ViewBag.TodateDate" id="todateserver" />
        <input type="hidden" value="@ViewBag.MinDate" id="mindateserver" />
    </div>
</div>
