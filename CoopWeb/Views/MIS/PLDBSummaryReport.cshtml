@{
    ViewBag.Title = "PLDB Summary Report";
}
<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }
</style>
<script src="~/Scripts/AngularFramework/PLDBSummaryReport.js?v=1.2"></script>
<div ng-app="BeneficiaryListMod" ng-controller="BeneficiaryListCnt" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
        <input type="hidden" id="hdnPldbId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
        <input type="hidden" id="hdnPldbBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />

        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; PLDB Summary Report</b>
                <div class="text-right">
                    <button ng-click="BackToPage()" class="btn btn-primary dev-btn">Back To List</button>
                    <button type="button" class="btn btn-warning" ng-click="exportDivToExcel('exportDiv','Summary_Report')"><i class="fa fa-file-excel-o"></i> Export Excel</button>
                </div>
            </div>

            <div class="panel-body">
                <input type="hidden" id="hdnDistrictId" ng-model="search.LoanDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="help-block-gender">
                            <input type="radio" id="NormalSummary" name="ReportType" ng-value="1" ng-model="ReportType" ng-change="GetPldbSummary(false) " selected> Normal Case
                        </label>
                        <label class="help-block-gender">
                            <input type="radio" id="Under103CaseSummary" ng-value="2" name="ReportType" ng-model="ReportType" ng-change="GetPldbSummary(false)">  103 Case
                        </label>
                        <label class="help-block-gender">
                            <input type="radio" id="PldbBothSummary" ng-value="3" name="ReportType" ng-model="ReportType" ng-change="GetPldbSummary(false)">  Both
                        </label>
                    </div>
                    <div class="col-md-6 form-group">
                    </div>
                </div>


                <div class="row" id="search-filter">
                    @*<div class="col-md-2">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" name="SearchText" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>*@
                    <div class="col-md-2">
                        <label for="search">{{translation.ItemPerPage}}:</label>
                        <input type="number" min="1" max="1000" class="form-control" ng-model="pageSize" ng-change="pagechange()">
                    </div>

                    <div class="col-md-2 form-group" ng-show="false">
                        <label>{{ translation.District}}<span class="error">*</span></label>
                        <select id="DISTRICT_ID" ng-model="search.DISTRICT_ID" class="form-control" ng-init="search.DISTRICT_ID='0'" ng-change="PLDBListData(0)">
                            <option value="0">{{translation.SelectOption}}</option>
                            <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>

                    <div class="col-lg-2 margin-Top20" style="padding-left: 0;" id="ddlPLDBID">
                        <label for="PLDB_ID">{{ translation.PLDB}} </label>
                        <select id="PLDB_ID" name="PLDB_ID" ng-model="search.PLDB_ID" class="form-control" ng-init="PLDB_ID='0'" ng-change="PLDBBranchList('0')">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemPLDB in PLDBList  track by itemPLDB.PldbId " value="{{itemPLDB.PldbId}}">
                                {{itemPLDB.PLDBName}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2 margin-Top20" style="padding-left: 0;" id="ddlPldbBranchID">
                        <label for="PLDB_Branch_ID">{{ translation.Branch}}</label>
                        <select ng-model="search.PLDB_Branch_ID" name="PLDB_Branch_ID" id="PLDB_Branch_ID" class="form-control" ng-init="PLDB_Branch_ID='0'" ng-change="GetPldbSummary(false)">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemBlock in PLDBBranches " value="{{itemBlock.BLOCK_ID}}">
                                {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                            </option>
                        </select>
                    </div>

                </div>


                <div class="clearfix"></div>
                <div class="row " style="padding-top:10px" id="exportDiv">
                    <div class="table-responsive devtable ">
                        <table class="table table-hover table-striped table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="text-align:center" width="60">{{translation.SRNO}}</th>
                                    <th rowspan="2" style="text-align:center">{{_language =='en-us' ? 'Primary Bank': 'प्राथमिक बैंक' }}</th>
                                    <th rowspan="2" style="text-align:center">{{_language =='en-us' ? 'Bank Branch': 'बैंक शाखा' }}</th>
                                    <th rowspan="2" style="text-align:center">{{_language =='en-us' ? 'Number of borrowers benefited':'लाभान्वित ऋणियों  की संख्या '}}</th>
                                    <th colspan="4" ng-show="ReportType!=2" style="text-align:center">{{translation.OD_1_7}}</th>
                                    <th colspan="4" ng-show="ReportType!=2" style="text-align:center">{{translation.OD_31_3}}</th>
                                    <th colspan="5" ng-show="ReportType!=1" style="text-align:center">{{translation.detailsofcasesunderact103}}</th>

                                </tr>
                                <tr>
                                    <th ng-show="ReportType!=2" style="text-align:center">{{translation.ODPrincipal}}</th>
                                    <th ng-show="ReportType!=2" style="text-align:center">{{translation.InsurancePremium}}</th>
                                    <th ng-show="ReportType!=2" style="text-align:center">{{translation.ODInterest}}</th>
                                    <th ng-show="ReportType!=2" style="text-align:center">{{translation.PenalInterest}}</th>
                                    @*<th ng-show="ReportType!=2" style="text-align:center">{{translation.ODTotal}}</th>*@

                                    <!--NOD-->
                                    <th ng-show="ReportType!=2" style="text-align:center">{{translation.ODPrincipal}}</th>
                                    <th ng-show="ReportType!=2" style="text-align:center">{{translation.InsurancePremium}}</th>
                                    <th ng-show="ReportType!=2" style="text-align:center">{{translation.ODInterest}}</th>
                                    <th ng-show="ReportType!=2" style="text-align:center">{{translation.PenalInterest}}</th>
                                    @*<th ng-show="ReportType!=2" style="text-align:center">{{translation.ODTotal}}</th>*@

                                    <th ng-show="ReportType!=1" style="text-align:center">{{translation.principaloutstanding}}</th>
                                    <th ng-show="ReportType!=1" style="text-align:center">{{translation.totalinterestasonresolutiondate}}</th>
                                    <th ng-show="ReportType!=1" style="text-align:center">{{translation.totaloutstandingasonresolutiondate}}</th>
                                    <th ng-show="ReportType!=1" style="text-align:center">{{translation.interestfromresolutionto30062024}}</th>
                                    <th ng-show="ReportType!=1" style="text-align:center">{{translation.interestfrom30062024to31032025}}</th>
                                </tr>


                            </thead>

                            <tbody>
                                <tr ng-repeat="item in GetPldbSummaryList">
                                    <td>{{$index+1}}</td>
                                    <td align="center">{{item.PLDBName}}</td>
                                    <td align="center">{{item.BranchName_En}}</td>
                                    <td align="center">{{item.TotalApplication}}</td>

                                    <td align="center" ng-show="ReportType!=2">{{item.ODPrincipal}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.ODInsurancePremium}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.ODInterest}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.ODPenalInterast}}</td>
                                    @*<td align="center" ng-show="ReportType!=2">{{item.ODTotal}}</td>*@
                                    <td align="center" ng-show="ReportType!=2">{{item.NODPrincipal}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.NODInsurancePremium}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.NODInterest}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.NODPenalInterest}}</td>

                                    <td align="center" ng-show="ReportType!=1">{{item.PrincipalOutstandingAsOnDateSettlement}}</td>
                                    <td align="center" ng-show="ReportType!=1">{{item.TotalInterestAsOnDateSettlement}}</td>
                                    <td align="center" ng-show="ReportType!=1">{{item.TotalLoanOutstandingAsOnDateSettlement}}</td>
                                    <td align="center" ng-show="ReportType!=1">{{item.InterestFromSettlementPre}}</td>
                                    <td align="center" ng-show="ReportType!=1">{{item.InterestFromSettlement}}</td>
                                </tr>
                            </tbody>

                            <tfoot ng-show="GetPldbSummary!=null">
                                <tr ng-repeat="item in TotalGetPldbSummary">
                                    <td colspan="3" align="right"><b>Total</b></td>
                                    <td align="center"><b>{{item.TotalApplication}}</b></td>

                                    <td align="center" ng-show="ReportType!=2">{{item.TotalODPrincipal}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.TotalODInsurancePremium}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.TotalODInterest}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.TotalODPenalInterast}}</td>
                                    @*<td align="center" ng-show="ReportType!=2">{{item.TotalODTotal}}</td>*@
                                    <td align="center" ng-show="ReportType!=2">{{item.TotalNODPrincipal}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.TotalNODInsurancePremium}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.TotalNODInterest}}</td>
                                    <td align="center" ng-show="ReportType!=2">{{item.TotalNODPenalInterest}}</td>

                                    <td align="center" ng-show="ReportType!=1">{{item.TotalPrincipalOutstandingAsOnDateSettlement}}</td>
                                    <td align="center" ng-show="ReportType!=1">{{item.TotalTotalInterestAsOnDateSettlement}}</td>
                                    <td align="center" ng-show="ReportType!=1">{{item.TotalTotalLoanOutstandingAsOnDateSettlement}}</td>
                                    <td align="center" ng-show="ReportType!=1">{{item.TotalInterestFromSettlementPre}}</td>
                                    <td align="center" ng-show="ReportType!=1">{{item.TotalInterestFromSettlement}}</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>





            </div>
        </div>
    </div>
</div>
