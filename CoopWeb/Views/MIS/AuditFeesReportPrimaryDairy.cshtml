
<script src="~/Scripts/AngularFramework/AuditFeesReportPrimaryDairy.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />


<style>
    .footer-bold td {
        font-weight: bold;
    }
</style>
@Html.Hidden("TemplateId")
<div ng-app="AuditProgressReportBySociety" ng-controller="AuditProgressReportBySocietycnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">समिति की कैटोगरी वाईज बकाया ऑडिट फीस की रिपोर्ट</h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">समिति की कैटोगरी वाईज बकाया ऑडिट फीस की रिपोर्ट</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div class="table-dropdown" id="search-filter" style="overflow:inherit; float:left;width: 100%;margin-bottom: 10px;">
                <div class="col-lg-3 form-group">
                    <label>{{translation.SocietyCategory}}</label>
                    <select class="form-control" id="ddlCategoryId" ng-model="Liqudation.CategoryId" ng-init="Liqudation.CategoryId='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in SocietyCategory" value="{{item.CategoryId}}">
                            {{item.CategoryNameHi}}
                        </option>
                    </select>
                </div>

                @*<div class="col-lg-3 form-group">
                        <label>{{translation.YEAR}}</label>
                        <select class="form-control" id="ddlFYearId" ng-model="Liqudation.FYearId" ng-init="Liqudation.FYearId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_END}}">
                                {{item.FIN_YEAR_END}}
                            </option>
                        </select>
                    </div>*@
                <div class="col-md-2 margin-Top20 y_dropdown" style="padding-left: 0;">
                    <label for="search" class="ng-binding">{{translation.Month}}:</label>
                    <input id="txtFromMonth" value="date" type="month" class="form-control" autocomplete="off" onkeypress="return false;" />
                    @*<input id="txtFromMonth" value="date" type="month" class="form-control" autocomplete="off" onkeypress="return false;" />*@
                </div>





                <div class="col-lg-3 form-group">
                    <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="GridData2()">{{translation.Show}}</button>
                </div>
            </div>
            <table class="table table-responsive devtable" style="overflow-x:auto;">
                <thead>
                    <tr>
                        <th rowspan="2" style="text-align: center !important;vertical-align:middle;">
                            क्र.स
                        </th>
                        <th rowspan="2" style="text-align: center !important;vertical-align:middle;">
                            नाम इकाई / खण्ड
                        </th>
                        <th colspan="2" style="text-align: center !important;vertical-align:middle;">
                            बकाया ऑडिट फीस ( लाख में )
                        </th>
                        <th rowspan="2" style="text-align: center !important;vertical-align:middle;">
                            कुल बकाया ऑडिट फीस ( लाख में )
                        </th>
                    </tr>
                    <tr>
                        <th style="text-align: center !important;vertical-align:middle;">चालू वर्ष बकाया ( लाख में ) </th>
                        <th style="text-align: center !important;vertical-align:middle;">गत बकाया (बैकलॉग) ( लाख में )</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="BData in DataList" ng-class="{'footer-bold': BData.IsFooter == 1}">
                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                        <td style="text-align:left !important">
                            @*{{BData.ResionNameHi}}*@
                            {{BData.DISTRICT}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.Auditorfees/100000}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.AuditorBaclogfees/100000}}
                        </td>
                        <td style="text-align:center !important">
                            {{BData.Auditorfees/100000 + BData.AuditorBaclogfees/100000}}
                        </td>
                        @*<td style="text-align:center !important">
                                {{BData.total}}
                            </td>*@


                        @*
                            <td style="text-align:center !important">
                                {{BData.AuditorRemainigfees}}
                            </td>*@
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td></td>
                        <td style="text-align:left !important">
                            महायोग राज्य
                        </td>
                        <td style="text-align:center !important">
                            {{(DataList  | filter:{IsFooter:1} | sumByKey:'Auditorfees') / 100000 }}
                        </td>
                        <td style="text-align:center !important">
                            {{ (DataList  | filter:{IsFooter:1} | sumByKey:'AuditorBaclogfees') / 100000 }}
                        </td>
                        <td style="text-align:center !important">
                            {{((DataList  | filter:{IsFooter:1} | sumByKey:'Auditorfees') + (DataList | sumByKey:'AuditorBaclogfees')) / 100000 | number:2}}
                        </td>
                    </tr>
                </tfoot>

            </table>
        </div>
    </div>
</div>
