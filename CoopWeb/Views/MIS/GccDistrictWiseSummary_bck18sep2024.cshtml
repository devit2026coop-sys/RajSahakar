@{
    ViewBag.Title = "District Wise Summary";   
}
<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }


        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }
</style>
<script src="~/Scripts/AngularFramework/GccDistrictWiseSummary.js?id=1"></script>
<div ng-app="BeneficiaryListMod" ng-controller="BeneficiaryListCnt" ng-cloak="">

    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; District Wise Summary</b>
                <a href="~/Mis/GccDistrictWiseSummary" class="backBtn"><i class="fa fa-angle-left"></i>Back</a>
            </div>
            <div class="panel-body">
                <div class="row">
                   

                    @*<div class="col-md-3 form-group">
                        <label>
                            {{translation.District}}
                        </label>
                        <select ng-model="search.LoanDistrictId" class="form-control" ng-init="search.LoanDistrictId='0'" ng-change="LoanBankList('0')" id="DistId">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>*@
                    <div class="col-md-3 form-group">
                        <label>
                            {{translation.BankName}}
                        </label>
                        <select ng-model="search.LoanBankID" ng-disabled="IsSubmiApplication" id="BankID" class="form-control" ng-init="search.LoanBankID='0'" ng-change="Get_LoanBankBranch('0')">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemBlock in BankMasterList | orderBy:'CCBNameEn'" value="{{itemBlock.CCBId}}">
                                {{_language =='en-us' ?  itemBlock.CCBNameEn : itemBlock.CCBNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label>
                            {{translation.BankBranch}}
                        </label>
                        <select ng-model="search.LoanBranchId" id="BranchId" class="form-control" ng-init="search.LoanBranchId='0'" ng-change="Get_LoanBranch_PACS('0')">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemBlock in BankBranches | orderBy:'BranchNameEn'" value="{{itemBlock.Branch_ID}}">
                                {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameHi}}
                            </option>
                        </select>
                    </div>

                </div>

                <div class="table-responsive devtable citizen-dash-head">
                    <table class="table table-hover table-striped table-bordered mb-0">
                        <thead>
                            <tr>
                                <th valign="middle" width="60">Sr. No.</th>
                                <th valign="middle">{{(search.LoanDistrictId!='0' && search.LoanBankID!='0' && search.LoanBranchId!='0' ?'Pacs Name':search.LoanDistrictId!='0' && search.LoanBankID!='0'?'Branch Name':search.LoanDistrictId!='0'?'CCB Name':'District Name')}}</th>
                                <th valign="middle" class="text-center">Total Application</th>
                                <th valign="middle" class="text-center">Approve</th>
                                <th valign="middle" class="text-center">Sanctioned</th>
                                <th valign="middle" class="text-center">Reject</th>
                                <th valign="middle" class="text-center">Assign To Pacs</th>
                                <th valign="middle" class="text-center">Assign To BM</th>
                                <th valign="middle" class="text-center">Assign To MD</th>
                            </tr>
                           
                        </thead>
                        <tbody>

                            <tr ng-repeat="item in GccSummary">
                                <td>{{$index+1}}.</td>
                                <td>
                                    {{(search.LoanDistrictId!='0' && search.LoanBankID!='0' && search.LoanBranchId!='0'?item.PACSNameEn:search.LoanDistrictId!='0' && search.LoanBankID!='0'?item.BranchNameEn:search.LoanDistrictId!='0'?item.CCBNameEn:item.DISTRICT_ENG)}}
                                </td>
                                <td align="center">{{item.TotalGcc}}</td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.LoanDistrictId!='0'?search.LoanDistrictId:item.DISTRICT_ID}}&FyId={{FinancialYearId}}&ccbId={{search.LoanBankID!='0'?search.LoanBankID:search.LoanDistrictId!='0'?item.CCBId:'0'}}&branchId={{search.LoanBranchId!='0'?search.LoanBranchId:search.LoanBankID!='0'?item.Branch_ID:0}}&pacsId={{search.LoanDistrictId!='0' && search.LoanBankID!='0' && search.LoanBranchId!='0'?item.PACS_ID:'0'}}&statusType=1">{{item.ApproveGcc}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.LoanDistrictId!='0'?search.LoanDistrictId:item.DISTRICT_ID}}&FyId={{FinancialYearId}}&ccbId={{search.LoanBankID!='0'?search.LoanBankID:search.LoanDistrictId!='0'?item.CCBId:'0'}}&branchId={{search.LoanBranchId!='0'?search.LoanBranchId:search.LoanBankID!='0'?item.Branch_ID:0}}&pacsId={{search.LoanDistrictId!='0' && search.LoanBankID!='0' && search.LoanBranchId!='0'?item.PACS_ID:'0'}}&statusType=2">{{item.SanctionGcc}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.LoanDistrictId!='0'?search.LoanDistrictId:item.DISTRICT_ID}}&FyId={{FinancialYearId}}&ccbId={{search.LoanBankID!='0'?search.LoanBankID:search.LoanDistrictId!='0'?item.CCBId:'0'}}&branchId={{search.LoanBranchId!='0'?search.LoanBranchId:search.LoanBankID!='0'?item.Branch_ID:0}}&pacsId={{search.LoanDistrictId!='0' && search.LoanBankID!='0' && search.LoanBranchId!='0'?item.PACS_ID:'0'}}&statusType=3">{{item.RejectGcc}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.LoanDistrictId!='0'?search.LoanDistrictId:item.DISTRICT_ID}}&FyId={{FinancialYearId}}&ccbId={{search.LoanBankID!='0'?search.LoanBankID:search.LoanDistrictId!='0'?item.CCBId:'0'}}&branchId={{search.LoanBranchId!='0'?search.LoanBranchId:search.LoanBankID!='0'?item.Branch_ID:0}}&pacsId={{search.LoanDistrictId!='0' && search.LoanBankID!='0' && search.LoanBranchId!='0'?item.PACS_ID:'0'}}&statusType=4">{{item.AssignToPacs}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.LoanDistrictId!='0'?search.LoanDistrictId:item.DISTRICT_ID}}&FyId={{FinancialYearId}}&ccbId={{search.LoanBankID!='0'?search.LoanBankID:search.LoanDistrictId!='0'?item.CCBId:'0'}}&branchId={{search.LoanBranchId!='0'?search.LoanBranchId:search.LoanBankID!='0'?item.Branch_ID:0}}&pacsId={{search.LoanDistrictId!='0' && search.LoanBankID!='0' && search.LoanBranchId!='0'?item.PACS_ID:'0'}}&statusType=5">{{item.AssignToBM}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.LoanDistrictId!='0'?search.LoanDistrictId:item.DISTRICT_ID}}&FyId={{FinancialYearId}}&ccbId={{search.LoanBankID!='0'?search.LoanBankID:search.LoanDistrictId!='0'?item.CCBId:'0'}}&branchId={{search.LoanBranchId!='0'?search.LoanBranchId:search.LoanBankID!='0'?item.Branch_ID:0}}&pacsId={{search.LoanDistrictId!='0' && search.LoanBankID!='0' && search.LoanBranchId!='0'?item.PACS_ID:'0'}}&statusType=6">{{item.AssignToCCB}}</a></td>
                               
                            </tr>
                          


                        </tbody>
                        <tfoot>
                            <tr ng-repeat="item in TotalGccSummary">
                                <td colspan="2" align="right"><b>Total</b></td>
                                <td align="center"><b>{{item.TotalGcc}}</b></td>
                                <td align="center"><b>{{item.ApproveGcc}}</b></td>
                                <td align="center"><b>{{item.SanctionGcc}}</b></td>
                                <td align="center"><b>{{item.RejectGcc}}</b></td>
                                <td align="center"><b>{{item.AssignToPacs}}</b></td>
                                <td align="center"><b>{{item.AssignToBM}}</b></td>
                                <td align="center"><b>{{item.AssignToCCB}}</b></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="clearfix"></div>
              
            </div>
        </div>

    </div>
</div>
