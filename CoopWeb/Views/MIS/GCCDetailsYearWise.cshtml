@{
    ViewBag.Title = "Gopal Credit Card Data Year Wise Information Details";
}
<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }


        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }
</style>
<script src="~/Scripts/AngularFramework/GCCDetailsYearWise.js?v=1.4"></script>
<div ng-app="GCCDataYearWiseDetailsMod" ng-controller="GCCDataYearWiseDetailsCnt" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; Gopal Credit Card Data Year Wise Information Details List </b>
            </div>

            <div class="panel-body">
                <input type="hidden" id="hdnDistrictId" ng-model="search.LoanDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />               

                <div class="table-responsive devtable">
                    <table class="table table-hover table-striped table-bordered mb-0">
                        <thead>
                            <tr>
                                <th valign="middle" width="60">Sr.No.</th>                                                                    
                                <th valign="middle" class="text-center"> Application Name </th>
                                <th valign="middle" class="text-center"> DOB </th>
                                <th valign="middle" class="text-center"> Gender </th>
                                <th valign="middle" class="text-center"> Status </th>
                                <th valign="middle" class="text-center"> Sanction  </th>                                  
                            </tr>
                        </thead>
                        <tbody>             
                            <tr ng-repeat="item in DetailData">
                                <td>{{$index+1}}</td>
                                <td class="text-center">{{item.Name_ENG}}</td>
                                <td class="text-center">{{item.DOB}}</td>
                                <td class="text-center">{{item.Gender}}</td>
                                <td class="text-center">{{item.ProceesStatusTextEn}}</td>
                                <td class="text-center">{{item.SanctionAmt}}</td>                             
                            </tr>           
                        </tbody>                        
                    </table>
                </div>                
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>
