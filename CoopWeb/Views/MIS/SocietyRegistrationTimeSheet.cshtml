                            </th>
                            <th>{{translation.TotalSociety}} {{translation.Approved}}</th>
                            <th>
                                Average Approved Time(in Days)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in RegistrationTimeSheet">
                            <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
