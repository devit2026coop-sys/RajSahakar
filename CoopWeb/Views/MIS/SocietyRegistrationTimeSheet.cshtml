                            <td>
                                {{item.DISTRICT_ENG}}
                            </td>
                            <td>{{item.TotalSociety}}</td>
                            <td>
                                {{ item.TotalApprovedSociety}}
                            </td>
                            <td>
                                {{ item.AverageApprovedDays}}
                            </td>
                        </tr>
                    </tbody>
                   
                </table>

                <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;" ng-if="TimeSheet.Type==2">
