<script type="text/javascript">
    function TimeCheck() {

        var Time1 = $('#txtStartTime').val();
        var Time2 = $('#txtEndTime').val();
        var date2 = $('#txtEndDate').val();
        var date1 = $('#txtStartDate').val();

        if (date2 != "" && date1 != "") {
            if (date1 > date2) {
                alert("Please ensure that the End Date is greater than or equal to the Start Date.");
                $("#txtEndDate").val('');
            }
        }
        if (Time2 != "" && Time1 != "") {
            if (Time1 > Time2) {
                alert("Please ensure that the End Time is greater than or equal to the Start Time.");
                $("#txtEndDate").val('');
            }
        }
        else {
            return false;
        }
    }
</script>
