<div ng-app="AppTrainnging">
    <div ng-controller="Trainnging">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.TrainningReport}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.MIS}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.TrainningReport}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        &nbsp;
                    </li>
                </ul>
            </div>
        </div>
        <div class="citizen-dash-head" ng-show="DivtringGrid">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-lg-12 form-group">
                            <div class="col-lg-4" style="padding-left: 0;">
                                <label for="search">{{translation.ChannelName}}:</label>
                                <select ng-model="Trainning.ChannelId" class="form-control" ng-init="Trainning.ChannelId='0'" ng-change="GetAllTrainningList()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Channels" value="{{item.ChannelId}}">
                                        {{_language =='en-us' ?  item.ChannelName_En : item.ChannelName_Hi}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-lg-4" style="padding-left: 0;">
                                <label for="search">{{translation.Organization}}:</label>
                                <select class="form-control" id="ddlOrganisation" ng-model="Trainning.OrganisationId" ng-init="Trainning.OrganisationId='0'" ng-change="GetAllTrainningList()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in OrganisationData" value="{{item.OrganisationId}}">
                                        {{_language =='en-us' ?  item.OrganisationNameEn : item.OrganisationNameHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>


                        </div>

                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                        <div class="col-md-4" style="padding-left: 654px; padding-top: 35px;">
                            <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                        </div>
                    </div>
                    <div style="min-width:100%;overflow-x :scroll;" id="tblgetsuport">
                        <table class="table table-responsive devtable" style="overflow-x:auto;">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th ng-click="sortData('ProgrammeNameEn')">
                                        {{translation.ProgrammeNameEn}}
                                        <div ng-class="getSortClass('ProgrammeNameEn')"></div>
                                    </th>
                                    @*<th ng-click="sortData('ProgrammeNameHi')">
                            {{translation.ProgrammeNameHi}}
                            <div ng-class="getSortClass('ProgrammeNameHi')"></div>
                        </th>*@
                                    <th ng-click="sortData('ChannelName_Hi')">
                                        {{translation.ChannelName}}
                                        <div ng-class="getSortClass('ChannelName_Hi')"></div>
                                    </th>
                                    <th ng-click="sortData('TargetName_En')">
                                        {{translation.OrganisationNameEng}}
                                        <div ng-class="getSortClass('TargetName_En')"></div>
                                    </th>
                                    <th ng-click="sortData('StartDate')">
                                        {{translation.StartDate}}
                                        <div ng-class="getSortClass('StartDate')"></div>
                                    </th>
                                    <th ng-click="sortData('EndDate')">
                                        {{translation.EndDate}}
                                        <div ng-class="getSortClass('EndDate')"></div>
                                    </th>
                                    <th ng-click="sortData('StartTime')">
                                        {{translation.StartTime}}
                                        <div ng-class="getSortClass('StartTime')"></div>
                                    </th>
                                    <th ng-click="sortData('EndTime')">
                                        {{translation.EndTime}}
                                        <div ng-class="getSortClass('EndTime')"></div>
                                    </th>
                                    <th>
                                        {{translation.File}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="Trainning in TrainningData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                    <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                    <td>
                                        {{Trainning.ProgrammeNameEn}}
                                    </td>

                                    <td>
                                        {{Trainning.ChannelName_En}}
                                    </td>

                                    <td>
                                        {{Trainning.OrgFullName_En}}
                                    </td>

                                    <td>
                                        {{Trainning.StartDate}}
                                    </td>
                                    <td>
                                        {{Trainning.EndDate}}
                                    </td>
                                    <td>
                                        {{Trainning.StartTime}}
                                    </td>
                                    <td>
                                        {{Trainning.EndTime}}
                                    </td>
                                   {{Trainning.FileName}}
<td><a href="{{Trainning.FileName}}" target="_blank"><img src="~/Images/PDF.png" /></a></td>

                                </tr>
                            </tbody>
                        </table>
                    </div>
                    </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="TrainningFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2" ng-show="DivSms">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>
</div>
