@*@{
        ViewBag.Title = "Gopal Credit Card Appliation List";
    }*@
<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }


        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }
    .ui-datepicker {
        z-index: 9999 !important;
    }


    .SetCalender {
        background: url("../images/calender.png") no-repeat right 8px center;
        background-size: 20px 20px;
        padding-right: 30px; /* space for icon */
        cursor: pointer;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {

        $('.SetCalender').datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: "dd/mm/yy",
            showOn: "focus",
            maxDate: 0,
            // defaultDate: new Date() 
        });//.datepicker("setDate", new Date());            
       
    });
</script>
<script src="~/Scripts/AngularFramework/DueDateDiary.js?v=1.2"></script>
<div ng-app="GccApplicationListMod" ng-controller="GccApplicationListCnt" ng-cloak="">
    <input type="hidden" id="hdnGccId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).GccId)" />
    <input type="hidden" id="hdnLevelId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />

    <div class="container-fluid  citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp;Due Date Diary</b>
                <div>

                    @*<div class="row">
                        <div class="col-xs-12" align="right">
                            <a href="~/MIS/DueDateDiary" class="backBtn"><i class="fa fa-angle-left"></i>Back</a>
                          
                        </div>
                    </div>*@
                </div>
            </div>
            <div id="search-filter">
                <div class="table-dropdown">
                    <div class="form-group col-md-12">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" name="SearchText" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-2">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <select ng-model="obj.pageSize" class="form-control" ng-change="pagechange()" ng-init="obj.pageSize='50'">
                                <option value="10">10</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                                <option value="200">200</option>
                                <option value="500">500</option>
                                <option value="1000">1000</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-12">

                        <div class="col-md-2  form-group">
                            <label>
                                {{translation.FromDate}}
                            </label>
                            <input id="txtFromDate" type="text" name="FromDate" class="form-control SetCalender " ng-model="Filter.FromDate" placeholder="{{translation.FromDate}}" autocomplete="off" readonly>
                        </div>
                        <div class="col-md-2 NewMemberdob form-group">
                            <label>
                                {{translation.ToDate}}
                            </label>
                            <input id="txtToDate" type="text" name="ToDate" class="form-control SetCalender Todate" ng-model="Filter.ToDate" placeholder="{{translation.ToDate}}" autocomplete="off" readonly>
                        </div>

                        <div class="col-md-3 form-group"  ng-show="levelId==1">
                            <label>
                                {{translation.BankName}}
                            </label>
                            <select ng-model="search.LoanBankID" name="CcbId" ng-disabled="IsSubmiApplication || isLBDisabled" ng-init="search.LoanBankID=='0'" class="form-control" ng-change="Get_LoanBankBranch('0')">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="itemBlock in BankMasterList | orderBy:'CCBNameEn'" value="{{itemBlock.CCBId}}">
                                    {{_language =='en-us' ?  itemBlock.CCBNameEn : itemBlock.CCBNameHi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-3 form-group" ng-show="search.LoanBankID>0">
                            <label>
                                {{translation.BankBranch}}
                            </label>
                            <select ng-model="search.LoanBranchId" name="CcbBranchId" id="BranchId" class="form-control"  ng-change="Get_LoanBranch_PACS('0')">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="itemBlock in BankBranches | orderBy:'BranchNameEn'" value="{{itemBlock.Branch_ID}}">
                                    {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameHi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-2 form-group" ng-show="search.LoanBranchId>0">
                            <label>
                                {{translation.PACSName}}
                            </label>
                            <select ng-model="search.PACS_ID" name="PacsId" id="PacsId" class="form-control">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="itemBlock in PACSNameList | orderBy:'BLOCK_ENG'" value="{{itemBlock.PACS_ID}}">
                                    {{_language =='en-us' ?  itemBlock.PACSNameEn : itemBlock.PACSNameEn}}
                                </option>
                            </select>
                        </div>
                    </div>


                    <div class="form-group col-md-12">
                        <div class="dev-align-btn">
                            <button type="submit" class="btn btn-primary dev-btn" ng-click="searchRequest(GetGccApplicationList)">{{translation.Search}}</button>
                            <button type="button" class="btn btn-warning" ng-click="exportExcel()"><i class="fa fa-file-excel-o"></i> Export Excel</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-body">
                <div class="table-responsive devtable">
                    <table class="table table-hover table-striped table-bordered mb-0">
                        <thead>
                            <tr>
                                <th>Sr. No.</th>
                                <th>Application No</th>
                                <th>CCB</th>
                                <th>Branch</th>
                                <th>GSS/PACS</th>
                                <th>Loan Amount</th>
                                <th>Disbursed Date</th>
                                <th>Due Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in GccApplicationList | filter:q | orderBy:colsort:reverseSort | itemsPerPage: obj.pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                                <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                                <td>{{item.ApplicationNo}}</td>
                                <td>{{item.CCBName}}</td>
                                <td>{{item.BranchName}}</td>
                                <td>{{item.PACSName}}</td>
                                <td>{{item.sanctionAmt}}</td>
                                <td>{{item.DisbursedDate}}</td>
                                <td>{{item.DueDate}}</td>
                                <td>
                                    <a href="#" ng-click="ApplicationView(item.encGccid)">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    @*@if (System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin] != null)
                                        {
                                            <a title="VIEW" ng-show="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId)==1" ng-click="ApplicationActionView(item.encGccid)"><i class="fa fa-info-circle infoicon-edit"></i></a>
                                        }*@
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate" style="display: flex; align-items: center; justify-content: space-between;">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important; margin:0">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',SearchData)" style="cursor: pointer;">
                                    <span>« First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,SearchData)" style="cursor:pointer;">
                                    <span>« Prev</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,SearchData)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,SearchData)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,SearchData)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>