                                        <td>{{item.DISTRICT_ENG}}</td>
                                        @*<td>{{item.TotalSociety}}</td>*@
                                        <td>
                                            <a href="" ng-if="item.TotalActiveSociety > 0" ng-click="GetDetails(item.DISTRICT_ID,5)"> {{item.TotalActiveSociety}}  </a>
                                            <span ng-if="item.TotalActiveSociety == 0">{{item.TotalActiveSociety}}</span>
