                                            <span ng-if="item.TotalCleansedCount == 0">{{item.TotalCleansedCount}}</span>
                                        </td>
                                        <td>
                                            <a href="" ng-if="item.TotalRemainingSociety > 0" ng-click="GetDetails(item.DISTRICT_ID,8)"> {{item.TotalRemainingSociety}}  </a>
                                            <span ng-if="item.TotalRemainingSociety == 0">{{item.TotalRemainingSociety}}</span>
                                        </td>
                                        <td>
                                            <a href="" ng-if="item.TotalMergeUpdate > 0" ng-click="GetDetails(item.DISTRICT_ID,4)"> {{item.TotalMergeUpdate}}  </a>
                                            <span ng-if="item.TotalMergeUpdate == 0">{{item.TotalMergeUpdate}}</span>
                                        </td>
                                        <td>
                                            <a href="" ng-if="item.TotalNoAction > 0" ng-click="GetDetails(item.DISTRICT_ID,6)"> {{item.TotalNoAction}}  </a>
                                            <span ng-if="item.TotalNoAction == 0">{{item.TotalNoAction}}</span>
                                        </td>
                                        @*<td>
                                            <a href="" ng-if="item.TotalActiveMerge > 0" ng-click="GetDetails(item.DISTRICT_ID,2)"> {{item.TotalActiveMerge}}  </a>
                                            <span ng-if="item.TotalActiveMerge == 0">{{item.TotalActiveMerge}}</span>
                                        </td>
                                        <td>
                                            <a href="" ng-if="item.TotalUpdate > 0" ng-click="GetDetails(item.DISTRICT_ID,3)"> {{item.TotalUpdate}}  </a>
                                            <span ng-if="item.TotalUpdate == 0">{{item.TotalUpdate}}</span>
                                        </td>*@
                                    </tr>
                                    @*
                                    <tr ng-if="SocietySummary.length > 0" style="font-weight:bold; background-color:#f5f5f5;">
                                        <td colspan="2" class="text-center">Total</td>
                                        <td>{{TotalCount}}</td>
                                    </tr>*@
