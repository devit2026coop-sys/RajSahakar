@{
    ViewBag.Title = "Gopal Credit Card Data Year Wise Information";
}
<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }


        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }
</style>
<script src="~/Scripts/AngularFramework/GCCDataYearWiseInformation.js?v=1.4"></script>
<div ng-app="GCCDataYearWiseMod" ng-controller="GCCDataYearWiseCnt" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; Gopal Credit Card Data Year Wise Information </b>
            </div>

            <div class="panel-body">
                <input type="hidden" id="hdnDistrictId" ng-model="search.LoanDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />               

                <div class="table-responsive devtable">
                    <table class="table table-hover table-striped table-bordered mb-0">
                        <thead>
                            <tr>
                                <th valign="middle" width="60">Sr.No.</th>
                                <th valign="middle" width="60">Year</th>
                                <th valign="middle" class="text-center">Total Loanee </th>
                                <th valign="middle" class="text-center"> Amount </th>
                                <th valign="middle" class="text-center">Renew Loan </th>
                                <th valign="middle" class="text-center">Renew Loan Amount</th>
                                <th valign="middle" class="text-center">A/C Closed Loanee (Not Renewed)</th>
                                <th valign="middle" class="text-center">A/C Closed Loanee Amount</th>
                                <th valign="middle" class="text-center">OD Loanee</th>
                                <th valign="middle" class="text-center">OD Loanee Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in GccSummary">
                                <td>{{$index+1}}</td>
                                <td class="text-center">{{item.Year}}</td>
                                <td class="text-center"><a href="" ng-click="GoToDetails(item , 'NEW')">{{item.Total_Loanee}} </a></td>
                                <td class="text-center">{{item.Total_Amount}}</td>
                                <td class="text-center"><a href="" ng-click="GoToDetails(item, 'RENEW')">{{item.Renew_Loan}} </a> </td>
                                <td class="text-center">{{item.Renew_Loan_Amount}}</td>
                                <td class="text-center"> <a href="" ng-click="GoToDetails(item, 'CLOSED')">{{item.Closed_Loanee}} </a></td>
                                <td class="text-center">{{item.Closed_Amount}}</td>
                                <td class="text-center"> <a href="" ng-click="GoToDetails(item, 'OD')">{{item.OD_Loanee}} </a></td>
                                <td class="text-center">{{item.OD_Amount}}</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr style="font-weight:bold; background:#f1f1f1;">
                                <td></td>
                                <td class="text-center">Total</td>

                                <td class="text-center">{{TotalRow.Total_Loanee | number:0 }}</td>
                                <td class="text-center">{{TotalRow.Total_Amount | number:0 }}</td>

                                <td class="text-center">{{TotalRow.Renew_Loan | number:0 }}</td>
                                <td class="text-center">{{TotalRow.Renew_Loan_Amount | number:0 }}</td>

                                <td class="text-center">{{TotalRow.Closed_Loanee | number:0 }}</td>
                                <td class="text-center">{{TotalRow.Closed_Amount | number:0 }}</td>

                                <td class="text-center">{{TotalRow.OD_Loanee | number:0 }}</td>
                                <td class="text-center">{{TotalRow.OD_Amount | number:0 }}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>                
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>
