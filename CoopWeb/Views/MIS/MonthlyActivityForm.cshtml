<script src="~/Scripts/AngularFramework/MonthlyActivityFrom.js?v=1.1"></script>
@{
    ViewBag.Title = "Monthly Activity From";
}
<div ng-app="MafMod" ng-controller="MafCnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.MonthlyActivityEntryFrom}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.MonthlyActivityEntryFrom}}   </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <form class="citizen-dash-head" ng-submit="SaveActivityReport()">
            <div class="row">
                <div class="col-md-2">
                    <label for="search">{{translation.Sector}}:</label>
                    <select ng-model="mafObj.Sector" class="form-control" required>
                        <option value="">{{translation.SelectOption}}</option>
                        <option value="PACS">PACS</option>
                        <option value="DCCB">DCCB</option>
                        <option value="StCB">StCB</option>
                        <option value="Dairy">Dairy</option>
                        <option value="Fisheries">Fisheries</option>
                        <option value="Others">Others</option>
                    </select>
                </div>
                <div class="form-group col-md-2">
                    <label>{{ translation.Level}}<span class="error">*</span></label>
                    <select ng-model="mafObj.LEVEL_ID" class="form-control" ng-change="ChangeLevel()" ng-init="mafObj.LEVEL_ID='0'">
                        <option value="0">{{translation.SelectOption}}</option>
                        <option ng-repeat="item in LevelList" value="{{item.LevelId}}">
                            {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                        </option>
                    </select>
                </div>
                <div class="form-group col-md-2" ng-show="mafObj.LEVEL_ID=='1'">
                    <label>{{ translation.State}}<span class="error">*</span></label>
                    <select ng-model="mafObj.STATE_ID" class="form-control" ng-init="mafObj.STATE_ID='6'">
                        <option ng-repeat="item in StateList" value="{{item.STATE_ID}}">
                            {{_language =='en-us' ?  item.STATE_ENG : item.STATE_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="form-group col-md-2" ng-show="mafObj.LEVEL_ID=='3' || mafObj.LEVEL_ID=='6'">
                    <label>{{ translation.UnitZone}}<span class="error">*</span></label>
                    <select ng-model="mafObj.DIVISION_ID" class="form-control" ng-change="GetDistrictList()" ng-init="mafObj.DIVISION_ID='0'">
                        <option value="0">{{translation.SelectOption}}</option>
                        <option ng-repeat="item in DivisionList" value="{{item.DIVISION_ID}}">
                            {{_language =='en-us' ?  item.DIVISION_ENG : item.DIVISION_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="form-group col-md-3" ng-show="mafObj.LEVEL_ID=='3' || mafObj.LEVEL_ID=='6'">
                    <label>{{ translation.District}}<span class="error">*</span></label>
                    <select ng-model="mafObj.DISTRICT_ID" class="form-control" ng-init="mafObj.DISTRICT_ID='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="form-group col-md-3"  ng-show="mafObj.LEVEL_ID=='6'">
                    <label>{{ translation.Village}}<span class="error">*</span></label>
                    <input type="text" class="form-control" ng-model="mafObj.Village" placeholder="{{translation.Village}}" />
                </div>
                <div class="form-group col-md-3">
                    <label>{{ translation.Location}}<span class="error">*</span></label>
                    <input type="text" class="form-control" ng-model="mafObj.Location" placeholder="{{translation.Location}}" required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 form-group">
                    <label>{{translation.EventHeldOn}}<span class="error">*</span>:</label>
                    <input type="date" class="form-control" ng-model="mafObj.EventHeldOn" placeholder="{{translation.EventHeldOn}}" required />
                </div>
                <div class="col-md-12 form-group">
                    <label>{{translation.EventActivityName}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="mafObj.EventActivityName" placeholder="{{translation.EventActivityName}}" required />
                </div>
                <div class="col-md-12 form-group">
                    <label>{{translation.BriefActivityInformation}}<span class="error">*</span>:</label>
                    <textarea rows="5" class="form-control" ng-model="mafObj.BriefActivityInformation" placeholder="{{translation.BriefActivityInformation}}" required></textarea>
                </div>
                <div class="col-md-8 form-group">
                    <label>{{translation.Objective}}<span class="error">*</span>:</label>
                    <input type="text" class="form-control" ng-model="mafObj.Objective" placeholder="{{translation.Objective}}" required />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.NoOfParticipants}}<span class="error">*</span>:</label>
                    <input type="number" class="form-control" ng-model="mafObj.NoOfParticipants" placeholder="{{translation.NoOfParticipants}}" required />
                </div>
                <div class="col-md-12 form-group">
                    <label>{{translation.AchievementsOutcomes}}<span class="error">*</span>:</label>
                    <textarea class="form-control" ng-model="mafObj.AchievementsOutcomes" placeholder="{{translation.AchievementsOutcomes}}" required></textarea>
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.Photo}}<span class="error">(max 5MB)</span>:</label>
                    <input type="file" accept="image/*" class="form-control" checkmaxsize="5120" multiple onchange="angular.element(this).scope().FileUploader(this.files,'Photographs')" />
                    <input type="hidden" ng-model="mafObj.Photographs" id="Photographs" />
                </div>
                <div class="col-md-4 form-group">
                    <label>{{translation.AudioVideoContent}}<span class="error">(max 100MB)</span>:</label>
                    <input type="file" accept="audio/*,video/*" class="form-control" checkmaxsize="100000" filetype="video" onchange="angular.element(this).scope().FileUploader(this.files,'AVContent')" />
                    <input type="hidden" ng-model="mafObj.AVContent" id="AVContent" />
                </div>
            </div>
            <div class="col-md-12 text-center">
                <label>&nbsp;</label><br>
                <button type="submit" class="btn btn-primary dev-btn">{{translation.Submit}}</button>
                <button type="button" ng-click="ResetControls()" class="btn btn-warning dev-btn">{{translation.Clear}}</button>
            </div>
        </form>
    </div>
</div>



