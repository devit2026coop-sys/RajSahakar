@{
    ViewBag.Title = "Gopal Credit Card District Wise Summary";
}
<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }


        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }
</style>
<script src="~/Scripts/AngularFramework/GccDistrictWiseSummary.js?v=1.5"></script>
<div ng-app="BeneficiaryListMod" ng-controller="BeneficiaryListCnt" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; Gopal Credit Card District Wise Summary</b>
            </div>

            <div class="panel-body">
                <input type="hidden" id="hdnDistrictId" ng-model="search.LoanDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="help-block-gender">
                            <input type="radio" id="sdfs" name="IsOverall" ng-value="0" ng-model="GopalCreditCardModel.IsPendancy" ng-change="GridShow(0)"> Pendancy
                        </label>
                        <label class="help-block-gender">
                            <input type="radio" id="sdf" ng-value="1" name="IsOverall" ng-model="GopalCreditCardModel.IsPendancy" ng-change="GridShow(1)"> Overall
                        </label>
                    </div>
                    <div class="col-md-6 form-group">
                    </div>
                </div>


                <div class="row">                   
                    <div class="col-md-3">
                        <label>{{ translation.FincialYearHeading}}<span class="error">*</span></label>
                        <select class="form-control" ng-model="search.FinancialYearId" ng-init="search.FinancialYearId='0'" ng-change="GetGccSummary()">
                            <option value="0" >{{translation.All}}</option>
                            <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_MASTR_ID}}">
                                {{item.FIN_YEAR_NAME}}
                            </option>
                        </select>                   
                    </div>



                    <div class="col-md-3 form-group">
                        <label>{{ translation.District}}<span class="error">*</span></label>
                        <select ng-model="search.DISTRICT_ID" class="form-control" ng-init="search.DISTRICT_ID='0'" ng-change="BlockListByOffAdd(0)">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3 form-group">
                        <label>{{ translation.BlockHeading}}<span class="error">*</span> </label>
                        <select ng-model="search.BLOCK_ID" id="ddlblock" class="form-control" ng-change="GetGccSummary()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Blocksdata | orderBy:'BLOCK_ENG'" value="{{item.BLOCK_ID}}">
                                {{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}
                            </option>
                        </select>
                    </div>


                    <div class="col-md-3 form-group" ng-show="false">
                        <label>
                            {{translation.BankName}}
                        </label>
                        <select ng-model="search.LoanBankID" ng-disabled="IsSubmiApplication || isLBDisabled" id="BankID" class="form-control" ng-change="Get_LoanBankBranch('0')">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemBlock in BankMasterList | orderBy:'CCBNameEn'" value="{{itemBlock.CCBId}}" ng-selected="itemBlock.CCBId == selectedCCBId">
                                {{_language =='en-us' ?  itemBlock.CCBNameEn : itemBlock.CCBNameHi}}
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3 form-group" ng-show="false">
                        <label>
                            {{translation.BankBranch}}
                        </label>
                        <select ng-model="search.LoanBranchId" id="BranchId" class="form-control" ng-init="search.LoanBranchId='0'" ng-change="Get_LoanBranch_PACS('0')">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemBlock in BankBranches | orderBy:'BranchNameEn'" value="{{itemBlock.Branch_ID}}">
                                {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameHi}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="table-responsive devtable" ng-hide="IsOverall">
                    <table class="table table-hover table-striped table-bordered mb-0">
                        <thead>
                            <tr>
                                <th valign="middle" width="60">Sr. No.</th>
                                <th valign="middle">{{(search.DISTRICT_ID!='0' && search.BLOCK_ID!='0' ?'Gram Panchayat':search.DISTRICT_ID!='0'?'Block':'Distict')}}</th>
                                <th valign="middle" class="text-center">Total Application</th>
                                @*<th valign="middle" class="text-center">Approve</th>
                                    <th valign="middle" class="text-center">Sanctioned</th>
                                    <th valign="middle" class="text-center">Objection</th>
                                    <th valign="middle" class="text-center">Reject</th>*@
                                <th valign="middle" class="text-center">Assign To PACS</th>
                                <th valign="middle" class="text-center">Assign To BM</th>
                                <th valign="middle" class="text-center">Assign To MD</th>
                                <th valign="middle" class="text-center">Objection</th>
                                <th valign="middle" class="text-center">Reject</th>
                                <th valign="middle" class="text-center">Sanctioned</th>
                                <th valign="middle" class="text-center">Disbursed</th>
                                <th valign="middle" class="text-center">Sanction Amt.</th>
                                <th valign="middle" class="text-center">Disbursed Amt.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in GccSummary">
                                <td>{{$index+1}}.</td>
                                <td>
                                    {{( search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ENG: search.DISTRICT_ID!='0'?item.BLOCK_ENG:item.DISTRICT_ENG)}}
                                </td>
                                <td align="center">{{item.TotalGcc}}</td>

                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=4&DistrictWise=1">{{item.AssignToPacs}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=5&DistrictWise=1">{{item.AssignToBM}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=6&DistrictWise=1">{{item.AssignToCCB}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=7&DistrictWise=1">{{item.ObjectionGcc}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=3&DistrictWise=1">{{item.RejectGcc}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=1&DistrictWise=1">{{item.ApproveGcc}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=8&DistrictWise=1">{{item.Disbursed}}</a></td>
                                <td align="center">{{item.SanctionAmt}}</td>                                                                                                                                                            
                                <td align="center">{{item.DisbursedAmt}}</td>

                            </tr>
                        </tbody>
                        <tfoot>
                            <tr ng-repeat="item in TotalGccSummary">
                                <td colspan="2" align="right"><b>Total</b></td>
                                <td align="center"><b>{{item.TotalGcc}}</b></td>
                                <td align="center"><b>{{item.AssignToPacs}}</b></td>
                                <td align="center"><b>{{item.AssignToBM}}</b></td>
                                <td align="center"><b>{{item.AssignToCCB}}</b></td>
                                <td align="center"><b>{{item.ObjectionGcc}}</b></td>
                                <td align="center"><b>{{item.RejectGcc}}</b></td>
                                <td align="center"><b>{{item.ApproveGcc}}</b></td>
                                <td align="center"><b>{{item.Disbursed}}</b></td>
                                <td align="center"><b>{{item.SanctionAmt}}</b></td>
                                <td align="center"><b>{{item.DisbursedAmt}}</b></td>

                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="table-responsive devtable" ng-hide="!IsOverall">
                    <table class="table table-hover table-striped table-bordered mb-0">
                        <thead>
                            <tr>
                                <th valign="middle" width="60">Sr. No.</th>
                                <th valign="middle">{{(search.DISTRICT_ID!='0' && search.BLOCK_ID!='0' ?'Gram Panchayat':search.DISTRICT_ID!='0'?'Block':'Distict')}}</th>
                                <th valign="middle" class="text-center">Total Application</th>
                                <th valign="middle" class="text-center">Overall Applications To PACS</th>
                                <th valign="middle" class="text-center">Overall Applications To BM</th>
                                <th valign="middle" class="text-center">Overall Applications To MD</th>
                                <th valign="middle" class="text-center">Objection</th>
                                <th valign="middle" class="text-center">Sanctioned</th>
                                <th valign="middle" class="text-center">Disbursed</th>
                                <th valign="middle" class="text-center">Reject</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in GccSummary">
                                <td>{{$index+1}}.</td>
                                <td>
                                    {{( search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ENG: search.DISTRICT_ID!='0'?item.BLOCK_ENG:item.DISTRICT_ENG)}}
                                </td>
                                <td align="center">{{item.TotalGcc}}</td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=4&Overall=1&DistrictWise=1">{{item.AssignToPacs}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=5&Overall=1&DistrictWise=1">{{item.AssignToBM}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=6&Overall=1&DistrictWise=1">{{item.AssignToCCB}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=7&Overall=1&DistrictWise=1">{{item.ObjectionGcc}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=1&Overall=1&DistrictWise=1">{{item.ApproveGcc}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=8&Overall=1&DistrictWise=1">{{item.Disbursed}}</a></td>
                                <td align="center"><a target="_blank" href="~/mis/GccApplicationList?districtId={{search.DISTRICT_ID=='0'?item.DISTRICT_ID:search.DISTRICT_ID}}&FyId={{search.FinancialYearId}}&blockId={{search.DISTRICT_ID!='0' && search.BLOCK_ID=='0'?item.BLOCK_ID : '0'}}&gpId={{search.DISTRICT_ID!='0' && search.BLOCK_ID!='0'?item.GP_ID:'0'}}&statusType=3&Overall=1&DistrictWise=1">{{item.RejectGcc}}</a></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr ng-repeat="item in TotalGccSummary">
                                <td colspan="2" align="right"><b>Total</b></td>
                                <td align="center"><b>{{item.TotalGcc}}</b></td>
                                <td align="center"><b>{{item.AssignToPacs}}</b></td>
                                <td align="center"><b>{{item.AssignToBM}}</b></td>
                                <td align="center"><b>{{item.AssignToCCB}}</b></td>
                                <td align="center"><b>{{item.ObjectionGcc}}</b></td>
                                <td align="center"><b>{{item.ApproveGcc}}</b></td>
                                <td align="center"><b>{{item.Disbursed}}</b></td>
                                <td align="center"><b>{{item.RejectGcc}}</b></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>
