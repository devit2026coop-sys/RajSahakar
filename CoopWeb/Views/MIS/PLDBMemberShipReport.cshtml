                                <label>   {{translation.Photo}} </label>
                            </div>
                            <div class="col-md-7">
                                <img src="{{ViewApplication.PhotoPath}}" alt="Photo" width="100" height="100" />
                            </div>
                            <div class="clearfix"></div>
                        </div>
                        <div class="col-md-12 margin-Top20" ng-if="TackActionShow">
                            <div class="col-md-5">
                                <label> {{translation.TakeAction}} </label>
                            </div>
                            <div class="col-md-7">

                            </div>
                            <div class="clearfix"></div>
                        </div>

                        <div class="col-md-4 margin-Top20" ng-if="TackActionShow">
                            <div class="col-md-5">
                                <label>   {{translation.Status}} </label>
                            </div>
                            <div class="col-md-7">
                                <select id="ddlStatus" ng-model="MemberApproval.StatusId" class="form-control" ng-init="MemberApproval.StatusId='0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in NextActionList | orderBy:'ProceesStatusTextHi'" value="{{item.SocietyProceesStatusId}}">
                                        {{_language =='en-us' ?  item.ProceesStatusTextEn : item.ProceesStatusTextHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="clearfix"></div>
                        </div>

                        <div class="col-md-4 margin-Top20" ng-if="TackActionShow">
                            <div class="col-md-5">
                                <label>   {{translation.Remarks}} </label>
                            </div>
                            <div class="col-md-7">
                                <textarea rows="2" class="form-control" cols="125" style="margin: 0px; width: 341px;resize:none;" placeholder="{{translation.Remarks}}" ng-model="MemberApproval.Remark" ng-maxlength="50" autocomplete="off" onKeyPress="return ValidateAlpha(event);"> </textarea>
                            </div>
                            <div class="clearfix"></div>
                        </div>

                        <div class="col-md-12 margin-Top20" ng-if="TackActionShow">
                            <center>
                                <br />            <div>
                                    <button ng-if="ViewApplication.ActionStatus==1060" class="btn btn-primary dev-btn" ng-click="ApplicationEdit();EditMember(ViewApplication);ShowForm();"><i class="fa fa-edit"></i> {{translation.Edit}}</button>

                                    <button class="btn btn-primary dev-btn ng-binding" ng-click="SavePLDBMemberStatus()">{{translation.Submit}}</button>
                                </div>
                            </center>
                            <div class="clearfix"></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="dev-popup-body modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content" style="width:800px">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"> {{translation.TransactionLog}} </h4>
                </div>
                <div class="modal-header" style="color:#000;font-weight:800;">
                    {{translation.ApplicationNo}} : {{ApplicationNo}} <br />
                    {{translation.MembershipNo}} : {{MemberShipNo}} <br />
                    {{translation.MemberName}} : {{TransactionMemberName}} <br />
                    {{translation.PLDB}} : {{TransactionPLDB}} <br />
                    {{translation.Branch}} : {{TransactionBranch}}
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-responsive devtable" style="margin-top: 30px;color:black" id="a">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th>
                                        {{translation.Status}}
                                    </th>
                                    <th>
                                        {{translation.ActionBy}}
                                    </th>
                                    <th>
                                        {{translation.Remarks}}
                                    </th>
                                    <th>
                                        {{translation.CreationDate}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in MemberApprvalTransactionLog">
                                    <td>{{$index+1}}</td>
                                    <td>{{_language=='en-us' ? item.ProceesStatusTextEn : item.ProceesStatusTextHi}}</td>
                                    <td>{{item.ActionTakenBy}}</td>
                                    <td>{{item.ActionRemark}}</td>
                                    <td>{{item.ActionTakenDateTime}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>


