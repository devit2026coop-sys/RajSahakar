                    <label for="search">{{translation.PLDB}}:</label>
                    <select ng-model="MembershipReport.PLDB_ID" name="ddlPldbId" class="form-control" ng-init="MembershipReport.PLDB_ID=''" ng-change="PLDBBranchList()">
