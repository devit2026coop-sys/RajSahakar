
<script src="~/Scripts/AngularFramework/DistrictwiseAdvancementLoanRpt.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />



@Html.Hidden("TemplateId")
<div ng-app="AppEntryFormLoanAdvancement">
    <div ng-controller="LoanAdvancementcnt">
        <style>
            .formFlex {
                display:flex;
                align-items:center;
                justify-content:space-between;
            }

            .formHeading {
                border-bottom: solid 1px #f1f1f1;
                margin-bottom:15px;
            }
                
            .mt-20 {
                margin-top:20px;
            }
        </style>
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.DistrictwiseAdvancementLoanRpt}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.EntryForm}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.DistrictwiseAdvancementLoanRpt}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowLoanAdvancementContent()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" data-target="#myModal">
                            <h5>&#187; {{translation.NewEntry}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div  class="citizen-dash-head" ng-show="showtringdiv">
            <form>
                <div class="col-md-12 citizen-dash-head" >

                    <div class="col-lg-12">
                        <div class="row">
                            @*<div class="col-sm-4 form-group">
                                <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                                <label class="col-lg-2">{{translation.DistrictHeading}}</label>
                               
                                <select name="DISTRICT_ID" ng-model="Loan.DistrictId" class="form-control" ng-init="DistrictId=''" id="ddrDistrictId" ng-click="GetDataByFinancialYear()">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}" ng-model="Loan.DistrictId" ng-click="GetDataByFinancialYear()">
                                        {{_language =='en-us' ?  district.DISTRICT_MANGAL : district.DISTRICT_MANGAL}}
                                    </option>
                                </select>
                            </div>*@

                            <div class="col-sm-6 form-group">
                                <label>Financial Year</label>
                                <select class="form-control" ng-model="Loan.YearName" ng-click="GetDataByFinancialYear()" id="ddlstate1">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="district in FinancialYearList" value="{{district.FIN_YEAR_MASTR_ID}}">
                                        {{_language =='en-us' ?  district.FIN_YEAR_NAME : district.FIN_YEAR_NAME}}
                                    </option>
                                </select>


                            </div>

                        </div>
                        <div>
                            

                            <table class="table table-bordered devtable form-group">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>
                                            <input type="hidden" ng-model="Loan.LoanDataId" />
                                            <label>{{ translation.LoanAdvancement}} (In Thousand)</label>
                                        </th>
                                        <th><label>{{ translation.LoanRecovered}} (In Thousand)</label></th>
                                        <th>Outstanding (In Thousand)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><label>{{translation.Stamt}}</label></td>
                                        <td><input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.AprStamt" placeholder={{translation.BlanckAmount}} value="0" autocomplete="off"/></td>
                                        <td><input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.RecStamt" placeholder={{translation.BlanckAmount}} value="0" autocomplete="off"/></td>
                                        <td>{{Loan.AprStamt-Loan.RecStamt}}</td>

                                    </tr>
                                    <tr>
                                        <td><label>{{translation.Mtamt}}</label></td>
                                        <td><input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.AprMtamt" placeholder={{translation.BlanckAmount}} autocomplete="off" /></td>
                                        <td><input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.RecMtamt" placeholder={{translation.BlanckAmount}} autocomplete="off"/></td>
                                        <td>{{Loan.AprMtamt-Loan.RecMtamt}}</td>
                                    </tr>
                                    <tr>
                                        <td><label>{{translation.ltamt}}</label></td>
                                        <td><input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.Aprltamt" placeholder={{translation.BlanckAmount}} autocomplete="off"/></td>
                                        <td><input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.Recltamt" placeholder={{translation.BlanckAmount}} autocomplete="off"/></td>
                                        <td>{{Loan.Aprltamt-Loan.Recltamt}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>


                    <div class="form-group col-md-12">
                        <br />
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveLoan(true)">{{translation.Submit}}</button>
                            <button type="submit" class="btn btn-primary" ng-click="ClearLoanForm()">{{translation.Clear}}</button>
                            <button type="submit" class="btn btn-primary" ng-click="HideLoanContent()">{{translation.Back}}</button>


                        </div>
                    </div>
                </div>
              </form>
                
        </div>
        <div ng-show="DivtringGrid">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label>
                                {{translation.FincialYearHeading}} :
                            </label>


                            <select class="form-control" ng-model="Loan.FYear" ng-click="GetDataByFinancialYear()" id="ddlstate" >
                                <option value="">{{translation.SelectOption}}</option>
                                <option ng-repeat="district in FinancialYearList" value="{{district.FIN_YEAR_MASTR_ID}}">
                                    {{_language =='en-us' ?  district.FIN_YEAR_NAME : district.FIN_YEAR_NAME}}

                                </option>
                            </select>
                        </div>
                        
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-disabled="Liqudation.MonthId.$invalid" ng-click="GridData2()">{{translation.Show}} </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12"  >
                <div class="citizen-dash-head">
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th rowspan="2">
                                    {{translation.SRNO}}
                                </th>

                                <th rowspan="2" style="text-align: center !important">
                                    {{translation.District}}

                                </th>
                                <th rowspan="2" style="text-align: center !important">
                                    {{translation.FincialYearHeading}}

                                </th>

                                <th colspan="3" style="text-align:center !important">
                                    {{translation.LoanAdvancement}} (In Thousand)

                                </th>

                                <th colspan="3" style="text-align:center !important">
                                    {{translation.LoanRecovered}} (In Thousand)

                                </th>

                                <th colspan="3" style="text-align:center !important">
                                    {{translation.LoanOutstanding}} (In Thousand)

                                </th>
                                <th rowspan="3" style="text-align:center !important;vertical-align:middle">
                                    Action
                                </th>
                            </tr>


                            <tr>
                                <th style="text-align:center !important">{{translation.Stamt}}</th>
                                <th style="text-align:center !important">{{translation.Mtamt}}</th>
                                <th style="text-align:center !important">{{translation.ltamt}}</th>
                                <th style="text-align:center !important">{{translation.Stamt}}</th>
                                <th style="text-align:center !important">{{translation.Mtamt}}</th>
                                <th style="text-align:center !important">{{translation.ltamt}}</th>
                                <th style="text-align:center !important">{{translation.Stamt}}</th>
                                <th style="text-align:center !important">{{translation.Mtamt}}</th>
                                <th style="text-align:center !important">{{translation.ltamt}}</th>


                            </tr>


                        </thead>

                        <tbody>

                            <tr dir-paginate="BData in LoanData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>

                                <td style="text-align:center !important">
                                    {{ BData.DISTRICT_ENG}}
                                </td>
                                <td style="text-align:center !important">
                                    {{ BData.Year}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.AprStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.AprMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Aprltamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.RecStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.RecMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Recltamt}}
                                </td>

                                <td style="text-align:center !important">
                                    {{BData.OptStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.OptMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Optltamt}}
                                </td>
                                <td ng-show="true" style="text-align:center !important">
                                    <i class="fa fa-edit" data-target="#myModalFeedback" data-toggle="modal" ng-click="Update(BData)"></i>
                                </td>
                                <!--
                                            <td>
                                                <div class="dev-action">
                                                    <label class="switch">
                                                        <input type="checkbox" ng-checked="BData.IsActive == 1" ng-click="SetStatus(BData)">
                                                        <span class="slider round"></span>
                                                    </label>
                                                </div>
                                            </td>

                                            <td ng-show="true" style="text-align:center !important">
                                                <i class="fa fa-edit" data-target="#myModalFeedback" data-toggle="modal" ng-click="update(BData)"></i>
                                            </td>

                                            <td ng-show="true" style="text-align:center !important">
                                                <i class="fa fa-trash" data-target="#myModalFeedback" data-toggle="modal" ng-click="SetStatusTrash(BData)"></i>
                                            </td>

                                  -->
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="TrainningFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            
        </div>
    </div>

</div>