
<script src="~/Scripts/AngularFramework/CooperateMovementZoneWiseRpt1.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />



@Html.Hidden("TemplateId")
<div ng-app="AppEntryCooperateMovementZoneWiseRpt1">
    <div ng-controller="CooperateMovementZoneWiseRpt1cnt">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.CooperateMovementZoneWiseRpt}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.EntryForm}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.CooperateMovementZoneWiseRpt}} </span>
                    </li>
                    <!--<li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowLiqudationContent()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" data-target="#myModal">
                            <h5>&#187; {{translation.NewEntry}}</h5>
                        </button>
                    </li>
                    -->
                </ul>
            </div>
        </div>


            <div class="col-md-12">                
                <div class="citizen-dash-head">
                    <div class="table-dropdown" id="search-filter" style="overflow:inherit; float:left;width: 100%;margin-bottom: 10px;">
                        <div class="col-sm-4 form-group">
                            <label>Select Year</label>
                            <select class="form-control" ng-model="Loan.YearName" ng-click="GetDataByFinancialYear()" id="ddlstate1">
                                <option value="">{{translation.SelectOption}}</option>
                                <option ng-repeat="district in FinancialYearList" value="{{district.FIN_YEAR_NAME}}">
                                    {{_language =='en-us' ? district.FIN_YEAR_NAME : district.FIN_YEAR_NAME}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4 margin-Top20 y_dropdown" style="padding-left: 0;">
                            <br />
                            <button type="submit" class="btn btn-primary dev-btn" ng-click="GridData2()">{{translation.Search}}</button>
                            @*<input type="button" class="btn btn-primary dev-btn" ng-click="ExportData()" value="Export to Excel">*@
                        </div>
                    </div>
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>

                            @*
                            <tr>
                                <th colspan="7" style="text-align: center !important">
                                    {{translation.AllUnitsOfRajasthan}}
                                </th>
                            </tr>*@

                            <tr>
                                <th rowspan="2">
                                    {{translation.SRNO}}
                                </th>


                                <th rowspan="2" style="text-align:center !important;vertical-align:middle">
                                    {{translation.UnitZone}}

                                </th>
                                <th rowspan="2" style="text-align:center !important;vertical-align:middle">
                                    {{translation.NoOfSocieties}}

                                </th>

                                <th style="text-align:center !important;vertical-align:middle">
                                    {{translation.Membership}}

                                </th>

                                <th style="text-align:center !important;vertical-align:middle">
                                    {{translation.ShareCapital}}

                                </th>

                                <th style="text-align:center !important;vertical-align:middle">
                                    {{translation.WorkingCapital}}

                                </th>


                            </tr>
                            <tr>
                                <th style="text-align:center !important;vertical-align:middle">{{translation.Actual}}</th>
                                <th style="text-align:center !important;vertical-align:middle">{{translation.InLakh}}</th>
                                <th style="text-align:center !important;vertical-align:middle">{{translation.InLakh}}</th>
                            </tr>


                        </thead>
                        <tbody>


                            <tr ng-repeat="BData in GetMovementZoneWiseMPRRpt">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>

                                <td style="text-align:center !important;vertical-align:middle">
                                    {{ BData.DISTRICT_ENG}}
                                </td>
                                <td style="text-align:center !important;vertical-align:middle">
                                    {{BData.SocietyCnt}}
                                </td>
                                <td style="text-align:center !important;vertical-align:middle">
                                    {{BData.MembershipNo}}
                                </td>
                                <td style="text-align:center !important;vertical-align:middle">
                                    {{((BData.sharcap)/1).toFixed(2)}}
                                </td>

                                <td style="text-align:center !important;vertical-align:middle">
                                    {{BData.WorkingCapital}}
                                </td>



                                <!--
                        <td>
                            <div class="dev-action">
                                <label class="switch">
                                    <input type="checkbox" ng-checked="BData.IsActive == 1" ng-click="SetStatus(BData)">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                        </td>

                        <td ng-show="true" style="text-align:center !important">
                            <i class="fa fa-edit" data-target="#myModalFeedback" data-toggle="modal" ng-click="update(BData)"></i>
                        </td>

                        <td ng-show="true" style="text-align:center !important">
                            <i class="fa fa-trash" data-target="#myModalFeedback" data-toggle="modal" ng-click="SetStatusTrash(BData)"></i>
                        </td>
                        -->

                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>