    <div class="dev-popup-body modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">{{translation.UploadeddocumentList}}</h4>
                </div>
                <div class="modal-body">
                    <div class="table-responsive citizen-dash-head">
                        <table class="table devtable">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th>
                                        {{translation.Name}}
                                    </th>
                                    <th ng-repeat="item in DocumentList.DocumentTypes">
                                        {{(item === 'docx' || item === 'doc') ? translation.WORD : ( (item === 'xls' || item === 'xlsx') ? translation.EXCEL : (item === 'pdf' ? translation.PDF : ''))}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="items in DocumentList.DocumentList">
                                    <td>{{$index+1}}</td>
                                    <td>
                                        {{ _language =='en-us' ? items.DocumentNameEnglish  : items.DocumentNameHindi}}
                                    </td>
                                    <td ng-repeat="item2 in items.DocumenTypeDetails">
                                        <a ng-show="item2.URL !=''" href="{{item2.URL}}" target="_blank" style="color:#505050;" class="fa fa-download"></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">{{translation.Close}}</button>
                </div>





            </div>
        </div>
    </div>


