<script src="~/Scripts/AngularFramework/SocietyRegisterDistWise.js"></script>
<script src="~/Scripts/jquery-1.11.3.min.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />

<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()


    $(document).ready(function () {
        //alert($("#hdnActId").val());
    });

</script>
<div ng-app="SocietyRegisterDistWiseMod">
    <div ng-controller="SocietyRegisterDistWiseCnt">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.SocietyRegisterReport}}</h3>
            <hr style="margin: 0;">
        </div>
        <input type="hidden" id="hdnActId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).ActId)" />
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.MIS}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.SocietyRegisterReport}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        &nbsp;
                    </li>
                </ul>
            </div>
        </div>

        <div>
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="table-responsive citizen-dash-head">
                    <div class="col-lg-2">
                        <label for="search">{{translation.Act}}:</label>
                    </div>
                    <div class="col-lg-4" style="text-align:left">
                        <select ng-model="ActId" class="form-control" ng-init="ActId='0'" ng-change="GetSocietyTypeList()" id="ddrActId">
                            <option value="0">{{translation.All}}</option>
                            <option ng-repeat="item in Actlist" value="{{item.ActId}}">
                                {{_language =='en-us' ?  item.ActNameEn : item.ActNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2" style="text-align:left">
                        <label for="search">{{translation.SocietyType}}:</label>
                    </div>
                    <div class="col-lg-4">
                        <select ng-model="SocietyTypeId" class="form-control" ng-init="SocietyTypeId='0'">
                            <option value="0">{{translation.All}}</option>
                            <option ng-repeat="item in Typelist" value="{{item.SocietyTypeId}}">
                                {{_language =='en-us' ?  item.TypeameEng : item.TypeNameHin}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2" style="text-align:left">
                        <label  ng-show="IsState" >{{translation.DivisionHeading}}:</label>
                    </div>
                    <div class="col-lg-4">
                        <select ng-show="IsState" ng-model="DIVISION_ID" class="form-control" id="ddlDivision" ng-init="DIVISION_ID='0'" style="padding-top:5px;margin-top:5px">
                            <option value="0">{{translation.All}}</option>
                            <option ng-repeat="item in Divisions" value="{{item.DIVISION_ID}}">
                                {{_language =='en-us' ?  item.DIVISION_ENG : item.DIVISION_MANGAL}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2" style="text-align:left;margin-top:5px;padding-top:5px">
                        <label for="search">{{translation.Date}}:</label>
                    </div>
                    <div class="col-lg-4" style="text-align:center;margin-top:5px;padding-top:5px">
                        <input name="CreatetionDate" id="txtCreatetionDate" class="form-control devcalender SetCalender" disabled="disabled" placeholder="{{translation.Date}}" ng-model="CreatetionDate" />
                    </div>
                    <div class="col-lg-6"></div>
                    <div class="col-lg-6" style="text-align:left;margin-top:5px;padding-top:5px">
                        <button type="button" class="btn btn-primary dev-btn" ng-click="GetSocietyData()">{{translation.Submit}}</button>
                        <button type="button" class="btn btn-primary dev-btn" ng-click="Reset()">{{translation.Clear}}</button>
                        <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tbl6', 'Get Society District Wise Data')" value="Export to Excel">
                    </div>
                </div>
            </div>
        </div>

        <div ng-show="DivShowCount">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="table-responsive citizen-dash-head">
                    <table id="tbl6" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    {{ translation.District}}
                                </th>
                                <th>   {{ translation.PartialSave}} </th>
                                <th>   {{ translation.PermanentSave}} </th>
                                <th>   {{ translation.Approvable}} </th>
                                <th>   {{ translation.Rejection}}/{{translation.AutoClose}} </th>
                                <th>   {{ translation.UnderProcess}} </th>
                                <th>   {{ translation.TOTAL}} </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in SocietyCombine">
                                <td>{{_language =='en-us' ?  item.DistrictNameEn : item.DistrictNameHi}}</td>
                                <td><a ng-click="ShowDetail(item.DISTRICT_ID,1)">{{item.TotPartialSave}}</a></td>
                                <td><a ng-click="ShowDetail(item.DISTRICT_ID,2)">{{item.TotPermanetSave}}</a></td>
                                <td><a ng-click="ShowDetail(item.DISTRICT_ID,3)">{{item.TotApprove}}</a></td>
                                <td><a ng-click="ShowDetail(item.DISTRICT_ID,4)">{{item.TotReject}}</a></td>
                                <td><a ng-click="ShowDetail(item.DISTRICT_ID,5)">{{item.TotUnderProcess}}</a></td>
                                <td><a ng-click="ShowDetail(item.DISTRICT_ID,0)">{{item.TotRegi}}</a> </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div ng-show="DivShowDetail">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="table-responsive citizen-dash-head">
                    <div class="col-md-12 dev-search-form">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="9999" class="form-control" ng-model="pageSize">
                        </div>
                        <div class="col-xs-4" style="padding-top: 25px; ">
                            <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblData', 'Get Society Detail Data')" value="Export to Excel">
                        </div>
                    </div>
                    <br>
                    <table id="tblData" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.SocietyName}}
                                </th>
                                <th>
                                    {{translation.RegistrationNo}}
                                </th>

                                <th>
                                    {{translation.District}}
                                </th>
                                <th>
                                    {{translation.Act}}
                                </th>
                                <th>
                                    {{translation.SocietyType}}
                                </th>
                                <th>
                                    {{translation.Status}}
                                </th>
                                <th>
                                    {{translation.View}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in SocietyList | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{item.SocietyName}}</td>
                                <td>{{item.RegistrationNo}}</td>
                                <td>{{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}</td>
                                <td>{{_language =='en-us' ?  item.ActNameEn_Short : item.ActNameHi_Short}}</td>
                                <td>{{_language =='en-us' ?  item.TypeameEng : item.TypeNameHin}}</td>
                                <td>{{item.ProceesStatusTextEn}}</td>
                                <td><a ng-click="SocietyView(item.SocietyIdEnc)"><i class="fa fa-eye"></i></a> </td>
                            </tr>
                            <tr>
                                <td colspan="8"><button type="button" class="btn btn-primary dev-btn" ng-click="BackDetails()">{{translation.Back}}</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <br />
                    <div class="col-md-12">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

