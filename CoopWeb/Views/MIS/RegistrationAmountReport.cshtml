                <div ng-show="DivShowCount">


                    <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    #
                                </th>
                                <th> {{translation.District}}</th>
                                <th style="text-align:right">
                                    {{translation.Total}} {{translation.Society}}
                                </th>
                                <th style="text-align:right">
                                    {{translation.Total}} {{translation.Amount}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in ReportData" ng-click="ShowSocietyDetails(item.DISTRICT_ID)" style="cursor: pointer;">
                                <td>{{$index+1}}</td>
                                <td>
                                    {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                </td>
                                <td style="text-align:right">
                                    {{item.TotalSocieties}}
                                </td>
                                <td style="text-align:right">
                                    {{item.TotalAmount}}
                                </td>
                            </tr>
                        </tbody>
                        <tfoot ng-if="ReportData.length>0">
                            <tr>
                                <th colspan="2" style="text-align:right">Total</th>
                                <th style="text-align:right">{{TotalSocietie}}</th>
                                <th style="text-align:right">{{TotalAmount}}</th>
                            </tr>
                        </tfoot>
                    </table>

               

                    <input ng-if="WRDetails.length>0" type="button" id="btnExport" class="btn btn-primary dev-btn" style="" ng-click="ExportData()" value="Export" />
                </div>

                <div ng-show="DivShowDetail">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="table-responsive citizen-dash-head">
                            <div class="col-md-12 dev-search-form">
                                <div class="col-xs-4">
                                    <label for="search">{{translation.Search}}:</label>
                                    <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                                </div>
                                <div class="col-xs-4">
                                    <label for="search">{{translation.ItemPerPage}}:</label>
                                    <input type="number" min="1" max="9999" class="form-control" ng-model="pageSize">
                                </div>
                                <div class="col-xs-4" style="padding-top: 25px; ">
                                    <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblData', 'Get Society Detail Data')" value="Export to Excel">
                                </div>
                            </div>
                            <br>
                            <table id="tblData" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.SocietyName}}
                                        </th>
                                        <th>
                                            {{translation.RegistrationNo}}
                                        </th>

                                        <th>
                                            {{translation.District}}
                                        </th>                                    
                                        <th style="text-align:right">
                                            {{translation.Amount}}
                                        </th>
                                      
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="item in SocietyList | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{item.SocietyName}}</td>
                                        <td>{{item.RegistrationNo}}</td>
                                        <td>{{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}</td>                                                                      
                                        <td style="text-align:right">{{item.Amount}}</td>                                       
                                    </tr>
                                    <tr>
                                        <td colspan="4"  style="text-align:right">Total</td>
                                        <td style="text-align:right">{{TotalDistrictTotalAmount}}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="5"><button type="button" class="btn btn-primary dev-btn" ng-click="BackDetails()">{{translation.Back}}</button></td>
                                    </tr>
                                </tbody>
                            </table>
                            <br />
                            <div class="col-md-12">
                                <div class="text-center">
                                    <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <input type="hidden" value="@ViewBag.FromDate" id="fromdateserver" />
        <input type="hidden" value="@ViewBag.TodateDate" id="todateserver" />
        <input type="hidden" value="@ViewBag.MinDate" id="mindateserver" />
