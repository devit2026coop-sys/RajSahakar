@{
    ViewBag.Title = "PACS Report (State-District-Block Wise)";
    Layout = "~/Views/Shared/LayoutForPS.cshtml";
}

<script src="~/Scripts/AngularFramework/PACSReport.js"></script>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>


<div ng-app="PACSReportMod" ng-controller="PACSReportCnt">

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head">{{translation.PACSReport}} </h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.MIS}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.PACSReport}} </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

        <div class="table-responsive citizen-dash-head">
            <table id="example" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                        <th>
                            {{translation.State}}
                        </th>
                        <th>
                            {{translation.SocietyCount}}
                        </th>
                        <th>
                            {{translation.MemberCount}}
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <tr dir-paginate="item in StateData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: 1000">
                        <td>{{$index+1}}</td>
                        <td><a ng-click="ShowDistrictData()">{{item.LevelHi}}</a></td>
                        <td>{{item.PACSSocietyCount}}</td>
                        <td>{{item.PACSMemberCount}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divDistrictWisePACS">
        <h3 class="citizen-dash-head">{{translation.PACSForDistrict}} </h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divDistrictWisePACS">

        <div class="table-responsive citizen-dash-head">
            <table id="example" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                        <th>
                            {{translation.District}}
                        </th>
                        <th>
                            {{translation.SocietyCount}}
                        </th>
                        <th>
                            {{translation.MemberCount}}
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <tr dir-paginate="item in DistrictData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: 1000">
                        <td>{{$index+1}}</td>
                        <td><a ng-click="GetBlockData(item)">{{ _languahe=='en-us'? item.LevelEng : item.LevelHi}}</a></td>
                        <td>{{item.PACSSocietyCount}}</td>
                        <td>{{item.PACSMemberCount}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divBlockWisePACS">
        <h3 class="citizen-dash-head">{{translation.PACSForBlock}} ({{DistrictName}}) <a ng-click="BackTODCCB()" style="float:right; font-size:12px" class="btn btn-primary dev-btn">{{translation.Back}}</a></h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divBlockWisePACS">

        <div class="table-responsive citizen-dash-head">
            <table id="example" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                        <th>
                            {{translation.District}}
                        </th>
                        <th>
                            {{translation.SocietyCount}}
                        </th>
                        <th>
                            {{translation.MemberCount}}
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <tr dir-paginate="item in BlockData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: 1000">
                        <td>{{$index+1}}</td>
                        <td>{{item.LevelHi}}</td>
                        <td>{{item.PACSSocietyCount}}</td>
                        <td>{{item.PACSMemberCount}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>



