                <div class="col-md-2 margin-Top20" style="">
                    <label>{{ translation.Month}}</label>
                    <select name="MY" ng-model="AppLoanReport.Month" class="form-control" ng-init="AppLoanReport.Month=''">
                        <option value="">{{translation.SelectOption}}</option>
                        <option ng-repeat="item in MonthList" value="{{item.Month_Id}}">
                            {{_language =='en-us' ?  item.Month_En : item.Month_Hi}}
                        </option>
                    </select>
                </div>
