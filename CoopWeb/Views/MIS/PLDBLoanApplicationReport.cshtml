                <div class="col-md-2 margin-Top20" style="">
                    <label>{{ translation.DistrictHeading}}:</label>
                    <select name="Districtdll" ng-model="MembershipReport.DistrictId" class="form-control" ng-init="MembershipReport.DistrictId=''" ng-change="BlockList()">
                        <option value="">{{translation.SelectOption}}</option>
