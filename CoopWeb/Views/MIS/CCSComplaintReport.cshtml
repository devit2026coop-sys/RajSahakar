@*CCSComplaintReport*@
@{
    ViewBag.Title = "Complaint Report";
}


<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>

<script src="~/Scripts/AngularFramework/CCSComplaintReport.js?id=2"></script>

<div ng-app="CCSComplaintReportMod" ng-controller="CCSComplaintReportCnt">

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head"> {{ translation.CCSComplaintReport}}   </h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">  {{ translation.CCSComplaintReport}}  </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div class="col-lg-5" style="margin-top:30px;">
                <div class="col-lg-2">{{ translation.FilterType}}:</div>
                <div class="col-lg-8">
                    <input type="radio" name="rdoSelect" value="1" checked="checked" ng-click="ChangeSelction()" /> &nbsp; {{translation.AllSocieties}} &nbsp;&nbsp;
                    <input type="radio" name="rdoSelect" value="2" ng-click="ChangeSelction()" /> &nbsp; {{translation.SingleState}} &nbsp;&nbsp;
                    <input type="radio" name="rdoSelect" value="3" ng-click="ChangeSelction()" /> &nbsp; {{translation.MultiState}} &nbsp;&nbsp;
                </div>
                @*<div class="col-lg-2">{{ translation.District}}:</div>
               <div class="col-lg-4">
                    <select ng-model="DISTRICT_ID" id="ddlDistrict" class="form-control" ng-init="DISTRICT_ID='0'" ng-change="SetCCSociety()">
                        <option value="0">{{translation.SelectOption}}</option>
                        <option ng-repeat="itemDist in DistrictList | orderBy:'DISTRICT_ENG'" value="{{itemDist.DISTRICT_ID}}">
                            {{_language =='en-us' ?  itemDist.DISTRICT_ENG : itemDist.DISTRICT_MANGAL}}
                        </option>
                    </select>
                </div>*@
            </div>
            <div class="col-lg-7" style="margin-top:30px;">
                <div class="col-lg-2" >{{ translation.Society}}:</div>
                <div class="col-lg-4" >
                    <select ng-model="SocietyId" id="ddlDistrict" class="form-control" ng-init="SocietyId='0'">
                        <option value="0">{{translation.SelectOption}}</option>
                        <option ng-repeat="itemDist in SocietyBasicDetailList | orderBy:'SocietyName'" value="{{itemDist.SocietyIdEnc}}">
                            {{_language =='en-us' ?  itemDist.SocietyName : itemDist.SocietyName}}
                        </option>
                    </select>
                </div>
                <div class="col-lg-2"></div>
                <div class="col-lg-4">
                    <button type="button" class="btn btn-primary dev-btn" ng-click="GetComplaintData()">{{translation.Submit}}</button>
                    <button type="button" class="btn btn-primary dev-btn" ng-click="Reset()">{{translation.Clear}}</button>
                </div>
            </div>
        </div>
    </div>
    <div ng-show="DivShowCount">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="table-responsive citizen-dash-head">
                <table id="tbl6" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                    <thead>
                        <tr>
                            <th style="width:5%">
                                {{ translation.SRNO}}
                            </th>
                            <th  style="width:35%">
                                {{ translation.District}}
                            </th>
                            <th  style="text-align:right;width:30%">
                                {{ translation.TotalComplainer}}
                            </th>
                            <th  style="text-align:right;width:30%">
                                {{ translation.TotalAmountDeposited}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in CCSComplaintCombine"  ng-click="ShowDetail(item)" style="cursor:pointer;" ng-if="item.DistrictNameEn!='Total'">
                            <td><a href="#">{{$index+1}}</a></td>
                            <td><a href="#" >{{item.DistrictNameEn}}</a></td>
                            <td style="text-align:right"><a href="#">{{item.TotComplainer}}</a></td>
                            <td style="text-align:right"><a href="#" >{{item.TotAmountDeposited}}</a> </td>
                        </tr>
                        <tr ng-repeat="item in CCSComplaintCombine" ng-if="item.DistrictNameEn=='Total'">
                            <th colspan="2"  style="text-align:right">{{item.DistrictNameEn}}</th>
                            <td style="text-align:right">{{item.TotComplainer}}</td>
                            <th  style="text-align:right">{{item.TotAmountDeposited}}</th>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div ng-show="DivShowDetail">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="table-responsive citizen-dash-head">
                <div class="col-md-12 dev-search-form">
                    <div class="col-xs-4">
                        <label for="search">{{translation.Search}}:</label>
                        <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                    </div>
                    <div class="col-xs-4">
                        <label for="search">{{translation.ItemPerPage}}:</label>
                        <input type="number" min="1" max="9999" class="form-control" ng-model="pageSize">
                    </div>
                    <div class="col-xs-4" style="padding-top: 25px; ">
                        <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblData', 'Get Support Data')" value="Export to Excel">
                    </div>
                </div>
                <br>

                <table id="tblData" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.ComplainerName}}
                            </th>
                            <th>
                                {{translation.NameOfFather}}
                            </th>
                            <th>
                                {{translation.Mobile}}
                            </th>
                            <th>
                                {{translation.Address}}
                            </th>
                            <th>
                                {{translation.District}}
                            </th>
                            <th>
                                {{translation.CCSName}}
                            </th>

                            <th  style="text-align:right">
                                {{translation.AmountDepoisted}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="item in CCSComplaintList | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{item.ComplainerName}}</td>
                            <td>{{item.ComplainerFatherName}}</td>
                            <td>{{item.MobileNo}}</td>
                            <td>{{item.Address}}</td>
                            <td>{{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}</td>
                            <td>{{item.SocietyName}}</td>
                            <td  style="text-align:right">{{item.AmountDeposited}}</td>
                        </tr>
                        <tr>
                            <td colspan="8" style="text-align:left"><input type="button" class="btn btn-primary dev-btn" ng-click="BackToCount()" value="Back"></td>
                        </tr>
                    </tbody>
                </table>

                <br />
                <div class="col-md-12">
                    <div class="text-center">
                        <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
                <div class="col-md-2">
                    <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                </div>
            </div>



        </div>
    </div>


</div>




