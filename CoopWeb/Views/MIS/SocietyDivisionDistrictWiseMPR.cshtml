<script src="~/Scripts/AngularFramework/societyDivisionDistrictwiseMPR.js"></script>
<script src="~/Scripts/Excel/jszip_v1.js"></script>
<script src="~/Scripts/Excel/xlsx.js"></script>
<script src="~/Scripts/Excel/jszip.js"></script>
<script src="~/Scripts/Excel/FileSaver.js"></script>
<script src="~/Scripts/Excel/myexcel.js"></script>

<div class="hk-pg-wrapper" ng-app="societydivisionDistrictwisemodule" ng-controller="societydivisionDistrictwiseCount">
    <div>
        <!-- Breadcrumb -->
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">{{translation.MPR1958CoSocietyRegistered}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.MIS}}  </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.MPR1958CoSocietyRegistered}}   </span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="table-responsive citizen-dash-head">
                <div class="table-dropdown" id="search-filter" style="overflow:inherit; float:left;width: 100%;margin-bottom: 10px;">
                    <div class="col-md-2 margin-Top20 y_dropdown" style="padding-left: 0;">
                        <label for="search" class="ng-binding">{{translation.Month}}:</label>
                        <input id="txtFromMonth" value="date" type="month" class="form-control" autocomplete="off" onkeypress="return false;" />
                    </div>
                    <div class="col-md-2 margin-Top20 y_dropdown" style="padding-left: 0;">
                        <label>{{ translation.Division}}:</label>
                        <select name="Districtdll" ng-model="DivisionId" class="form-control" ng-init="DivisionId='0'">
                            <option value="0">{{translation.SelectOption}}</option>
                            <option ng-repeat="district in DivisionList" value="{{district.DIVISION_ID}}">
                                {{_language =='en-us' ?  district.DIVISION_MANGAL : district.DIVISION_MANGAL}}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-2 margin-Top20 y_dropdown" style="padding-left: 0;">
                        <br />
                        <button type="submit" class="btn btn-primary dev-btn" ng-click="GetSocietyDivisionDistrictwiseMPR()">{{translation.Search}}</button>
                        <input type="button" class="btn btn-primary dev-btn" ng-click="ExportData()" value="Export to Excel">
                    </div>
                </div>
                <table id="tblgetsuport" style="width:100%">
                    <tbody style="text-align:center">
                        <tr ng-repeat="Item in DivistionList" class="item_{{Item.DIVISION_ID}} divItemForHide">
                            <td colspan="4">
                                <table class="table table-responsive devtable" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th style="text-align:center;" colspan="5">{{Item.DIVISION_MANGAL}}</th>
                                        </tr>
                                        <tr>
                                            <th style="text-align:left">{{translation.SRNO}}</th>
                                            <th style="text-align:left">{{translation.District}}</th>
                                            <th style="text-align: center">{{dateummu}} {{translation.GatmahtakpanjikritkisankhyokiShankhya}}</th>
                                            <th style="text-align: center">{{dateummu}} {{translation.Mahmepanjikritsankhyaokishankhya}}</th>
                                            <th style="text-align: center">{{dateummu}} {{translation.Mahkeantmepanjikritsankhyaokikulshankya}}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="tm in Item.DistricList">
                                            <td style="text-align:left">{{$index+1}}</td>
                                            <td style="text-align: left">{{tm.DISTRICT_MANGAL}}</td>
                                            <td style="text-align: center">{{tm.ToatlPrevMonth}}</td>
                                            <td style="text-align: center" ng->{{tm.TotalLastMonth}}</td>
                                            @*<td style="text-align: center">{{tm.ToatlPrevMonth}}</td>*@
                                            <td style="text-align: center">{{tm.TotalLastMonth + tm.ToatlPrevMonth}}</td>
                                        </tr>
                                        <tr>
                                            <th colspan="2" style="text-align:center">{{translation.Yog}}</th>
                                            <th style="text-align:center">{{ToatlPrevMonth[Item.DIVISION_ID]}}</th>
                                            <th style="text-align:center">{{TotalLastMonth[Item.DIVISION_ID]}}</th>
                                            <th style="text-align:center">{{TotalLastMonth[Item.DIVISION_ID]+ToatlPrevMonth[Item.DIVISION_ID]}}</th>
                                        </tr>
                                    </tbody>

                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

