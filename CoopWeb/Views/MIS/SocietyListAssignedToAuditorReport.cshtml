                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.SocietyName}}
                                </th>
                                <th>
                                    {{translation.RegistrationNo}}
                                </th>
                                <th>
                                    {{translation.AuditBy}}
                                </th>
                                <th>
                                    {{translation.AuditorInspector}}
                                </th>
                                <th>
                                    {{translation.FincialYearHeading}}
                                </th>
                                <th>
                                    {{translation.RequestStatus}}
                                </th>
                                <th>
                                    {{translation.Date}}
                                </th>
                                <th>
                                    {{translation.Order}}
                                </th>
                                <th>
                                    {{translation.Document}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="items in AssignedAuditor | filter: q  | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="rolePagination">
