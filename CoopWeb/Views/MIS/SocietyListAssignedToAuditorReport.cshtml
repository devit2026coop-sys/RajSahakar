                                <td>{{ items.RegistrationNo }}</td>
                                <td>{{ items.AuditBy}}</td>
                                <td>{{ items.AuditorName }}</td>
                                <td>{{items.FIN_YEAR_NAME}}</td>
                                <td>{{ items.RequestStatusText }} </td>
                                <td>{{ items.RequestDate }}</td>
                                <td><a ng-show="{{items.AuditorAssignFilePath!=''}}" href="{{items.AuditorAssignFilePath}}" class="fa fa-download" target="_blank"></a> </td>
                                <td><a href="javascript:void(0)" ng-click="ViewDocuments(items.Id)" class="fa fa-eye"></a> </td>
                            </tr>
                        </tbody>
                        <tfoot ng-hide="AssignedAuditor.length>0">
