                <div>
                    <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;" ng-if="!showDetailsReport">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th style="text-align:left">District</th>
                                <th style="text-align:center">Total Application</th>
                                <th style="text-align:center">Approved</th>
                                <th style="text-align:center">Rejected</th>
                                <th style="text-align:center">In Progress</th>
                                <th style="text-align:center">Objected/Pending</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in AmendmentList" style="cursor: pointer;">
                                <td>{{$index+1}}</td>
                                <td style="text-align:left">
                                    <a href="javascript:void(0)" ng-click="GetDetailsList(item.DISTRICT_ID,1)">{{item.DISTRICT_ENG}}</a>
                                </td>
                                <td style="text-align:center">
                                    <a href="javascript:void(0)" ng-click="GetDetailsList(item.DISTRICT_ID,1)">{{item.TotalApplication}}</a>
                                </td>
                                <td style="text-align:center">
                                    <a href="" ng-if="item.Approved > 0" ng-click="GetDetailsList(item.DISTRICT_ID,2)">{{item.Approved}}</a>
                                    <span ng-if="item.Approved == 0">{{item.Approved}}</span>
                                </td>
                                <td style="text-align: center">
                                    <a href="" ng-if="item.Reject > 0" ng-click="GetDetailsList(item.DISTRICT_ID,4)">{{item.Reject}}</a>
                                    <span ng-if="item.Reject == 0">{{item.Reject}}</span>
                                </td>
                                <td style="text-align: center">
                                    <a href="" ng-if="item.UnderProcess > 0" ng-click="GetDetailsList(item.DISTRICT_ID,5)">{{item.UnderProcess}}</a>
                                    <span ng-if="item.UnderProcess == 0">{{item.UnderProcess}}</span>
                                </td>
                                <td style="text-align: center">
                                    <a href="" ng-if="item.Pandding > 0" ng-click="GetDetailsList(item.DISTRICT_ID,3)">{{item.Pandding}}</a>
                                    <span ng-if="item.Pandding == 0">{{item.Pandding}}</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div>
                    <div class="table-dropdown" id="search-filter">
                        <div class="col-md-2 margin-Top20">
                            <label for="search" class="ng-binding">{{translation.Search}}:</label>
                            <input name="SearchText" type="text" class="form-control" ng-model="Filter.SearchText" />
                        </div>
                        <div class="col-md-2  margin-Top20">
                            <label>&nbsp;</label><br>
                            <button type="button" ng-click="searchRequest(GetDigitalRegister)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>

                        </div>
                    </div>
                    <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;" ng-if="showDetailsReport">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('SocietyName')">
                                    {{translation.SocietyName}}
                                    <div ng-class="getSortClass('SocietyName')"></div>
                                </th>
                                <th>
                                    {{translation.SocietyRegistrationNo}}
                                </th>
                                <th>
                                    {{translation.AssignTo}}
                                </th>
                                <th>
                                    {{translation.Status}}
                                </th>
                                <th>
                                    {{translation.Remarks}}
                                </th>
                                <th>
                                    {{translation.CreationDate}}
                                </th>
                                <th>
                                    {{translation.Actions}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="AppFlow in AmendmentDetailsList" style="cursor: pointer;">
                                <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>

                                <td>
                                    <b> <i ng-style="{'background-color': getColor(AppFlow), 'color': gettextColor(AppFlow), 'cursor':'pointer'}">{{AppFlow.SocietyName }}</i></b>
                                </td>
                                <td>{{AppFlow.RegistrationNo}}  </td>
                                <td>{{AppFlow.OfficerName}}</td>
                                <td>{{AppFlow.ProceesStatusTextEn}}</td>
                                <td>{{AppFlow.Remark}}</td>
                                <td>{{AppFlow.ActionDate}}</td>
                                <td style="text-align: center">
                                    <a title="{{translation.ShowDetails}}" href="../ApplicationFlow/SocietyActionView?SocietyIDEnc={{AppFlow.SocietyIDEnc}}~_ApplicationFlow_ApplicationFlow" style="color:#505050;" target="_blank"><i class="fa fa-info-circle infoicon-edit"></i></a>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetDigitalRegister)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetDigitalRegister)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetDigitalRegister)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetDigitalRegister)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetDigitalRegister)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <input ng-if="showDetailsReport" type="button" id="btnExport" class="btn btn-primary dev-btn" style="" ng-click="DetailsBack()" value="Back" />

                </div>
            </div>
        </div>
    </div>
</div>



