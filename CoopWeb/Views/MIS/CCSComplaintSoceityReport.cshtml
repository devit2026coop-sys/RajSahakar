<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>
<script src="~/Scripts/AngularFramework/CCSComplaintSoceityReport.js?id=1"></script>
<div ng-app="CCSComplaintReportMod" ng-controller="CCSComplaintReportCnt">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head"> Society CCS Report   </h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MIS}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> Society CCS Report  </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="DivShowCount">
        <div class="table-responsive citizen-dash-head">
            <div class="col-md-12 dev-search-form">
                <div class="col-lg-6" style="margin-top:30px;">
                    <div class="col-lg-2">{{ translation.FilterType}}:</div>
                    <div class="col-lg-8">
                        <input type="radio" name="rdoSelect" value="1" ng-click="ChangeSelction()" /> {{translation.AllSocieties}} &nbsp;&nbsp;
                        <input type="radio" name="rdoSelect" value="2" ng-click="ChangeSelction()" />  {{translation.SingleState}} &nbsp;&nbsp;
                        <input type="radio" name="rdoSelect" value="3" checked="checked" ng-click="ChangeSelction()" />  {{translation.MultiState}} &nbsp;&nbsp;
                    </div>
                </div>
                <div class="col-md-4  margin-Top20">
                    <label>&nbsp;</label><br>
                    <button type="button" ng-click="GetComplaintData(1)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                </div>               
            </div>
        </div>
    </div>
    <div ng-show="DivShowCount">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="table-responsive citizen-dash-head">
                <table id="tbl6" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                    <thead>
                        <tr>
                            <th style="width:5%">
                                {{ translation.SRNO}}
                            </th>
                            <th style="width:35%">
                                Society Name
                            </th>
                            <th style="text-align:right;width:30%">
                                {{ translation.TotalComplainer}}
                            </th>
                            <th style="text-align:right;width:30%">
                                {{ translation.TotalAmountDeposited}}
                            </th>
                        </tr>

                    </thead>
                    <tbody>
                        <tr ng-repeat="item in CCSComplaintCombine" style="cursor:pointer;" ng-if="item.SocietyName!='Total'">
                            <td><a ng-click="GetshowdtailsList(item)">{{$index+1}}</a></td>
                            <td><a ng-click="GetshowdtailsList(item)">{{item.SocietyName}}</a></td>
                            <td style="text-align:right"><a ng-click="GetshowdtailsList(item)">{{item.Total}}</a></td>
                            <td style="text-align:right"><a ng-click="GetshowdtailsList(item)">{{item.toamt}}</a> </td>
                        </tr>
                        <tr>
                            <td><input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tbl6', 'Get Support Data')" value="Export to Excel"></td>
                            <th style="text-align:right">Total</th>
                            <td style="text-align:right" fo>{{TotalCSS}}</td>
                            <th style="text-align:right">{{total}}</th>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div ng-show="!DivShowCount">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="table-responsive citizen-dash-head">
                <div class="col-md-12 dev-search-form" id="search-filter">
                    <div class="col-md-4" style="padding-left: 0;">
                        <label for="search">{{translation.Search}}:</label>
                        <input name="SearchText" id="search" class="form-control" ng-model="Filter.SearchText" placeholder="{{translation.filttertext}}" autocomplete="off">
                    </div>

                    <div class="col-md-4  margin-Top20">
                        <label>&nbsp;</label><br>
                        <button type="button" ng-click="searchRequest(GetComplaintData)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                        <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                    </div>

                </div>

                <table id="tblData" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.ComplainerName}}
                            </th>
                            <th>
                                {{translation.NameOfFather}}
                            </th>
                            <th>
                                {{translation.Mobile}}
                            </th>
                            <th>
                                {{translation.Address}}
                            </th>
                            <th>
                                DISTRICT
                            </th>
                            <th>
                                {{translation.RegistrationNo}}
                            </th>

                            <th>
                                {{translation.CCSName}}
                            </th>
                            <th>
                                AmountDeposited
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in CCSComplaintDetailsList">
                            <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                            <td>{{item.ComplainerName}}</td>
                            <td>{{item.ComplainerFatherName}}</td>
                            <td>{{item.MobileNo}}</td>
                            <td>{{item.Address}}</td>
                            <td>{{item.DISTRICT_ENG}}</td>
                            <td>{{item.RegistrationNo}}</td>
                            <td>{{item.SocietyName}}</td>
                            <td>{{item.AmountDeposited}}</td>
                        </tr>
                        <tr>
                            <td style="text-align:left"><input type="button" class="btn btn-primary dev-btn" ng-click="BackToCount()" value="Back"></td>
                            <td colspan="13">
                                <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                    <div class="col-md-2" id="dataTables-example_info" role="status" aria-live="polite">
                                        Total Records: {{DataPagingDetails.TotalRecords}}
                                    </div>
                                    <div class="col-md-10">
                                        <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',ShowDetail)" style="cursor: pointer;">
                                                <span>«First</span>
                                            </li>
                                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,ShowDetail)" style="cursor:pointer;">
                                                <span>« Previous</span>
                                            </li>
                                            <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,ShowDetail)"><span>{{n}}</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,ShowDetail)" style="cursor:pointer;">
                                                <span>Next »</span>
                                            </li>
                                            <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,ShowDetail)" style="cursor:pointer;">
                                                <span>Last »</span>
                                            </li>
                                        </ul>
                                    </div>

                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>




