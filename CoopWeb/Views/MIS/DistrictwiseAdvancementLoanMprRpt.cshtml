
<script src="~/Scripts/AngularFramework/DistrictwiseAdvancementLoanRpt.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />
@Html.Hidden("TemplateId")
<div ng-app="AppEntryFormLoanAdvancement">
    <div ng-controller="LoanAdvancementcnt">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.DistrictwiseAdvancementLoanMprRpt}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.EntryForm}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.DistrictwiseAdvancementLoanMprRpt}} </span>
                    </li>

                </ul>
            </div>
        </div>
        <input type="hidden" id="roleid" value="@ViewBag.RoleId" />
        <div ng-show="@ViewBag.RoleId !=10222" class="citizen-dash-head">
            <form>
                <div class="col-md-4">
                    <label>
                        {{translation.FincialYearHeading}} :
                    </label>
                    <select class="form-control" id="ddlFYearId1" ng-model="Loan.FYear1">
                        <option value="">{{translation.SelectOption}}</option>
                        <option ng-repeat="district in  FinancialYearList" value="{{district.FIN_YEAR_MASTR_ID}}">
                            {{_language =='en-us' ?  district.FIN_YEAR_NAME : district.FIN_YEAR_NAME}}
                        </option>
                    </select>
                </div>
                <div class="col-lg-12 form-group">
                    <input type="hidden" ng-model="Loan.LoanDataId" />
                    <label>{{ translation.LoanAdvancement}}</label>
                </div>

                <div class="col-lg-12 form-group">

                    <div class="col-lg-1">{{translation.Stamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.AprStamt" placeholder="" autocomplete="off" />
                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-1">{{translation.Mtamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.AprMtamt" placeholder="" autocomplete="off" />

                    </div>
                    <div class="col-lg-1"></div>
                    <div class="col-lg-1">{{translation.ltamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.Aprltamt" placeholder="" autocomplete="off" />
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <label>{{ translation.LoanRecovered}}</label>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-1">{{translation.Stamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.RecStamt" placeholder="" autocomplete="off" ng-init="Liqudation.NameUnit='0'" />
                    </div>
                    <div class="col-lg-1"></div>

                    <div class="col-lg-1">{{translation.Mtamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.RecMtamt" placeholder="" autocomplete="off" />
                    </div>

                    <div class="col-lg-1"></div>

                    <div class="col-lg-1">{{translation.ltamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" ng-bind="ProgrammeNameEn" ng-model="Loan.Recltamt" placeholder="" autocomplete="off" />

                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <label>Loan Outstanding amount</label>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-1">{{translation.Stamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" id="Loastamt" ng-model="Loan.loastamt" value="{{Loan.AprStamt-Loan.RecStamt}}" disabled />
                    </div>
                    <div class="col-lg-1"></div>

                    <div class="col-lg-1">{{translation.Mtamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" id="Loamtamt" ng-model="Loan.loamtamt" value="{{Loan.AprMtamt-Loan.RecMtamt}}" disabled />
                    </div>

                    <div class="col-lg-1"></div>

                    <div class="col-lg-1">{{translation.ltamt}}</div>
                    <div class="col-lg-2">
                        <input type="number" class="form-control" id="Loaltamt" ng-model="Loan.loaltamt" value="{{Loan.Aprltamt-Loan.Recltamt}}" disabled />
                    </div>
                </div>
                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveLoan()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearLoanForm()">{{translation.Clear}}</button>
                    </div>
                </div>
            </form>
        </div>

        <div ng-show="DivtringGrid">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        @*<div class="col-md-4">
                            <label>
                                {{translation.FincialYearHeading}} :
                            </label>
                            <select class="form-control" ng-model="Loan.FYear">
                                <option value="">{{translation.SelectOption}}</option>
                                <option ng-repeat="district in  FinancialYearList" value="{{district.FIN_YEAR_MASTR_ID}}" id="ddlFYearId" ng-model="Loan.FYear">
                                    {{_language =='en-us' ?  district.FIN_YEAR_NAME : district.FIN_YEAR_NAME}}
                                </option>
                            </select>
                        </div>*@
                        @*<div class="col-md-4">
                            <button type="submit" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-disabled="Liqudation.MonthId.$invalid" ng-click="GridData2()">{{translation.Show}}</button>
                        </div>*@
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th rowspan="2">
                                    {{translation.SRNO}}
                                </th>

                                <th rowspan="2" style="text-align: center !important">
                                    {{translation.District}}

                                </th>
                                <th rowspan="2" style="text-align: center !important">
                                    {{translation.FincialYearHeading}}

                                </th>
                                <th colspan="3" style="text-align:center !important">
                                    {{translation.LoanAdvancement}} (In Thousand)

                                </th>

                                <th colspan="3" style="text-align:center !important">
                                    {{translation.LoanRecovered}} (In Thousand)

                                </th>

                                <th colspan="3" style="text-align:center !important">
                                    {{translation.LoanOutstanding}} (In Thousand)

                                </th>

                            </tr>


                            <tr>
                                <th style="text-align:center !important">{{translation.Stamt}}</th>
                                <th style="text-align:center !important">{{translation.Mtamt}}</th>
                                <th style="text-align:center !important">{{translation.ltamt}}</th>
                                <th style="text-align:center !important">{{translation.Stamt}}</th>
                                <th style="text-align:center !important">{{translation.Mtamt}}</th>
                                <th style="text-align:center !important">{{translation.ltamt}}</th>
                                <th style="text-align:center !important">{{translation.Stamt}}</th>
                                <th style="text-align:center !important">{{translation.Mtamt}}</th>
                                <th style="text-align:center !important">{{translation.ltamt}}</th>

                            </tr>


                        </thead>

                        <tbody>

                            <tr dir-paginate="BData in LoanData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>

                                <td style="text-align:center !important">
                                    {{ BData.DISTRICT_ENG}}
                                </td>
                                <td style="text-align:center !important">
                                    {{ BData.Year}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.AprStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.AprMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Aprltamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.RecStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.RecMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Recltamt}}
                                </td>

                                <td style="text-align:center !important">
                                    {{BData.OptStamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.OptMtamt}}
                                </td>
                                <td style="text-align:center !important">
                                    {{BData.Optltamt}}
                                </td>

                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>



            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="TrainningFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">
                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                </div>
            </div>

        </div>
    </div>

</div>