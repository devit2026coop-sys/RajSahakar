
	<meta charset="UTF-8">
	<title>eSign Success</title>

	<!-- Bootstrap CSS -->
	<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />

	<!-- Font Awesome -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />

	<style>
		body {
			background: linear-gradient(135deg, #f5f9ff, #e9f5ff);
			min-height: 100vh;
			font-family: 'Segoe UI', sans-serif;
		}

		.esign-container {
			padding-top: 80px;
		}

		.esign-card {
			border-radius: 15px;
			border: none;
			padding: 30px;
			animation: fadeInUp 0.6s ease-in-out;
		}

		.success-icon i {
			font-size: 90px;
			color: #28a745;
			animation: popIn 0.5s ease;
		}

		.detail-label {
			font-weight: 600;
			color: #555;
		}

		.detail-value {
			font-weight: 500;
			color: #333;
		}

		.status-badge {
			font-size: 14px;
			padding: 6px 14px;
		}

		@@keyframes fadeInUp {
			from {
				opacity: 0;
				transform: translateY(20px);
			}

			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		@@keyframes popIn {
			from {
				transform: scale(0.5);
				opacity: 0;
			}

			to {
				transform: scale(1);
				opacity: 1;
			}
		}
	</style>


	<div>
		<div class="hk-pg-wrapper">

			<div class="container esign-container">

				<div class="row justify-content-center">
					<div class="col-md-8">

						<div class="card shadow-lg esign-card">

							<div class="text-center">

								<div class="success-icon">
									<i class="fas fa-check-circle"></i>
								</div>

								<h2 class="text-success mt-3">
									Document Signed Successfully
								</h2>

								<p class="text-muted">
									Your document has been digitally signed and stored securely.
								</p>

							</div>

							<hr />

							<!-- Transaction Details -->
							

							<hr />

							

						</div>

					</div>
				</div>

			</div>
		</div>
	</div>
	<!-- AngularJS -->
	<script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>

	

	

