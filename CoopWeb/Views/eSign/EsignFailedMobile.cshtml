<!-- Bootstrap CSS -->
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />

<!-- Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />

<style>
	body {
		background: linear-gradient(135deg, #fff5f5, #ffecec);
		min-height: 100vh;
		font-family: 'Segoe UI', sans-serif;
	}

	.esign-container {
		padding-top: 80px;
	}

	.esign-card {
		border-radius: 15px;
		border: none;
		padding: 30px;
		animation: fadeInUp 0.6s ease-in-out;
	}

	.failure-icon i {
		font-size: 90px;
		color: #dc3545;
		animation: shake 0.6s ease;
	}

	.detail-label {
		font-weight: 600;
		color: #555;
	}

	.detail-value {
		font-weight: 500;
		color: #333;
	}

	@@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@@keyframes shake {
		0% {
			transform: translateX(0);
		}

		25% {
			transform: translateX(-5px);
		}

		50% {
			transform: translateX(5px);
		}

		75% {
			transform: translateX(-5px);
		}

		100% {
			transform: translateX(0);
		}
	}
</style>

<div>
	<div class="hk-pg-wrapper">
		<div class="container esign-container">

			<div class="row justify-content-center">
				<div class="col-md-8">

					<div class="card shadow-lg esign-card">

						<div class="text-center">

							<div class="failure-icon">
								<i class="fas fa-times-circle"></i>
							</div>

							<h2 class="text-danger mt-3">
								eSign Process Failed
							</h2>
							<div class="alert alert-danger mt-3">
								@ViewBag.ErrorMessage
							</div>
							<p class="text-muted">
								We were unable to complete the digital signing process.
							</p>

						</div>

						<hr />

						<!-- Failure Details -->
						<div class="mt-3">

							

							<div class="row mb-3">
								<div class="col-5 detail-label">
									eSign Status
								</div>
								<div class="col-7 detail-value text-danger">
									FAILED
								</div>
							</div>

							

						</div>

						<hr />

						

					</div>

				</div>
			</div>

		</div>
	</div>
</div>
<!-- AngularJS -->
<script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>



