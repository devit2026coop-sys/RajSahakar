@model Cooperative.Models.SignedXmlResponse
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Redirecting to eSign...</title>
</head>
<body>
    <form id="esignForm" action="https://esign.rajasthan.gov.in/esign/2.1/signdoc/"
          method="post" enctype="multipart/form-data" name="uploadForm">
        <textarea name="esignData" style="display:none;">
            @System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(ViewBag.response))
        </textarea>
        <span ng-if="!isEsignProcessing">
            {{translation.ASApproEsign}}
        </span>

        <span ng-if="isEsignProcessing">
            <i class="fa fa-spinner fa-spin"></i> Processing...
        </span>
    </form>

    <script>
        document.getElementById("esignForm").submit();
    </script>

</body>
</html>
