
<meta charset="UTF-8">
<title>eSign Success</title>
<script src="~/Scripts/jquery.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/angular.min.js"></script>
<link href="~/Content/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
<script src="~/Scripts/AngularFramework/EsignSuccess.js"></script>

<style>
    body {
        background: linear-gradient(135deg, #f5f9ff, #e9f5ff);
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .esign-container {
        padding-top: 80px;
    }

    .esign-card {
        border-radius: 15px;
        border: none;
        padding: 30px;
        animation: fadeInUp 0.6s ease-in-out;
    }

    .success-icon i {
        font-size: 90px;
        color: #28a745;
        animation: popIn 0.5s ease;
    }

    .detail-label {
        font-weight: 600;
        color: #555;
    }

    .detail-value {
        font-weight: 500;
        color: #333;
    }

    .status-badge {
        font-size: 14px;
        padding: 6px 14px;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes popIn {
        from {
            transform: scale(0.5);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>


<div ng-app="esignApp">
    <div class="hk-pg-wrapper" ng-controller="EsignResultController">

        <div class="container esign-container">

            <div class="row justify-content-center">
                <div class="col-md-8">

                    <div class="card shadow-lg esign-card">

                        <div class="text-center">

                            <div class="success-icon">
                                <i class="fa fa-check-circle"></i>
                            </div>

                            <h2 class="text-success mt-3">
                                Document Signed Successfully
                            </h2>

                            <p class="text-muted">
                                Your document has been digitally signed and stored securely.
                            </p>

                        </div>

                        <hr />

                        <!-- Transaction Details -->
                        <div class="mt-3">

                            <div class="row mb-3">
                                <div class="col-5 detail-label">
                                    Transaction Reference (PRN)
                                </div>
                                <div class="col-7 detail-value">
                                    {{esignResult.PRN || 'N/A'}}
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-5 detail-label">
                                    Transaction ID
                                </div>
                                <div class="col-7 detail-value">
                                    {{esignResult.TxnId || 'N/A'}}
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-5 detail-label">
                                    Status
                                </div>
                                <div class="col-7">
                                    <span class="badge badge-success status-badge">
                                        {{esignResult.Status || 'SIGNED'}}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <!-- Buttons -->
                        <div class="text-center mt-4">

                            <button class="btn btn-success btn-lg mr-2"
                                    ng-click="DownloadSignedPdf(esignResult.SignedPdfPath)">
                                <i class="fa fa-download"></i>
                                Download Signed PDF
                            </button>

                            <button class="btn btn-outline-primary btn-lg"
                                    ng-click="GoToPrevious(esignResult.ReturnPath)">
                                <i class="fa fa-arrow-left"></i>
                                Back To Previous Page
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




