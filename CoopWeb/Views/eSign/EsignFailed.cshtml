<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/angular.min.js"></script>
<link href="~/Content/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
<script src="~/Scripts/AngularFramework/EsignSuccess.js"></script>

<style>
    body {
        background: linear-gradient(135deg, #fff5f5, #ffecec);
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .esign-container {
        padding-top: 80px;
    }

    .esign-card {
        border-radius: 15px;
        border: none;
        padding: 30px;
        animation: fadeInUp 0.6s ease-in-out;
    }

    .failure-icon i {
        font-size: 90px;
        color: #dc3545;
        animation: shake 0.6s ease;
    }

    .detail-label {
        font-weight: 600;
        color: #555;
    }

    .detail-value {
        font-weight: 500;
        color: #333;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-message {
        font-size: 15px;
        font-weight: 500; /* Optional */
    }

    @@keyframes shake {
        0% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        50% {
            transform: translateX(5px);
        }

        75% {
            transform: translateX(-5px);
        }

        100% {
            transform: translateX(0);
        }
    }
</style>

<div ng-app="esignApp">
    <div class="hk-pg-wrapper" ng-controller="EsignResultController">
        <div class="container esign-container">

            <div class="row justify-content-center">
                <div class="col-md-8">

                    <div class="card shadow-lg esign-card">

                        <div class="text-center">

                            <div class="failure-icon">
                                <i class="fa fa-times-circle"></i>
                            </div>

                            <h2 class="text-danger mt-3">
                                eSign Process Failed
                            </h2>
                            @*<div class="alert alert-danger mt-3 alert-message">
                                    {{esignResult.message }}
                                </div>*@
                            <div class="alert alert-danger mt-3 alert-message"
                                 style="white-space: pre-line;">
                                {{esignResult.message}}
                            </div>
                            <p class="text-muted">
                                We were unable to complete the digital signing process.
                            </p>

                        </div>

                        <hr />

                        <!-- Failure Details -->
                        <div class="mt-3">

                            <div class="row mb-3">
                                <div class="col-5 detail-label">
                                    Transaction Reference (PRN)
                                </div>
                                <div class="col-7 detail-value">
                                    {{esignResult.PRN || 'N/A'}}
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-5 detail-label">
                                    Status
                                </div>
                                <div class="col-7 detail-value text-danger">
                                    {{esignResult.Status || 'FAILED'}}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-5 detail-label">
                                    Error Message
                                </div>
                                <div class="col-7 detail-value">
                                    {{esignResult.ResponseMessage || 'Something went wrong during signing.'}}
                                </div>
                            </div>

                        </div>

                        <hr />

                        <!-- Action Buttons -->
                        <div class="text-center mt-4">
                            <button class="btn btn-outline-secondary btn-lg"
                                    ng-click="GoToPrevious(esignResult.ReturnPath)">
                                <i class="fa fa-arrow-left"></i>
                                Try Again
                            </button>

                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
