<style>
    .has-error {
        border: #F00;
    }

    h5, p {
        text-align: left;
    }

    .ui-timepicker-table th.periods {
        padding: 0.1em !important;
        width: 2.2em !important;
    }

    .ui-timepicker-table td span {
        display: block !important;
        padding: 0.2em 0.3em 0.2em 0.5em !important;
        width: 1.2em !important;
        text-align: right !important;
        text-decoration: none !important;
    }
    /* anchors for clickable cells */
    .ui-timepicker-table td a {
        display: block !important;
        padding: 0.2em 0.3em 0.2em 0.5em !important;
        width: 2.2em !important;
        cursor: pointer !important;
        text-align: right !important;
        text-decoration: none !important;
    }
</style>
<div ng-app="OrderCircularsAction" ng-controller="OrderCircularsController">
    <div class="col-md-12">
        <h3 class="citizen-dash-head">{{ translation.OrderCirculars }}</h3>
        <hr style="margin: 0;">
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{ translation.Home }}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{ translation.New }}  </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> {{ translation.OrderCirculars }}  </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-12" ng-show="DivPageContent">
        <div class="citizen-dash-head">
            <div class="table-dropdown">
                <div class="col-md-4">
                    <label for="search">{{translation.Search}}:</label>
                    <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">


                </div>
                <div class="col-md-4">
                    <label for="search">{{translation.ItemPerPage}}:</label>
                    <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                </div>

            </div>
            <div class="col-md-12 dev-search-form">

            </div><div class="col-md-12 dev-search-form">

            </div>
            <div class="col-md-12">
                <div class="table-responsive citizen-dash-head">
                    <table class="table devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.Name}}
                                </th>
                                <th>
                                    {{translation.TakeAction}}
                                </th>
                            </tr>
                        </thead>
                        <tbody id="myTable">
                            <tr dir-paginate="Item in OrderCircularsCatListData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuActionPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ Item.Name }}</td>
                                <td>
                                    <a ng-click="MapSSO(Item.Id)" data-toggle="modal" data-target="#exampleModal"><i class="fa fa-arrow-right"></i></a>
                                    <a ng-click="GETSSODETAIL(Item.Id)" data-toggle="modal" data-target="#exampleModal1"><i class="fa fa-eye"></i></a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @*<div id="myModal" class="modal">

                <!-- The Close Button -->
                <span class="close">&times;</span>

                <!-- Modal Content (The Image) -->
                <img class="modal-content" id="img01">

                <!-- Modal Caption (Image Text) -->
                <div id="caption"></div>16
            </div>*@

        <div class="col-md-10">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="MenuActionPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="col-md-2">
            <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
        </div>

    </div>
    <div class="modal fade" ng-show="ShowSSOMAP" id="exampleModal1" tabindex="-2" role="dialog" aria-labelledby="exampleModalLabel1" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 style="color: #64c0c5;text-align: center;font-size: x-large;text-transform: uppercase;">{{ translation.OrderCircularsSSOMAP }}</h5>                
                  
                </div>
                <div class="modal-body">
                    <div class="table-responsive citizen-dash-head">
                        <table class="table devtable">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th>
                                        {{translation.SSOID}}
                                    </th>
                                    <th>
                                        {{translation.TakeAction}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="myTable">
                                <tr dir-paginate="Item in OrderCircularsSSOListData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuActionPagination">
                                    <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                    <td>{{ Item.ssoid }}</td>
                                    <td>
                                        <a ng-click="DeleteSSO(Item.ordercatmapid,2)"><i class="fa fa-trash-o"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 style="color: #64c0c5;text-align: center;font-size: x-large;text-transform: uppercase;">{{ translation.OrderCircularsSSOMAP }}</h5>
                    <button type="button" class="btn btn-primary" ng-click="newItem()" >ADD NEW</button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="col-lg-12 form-group" ng-repeat="element in elements">
                            <div class="col-lg-2" style="color:#204d74; top: 5px;font-size: large;font-weight: bold;">{{ translation.SSOID }}</div>
                            <div class="col-lg-10">
                                <input type="hidden" id="bar" value="1" />
                                <input type="text" name="NewsTitleHi" width="100" class="form-control" id="oicname" ng-model="element.SSOId" placeholder="{{ translation.SSOID }}" autocomplete="off">
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" ng-click="SaveOrderCircularsMap(elements)" style="margin-right:15px;">{{translation.Submit}}</button>
                </div>
            </div>
        </div>
    </div>

    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

