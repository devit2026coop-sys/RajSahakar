<script src="~/Scripts/AngularFramework/WebSahakar.js"></script>
@*<script src="~/ckeditor/ckeditor.js"></script>*@

<script src="http://code.jquery.com/jquery-migrate-1.2.1.js"></script>
@*<script src="http://code.jquery.com/jquery-1.11.3.min.js"></script>*@
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />
<script src="~/Scripts/summernote.js"></script>
<link href="~/Content/Stylesheets/summernote.css" rel="stylesheet" />
<link href="~/Cleditor/Content/cleditor/jquery.cleditor.css" rel="stylesheet" />
<script src="~/Cleditor/Scripts/jquery.cleditor.js"></script>






<style>
    .has-error {
        border: #F00;
    }

    h5, p {
        text-align: left;
    }

    .ui-timepicker-table th.periods {
        padding: 0.1em !important;
        width: 2.2em !important;
    }

    .ui-timepicker-table td span {
        display: block !important;
        padding: 0.2em 0.3em 0.2em 0.5em !important;
        width: 1.2em !important;
        text-align: right !important;
        text-decoration: none !important;
    }
    /* anchors for clickable cells */
    .ui-timepicker-table td a {
        display: block !important;
        padding: 0.2em 0.3em 0.2em 0.5em !important;
        width: 2.2em !important;
        cursor: pointer !important;
        text-align: right !important;
        text-decoration: none !important;
    }
</style>
<div ng-app="FertilizerAction" ng-controller="FertilizerController">
    <div class="col-md-12">
        <h3 class="citizen-dash-head">{{ translation.Fertilizer }}</h3>
        <hr style="margin: 0;">
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{ translation.Home }}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{ translation.New }}  </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> {{ translation.Fertilizer }}  </span>
                </li>
                <li style="float: right;" id="divAddBtn">
                    <button type="button" ng-click="AddNewsContent()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" >
                        <h5>&#187; {{translation.AddNew}}</h5>
                    </button>
                </li>

            </ul>
        </div>
    </div>
    <div class="citizen-dash-head" ng-show="DivAddContent">

        <form>
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top: -20px;">
                <h3 class="citizen-dash-head">{{ translation.Fertilizer }}</h3>
            </div>
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{ translation.TitleEn }}</div>
                <div class="col-lg-10">
                    <input type="text" name="NewsTitleEn" class="form-control" id="oicname" ng-model="Fertilizer.TitleEN" placeholder="{{ translation.TitleEn }}" autocomplete="off">
                </div>
            </div>
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{ translation.TitleHi }}</div>
                <div class="col-lg-10">
                    <input type="text" name="NewsTitleHi" class="form-control" id="oicname" ng-model="Fertilizer.TitleHI" placeholder="{{ translation.TitleHi }}" autocomplete="off">
                </div>
            </div>
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">
                    {{ translation.File}}<span class="error">*</span>
                </div>
                <div class="col-lg-4">
                    <input type="file" name="File"id="fuUpload" class="form-control" ng-model="Fertilizer.FileName" onchange="angular.element(this).scope().UploadNewsFile(this.files)">
                </div>
            </div>           
            <div class="form-group">
                <div class="dev-menu-btn">
                    <button type="submit" class="btn btn-primary" ng-click="SaveFertilizer()" style="margin-right:15px;">{{translation.Submit}}</button>
                    <button type="submit" class="btn btn-primary" ng-click="ClearFertilizer()">{{translation.Clear}}</button>
                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToPage()">{{translation.Back}} </a>
                    <input type="hidden" ng-model="Fertilizer.FertilizerID" />
                </div>
            </div>
        </form>
    </div>


    <div class="col-md-12" ng-show="DivPageContent">
        <div class="citizen-dash-head">
            <div class="table-dropdown">
                <div class="col-md-4">
                    <label for="search">{{translation.Search}}:</label>
                    <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                </div>
                <div class="col-md-4">
                    <label for="search">{{translation.ItemPerPage}}:</label>
                    <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                </div>
            </div>
            <div class="col-md-12 dev-search-form">

            </div><div class="col-md-12 dev-search-form">

            </div>
            <div class="col-md-12">
                <div class="table-responsive citizen-dash-head">
                    <table class="table devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.TitleEn}}
                                </th>
                                <th>{{translation.TitleHi}}</th>
                                <th>{{translation.Status}}</th>
                                <th>{{translation.Edit}}</th>
                                <th>{{translation.Delete}}</th>
                                <th>{{translation.File}}</th>
                            </tr>
                        </thead>
                        <tbody id="myTable">
                            <tr dir-paginate="Item in FertilizerData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuActionPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ Item.TitleEN }}</td>
                                <td>{{ Item.TitleHI }}</td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Item.IsActive == 1" ng-click="SetStatus(Item.FertilizerID,Item.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" ng-click="update(Item)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(Item.FertilizerID,2)"></i>

                                </td>
                                <td>
                                    <a target="_blank" ng-show="{{Item.FileName!=''}}" href="~/Content/Fertilizer/{{Item.FileName}}">
                                        <i class="fa fa-file-pdf-o"></i>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div id="myModal" class="modal">

            <!-- The Close Button -->
            <span class="close">&times;</span>

            <!-- Modal Content (The Image) -->
            <img class="modal-content" id="img01">

            <!-- Modal Caption (Image Text) -->
            <div id="caption"></div>
        </div>
        <div class="col-md-10">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="MenuActionPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="col-md-2">
            <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
        </div>

    </div>

    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

