<script src="~/Scripts/AngularFramework/WebSahakar.js"></script>
@*<script src="~/ckeditor/ckeditor.js"></script>*@
<style>
    .has-error {
        border: #F00;
    }
</style>
<div ng-app="TelePhoneModule" ng-controller="TelePhoneCont">


    <div class="col-md-12">
        <h3 class="citizen-dash-head">{{ translation.TelephoneDirectory }}</h3>
        <hr style="margin: 0;">
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{ translation.Home }}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{ translation.WebSahakar}}  </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> {{ translation.TelephoneDirectory }}  </span>
                </li>

            </ul>
        </div>
    </div>
    <div class="citizen-dash-head" ng-show="DivAddContent">

        <form>
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="margin-top: -20px;">
                <h3 class="citizen-dash-head">{{ translation.TelephoneDirectory }}</h3>
            </div>
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{ translation.TelePhoneCat }}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <select ng-model="TelePhone.TeleCatID" class="form-control" id="DDLPageId" ng-change="GetTelePhoneList(TelePhone.TeleCatID)">
                        <option ng-repeat="item in TelePhoneCatList" value="{{item.Id}}">
                            {{ _language =='en-us' ? item.Name : item.Name }}
                        </option>
                    </select>
                </div>
                <div class="col-lg-2">{{ translation.Name }}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="text" name="name" class="form-control" placeholder="{{translation.Name}}" ng-model="TelePhone.Name" autocomplete="off">
                </div>
            </div>

            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.Designation}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="text" name="designation" class="form-control" placeholder="{{translation.Designation}}" ng-model="TelePhone.Designation" autocomplete="off">
                </div>
                <div class="col-lg-2">{{translation.Mobile}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="text" name="designation" class="form-control" placeholder="{{translation.Mobile}}" ng-model="TelePhone.Mobile" autocomplete="off">
                </div>
            </div>

            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.STDCODE}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="text" name="designation" class="form-control" placeholder="{{translation.STDCODE}}" ng-model="TelePhone.STDCODE" autocomplete="off">
                </div>
                <div class="col-lg-2">{{translation.OFFICE}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="text" name="designation" class="form-control" placeholder="{{translation.OFFICE}}" ng-model="TelePhone.OFFICE" autocomplete="off">
                </div>
            </div>

            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.RESI}}</div>
                <div class="col-lg-4">
                    <input type="text" name="designation" class="form-control" placeholder="{{translation.RESI}}" ng-model="TelePhone.RESI" autocomplete="off">
                </div>
                <div class="col-lg-2">{{translation.FAX}}</div>
                <div class="col-lg-4">
                    <input type="text" name="designation" class="form-control" placeholder="{{translation.FAX}}" ng-model="TelePhone.FAX" autocomplete="off">
                </div>
            </div>

            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.EMAILID}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="text" name="designation" class="form-control" placeholder="{{translation.EMAILID}}" ng-model="TelePhone.EMAILID" autocomplete="off">
                </div>
                @*<div class="col-lg-2">{{translation.DisplayOrder}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="number" name="DisplayOrder" class="form-control" placeholder="{{translation.DisplayOrder}}" ng-model="TelePhone.DisplayOrder" autocomplete="off">
                </div>*@
            </div>
            <div class="col-lg-12 form-group">
                <div class="dev-menu-btn">
                    <button type="submit" class="btn btn-primary" ng-click="SaveTelePhone()" style="margin-right:15px;">{{translation.Submit}}</button>
                    <button type="submit" class="btn btn-primary" ng-click="ClearTelePhone()">{{translation.Clear}}</button>                    
                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                    <input type="hidden" ng-model="TelePhone.TeleCatID" />
                </div>
            </div>
        </form>
    </div>


    <div class="col-md-12" ng-show="DivTelePhoneContent">
        <div class="citizen-dash-head">
            <div class="table-dropdown">
                <div class="col-md-4">
                    <label for="search">{{translation.Search}}:</label>
                    <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                </div>
                <div class="col-md-4">
                    <label for="search">{{translation.ItemPerPage}}:</label>
                    <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                </div>
            </div>
            <div class="col-md-12 dev-search-form">

            </div><div class="col-md-12 dev-search-form">

            </div>
            <div class="col-md-12">
                <div class="table-responsive citizen-dash-head">
                    <table class="table devtable">
                        <thead>
                            <tr>
                                <th>{{translation.SNo}}</th>
                                <th> {{translation.Name}}</th>
                                <th> {{translation.Designation}}</th>
                                <th> {{translation.Mobile}}</th>
                                <th> {{translation.STDCODE}}</th>
                                <th> {{translation.Office}} </th>
                                <th> {{translation.RESI}} </th>
                                <th> {{translation.FAX}} </th>
                                <th> {{translation.EMAILID}} </th>
                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>{{translation.Edit}}</th>
                                <th>{{translation.Delete}}</th>
                            </tr>
                        </thead>
                        <tbody id="myTable">
                            <tr dir-paginate="Item in TelePhoneList | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuActionPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td> {{Item.Name}} </td>
                                <td> {{Item.Designation}} </td>
                                <td> {{Item.Mobile}} </td>
                                <td> {{Item.STDCODE}} </td>
                                <td> {{Item.OFFICE}} </td>
                                <td> {{Item.RESI}} </td>
                                <td> {{Item.FAX}} </td>
                                <td> {{Item.EMAILID}} </td>
                                <td>
                                    <div class="dev-action">

                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Item.IsActive == 1" ng-click="SetStatus(Item.TeleDirectoryID,Item.IsActive,Item.TeleCatID)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" ng-click="update(Item)"></i>
                                </td>

                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(Item.TeleDirectoryID,2,Item.TeleCatID)"></i>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-10">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="MenuActionPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="col-md-2">
            <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
        </div>

    </div>

    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

