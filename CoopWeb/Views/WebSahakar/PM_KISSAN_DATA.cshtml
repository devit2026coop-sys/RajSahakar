<script src="~/Scripts/AngularFramework/WebSahakar.js"></script>



<style>
    .has-error {
        border: #F00;
    }

    h5, p {
        text-align: left;
    }

    .ui-timepicker-table th.periods {
        padding: 0.1em !important;
        width: 2.2em !important;
    }

    .ui-timepicker-table td span {
        display: block !important;
        padding: 0.2em 0.3em 0.2em 0.5em !important;
        width: 1.2em !important;
        text-align: right !important;
        text-decoration: none !important;
    }
    /* anchors for clickable cells */
    .ui-timepicker-table td a {
        display: block !important;
        padding: 0.2em 0.3em 0.2em 0.5em !important;
        width: 2.2em !important;
        cursor: pointer !important;
        text-align: right !important;
        text-decoration: none !important;
    }
</style>
<div ng-app="PMKISSAN" ng-controller="PMKISSANController">
    <div class="col-md-12">
        <h3 class="citizen-dash-head">{{ translation.PMKisanSmsAction }}</h3>
        <hr style="margin: 0;">
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{ translation.Home }}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> {{ translation.PMKisanSmsAction }}  </span>
                </li>

            </ul>
        </div>
    </div>
    <div class="col-lg-12">
        <div class="citizen-dash-head">
            <form>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2">{{ translation.TotalApplicationReceived }}<span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" class="form-control devcalender" placeholder="{{translation.TotalApplicationReceived}}" ng-model="PMKisanSms.TotalApplication" autocomplete="off" />
                        </div>
                        <div class="col-lg-2">{{ translation.TotalUploadedOnPMKisan }}<span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" name="NewsTitleEn" class="form-control" id="oicname" ng-model="PMKisanSms.TotalUploded" placeholder="{{ translation.TotalUploadedOnPMKisan }}" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2">{{ translation.DisbursementInstallment1 }}<span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" name="NewsTitleEn" class="form-control" id="oicname" ng-model="PMKisanSms.DisbursementI" placeholder="{{ translation.DisbursementInstallment1 }}" autocomplete="off">
                        </div>
                        <div class="col-lg-2">{{ translation.DisbursementInstallment2 }}<span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" name="NewsTitleHi" class="form-control" id="oicname" ng-model="PMKisanSms.DisbursementII" placeholder="{{ translation.DisbursementInstallment2 }}" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2">{{ translation.DisbursementInstallment3 }}<span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" name="NewsTitleEn" class="form-control" id="oicname" ng-model="PMKisanSms.DisbursementIII" placeholder="{{ translation.DisbursementInstallment3 }}" autocomplete="off">
                        </div>
                        <div class="col-lg-2">{{ translation.DisbursementInstallment4 }}<span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" name="NewsTitleHi" class="form-control" id="oicname" ng-model="PMKisanSms.DisbursementIV" placeholder="{{ translation.DisbursementInstallment4 }}" autocomplete="off">
                        </div>
                    </div>

                </div>



                <div class="form-group">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="SavePMKissanSMS()" style="margin-right:15px;">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearData()">{{translation.Clear}}</button>
                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToPage()">{{translation.Back}} </a>
                        <input type="hidden" ng-model="PMKisanSms.NewsID" />
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-12">
        <div class="citizen-dash-head">
            <div class="col-md-12">
                <div class="table-responsive citizen-dash-head">
                    <table class="table devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.TotalApplicationReceived}}
                                </th>
                                <th>{{translation.TotalUploadedOnPMKisan}}</th>
                                <th>{{translation.DisbursementInstallment1}}</th>
                                <th>{{translation.DisbursementInstallment2}}</th>
                                <th>{{translation.DisbursementInstallment3}}</th>
                                <th>{{translation.DisbursementInstallment4}}</th>
                                <th>{{translation.Date}}</th>
                                <th>{{translation.Status}}</th>
                                <th>{{translation.Edit}}</th>
                            </tr>
                        </thead>
                        <tbody id="myTable">
                            <tr dir-paginate="Item in PMKisanSmsDataG | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuActionPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ Item.TotalApplication }}</td>
                                <td>{{ Item.TotalUploded }}</td>
                                <td>{{ Item.DisbursementI }}</td>
                                <td>{{ Item.DisbursementII }}</td>
                                <td>{{ Item.DisbursementIII }}</td>
                                <td>{{ Item.DisbursementIV }}</td>
                                <td>{{ Item.CreationDate }}</td>
                                <td>
                                    <div class="dev-action">
                                        <i class="fa fa-commenting-o" ng-click="SendSms()" aria-hidden="true"></i>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" ng-click="update(Item)"></i>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-10">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="MenuActionPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="col-md-2">
            <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
        </div>

    </div>

    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

