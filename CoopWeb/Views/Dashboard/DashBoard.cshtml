<style>
    .card {
        background: #fff;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        margin-bottom: 20px;
    }

    th {
        vertical-align: middle !important;
    }

    .card h2 {
        margin: 0;
        font-size: 28px;
    }

    .card small {
        color: #888;
    }

    .table-card {
        background: #fff;
        padding: 15px;
        border-radius: 10px;
    }

    .badge-custom {
        background: #00bfa5;
    }

    .last-crdHght {
        min-height: 400px;
    }

    .card-outer {
        padding: 15px;
        border-radius: 10px;
        background: #fff;
        margin: 15px 0;
    }

        .card-outer h3 {
            color: #000;
            font-weight: 600;
        }

    .colum-value-dashboard .card {
        margin: 0;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        margin-bottom: 20px;
        height: 128px;
        background: linear-gradient(90deg, #21CAB9 0%, #3C8DDC 100%);
        color: #ffff;
    }

        .colum-value-dashboard .card h2 {
            margin: 0;
            font-size: 36px;
            font-weight: 600;
            text-align:center;
        }

        .colum-value-dashboard .card small {
            font-size: 16px;
            font-weight: 600;
            color: #fff;
            display: block;
            margin-bottom: 8px;
            text-align:center;
        }

    .heading-mnage {
        background: linear-gradient(90deg, #21CAB9 0%, #3C8DDC 100%);
        color: #fff;
        margin: 0;
        padding: 12px;
    }

    .list-module {
        background-color: #fff;
        border-radius: 6px;
        overflow: hidden;
    }

        .list-module ul {
        }

            .list-module ul li {
                border-bottom: 1px solid rgba(231, 234, 239, 1);
                color: rgba(58, 24, 31, 1);
                padding: 10px 14px;
                font-weight: 500;
                color: #000;
                display: flex;
                gap: 10px;
                font-size: 16px;
                align-items: center;
                justify-content: space-between;
                cursor: pointer;
            }

                .list-module ul li h4 {
                    margin: 0;
                    display: flex;
                    gap: 16px;
                    align-items: center;
                    font-size: 16px;
                }


                .list-module ul li i {
                    display: flex;
                    width: 42px;
                    height: 42px;
                    border-radius: 12px;
                    align-items: center;
                    justify-content: center;
                }

                .list-module ul li span {
                    font-size: 14px;
                    padding: 0px 8px;
                    border-radius: 106px;
                    color: #fff;
                }

    .grn i {
        background: rgba(234, 249, 242, 1);
        color: rgba(49, 196, 127, 1);
    }

    .adlt i {
        background: rgba(160, 95, 24, 0.22);
        color: rgba(160, 95, 24, 1);
    }

    .complt i {
        background: rgba(252, 255, 212, 1);
        color: rgba(197, 211, 6, 1);
    }

    .mpacstarget i {
        background: rgba(255, 212, 212, 1);
        color: rgba(211, 6, 6, 1);
    }

    .grn span {
        background: rgba(49, 196, 127, 1);
    }

    .adlt span {
        background: rgba(160, 95, 24, 1);
    }

    .complt span {
        background: rgba(197, 211, 6, 1);
    }

    .mpacstarget span {
        background: rgba(211, 6, 6, 1);
    }

    img {
        max-width: 100%;
    }

    .data-table-list {
        border-collapse: collapse;
        width: 100%;
    }

        .data-table-list thead {
            position: sticky;
            top: 0;
        }

            .data-table-list thead tr {
                background: rgba(33, 200, 186, 1);
            }

                .data-table-list thead tr th {
                    color: #fff;
                    padding: 6px;
                }

        .data-table-list td {
            padding: 14px 6px;
            box-shadow: 0px -1px 0px 0px rgba(17, 17, 17, 0.08) inset;
            /*white-space: nowrap;*/
        }

    .rtio-mange {
        display: flex;
        gap: 10px;
        font-size: 16px;
        align-items: center;
        justify-content: space-between;
    }

        .rtio-mange h1 {
            font-size: 24px;
            font-weight: 600;
            margin: 0;
            text-align: center;
        }

            .rtio-mange h1 span {
                display: block;
                color: rgba(33, 200, 186, 1);
                font-size: 12px;
                font-weight: 500;
                margin-top: 4px;
            }

        .rtio-mange h2 {
            font-size: 20px;
            font-weight: 700;
        }

        .rtio-mange p {
            font-size: 14px;
            margin-top: 4px;
            color: #646464;
        }

    zingchart > div, zingchart > div > div, zingchart svg {
        width: 100% !important;
    }

    .datatableContnr {
        max-height: 232px;
        height: 100%;
        min-height: 232px;
        overflow: auto;
    }

    .act-container {
        background-color: #dbe9e7;
        padding: 8px 10px;
        border-radius: 10px;
        display: inline-flex;
        gap: 10px;
    }

    .act-btn {
        padding: 6px 14px;
        border-radius: 8px;
        background-color: #ffffff;
        color: #0f766e;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .active-act {
        background-color: #0f6d66;
        color: #ffffff;
    }

    .act-btn:hover {
        background-color: #0f6d66;
        color: #fff;
    }

    .whit-txt-man th {
        white-space: nowrap;
    }

    .collection .collection-item {
        padding: 12px 6px;
    }

    span.badge2.new {
        font-weight: 500;
        font-size: 14px;
        color: #000000;
        background-color: transparent;
        /* border-radius: 2px; */
        padding: 0;
        line-height: normal;
    }

    .card [class*=card-header-]:not(.card-header-icon):not(.card-header-text):not(.card-header-image) {
        border-radius: 3px;
        margin-top: -41px !important;
        padding: 10px;
        font-size: 16px;
        background: linear-gradient(90deg, #21CAB9 0%, #3C8DDC 100%);
        color: #fff;
        margin: 0;
        padding: 12px;
    }

    .card.last-crdt-h {
        height: 560px;
    }


    ::-webkit-scrollbar-track {
    }

    ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    ::-webkit-scrollbar-thumb {
    }
</style>

