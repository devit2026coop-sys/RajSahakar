<style type="text/css">
    .cont-m1 {
        background-color: transparent;
        height: 275px;
        perspective: 1000px;
    }

    .collection {
        overflow: auto;
    }
    /* span.badge2{
        float:left;
    }*/


    #card {
        width: 100%;
        height: 100%;
        position: absolute;
        transform-style: preserve-3d;
        transition: transform 1s;
        color: white;
    }

        #card figure {
            margin: 0;
            display: block;
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            z-index: 999;
        }

        #card .back {
            transform: rotateY( 180deg);
        }

        #card.flipped {
            transform: rotateY( 180deg);
        }

    .line-clamp-1 {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
    }


    .text-td-left td span {
        text-align: left;
        float: none;
    }

    .main-tbs-dashbord {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .main-tbs-dashbord ul.nav.nav-tabs li a {
            font-size: 18px;
            font-weight: 700;
            color: #000;
            padding: 12px 32px;
            transition: 0.3s;
            border: 0;
        }

            .main-tbs-dashbord ul.nav.nav-tabs li a:focus {
                outline: 0 !important;
                outline-offset: 0 !important;
            }

            .main-tbs-dashbord ul.nav.nav-tabs li a:hover {
                font-size: 18px;
                font-weight: 700;
                color: #000;
                padding: 12px 32px;
                border: 0;
            }

        .main-tbs-dashbord ul.nav.nav-tabs li.active a, .main-tbs-dashbord ul.nav.nav-tabs li.active a:hover {
            background: linear-gradient(90deg, #21CAB9 0%, #3C8DDC 100%);
            color: #fff;
            margin: 0;
            border: 0;
            border-radius: 7px;
        }

        .main-tbs-dashbord ul.nav.nav-tabs {
            border: 0;
        }

    ul.act-label {
        padding: 0;
        list-style: none;
        display: flex;
        font-size: 12px;
        justify-content: space-between;
        font-weight: 600;
        margin: 5px 0 0;
    }

        ul.act-label li {
            font-size: 12px;
            display: flex;
            align-items: start;
            /* justify-content: space-between; */
            color: #fff;
            flex-direction: column;
        }

            ul.act-label li:last-child {
                border: 0;
            }

    .card.d-block {
        display: block;
    }

    .data-col {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .value-cnt {
        /*margin-left: 5px;*/
        color: #fff !important;
        font-size: 13px;
    }

    @@media screen and (max-width: 1500px) {
        ul.act-label li, ul.act-label li {
            display: block;
            text-align: center;
        }

        .colum-value-dashboard .card {
            height: 146px;
        }
    }
</style>
<script>
    window.onload = function () {
    }
    function formatNumber(num) {
        Globalize.culture('en-IN');
        if (isNaN(num))
            return ('Number not valid');
        return (Globalize.format(parseInt(num), "n2"));
    }



</script>

<div ng-app="DashboardMod" ng-controller="DashboardCtrl" ng-cloak="">
    <div class="container-fluid">
        <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
        <input type="hidden" id="hdnDivisionId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DivisionId)" />
        <input type="hidden" id="hdnActId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).ActId)" />
        <input type="hidden" id="hdnLevel" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />
        <input type="hidden" id="hdnUserRoleDeptMappingId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserRoleDeptMappingId)" />
        <div class="card-outer">
            <div class="main-tbs-dashbord">
                <ul class="nav nav-tabs">
                    <li class="active"><a data-toggle="tab" ng-click="switchTab(1)">State Level Dashboard</a></li>
                    <li><a data-toggle="tab" ng-click="switchTab(2)"> My Dashboard</a></li>
                </ul>
                <div class=" ">
                    <select class="form-control" style="width:115px; display:inline-block;" ng-model="searchRequest.CurrentFinYear" ng-change="OnChangeFilterData()">
                        <option value="0">{{translation.All}}</option>
                        <option value="{{FinYear.FinYearId}}" ng-repeat="FinYear in FinancialYearList">{{FinYear.FinYearName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="colum-value-dashboard">
            <div class="row">
                <div class="col-lg-3 col-md-6">
                    <div class="card d-block">
                        <div class="data-col">
                            <h2>
                                <small>REGISTERED SOCIETIES <span>(Online)</span></small>{{dashboardData.TotalSocietyOnline | number}}
                            </h2>
                            @*<a ng-attr-href="{{searchRequest.tabType == '2' ? '../mis/SocietyRegisterDistWise?FinYear=' + searchRequest.CurrentFinYear : 'javascript:void(0)'}}" ng-attr-target="{{searchRequest.tabType == '2' ? '_blank' : undefined}}">
                                <img src="~/Content/Images/dashboard-icons/society-icon.png" />
                            </a>*@
                        </div>
                        <ul class="act-label">
                            <li ng-repeat="act in FilterActDataOnline track by $index">
                                <span> {{act.ActName}} :- </span>
                                <span class="value-cnt">({{act.ActNo | number}})</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="card d-block">
                        <div class="data-col">
                            <h2>
                                <small>REGISTERED SOCIETIES <span>(Offline)</span></small>{{dashboardData.TotalSocietyOffline | number}}
                            </h2>
                            @*<a ng-attr-href="{{searchRequest.tabType == '2' ? '../mis/SocietyRegisterDistWise?FinYear=' + searchRequest.CurrentFinYear : 'javascript:void(0)'}}" ng-attr-target="{{searchRequest.tabType == '2' ? '_blank' : undefined}}">
                                <img src="~/Content/Images/dashboard-icons/society-icon.png" />
                            </a>*@
                        </div>
                        <ul class="act-label">
                            <li ng-repeat="act in FilterActDataOffline track by $index">
                                <span> {{act.ActName}} :- </span>
                                <span class="value-cnt">({{act.ActNo | number}})</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4">
                    <div class="card">
                        <h2> <small>AUDIT UPLOADED</small> {{dashboardData.TotalAuditor | number}}</h2>
                        @*<a ng-attr-href="{{searchRequest.tabType == '2' ? '../mis/SocietyListAssignedToAuditorReport?FinYear=' + searchRequest.CurrentFinYear : 'javascript:void(0)'}}" ng-attr-target="{{searchRequest.tabType == '2' ? '_blank' : undefined}}">
                            <img src="~/Content/Images/dashboard-icons/auditicon.png" />
                        </a>*@
                    </div>
                </div>

                <div class="col-lg-2 col-md-4">
                    <div class="card">
                        <h2> <small>CCS COMPLAINT </small> {{dashboardData.TotalCCSComplaints | number}}</h2>
                        @*<a ng-attr-href="{{searchRequest.tabType == '2' ? '../mis/CCSComplaintStatusReport?FinYear=' + searchRequest.CurrentFinYear : 'javascript:void(0)'}}" ng-attr-target="{{searchRequest.tabType == '2' ? '_blank' : undefined}}">
                            <img src="~/Content/Images/dashboard-icons/complaint.png" />
                        </a>*@
                    </div>
                </div>

                <div class="col-lg-2 col-md-4">
                    <div class="card">
                        <h2><small>MPACS</small> {{dashboardData.TotalMPacs | number}}</h2>
                        @*<a href="javascript:void(0)">
                            <img src="~/Content/Images/dashboard-icons/target.png" />
                        </a>*@
                    </div>
                </div>
            </div>
        </div>
        <div class="detail-users">
            <div class="row">
                <div class="col-md-4">
                    <div class="list-module">
                        <h4 class="heading-mnage">{{pendencyTitle}}</h4>
                        @*<h4 class="heading-mnage">District Level Pendency</h4>*@
                        <ul>
                            <li class="grn" ng-click="SocietyDetails('Registration')"><h4><i class="fa fa-users"></i> Society Registration</h4> <span>{{dashboardData.TotalPendencySociety | number}}</span></li>
                            <li class="adlt" ng-click="SocietyDetails('Auditor')"><h4><i class="fa fa-users"></i> Audit Appointment/Allotment </h4> <span>{{dashboardData.TotalPendencyAuditor | number}}</span></li>
                            <li class="complt" ng-click="SocietyDetails('CCSComplaint')"><h4><i class="fa fa-users"></i> CCS Complaint</h4> <span>{{dashboardData.TotalPendencyComplaint | number}}</span></li>
                            <li class="mpacstarget" ng-click="SocietyDetails('MPacsTarget')"><h4><i class="fa fa-users"></i> MPACS</h4> <span>{{dashboardData.TotalPendencyMPacs | number}}</span></li>
                        </ul>

                    </div>
                </div>
                <div class="col-md-8">
                    <div class="card" style="background:#fff;  margin:0;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                            <h4 style="margin: 0; font-weight: 700;">{{pendencyHeadingTitle}}</h4>
                        </div>
                        <div class="datatableContnr">
                            <table class="data-table-list" ng-if="SocietyDataList.columnsList && SocietyDataList.columnsList.length > 0">
                                <thead>
                                    <tr>
                                        <th style="white-space: nowrap;" ng-repeat="col in SocietyDataList.columnsList track by $index">
                                            {{col}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="row in SocietyDataList.dataList track by $index">
                                        <td ng-repeat="cell in row track by $index">
                                            <span ng-style="{ 'color': (cell == 'Registration') ? '#ff6a00' :(cell == 'Complaint') ? 'red' :(cell == 'Auditor') ? 'green' : 'black' }">
                                                {{cell}}
                                            </span>
                                        </td>
                                    </tr>
                                    <tr ng-show="SocietyDataList.isNoRecord">
                                        <td colspan="{{SocietyDataList.columnsList.length}}" style="text-align:center;">
                                            No Records
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row" ng-hide="searchRequest.tabType == 2 && searchRequest.districtId > 0">
            <div class="col-lg-12 col-md-7 col-sm-12 col-xs-12">
                <div class="card">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                        <h4 style="margin: 0; font-weight: 700;">{{translation.SocietyRegistrationSummary}}</h4>
                    </div>
                    <div class="card-body p-0" style="min-height: 293px;">
                        <div class="collection">
                            <div class="table-responsive">
                                <table class="table  table-hover table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th rowspan="2">Service</th>
                                            @*<th rowspan="2">Time Limit</th>*@
                                            <th colspan="2" class="text-center">Total Application</th>
                                            <th colspan="4" class="text-center">Time Taken (Days)</th>
                                        </tr>
                                        <tr>
                                            <th rowspan="2">Recevied</th>
                                            <th rowspan="2">Approved</th>
                                            <th>Avg.</th>
                                            <th>Median</th>
                                            <th>Min</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="li in dashboardBrapData |filter:{IsAmendment:0}">
                                            <td><span class="line-clamp-1">{{li.Act}}</span></td>
                                            @*<td><span class="new badge2">30</span></td>*@
                                            <td><span class="new badge2">{{li.NoOfApplicationReceived}}</span></td>
                                            <td><span class="new badge2">{{li.NoOfApplicationRegistered}}</span></td>
                                            <td><span class="new badge2">{{li.AvgTimeTaken}}</span></td>
                                            <td><span class="new badge2">{{li.MedianTimeTaken}}</span></td>
                                            <td><span class="new badge2">{{li.MinTimeTaken}}</span></td>
                                        </tr>
                                        <tr ng-show="(dashboardBrapData |filter:{IsAmendment:1}).length>0">
