<script src="~/Scripts/AngularFramework/FundingPosition.js"></script>

<div ng-app="FundingPositionMod">
    <div ng-controller="FundingPositionCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.FundingPosition}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.PLDB}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.FundingPosition}} </span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="citizen-dash-head">
                <form name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.FundingPositionProfile}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option> Cash & Banks</option>
                            </select>
                        </div>
                        
                        <div class="col-lg-6">
                            <label class="help-block-gender">
                                <input type="radio">{{translation.FinalPosteBal}}
                            </label>
                            <label class="help-block-gender">
                                <input type="radio">{{translation.TentativeUnpostBal}}
                            </label>
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.FundingPositiDate}}</div>
                        <div class="col-lg-4">
                            <input type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary">{{translation.Print}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Close}}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

