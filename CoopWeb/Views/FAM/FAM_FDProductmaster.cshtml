@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; ;
}
<script src="~/Scripts/AngularFramework/FAM_FDProductmaster.js"></script>

<style>
    /* Style the tab */
    .tab {
        overflow: hidden;
        border: unset;
        background-color: #f1f1f1;
        border-radius: 11px;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
                border-radius: 11px;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #1899a0;
                border-radius: 11px;
            }

    .dishide {
        display: none !important;
    }

    .disshow {
        display: block !important;
    }

    .stpclick{
        pointer-events:none;
    }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 50px 12px;
        /*border: 1px solid #ccc;*/
        border: none !important;
    }

    .arrow-down:after, .arrow-up:after {
        content: ' ';
        position: relative;
        left: 2px;
        border: 8px solid transparent;
    }

    .arrow-down:after {
        top: 0px;
        border-top-color: #337ab7;
    }

    .arrow-up:after {
        bottom: 26px;
        border-bottom-color: #337ab7;
    }

    .arrow-down, .arrow-up {
        padding-top: 10px;
        float:right;
        color:#fff;
    }

</style>

<div ng-app="FAM_FDProductmasterModule">
    <div ng-controller="FAM_FDProductmasterCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.FAMFDProductMaster}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.FAMFDProductMaster}}</span>
                    </li>
                    <li style="float: right">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" ng-click="Openform()"> <h5>&#187; Add {{translation.FAMFDProductMaster}}</h5> </button>
                    </li>
                </ul>
            </div>
        </div>



        <div class="col-lg-12" ng-show="ShowForm">
            <div class="citizen-dash-head">
                <div class="table-dropdown" ng-show="Showgride">
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2" style="font-weight: 600 !important;">{{translation.FixDiposittype}}</div>
                        <div class="col-lg-4">
                            <input type="text" name="Affiliation" id="txtfAffiliationDate" ng-init="FAM_OffilineVoucherPosting.EndDate=''" style="display:inline; margin-top: 0px;" class="form-control" ng-change="CaseRegDetailList()" placeholder="{{translation.Affiliation}}" ng-model="FDProductMaster.DateOfAffiliation" autocomplete="off" /> &nbsp;
                        </div>
                        <div class="col-lg-2" style="font-weight: 600 !important;">{{translation.CategoryName}}</div>
                        <div class="col-lg-4">
                            <select ng-model="MemberRegistration.PLDB_ID" ng-disabled="IsSubmiApplication" id="ddlDistrict" class="form-control" ng-init="MemberRegistration.PLDB_ID='0'" ng-change="PLDBBranchList('0')">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="itemPLDB in PLDB | orderBy:'PldbId'" value="{{itemPLDB.PldbId}}">
                                    {{itemPLDB.PLDBName}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2" style="font-weight: 600 !important;">{{translation.FixDepositName}}</div>
                        <div class="col-lg-4">
                            <input type="text" name="Affiliation" id="txtfAffiliationDate" ng-init="FAM_OffilineVoucherPosting.EndDate=''" style="display:inline; margin-top: 0px;" class="form-control" ng-change="" placeholder="{{translation.Affiliation}}" ng-model="FDProductMaster.DateOfAffiliation" autocomplete="off" /> &nbsp;
                        </div>
                        <div class="col-lg-2" style="font-weight: 600 !important;">{{translation.IsFixedDepositClose}}</div>
                        <div class="col-lg-4">
                            <input type="checkbox" name="Affiliation" id="txtfAffiliationDate" class="form-control" placeholder="{{translation.Affiliation}}" ng-model="FDProductMaster.DateOfAffiliation" autocomplete="off" /> &nbsp;
                        </div>

                    </div>
                    <div class="form-group col-md-12">
                        <div class="dev-align-btn">
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="#">{{translation.OnlySave}}</a>
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="#"> {{translation.Cencel}}</a>
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="closeform()"> {{translation.Close}}</a>
                        </div>
                    </div>

                    <div class="col-md-10">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="statePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="1000" class="form-control" ng-model="pageSize">
                        </div>
                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>                              
                                
                                <th ng-click="sortData('MenuUrl')">
                                    {{translation.MenuUrl}}
                                    <div ng-class="getSortClass('MenuUrl')"></div>
                                </th>

                                <th ng-click="sortData('MenuIcon')">
                                    {{translation.MenuIcon}}
                                    <div ng-class="getSortClass('MenuIcon')"></div>
                                </th>

                                <th ng-click="sortData('IsActive')">
                                    {{translation.Status}}
                                    <div ng-class="getSortClass('IsActive')"></div>
                                </th>
                                <th>{{translation.Edit}}</th>
                                <th>{{translation.Delete}}</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr dir-paginate="Menu in AllMenus | filter: q | orderBy:colsort:reverseSort  | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>

                                <td>{{ Menu.Level1En | uppercase }}</td>
                                <td>{{ Menu.Level2En | uppercase }}</td>
                                <td>{{ Menu.Level3En | uppercase }}</td>
                                <td>{{ Menu.MenuUrl | uppercase }}</td>
                                <td>{{ Menu.MenuIcon | uppercase }}</td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Menu.IsActive == 1" ng-click="SetStatus(Menu.MenuId,Menu.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Menu.MenuId)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(Menu.MenuId,2)"></i>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="MenuPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>



    </div>
</div>


