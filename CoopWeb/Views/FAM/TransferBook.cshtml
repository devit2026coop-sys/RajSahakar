<script src="~/Scripts/AngularFramework/TransferBook.js"></script>
<div ng-app="TransferBookMod">
    <div ng-controller="TransferBookCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.TransferBook}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.PLDB}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.TransferBook}} </span>

                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="citizen-dash-head">
                <form name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.TransferBookDate}}</div>
                        <div class="col-lg-4">
                            <input class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary">{{translation.Generate}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Cancle}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Close}}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="citizen-dash-head">
                <form style="overflow: hidden; margin-bottom:35px;">
                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.TransferBookFromDate}}</div>
                        <div class="col-lg-4">
                            <input class="form-control" type="date" />
                        </div>
                        <div class="col-lg-2">{{translation.TransferBookToDate}}</div>
                        <div class="col-lg-4">
                            <input class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary">{{translation.Generate}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Cancle}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Close}}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
