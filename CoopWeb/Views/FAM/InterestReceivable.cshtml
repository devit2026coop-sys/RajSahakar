                <div class="col-lg-12 form-group">
                    <div class="col-lg-4">

                    </div>
                    <div class="col-lg-1">
                        {{translation.Date}}
                    </div>
                    <div class="col-lg-3">
                        <input id="Date" name="Date" class="form-control devcalender" placeholder={{translation.Date}} autocomplete="off">
                    </div>
                    <div class="col-lg-4">

                    </div>
                </div>
                <div class="table-responsive citizen-dash-head">
                    <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SEQNO}}
                                </th>
                                <th>
                                    {{translation.INVESTMENT}}
                                </th>
                                <th>
                                    {{translation.INSTITUTE}}
                                </th>
                                <th>
                                    {{translation.AMOUNT}}
                                </th>
                                <th>
                                    {{translation.DEPOSITEDATE}}
                                </th>
                                <th>
                                    {{translation.RATEOFINTEREST}}
                                </th>
                                <th>
                                    {{translation.PERIOD}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr @*dir-paginate="item in LoanSchemeList | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="ElectionSymbolsPagination"*@>
                                
                                <td>
                                    @*{{item.scheme_name_hi}}*@ Test
                                </td>
                                <td>
                                    @*{{item.scheme_name_hi}}*@  Test
                                </td>
                                <td>
                                    @*{{item.scheme_name_hi}}*@ Test
                                </td>
                                <td>
                                    @*{{item.scheme_name_hi}}*@  Test
                                </td>
                                <td>
                                    @*{{item.scheme_name_hi}}*@  Test
                                </td>
                                <td>
                                    @*{{item.scheme_name_hi}}*@  Test
                                </td>
                                <td>
                                    @*{{item.scheme_name_hi}}*@  Test
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-12">
                    <div class="text-left">
                        <dir-pagination-controls boundary-links="true" pagination-id="ElectionSymbolsPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">

                    </div>
                    <div class="col-lg-1">
                        {{translation.InterestBalance}}
                    </div>
                    <div class="col-lg-3">
                        <input type="text" id="InterestBalance" name="InterestBalance" class="form-control" placeholder={{translation.InterestBalance}} autocomplete="off">
                    </div>
                    <div class="col-lg-1">
                        {{translation.ChequeNo}}
                    </div>
                    <div class="col-lg-3">
                        <input type="text" id="ChequeNo" name="ChequeNo" class="form-control" placeholder={{translation.ChequeNo}} autocomplete="off">
                    </div>
                    <div class="col-lg-2">

                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">

                    </div>
                    <div class="col-lg-1">
                        {{translation.PaidBalance}}
                    </div>
                    <div class="col-lg-3">
                        <input type="text" id="PaidBalance" name="PaidBalance" class="form-control" placeholder={{translation.PaidBalance}} autocomplete="off">
