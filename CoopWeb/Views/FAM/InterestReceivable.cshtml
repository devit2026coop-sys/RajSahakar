<script src="~/Scripts/AngularFramework/PLDBLoanMasters.js?id=3"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('.devcalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            // minDate: '0'
            yearRange: "c-10:c+0"
        });
    });
</script>


<div ng-app="PLDBLoanMastersMOD">
    <div ng-controller="PLDBLoanMastersCONT">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.InterestReceivable}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-md-12">

        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.InterestReceivable}} </span>
                    </li>
                </ul>
            </div>

        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <form class="citizen-dash-head">
