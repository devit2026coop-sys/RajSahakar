                    <div class="col-lg-4">
                        <input type="text" id="CostPrice" name="CostPrice" class="form-control" placeholder={{translation.CostPrice}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.RateOfPurchase}}</div>
                    <div class="col-lg-4">
                        <input type="text" id="RateOfPurchase" name="RateOfPurchase" class="form-control" placeholder={{translation.RateOfPurchase}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.RateOfInterest}}</div>
                    <div class="col-lg-4">
                        <input type="text" id="RateOfInterest" name="RateOfInterest" class="form-control" placeholder={{translation.RateOfInterest}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Frequency}}</div>
                    <div class="col-lg-4">
                        <input type="text" id="Frequency" name="Frequency" class="form-control" placeholder={{translation.Frequency}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.MaturityDate}}</div>
                    <div class="col-lg-4">

                        <input id="MaturityDate" name="MaturityDate" class="form-control devcalender" placeholder={{translation.MaturityDate}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2"></div>
                    <div class="col-lg-4">
                        <input type="checkbox" id="InvestmentClose" name="InvestmentClose" value="InvestmentClose"> &nbsp;{{translation.InvestmentClose}}
                    </div>
                </div>
                <div class="col-lg-12 form-group" style="margin-top: 10px;">
                    <div class="col-lg-2"></div>
                    <div class="col-lg-4">
                        <div class="dev-menu-btn" style="text-align:left">
                            <button type="submit" class="btn btn-primary">{{translation.Submit}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Clear}}</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

    </div>

    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
