<script src="~/Scripts/AngularFramework/PLDBLoanMasters.js?id=3"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('.devcalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            // minDate: '0'
            yearRange: "c-10:c+0"
        });
    });
</script>


<div ng-app="PLDBLoanMastersMOD">
    <div ng-controller="PLDBLoanMastersCONT">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.InvestmentBond}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-md-12">

        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.InvestmentBond}} </span>
                    </li>
                </ul>
            </div>

        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <form class="citizen-dash-head">
                <input type="hidden" value="Scheme" id="MasterType" />
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2"></div>
                    <div class="col-lg-2">

                        <input type="radio" id="bondtype" name="bondtype" value="BondPurchase">
                        <label>
                            {{translation.BondPurchase}}
                        </label>
                    </div>
                    <div class="col-lg-2">

                        <input type="radio" id="bondtype" name="bondtype" value="BondMaturity">
                        <label>
                            {{translation.BondMaturity}}
                        </label>

                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <fieldset>
                        <legend>{{translation.BondDetail}}</legend>
                    </fieldset>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.InvestmentID}}</div>
                    <div class="col-lg-4">
                        <input type="text" id="InvestmentID" name="InvestmentID" class="form-control" placeholder={{translation.InvestmentID}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.InvestmentType}}</div>
                    <div class="col-lg-4">
                        <select class="form-control">
                            <option value="0">{{translation.SelectOption}}</option>
                            @*<option ng-repeat="itm in LoanSectorList" value="{{itm.sector_id}}" ng-if="itm.IsShow">
                                    {{_language =='en-us' ?  itm.sector_name_en : itm.sector_name_hi}}
                                </option>*@
                            <option value="1">InvestmentType</option>
                            <option value="2">InvestmentType</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.NatureInvestment}}</div>
                    <div class="col-lg-4">
                        <select class="form-control">
                            <option value="0">{{translation.SelectOption}}</option>
                            @*<option ng-repeat="itm in LoanSectorList" value="{{itm.sector_id}}" ng-if="itm.IsShow">
                                    {{_language =='en-us' ?  itm.sector_name_en : itm.sector_name_hi}}
                                </option>*@
                            <option value="1">NatureInvestment</option>
                            <option value="2">NatureInvestment1</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <fieldset>
                        <legend>{{translation.BondPurchase}}</legend>
                    </fieldset>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.BondName}}</div>
                    <div class="col-lg-4">
                        <input type="text" id="BondName" name="BondName" class="form-control" placeholder={{translation.BondName}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.PurchaseDate}}</div>
                    <div class="col-lg-4">

                        <input id="PurchaseDate" name="PurchaseDate" class="form-control devcalender" placeholder={{translation.PurchaseDate}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.FaceValue}}</div>
                    <div class="col-lg-2">
                        <input type="text" id="FaceValue" name="FaceValue" class="form-control" placeholder={{translation.FaceValue}} autocomplete="off">
                    </div>
                    <div class="col-lg-1">{{ translation.NoofBond}}</div>
                    <div class="col-lg-1">
                        <input type="text" id="NoofBond" name="NoofBond" class="form-control" placeholder={{translation.NoofBond}} autocomplete="off">
                    </div>
                </div>
