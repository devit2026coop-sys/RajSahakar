@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; 
}
<script src="~/Scripts/AngularFramework/DigitalRegister.js"></script>


<div ng-app="DigitalRegisterMod" ng-controller="DigitalRegisterCnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.InstitutionDetail}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.InstitutionDetail}}   </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <fieldset>
                <legend>{{translation.InstitutionDetail}}</legend>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.InsType}} :</label>
                        <div class="form-group">
                            <select class="form-control">
                                <option>{{translation.SelectOption}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.InstitutionID}} :</label>
                        <input id="txtInstitutionID" class="form-control" type="text" name="InstitutionID" value="{{translation.InstitutionID}}" />
                    </div>
                </div>
                

                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.InstitutionNarration}} : </label>
                        <input id="txtInstitutionNarration" class="form-control" type="text" name="InstitutionNarration" value="{{translation.InstitutionNarration}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.BranchCode}} : </label>
                        <input id="txtBranchCode" class="form-control" type="text" name="BranchCode" value="{{translation.BranchCode}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.Address1}} : </label>
                        <input id="txtAddress1" class="form-control" type="text" name="Address1" value="{{translation.Address1}}" />
                    </div>
                    <div class="col-md-6">
                            <label class="ng-binding">{{translation.Address2}} : </label>
                            <input id="txtAddress2" class="form-control" type="text" readonly="readonly" name="Address2" value="{{translation.Address2}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.Address3}} :</label>
                        <input id="txtAddress3" class="form-control" type="text" name="Address3" value="{{translation.Address3}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.City}} :</label>
                        <input id="txtCity" class="form-control" type="text" name="City" value="{{translation.City}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.State}} :</label>
                        <input id="txtState" class="form-control" type="text" name="MaturityAmount" value="{{translation.State}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.StdCode}} :</label>
                        <input id="txtStdCode" class="form-control" type="text" name="StdCode" value="{{translation.StdCode}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.PhoneNo}} :</label>
                        <input id="txtPhoneNo" name="PhoneNo" class="form-control" placeholder="{{translation.PhoneNo}}" />
                    </div>
                        <div class="col-md-6">
                            <label class="ng-binding">{{translation.FaxNo}} :</label>
                            <input id="txtFaxNo" name="FaxNo" class="form-control" placeholder="{{translation.FaxNo}}" />                          
                        </div>                                     
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.EmailId}} :</label>
                        <input id="txtEmailId" name="EmailId" class="form-control" placeholder="{{translation.EmailId}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.Remark}} :</label>
                        <input id="txtRemark" class="form-control" type="text" name="Remark" value="{{translation.Remark}}" />
                    </div>
                </div>              
                <div class="table-dropdown">
                    <div class="col-md-12">
                        <div class="table-dropdown">
                            <div class="col-md-7">

                            </div>
                            <div class="col-md-1">
                                <br /><br /><br /><br />
                                <input id="btn btnSave" name="save" value="{{translation.Saved}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <br /><br /><br /><br />
                                <input id="btnCancel" name="Cancel" value="{{translation.Cancel}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <br /><br /><br /><br />
                                <input id="btnCloase" name="Close" value="{{translation.Close}}" class="btn btn-primary form-control" type="button">
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>


</div>