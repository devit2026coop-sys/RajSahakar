    <script>
        function openCity(evt, cityName, flag) {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");

            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }


            document.getElementById(cityName).style.display = "block";

            evt.currentTarget.className = "tablinks active";

            if (flag == true) {
                if (cityName == 'OICDetail') {
                    $("#OIC").removeClass("tablinks ng-binding");
                    $("#OIC").addClass("tablinks ng-binding active");
                }

                if (cityName == 'Advocate') {
                    $("#iddAdvocate").removeClass("tablinks ng-binding");
                    $("#iddAdvocate").addClass("tablinks ng-binding active");
                }

                if (cityName == 'Responed') {
                    $("#iddResponed").removeClass("tablinks ng-binding");
                    $("#iddResponed").addClass("tablinks ng-binding active");
                }

                if (cityName == 'Appellant') {
                    $("#iddapplant").removeClass("tablinks ng-binding");
                    $("#iddapplant").addClass("tablinks ng-binding active");
                }

                if (cityName == 'Enclouser') {
                    $("#defaultOpen").removeClass("tablinks ng-binding");
                    $("#defaultOpen").addClass("tablinks ng-binding active");
                }
            }
        }



    </script>

