<style>
    /* Style the tab */
    .tab {
        overflow: hidden;
        border: unset;
        background-color: #f1f1f1;
        border-radius: 11px;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
                border-radius: 11px;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #1899a0;
                border-radius: 11px;
            }

    .dishide {
        display: none !important;
    }

    .disshow {
        display: block !important;
    }

    .stpclick {
        pointer-events: none;
    }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 50px 12px;
        /*border: 1px solid #ccc;*/
        border: none !important;
    }

    .arrow-down:after, .arrow-up:after {
        content: ' ';
        position: relative;
        left: 2px;
        border: 8px solid transparent;
    }

    .arrow-down:after {
        top: 0px;
        border-top-color: #337ab7;
    }

    .arrow-up:after {
        bottom: 26px;
        border-bottom-color: #337ab7;
    }

    .arrow-down, .arrow-up {
        padding-top: 10px;
        float: right;
        color: #fff;
    }
</style>

