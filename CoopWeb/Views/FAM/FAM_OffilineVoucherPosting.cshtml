@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; ;
}
<script src="~/Scripts/AngularFramework/FAM_OffilineVoucherPosting.js"></script>

<style>
    /* Style the tab */
    .tab {
        overflow: hidden;
        border: unset;
        background-color: #f1f1f1;
        border-radius: 11px;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
                border-radius: 11px;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #1899a0;
                border-radius: 11px;
            }

    .dishide {
        display: none !important;
    }

    .disshow {
        display: block !important;
    }

    .stpclick{
        pointer-events:none;
    }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 50px 12px;
        /*border: 1px solid #ccc;*/
        border: none !important;
    }

    .arrow-down:after, .arrow-up:after {
        content: ' ';
        position: relative;
        left: 2px;
        border: 8px solid transparent;
    }

    .arrow-down:after {
        top: 0px;
        border-top-color: #337ab7;
    }

    .arrow-up:after {
        bottom: 26px;
        border-bottom-color: #337ab7;
    }

    .arrow-down, .arrow-up {
        padding-top: 10px;
        float:right;
        color:#fff;
    }

</style>

<div ng-app="FAM_OffilineVoucherPostingModule">
    <div ng-controller="FAM_OffilineVoucherPostingCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.OffilineVoucherPosting}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.OffilineVoucherPosting}}</span>

                    </li>
                    <li style="float: right">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" ng-click="Openform()"> <h5>&#187; Add {{translation.OffilineVoucherPosting}}</h5> </button>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-12" ng-show="ShowForm">
            <div class="citizen-dash-head">
                <div class="table-dropdown" ng-show="Showgride">
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2" style="font-weight: 600 !important;">{{translation.SelectDate}}</div>
                        <div class="col-lg-4">
                            <input type="date" name="Affiliation" id="txtfAffiliationDate" ng-init="FAM_OffilineVoucherPosting.EndDate=''" style="display:inline; margin-top: 0px;" class="form-control" ng-change="CaseRegDetailList()" placeholder="{{translation.Affiliation}}" ng-model="CaseRegistration.DateOfAffiliation" autocomplete="off" /> &nbsp;
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="dev-align-btn">
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="#">{{translation.PostVouchers}}</a>
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="closeform()"> {{translation.Close}}</a>
                        </div>
                    </div>
                    <div class="col-md-10">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="statePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <table class="table table-responsive devtable citizen-dash-head" ng-show="Showtabl">
            <thead>
                <tr>
                    <th>
                        {{translation.SRNO}}
                    </th>
                    <th>
                        {{translation.Court}}
                        <div class="arrow-up" ng-click="sortData('Court')"></div>
                        <div class="arrow-down" ng-click="sortData('Court')"></div>
                        <div ng-class="getSortClass('Court')"></div>
                    </th>
                    <th>
                        {{translation.Act}}
                        <div class="arrow-up" ng-click="sortData('Act')"></div>
                        <div class="arrow-down" ng-click="sortData('Act')"></div>
                        <div ng-class="getSortClass('Act')"></div>
                    </th>
                    <th ng-click="sortData('TypeOfCase')">
                        {{translation.TypeOfCase}}
                        <div ng-class="getSortClass('TypeOfCase')"></div>
                    </th>
                    <th ng-click="sortData('DateOfAffiliation')">
                        {{translation.DateOfAffiliation}}
                        <div ng-class="getSortClass('DateOfAffiliation')"></div>
                    </th>
                    <th ng-click="sortData('CaseRegistraionNo')">
                        {{translation.CaseRegistraionNo}}
                        <div ng-class="getSortClass('CaseRegistraionNo')"></div>
                    </th>
                    <th>
                        {{translation.Status}}
                    </th>
                    <th>
                        {{translation.TakeAction}}
                    </th>

                </tr>
            </thead>

            <tbody>
                <tr dir-paginate="items in CaseRegDetailListData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="statePagination">
                    <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                    <td>{{ items.courtname }}</td>
                    <td>{{ items.Act}}</td>
                    <td>{{ items.Casetype}}</td>
                    <td>{{ items.AffilationDate}}</td>
                    <td>{{ items.CaseRegNo}}</td>
                    <td>{{ items.CaseStatus}}</td>
                    <td>
                        <a title="VIEW CASE" style="cursor:pointer;" ng-click="CaseApplicationView(items.ID)"><i class="fa fa-eye"></i></a>
                        <a title="UPDATE CASE" style="cursor:pointer;" ng-show="(items.EnclouserCount == '0' || items.AppllantCount == '0' || items.ResponedCount == '0' || items.AdvocateCount == '0'  || items.OICCount == '0') ? true : false" ng-click="update(items)"><i class="fa fa-edit"></i></a>
                        <a title="SUBMIT" style="cursor:pointer;" ng-show="(items.CaseRegNo == '' && items.EnclouserCount != '0' && items.AppllantCount != '0' && items.ResponedCount != '0' && items.AdvocateCount != '0'  && items.OICCount != '0') ? true : false" ng-click="GetCaseDetails(items.ID)"><i class="fa fa-arrow-right"></i></a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


