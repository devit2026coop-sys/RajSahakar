<script src="~/Scripts/AngularFramework/TrialBalance.js"></script>
<div ng-app="TrialBalanceMod">
    <div ng-controller="TrialBalanceCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.TrialBalance}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.PLDB}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.TrialBalance}} </span>

                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="citizen-dash-head">
                <form name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.TrialBalanceDate}}</div>
                        <div class="col-lg-4">
                            <input class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary">{{translation.TrialBalance}}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="citizen-dash-head">
                <form name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.TrialBalanceAcType}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> All </option>
                                <option>  </option>
                            </select>
                        </div>
                        <div class="col-lg-2">{{translation.TrialBalanceZeroType}}</div>
                        <div class="col-lg-4">
                            <input class="form-check-input" type="checkbox" />
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary">{{translation.TrialBalance}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.TBwithLayer}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Close}}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

