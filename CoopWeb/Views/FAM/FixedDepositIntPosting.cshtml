@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; 
}
<script src="~/Scripts/AngularFramework/DigitalRegister.js"></script>


<div ng-app="DigitalRegisterMod" ng-controller="DigitalRegisterCnt">

    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.FixedDepIntPost}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">

                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.FixedDepIntPost}}   </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <fieldset>
                <legend>{{translation.FixedDepIntPostToLedger}}</legend>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <div class="col-md-6">
                            <br />
                            <div class="custom-control custom-radio">
                                <input type="radio" class="custom-control-input" id="rdbtnProcessAll" name="rdbtnOpType">
                                <label class="custom-control-label">{{translation.ProcessAll}}</label>
                            </div>
                            </div>
                        <div class="col-md-6">
                            <br />
                            <div class="custom-control custom-radio">
                                <input type="radio" class="custom-control-input" id="rdbtnProcessAll" name="rdbtnOpType" checked>
                                <label class="custom-control-label">{{translation.ParticularRecord}}</label>
                            </div>
                        </div>
                        </div>
                    <div class="col-md-6">
                        <label for="search" class="ng-binding"> {{translation.HolderName}} : </label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.ReceiptNumber}}:</label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.IntPostLedgerUpToDate}} </label>
                        <br />
                        <label for="search" class="ng-binding"> __________________ </label>
                    </div>                 
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.IntPostLedgerInDate}}:</label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="col-md-3">
                            <br />
                            <input id="btn btnSave" name="save" value="{{translation.Post}}" class="btn btn-primary form-control" type="button" style="width:70%;">
                        </div>
                        <div class="col-md-6">
                            <br />
                            <input id="btnCloase" name="Close" value="{{translation.Close}}" class="btn btn-primary form-control" type="button"  style="width:40%;">
                        </div>
                    </div>
                </div>

                
            </fieldset>
        </div>
    </div>

</div>
