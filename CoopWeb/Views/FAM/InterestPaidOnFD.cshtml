@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; 
}
<script src="~/Scripts/AngularFramework/DigitalRegister.js"></script>


<div ng-app="DigitalRegisterMod" ng-controller="DigitalRegisterCnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.IntPaidOnFD}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">

                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.IntPaidOnFD}}   </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <fieldset>
                <legend>{{translation.IntPaidOnFD}}</legend>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.PaymentDate}} :</label>
                        <div class="form-group">
                            <input id="txtPaymentDate" name="PaymentDate" class="form-control SetCalender" placeholder="{{translation.PaymentDate}}" style="width:90%; display:inline;">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.InterestUpTo}} :</label>
                        <input id="txtInterestUpTo" name="InterestUpTo" class="form-control SetCalender" placeholder="{{translation.InterestUpTo}}" style="width:90%; display:inline;">
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.HolderName}}:</label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>                    
                    <div class="col-md-6">
                        <div class="checkbox">
                            <label><input type="checkbox" value="">{{translation.Form15GFill}}</label>
                        </div>
                    </div>                    
                </div>
                <div class="table-dropdown">
                    <div class="col-md-12">
                        <textarea rows="5" class="form-control"></textarea>                      
                    </div>                   
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.InterestBalance}} : 00.00</label>     
                    </div>    
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.TotIntToBePaid}} : </label>
                        <input id="txtTotIntToBePaid" class="form-control" type="text" name="TotIntToBePaid" value="{{translation.TotIntToBePaid}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.PaidBalance}} : </label>
                        <input id="txtPaidBalance" class="form-control" type="text" name="PaidBalance" value="{{translation.PaidBalance}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <div class="checkbox">
                            <label><input type="checkbox" value="">{{translation.CutTDS}}</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.TDSAmount}} :</label>
                        <input id="txtTDSAmount" class="form-control" type="text" name="TDSAmount" value="{{translation.TDSAmount}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.Balance}} :</label>
                        <input id="txtBalance" class="form-control" type="text" name="Balance" value="{{translation.Balance}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.PmtMode}} :</label>
                        <input id="txtTDSAmount" class="form-control" type="text" name="TDSAmount" value="{{translation.PmtMode}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.ChequeDDTrnNo}} :</label>
                        <input id="txtChequeDDTrnNo" class="form-control" type="text" name="ChequeDDTrnNo" value="{{translation.ChequeDDTrnNo}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.ChequeDDTrndate}} :</label>
                        <input id="txtChequeDDTrndate" class="form-control" type="text" name="ChequeDDTrndate" value="{{translation.ChequeDDTrndate}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.Remarks}} :</label>
                        <input id="txtRemarks" class="form-control" type="text" name="Remarks" value="{{translation.Remarks}}" />
                    </div>
                   
                </div>
                <div class="table-dropdown">
                    <div class="col-md-12">
                            <div class="table-dropdown">
                                <div class="col-md-12">
                                    <div class="table-dropdown">
                                        <div class="col-md-7">

                                        </div>
                                        <div class="col-md-1">
                                            <br /><br /><br /><br />
                                            <input id="btn btnSave" name="save" value="{{translation.Saved}}" class="btn btn-primary form-control" type="button">
                                        </div>
                                        <div class="col-md-1">
                                            <br /><br /><br /><br />
                                            <input id="btnCancel" name="Cancel" value="{{translation.Cancel}}" class="btn btn-primary form-control" type="button">
                                        </div>
                                        <div class="col-md-1">
                                            <br /><br /><br /><br />
                                            <input id="btnCloase" name="Close" value="{{translation.Close}}" class="btn btn-primary form-control" type="button">
                                        </div>
                                       
                                    </div>
                                </div>
                            </div>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>


</div>
