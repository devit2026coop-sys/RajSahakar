                                <option> Bankers PLDB</option>
                            </select>
                        </div>
                        <div class="col-lg-2">{{translation.IndiAcHead}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                            </select>
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.FundingPositiDate}}</div>
                        <div class="col-lg-4">
                            <input type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary">{{translation.SunDebCred}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Print}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Cancle}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Close}}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="citizen-dash-head">
                <form name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.AcType}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option> Bankers PLDB</option>
                            </select>
                        </div>
                        <div class="col-lg-2">{{translation.IndiAc}}</div>
                        <div class="col-lg-4">
                            <input class="form-check-input" type="checkbox" />
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.BalSheetHead}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option>  </option>
                            </select>
                        </div>
                        <div class="col-lg-2">{{translation.SchuleHead}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option>  </option>
                            </select>
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.TrialBalHead}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option>  </option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary">{{translation.Print}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.PrintWith}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Cancle}}</button>
                        </div>
                    </div>
                </form>
            </div>
