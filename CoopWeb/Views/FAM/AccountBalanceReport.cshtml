<script src="~/Scripts/AngularFramework/AccountBalanceReport.js"></script>

<div ng-app="AccountBalanceReportMod">
    <div ng-controller="AccountBalanceReportCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.AccountBalanceReport}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.PLDB}} </a>
                        <i class="fa fa-angle-right"> </i>
