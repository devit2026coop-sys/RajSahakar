@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; 
}
<script src="~/Scripts/AngularFramework/DigitalRegister.js"></script>


<div ng-app="DigitalRegisterMod" ng-controller="DigitalRegisterCnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.MaturityOfFDR}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.MaturityOfFDR}}   </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <fieldset>
                <legend>{{translation.MaturityOfFDR}}</legend>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.ReimburshmentDate}} :</label>
                        <div class="form-group">
                            <input id="txtReimburshmentDate" name="ReimburshmentDate" class="form-control SetCalender"
                                   placeholder="{{translation.ReimburshmentDate}}" style="width:90%; display:inline;" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.AccountNumber}} :</label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.ReceiptNumber}}:</label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.DueDate}}:</label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                </div>

                
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.AccumulateIntAmt}} : </label>
                        <input id="txtPaidBalance" class="form-control" type="text" name="PaidBalance" value="{{translation.AccumulateIntAmt}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.Amount}} : </label>
                        <input id="txtAmount" class="form-control" type="text" name="Amount" value="{{translation.Amount}}" />
                    </div>
                    
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.MaturityAmount}} : </label>
                        <input id="txtMaturityAmount" class="form-control" type="text" name="MaturityAmount" value="{{translation.MaturityAmount}}" />
                    </div>
                    <div class="col-md-6">
                        <br />
                        <label class="ng-binding">{{translation.TDSAmount}} : 00.00 </label>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.MaturityAmtLeftToBe}} :</label>
                        <input id="txtMaturityAmtLeftToBe" class="form-control" type="text" name="MaturityAmtLeftToBe" value="{{translation.MaturityAmtLeftToBe}}" />
                    </div>
                    <div class="col-md-6">
                        <br />
                        <label class="ng-binding">{{translation.TDSAlreadyCut}} : 00.00 </label>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.TDStoBeDeduct}} :</label>
                        <input id="txtTDStoBeDeduct" class="form-control" type="text" name="ChequeDDTrndate" value="{{translation.TDStoBeDeduct}}" />
                    </div>
                    <div class="col-md-6">
                        <br />
                        <label class="ng-binding">{{translation.intAlreadypaid}} : 00.00 </label>
                    </div>
                    
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.PaymentMode}} :</label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.ChequeDDTrnNo}} :</label>
                        <input id="txtChequeDDTrnNo" class="form-control" type="text" name="ChequeDDTrnNo" value="{{translation.ChequeDDTrnNo}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.ChequeDDTrndate}} :</label>
                        <input id="txtChequeDDTrndate" name="ChequeDDTrndate" class="form-control SetCalender" placeholder="{{translation.ChequeDDTrndate}}" style="width:94%; display:inline;" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.Remark}} :</label>
                        <input id="txtRemark" class="form-control" type="text" name="Remark" value="{{translation.Remark}}" />
                    </div> 
              </div>
                <div class="table-dropdown">
                    <div class="col-md-12">
                                <div class="table-dropdown">
                                    <div class="col-md-7">

                                    </div>
                                    <div class="col-md-1">
                                        <br /><br /><br /><br />
                                        <input id="btn btnSave" name="save" value="{{translation.Saved}}" class="btn btn-primary form-control" type="button">
                                    </div>
                                    <div class="col-md-1">
                                        <br /><br /><br /><br />
                                        <input id="btnCancel" name="Cancel" value="{{translation.Cancel}}" class="btn btn-primary form-control" type="button">
                                    </div>
                                    <div class="col-md-1">
                                        <br /><br /><br /><br />
                                        <input id="btnCloase" name="Close" value="{{translation.Close}}" class="btn btn-primary form-control" type="button">
                                    </div>

                                </div>                           
                    </div>
                </div>
            </fieldset>
        </div>
    </div>


</div>
