<script src="~/Scripts/AngularFramework/PLDBLoanMasters.js?id=3"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('.devcalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            // minDate: '0'
            yearRange: "c-10:c+0"
        });
    });
</script>
<div ng-app="PLDBLoanMastersMOD">
    <div ng-controller="PLDBLoanMastersCONT">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.ReceiptUtilisation}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-md-12">

        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.ReceiptUtilisation}} </span>
                    </li>
                </ul>
            </div>

        </div>

        
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <form class="citizen-dash-head">
                <input type="hidden" value="Scheme" id="MasterType" />
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.UtilisationDate}}</div>
                    <div class="col-lg-4">

                        <input id="UtilisationDate" name="UtilisationDate" class="form-control devcalender" placeholder={{translation.UtilisationDate}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.ReceiptType}}</div>
                    <div class="col-lg-4">
                        <select class="form-control">
                            <option value="0">{{translation.SelectOption}}</option>
                            @*<option ng-repeat="itm in LoanSectorList" value="{{itm.sector_id}}" ng-if="itm.IsShow">
                        {{_language =='en-us' ?  itm.sector_name_en : itm.sector_name_hi}}
                    </option>*@
                            <option value="1">ReceiptType</option>
                            <option value="2">ReceiptType1</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.HolderName}}</div>
                    <div class="col-lg-4">
                        <select class="form-control">
                            <option value="0">{{translation.SelectOption}}</option>
                            @*<option ng-repeat="itm in LoanSectorList" value="{{itm.sector_id}}" ng-if="itm.IsShow">
                                {{_language =='en-us' ?  itm.sector_name_en : itm.sector_name_hi}}
                            </option>*@
                            <option value="1">HolderName</option>
                            <option value="2">HolderName1</option>
                        </select>
                    </div>
                </div>
                
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.ReceiptNoFrom}}</div>
                    <div class="col-lg-4">
                        <input type="text" id="ReceiptNoFrom" name="ReceiptNoFrom" class="form-control" placeholder={{translation.ReceiptNoFrom}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.ReceiptNoTo}}</div>
                    <div class="col-lg-4">
                        <input type="text" id="ReceiptNoTo" name="ReceiptNoTo" class="form-control" placeholder={{translation.ReceiptNoTo}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.TotalNoReceiptUsed}}</div>
                    <div class="col-lg-4">
                        <input type="text" id="TotalNoReceiptUsed" name="TotalNoReceiptUsed" class="form-control" placeholder={{translation.TotalNoReceiptUsed}} autocomplete="off">
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Remarks}}</div>
                    <div class="col-lg-4">
                        <textarea name="Remarks" id="Remarks" cols="40" rows="5" class="form-control" placeholder={{translation.Remarks}} autocomplete="off"></textarea>
                    </div>
                </div>
                <div class="col-lg-12 form-group" style="margin-top: 10px;">
                    <div class="col-lg-2"></div>
                    <div class="col-lg-4">
                        <div class="dev-menu-btn" style="text-align:left">
                            <button type="submit" class="btn btn-primary">{{translation.Submit}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Clear}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.VerificaionList}}</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>