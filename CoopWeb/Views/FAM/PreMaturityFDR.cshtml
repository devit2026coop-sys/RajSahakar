                    </div>
                </div>

                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.IntRateApplicable}} : </label>
                        <input id="txtIntRateApplicable" class="form-control" type="text" name="IntRateApplicable" value="{{translation.IntRateApplicable}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.IntFrequency}} : </label>
                        <input id="txtIntFrequency" class="form-control" type="text" name="IntFrequency" value="{{translation.IntFrequency}}" />
                    </div>

                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.FDAmt}} : </label>
                        <input id="txtFDAmt" class="form-control" type="text" name="FDAmt" value="{{translation.FDAmt}}" />
                    </div>
                    <div class="col-md-6">
                        <div class="col-md-3">
                            <div class="custom-control custom-radio">
                                <input type="radio" class="custom-control-input" id="rdbtnProcessAll" name="rdbtnOpType">
                                <label class="custom-control-label">{{translation.Days}}</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="custom-control custom-radio">
                                <input type="radio" class="custom-control-input" id="rdbtnProcessAll" name="rdbtnOpType">
                                <label class="custom-control-label">{{translation.Month}}</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="ng-binding">{{translation.Durration}} : </label>
                            <input id="txtDurration" class="form-control" type="text" readonly="readonly" name="Durration" value="{{translation.Durration}}" />
                        </div>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.NewIntAmt}} :</label>
                        <input id="txtNewIntAmt" class="form-control" type="text" name="NewIntAmt" value="{{translation.NewIntAmt}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.PmtMode}} :</label>
                        <select class="form-control">
                            <option>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.MaturityAmount}} :</label>
                        <input id="txtMaturityAmount" class="form-control" type="text" name="MaturityAmount" value="{{translation.MaturityAmount}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.ChequeDDTrnNo}} :</label>
                        <input id="txtChequeDDTrnNo" class="form-control" type="text" name="ChequeDDTrnNo" value="{{translation.ChequeDDTrnNo}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <div class="col-md-10" style="padding-left:0px;">
                            <label class="ng-binding">{{translation.TDSAmount}} :</label>
                            <input id="txtTDSAmount" name="TDSAmount" class="form-control" placeholder="{{translation.TDSAmount}}" />
                        </div>
                        <div class="col-md-2">
                            <br />
                            <div class="checkbox">
                                <label for="search" class="ng-binding" style="padding-left:0px;">
                                    {{translation.CutTDS}} :  <input type="checkbox" value="" style="margin-left:10px;">
                                </label>
                            </div>
                        </div>                       
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.ChequeDDTrndate}} :</label>
                        <input id="txtChequeDDTrndate" name="ChequeDDTrndate" class="form-control SetCalender" placeholder="{{translation.ChequeDDTrndate}}" style="width:94%; display:inline;" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.AmtPayble}} :</label>
                        <input id="txtAmtPayble" name="AmtPayble" class="form-control" placeholder="{{translation.ChequeDDTrndate}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.Remark}} :</label>
                        <input id="txtRemark" class="form-control" type="text" name="Remark" value="{{translation.Remark}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.AmtPayble}} :</label>
                        <input id="txtAmtPayble" name="AmtPayble" class="form-control" placeholder="{{translation.ChequeDDTrndate}}" />
                    </div>
                    <div class="col-md-6">
                        <label class="ng-binding">{{translation.IntPaidTillDt}} :</label>
                        <input id="txtIntPaidTillDt" class="form-control SetCalender" type="text" name="IntPaidTillDt" value="{{translation.IntPaidTillDt}}" style="width:94%; display:inline;" />
                    </div>
                </div>

                <div class="table-dropdown">
                    <div class="col-md-12">
                        <div class="table-dropdown">
                            <div class="col-md-7">

                            </div>
                            <div class="col-md-1">
                                <br /><br /><br /><br />
                                <input id="btn btnSave" name="save" value="{{translation.Saved}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <br /><br /><br /><br />
                                <input id="btnCancel" name="Cancel" value="{{translation.Cancel}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <br /><br /><br /><br />
                                <input id="btnCloase" name="Close" value="{{translation.Close}}" class="btn btn-primary form-control" type="button">
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>


</div>