<script src="~/Scripts/AngularFramework/FundingPositionConfiguration.js"></script>

<div ng-app="FundingPositionConfigurationMod">
    <div ng-controller="FundingPositionConfigurationCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.FundingPositionConfiguration}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.PLDB}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.FundingPositionConfiguration}} </span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="citizen-dash-head">
                <form name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.FundingPosConID}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option> 01 </option>
                                <option> 02 </option>
                            </select>
                        </div>
                        <div class="col-lg-2">{{translation.FundingPosConDate}}</div>
                        <div class="col-lg-4">
                            <input type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.FundingPosConName}}</div>
                        <div class="col-lg-4">
                            <input type="text" class="form-control" />
                        </div>
                        <div class="col-lg-2">{{translation.FundingPosConAcGroup}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option> Individual Account Head </option>
                            </select>
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-lg-2">{{translation.FundingPosConAllAc}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option> Loan Minor Irrigation </option>
                                <option> Loan Farm </option>
                                <option> Loan Diversified </option>
                            </select>
                        </div>
                        <div class="col-lg-2">{{translation.FundingPosConSelectAc}}</div>
                        <div class="col-lg-4">
                            <select class="form-control">
                                <option> Select </option>
                                <option> Cash In Hand </option>
                                <option> Rajasthan State Cooperative </option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary">{{translation.Save}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Delete}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Cancle}}</button>
                            <button type="submit" class="btn btn-primary">{{translation.Close}}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

