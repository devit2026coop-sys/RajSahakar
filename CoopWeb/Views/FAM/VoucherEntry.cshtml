@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; 
}
<script src="~/Scripts/AngularFramework/DigitalRegister.js"></script>

<div ng-app="DigitalRegisterMod" ng-controller="DigitalRegisterCnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.VoucherEntry}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
              
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.VoucherEntry}}   </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div>  
                <fieldset>
                    <legend>{{translation.VOUCHERFIELDSET}}</legend>
                    <div class="table-dropdown">
                        <div class="col-md-3">
                            <label for="search" class="ng-binding">{{translation.VoucherDate}}:</label>
                            <input id="txtVoucherDate" name="VoucherDate" class="form-control SetCalender" placeholder="{{translation.VoucherDate}}" autocomplete="off" style="width:90%; display:inline;">
                        </div>
                        <div class="col-md-2">
                            <label for="search" class="ng-binding" > </label><br />
                            <div class="checkbox">
                                <label for="search" class="ng-binding" style="padding-left:0px;">
                                    {{translation.CashVoucherEntry}} :  <input type="checkbox" value="" style="margin-left:10px;">
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label for="search" class="ng-binding"> </label>
                            <select class="form-control">
                                <option>--Select--</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <br />
                            <label for="search" class="ng-binding">{{translation.LastPostedDate}}: 16 May 2014</label>
                        </div>
                    </div>
                    <div class="table-dropdown">
                        <div class="col-md-3">
                            <label for="search" class="ng-binding">{{translation.SerialNoInFile}}:</label>
                            <input id="txtFileSLNo" name="txtFileSLNo" class="form-control">
                        </div>
                        <div class="col-md-2">
                            <br />
                            <label for="search" class="ng-binding">{{translation.Balance}} [-] :  00.00 </label>

                        </div>
                        <div class="col-md-4">

                            <label class="ng-binding">{{translation.TrialBalanceHead}}:</label>
                            <select class="form-control">
                                <option>--Select--</option>
                                <option>ADVENCE LOAN RECOVERY FROM BRANCH</option>
                            </select>

                        </div>
                        <div class="col-md-3" style="border-bottom:1px solid #000;">
                            <br />
                            <label for="search" class="ng-binding">{{translation.PostVoucher}}</label>
                        </div>
                    </div>
                    <div class="table-dropdown">
                        <div class="col-md-3">
                            <label class="ng-binding">{{translation.AccountName}} :</label>
                            <select class="form-control">
                                <option>--Select--</option>
                                <option>ADVENCE LOAN RECOVERY FROM BRANCH</option>
                            </select>
                        </div>
                        <div class="col-md-2">

                            <label class="ng-binding">{{translation.AccountCode}}:</label>
                            <select class="form-control">
                                <option>--Select--</option>
                                <option>ADVENCE LOAN RECOVERY FROM BRANCH</option>
                            </select>
                        </div>
                        <div class="col-md-4">

                            <label class="ng-binding">{{translation.Amount}}:</label>
                            <input id="txtAmount" name="Amount" class="form-control" placeholder="{{translation.Amount}}">
                        </div>
                        <div class="col-md-3">
                            <br />
                            <label for="search" class="ng-binding">{{translation.CumDr}} : 0.00 </label>
                        </div>
                    </div>
                    <div class="table-dropdown">
                        <div class="col-md-3">
                            <label class="ng-binding">{{translation.Narration}} :</label>
                            <select class="form-control">
                                <option>To</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <br />
                            <input style="margin-left: 20px;" type="radio" name="dabit" value="Dabit" /><label for="search" class="ng-binding">{{translation.Dabit}}</label>
                        </div>
                        <div class="col-md-4">
                            <br />
                            <input style="margin-left: 20px;" type="radio" name="dabit" value="Credit" /><label for="search" class="ng-binding">{{translation.Credit}}</label>
                        </div>
                        <div class="col-md-3" style="border-bottom:1px solid #000;">
                            <br />
                            <label for="search" class="ng-binding">{{translation.CumCr}} : 0.00 </label>
                        </div>
                    </div>
                    <div class="table-dropdown">
                        <div class="col-md-12">
                            <br />
                            <label for="search" class="ng-binding" style="float:right">{{translation.Balance}} : 0.00 </label>
                        </div>
                    </div>
                </fieldset>
                </div>
            </div>
            
        </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">       
        <div class="table-responsive citizen-dash-head">           
            <div>
                <table id="TblvoucherEntry" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                
                                <th style="text-align:left">{{translation.AccountNumber}}</th>
                                <th style="text-align:left">{{translation.AccountHead}}</th>
                                <th style="text-align:left">{{translation.Dabit}}</th>
                                <th style="text-align:left">{{translation.Credit}}</th>
                                <th style="text-align:left">{{translation.Narration}}</th>
                                <th style="text-align:left">{{translation.VoucherNo}}</th>
                                <th style="text-align:left">{{translation.VoucherType}}</th>
                                <th style="text-align:left"> #{{translation.SRNO}}</th>
                               
                            </tr>
                        </thead>
                      
                            <tr style="cursor: pointer;">                             
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">To</td>
                                <td style="text-align:left">VCH-00919</td>
                                <td style="text-align:left">VCHTYPE-0900</td>
                                <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                            </tr>   
                    <tr style="cursor: pointer;">
                        <td style="text-align:left">75276156767</td>
                        <td style="text-align:left">Account Head</td>
                        <td style="text-align:left">00.00</td>
                        <td style="text-align:left">00.00</td>
                        <td style="text-align:left">To</td>
                        <td style="text-align:left">VCH-00919</td>
                        <td style="text-align:left">VCHTYPE-0900</td>
                        <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                    </tr> 
                        <tr style="cursor: pointer;">                             
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">To</td>
                                <td style="text-align:left">VCH-00919</td>
                                <td style="text-align:left">VCHTYPE-0900</td>
                                <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                            </tr> 
                    </table>
                    <div class="col-md-12">
                        <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetDigitalRegister)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetDigitalRegister)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetDigitalRegister)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetDigitalRegister)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetDigitalRegister)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>

                        <div class="table-dropdown">
                            <div class="col-md-1">
                                <input id="btn btnSave" name="save" value="{{translation.Saved}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <input id="btnNew" name="New" value="{{translation.New}}" class="btn btn-primary form-control" type="button">
                            </div>

                            <div class="col-md-1">
                                <input id="btnEdit" name="Edit" value="{{translation.Edit}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <input id="btnDelete" name="Delete" value="{{translation.Delete}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <input id="btnViewAll" name="ViewAll" value="{{translation.ViewAll}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <input id="btnCancel" name="Cancel" value="{{translation.Cancel}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">

                            </div>
                            <div class="col-md-1">
                                <input id="btnPrint" name="print" value="{{translation.Print}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <input id="btnPrintMonthly" name="printMonthly" value="{{translation.PrintMonthly}} " class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-2">
                                <input id="btnVoucherSmry" name="VoucherSumary" value="{{translation.VoucherSummery}}" class="btn btn-primary form-control" type="button">
                            </div>
                            <div class="col-md-1">
                                <input id="btnVoucherPrint" name="Voucherprint" value="{{translation.PrintVoucher}}" class="btn btn-primary form-control" type="button">
                            </div>
                        </div>
                    </div>

                


                </div>
            
            </div>
        </div>     
    </div>
