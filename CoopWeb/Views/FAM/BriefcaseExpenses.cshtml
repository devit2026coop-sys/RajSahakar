@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}
<script src="~/Scripts/AngularFramework/DigitalRegister.js"></script>

<div ng-app="DigitalRegisterMod" ng-controller="DigitalRegisterCnt">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.MedicalExpTitle}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.MedicalExpTitle}}   </span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <fieldset>
                <legend>{{translation.BriefcaseExpTitle}}</legend>
                <div class="table-dropdown">
                    <div class="col-md-3">
                        <label for="search" class="ng-binding">{{translation.RegisterSrNo}} :</label>
                        <input id="txtSrNumber" name="SerialNo" class="form-control" placeholder="{{translation.RegisterSrNo}}">
                    </div>
                    <div class="col-md-2">
                        <label for="search" class="ng-binding">{{translation.Date}} :</label>
                        <div class="form-group">
                            <input id="txtdate" name="Date" class="form-control SetCalender" placeholder="{{translation.Date}}" style="width:90%; display:inline;">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <br />
                        <label for="search" class="ng-binding">{{translation.Designation}} : Designation</label>

                    </div>
                    <div class="col-md-3">
                        <br />
                        <label for="search" class="ng-binding">{{translation.Department}}: Department</label>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-3">
                        <label for="search" class="ng-binding">{{translation.EmployeeType}}:</label>
                        <select class="form-control">
                            <option>REGULAR</option>
                            <option>RETIRED</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="search" class="ng-binding">{{translation.EmpName}}:</label>
                        <select class="form-control">
                            <option>SELECT</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <br />
                        <label for="search" class="ng-binding">{{translation.BasicPay}} : Basic Pay</label>
                    </div>
                    <div class="col-md-3">
                        <br />
                        <label for="search" class="ng-binding">{{translation.TotalRembrusment}}: Amount</label>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-3">
                        <label class="ng-binding">{{translation.DetailOfBriefcase}} :</label>
                        <input id="txtDetailsofBriefCase" name="DetailsofBriefCase" class="form-control" placeholder="{{translation.DetailOfBriefcase}}">
                    </div>
                    <div class="col-md-2">
                        <br />
                        <label class="ng-binding">{{translation.MaximumLimit}}: 00.00</label>
                        @*<input id="txtReasonJourney" name="ReasonJourney" class="form-control" placeholder="{{translation.ReasonOfJourny}}">*@
                    </div>
                    <div class="col-md-4">
                        <label class="ng-binding">{{translation.NameofAgent}} : </label>
                        <input id="txtNameofAgent" class="form-control" type="text" name="NameofAgent" value="{{translation.NameofAgent}}" />
                    </div>
                    <div class="col-md-3">
                        <label class="ng-binding">{{translation.SanctionedAmt}} :</label>
                        <input id="txtSancAmt" class="form-control" type="text" name="sancAmt" value="{{translation.SanctionedAmt}}" />
                    </div>

                </div>
                <div class="table-dropdown">
                    <div class="col-md-3">
                        <label class="ng-binding">{{translation.PeriodForEx}} :</label>
                        <input id="txtperiodFrom" class="form-control SetCalender" type="text" name="periodFrom" value="{{translation.PeriodForEx}}" style="width:90%; display:inline;" />
                    </div>
                    <div class="col-md-2">
                        <label class="ng-binding">{{translation.PeriodTo}} :</label>
                        <input id="txtPeriodTo" class="form-control SetCalender" type="text" name="PeriodTo" value="{{translation.PeriodTo}}" style="width:90%; display:inline;" />
                    </div>
                    <div class="col-md-4">
                        <label class="ng-binding">{{translation.ClaimedAmt}} : </label>
                        <input id="txtClaimedAmount" class="form-control" type="text" name="ClaimedAmount" value="{{translation.ClaimedAmt}}" />
                    </div>
                    <div class="col-md-3">
                        <label class="ng-binding">{{translation.DiffrenceAmt}} :</label>
                        <input id="txtDiffAmount" class="form-control" type="text" name="DiffAmount" value="{{translation.DiffrenceAmt}}" />
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-12">
                        <table id="TblvoucherEntry" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                            <thead>
                                <tr>
                                    <th style="text-align:left"> #{{translation.SRNO}}</th>
                                    <th style="text-align:left">{{translation.BillInvNo}}</th>
                                    <th style="text-align:left">{{translation.BillInvDate}}</th>
                                    <th style="text-align:left">{{translation.ClaimedAmt}}</th>
                                    <th style="text-align:left">{{translation.SanctionedAmt}}</th>
                                    <th style="text-align:left">{{translation.DiffrenceAmt}}</th>
                                    <th style="text-align:left">{{translation.Remarks}}</th>
                                </tr>
                            </thead>

                            <tr style="cursor: pointer;">
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">To</td>
                                <td style="text-align:left">VCH-00919</td>
                                <td style="text-align:left">VCHTYPE-0900</td>

                            </tr>
                            <tr style="cursor: pointer;">
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">To</td>
                                <td style="text-align:left">VCH-00919</td>
                                <td style="text-align:left">VCHTYPE-0900</td>

                            </tr>
                            <tr style="cursor: pointer;">
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">To</td>
                                <td style="text-align:left">VCH-00919</td>
                                <td style="text-align:left">VCHTYPE-0900</td>
                            </tr>
                        </table>
                        <div class="col-md-12">
                            <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">

                                </div>
                                <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                    <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                    <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetDigitalRegister)" style="cursor: pointer;">
                                        <span>«First</span>
                                    </li>
                                    <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetDigitalRegister)" style="cursor:pointer;">
                                        <span>« Previous</span>
                                    </li>
                                    <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetDigitalRegister)"><span>{{n}}</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                    <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetDigitalRegister)" style="cursor:pointer;">
                                        <span>Next »</span>
                                    </li>
                                    <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetDigitalRegister)" style="cursor:pointer;">
                                        <span>Last »</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="table-dropdown">
                                <div class="col-md-6">
                                    <div class="col-md-2">
                                        <br /><br />
                                        <label class="ng-binding">{{translation.Remarkcomment}} : </label>
                                    </div>
                                    <div class="col-md-10">
                                        <textarea id="txtRemark" name="Remark" class="form-control" cols="40" rows="5"></textarea>

                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="table-dropdown">
                                        <div class="col-md-4">

                                        </div>
                                        <div class="col-md-2">
                                            <br /><br /><br /><br />
                                            <input id="btn btnSave" name="save" value="{{translation.Saved}}" class="btn btn-primary form-control" type="button">
                                        </div>
                                        <div class="col-md-2">
                                            <br /><br /><br /><br />
                                            <input id="btnPrint" name="print" value="{{translation.Print}}" class="btn btn-primary form-control" type="button">
                                        </div>

                                        <div class="col-md-2">
                                            <br /><br /><br /><br />
                                            <input id="btnCancel" name="Cancel" value="{{translation.Cancel}}" class="btn btn-primary form-control" type="button">
                                        </div>
                                        <div class="col-md-2">
                                            <br /><br /><br /><br />
                                            <input id="btnCloase" name="Close" value="{{translation.Close}}" class="btn btn-primary form-control" type="button">
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>


</div>
