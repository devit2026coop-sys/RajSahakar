<script src="~/Scripts/AngularFramework/FinancialStatementConfiguration.js"></script>

<div ng-app="ApplicationFlowCitizenModule" ng-controller="FinancialStatementConfiguration">

	<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
		<h3 class="citizen-dash-head">{{translation.FinancialStatementConfiguration}} </h3>
	</div>

	<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
		<div class="devpage-breadcrumb">
			<ul class="page-breadcrumb">
				<li class="dev-page-br">
					<i class="fa fa-home"> </i>
					<a href="../Citizen/Index"> {{translation.Home}} </a>
					<i class="fa fa-angle-right"> </i>
				</li>
				<li style="float: left">
					<span style="margin: 0 5px;"> {{translation.FinancialStatementConfiguration}} </span>
				</li>

				<li style="float: right;" id="divAddBtn">
					<button type="button" ng-click="ShowTrialBalancegrid()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" data-target="#myModal">
						<h5>&#187; {{translation.NewEntry}}</h5>
					</button>
				</li>


			</ul>
		</div>
	</div>
	@*MEMBERS*@

	<div class="citizen-dash-head" ng-show="!ShowTrialBalance">
		<form>
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<h4 class="citizen-dash-head">{{translation.AccountConfig}} </h4>
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-2">{{translation.ProfileId}}</div>
					<div class="col-lg-4">
					<select ng-model="BhandarForm.BhandarId" disabled class="form-control" ng-init="BhandarForm.BhandarId='0'">
							<option value="0" disabled>{{translation.SelectOption}}</option>
							<option ng-repeat="item in BhandarList" value="{{item.DISTRICT_ID}}">
								{{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
							</option>
						</select>
					</div>
					<div class="col-lg-2">
						{{translation.ProfileCreationdate}}</div>
					<div class="col-lg-2">
						<select ng-model="BhandarForm.BhandarId" disabled class="form-control" ng-init="BhandarForm.BhandarId='0'">
							<option value="0" disabled>{{translation.SelectOption}}</option>
							<option ng-repeat="item in BhandarList" value="{{item.DISTRICT_ID}}">
								{{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
							</option>
						</select>
							</div>
					
				</div>
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-2">
						{{translation.Profilename}}
					</div>
					<div class="col-lg-8">
						<input type="text" class="form-control" ng-bind="ProgrammeNameEn" ng-model="BhandarForm.ControlledBusinessTarget" placeholder="" autocomplete="off" />

					</div>
					

				</div>
				

			</div>
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-4">
						<input type="radio" style="" ng-click="SelectReportType('Quantity')" checked="checked" name="Type" value="New" />{{translation.BalanceSheet}}
						<input style="" type="radio" ng-click="SelectReportType('GSSWise')" name="Type" value="Generate" />{{translation.Profitandlossstate}}
					</div>


				</div>
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-4">
						{{translation.Accounttype}}
					</div>
					<div class="col-lg-4">

						<select ng-model="BhandarForm.BhandarId" disabled class="form-control" ng-init="BhandarForm.BhandarId='0'">
							<option value="0" disabled>{{translation.SelectOption}}</option>
							<option ng-repeat="item in BhandarList" value="{{item.DISTRICT_ID}}">
								{{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
							</option>
						</select>
					</div>


				</div>
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-4">
						{{translation.BalanceSheetHead}}
					</div>
					<div class="col-lg-4">

						<select ng-model="BhandarForm.BhandarId" disabled class="form-control" ng-init="BhandarForm.BhandarId='0'">
							<option value="0" disabled>{{translation.SelectOption}}</option>
							<option ng-repeat="item in BhandarList" value="{{item.DISTRICT_ID}}">
								{{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
							</option>
						</select>
					</div>


				</div>
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-4">
						{{translation.DisplayAccountName}}
					</div>
					<div class="col-lg-4">

						<select ng-model="BhandarForm.BhandarId" disabled class="form-control" ng-init="BhandarForm.BhandarId='0'">
							<option value="0" disabled>{{translation.SelectOption}}</option>
							<option ng-repeat="item in BhandarList" value="{{item.DISTRICT_ID}}">
								{{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
							</option>
						</select>
					</div>


				</div>
				</div>
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-2">
						{{translation.Listofall}}
					</div>
					<div class="col-lg-3">
						<input type="checkbox" id="vehicle1" name="vehicle1" >
						{{translation.Sortonac}}
					</div>
					<div class="col-lg-3">
						
					</div>
					<div class="col-lg-2">
						{{translation.SelectedAc}}
					</div>
					<div class="col-lg-2">
						<input type="text" class="form-control" ng-bind="ProgrammeNameEn" ng-model="BhandarForm.ControlledBusinessTarget" placeholder="" autocomplete="off" />

					</div>

				</div>
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-4">
						
						<textarea name="AddressEn" class="form-control resize" rows="5" ng-model="UserRegistration.AddressEn" maxlength="200" ng-minlength="5" ng-required="true" autocomplete="off"> </textarea>
					</div>
					<div class="col-lg-1"></div>

						<div class="col-lg-2">
							<button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveBhandar(true)"><<</button>
							<button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveBhandar(true)">>></button>
						</div>
					<div class="col-lg-1"></div>
						<div class="col-lg-4">
							<textarea name="AddressEn" class="form-control resize" rows="5"  ng-model="UserRegistration.AddressEn" maxlength="200" ng-minlength="5" ng-required="true" autocomplete="off"> </textarea>

						</div>


					</div>
				<div class="col-lg-12 form-group">
					<input type="hidden" ng-model="BhandarForm.BhandarDataId" />
					<div class="col-lg-4">
						{{translation.Subtitleofac}}
					</div>
					<div class="col-lg-4">
						<input type="text" class="form-control" ng-bind="ProgrammeNameEn" ng-model="BhandarForm.ControlledBusinessTarget" placeholder="" autocomplete="off" />

						
					</div>
					<div class="col-lg-4">
						<button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveBhandar(true)">ADD</button>

					</div>


				</div>
				
			</div>

				<div class="form-group col-md-12">
					<div class="dev-menu-btn">
						<button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveBhandar(true)">{{translation.Submit}}</button>
						<button type="submit" class="btn btn-primary" ng-click="CloseTrialBalancegrid()">Delete</button>
						<button type="submit" class="btn btn-primary" ng-click="ClearBhandarForm()">{{translation.Clear}}</button>
						<button type="submit" class="btn btn-primary" ng-click="CloseTrialBalancegrid()">Close</button>
						<button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveBhandar(true)">{{translation.Print}}</button>

						
					</div>
				</div>
</form>
	</div>
	<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="ShowTrialBalance">
		<div class="table-responsive citizen-dash-head">
			<div class="table-dropdown" id="search-filter">
				<input type="hidden" value="Purpose" id="MasterType" />
				<div class="col-md-4">
					<label for="search" class="ng-binding">Search:</label>
					<input id="search" ng-model="q" class="form-control ng-pristine ng-valid ng-empty ng-touched" placeholder="Filter Text" autocomplete="off">
				</div>


				<div class="col-md-4">
					<label>&nbsp;</label><br>
					<button type="button" ng-click="searchRequest(GetElectionSocietyListData)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
					<button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
				</div>
			</div>
			<table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
				<thead>
					<tr>
						<th>
							#
							@*{{translation.SRNO}}*@
						</th>

						<th>
							{{translation.AccountHeadName}}
						</th>
						<th>
							{{translation.AccountCode}}
						</th>
						<th>
							{{translation.AccountType}}
						</th>
						<th>
							{{translation.AbbreviationName}}
						</th>
						<th>
							{{translation.GenLFNo}}
						</th>
						<th>
							{{translation.Active}}
						</th>
						<th>
							{{translation.Actions}}
						</th>
					</tr>
				</thead>
				<tbody>
					<tr dir-paginate="item in LoanPurposeList | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="ElectionSymbolsPagination">
						<td>{{$index+1}}</td>


						<td>
							{{item.AccountHeadName}}
						</td>
						<td>
							{{item.AccountCode}}
						</td>
						<td>
							{{item.AccountType}}
						</td>
						<td>
							{{item.AbbreviationName}}
						</td>
						<td>
							{{item.GenLFNo}}
						</td>


						<td>
							<div class="dev-action">

								<label class="switch">

									<input type="checkbox" ng-checked="item.is_active == 1" ng-click="SetStatus(item.purpose_id,item.is_active)">

									<span class="slider round"></span>
								</label>
							</div>
						</td>
						<td class="add-more-td">
							<a href="javascript:void(0);" ng-click="ShowTrialBalancegrid()"><i class="fa fa-edit"></i></a>
							<a href="javascript:void(0);" ng-click="SetStatus(item.purpose_id,2)"><i class="fa fa-trash"></i></a>

						</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div class="col-md-12">
			<div class="text-left">
				<dir-pagination-controls boundary-links="true" pagination-id="ElectionSymbolsPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
			</div>
		</div>

	</div>
</div>

