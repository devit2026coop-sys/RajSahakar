
@{

    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; 
}
<script src="~/Scripts/AngularFramework/DigitalRegister.js"></script>

<div ng-app="DigitalRegisterMod" ng-controller="DigitalRegisterCnt">

    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.CashDetail}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">

                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.CashDetail}}   </span>
                </li>
            </ul>
        </div>
    </div>
    
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <fieldset>
                <legend>{{translation.CashDetailFieldset}}</legend>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding" style="width:50%;">{{translation.Date}}:</label>
                        <input id="txtCashDate" name="CashDate" class="form-control SetCalender" placeholder="{{translation.Date}}" autocomplete="off" style="width:90%; display:inline;">
                    </div>               
                    <div class="col-md-6">                      
                            <label for="search" class="ng-binding"> {{translation.TrialBalanceInHand}} : </label>
                            <select class="form-control">
                                <option>CASH IN HAND - PLDB OFFICE</option>
                            </select>                          
                   </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-6">
                        <label for="search" class="ng-binding">{{translation.AccountName}}:</label>
                        <select class="form-control">
                            <option>CASH IN HAND - PLDB JAIPUR </option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label for="search" class="ng-binding">{{translation.AccountCode}} </label>
                        <select class="form-control">
                            <option>10101010101 </option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <br />
                        <label for="search" class="ng-binding">{{translation.Balance}} [Dr.] 7100 </label>
                    </div>

                </div>
                <div class="table-dropdown">
                    <div class="col-md-8">
                        <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                            <thead>
                                <tr>
                                    <th style="text-align:left">{{translation.SRNO}} </th>
                                    <th style="text-align:left">{{translation.CurrencyType}}</th>
                                    <th style="text-align:left">{{translation.CurrencyCount}}</th>
                                    <th style="text-align:left">{{translation.Amount}}</th>
                                    <th style="text-align:left">{{translation.Remark}}</th>
                                </tr>
                            </thead>

                            <tr>
                                <td>1</td>
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                            </tr>
                            <tr>
                                <td>4</td>
                                <td style="text-align:left">75276156767</td>
                                <td style="text-align:left">Account Head</td>
                                <td style="text-align:left">00.00</td>
                                <td style="text-align:left">00.00</td>
                            </tr>
                        </table>

                    </div>
                    <div class="col-md-4">
                        <div class="table-dropdown">
                            <div class="col-md-6">
                                <label for="search" class="ng-binding"> {{translation.CumDr}}</label>
                         </div>
                            <div class="col-md-6">
                                <label for="search" class="ng-binding"> 7100</label>
                            </div>
                        </div>
                        <div class="table-dropdown" style="border-bottom:1px solid #000;">
                            <div class="col-md-6">
                                <label for="search" class="ng-binding"> {{translation.CumCr}}</label>
                            </div>
                            <div class="col-md-6">
                                <label for="search" class="ng-binding"> 0</label>
                            </div>
                        </div>
                        <div class="table-dropdown">
                            <div class="col-md-6">
                                <label for="search" class="ng-binding"> {{translation.Balance}}</label>
                            </div>
                            <div class="col-md-6">
                                <label for="search" class="ng-binding"> 7100 [DR.]</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-dropdown">
                    <div class="col-md-8">
                        <div class="col-md-12">

                            <div class="table-dropdown">
                                <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                    <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">

                                    </div>
                                    <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetDigitalRegister)" style="cursor: pointer;">
                                            <span>«First</span>
                                        </li>
                                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetDigitalRegister)" style="cursor:pointer;">
                                            <span>« Previous</span>
                                        </li>
                                        <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetDigitalRegister)"><span>{{n}}</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetDigitalRegister)" style="cursor:pointer;">
                                            <span>Next »</span>
                                        </li>
                                        <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetDigitalRegister)" style="cursor:pointer;">
                                            <span>Last »</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="table-dropdown">
                                <div class="col-md-6" style="text-align:right;">
                                    {{translation.Total}} :
                                </div>
                                <div class="col-md-3">
                                    <input type="text" value="7100" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="table-dropdown">
                        <div class="col-md-8">

                        </div>
                        <div class="col-md-1">
                            <br /><br /><br /><br />
                            <input id="btn btnSave" name="save" value="{{translation.Saved}}" class="btn btn-primary form-control" type="button">
                        </div>
                        <div class="col-md-1">
                            <br /><br /><br /><br />
                            <input id="btnPrint" name="print" value="{{translation.Print}}" class="btn btn-primary form-control" type="button">
                        </div>

                        <div class="col-md-1">
                            <br /><br /><br /><br />
                            <input id="btnCancel" name="Cancel" value="{{translation.Cancel}}" class="btn btn-primary form-control" type="button">
                        </div>
                        <div class="col-md-1">
                            <br /><br /><br /><br />
                            <input id="btnCloase" name="Close" value="{{translation.Close}}" class="btn btn-primary form-control" type="button">
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>   
        </div>
   
 </div>
