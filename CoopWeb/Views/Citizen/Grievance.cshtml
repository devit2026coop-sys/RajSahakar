

<script src="~/Scripts/AngularFramework/Grievance.js?id=0"></script>

<div ng-app="UserfeedbackMod">
    <div ng-controller="UserfeedbackCnt">

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h4 class="citizen-dash-head"> {{translation.GrievanceRegistration}}</h4>
            @*<input type="hidden" id="EUserType" value="@ViewBag.usertype" />*@
            <input type="hidden" id="Idmobile" value="@ViewBag.MobileNo" />

        </div>


        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.OtherServices}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.GrievanceRegistration}} </span>
                    </li>
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" ng-click="ShowForm()"> <h5>&#187; {{translation.AddNewGrievance}}</h5> </button>
                    </li>
                </ul>
            </div>
        </div>


        <div class="col-md-12 citizen-dash-head" ng-show="divRegistration">
            <div class="col-lg-12 margin-Top20" style="margin-top:20px;">

                <div class="col-lg-2">
                    <label>{{translation.SocietyName}}<span class="error">*</span></label>
                </div>

                <div class="form-group col-lg-4">

                    <select class="form-control" id="societydll" ng-model="Grievance.SocietyIdENC" ng-init="Grievance.SocietyIdEnc='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in SocietyList" value="{{item.SocietyIdENC}}">
                            {{item.SocietyName}}
                        </option>
                    </select>

                </div>
                <div class="col-lg-2">
                    <label>{{translation.GrievanceCategory}}<span class="error">*</span></label>
                </div>

                <div class="form-group col-lg-4">
                    <select ng-model="Grievance.GCategoryId" class="form-control" ng-init="Grievance.GCategoryId='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in GrievanceCategoryList | orderBy:'CategoryNameEn'" value="{{item.GCategoryId}}">
                            {{_language =='en-us' ?  item.CategoryNameEn : item.CategoryNameHi}}
                        </option>
                    </select>
                </div>



                <div class="col-lg-2" style="display:none;">
                    <label>Application ID<span class="error">*</span></label>
                </div>
                <div class="form-group col-lg-4" style="display:none;">
                    <select ng-model="ID" class="form-control" ng-init="ID='0'">
                        <option value="0">{{translation.SelectOption}}</option>
                        <option ng-repeat="item in Department" value="{{item.ID}}">
                            {{_language =='en-us' ?  item.DEPTNAMEENGLISH : item.DEPTNAMEENGLISH}}
                        </option>
                    </select>
                </div>

            </div>

            <div class="col-lg-12 margin-Top20" style="margin-top:20px;">
                <div class="col-lg-2" style="display:none;">
                    <label>Aggrieved By Order/Action of<span class="error">*</span></label>
                </div>

                <div class="form-group col-lg-4" style="display:none;">

                    <select ng-model="GCategoryId" class="form-control" ng-init="GCategoryId='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in GrievanceCategoryList | orderBy:'CategoryNameEn'" value="{{item.GCategoryId}}">
                            {{_language =='en-us' ?  item.CategoryNameEn : item.CategoryNameHi}}
                        </option>
                    </select>
                </div>
            </div>

            <div class="col-lg-12 margin-Top20">
                <div class="col-lg-2">

                    <label>{{translation.Description}}<span class="error">*</span></label>
                </div>
                <div class="col-lg-10">
                    <textarea id="Remark" class="form-control" ng-model="Grievance.Description"></textarea>

                </div>
            </div>
            <div class="col-lg-12 margin-Top20" style="margin-top:20px;">


                <div class="col-lg-2">
                    <label>  {{translation.MobileNo}} <span class="error">*</span></label>
                </div>
                <div class="col-lg-4">
                    <input type="text" class="form-control" placeholder="{{translation.MobileNo}}" ng-model="Grievance.MobileNo" ng-bind="MobileNo" autocomplete="off" required onkeypress='return ((event.charCode >= 48 && event.charCode <= 57)|| event.which ==8 || event.keyCode ==8 || event.charCode==8)' maxlength="10">
                </div>

                <div class="col-lg-2" style="display:none;">
                    <label>Past Refrence<span class="error">*</span></label>
                </div>

                <div class="form-group col-lg-4" style="display:none;">


                    <select ng-model="GCategoryId" class="form-control" ng-init="GCategoryId='0'">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in GrievanceCategoryList | orderBy:'CategoryNameEn'" value="{{item.GCategoryId}}">
                            {{_language =='en-us' ?  item.CategoryNameEn : item.CategoryNameHi}}
                        </option>
                    </select>

                </div>

                <div class="col-lg-2">
                    <label>{{translation.AttachmentifAny}}<span class="error">*</span>: </label>
                </div>
                <div class="col-lg-4">
                    <div class="col-lg-12" style="color:black; width: 425px;">

                        <div class="col-lg-5" ng-show="!Grievance.IsUploadFileName" style="padding-left: 0px;">
                            <input type="file" accept="image/*,application/pdf" dat-val="nocheck" ng-model="Grievance.FileName" id="FileName" ng-click="AddFile1(1,0)" validfile1 />
                        </div>
                        <div class="col-lg-7" ng-if="Grievance.IsUploadFileName">
                            <a href="javascript:void(1);" ng-if="Grievance.FileName!=''"><i class="fa fa-check-circle-o" style="font-size: 18px;margin-right: 5px;    color: #20cc20;"></i></a>
                            <a href="{{Grievance.FileName}}" ng-if="Grievance.FileName!=''" target="_blank"><i class="fa fa-eye-slash" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>View File</a>
                            <a href="javascript:void(1);" ng-if="Grievance.FileName=='' && !IsSubmiApplication" ng-click="UploadFile_new('FileName',1,0)"><i class="fa fa-upload" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>Upload File</a>
                            <a href="javascript:void(1);" ng-if="Grievance.IsUploadFileName && !IsSubmiApplication" ng-click="ChangeFile1(1,0)"><i class="fa fa-undo" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>Change File</a>
                        </div>

                    </div>
                </div>


            </div>

            <div class="col-lg-12" style="margin-top:20px;">
                <div class="form-group">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="SaveGrievance()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearMenuForm()">{{translation.Cancel}}</button>
                        <button type="submit" class="btn btn-primary" ng-disabled="ShowButton" ng-click="Showfeedback()"> Feedback </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divGrid">
            <div class="citizen-dash-head">
                <table class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.SocietyName}}
                            </th>
                            <th>
                                {{translation.GrievanceCategory}}
                            </th>
                            <th>
                                {{translation.SSOID}}
                            </th>

                            <th>
                                {{translation.Description}}
                            </th>

                            <th> {{translation.GrievanceStatus}} </th>

                            <th>
                                {{translation.DateTime}}
                            </th>

                            <th>
                                {{translation.File}}
                            </th>
                            @*
                            <th>
                                {{translation.TakeAction}}
                            </th>*@
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="Item in GrievanceDetailList">
                            <td>{{$index+1}}</td>
                            <td>{{ Item.SocietyName | uppercase }}</td>
                            <td>{{ Item.CategoryNameEn | uppercase }}</td>
                            <td>{{ Item.SSO_ID | uppercase }}</td>
                            <td>{{ Item.Discription | uppercase }}</td>

                            <td ng-if="Item.CurrentStatusId=='1'">New Request</td>
                            <td ng-if="Item.CurrentStatusId=='2'">Open</td>
                            <td ng-if="Item.CurrentStatusId=='3'">Reopen</td>
                            <td ng-if="Item.CurrentStatusId=='4'">Reject</td>
                            <td ng-if="Item.CurrentStatusId=='5'">Close</td>
                            <td>{{ Item.CreationDate }}</td>


                            <td>
                                <a target="_blank" ng-if="Item.AttachmentFileName!=''" href="{{Item.AttachmentFileName}}"><i class="fa fa-download"></i></a>
                            </td>
                            @*
                            <td>
                                <i class="fa fa-eye" data-target="#myModal" data-toggle="modal"></i>
                            </td>*@
                        </tr>


                        <tr ng-if="DataPagingDetails.TotalPages>1">
                            <td colspan="8">
                                <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                    <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                        Total Records: {{DataPagingDetails.TotalRecords}}
                                    </div>
                                    <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetGrievanceList)" style="cursor: pointer;">
                                            <span>«First</span>
                                        </li>
                                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetGrievanceList)" style="cursor:pointer;">
                                            <span>« Previous</span>
                                        </li>
                                        <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetGrievanceList)"><span>{{n}}</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                        <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetGrievanceList)" style="cursor:pointer;">
                                            <span>Next »</span>
                                        </li>
                                        <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetGrievanceList)" style="cursor:pointer;">
                                            <span>Last »</span>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>

        </div>
        @Html.Partial("_UserRatingModel")

    </div>
</div>

