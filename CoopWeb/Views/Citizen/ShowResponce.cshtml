
@{
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}
<script type="text/javascript">
    function GoToDashBoard() {
        window.location = "../Citizen/CitizenDashboard";
    }
</script>
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <h3 class="citizen-dash-head">PAYMENT STATUS/भुगतान की स्थिति</h3>
</div>

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <div class="devpage-breadcrumb">
        <ul class="page-breadcrumb">
            <li class="dev-page-br">
                <i class="fa fa-home"> </i>
                <a href="#"> HOME/होम </a>
                <i class="fa fa-angle-right"> </i>
            </li>
            <li style="float: left">
                <span style="margin: 0 5px;">PAYMENT STATUS/भुगतान की स्थिति </span>
            </li>
        </ul>
    </div>
</div>
<div class="col-md-12">
    <div class="citizen-dash-head">
        <div class="table-dropdown">
            @Html.Raw(ViewBag.Responce)
        </div>
        <div>
            <button type="button" class="btn btn-primary dev-btn" style="margin-top: 25px;" onclick="GoToDashBoard()">Go To Dashboard</button>
        </div>
    </div>
</div>

