<div ng-app="CCSComplaintViewCnt">
    <div ng-controller="CCSComplaintViewMod">
        <div class="container" id="skip-content">
            <div class="col-md-12">
                <h3 class="citizen-dash-head">{{translation.CCSComplaint}}</h3>
                <hr style="margin: 0;">
            </div>

            <div class="row" style="margin:10px 0px;">
                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 col-lg-offset-1" style="margin-top:15px;">
                    <div class="update-block">
                        <a href="/Citizen/CCSComplaint" target="_self">
                            <div class="col-md-8 update-left">
                                <p class="ng-binding">शिकायत दर्ज करें </p>
                            </div>
                            <div class="col-md-4 market-update-right icon">
                                <i class="fa fa-gavel dred"></i>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 col-lg-offset-1" style="margin-top:15px;">
                    <div class="update-block">
                        <a href="/Citizen/CCSComplaintView" target="_self">
                            <div class="col-md-8 update-left">
                                <p class="ng-binding">दर्ज शिकायत देखें </p>
                            </div>
                            <div class="col-md-4 market-update-right icon">
                                <i class="fa fa-file dred"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <form class="ng-pristine ng-valid">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="citizen-dash-head col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divAADHARVerificationStep_1">

                            <div class="col-12" style="color:#005E8D;margin-top:15px;font-size:18px;margin-bottom:10px;">
                                शिकायत दर्ज करने में किसी भी प्रकार की समस्या आने पर हेल्पलाइन ईमेल आई डी <span style="color:#F00;font-size:20px;font-weight:800;">support.rajsahakar@rajasthan.gov.in</span>  पर मेल भेजें
                            </div>

                            <div class="col-lg-12 form-group12">
                                <div class="col-lg-2">{{translation.AADHARNo}}<span class="error">*</span></div>
                                <div class="col-lg-4">
                                    <input type="text" class="form-control" placeholder="{{translation.AADHARNo}}" ng-model="Complaint.AADHARNo" autocomplete="off" onkeypress='return event.charCode >= 48 && event.charCode <= 57' min="1" maxlength="12">
                                </div>

                                <div class="col-lg-4">
                                    <button type="button" class="btn btn-success ng-binding" ng-click="VerifyAADHARNo_Step_1_2()" ng-disabled="disablebtnSendOtp">&nbsp;&nbsp;{{translation.SendOTP}}</button>

                                </div>
                                <div class="col-lg-2">&nbsp;</div>
                            </div>

                            <div class="col-lg-12 form-group12">
                                <div class="col-lg-12"><input type="checkbox" id="ckkAADHARAcceptance" /> &nbsp; &nbsp; {{translation.AADHARAcceptance}}</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="citizen-dash-head col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divAADHARVerificationStep_2">
                            <div class="col-lg-12 form-group12">
                                <div class="col-lg-2">{{translation.EnterOTP}}<span class="error">*</span></div>
                                <div class="col-lg-4">
                                    <input type="text" class="form-control" placeholder="{{translation.EnterOTP}}" ng-model="Complaint.EnterOTP" autocomplete="off" onkeypress='return event.charCode >= 48 && event.charCode <= 57' min="6" maxlength="6">
                                </div>

                                <div class="col-lg-4">
                                    <button type="button" class="btn btn-success ng-binding" ng-click="VerifyAADHARNo_Step_2_2()">&nbsp;&nbsp;{{translation.OtpVeryfication}}</button>
                                </div>
                                <div class="col-lg-2"><button type="button" class="btn btn-success ng-binding" ng-click="ResendOTP()" ng-disabled="isDisabled">&nbsp;&nbsp;{{translation.ReSendOTP}}</button></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divComplaintList">
                        <div class="citizen-dash-head">
                            <div class="col-lg-12">
                                <div>
                                    <table class="table devtable">
                                        <thead>
                                            <tr>
                                                <th>{{translation.SRNO}}</th>
                                                <th>{{translation.ComplainerName}}</th>
                                                <th>{{translation.ComplainerFatherhusbandName}}</th>
                                                <th>{{translation.ComplaintAgainstSociety}}</th>
                                                <th>{{translation.AmountDepoisted}}</th>
                                                <th>{{translation.ComplaintDate}}</th>
                                                <th>{{translation.ComplaintDetailsDownload}}</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            <tr ng-repeat="item in ComplaintList">
                                                <td>{{$index+1}}</td>
                                                <td>{{item.ComplainerName}}</td>
                                                <td>{{item.ComplainerFatherName}}</td>
                                                <td>{{item.SocietyName}}</td>
                                                <td>{{item.AmountDeposited}}</td>
                                                <td>{{item.CreateDateTime}}</td>
                                                <td><a href="javascript:void()" ng-click="ExportData(item.ComplaintId)" title="{{translation.ComplaintDetailsDownload}}"><i class="fa fa-download" aria-hidden="true"></i> </a> </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>

    <input type="button" id="btnGeneratePDF" onclick="DownloadPDF()" />
    <input type="hidden" id="hdfcomplaintid" value="" />
</div>

