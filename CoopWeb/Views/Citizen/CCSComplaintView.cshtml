<script type="text/javascript">


    function DownloadPDF() {
        // ExportToPDF(Id, [], '', PDFPageType.Portrait);
      
        $('body').prepend("<form method='post' action='../ExportHandler.ashx' id='tempForm'><input type='hidden' name='PdfId' value='2' ><input type='hidden' name='data' value='" + $('#hdfcomplaintid').val() + "' ><input type='hidden' name='PageType' value='" + PDFPagePrintType.Portrait + "' ></form>");
        $('#tempForm').submit();
        $("tempForm").remove();
    }
    var PDFPagePrintType = {
        Default: 'Default',
        Portrait: 'Portrait',
        Landscape: 'Landscape'
    }

</script>

