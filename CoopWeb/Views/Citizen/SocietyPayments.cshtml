@{
    // Layout = "~/Views/Shared/_LayoutWithoutLogin.cshtml";
    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; ;
}
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script type="text/javascript">
    function OnSuccess(data) {
        if (data.UserType == 'C') {
            $('#FormPost').html(data.result);
            $('#FormPost').find('form').submit();
        }
        else {
            if (data.result == '1') {
                alert('Payment Successful Received');
                window.location = "../Citizen/SocietyPayments";
            }
            else {
                ShowModelAlert("Society Administrative Details", 'Issue in Payment Receiveing Please Try after Some time');
            }
        }
    }


    function OnFailure(data) {
        $scope.showLoader = false;
        alert(JSON.stringify(data));

    }
    function OnBegin() {
        //$scope.showLoader = true;
    }


</script>

<script src="~/Scripts/AngularFramework/SocietyPayment.js"></script>

<div ng-app="SocietyPaymentModule">
    <div ng-controller="SocietyPaymentCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.SocietyPayment}}</h3>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        @*<span style="margin: 0 5px;">{{translation.New}}  </span>
                        <i class="fa fa-angle-right"> </i>*@
                        <span style="margin: 0 5px;">{{translation.SocietyPayment}} </span>
                    </li>

                </ul>
            </div>
        </div>
        <div class="form-group col-md-6" hidden>
            <input type="text" class="form-control" ng-model="SocietyRegistration.txn">
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    @*<div class="col-lg-12 form-group">
                        <div class="col-lg-2">
                            <label style="color:black">{{translation.SocietyRegistrationNo}} :</label>
                        </div>
                        <div class="col-lg-4">
                            <input type="text" name="SocietyName" class="form-control" ng-model="SocietyRegistration.SocietyRegistrationNo" placeholder="{{translation.SocietyRegistrationNo}}" autocomplete="off">
                        </div>
                        <div>

                        </div>
                        <button type="submit" class="btn btn-primary dev-btn" ng-click="getfunSocietyPayment()" ng-disabled="SocietyRegistration.SocietyRegistrationNo==undefined || SocietyRegistration.SocietyRegistrationNo==''">{{translation.GetSocieties}}</button>
                    </div>*@
                </div>
                <table class="table table-responsive devtable" ng-show="Showgride">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.SocietyName}}

                            </th>
                            <th>
                                {{translation.Act}}
                            </th>
                            <th>
                                {{translation.SocietyRegistrationNo}}

                            </th>
                            <th>
                                {{translation.SocietyTyped}}
                            </th>
                            <th>
                                {{translation.PaymentStatus}}
                            </th>
                            <th>
                                {{translation.Payment}}
                            </th>

                        </tr>
                    </thead>
                    <tbody>

                        <tr ng-repeat="items in SocietyRegdata">
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{ items.SocietyName }}</td>
                            <td>{{ items.ActNameEn }}</td>
                            <td>{{ items.RegistrationNo }}</td>
                            <td>{{ items.TypeameEng }}{{items.StatusId}}{{items.ISVerifyPayment}}</td>
                            <td>{{items.StatusId=='33' ||items.StatusId=='1081'  ?'': items.ProceesStatusTextEn }}</td>

                            <td ng-if="(items.StatusId=='33' ||items.StatusId=='1081' ) && (items.ISVerifyPayment==2 || items.ISVerifyPayment==3)">
                                @using (Ajax.BeginForm("FeePaymentByCitizen", "Citizen", FormMethod.Post, new AjaxOptions
                                {
                                OnSuccess = "OnSuccess",
                                OnFailure = "OnFailure",
                                LoadingElementId = "progress",
                                OnBegin = "OnBegin"
                                }))
                                {
                                <input type="hidden" ng-show="items.StatusId=='33' ||items.StatusId=='1081' " name="RegistrationNo" value="{{ items.RegistrationNo }}" />
                                <input type="submit" ng-show="items.StatusId=='33' ||items.StatusId=='1081' " class="btn btn-primary active" value="{{ translation.Pay }}" />
                                }
                            </td>
                            <td ng-if="items.ISVerifyPayment==1 && (items.StatusId=='33' ||items.StatusId=='1081' )">
                                <a class="btn btn-primary active" ng-if="items.StatusId=='33'||items.StatusId=='1081'" href="../Citizen/FeeVerification">{{_language == 'en-us' ?'Verify Payment':'भुगतान सत्यापित करें'}}</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-12" ng-show="Showgride">
        <div class="citizen-dash-head">
            <div class="table-dropdown">

                <div class="col-lg-12 form-group" ng-show="getotp">
                    <div class="col-lg-2">
                        <label style="color:black">{{translation.EnterOTP}} :</label>
                    </div>
                    <div class="col-lg-2">
                        <input class="form-control" required name="login[password]" type="password" ng-model="SocietyRegistration.EnterOTP" placeholder="{{translation.EnterOTP}}" autocomplete="off" onkeypress="return event.charCode >= 48 && event.charCode <= 57">
                        <div class="hide-show"><span class="fa fa-eye-slash"></span></div>
                    </div>
                    <div class="col-lg-2">
                        <button type="submit" class="btn btn-primary dev-btn" ng-show="showResendBtn" ng-click="funChekvalidOTP()">{{ translation.ReSendOTP}}</button>
                    </div>
                    <div class="col-lg-6">
                    </div>
                </div>
                @*<div ng-hide="DivMsg">
                    {{translation.MappingProcessTitle}}
                </div>*@
                <br /><br />
                <div class="col-lg-12">
                    <div class="col-lg-6" ng-show="IsOTPSended">
                        <button type="submit" style="float:right" class="btn btn-primary dev-btn" ng-click="MatchOtpApproved();">{{ translation.Approvedmap}}</button>
                    </div>
                    <div class="col-lg-6">
                        @*<button type="submit" id="abc" style="float:left" class="btn btn-primary dev-btn" ng-click="PaymentInitiatByCityzen(SocietyRegdata[0].RegistrationNo);">{{translation.Payment}}</button>*@
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div id="FormPost">

    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
