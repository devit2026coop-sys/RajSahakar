@if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]) != null)
{
    if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserType == "C")
    {
        Layout = "~/Views/Shared/_CitizenLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}
else
{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/AngularFramework/ApplicationFlowCitizen.js"></script>

<div ng-app="ApplicationFlowCitizenModule">
    <div ng-controller="ApplicationFlowCitizenCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">{{translation.TRACKYOURAPPLICATION}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="../Citizen/Index">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.TRACKYOURAPPLICATIONSUB}} </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
            </div>
        </div>
        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label>
                                {{translation.SocietyName}} :
                            </label>
                            <select ng-model="SocietyIdEnc" class="form-control" ng-init="SocietyIdEnc='0'" ng-change="update(SocietyIdEnc)">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in SocietyList" value="{{item.SocietyIdENC}}">
                                    {{_language =='en-us' ?  item.SocietyName : item.SocietyName}}
                                </option>
                            </select>
                        </div>
                        @*<div class="col-md-4" style="padding-left: 0;">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-md-4">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                            </div>*@
                    </div>
                    <table class="table table-responsive devtable" style="margin-top:10px;padding-top:10px">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.AssignTo}}
                                </th>
                                <th>
                                    {{translation.Status}}
                                </th>
                                <th>
                                    {{translation.Remarks}}
                                </th>
                                <th>
                                    {{translation.Date}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="AppFlowOne in ApplicationFlowCitizenSociety  | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="AppliFlowPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ _language =='en-us' ? AppFlowOne.OfficerNameEn : AppFlowOne.OfficerNameHi}}</td>
                                <td>{{ _language =='en-us' ? AppFlowOne.ProceesStatusTextEn : AppFlowOne.ProceesStatusTextHi}}</td>
                                <td>{{AppFlowOne.Remark}}</td>
                                <td>{{AppFlowOne.ActionDate}}</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>

            @*<div class="form-group col-md-12">
                    <div class="dev-align-btn">
                        <button type="submit" class="btn btn-primary dev-btn" ng-disabled="MyUserForm.$invalid" ng-click="SaveUserReqAppForm()">{{translation.Submit}}</button>
                    </div>
                </div>*@
            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="AppliFlowPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">

                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../Citizen/Index"> Back</a>
                </div>
            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>