<div ng-app="PLDBMemberRegistrtionMod">
    <div ng-controller="PLDBMemberRegistrtionCnt">

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h4 class="citizen-dash-head"> {{translation.PLDBMemberRegistrationRequest}}</h4>
            <input type="hidden" id="EUserType" value="@ViewBag.usertype" />
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.OtherServices}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.PLDBMemberRegistrationRequest}} </span>

                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="showPLDBMemberRequestList">
            @*ng-show="divGrid"*@

            <div class="citizen-dash-head">
                <table class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.ApplicantName}}
                            </th>
                            <th>
                                {{translation.PLDB}}
                            </th>
                            <th>
                                {{translation.MobileNo}}
                            </th>
                            <th>
                                {{translation.ApplicationNo}}
                            </th>
                            <th>
                                {{translation.Date}}
                            </th>
                            <th>
                                {{translation.Approvable}}/{{translation.Reject}}
                            </th>
                            <th>
                                {{translation.Date}}
                            </th>
                            <th>
                                {{translation.Remarks}}
                            </th>
                            <th>
                                {{translation.TakeAction}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @*ng-style="{'background-color': Item.ActionStatus == '0' ? 'red' : (Item.ActionStatus == '1' ? 'green' : '') }"*@
                        <tr dir-paginate="Item in MemberDataForApproval | filter: q | orderBy:colsort:reverseSort  | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuPagination" >  
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{ Item.Name | uppercase }}</td>
                            <td>{{ Item.PLDBName | uppercase }}</td>
                            <td>{{ Item.MobileNo }}</td>
                            <td>{{ Item.ApplicationNo  }}</td>
                            <td>{{ Item.InsertDate  }}</td>
                            <td>{{ Item.ActionStatus == '1' ? translation.Approvable : Item.ActionStatus =='0' ? translation.Reject : ''  }}</td>
                            <td>{{ Item.ActionDate  }}</td>
                            <td>{{ Item.ActionRemark  }}</td>
                            
                            <td>
                                <i class="fa fa-eye" data-target="#myModal" data-toggle="modal" ng-click="ViewMemberApplication(Item.RequestIdEnc)" ng-show="Item.ActionStatus!=250"></i>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>





        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divViewApplicationDetailShow">
            <div class="citizen-dash-head">
                <table style="width:100%;">
                    <tr>
                        <td colspan="4">
                            <h4 class="heading-hr ng-binding"> {{ViewApplication.BLOCK_MANGAL}}  {{translation.PLDBHeading}}, {{ViewApplication.PLDBName}}</h4>
                        </td>
                    </tr>

                    <tr ng-show="IsPaymentDone">
                        <td>
                            {{translation.ApplicationNo}}
                        </td>
                        <td>
                            {{ViewApplication.ApplicationNo}}
                        </td>
                        <td> &nbsp; </td>
                        <td> &nbsp; </td>
                    </tr>

                    <tr>
                        <td>
                            {{translation.ApplicantName}}
                        </td>
                        <td>
                            {{ViewApplication.Name}}
                        </td>
                        <td>
                            {{translation.FatherHusbandName}}
                        </td>
                        <td>
                            {{ViewApplication.FatherHusbandName}}
                        </td>
                    </tr>



                    <tr>
                        <td>
                            {{translation.Age}}
                        </td>
                        <td>
                            {{ViewApplication.Age}}
                        </td>
                        <td> {{translation.EducationalQualification}} </td>
                        <td> {{ViewApplication.QualificationHi}} </td>
                    </tr>

                    <tr>
                        <td>
                            {{translation.PermanatAddress}}
                        </td>
                        <td>
                            {{ViewApplication.Address}}
                        </td>
                        <td> {{translation.CurrentAddress}} </td>
                        <td> {{ViewApplication.CurrentAddress}} </td>
                    </tr>

                    <tr>
                        <td>
                            {{translation.NomineeNameWithFatherName}}
                        </td>
                        <td>
                            {{ViewApplication.NomineeName}}
                        </td>
                        <td> {{translation.NomineeRelation}} </td>
                        <td> {{ViewApplication.RelationHi}} </td>
                    </tr>

                    <tr>
                        <td>
                            {{translation.MobileNo}}
                        </td>
                        <td>
                            {{ViewApplication.MobileNo}}
                        </td>
                        <td> {{translation.Business}} </td>
                        <td> {{ViewApplication.Business}} </td>
                    </tr>

                    <tr>
                        <td>
                            {{translation.MembershipFee}}
                        </td>
                        <td>
                            <b>100 ₹</b>
                        </td>
                        <td> {{translation.PartAmount}} </td>
                        <td> <b>11 ₹</b> </td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            {{translation.MembershipFee}}
                        </td>
                    </tr>

                    <tr ng-show="IsPaymentDone">
                        <td>
                            {{translation.TokenNo}}
                        </td>
                        <td>
                            {{ViewApplication.TokenNo}}
                        </td>
                        <td> {{translation.ReceiptNo}} </td>
                        <td> {{ ViewApplication.ReceiptNo }} </td>
                    </tr>

                    <tr ng-show="IsPaymentDone">
                        <td>
                            {{translation.BANK_NAME}}
                        </td>
                        <td>
                            {{ViewApplication.BANK_NAME}}
                        </td>
                        <td> {{translation.TranDate}} </td>
                        <td> {{ ViewApplication.TranDate }} </td>
                    </tr>

                    <tr ng-show="IsPaymentDone">
                        <td>
                            {{translation.KioskID}}
                        </td>
                        <td>
                            {{ViewApplication.KioskID}}
                        </td>
                        <td> {{translation.BANK_ACC_NO}} </td>
                        <td> {{ ViewApplication.BANK_ACC_NO }} </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <img src="{{ViewApplication.PhotoPath}}" alt="Photo" width="100" height="100" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            {{translation.TakeAction}}
                        </td>
                        <td>
                            <input type="radio" name="ApprovalPLDBMember" value="1" ng-init="MemberApproval.IsApproved='0'" ng-model="MemberApproval.IsApproved" /> {{translation.Approvable}} &nbsp; &nbsp;
                            <input type="radio" name="ApprovalPLDBMember" value="0" ng-model="MemberApproval.IsApproved" /> {{translation.Rejection}}
                            <input type="radio" name="ApprovalPLDBMember" value="2" ng-model="MemberApproval.IsApproved" /> {{translation.Objection}}
                        </td>
                        <td> {{translation.Remarks}} </td>
                        <td>
                            <textarea rows="6" cols="125" style="margin: 0px; width: 341px; height: 74px;resize:none;" placeholder="{{translation.Remarks}}" ng-model="MemberApproval.Remark" ng-minlength="1" ng-maxlength="50" autocomplete="off" onKeyPress="return ValidateAlpha(event);"> </textarea>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <center>
                                <div>
                                    <button class="btn btn-primary dev-btn ng-binding" ng-click="SavePLDBMemberStatus()">{{translation.Submit}}</button>

                                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="#" ng-click="BackToPLDBMemberRequestList()">{{ translation.Back}}</a>
                                </div>
                            </center>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>


