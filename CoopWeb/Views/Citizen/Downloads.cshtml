@{
    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; ;
}
<script src="~/Scripts/AngularFramework/DownloadsCitizenClient.js"></script>

@model List<Cooperative.Models.SocietyRegistrationEntity>

<script>
    function ShowTBL(val) {
        if (val == 0) {
            $("#DivOther").show();
            $("#DivYearly").hide();
        }
        else {
            $("#DivOther").hide();
            $("#DivYearly").show();
        }

    }
</script>
<div ng-app="CitizenDownloadMod">
    <div ng-controller="CitizenDownloadCnt">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.Downloads}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="../Citizen/Index"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">  {{translation.Citizen}}</span>
                        <span style="margin: 0 5px;"> {{translation.Downloads}}</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="citizen-dash-head" style="overflow: hidden;">
                <div class="table-dropdown">
                    <div class="col-xs-4">
                        <label style="color:black">
                            {{translation.SocietyName}} :
                        </label>
                        <select ng-model="SocietyIdENC" id="DDLSociety" class="form-control" ng-init="SocietyIdENC='0'" ng-change="GetSocietyDownloadList()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Societylist" value="{{item.SocietyIdENC}}">
                                {{_language =='en-us' ?  item.SocietyName : item.SocietyName}}
                            </option>
                        </select>
                    </div>
                    <div class="col-xs-4" style="margin-top:20px;">
                        <label style="color:black">
                            {{translation.Downloads}}
                        </label>
                        <input class="form-check-input" type="radio" name="rbDown" checked="checked" onchange="ShowTBL(0);">
                        <label class="form-check-label option_value ng-binding">{{translation.Other}}</label>
                        <input class="form-check-input" type="radio" name="rbDown" onchange="ShowTBL(1);">
                        <label class="form-check-label option_value ng-binding" style="margin-right: 15px;">{{translation.Yearly}}</label>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-hide="SocietyIdENC=='0'">
            <div class="citizen-dash-head">

                <div class="dev-masters" id="DivOther" style="margin:20px 0px 20px 0px;">
                    <div class="col-md-12">
                        <div class="citizen-dash-head">
                            <table class="table table-responsive devtable" style="margin-top: 30px;">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.File}} {{translation.Name}}
                                        </th>
                                        <th>
                                            {{translation.Fileview}}
                                        </th>

                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-hide="RegistrationCertificateFile ==''">
                                        <td>{{translation.RegistrationCertificateFile}}</td>
                                        <td><a style="color:#505050;" target="_blank" href="{{  RegistrationCertificateFile }}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                    </tr>
                                    <tr ng-hide="BylawsFile ==''">
                                        <td>{{translation.BylawsFile}}</td>
                                        <td><a style="color:#505050;" target="_blank" href="{{  BylawsFile }}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                    </tr>
                                    <tr ng-hide="RulesAndRegulationFile ==''">
                                        <td>{{translation.RulesAndRegulationFile}}</td>
                                        <td><a style="color:#505050;" target="_blank" href="{{  RulesAndRegulationFile }}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                    </tr>
                                    <tr ng-hide="DLSCFileName==''">
                                        <td>{{translation.DLSCFileName}}</td>
                                        <td><a style="color:#505050;" target="_blank" href="{{ DLSCFileName }}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                    </tr>
                                    <tr ng-hide="SOCFileName ==''">
                                        <td>{{translation.OCFileName}}</td>
                                        <td><a style="color:#505050;" target="_blank" href="{{   SOCFileName }}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                    </tr>
                                    <tr ng-hide="RSSCFileName ==''">
                                        <td>{{translation.RSSCFileName}}</td>
                                        <td><a style="color:#505050;" target="_blank" href="{{ RSSCFileName }}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                    </tr>
                                    <tr ng-hide="MemberListFile ==''">
                                        <td>{{translation.MemberListFile}}</td>
                                        <td><a style="color:#505050;" target="_blank" href="{{ MemberListFile }}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                    </tr>
                                    <tr ng-hide="BankOpeningCertificate ==''">
                                        <td>{{translation.BankOpeningCertificate}}</td>
                                        <td><a style="color:#505050;" target="_blank" href="{{ BankOpeningCertificate }}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="dev-masters" id="DivYearly" style="margin:20px 0px 20px 0px; display:none">
                    <div class="citizen-dash-head">
                        <label style="color:black">
                            {{translation.FincialYearHeading}}
                        </label>
                        <select class="form-control" ng-model="FinancialYear" ng-init="FinancialYear='0'" ng-change="ShowYearlyData()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_MASTR_ID}}">
                                {{item.FIN_YEAR_NAME}}
                            </option>
                        </select>
                    </div>
                    <div class="citizen-dash-head">
                        <table class="table table-responsive devtable" style="margin-top: 30px;" ng-show="FYearData">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                    </th>
                                    <th>
                                        {{translation.File}}
                                    </th>
                                    <th>
                                        {{translation.CreationDate}}
                                    </th>
                                    <th>
                                        {{translation.Fileview}}
                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="item in YearlyDataList | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="ClassFormatPagination">
                                    <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                    <td ng-show="item.Doctype==1">Inspection File</td>
                                    <td ng-show="item.Doctype==2">Audit File</td>
                                    <td>{{item.Insert_Date}}</td>
                                    <td><a style="color:#505050;" target="_blank" href="{{item.FilePath}}"><i class="fa fa-info-circle infoicon-edit"></i></a></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group col-md-12">
                <div class="dev-menu-btn" style="margin-top: 20px;">
                    <a class="btn btn-primary dev-btn" href="../Citizen/Index">{{translation.Back}}</a>
                </div>
            </div>
        </div>
        <div class="se-pre-con"></div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>
    </div>
