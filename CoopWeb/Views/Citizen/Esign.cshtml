
@{
    Layout = "~/Views/Shared/_CitizenLayout.cshtml"; ;
}
<script src="~/Scripts/AngularFramework/SocietyApplicationView.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script type="text/javascript">
    function OnSuccess(data) {         
        //$('#FormPost').html(data);
         $('#FormPost').html(data.result);
         $('#FormPost').find('form').submit();
           
    }
    function OnFailure(data) {
        $('#preloader').hide();
        alert(JSON.stringify(data));
    }
    function OnBegin() {
        $('#preloader').show();
    }
</script>
<body>
    <div> 
        <form action="../Citizen/ESING_New" data-ajax="true" data-ajax-begin="OnBegin" data-ajax-failure="OnFailure" data-ajax-loading="#progress" data-ajax-success="OnSuccess" id="form0" method="post" class="ng-pristine ng-valid">           
            <button type="submit" class="btn btn-primary pay-btn">SAVE</button>
        </form>
    </div>
    <div id="FormPost">

    </div>
</body>

