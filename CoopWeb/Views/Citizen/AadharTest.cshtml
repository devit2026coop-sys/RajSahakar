
<script src="~/Scripts/AngularFramework/AAdhar.js"></script>
<script type="text/javascript"
        src=" https://ssotest.rajasthan.gov.in/ssoauth/js/ssoauth_frame.js"></script>

<script type="text/javascript">
    function init() {        
        initSSOAuthFrame('ssoauth_iframe', 'https://ssoauth.rajasthan.gov.in/fpauthnew?iframe=1', $('#encXml').html());
    }
</script>


<div ng-app="AAdharMod" ng-controller="AAdharCnt">
    <div>
        <table>
            <thead>
                <tr>
                    <th>AADHAR</th>
                    <th>NAME</th>
                    <th>PHOTO</th>
                    <th>AGE</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th><label id="Adhar"></label></th>
                    <th><label id="Name"></label></th>
                    <th><label id="Photo"></label></th>
                    <th><label id="Age"></label></th>
                    <th>
                        <input type="submit" ng-click="GetAAdhar()" />                       
                        <label id="encXml"></label>
                    </th>

                </tr>
            </tbody>
        </table>
       
    </div>
    <div>
        <iframe id="animateCC" src="AnimateCC/hw.html" class="fullscreen"></iframe>
        <button id="initButton" onclick="init();">Animate!</button>
        <div class="modal fade" id="UDID_POPOUP_APPSUBMIT" role="dialog">
            <div class="vertical-alignment-helper">
                <div class="modal-dialog modal-sm vertical-align-center">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title">INFORMATION/ जानकारी</h4>
                        </div>
                        <div class="modal-body">
                            <p></p>
                        </div>
                        <div class="modal-footer">
                            <asp:Button ID="btn_RedirectSWS" class="showloading btnvalidate btn-mod" CausesValidation="false" runat="server" Text="OK" OnClick="btn_RedirectSWS_Click" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="confirm" role="dialog">
            <div class="vertical-alignment-helper">
                <div class="modal-dialog modal-sm vertical-align-center">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title">CONFIRMATION/ पुष्टीकरण</h4>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to delete this member?
                        </div>
                        <div class="modal-footer">
                            <button type="button" data-dismiss="modal" class="btn btn-primary" id="delete">OK</button>
                            <button type="button" data-dismiss="modal" class="btn btn-primary" id="cancel">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
