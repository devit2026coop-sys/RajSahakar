<script type="text/javascript">


    function DownloadPDF() {
        // ExportToPDF(Id, [], '', PDFPageType.Portrait);

        $('body').prepend("<form method='post' action='../ExportHandler2.ashx' id='tempForm'><input type='hidden' name='PdfId' value='2' ><input type='hidden' name='data' value='" + $('#hdfcomplaintid').val() + "' ><input type='hidden' name='PageType' value='" + PDFPagePrintType.Portrait + "' ></form>");
        $('#tempForm').submit();
        $("tempForm").remove();
    }
    var PDFPagePrintType = {
        Default: 'Default',
        Portrait: 'Portrait',
        Landscape: 'Landscape'
    }

</script>

<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

    $(document).ready(function () {
        $('.SetCalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            maxDate: '0'
        });

    })


</script>
