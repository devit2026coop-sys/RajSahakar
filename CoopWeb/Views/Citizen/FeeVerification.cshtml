@{
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}
<script src="~/Scripts/AngularFramework/Emitra.js?id=4"></script>
<div ng-app="EmitraModule" ng-controller="EmitraCont">
    <div class="col-md-12">
        <h3 class="h3heading citizen-dash-head">{{translation.FeeVerification}}</h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.Home}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;">{{translation.FeeVerification}}   </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-12">
        <form class="dev-search-form citizen-dash-head " style="overflow: hidden;" name="Myauditform">
            <div class="col-lg-12 form-group">             

                <div class="col-lg-2">
                    <label>{{translation.SocietyName}}</label>
                </div>
                <div class="col-lg-4">
                    <select class="form-control" ng-model="FailedTransaction.SocietyIdENC" ng-init="FailedTransaction.SocietyIdENC='0'" ng-change="GetTransaction()">
                        <option value="0" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in SocietyList" value="{{item.RegistrationNo}}">
                            {{item.SocietyName}}
                        </option>
                    </select>
                </div>

                @if(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserType=="K")
                {
                <div class="col-lg-12" style="margin-top:10px;">

                </div>
                <div class="col-lg-2">
                    <label>{{translation.Search}} {{item.SocietyName}}</label>
                </div>
                <div class="col-lg-4">
                    <input class="form-control" ng-model="SearchText" placeholder="{{translation.RegistrationNo}}" />
                </div>
                <div class="col-lg-4">
                    <button type="button" ng-click="SerachTransaction()" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                </div>
                }

            </div>

                  <div class="col-md-12 table-responsive ">
                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th class="info_news_slh_table_fix">Sr No.</th>
                                    @*<th>Society Name</th>*@
                                    @*<th>RegistrationNo</th>*@
                                    <th>Status Msg</th>
                                    @*<th>Request String</th>
                                    <th>Response String</th>*@                                  
                                    <th>Submission Date</th>                                  
                                    <th>Action</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in ApplicationList">
                                    <td>{{$index+1}}</td>
                                    @*<td>{{item.SocietyName}}</td>*@
                                    @*<td>{{item.RegistrationNo}}</td>*@
                                    <td>{{item.StatusMsg}}</td>
                                    @*<td style="word-break:break-all;word-wrap:break-word">{{item.RequestString}}</td>
                                    <td style="word-break:break-all;word-wrap:break-word">{{item.ResponseString}}</td>*@
                                    <td>{{item.CreationDate}}</td>
                                    <td> <a ng-click="GetFeeVerification(item.SocietyIdENC, item.EMitraAppRequestID, item.SERICEID, item.SocietyId, item.RegistrationNo,item.ApplicationStatus)" class="btn btn-primary dev-btn ng-binding">VERIFY TRANSACTION</a></td>
                                    <td>
                                        @*<a title="{{translation.ShowDetails}}" style="color:#505050;"><i ng-click="SocietyView(item)" class="fa fa-info-circle infoicon-edit"></i></a>*@
                                    </td>
                                </tr>
                                    </tbody>
                                </table>



                            </div>

          
            <div class="form-group col-md-12">
                <div class="dev-align-btn">
                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../Citizen/Index"> Back</a>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="se-pre-con"></div>
<div id="stop" class="scrollTop">
    <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
</div>