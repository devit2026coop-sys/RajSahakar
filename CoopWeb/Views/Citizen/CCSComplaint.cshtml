                                        <input type="file" filetype="onlyimagepdf" id="file_{{$index}}" onchange="angular.element(this).scope().UploadEnclouserFile(this.files,this)" fileid="fileid_{{$index}}_{{item.UId}}" />
                                    </td>
                                    <td><i ng-hide="($index+1)==1" class="fa fa-trash" title="Remove" ng-click="RemoveRow($index)"></i></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="8">&nbsp;</td>
                                    <td ng-click="AddNewRow()"><i class="fa fa-plus" title="Add New"></i>{{translation.Add}}</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary" ng-click="Insert()" ng-show="ShowSubmitButton">{{translation.Submit}}</button>
                            @*<button type="submit" class="btn btn-primary" ng-click="ClearForm()">{{translation.Clear}}</button>*@
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToList()"> {{translation.Back}}</a>
                            <input type="hidden" id="hdnUserType" value="@ViewBag.UserType" />
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="dev-popup-body modal fade" id="addModal" data-backdrop="static" data-keyboard="false" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title"> {{translation.ComplaintRegister}}</h4>
                    </div>
                    <div class="modal-body">
                        <div ng-show="DivResponce" id="Responce">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_JanAadhaarValidation")