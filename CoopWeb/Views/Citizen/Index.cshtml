            }

            .blue-txt {
                color: #e94442;
            }

            .sky {
                background: linear-gradient(60deg,#26c6da,#00acc1) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(0,188,212,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(0,188,212,.4);
            }

            .sky-txt {
                color: #53c0d4;
            }

            .lyt-green {
                background: linear-gradient(60deg,#dd70d4,#bd29e5) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgb(244, 166, 248);
