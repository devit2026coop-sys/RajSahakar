            }

            .panel-primary {
                display: inline-block;
                margin-bottom: 30px;
                width: 100%;
            }



            .panel-primary {
                border-color: #337ab7;
            }

            .panel {
                margin-bottom: 20px;
                background-color: #fff;
                border: 1px solid transparent;
                border-radius: 4px;
                -webkit-box-shadow: 0 1px 1px rgba(0,0,0,.05);
                box-shadow: 0 1px 1px rgba(0,0,0,.05);
            }

            .board .number {
                float: left;
            }

            .number h3 {
                font-size: 32px;
                color: #676767;
            }

            .number small {
                font-size: 16px;
                font-weight: 600;
                text-transform: uppercase;
                margin: 8px 5px;
                display: inline-block;
            }

            .board .icon {
                float: right;
            }

            .board .panel .icon .fa {
                font-size: 35px;
                color: #FFFFFF;
                background: #30A5FF;
                padding: 15px;
                border-radius: 50%;
            }

            .dred {
                background: linear-gradient(60deg,#ffa726,#fb8c00) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(255,152,0,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(255,152,0,.4);
            }

            .red-txt {
                color: #f29918;
            }

            .green {
                background: linear-gradient(60deg,#66bb6a,#43a047) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(76,175,80,.4);
                box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(76,175,80,.4);
            }

            .green-txt {
                color: #5ab360;
            }

            .blue {
                background: linear-gradient(60deg,#ef5350,#e53935) !important;
                -webkit-box-shadow: 0 4px 20px 0 rgba(0,0,0,.14), 0 7px 10px -5px rgba(244,67,54,.4);
