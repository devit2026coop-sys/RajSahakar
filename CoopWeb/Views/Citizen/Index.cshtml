                                {{translation.RegistrationDate}}
                            </th>
                            <th>
                                {{translation.Status}}
                            </th>
                            <th>
                                {{translation.Actions}}
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr dir-paginate="item in TableData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SocietyIdForTbl">

                            @*<td>{{$index+1}}</td>*@
                            <td>
                                <input ng-model="ABC" ng-click="GetSocietiesForDeshBoard(item.SocietyIdENC)" ng-checked="$index=='0'" type="radio" name="AAAS" />
                            </td>
                            <td>{{item.SocietyName}}</td>
                            <td>{{item.RegistrationNo}}</td>
                            <td>{{item.TypeameEng}}  </td>
                            <td>{{item.RegistrationDate.includes("999") ? '': item.RegistrationDate}}  </td>
                            <td>{{item.IsAmendment?item.AmendmentProceesStatusTextEn: item.Status}}</td>
                            <td class="add-more-td">
                                <a ng-if="item.IsPermanentSave==1" title="Feed back" ng-click="Feedbackrating(item.SocietyIdENC)"><img src="~/Images/Rat.png" width="25" style="border-radius: 50px 50px 50px 50px;" height="25" /></a>
                                <a href="../Citizen/SocietyApplicationForm"><i class="fa fa-eye"></i></a>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="col-md-10">
                    <div class="text-center">
                        <dir-pagination-controls boundary-links="true" pagination-id="SocietyIdForTbl" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
            </div>
            <input type="hidden" value="@ViewBag.currentSSOID" id="hdncurrentSSOID" />
            @Html.Partial("_UserRatingModel")
        </div>
        <div class="se-pre-con"></div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>
    </div>
</div>