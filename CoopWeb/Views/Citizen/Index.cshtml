                transition: 0.5s all;
            }

            .blue1:hover .panel {
                background: #ef5350;
                transition: 0.5s all;
            }

            .blue1:hover .blue-txt, .blue1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .blue1:hover .blue {
                background: #fff !important;
                transition: 0.5s all;
            }

            .blue1:hover .icon .fa {
                color: #ef5350;
                transition: 0.5s all;
            }

            .sky1:hover .panel {
                background: #26c6da;
                transition: 0.5s all;
            }

            .sky1:hover .sky-txt, .sky1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .sky1:hover .sky {
                background: #fff !important;
                transition: 0.5s all;
            }

            .sky1:hover .icon .fa {
                color: #26c6da;
                transition: 0.5s all;
            }

            .lyt-green1:hover .panel {
                background: #bd29e5;
                transition: 0.5s all;
            }

            .lyt-green1:hover .lyt-green-txt, .lyt-green1:hover h3 {
                color: #fff;
                transition: 0.5s all;
            }

            .lyt-green1:hover .lyt-green {
                background: #fff !important;
                transition: 0.5s all;
            }

            .lyt-green1:hover .icon .fa {
                color: #bd29e5;
                transition: 0.5s all;
            }

            .dark-blue1:hover .panel {
