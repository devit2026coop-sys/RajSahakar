                color: #4208f4;
                transition: 0.5s all;
            }

            .blink_me {
                animation: blinker 1s linear infinite;
            }

            .blink-bg {
                animation: blinkBg .6s infinite alternate;
            }

            @@keyframes blinkBg {
                0% {
                    background-color: #ffeb3b; /* yellow */
                }

                100% {
                    background-color: #f44336; /* red */
                }
            }

            @@keyframes blinker {
                50% {
                    opacity: 0;
                }
            }


            .board a {
                display: block;
            }
