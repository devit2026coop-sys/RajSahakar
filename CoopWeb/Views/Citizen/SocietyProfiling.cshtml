<script type="text/javascript">
    function Removetr(Control) {
        if (confirm("Are you sure to remove this Data?")) {
            var index = -1;
            $(Control).parents('#myTable tr').find('[Id^="Remove_"]').each(function (e, res) {
                if ($(Control).attr('id') == $(res).attr('id')) {
                    index = e;
                }
            });

            if (index >= 0) {
                $(Control).parent().parent().remove();
            }
            else {

                // alert("Can't delete this item");
            }
        }
    };

    function ValidateAlphaNumericAndSlash(evt) {
        // alert(evt.keyCode);
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;
        if ((evt.which == 45 || evt.keyCode == 45 || evt.charCode == 45))
            return true;
        if ((evt.which == 95 || evt.keyCode == 95 || evt.charCode == 95))
            return true;

        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32) {
            //    alert("not cahr");
            if ((keyCode >= 48 && keyCode <= 57) || keyCode == 47) {
                //     alert(" num or slash");
                return true;
            }
            else {
                //    alert("not cahr and num");
                return false;
            }
        } else {
            //    alert("cahr");
            return true;
        }
    };


    function EntrenceFeeCalculate(value) {
        if (value > 0) {
            if ($('#lblFeeCalculate').html() == "0") {
                $('#txtEntranceFees').val(0);
            }
            else {
                $('#txtEntranceFees').val(value * 11);
            }
        }
        else if (value == 0)
            $('#txtEntranceFees').val(0);

        CheckMembervalidetion();

    }
    function CheckMembervalidetion() {
        var NumberOfMembers = $('#txtTotalNumberOfMembers').val();
        var NoOfMemberInAGM = $('#txtNoOfMemberInAGM').val();
        if (NumberOfMembers != "" && NoOfMemberInAGM != "") {
            if (parseInt(NoOfMemberInAGM, 10) > parseInt(NumberOfMembers, 10)) {
                alert("No of Members who Participated in AGM should not be greater than Total Number of Members applying for the Society");
                $('#txtNoOfMemberInAGM').val("");
            }
        }
    }

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };
    function RemoveRowFromTable(e) {
        if (confirm("Are you sure to remove this file?")) {
            $('#' + e).remove();
        }
    };


    function DateCheck() {

        return true;
    }


</script>

<script>
    function _(el) {
        return document.getElementById(el);
    }
    function uploadFile() {
        //_("PId").value = fileVal
        var file = _("file1").files[0];
        // alert(file.name+" | "+file.size+" | "+file.type);
        var formdata = new FormData();
        formdata.append("file1", file);
        var ajax = new XMLHttpRequest();
        ajax.upload.addEventListener("progress", progressHandler, false);
        ajax.addEventListener("load", completeHandler, false);
        ajax.addEventListener("error", errorHandler, false);
        ajax.addEventListener("abort", abortHandler, false);
        ajax.open("POST", "../text/SaveFileData");
        ajax.send(formdata);
    }
    function progressHandler(event) {
        //var M = _("PId").value;
        _("loaded_n_total").innerHTML = "Uploaded " + event.loaded + " bytes of " + event.total;
        var percent = (event.loaded / event.total) * 100;
        _("progressBar").value = Math.round(percent);
        _("status").innerHTML = Math.round(percent) + "% uploaded... please wait";
    }
    function completeHandler(event) {
        //var M = _("PId").value;
        alert(event.target.statusText);
        _("status").innerHTML = event.target.statusText.split('#')[0];

        _("progressBar" + M).value = 0;

    }
    function errorHandler(event) {
        //var M = _("PId").value;
        _("status").innerHTML = "Upload Failed : ";
    }
    function abortHandler(event) {
        //var M = _("PId").value;
        _("status").innerHTML = "Upload Aborted";
    }
</script>

