@{
    ViewBag.Title = "Loanee PR Payment";
}
<script src="~/Scripts/AngularFramework/OtsPrLoanPaymentCitizen.js?v=1.1"></script>
<style>
    label {
        display: inline-block;
        width: 100% !important;
        margin-bottom: 5px;
        font-weight: 700;
        font-weight: normal
    }

    .zoom {
        transition: transform .2s; /* Animation */
        margin: 0 auto;
    }

        .zoom:hover {
            padding-left: 30px;
            transform: scale(2.5); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }

    a > i.fa.fa-plus-circle {
        font-size: 25px;
        cursor: pointer;
    }

    a:hover > i.fa.fa-plus-circle {
        font-size: 26px;
        cursor: pointer;
    }

    a > i.fa.fa-eye {
        font-size: 25px;
        cursor: pointer;
    }

    a:hover > i.fa.fa-eye {
        font-size: 26px;
        cursor: pointer;
    }


    .dvfieldset {
        border: 1px solid #b0adad;
        border-radius: 5px;
        padding-bottom: 10px;
        margin-bottom: 20px;
        background: #fff;
        color: #444;
    }

    .dvlegend {
        width: auto;
        padding: 24px;
        margin-left: 11px;
        border: 1px solid gray;
        padding: 5px;
        border-radius: 14px;
        font-size: 16px;
        padding-left: 14px;
        padding-right: 15px;
        background: #025e63;
        color: #fff;
    }

    .modal-dialog {
        color: #444;
    }

    .payment-table {
        width: 100%;
    }

        .payment-table td {
            padding: 5px;
        }
</style>
<div ng-app="pldbApp" ng-controller="pldbCtrl" ng-cloak="">
    <div class="col-md-12" ng-show="ApplicantDetailsList==null">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pt-2">
            <h5 style="text-align:center;font-size: 17px;background:#025e63;color:#fff;" class="citizen-dash-head">Get Application Details</h5>
        </div>
        <fieldset class="dvfieldset">
            <legend class="dvlegend">Application Details/आवेदक का विवरण</legend>
            <form ng-submit="SearchApplicationDetails()">
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="row">
                        <div class="col-md-6">
                            <label>{{translation.PLDB}} :</label>
                            <select ng-model="obj.PldbId" class="form-control" ng-init="PldbId='0'" ng-change="PLDBBranchList('0')" required>
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="li in PLDBList  track by li.PldbId " value="{{li.PldbId}}">
                                    {{li.PLDBName}}
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label>{{translation.BranchName}} :</label>
                            <select ng-model="obj.BranchId" class="form-control" ng-init="BranchId='0'" required>
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="li in PLDBBranches " value="{{li.BLOCK_ID}}">
                                    {{_language =='en-us' ?  li.BLOCK_ENG : li.BLOCK_MANGAL}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{translation.LoanApplicationNo}} :</label>
                        <input type="text" class="form-control" ng-model="obj.LoanAccNo" placeholder="Loan Account Number" />
                    </div>
                    ---------------------------OR---------------------------
                    <div class="form-group">
                        <label>{{translation.Notice}}/{{translation.RegistrationNo}} :</label>
                        <input type="text" class="form-control" ng-model="obj.RegistrationNo" placeholder="Notice/RegistrationNo" />
                    </div>
                    ---------------------------OR---------------------------
                    <div class="form-group">
                        <label>{{translation.MobileNo}} :</label>
                        <input type="text" class="form-control" ng-model="obj.MobileNo" placeholder="MobileNo" />
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn dev-btn btn-primary">Get Details</button>
                    </div>
                </div>
            </form>
        </fieldset>
    </div>
    <div ng-show="ApplicantDetailsList!=null && ApplicantDetails==null">

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pt-2">
            <h5 style="text-align:center;font-size: 17px;background:#025e63;color:#fff;" class="citizen-dash-head">Loanee Applicant List</h5>
        </div>
        <div class="text-right"><button ng-click="ApplicantDetailsList=null" class="btn btn-primary dev-btn">Back To Search</button></div>
        <table class="table table-responsive devtable" style="color:#444">
            <thead>
                <tr>
                    <th>
                        {{translation.SRNO}}
                    </th>
                    <th>
                        {{translation.ApplicantName}}
                    </th>
                    <th style=" min-width: 125px;">
                        {{translation.PLDB}}
                    </th>
                    <th style=" min-width: 125px;">
                        {{translation.Branch}}
                    </th>
                    <th>
                        {{translation.MobileNo}}
                    </th>
                    <th>
                        Loan Account No
                    </th>
                    <th>
                        {{translation.Sector}}
                    </th>
                    <th>
                        {{translation.PurposeOfLoan}}
                    </th>
                    <th>
                        {{translation.Actions}}
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="li in ApplicantDetailsList">
                    <td>
                        {{$index+1}}
                    </td>
                    <td>
                        <b> <i>{{li.ApplicantName }}</i></b><br />
                        {{li.FatherHusbandName}}
                    </td>
                    <td>{{li.PLDBName}}  </td>
                    <td>{{li.PLDBBranch }}</td>
                    <td>{{li.MobileNo }}</td>
                    <td>{{li.LoanAccNo }}</td>
                    <td>{{li.Sector }}</td>
                    <td>{{li.Purpose }}</td>
                    <td>
                        <div style="display:flex;gap:5px;">
                            <a class="btn btn-sm btn-primary" title="View" ng-click="GetApplicationDetails(li.OtsIdEnc)"><i class="fa fa-eye text-white"></i></a>
                            <button ng-click="downloadFile(li)" title="Download Notice" class="btn btn-sm btn-warning"> <i class="fa fa-download text-white"></i></button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="col-md-12" ng-show="ApplicantDetails!=null">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pt-2">
            <h5 style="text-align:center;font-size: 17px;background:#025e63;color:#fff;" class="citizen-dash-head">Loanee Application Details</h5>
        </div>
        <div class="text-right"><button ng-click="ApplicantDetails=null" class="btn btn-primary dev-btn">Back To List</button></div>
        <fieldset class="dvfieldset">
            <legend class="dvlegend">Application Details/आवेदक का विवरण</legend>
            <div class="col-lg-12">
                <div class="table-responsive">
                    <table class="table">
                        <tr>
                            <td colspan="8">
                                <div ng-init="IsAccountClose=0">
                                    <b>Does A/c close in same day</b>
                                    <label style="display:inline;"><input type="radio" value="1" name="IsAccountClose" ng-model="IsAccountClose" ng-change="GetApplicationDetails()" ng-disabled="ApplicantDetails.IsDisabledSingleAccountClose==1" /> Yes</label>
                                    <label style="display:inline;"><input type="radio" value="0" name="IsAccountClose" ng-model="IsAccountClose" ng-change="GetApplicationDetails()" ng-disabled="ApplicantDetails.IsDisabledSingleAccountClose==1" checked /> No</label>
                                    <input type="date" class="form-control inline datecalculator" style="width:130px" ng-show="IsAccountClose==1" ng-model="AccountCloseDate" ng-change="GetApplicationDetails()" min="2025-04-01" max="{{ today | date:'yyyy-MM-dd' }}" />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label>{{translation.LoanApplicationNo}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.LoanAccNo : ApplicantDetails.LoanAccNo }}
                            </td>
                            <td>
                                <label>{{translation.RegistrationNo}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.NoticeNo : ApplicantDetails.NoticeNo }}
                            </td>
                            <td>
                                <label>{{translation.PLDB}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.PLDBName: ApplicantDetails.PLDBName}}
                            </td>
                            <td>
                                <label>{{translation.PLDBBranch}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.PLDBBranch: ApplicantDetails.PLDBBranch}}
                            </td>

                        </tr>
                        <tr>
                            <td>
                                <label>{{translation.ApplicantName}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.ApplicantName: ApplicantDetails.ApplicantName}}
                            </td>
                            <td>
                                <label>{{translation.FatherHasbandName}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.FatherHusbandName : ApplicantDetails.FatherHusbandName }}
                            </td>
                            <td>
                                <label>{{translation.Gender}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.Gender: ApplicantDetails.Gender}}
                            </td>
                            <td>
                                <label>{{translation.MobileNo}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.MobileNo: ApplicantDetails.MobileNo}}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label>Outstanding as on 31-03-2025 (A)</label>
                            </td>
                            <td>
                                {{ApplicantDetails.PrincipalOutstandingAs31032025}}
                            </td>

                            <td>
                                <label>{{translation.RateOfInterest}} : </label>
                            </td>
                            <td>
                                {{ApplicantDetails.RateOfInterest}}
                            </td>

                            <td>
                                <label>{{translation.OtherInterestFrom}}(B) : @*(47*RateOFInterest + RateOfInterest*daysFrom1_4_2025)*@</label>
                            </td>
                            <td>
                                {{ApplicantDetails.OtherInterestAmt}}
                            </td>

                            <td>
                                <label>Current Penal Interest (C)</label>
                            </td>
                            <td>
                                {{ApplicantDetails.CurrentPenalInterestAmount}}
                            </td>

                        </tr>
                        <tr>
                            @*<td>
                                <label>Recovery Charges</label>
                            </td>
                            <td>
                                {{ApplicantDetails.RecoveryCharge|inrCurrency}}
                            </td>*@
                            <td>
                                <label>Recoverable Total Amount : @*(47*RateOFInterest + RateOfInterest*daysFrom1_4_2025)*@</label>
                            </td>
                            <td>
                                {{ApplicantDetails.EstimatedTotalAmount}}
                            </td>
                            <td>
                                <label>{{translation.AmountOfRecovery}} :</label>
                            </td>
                            <td>
                                {{ApplicantDetails.AlreadyPaidAmount}}
                            </td>
                            <td>
                                <label>Remaining Amount:</label>
                            </td>
                            <td>
                                {{ApplicantDetails.EstimatedTotalAmount-ApplicantDetails.AlreadyPaidAmount}}
                            </td>
                            <td>
                                <a ng-show="(ApplicantDetails.AlreadyPaidAmount)<(ApplicantDetails.EstimatedTotalAmount)" href="javascript:void(0)" class="btn btn-primary dev-btn mb-4" data-toggle="modal" data-target="#repaymentmodal">Pay Now</a>
                            </td>
                            <td></td>
                            <td></td>
                        </tr>

                    </table>
                </div>
            </div>
        </fieldset>
        <fieldset class="dvfieldset">
            <legend class="dvlegend">Payment Details/भुगतान का विवरण</legend>
            <div class="col-lg-12 profile-d">
                <div class="col-md-12 table-responsive ">
                    <table class="table table-responsive devtable" style="color:black">
                        <thead>
                            <tr>
                                <th> {{translation.SRNO}}</th>
                                <th>{{translation.ReceiptNo}}</th>
                                <th>{{translation.PaymentDate}}</th>
                                <th>{{translation.PaidAmount}}</th>
                                <th>{{translation.PaymentMode}}</th>
                                <th>{{translation.UTR_RefNo}}</th>
                                @*<th>{{translation.Status}}</th>*@
                                <th>{{translation.DepositorPerson}}</th>
                                <th>{{translation.Actions}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="li in paymentSummaryList">
                                <td>{{$index+1}}</td>
                                <td><span class="dev-spancon">{{li.ReceiptNo}}</span></td>
                                <td><span class="dev-spancon">{{li.PaymentDate|date:'dd-MM-yyyy'}}</span></td>
                                <td><span class="dev-spancon">{{li.PaidAmount1}}</span></td>
                                <td><span class="dev-spancon">{{li.PaymentMode}}</span></td>
                                <td>
                                    <span class="dev-spancon">{{li.UTR_RefNo}}</span>
                                    <div ng-show="li.PaymentModeId==2">
                                        Cheque No: {{li.ChequeNo}}
                                        Cheque Date: {{li.ChequeDate|date:'dd-MM-yyyy'}}
                                        Remark: {{li.ChequeOther}}
                                    </div>
                                </td>
                                @*<td><span class="dev-spancon">{{li.Status}}</span></td>*@
                                <td><span class="dev-spancon">{{li.DepositByPerson}}</span></td>
                                <td><span class="dev-spancon"><button ng-click="DownloadPreLoanPaymentReceipt(li.OTSRePaymentSummaryId,li.OtsIdEnc)" class="btn btn-xs btn-primary"> <i class="fa fa-print text-white"></i> </button></span></td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="paymentSummaryList==null">
                            <tr>
                                <td class="text-danger text-center" colspan="8">No payment has been deposited yet./अभी तक कोई भुगतान जमा नहीं किया गया है।</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </fieldset>
        <fieldset class="dvfieldset">
            <legend class="dvlegend">Ledger Details/खाता बही विवरण</legend>
            <div class="col-lg-12 clspanal" id="panel_od" ng-show="ApplicantDetails.ODPrincipal>0">
                <div class="table-responsive">
                    <table class="table devtable" id="tblPreLoanDetails">
                        <thead>
                            <tr>
                                <th colspan="6" style="text-align:center">{{translation.OD_1_7}}</th>
                                <th colspan="5" style="text-align:center">{{translation.OD_31_3}}</th>
                            </tr>
                            <tr>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.DateOfOD}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.ODPrincipal}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.InsurancePremium}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.ODInterest}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.PenalInterest}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.ODTotal}}</th>

                                <!--NOD-->
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.ODPrincipal}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.InsurancePremium}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.ODInterest}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.PenalInterest}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.ODTotal}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="text-align:center">{{ApplicantDetails.DateOfOD}}</td>
                                <td style="text-align:center">{{ApplicantDetails.ODPrincipal}}</td>
                                <td style="text-align:center">{{ApplicantDetails.ODInsurancePremium}}</td>
                                <td style="text-align:center">{{ApplicantDetails.ODInterest}}</td>
                                <td style="text-align:center">{{ApplicantDetails.ODPenalInterast}}</td>
                                <td style="text-align:center">{{ApplicantDetails.ODTotal}}</td>

                                <!--NOD-->
                                <td style="text-align:center">{{ApplicantDetails.NODPrincipal}}</td>
                                <td style="text-align:center">{{ApplicantDetails.NODInsurancePremium}}</td>
                                <td style="text-align:center">{{ApplicantDetails.NODInterest}}</td>
                                <td style="text-align:center">{{ApplicantDetails.NODPenalInterest}}</td>
                                <td style="text-align:center">{{ApplicantDetails.NODTotal}}</td>

                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="table-responsive">
                    <table class="table devtable" id="tblPreLoanDetails">
                        <thead>
                            <tr>
                                <th colspan="7" style="text-align:center">{{translation.CurrentDemandCD}}</th>
                            </tr>
                            <tr>
                                <!--cD-->
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.Principal}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.Interest}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.CDPenalInterest}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.TotalInterest}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.CDTotal}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.PrincipalOutstandingODNOD}}</th>
                                <th rowspan="3" class="thverticalMiddle" style="text-align:center">{{translation.TotalLoanOutstanding}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <!--cD-->
                                <td style="text-align:center">{{ApplicantDetails.CDPrincipal}}</td>
                                <td style="text-align:center">{{ApplicantDetails.CDInterest}}</td>
                                <td style="text-align:center">{{ApplicantDetails.CDPenalInterest}}</td>
                                <td style="text-align:center">{{ApplicantDetails.CDTotalInterest}}</td>
                                <td style="text-align:center">{{ApplicantDetails.CDTotal}}</td>
                                <td style="text-align:center">{{ApplicantDetails.PrincipalOutstandingODNOD}}</td>
                                <td style="text-align:center">{{ApplicantDetails.TotalLoanOutstanding}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>


            <div id="detailsofcasesunderact103" ng-show="ApplicantDetails.ODPrincipal<=0">

                <div class="col-lg-12 clspanal" id="DetailUndercase103">
                    <div class="table-responsive">
                        <table class="table devtable">
                            <thead>
                                <tr><th colspan="7" style="text-align:center">{{translation.detailsofcasesunderact103}}</th> </tr>
                                <tr>
                                    <th style="text-align:center">{{translation.resolutiondate}}</th>
                                    <th style="text-align:center">{{translation.principaloutstanding}}</th>
                                    <th style="text-align:center">{{translation.totalinterestasonresolutiondate}}</th>
                                    <th style="text-align:center">{{translation.totaloutstandingasonresolutiondate}}</th>
                                    <th style="text-align:center">{{translation.interestfromresolutionto30062024}}</th>
                                    <th style="text-align:center">{{translation.interestfrom30062024to31032025}}</th>
                                    <th style="text-align:center">{{translation.totalrecoverableamount}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>{{ApplicantDetails.DateOfSettlement}}</td>
                                    <td>{{ApplicantDetails.PrincipalOutstandingAsOnDateSettlement}}</td>
                                    <td>{{ApplicantDetails.TotalInterestAsOnDateSettlement}}</td>
                                    <td>{{ApplicantDetails.TotalLoanOutstandingAsOnDateSettlement}}</td>
                                    <td>{{ApplicantDetails.InterestFromSettlementPre}}</td>
                                    <td>{{ApplicantDetails.InterestFromSettlement}}</td>
                                    <td>{{ApplicantDetails.TotalAmount}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>

    <div id="repaymentmodal" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <b class="text-info">New Online Payment</b>
                    <a data-dismiss="modal" class="pull-right"><i class="fa fa-times"></i></a>
                </div>
                <div class="modal-body">

                    <form id="paymentForm" ng-submit="SavePayment()">
                        <table class="payment-table">
                            <tr>
                                <td>Deposit Amount (in Rupees):</td>
                                <td>
                                    <input type="number" class="form-control" ng-model="payObj.PaidAmount" placeholder="0.00" min="0" required />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" align="center">
                                    <input type="submit" class="btn btn-primary dev-btn" value="Process to Pay" />
                                    <input type="button" class="btn btn-danger" value="Cancel" data-dismiss="modal" />
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

