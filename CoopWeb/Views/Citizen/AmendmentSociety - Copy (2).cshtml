<script src="~/Scripts/AngularFramework/AmendmentSociety.js"></script>

<script>
    function DateCheck() {

        return true;
    }
    function EntrenceFeeCalculate(value) {
        if (value > 0) {
            if ($('#lblFeeCalculate').html() == "0") {
                $('#txtEntranceFees').val(0);
            }
            else {
                $('#txtEntranceFees').val(value * 11);
            }
        }
        else if (value == 0)
            $('#txtEntranceFees').val(0);

        CheckMembervalidetion();

    }
    function CheckMembervalidetion() {
        var NumberOfMembers = $('#txtTotalNumberOfMembers').val();
        var NoOfMemberInAGM = $('#txtNoOfMemberInAGM').val();
        if (NumberOfMembers != "" && NoOfMemberInAGM != "") {
            if (parseInt(NoOfMemberInAGM, 10) > parseInt(NumberOfMembers, 10)) {
                alert("No of Members who Participated in AGM should not be greater than Total Number of Members applying for the Society");
                $('#txtNoOfMemberInAGM').val("");
            }
        }
    }

    function ValidateAlphaNumericAndSlash(evt) {
        // alert(evt.keyCode);
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;
        if ((evt.which == 45 || evt.keyCode == 45 || evt.charCode == 45))
            return true;
        if ((evt.which == 95 || evt.keyCode == 95 || evt.charCode == 95))
            return true;

        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32) {
            //    alert("not cahr");
            if ((keyCode >= 48 && keyCode <= 57) || keyCode == 47) {
                //     alert(" num or slash");
                return true;
            }
            else {
                //    alert("not cahr and num");
                return false;
            }
        } else {
            //    alert("cahr");
            return true;
        }
    };


    function EntrenceFeeCalculate(value) {
        if (value > 0) {
            if ($('#lblFeeCalculate').html() == "0") {
                $('#txtEntranceFees').val(0);
            }
            else {
                $('#txtEntranceFees').val(value * 11);
            }
        }
        else if (value == 0)
            $('#txtEntranceFees').val(0);

        CheckMembervalidetion();

    }
   



</script>

