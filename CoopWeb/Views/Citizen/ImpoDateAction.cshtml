
@{
    ViewBag.Title = "ImpoDateAction";
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}
<script src="~/Scripts/AngularFramework/CitizenClient.js"></script>
<style>
    .heading-hr {
        font-size: 17px;
        font-weight: bold;
        /* margin: 0 20px 10px 15px; */
        background: #64c0c5;
        padding: 10px 15px;
        border-radius: 4px;
        color: #fff;
    }
</style>
<div ng-app="CitizenMod" ng-controller="CitizenCnt">

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head">{{translation.ImpoDateAction}}</h3>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.ImpoDateAction}} </span>
                </li>

                <li style="float: right;" id="divAddBtn">
                    @*<i class="fa fa-angle-double-right" style="color: #025e63;"></i>
                        <a ng-click="ShowUploadExcel()" style="color: #025e63; cursor: pointer; text-decoration:none; font-weight: bold;" class="ng-binding">{{translation.ExcelUpload}}</a>*@
                </li>


            </ul>
        </div>
    </div>

    <div class="col-md-12">
        <div class="table-responsive citizen-dash-head">
            <div class="table-dropdown">
                @*<div class="col-lg-12 form-group" style="margin-bottom:0px;">
                    <h5 class="heading-hr ng-binding">{{translation.ImpoDateAction}}</h5>
                </div>*@

                <div class="form-group col-md-12" style="margin-bottom:0px;">
                    <table class="table devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.Actions}}
                                </th>
                                <th>
                                    {{translation.Date}}
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1.</td>
                                <td>Next Election Date</td>
                                <td><a href="#"><span class="new badge2" ng-model="RegisteredSociety">25-Dec-2021</span></a></td>
                            </tr>
                            <tr>
                                <td>2.</td>
                                <td>Inspection Due Date</td>
                                <td><a href="#"><span class="new badge2 red" data-badge-caption="" ng-model="SUBMITTED">15-Aug-2019</span></a></td>
                            </tr>
                            <tr>
                                <td>3.</td>
                                <td>Next AGM Date</td>
                                <td><a href="#"><span class="new badge2" data-badge-caption="" ng-model="PartialSubmit">15-Aug-2019</span></a></td>
                            </tr>
                            <tr>
                                <td>4.</td>
                                <td>Society Election</td>
                                <td><a href="#"><span class="new badge2 brown" data-badge-caption="" ng-model="UNDERPROCESS">15-Aug-2019</span></a></td>
                            </tr>
                           
                        </tbody>
                    </table>
                   
                </div>
                <div class="form-group col-md-12">
                    <div class="dev-align-btn">

                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../Citizen/Index"> Back</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <div ng-show="divold" class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">
                    <label>{{translation.SocietyName}}</label>
                </div>
                <div class="col-lg-4">
                    <select class="form-control" id="DDLSocietyID" >
                        <option value="0" selected="selected" disabled>{{translation.SelectOption}}</option>
                        <option ng-repeat="item in SocietyList" value="{{item.SocietyIdENC}}">
                            {{item.SocietyName}}
                        </option>
                    </select>
                </div>

                <div class="col-lg-4">
                    <input class="form-check-input" type="button" name="Show Data" title="Show Data" value="Show Data" ng-click="GetImpoDateActionListData()" />


                </div>
            </div>

            <div class="col-lg-12 form-group">
                <table id="example" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th ng-click="sortData('TypeDetail')">
                                {{translation.TypeDetail}}
                                <div ng-class="getSortClass('TypeDetail')"></div>
                            </th>
                            @*<th ng-click="sortData('RegistrationNo')">
                                {{translation.SocietyRegistrationNo}}
                                <div ng-class="getSortClass('RegistrationNo')"></div>
                            </th>*@
                            <th>
                                {{translation.DataType}}
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @*<tr ng-repeat="item in TableData">*@
                        <tr dir-paginate="item in ImpoDateActionListData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: 100">

                            <td>{{$index+1}}</td>
                            <td>{{item.TypeDetail}}</td>
                            <td>{{item.DataDate}}</td>
                            @*<td>{{item.DataDate}}  </td>*@
                        @*    <td class="add-more-td">
    <a title="{{translation.ShowDetails}}" ng-click="ShowDetails(item.SocietyIdENC,'ShowDetails')"><i class="fa fa-info-circle infoicon-edit"></i></a>*@
                               @* <a title="{{translation.ShowDetails}}" ng-click="EditBasicDetailsForm(item.SocietyIdENC,item.ElectionMasterId)"><i class="fa fa-info-circle infoicon-edit"></i></a>
    <button type="button" class="btn btn-default btn-sm" ng-show="item.SubmitStatus==0" ng-click="EditBasicDetailsForm(item.SocietyIdENC,0);ShowDetailsWorkscope(item.SocietyIdENC)"><span class="glyphicon glyphicon-edit"></span> Edit</button>
                            </td>*@
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>

</div>

