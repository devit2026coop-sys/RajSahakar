<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };


    $(document).ajaxSend(function (e, xhr) {
        $.ajax({
            url: '../Login/Login',
            type: 'GET',
            global: false,
            success: function (session) {
                if (!session.isLogged) {
                    xhr.abort();

                    // This allows my framework to take care of the redirect
                    // and to remember the intended page,
                    // so it redirects back here after login:
                    location.reload();

                    // use this one to redirect directly to the login page:
                    // window.location.replace('login.php');
                }
            },
            dataType: 'json'
        });
    });



</script>

