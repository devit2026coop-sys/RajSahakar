<script>
    var myVar;
    $(document).ready(function () {
        $('#select-all').click(function (event) {
            if (this.checked) {
                // Iterate each checkbox
                $('.chk').each(function () {
                    this.checked = true;
                });
            } else {
                $('.chk').each(function () {
                    this.checked = false;
                });
            }
        });
        myVar = setInterval("SetOfficerData()", 3000);
    });
    var totalSeen = $("input#chk:checked").length;
    function SetOfficerData() {
        $('#tblPublish tr').each(function () {
            var OffiId = $(this).find('td:eq(2)').find('input').val();
            $(this).find('td:eq(2)').find('select').val(OffiId);
            if (OffiId != "0") {
                $(this).find('td:eq(2)').find('select').prop("disabled", "disabled");
            }
        });
        $("#divPrint").hide();
        clearInterval(myVar);
    }
</script>
