<script>
  
    $(document).ready(function () {
        //$('#HouseBuildingNo1_MemberAdd').css('display', 'none');
        //$('#LaneStreetName1_MemberAdd').css('display', 'none');
        //$('#Locality1_MemberAdd').css('display', 'none');
        //$('#ddlstate1_MemberAdd').css('display', 'none');
        //$('#ddlDivision1_MemberAdd').css('display', 'none');
        //$('#district1_MemberAdd').css('display', 'none');
        //$('#district1_MemberAdd').css('display', 'none');
        
        $('#select-all').click(function (event) {
            if (this.checked) {
                // Iterate each checkbox
                $('.chk').each(function () {
                    if ($(this).prop('disabled') == false) {
                        this.checked = true;
                    }
                });
            } else {
                // ($('table input[type=checkbox]').prop('disabled')) == true;
                $('.chk').each(function () {
                    if ($(this).prop('disabled') == false) {
                        this.checked = false;
                    }
                });
            }

        });



        $('#select-all-Society').click(function (event) {
            if (this.checked) {
                // Iterate each checkbox
                $('.chk').each(function () {
                    if ($(this).prop('disabled') == false) {
                        this.checked = true;
                    }
                });
            } else {
                // ($('table input[type=checkbox]').prop('disabled')) == true;
                $('.chk').each(function () {
                    if ($(this).prop('disabled') == false) {
                        this.checked = false;
                    }
                });
            }

        });

    });
    var totalSeen = $("input#chk:checked").length;
</script>
