        $(".devcalender").change(function () {

            
            if ($(this).attr("dat-val") != "" && $(this).attr("dat-val") != undefined) {
                var id = parseInt($(this).attr("dat-val"));

                var firstVal = 1;
                var prevId = id - 1;
                var nextId = id + 1;
                if (id > 9) {
                    prevId = id - 10;
                    nextId = id + 10;
                }

                //parseInt($(this).attr("dat-val").substring(0, 1))

                if (id == 12 || id == 22 || id == 32 || id == 42 || id == 52 || id == 62 || id == 72 || id == 82 || id == 92)
                    var firstVal = 12;
                if (id == 13 || id == 23 || id == 33 || id == 43 || id == 53 || id == 63 || id == 73 || id == 83 || id == 93)
                    var firstVal = 13;
                else if (id == 14 || id == 24 || id == 34 || id == 44 || id == 54 || id == 64 || id == 74 || id == 84 || id == 94)
                    var firstVal = 14;
                if (id == 15 || id == 25 || id == 35 || id == 45 || id == 55 || id == 65 || id == 75 || id == 85 || id == 95)
                    var firstVal = 15;

                //bhu
                if (id == 16 || id == 26 || id == 36 || id == 46 || id == 56 || id == 66 || id == 76 || id == 86 || id == 96)
                    var firstVal = 16;

                if (id == 17 || id == 27 || id == 37 || id == 47 || id == 57 || id == 67 || id == 77 || id == 87 || id == 97)
                    var firstVal = 17;

                if (id == 18 || id == 28 || id == 38 || id == 48 || id == 58 || id == 68 || id == 78 || id == 88 || id == 98)
                    var firstVal = 18;

                if (id == 19 || id == 29 || id == 39 || id == 49 || id == 59 || id == 69 || id == 79 || id == 89 || id == 99)
                    var firstVal = 19;

                if (id == 20 || id == 30 || id == 40 || id == 50 || id == 60 || id == 70 || id == 80 || id == 90 || id == 100)
                    var firstVal = 20;


                // if (id >= firstVal + 1) {
                var prevDate;
                if (prevId == 0) {
                    prevDate = new Date(new Date().getFullYear() + '/' + (new Date().getMonth() + 1) + '/' + new Date().getDate());
                } else {
                    prevDate = new Date($("#txtRegistrationDate" + prevId).val().split('/')[2] + '/' + $("#txtRegistrationDate" + prevId).val().split('/')[1] + '/' + $("#txtRegistrationDate" + prevId).val().split('/')[0]);
                }
