@{
    ViewBag.Title = "NCD-Service-Report";
}

<style>
    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }

    .tblthfont {
        font-weight: bold;
    }
</style>
<script src="~/Scripts/AngularFramework/NCD_Service_Report.js?v=1"></script>
<div ng-app="ncdPRMod" ng-controller="ncdPRCtrl" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; NCD State Details</b>
                <div class="text-right">
                    <button ng-click="BackToPage()" class="btn btn-primary dev-btn">Back To List</button>
                </div>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-2 form-group" ng-show="true">
                        <label for="NCD_Statecode">State Code</label>
                        <input type="text" ng-model="search.NCD_Statecode" name="NCD_Statecode" id="NCD_Statecode" class="form-control" />
                    </div>
                    @*<div class="col-lg-2 form-group">
                            <label for="Sector_Code">Sector Code</label>
                            <select id="Sector_Code" name="Sector_Code" ng-model="search.NCD_Sectorcode" ng-init="search.NCD_Sectorcode='0'" class="form-control">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in NCDSectorDetails  track by item.id" value="{{item.id}}">
                                    {{item.name}}
                                </option>
                            </select>
                        </div>*@
                    <div class="col-md-2 form-group" ng-show="true">
                        <label for="NCD_Statecode">Level Code</label>
                        <input type="text" ng-model="search.NCD_Levelcode" name="NCD_Levelcode" id="NCD_Levelcode" class="form-control" />
                    </div>
                    <div class="col-lg-2 form-group" style="padding-top: 26px;">
                        <div class="text-right">
                            <button ng-click="SaveNCDKhadiGramDetail()" class="btn btn-primary dev-btn">Add NCD</button>
                        </div>
                    </div>

                </div>
                <div class="table-responsive devtable">
                    <table class="table table-hover table-striped table-bordered mb-0">
                        <thead>
                            <tr>
                                <th width="60">{{translation.SRNO}}</th>
                                <th>State Code</th>
                                <th>{{translation.State }}</th>
                                <th>State Name (Hindi)</th>
                                <th>State UT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-if="NCDStateDetails && NCDStateDetails.length > 0" ng-repeat="item in NCDStateDetails">
                                <td><span>{{$index+1}}.</span></td>
                                <td>{{item.state_code}}</td>
                                <td> {{item.name }}</td>
                                <td>{{item.hindi_name}}</td>
                                <td>{{item.state_or_ut}}</td>
                            </tr>
                            <tr ng-if="(!NCDStateDetails || NCDStateDetails.length === 0)">
                                <td colspan="{{colspan}}" style="text-align: center;">No Records</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>