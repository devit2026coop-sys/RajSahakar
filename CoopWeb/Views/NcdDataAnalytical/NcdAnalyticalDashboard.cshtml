@{
    ViewBag.Title = "Anaytical Deshboard";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

        .form-control:not(select) {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

    .ncd-box {
        background: #ecf8ee !important;
        border: 1px dashed #ccc !important;
        padding: 20px;
        margin-bottom: 30px;
        width: 100%;
    }

    fieldset legend {
        border: none;
        background: #bf8313;
        width: auto;
        color: #ffffff;
        padding: 2px 10px;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }

    .tblthfont {
        font-weight: bold;
    }

    .d-flex {
        display: flex;
    }

    table thead th {
        background-color: #64c0c5 !important;
        color: #fff !important;
        text-align: center;
    }


    .scrollable-table {
        overflow-x: auto;
        max-height: 900px;
        overflow-y: auto;
        display: block;
    }

    .table {
        min-width: 500px; 
    }

        .table thead th {
            position: sticky;
            top: 0;
            background: #f8f9fa; /* Header background */
            z-index: 10;
        }

        .table th {
            white-space: nowrap;
        }

        .table td:nth-child(1),
        .table td:nth-child(2) {
            position: sticky;
            left: 0;
            background: #fff;
            z-index: 12;
            border-right: 1px solid #ddd;
        }

        .table th:nth-child(1),
        .table th:nth-child(2) {
            position: sticky;
            left: 0;
            background: #fff;
            z-index: 13;
            border-right: 1px solid #ddd;
        }

        .table td:nth-child(2),
        .table th:nth-child(2) {
            left: 45px;
            width: 45px;
            text-align: left;
        }


    .dashTabs > li > a {
        border: solid 1px #dddddd !important;
        padding: 8px 20px;
        color: #333;
        background: #e6feff;
    }

        .dashTabs > li > a:hover, .dashTabs > li > a:focus, .dashTabs > li.active > a, .dashTabs > li.active > a:hover {
            border: solid 1px #dddddd !important;
            background: #025e63 !important;
            color: #fff !important;
        }

    .dashTabsContent {
        border: solid 1px #dddddd !important;
        border-top: 0px !important;
    }
</style>


<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>

@*Added By Bhavesh*@

<script src="~/Scripts/AngularFramework/NcdAnalyticalDashboard.js"></script>

@*Added By Bhavesh*@
<script src="~/Scripts/zingchart.min.js"></script>
<script src="~/Scripts/zingchart-angularjs.js"></script>
<script src="~/Scripts/AngularFramework/ng-google-chart.min.js"></script>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script>
    google.charts.load("current", { packages: ["corechart"] });
</script>


<div ng-app="ncdAnaMod" ng-controller="ncdAnaCtrl" ng-cloak="">
    <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />

    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; NCD Anaytical Deshboard Bhavesh </b>
            </div>
            <div class="panel-body">
                <!-- Sector Society Table -->
                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-4" ng-if="FilteredSectors.length > 0">
                                <h4 class="text-center">SOCIETIES COUNT MORE THAN 22000</h4>
                                <div id="container"
                                     style="width: 100%; height: 450px; ">
                                </div>
                            </div>
                            <div class="alert alert-warning text-center" ng-show="FilteredSectors.length == 0">
                                No sector has more than 22,000 societies.
                            </div>

                            <div class="col-sm-4" ng-if="FilterBetween2000_22000.length > 0">
                                <h4 class="text-center">SOCIETIES COUNT BETWEEN 2,000 AND 22,000</h4>
                                <div id="containerr" style="width: 100%; height: 450px;"></div>
                            </div>
                            <div class="alert alert-warning text-center" ng-show="FilterBetween2000_22000.length == 0">
                                No sector has societies between 2,000 and 22,000.
                            </div>
                            <div class="col-sm-4" ng-if="FilterLess2000.length > 0">
                                <h4 class="text-center">SOCIETIES COUNT LESS THAN 2,000</h4>
                                <div id="containerrr" style="width: 100%; height: 450px;"></div>
                            </div>
                            <div class="alert alert-warning text-center" ng-show="FilterLess2000.length == 0">
                                No sector has less than 2,000 societies.
                            </div>
                        </div>

                        <div class="row" style="border: 1px solid #ccc; background: white;">
                            <div class="col-md-4">
                                <div id="CoveragePieChart" style="width:100%; height:400px;"> </div>
                            </div>

                            <div class="col-md-4">
                                <div id="RegisteredSocietyLineChart" style="width: 100%; height: 400px;"></div>
                            </div>
                        </div>

                        <div class="row" style="border: 1px solid #ccc; background: white;">
                            <h4 class="text-left">Functional Status of Cooperative Societies</h4>
                            <div class="col-md-4">
                                <div id="FunctionalStatusChart" style="width:100%; height:400px;"></div>
                            </div>

                            <div class="col-md-4">
                                <div id="FunctionalStatusChartDairy" style="width:100%; height:400px;"></div>
                            </div>

                            <div class="col-md-4">
                                <div id="FunctionalStatusChartFishery" style="width:100%; height:400px;"></div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
