<script src="~/Scripts/AngularFramework/ApplicationDocuments.js?id=10"></script>
<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }
</style>
<div ng-app="ApplicationStatusModule">
    <div ng-controller="ApplicationStatusCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">{{translation.ApplicationStatus}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>

                        <span style="margin: 0 5px;"> {{translation.ApplicationStatus}} </span>
                    </li>

                </ul>
            </div>
        </div>
        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter">
                        <div class="col-lg-12" style="margin-bottom: 10px; padding-left: 0;">
                            <div class="col-md-4">
                                <label for="search">Registration Number/BRN Number/Society Name *</label>
                                <input ng-model="Filter.SearchText" name="SearchText" id="search" class="form-control" placeholder="Registration Number/BRN Number/Society Name" autocomplete="off">
                            </div>
                            <div class="col-md-4  margin-Top20">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-click="GetApplication()" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 table-responsive ">
                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th class="info_news_slh_table_fix">Sr No.</th>
                                    <th>Society Name</th>
                                    <th>Act</th>
                                    <th>District</th>
                                    <th>SSO Id</th>
                                    <th>Uploaded By Excel ?</th>
                                    <th style="text-align: center">Registration Number</th>
                                    <th style="text-align: center">Submission Date</th>
                                    <th style="min-width: 95px;">Status</th>
                                    <th>History</th>
                                    <th>Documents</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in ApplicationList">
                                    <td>{{$index+1}}</td>
                                    <td>{{item.SocietyName}}</td>
                                    <td>{{item.ServiceName}}</td>
                                    <td>{{item.District}}</td>
                                    <td>{{item.ssoid}}</td>
                                    <td>{{item.UploadedByExcel}}</td>
                                    <td>{{item.ApplicationNo}}</td>
                                    <td>{{item.SubmissionDate}}</td>
                                    <td>{{item.Status}}</td>
                                    <td>
                                        <a title="{{translation.TakeAction}}" style="color:#505050;" href="javascript:void(0);" ng-click="update(item)">Show History</a>  
                                    </td>
                                    <td><a title="{{translation.TakeAction}}" style="color:#505050;" href="javascript:void(0);" ng-click="ShowDocuments(item)">Show Documents</a></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>


                    <div class="col-md-12 table-responsive ">
                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th class="info_news_slh_table_fix">Sr No.</th>
                                    <th>Documents Type</th>
                                    <th>Documents</th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in DocumentList">
                                    <td>{{$index+1}}</td>
                                    <td>{{item.DocumentName}}</td>
                                    <td><a href="~/Content/SocietyProfiling/{{item.DocumentURL}}" target="_blank"><i class="fa fa-arrow-up"></i></a></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th class="info_news_slh_table_fix">Sr No.</th>
                                    <th>Documents</th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in DocumentAllList">
                                    <td>{{$index+1}}</td>
                                    <td><a href="~/Content/SocietyProfiling//{{item}}" target="_blank">{{item}}</a></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
        <div class="se-pre-con"></div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>

        <div class="dev-popup-body modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content" style="width:800px">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearAppFlowForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.ApplicationFlow}} </h4>
                    </div>
                    <div class="modal-body">
                        <div class="table-responsive">
                            <table class="table table-responsive devtable" style="margin-top: 30px;color:black" id="a">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.Status}}
                                        </th>
                                        <th>{{translation.AssignTo}}</th>
                                        <th>
                                            {{translation.Remarks}}
                                        </th>
                                        <th>
                                            {{translation.CreationDate}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="AppFlowOne in ApplicationFlowSociety | itemsPerPage: 10">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ _language =='en-us' ? AppFlowOne.ProceesStatusTextEn : AppFlowOne.ProceesStatusTextHi}}</td>
                                        <td>{{AppFlowOne.OfficerNameEn}}</td>
                                        <td>{{AppFlowOne.Remark}}</td>
                                        <td>{{AppFlowOne.ActionDate}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>                        
                    </div>
                </div>
            </div>
        </div>
    </div>  
</div>