<div ng-app="ApplicationFlowModule">
    <div ng-controller="ApplicationFlowCont" ng-cloak="">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">{{translation.ApplicationFlow}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> {{translation.ApplicationFlow}} </span>
                    </li>

                </ul>
            </div>
        </div>
        <div class="dev-popup-body modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-lg">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearAppFlowForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.ApplicationFlow}} </h4>
                    </div>
                    <div class="modal-body">
                        <div class="table-responsive">
                            <table class="table table-responsive devtable" style="margin-top: 30px;color:black" id="a">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.Status}}
                                        </th>
                                        <th>{{translation.AssignTo}}</th>
                                        <th>
                                            {{translation.Remarks}}
                                        </th>
                                        <th>
                                            {{translation.CreationDate}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="AppFlowOne in ApplicationFlowSociety | itemsPerPage: 10">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ _language =='en-us' ? AppFlowOne.ProceesStatusTextEn : AppFlowOne.ProceesStatusTextHi}}</td>
                                        <td>{{AppFlowOne.OfficerNameEn}}</td>
                                        <td>{{AppFlowOne.Remark}}</td>
                                        <td>{{AppFlowOne.ActionDate}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <form class="dev-search-form" name="MyClassForm" ng-show="BaseUserId==ApplicationFlowMaster.UserId" style="overflow: hidden; margin-bottom:35px;">
                            <div class="col-md-6" ng-hide="ShowOTPDiv">
                                <label>
                                    {{translation.Status}} :
                                </label>
                                <select ng-model="ApplicationFlowMaster.StatusId" class="form-control" ng-init="ApplicationFlowMaster.StatusId='0'" ng-change="GetRoleList()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in SocietyProceesStatus" value="{{item.SocietyProceesStatusId}}">
                                        {{_language =='en-us' ?  item.ProceesStatusTextEn : item.ProceesStatusTextHi}}
                                    </option>
                                </select>
                            </div>

                            @*Bank*@
                            <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==37" id="BankID">
                                <div>
                                    <label>
                                        {{translation.BankName}}
                                    </label>
                                    <select id="BankID" name="CCBBANK_ID" ng-model="ApplicationFlowMaster.LoanBankID" ng-change="GetOfficer(ApplicationFlowMaster.StatusId,ApplicationFlowMaster.LoanBankID)" class="form-control" ng-init="ApplicationFlowMaster.LoanBankID = '0'">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in BankList | orderBy:'BLOCK_ENG'" value="{{itemBlock.CCBId}}">
                                            {{_language =='en-us' ?  itemBlock.CCBNameEn : itemBlock.CCBNameHi}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            @*Branch*@
                            <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==38" id="BranchId">
                                <label>
                                    {{translation.BankBranch}}
                                </label>
                                <select id="BranchID" name="PLDB_Branch_ID" ng-model="ApplicationFlowMaster.LoanBranchId" class="form-control" ng-change="GetOfficer(ApplicationFlowMaster.StatusId,ApplicationFlowMaster.LoanBranchId)" ng-init="ApplicationFlowMaster.LoanBranchId = '0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="itemBlock in BranchList | orderBy:'BLOCK_ENG'" value="{{itemBlock.Branch_ID}}">
                                        {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameHi}}
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-6" ng-hide="ShowOTPDiv">
                                @*<div ng-show="ApplicationFlowMaster.StatusId==3 || ApplicationFlowMaster.StatusId==9 || ApplicationFlowMaster.StatusId==12 || ApplicationFlowMaster.StatusId==19 || ApplicationFlowMaster.StatusId==23 || ApplicationFlowMaster.StatusId==35|| ApplicationFlowMaster.StatusId==36 || ApplicationFlowMaster.StatusId==1058">*@
                                <div ng-show="(ApplicationFlowMaster.StatusId==3 || ApplicationFlowMaster.StatusId==9 || ApplicationFlowMaster.StatusId==12 || ApplicationFlowMaster.StatusId==19 || ApplicationFlowMaster.StatusId==23 || ApplicationFlowMaster.StatusId==35|| ApplicationFlowMaster.StatusId==36  || ApplicationFlowMaster.StatusId==39 || ApplicationFlowMaster.StatusId==40 ||ApplicationFlowMaster.StatusId==41 || ApplicationFlowMaster.StatusId==1058 ||  ApplicationFlowMaster.StatusId==43) || (ApplicationFlowMaster.StatusId==37 && ApplicationFlowMaster.LoanBankID > 0) || (ApplicationFlowMaster.StatusId==38 && ApplicationFlowMaster.LoanBranchId > 0 )">
                                    <label>
                                        {{translation.RoleHeading}} :
                                    </label>
                                    <select ng-model="RoleId" class="form-control" id="ddlRole" ng-init="RoleId=0" ng-change="GetOfficer()">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in RoleList " value="{{item.RoleID}}">
                                            {{ item.RoleName_EN }}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6" ng-hide="ShowOTPDiv">
                                @*<div ng-show="ApplicationFlowMaster.StatusId==3 || ApplicationFlowMaster.StatusId==9 || ApplicationFlowMaster.StatusId==12 || ApplicationFlowMaster.StatusId==19 || ApplicationFlowMaster.StatusId==23 || ApplicationFlowMaster.StatusId==35 || ApplicationFlowMaster.StatusId==36 || ApplicationFlowMaster.StatusId==1058">*@
                                <div ng-show="ApplicationFlowMaster.StatusId==3 || ApplicationFlowMaster.StatusId==9 || ApplicationFlowMaster.StatusId==12 || ApplicationFlowMaster.StatusId==19 || ApplicationFlowMaster.StatusId==23 || ApplicationFlowMaster.StatusId==35 || ApplicationFlowMaster.StatusId==36   || ApplicationFlowMaster.StatusId==39 || ApplicationFlowMaster.StatusId==40 ||ApplicationFlowMaster.StatusId==41 || ApplicationFlowMaster.StatusId==1058 || ApplicationFlowMaster.StatusId==43 || (ApplicationFlowMaster.StatusId==37 && ApplicationFlowMaster.LoanBankID > 0) || (ApplicationFlowMaster.StatusId==38 && ApplicationFlowMaster.LoanBranchId > 0)">
                                    <label>
                                        {{translation.Officer}} :
                                    </label>
                                    <select ng-model="ApplicationFlowMaster.OfficeId" id="ddlOffice" class="form-control" ng-init="ApplicationFlowMaster.OfficeId='0'">
                                        @*<option value="0" disabled>{{translation.SelectOption}}</option>*@
                                        <option ng-repeat="item in OfficerData " value="{{item.userid}}">
                                            {{ item.OfficerNameEn }}
                                        </option>
                                    </select>
                                </div>

                            </div>



                            <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==39  || ApplicationFlowMaster.StatusId==40 || ApplicationFlowMaster.StatusId==41">
                                <input type="hidden" class="form-control" ng-model="ApplicationFlowMaster.BankDetailId" />
                                <label>Capital Amount <span class="error">*</span></label>
                                <input type="text" class="form-control" ng-model="ApplicationFlowMaster.CapitalAmount" ng-readonly="ApplicationFlowMaster.StatusId != 39" placeholder="0.00" maxlength="10" onkeypress='return (event.charCode >= 48 && event.charCode <= 57) || event.charCode==46' autocomplete="off" />
                            </div>

                            <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==39  || ApplicationFlowMaster.StatusId==40 || ApplicationFlowMaster.StatusId==41">
                                <label class="mt-2">Account Number  <span class="error">*</span></label>
                                <input type="text" class="form-control" ng-model="ApplicationFlowMaster.AccountNumber" ng-readonly="ApplicationFlowMaster.StatusId != 39" placeholder="Enter Account Number" />
                            </div>

                            <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==39  || ApplicationFlowMaster.StatusId==40 || ApplicationFlowMaster.StatusId==41">
                                <label class="mt-2">IFSC Code  <span class="error">*</span></label>
                                <input type="text" class="form-control" ng-model="ApplicationFlowMaster.IFSCCode" ng-readonly="ApplicationFlowMaster.StatusId != 39" maxlength="12" placeholder="Enter IFSC Code" />
                            </div>

                            <div class="col-md-6" style="padding-top:5px">
                                <label class="mt-2" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==39">Upload Receipt <span class="error">*</span></label>
                                <div class="formDocViews">
                                    <input type="file" accept="application/pdf" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==39" class="form-control" id="flReceiptFile" ng-model="ApplicationFlowMaster.RecieptPath"
                                           onchange="angular.element(this).scope().SelectReceiptFile(this.files)" style="border:solid 1px #ccc !important;">
                                    <div ng-hide="ShowOTPDiv" ng-if=" ApplicationFlowMaster.StatusId == 39 || ApplicationFlowMaster.StatusId == 40 || ApplicationFlowMaster.StatusId == 41">
                                        <a ng-if="ApplicationFlowMaster.RecieptPath" title="View Receipt" href="/Content/SocietyBankReciept/{{ApplicationFlowMaster.RecieptPath}}" target="_blank" class="btn btn-success">
                                            <i class="fa fa-file-o"></i>
                                        </a>
                                        <a href="javascript:void(0)" class="btn btn-danger" title="Remove" ng-click="RemoveLoanDocument()" ng-if="ApplicationFlowMaster.StatusId==39 && ApplicationFlowMaster.RecieptPath" ng-hide="isViewMode">
                                            <i class="fa fa-trash-o"></i>
                                        </a>

                                    </div>
                                </div>

                            </div>


                            @*Pacs Code*@
                            <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId == 45">
                                <label class="mt-2">Pacs Code</label>
                                <input type="text" class="form-control" ng-model="ApplicationFlowMaster.PACS_Code" maxlength="12" placeholder="Enter Pacs Code" />
                            </div>

                            @* Is Pacs Membership Registered *@
                            <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId == 45">
                                <label class="mt-2 d-block">Is Pacs Membership Registered</label>
                                <label class="mr-3"> <input type="radio" ng-model="ApplicationFlowMaster.IsPacsMembershipReg" ng-value="1" />  Yes </label>
                                <label>  <input type="radio" ng-model="ApplicationFlowMaster.IsPacsMembershipReg" ng-value="0" /> No </label>
                            </div>

                            <div class="col-md-12">
                                <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId == 45 && ApplicationFlowMaster.IsPacsMembershipReg == 1">
                                    <label class="mt-2">Membership Application Date</label>
                                    <input type="date" class="form-control" ng-model="ApplicationFlowMaster.membershipRegDate" placeholder="Select Date" />
                                </div>

                                <div class="col-md-6" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId == 45 && ApplicationFlowMaster.IsPacsMembershipReg == 1">
                                    <label class="mt-2">Membership Date</label>
                                    <input type="date" class="form-control" ng-model="ApplicationFlowMaster.membershipAllotDate" placeholder="Select Date" />
                                </div>
                            </div>

                            @*Membership Remark*@
                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId == 45 && ApplicationFlowMaster.IsPacsMembershipReg == 0">
                                <label>Reason For no Membership</label>
                                <textarea type="text" rows="4" cols="50" class="form-control" id="Remarks" name="Remarks" ng-bind="Remarks" ng-model="ApplicationFlowMaster.membershipRemark" placeholder="Reason For no Membership"></textarea>
                            </div>

                            @*Common Remark *@
                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv">
                                <label>{{translation.Remarks}}</label>
                                <textarea type="text" rows="4" cols="50" class="form-control" id="Remarks" name="Remarks" ng-bind="Remarks" ng-model="ApplicationFlowMaster.Remark" placeholder={{translation.Remarks}}></textarea>
                                <code style="float: left;">
                                </code>
                                @*<input type="hidden" class="form-control hindiFont" id="txtRemark" ng-bind="Remarks" ng-model="ApplicationFlowMaster.Remark" />
                                    <textarea type="text" rows="4" cols="50" class="form-control hindiFont" name="Remarks" onblur="convert_to_unicode(this,'txtRemark')"  placeholder={{translation.Remarks}}></textarea>*@
                            </div>

                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==1065">
                                <label>{{translation.Amount}}</label>
                                <input type="text" rows="4" cols="50" class="form-control" id="AmendmendAmount" name="AmendmendAmount" ng-model="ApplicationFlowMaster.AmendmendAmount" placeholder={{translation.Amount}} />
                            </div>
                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==1065">
                                <label>{{translation.ReceiptNumber }}</label>
                                <input type="text" rows="4" cols="50" class="form-control" id="AmendmendAmountReceipt" name="AmendmendAmountReceipt" ng-model="ApplicationFlowMaster.ReceiptNumber" placeholder={{translation.ReceiptNumber}} />
                            </div>

                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv">
                                <div ng-show="ApplicationFlowMaster.StatusId==36">
                                    <div class="col-md-3">
                                        <label>
                                            {{translation.File}} :
                                        </label>
                                    </div>
                                    <div class="col-md-8" style="text-align:left">
                                        <input type="file" name="File" filetype='pdf' id="flReportFile" class="form-control" ng-model="ApplicationFlowMaster.ReportFile" onchange="angular.element(this).scope().UploadReportFile(this.files)">
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv">
                                <div class="citizen-dash-head col-md-3" ng-show="ApplicationFlowMaster.StatusId==5 || ApplicationFlowMaster.StatusId==10 || ApplicationFlowMaster.StatusId==20">
                                    <label>{{translation.ObjectionBelongTo}}</label>
                                </div>
                                <div class="citizen-dash-head col-md-9" style="text-align:left" ng-show="ApplicationFlowMaster.StatusId==5 || ApplicationFlowMaster.StatusId==10 || ApplicationFlowMaster.StatusId==20">
                                    <input type="checkbox" style="" name="Basic" ng-model="ObjectionFlagBasic"> {{translation.SocietyDetails}}
                                    <input type="checkbox" style="padding-left:15px;margin-left:15px" name="Administrative" ng-model="ObjectionFlagAdmin"> {{translation.AdministrativeDetails}}
                                    <input type="checkbox" style="padding-left:15px;margin-left:15px" name="Office" ng-model="ObjectionFlagOffice"> {{translation.SocietyOfficeDetails}}
                                </div>
                            </div>
                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv">
                                @*<div class="dev-menu-btn" style="display:none">
                                        <button type="submit" class="btn btn-primary" ng-click="SaveSocietyApplicationFlowStatus()">{{translation.Submit}}</button>
                                        <button type="submit" class="btn btn-primary" ng-click="ClearAppFlowForm()">{{translation.Clear}}</button>
                                    </div>
                                    <div class="dev-menu-btn">
                                        <button type="submit" class="btn btn-primary" ng-click="SaveSocietyApplicationFlowStatus()" ng-if="ApplicationFlowMaster.StatusId != 17">
                                            {{translation.Submit}}
                                        </button>
                                        <button type="button" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId == 17 &&  ApplicationFlowMaster.IsEsignStage > 0 && ApplicationFlowMaster.IsEsignStage!=null && ApplicationFlowMaster.IsEsignStage==1" ng-click="RedirectToESPportalOTP(1)">
                                            Generate Certificate
                                        </button>
                                        <button type="button" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId == 17 &&  ApplicationFlowMaster.IsEsignStage > 0 && ApplicationFlowMaster.IsEsignStage!=null && ApplicationFlowMaster.IsEsignStage==2" ng-click="RedirectToESPportalOTP(2)">
                                            Generate Member
                                        </button>
                                        <button type="button" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId == 17 &&  ApplicationFlowMaster.IsEsignStage > 0 && ApplicationFlowMaster.IsEsignStage!=null && ApplicationFlowMaster.IsEsignStage==3" ng-click="RedirectToESPportalOTP(3)">
                                            Esign Bylaws
                                        </button>
                                        <button type="button" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId == 17 &&  ApplicationFlowMaster.IsEsignStage > 0 && ApplicationFlowMaster.IsEsignStage!=null && ApplicationFlowMaster.IsEsignStage==4" ng-click="RedirectToESPportalOTP(4)">
                                            Esign Objective
                                        </button>
                                    </div>*@
                                <div class="dev-menu-btn">

                                    <!-- Submit -->
                                    <button type="submit" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId != 17" ng-click="SaveSocietyApplicationFlowStatusNew()">
                                        {{translation.Submit}}
                                    </button>

                                    <!-- Generate Certificate -->
                                    <button type="button" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId == 17 && ApplicationFlowMaster.IsEsignStage == 1" ng-click="RedirectToESPportalOTP(1)">
                                        Generate Certificate
                                    </button>

                                    <!-- Generate Member -->
                                    <button type="button" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId == 17 && ApplicationFlowMaster.IsEsignStage == 2" ng-click="RedirectToESPportalOTP(2)">
                                        Generate Member
                                    </button>

                                    <!-- Esign Bylaws -->
                                    <button type="button" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId == 17 && ApplicationFlowMaster.IsEsignStage == 3" ng-click="RedirectToESPportalOTP(3)">
                                        Esign Bylaws
                                    </button>

                                    <!-- Esign Objective -->
                                    <button type="button" class="btn btn-primary" ng-if="ApplicationFlowMaster.StatusId == 17 && ApplicationFlowMaster.ActId != 7 && ApplicationFlowMaster.IsEsignStage == 4" ng-click="RedirectToESPportalOTP(4)">
                                        Esign Objective
                                    </button>
                                    <button type="button" class="btn btn-primary" ng-click="ClearAppFlowForm()">
                                        {{translation.Clear}}
                                    </button>

                                </div>
                            </div>

                            <div class="form-group col-md-6" ng-show="ShowOTPDiv">
                                <label>{{translation.EnterOTP}}</label>
                                <input type="text" class="form-control" name="OTP" ng-bind="OTP" ng-model="ApplicationFlowMaster.OTP" placeholder={{translation.EnterOTP}} autocomplete="off" /><br />
                                <button type="submit" class="btn btn-primary" ng-click="VerifyOTP()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="SaveSocietyApplicationFlowStatus()">{{translation.ReSendOTP}}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <div class="dev-popup-body modal fade" id="myModalNotAssign" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <div class="modal-content" style="width:800px">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearAppFlowForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.ApplicationFlow}} </h4>
                    </div>
                    <div class="modal-body">
                        <div class="table-responsive">
                            <table class="table table-responsive devtable" style="margin-top: 30px;color:black" id="a">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.Status}}
                                        </th>
                                        <th>{{translation.AssignTo}}</th>
                                        <th>
                                            {{translation.Remarks}}
                                        </th>
                                        <th>
                                            {{translation.CreationDate}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="AppFlowOne in ApplicationFlowSociety | itemsPerPage: 10">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ _language =='en-us' ? AppFlowOne.ProceesStatusTextEn : AppFlowOne.ProceesStatusTextHi}}</td>
                                        <td>{{AppFlowOne.OfficerNameEn}}</td>
                                        <td>{{AppFlowOne.Remark}}</td>
                                        <td>{{AppFlowOne.ActionDate}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <form class="dev-search-form" name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                            <div class="col-md-6">
                                <label>
                                    {{translation.Officer}} :
                                </label>
                                <select ng-model="ApplicationFlowMaster.OfficeId" id="ddlOffice" class="form-control" ng-init="ApplicationFlowMaster.OfficeId='0'">
                                    <option value="0">{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in OfficerNotAssignData " value="{{item.UserId}}">
                                        {{ item.OfficerNameEn }}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <span style="color: #964c4c;    font-weight: bold;">{{DivTextForNotMaaped}}</span>
                            </div>
                            <div class="clearfix"></div>
                            <div class="form-group col-md-12" style="margin-top:20px;">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-click="SavePermanentSocietyData()">{{translation.Submit}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">
                        <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">
                            <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                            <input type="hidden" id="hdnbankId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).GccId)" />
                            <input type="hidden" id="hdnUserId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserId)" />
                            <input type="hidden" id="hdnUserRoleMappingId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserRoleDeptMappingId)" />
                            <div class="col-md-2 margin-Top20" style="padding-left: 0;" id="ddrDistrictId">
                                <label>{{ translation.DistrictHeading}}:</label>
                                <select name="DISTRICT_ID" ng-model="DISTRICT_ID" class="form-control">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                        {{_language =='en-us' ?  district.DISTRICT_ENG : district.DISTRICT_MANGAL}}
                                    </option>
                                </select>
                            </div>
                            <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
