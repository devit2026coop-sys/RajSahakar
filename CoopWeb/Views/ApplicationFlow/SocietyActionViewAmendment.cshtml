<script type="text/javascript">
    function OnSuccess(data) {
        $('#preloader').hide();
        if (data.UserType == 'C') {
            $('#FormPost').html(data.result);
            $('#FormPost').find('form').submit();
        }
        else {
            if (data.result == '1') {
                alert('Payment Successful Received');
                window.location = "../Citizen/SocietyProfile";
            }
            else {
                ShowModelAlert("Society Administrative Details", 'Issue in Payment Receiveing Please Try after Some time');
            }
        }
    }
    function OnFailure(data) {
        $('#preloader').hide();
    }
    function OnBegin() {
        $('#preloader').show();
    }
</script>

<style>
    label {
        display: inline-block;
        width: 100% !important;
        margin-bottom: 5px;
        font-weight: 700;
    }

    .zoom {
        transition: transform .2s; /* Animation */
        margin: 0 auto;
    }

        .zoom:hover {
            padding-left: 30px;
            transform: scale(2.5); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }
</style>
