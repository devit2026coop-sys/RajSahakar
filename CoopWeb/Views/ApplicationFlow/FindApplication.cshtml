<script src="~/Scripts/AngularFramework/FindApplication.js?id=0"></script>
<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }
</style>
<div ng-app="ApplicationStatusModule">
    <div ng-controller="ApplicationStatusCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">{{translation.ApplicationStatus}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>

                        <span style="margin: 0 5px;"> {{translation.ApplicationStatus}} </span>
                    </li>

                </ul>
            </div>
        </div>   
        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter">
                        <div class="col-lg-12" style="margin-bottom: 10px; padding-left: 0;">
                            <div class="col-md-4">
                                <label for="search">Registration Number/BRN Number/Society Name *</label>
                                <input ng-model="Filter.SearchText" name="SearchText" id="search" class="form-control" placeholder="Registration Number/BRN Number/Society Name" autocomplete="off">
                            </div>
                            <div class="col-md-4  margin-Top20">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-click="GetApplication()" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 table-responsive ">
                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th>
                                        #
                                    </th>
                                    <th ng-click="sortData('SocietyName')">
                                        {{translation.SocietyName}}
                                        <div ng-class="getSortClass('SocietyName')"></div>
                                    </th>
                                    <th style=" min-width: 125px;">
                                        {{translation.RegistrationNo}}
                                    </th>
                                    <th>
                                        {{translation.AssignTo}}
                                    </th>
                                    <th>
                                        {{translation.Status}}
                                    </th>
                                    <th>
                                        {{translation.Remarks}}
                                    </th>
                                    <th style=" min-width: 115px;">
                                        {{translation.CreationDate}}
                                    </th>
                                    <th style=" min-width: 115px;">
                                        Overdue(Days)
                                    </th>
                                    <th>
                                        {{translation.Actions}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="AppFlow in ApplicationList">
                                    <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>

                                    <td>
                                        <b> <i ng-click="SocietyView(AppFlow.SocietyIDEnc)">{{AppFlow.SocietyName }}</i></b>
                                    </td>
                                    <td>{{AppFlow.RegistrationNo}}  </td>
                                    <td>{{ _language =='en-us' ? AppFlow.OfficerNameEn : AppFlow.OfficerNameHi}}</td>
                                    <td>{{ _language =='en-us' ? AppFlow.ProceesStatusTextEn : AppFlow.ProceesStatusTextHi}}</td>
                                    <td>{{AppFlow.Remark}}</td>
                                    <td>{{AppFlow.ActionDate}}</td>
                                    <td style="text-align:center">{{AppFlow.OverDue=='0'?'':AppFlow.OverDue}}</td>
                                    <td>
                                        <a title="{{translation.ShowDetails}}" style="color:#505050;" href="../ApplicationFlow/ChangeApplicationStatus?SocietyIDEnc={{AppFlow.SocietyIDEnc}}~_ApplicationFlow_ApplicationFlow" target="_blank"><i class="fa fa-info-circle infoicon-edit"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>            
        </div>
        <div class="se-pre-con"></div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>
    </div>
   
</div>