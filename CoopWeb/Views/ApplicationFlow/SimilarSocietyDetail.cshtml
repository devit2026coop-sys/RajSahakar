<div ng-app="SimilarSocietyViewMod" ng-controller="SimilarSocietyViewCnt" ng-cloak="">
    <input type="hidden" id="hdnResponse" value="@ViewBag.response" />
    <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
    <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h5 style="text-align:center;font-size: 17px;background:#025e63;color:#fff;" class="citizen-dash-head" ng-if="SocietyDetailsData.BasicDetails.ActId==1">Registration of Societies under Rajasthan Societies Act, {{SocietyDetailsData.BasicDetails.ActId==1?'1958':SocietyDetailsData.BasicDetails.ActId==3?'2001':SocietyDetailsData.BasicDetails.ActId==7?'2005':''}}/राजस्थान सोसायटी अधिनियम, {{SocietyDetailsData.BasicDetails.ActId==1?'1958':SocietyDetailsData.BasicDetails.ActId==3?'2001':SocietyDetailsData.BasicDetails.ActId==7?'2005':''}} के अंतर्गत सोसायटी का पंजीकरण</h5>
        <h5 style="text-align:center;font-size: 17px;background:#025e63;color:#fff;" class="citizen-dash-head" ng-if="SocietyDetailsData.BasicDetails.ActId==3">Registration of Cooperative Societies under Rajasthan Cooperative Societies Act, {{SocietyDetailsData.BasicDetails.ActId==1?'1958':SocietyDetailsData.BasicDetails.ActId==3?'2001':SocietyDetailsData.BasicDetails.ActId==7?'2005':''}}/राजस्थान सहकारी सोसायटी अधिनियम, {{SocietyDetailsData.BasicDetails.ActId==1?'1958':SocietyDetailsData.BasicDetails.ActId==3?'2001':SocietyDetailsData.BasicDetails.ActId==7?'2005':''}} के अंतर्गत सहकारी सोसायटी का पंजीकरण</h5>
        <h5 style="text-align:center;font-size: 17px;background:#025e63;color:#fff;" class="citizen-dash-head" ng-if="SocietyDetailsData.BasicDetails.ActId==7">Registration of Societies under Rajasthan Societies Act, {{SocietyDetailsData.BasicDetails.ActId==1?'1958':SocietyDetailsData.BasicDetails.ActId==3?'2001':SocietyDetailsData.BasicDetails.ActId==7?'2005':''}}/राजस्थान सोसायटी अधिनियम, {{SocietyDetailsData.BasicDetails.ActId==1?'1958':SocietyDetailsData.BasicDetails.ActId==3?'2001':SocietyDetailsData.BasicDetails.ActId==7?'2005':''}} के अंतर्गत सोसायटी का पंजीकरण</h5>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 px-0" id="printTable">
        <fieldset class="">             
            
                <div class="" style="margin-top: 30px;">               

                    <div>
                        <div class="col-md-12">
                            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">Similar Societies Details</h3>
                        </div>

                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="devpage-breadcrumb">
                                <ul class="page-breadcrumb">
                                    <li class="dev-page-br">
                                        <i class="fa fa-home"> </i>
                                        <a href="#">  {{translation.Home}}</a> <i class="fa fa-angle-right"> </i>
                                    </li>
                                    <li style="float: left">
                                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                                        <i class="fa fa-angle-right"> </i>
                                        <span style="margin: 0 5px;"> Similar Societies Details </span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-12">
                        <div class="citizen-dash-head">
                            <div class="dev-search-form">
                                <div class="col-md-3">
                                    <label for="search">{{translation.Search}}:</label>
                                    <input ng-model="q" id="search" class="form-control" placeholder="Filter text">
                                </div>
                                <div class="col-md-3">
                                    <label for="search">{{translation.ItemPerPage}}:</label>
                                    <input type="number" min="1" max="2000" class="form-control" ng-model="pageSize">
                                </div>

                                <div class="col-md-6" style="margin-top:24px;text-align:right">
                                    <a class="btn btn-primary" ng-click="goBack()">
                                        <i class="fa fa-chevron-left" aria-hidden="true"></i>  Back
                                    </a>
                                </div>
                                <div class="clear"></div>                             

                            </div>


                            <div class="col-md-12 table-responsive "style="margin-top:10px;">
                                <table class="table table-responsive devtable" style="color:black">
                                    <thead>
                                        <tr>
                                            <th>{{translation.SRNO}}</th>
                                            <th>Society Name</th>
                                            <th>Registration No</th>
                                            <th>Registration Date</th>
                                            <th>Applied Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr dir-paginate="AppFlowOne in SimilarSocietyDetail | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="lovPagination">
                                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                            <td>{{AppFlowOne.SocietyName}}</td>
                                            <td>{{AppFlowOne.RegistrationNo}}</td>
                                            <td>{{AppFlowOne.RegistrationDate | date:'dd/MM/yyyy'}}</td>
                                            <td>{{AppFlowOne.CreationDate | date:'dd/MM/yyyy'}}</td>
                                            <td>{{AppFlowOne.ProceesStatusTextEn}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="col-md-6">
                                    <b>Total Records: {{SimilarSocietyDetail.length}}</b>
                                </div>
                                <div class="col-md-6">
                                    <div style="text-align:end;">
                                        <dir-pagination-controls boundary-links="true" pagination-id="lovPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
           
        </fieldset>        
    </div> 
    
    @Html.Partial("_AadhaarValidation")
</div>
<input type="hidden" name="hdlang" id="hdlang" value="hi-IN" />

<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />

<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }
</style>
<script src="~/Scripts/google_hindi/google_transapi.js"></script>

<script type="text/javascript">
    google.load("elements", "1", {
        packages: "transliteration"
    });

    function onLoad() {
        var content = document.getElementById('content');
        if (document.getElementById('hdlang').value == "hi-IN") {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: true
            };
        }
        else {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: false
            }
        }
        var ids = ["Remarks"];
        var control = new google.elements.transliteration.TransliterationControl(options);
        control.makeTransliteratable(ids);
    }
    google.setOnLoadCallback(onLoad);

</script>
<script src="~/Scripts/google_hindi/google_transliteration.js"></script>

