


<script src="~/Scripts/AngularFramework/InstallmentType.js"></script>

<div ng-app="InstallmentMod" ng-controller="InstallmentCnt" ng-cloak="">
    <div class="col-md-2 form-group">
        <select class="form-control">
            <option selected value="0">--Choose Financial Year--</option>
            <option ng-repeat="FY in FinancialYearList" ng-value="FY.FIN_YEAR_MASTR_ID">{{FY.TitleEn}}</option>
            @*<option value="2024-25">2024-25</option>
            <option value="2023-24" selected>2023-24</option>
            <option value="2022-23">2022-23</option>*@
        </select>
    </div>
    <div class="col-md-2 form-group">
        <select class="form-control">
            <option selected value="0">--Choose Installment Type--</option>
            <option ng-repeat="li in InstallmentTypeList" ng-value="li.MasterInstallmentID">{{li.NameEn}}</option>
            @*<option value="I1000">I - 1000</option>
            <option value="II500">II - 500</option>
            <option value="III50">III - 500</option>*@
        </select>
    </div>
</div>
