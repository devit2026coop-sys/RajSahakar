
@{
    ViewBag.Title = "Beneficiary List";
    Layout = "~/Views/Shared/_PMKisanLayout.cshtml";
}
<div class="container-fluid dashHeader">
    <div class="row">
        <div class="col-md-8">
            <h3>मुख्यमंत्री किसान सम्मान निधि</h3>
        </div>
        @Html.Partial("_ChooseFYInstallment")
    </div>
</div>

<div class="container-fluid QuarterlyOverviewSection">
    <div class="panel panel-default" id="panelCheckyourstatus">
        <div class="panel-heading flexEqualCenter">
            <b><i class="fa fa-th-list"></i>&nbsp;Check your status</b>
            <div>
                <a href="javascript:void(0)" id="KnowyourRegisterationNo" class="btn btn-primary blueThemeBtn"><i class="fa fa-file-o"></i> Know your Registeration No.</a>
                <a href="~/pmkisan/Dashboard" class="backBtn"><i class="fa fa-angle-left"></i>Back</a>
            </div>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-3 form-group">
                    <label class="form-label">Enter Registration No.</label>
                    <input type="text" class="form-control" placeholder="Enter Registration No." />
                </div>
                <div class="col-md-2 form-group flexEqualCenter" style="padding-top:25px;">
                    <img src="~/Content/PMKisan/images/captcha.jpg" widh="100%" style="max-width:100%;max-height:35px;" />
                    <button class=" btn btn-success" type="button"><i class="fa fa-refresh"></i></button>
                </div>
                <div class="col-md-3 form-group">
                    <label class="form-label">Enter Captcha</label>
                    <input type="text" class="form-control" placeholder="Enter Captcha" />
                </div>
                <div class="col-md-3 form-group" style="padding-top:25px;">
                    <button class="btn btn-warning" type="button" data-toggle="modal" data-target="#myModal">Get OTP</button>
                </div>
            </div>
        </div>
    </div>
    <div class="panel panel-default" id="panelKnowyourRegisterationNo" style="display:none;">
        <div class="panel-heading flexEqualCenter">
            <b><i class="fa fa-th-list"></i>&nbsp;Know your Registeration No</b>
            <div>
                <a href="javascript:void(0)" id="Checkyourstatus" class="btn btn-primary blueThemeBtn"><i class="fa fa-file-o"></i> Check Your Status</a>
                <a href="~/pmkisan/Dashboard" class="backBtn"><i class="fa fa-angle-left"></i>Back</a>
            </div>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-3 form-group">
                    <label class="form-label">Search By</label>
                    <div class="clearfix"></div>
                    <label><input type="radio" name="SearchBy" value="1" checked/> Mobile No.</label>
                    <label><input type="radio" name="SearchBy" value="2"/> Aadhaar No.</label>
                </div>
                <div class="col-md-2 form-group">
                    <label class="form-label">Enter Mobile No.</label>
                    <input type="text" class="form-control" placeholder="Enter Mobile No." />
                </div>
                <div class="col-md-2 form-group flexEqualCenter" style="padding-top:25px;">
                    <img src="~/Content/PMKisan/images/captcha.jpg" widh="100%" style="max-width:100%;max-height:35px;" />
                    <button class=" btn btn-success" type="button"><i class="fa fa-refresh"></i></button>
                </div>
                <div class="col-md-2 form-group">
                    <label class="form-label">Enter Captcha</label>
                    <input type="text" class="form-control" placeholder="Enter Captcha" />
                </div>
                <div class="col-md-3 form-group" style="padding-top:25px;">
                    <button class="btn btn-warning" type="button" data-toggle="modal" data-target="#myModal">Get OTP</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Trigger the modal with a button -->

    <!-- Modal -->
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">OTP Verify</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Enter OTP</label>
                        <input type="text" class="form-control" placeholder="Enter OTP" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success">Submit</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>

        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('#KnowyourRegisterationNo').click(function () {
                $('#panelCheckyourstatus').hide();
                $('#panelKnowyourRegisterationNo').show();
            })
            $('#Checkyourstatus').click(function () {
                $('#panelCheckyourstatus').show();
                $('#panelKnowyourRegisterationNo').hide();
            })
        })
    </script>
</div>

