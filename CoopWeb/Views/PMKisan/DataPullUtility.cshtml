@{
    Layout = "~/Views/Shared/_Layout.cshtml"; ;
}
<script src="~/Scripts/AngularFramework/DataPullUtility.js?v=1.0"></script>
<div ng-app="dpModule">
    <div ng-controller="dpCont">
        <div class="col-md-12">
            <h3 class="h3heading citizen-dash-head">PM Kisan Data Pull Utility</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> PM Kisan Data Pull Utility  </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <form class="dev-search-form citizen-dash-head">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-lg-1">GID<span class="error">*</span></div>
                            <div class="col-lg-2">
                                <input type="number" class="form-control" ng-model="obj.GID" placeholder="GID" autocomplete="off">
                            </div>
                            <div class="col-md-12 mt-4 mb-4">
                                <button type="button" class="btn btn-primary" ng-click="GetRequestJson(0)">Get Encrypted Request Body</button>
                                <button type="button" class="btn btn-primary" ng-click="GetRequestJson(1)">Encrypt</button>
                                <button type="button" class="btn btn-primary" ng-click="GetDecrypt()">Decrypt</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <textarea class="{{(result.Status?'text-success':'text-danger')}}" style="width:100%" ng-model="result.Result" rows="10"></textarea>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
