
@{
    ViewBag.Title = "Generate Request for Fund Transfer";
    Layout = "~/Views/Shared/_PMKisanLayout.cshtml";
}

<script src="~/Scripts/AngularFramework/GenerateRFT.js"></script>
<div class="container-fluid QuarterlyOverviewSection" ng-app="grftApp" ng-controller="grftCnt" ng-cloak="">
    <div class="panel panel-default">
        <div class="panel-heading flexEqualCenter">
            <b><i class="fa fa-paper-plane"></i>&nbsp; Generate Request for Fund Transfer</b>
        </div>
        <div class="panel-body">
            <form ng-submit="GenerateRFT()">
                <div class="row">
                    <div class="col-md-3 col-sm-4 mt-5">
                        <label>{{translation.FinancialYear}}</label>
                        <select class="form-control" ng-model="obj.FinancialYearId" ng-init="obj.FinancialYearId='0'" required>
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="li in FinancialYearList" value="{{li.PMKisanCommonMasterId}}">
                                {{li.TitleEn}}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-4 mt-5">
                        <label>Scheme Name</label>
                        <select class="form-control" ng-model="obj.SchemeId" ng-init="obj.SchemeId='0'" required>
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="li in SchemeList" value="{{li.PMKisanCommonMasterId}}">
                                {{li.TitleEn}}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-4 mt-5">
                        <label>Quadrimester</label>
                        <select class="form-control" ng-model="obj.QuadrimesterId" ng-init="obj.QuadrimesterId='0'" required>
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="li in QuadrimesterList" value="{{li.PMKisanCommonMasterId}}">
                                {{li.TitleEn}}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-4 mt-5">
                        <label>Installment</label>
                        <select class="form-control" ng-model="obj.InstallmentNoId" ng-init="obj.InstallmentNoId='0'" required>
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="li in InstallmentTypeList" value="{{li.MasterInstallmentId}}">
                                {{li.NameEn}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="row">
                    <div class="col-md-12 text-center mt-5 mb-5">
                        <button type="submit" class="btn btn-primary">Proceed to Generate Beneficiary List</button>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered mb-0">
                    <thead>
                        <tr>
                            <th rowspan="2">#</th>
                            <th rowspan="2">RFT Number</th>
                            <th rowspan="2">Beneficiary Allocated Count</th>
                            <th rowspan="2">Allocated Amount (In Rs.)</th>
                            <th rowspan="2">PMK Lot No</th>
                            <th rowspan="2">Quadrimester</th>
                            <th rowspan="2">Amount (In Rs.)</th>
                            <th rowspan="2">Category</th>
                            <th rowspan="2">Download</th>
                            <th colspan="2">Beneficiary List</th>
                        </tr>
                        <tr>
                            <th>PDF</th>
                            <th>Excel</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td><a href="javascript:void(0)">RFT Bill</a></td>
                            <td><a href="javascript:void(0)">PDF</a></td>
                            <td><a href="javascript:void(0)">Excel</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

