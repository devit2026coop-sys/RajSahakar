@Cooperative.Models.Registration
@{
    ViewBag.Title = "Registration";
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}


@using (Ajax.BeginForm("SignUp", "Registration", new AjaxOptions { HttpMethod = "POST", OnBegin = "StartPost", OnSuccess = "Success", OnFailure = "OnFailure" }))
{

    <div class="form-group">
        <label asp-for="Name" class="col-sm-2 control-label">Name</label>
        <div class="col-sm-10">
          @Html.TextBoxFor(mode => mode.Name, new { @Class = "form-control" }) 
          @Html.ValidationMessageFor(mode => mode.Name)
        </div>
    </div>
    <div class="form-group">
        <label asp-for="DOB" class="col-sm-2 control-label">DOB</label>
        <div class="col-sm-10">
            @Html.TextBoxFor(mode => mode.DOB, new { @Class = "form-control" })
            @Html.ValidationMessageFor(mode => mode.DOB)
        </div>
    </div>
    <div class="form-group">
        <label asp-for="Mobile" class="col-sm-2 control-label">Mobile</label>
        <div class="col-sm-10">
            @Html.TextBoxFor(mode => mode.Mobile, new { @Class = "form-control" })
            @Html.ValidationMessageFor(mode => mode.Mobile)
        </div>
    </div>
    <div class="form-group">
        <label asp-for="Email" class="col-sm-2 control-label">Email</label>
        <div class="col-sm-10">
            @Html.TextBoxFor(mode => mode.Email, new { @Class = "form-control" })
            @Html.ValidationMessageFor(mode => mode.Email)
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
            <button type="submit" class="btn btn-default">Sign in</button>
        </div>
    </div>
    }
<script>
    function StartPost() { }
    function Success() {//do necessary code after successful signup }
    function OnFailure() { }
</script>