
<script src="~/Scripts/AngularFramework/PLDBDashboard.js"></script>
<script src="~/Scripts/zingchart.min.js"></script>
<script src="~/Scripts/zingchart-angularjs.js"></script>
<script src="~/Scripts/canvasjs.min.js"></script>
<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="~/Scripts/AngularFramework/ng-google-chart.min.js"></script>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.5/jspdf.min.js"></script>

<style>
    a.canvasjs-chart-credit {
        display: none;
    }
</style>
<div ng-app="SocietyIndexmod">
    <div ng-controller="SocietyIndexCont">
        <div class="row">
            {{ ElectionProgress.TotalSociety }}


            <div class="col-md-4">
                <div class="card">
                    <div class="card-header card-header-warning">{{translation.MemberRegistration}}</div>
                    <div class="card-image">
                        <div class="collection">
                            <a href="#!" ng-repeat="dsh in RegistrationModel" class="collection-item">{{ _language =='en-us' ?  dsh.Status_En : dsh.Status_Hi }}<span class="new badge2">{{ dsh.TotalCount }}</span></a>                           
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header card-header-warning">{{ translation.LoanApplication }} </div>
                    <div class="card-image">
                        <div class="collection">
                            <a href="#!" ng-repeat="dsh in LoanApplicationModel" class="collection-item">{{ _language =='en-us' ?  dsh.Status_En : dsh.Status_Hi }}<span class="new badge2">{{ dsh.TotalCount }}</span></a>
                           
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4" ng-if="PLDBModel.length>0">
                <div class="card">
                    <div class="card-header card-header-warning">{{ translation.PLDB }} </div>
                    <div class="card-image">
                        <div class="collection">
                            <a href="#!" ng-repeat="dsh in PLDBModel" class="collection-item">{{ _language =='en-us' ?  dsh.Status_En : dsh.Status_Hi }}<span class="new badge2">{{ dsh.TotalCount }}</span></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-md-6" id="dvRegistrationgraph">
                <div class="card">
                    <div class="card-header card-header-warning"> {{ translation.Registration }}</div>
                    <div class="card-image2">
                        <div style="" id="divChart1">
                        </div>
                    </div>
                </div>
            </div>     
            <div class="col-md-6" id="dvLoanApplication">
                <div class="card">
                    <div class="card-header card-header-warning"> {{ translation.LoanApplication }}</div>
                    <div class="card-image2">
                        <div style="" id="divChart2">
                        </div>
                    </div>
                </div>
            </div>
        </div>
     

<div class="se-pre-con"></div>
<div id="stop" class="scrollTop">
    <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
</div>
<!-- end main-content -->
</div>

</div>
