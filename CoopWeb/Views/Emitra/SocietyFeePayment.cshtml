
@{
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}

<script src="~/Scripts/AngularFramework/Emitra.js"></script>

<div ng-app="EmitraModule">
    <div ng-controller="EmitraCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.SocietyPayment}}</h3>
        </div>
        <!--div-- class="col-md-12">
            <div class="master-detail" style="margin-left:15px;">
                @if (ViewBag.BreadCrumbPath != null)
                {
                    <h5> @ViewBag.BreadCrumbPath </h5>
                }

            </div>
        </!--div-->
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        @*<span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>*@
                        <span style="margin: 0 5px;">{{translation.SocietyPayment}} </span>
                    </li>

                </ul>
            </div>
        </div>
        <div class="form-group col-md-6" hidden>
            <input type="text" class="form-control" ng-model="SocietyRegistration.txn">
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2">
                            <label style="color:black">{{translation.SocietyRegistrationNo}} :</label>
                        </div>
                        <div class="col-lg-4">
                            <input type="text" name="SocietyName" class="form-control" ng-model="SocietyRegistration.SocietyRegistrationNo" placeholder="{{translation.SocietyRegistrationNo}}" autocomplete="off">
                        </div>
                        <div>

                        </div>
                        <button type="submit" class="btn btn-primary dev-btn" ng-click="getfunSocietyPayment()" ng-disabled="SocietyRegistration.SocietyRegistrationNo==undefined || SocietyRegistration.SocietyRegistrationNo==''">{{translation.GetSocieties}}</button>
                    </div>
                </div>
                <table class="table table-responsive devtable" ng-show="Showgride">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.SocietyName}}

                            </th>
                            <th>
                                {{translation.Act}}
                            </th>
                            <th>
                                {{translation.SocietyRegistrationNo}}

                            </th>
                            <th>
                                {{translation.SocietyTyped}}
                            </th>
                            <th>
                                {{translation.PaymentStatus}}
                            </th>
                            <th>
                                    {{translation.payableamount}}
                                </th>

                        </tr>
                    </thead>
                    <tbody>

                        <tr dir-paginate="items in SocietyRegdata | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="statePagination">
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{ items.SocietyName }}</td>
                            <td>{{ items.ActNameEn }}</td>
                            <td>{{ items.RegistrationNo }}</td>
                            <td>{{ items.TypeameEng }}</td>
                            <td>{{ items.ProceesStatusTextEn }}</td>
                            <td>{{ items.Amount }}</td>


                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-12" ng-show="Showgride">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-lg-12 form-group" ng-show="getotp">
                        <div class="col-lg-2">
                            <label style="color:black">{{translation.EnterOTP}} :</label>
                        </div>
                        <div class="col-lg-2">
                            <input class="form-control" required name="login[password]" type="password" ng-model="SocietyRegistration.EnterOTP" placeholder="{{translation.EnterOTP}}" autocomplete="off" onkeypress="return event.charCode >= 48 && event.charCode <= 57">
                            <div class="hide-show"><span class="fa fa-eye-slash"></span></div>
                        </div>
                        <div class="col-lg-2">
                            <button type="submit" class="btn btn-primary dev-btn" ng-show="showResendBtn" ng-click="funChekvalidOTP()">{{ translation.ReSendOTP}}</button>
                        </div>
                        <div class="col-lg-6">
                        </div>
                    </div>
                    @*<div ng-hide="DivMsg">
                            {{translation.MappingProcessTitle}}
                        </div>*@
                    <br /><br />
                    <div class="col-lg-12">
                        <div class="col-lg-6" ng-show="IsOTPSended">
                            <button type="submit" style="float:right" class="btn btn-primary dev-btn" ng-click="MatchOtpApproved();">{{ translation.Approvedmap}}</button>
                        </div>
                        <div class="col-lg-6" ng-if="IsForPayment">
                            <button type="submit" id="abc" style="float:left" class="btn btn-primary dev-btn" ng-click="PaymentInitiatByEmitra(SocietyRegdata[0].RegistrationNo,'1');">{{translation.Payment}}/{{translation.SUBMITTED}}</button>
                            @*<button type="submit" id="abc" style="float:left" class="btn btn-primary dev-btn" ng-click="PaymentInitiatByEmitra(SocietyRegdata[0].RegistrationNo,'0');">{{translation.Payment}}/{{translation.PartialSubmit}}</button>*@
                            <button ng-if="PrintShow" class="btn btn-primary dev-btn" ng-click="PrintPage(SocietyRegdata[0].SocietyIdEnc)"><i class="fa fa-print"></i> Print</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <div class="se-pre-con"></div>
</div>
