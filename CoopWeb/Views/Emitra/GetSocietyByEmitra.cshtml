                        <select id="ddlCategory" ng-model="Search.ActId" class="form-control" ng-init="Search.ActId='0'" ng-disabled="IsActdisabled">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Acts | orderBy:'ActNameHi'" value="{{item.ActId}}">
                                {{_language =='en-us' ?  item.ActNameEn : item.ActNameHi}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2"><label>{{translation.MobileNo}}</label></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" placeholder="{{translation.MobileNo}}" ng-model="Search.MobileNo" autocomplete="off" required onkeypress='return event.charCode >= 48 && event.charCode <= 57' min="10" maxlength="10">
                    </div>
                    <div class="col-lg-2"><label>{{translation.Category}}</label></div>
                    <div class="col-lg-4">
                        <select id="ddlCategory" ng-model="Search.CategoryId" class="form-control" ng-init="Search.CategoryId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in CategoryList | orderBy:'CODEID'" value="{{item.CODEID}}">
                                {{_language =='en-us' ?  item.CODENAME : item.CODENAME_MANGAL}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2"><label>{{translation.PostHeading}}</label></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" placeholder="{{translation.PostHeading}}" ng-model="Search.PostName" autocomplete="off" onKeyPress="return ValidateAlpha(event);" maxlength="40">
                    </div>
                    <div class="col-lg-2"><label>{{translation.Occupation}}</label></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" placeholder="{{translation.Occupation}}" ng-model="Search.Occupation" autocomplete="off" onKeyPress="return ValidateAlpha(event);" maxlength="40">
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <center>
                        <button type="button" class="btn btn-primary dev-btn" ng-click="InsertSocietyMappingRequest()"> <i class="fa fa-edit"></i> {{translation.Submit}}</button>
                        <button type="button" class="btn btn-primary dev-btn" ng-click="Refresh()"> {{translation.Back}}</button>
                    </center>
                </div>

            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
</div>

