
<script src="~/Scripts/AngularFramework/TrainingAttendance.js?v=@DateTime.Now.Ticks"></script>


<style>
    .modal-title {
        color: #000 !important;
    }
</style>


<div ng-app="AppTrainngingAttendance">
    <div ng-controller="TrainngingAttendance">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.TrainngingAttendance}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.TrainngingAttendance}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-3">
                        <label>{{translation.TrainingProgramme}}</label>
                        <select ng-model="Trainning.TrainningId" class="form-control" ng-init="Trainning.TrainningId='0'" ng-change="GetAllTrainningAttendanceUserList()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in TraningOrgdata" value="{{item.TrainningId}}">
                                {{_language =='en-us' ?  item.ProgrammeNameEn : item.ProgrammeNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-3" ng-if="Trainning.TrainningId>0">
                        <label>Training Date</label>
                        <input type="date" class="form-control" ng-model="Trainning.TrainningDate" min="{{startDate}}" max="{{endDate}}" ng-disabled="isDateDisabled" />
                    </div>
                    <div class="col-lg-2" ng-if="Trainning.TrainningId > 0" style="padding-top:30px;">

                        <input type="checkbox" name="IsApproveTraingDate" class="checkBoxClass" ng-model="Trainning.IsApproveTraingDate" style="height:16px;width:16px; margin:0px 10px 0; vertical-align:middle;" ng-click="ApproveTrainingDateChanged()" />
                        <label style="margin-bottom: 0px;">Not a Training Date</label>
                    </div>
                    <div class="col-lg-2 dev-menu-btn " ng-if="Trainning.IsApproveTraingDate== true" style="padding-top:27px; text-align:left;">
                        <button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveTrainningApproveAttendance()">{{translation.Submit}}</button>
                    </div>
                    <div class="col-lg-2">&nbsp;</div>
                </div>

                <div ng-show="divuser">
                    <table class="table table-responsive devtable" id="TblUser">
                        <thead>
                            <tr>
                                <th>
                                    <lable>{{ _language === 'en-us' ? 'Is present ?' : 'उपस्थित है ?'}} <input type="checkbox" name="checkbox1" id="ckbCheckAll" ng-disabled="Trainning.IsApproveTraingDate" /></lable>
                                </th>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.UserHeading}}
                                </th>
                                <th>
                                    {{translation.SSOID}}
                                </th>
                                <th>
                                    {{translation.DepartmentHeading}}
                                </th>
                                <th>
                                    {{translation.DesignationHeading}}
                                </th>
                                @*<th>
                                        {{translation.AttendenceON}}
                                    </th>*@
                            </tr>
                        </thead>

                        <tbody>
                            <tr dir-paginate="Class in AcceptUSerLst | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                                <td>
                                    <p id="{{Class.UserId}}">
                                        <input type="checkbox" name="checkbox1" class="checkBoxClass" ng-true-value="true" ng-model="Class.IsActive" ng-click="ClickToChkUsers(Class.UserId);" ng-false-value="false" ng-disabled="Trainning.IsApproveTraingDate" />
                                    </p>
                                </td>
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ Class.OfficerNameEn }}</td>
                                <td>{{ Class.SSO_ID }}</td>
                                <td>{{ Class.DEPTNAMEENGLISH }}</td>
                                <td>{{ Class.DESIGNATIONDESCENGLISH }}</td>
                                @*<td>{{ Class.CreationDate }}</td>*@
                            </tr>
                        </tbody>
                    </table>
                    <div class="text-right">
                        <button class="btn btn-default" ng-click="previousPage()" ng-disabled="currentPage == 1">
                            Previous
                        </button>
                        <button class="btn" ng-repeat="page in pages" ng-click="goToPage(page)" ng-class="{ 'btn-primary': currentPage == page, 'btn-default': currentPage != page }">
                            {{ page }}
                        </button>
                        <button class="btn btn-default" ng-click="nextPage()" ng-disabled="currentPage == totalPages">
                            Next
                        </button>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid || Trainning.IsApproveTraingDate" ng-click="SaveTrainningUsersList()">{{translation.Submit}}</button>
                            <button type="submit" class="btn btn-primary" ng-click="ClearTrainningForm()">{{translation.Clear}}</button>
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../Trainning/TrainingAttendance"> {{translation.Back}}</a>
                            <input type="hidden" ng-model="Trainning.TrainningId" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



