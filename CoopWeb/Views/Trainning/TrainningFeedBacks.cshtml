<script src="~/Scripts/AngularFramework/TrainningFeedbacks.js"></script>

<style>
    h5, p {
        text-align: center;
    }

    .ui-timepicker-table th.periods {
        padding: 0.1em !important;
        width: 2.2em !important;
    }

    .ui-timepicker-table td span {
        display: block !important;
        padding: 0.2em 0.3em 0.2em 0.5em !important;
        width: 1.2em !important;
        text-align: right !important;
        text-decoration: none !important;
    }
    /* anchors for clickable cells */
    .ui-timepicker-table td a {
        display: block !important;
        padding: 0.2em 0.3em 0.2em 0.5em !important;
        width: 2.2em !important;
        cursor: pointer !important;
        text-align: right !important;
        text-decoration: none !important;
    }
</style>

@Html.Hidden("TemplateId")
<div ng-app="AppTrainningFeedBacks">
    <div ng-controller="TrainningFeedBacks">


        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.FeedBacks}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.FeedBacks}} </span>
                    </li>
                    <!-- Trigger the modal with a button -->
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" data-target="#myModal" ng-click="ClearFeedBacksForm()">
                            <h5>&#187; {{translation.AddFeedBacks}}</h5>
                        </button>
                    </li>

                </ul>
            </div>
        </div>

        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearFeedBacksForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.FeedBacks}} </h4>
                    </div>


                    <div class="modal-body">

                        <form class="dev-search-form" style="overflow: hidden; margin-bottom:35px;">

                            <div class="col-lg-12 form-group">
                                <div class="col-lg-4"><label>{{translation.TrainingProgramme}}</label></div>
                                <div class="col-lg-8">
                                    <select ng-model="FeedBacks.TrainningId" class="form-control" ng-init="FeedBacks.TrainningId='0'">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in UserTrainningData" value="{{item.TrainningId}}">
                                            {{_language =='en-us' ?  item.ProgrammeNameEn : item.ProgrammeNameHi}}
                                        </option>

                                    </select>
                                </div>
                            </div>

                            <div class="form-group col-lg-12">
                                <label>{{translation.FeedBack}}</label>
                                <textarea rows="6" cols="131" style="margin: 0px; width: 540px; color:#555; height: 116px;" ng-model="FeedBacks.FeedBack"></textarea>


                            </div>
                            <div class="form-group col-lg-8">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-click="SaveTrainningFeedback()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearFeedBacksForm()">{{translation.Clear}}</button>
                                    <input type="hidden" ng-model="FeedBacks.FeedbackId" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <div class="" ng-show="DivSms">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4" style="padding-left: 0;">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.TrainingProgramme}}
                                </th>
                                <th>
                                    {{translation.FeedBack}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="FeedBacks in FeedBacksData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="FeedBacksFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>

                                <td>
                                    {{_language =='en-us' ?  FeedBacks.ProgrammeNameEn : FeedBacks.ProgrammeNameHi}}
                                </td>
                                <td>
                                    {{FeedBacks.Feedback}}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="FeedBacksFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2" ng-show="DivSms">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>

</div>