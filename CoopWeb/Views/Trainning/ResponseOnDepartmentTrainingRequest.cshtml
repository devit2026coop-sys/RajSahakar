                                <td><a ng-show="Trainning.IsApproved=='APPROVED'" href="{{Trainning.TrainingParticipantFileName}}" target="_blank"><i class="fa fa-file-pdf-o" aria-hidden="true"></i></a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

