        <div class="row">

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header card-header-warning">{{translation.TrainingTaskPanel}} <div style="text-align:right;width:100%;display:inline">&nbsp;&nbsp;&nbsp; <span style="text-align:right;font-size:12px"></span></div></div>
                    <div class="card-image">
                        <div class="collection">
                            <a href="#!" class="collection-item">{{translation.Total}} <span class="new badge2" ng-model="TotTraining">{{TotTraining}}</span></a>
                            <a href="#!" class="collection-item">{{translation.RequestPendingAtRICEM}}<span class="new badge2 red" data-badge-caption="" ng-model="TotRequestPending">{{TotRequestPending}}</span></a>
                            <a href="#!" class="collection-item">{{translation.PendingAtDepart}}<span class="new badge2 brown" data-badge-caption="" ng-model="TotPendingAtDepart">{{TotPendingAtDepart}}</span></a>
                            <a href="#!" class="collection-item">{{translation.Approvable}}<span class="new badge2" data-badge-caption="" ng-model="TotApproved">{{TotApproved}}</span></a>
                            @*<a href="#!" class="collection-item">{{translation.TOtalUnderProcessCase}} <span class="new badge2 brown" data-badge-caption="" ng-model="UNDERPROCESS">20</span></a>*@
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header card-header-warning"> {{translation.TrainingGraphView}}</div>
                    <div class="card-image2">
                        <div style="height: 277px; width: 100%;" id="divChart1">
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>