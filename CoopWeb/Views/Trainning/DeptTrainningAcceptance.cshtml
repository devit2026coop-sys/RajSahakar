<script src="~/Scripts/AngularFramework/DeptTrainningAcceptance.js"></script>


<div ng-app="AppClassesFormat">
    <div ng-controller="Classes">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.DeptTrainningAcceptance}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.TrainingRICEM}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">  {{translation.DeptTrainningAcceptance}} </span>
                    </li>
                </ul>
            </div>
        </div>

        <div ng-show="trainninggrid" class="col-md-12">

            <div class="citizen-dash-head">
                <table class="table table-responsive devtable" style="overflow-x:auto;">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th ng-click="sortData('ProgrammeNameEn')">
                                {{translation.ProgramName}}
                                <div ng-class="getSortClass('ProgrammeNameEn')"></div>
                            </th>
                            <th ng-click="sortData('ChannelName_En')">
                                {{translation.ChannelName}}
                                <div ng-class="getSortClass('ChannelName_En')"></div>
                            </th>
                            <th ng-click="sortData('StartDate')">
                                {{translation.StartDate}}
                                <div ng-class="getSortClass('StartDate')"></div>
                            </th>
                            <th ng-click="sortData('EndDate')">
                                {{translation.EndDate}}
                                <div ng-class="getSortClass('EndDate')"></div>
                            </th>
                            <th ng-click="sortData('StartTime')">
                                {{translation.StartTime}}
                                <div ng-class="getSortClass('StartTime')"></div>
                            </th>
                            <th ng-click="sortData('EndTime')">
                                {{translation.EndTime}}
                                <div ng-class="getSortClass('EndTime')"></div>
                            </th>

                            <th>
                                {{translation.Status}}
                            </th>

                            <th>
                                {{translation.TakeAction}}
                            </th>
                            <th>
                                {{translation.File}}
                            </th>
                            <th>
                                {{translation.TrainingParticipant}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="Trainning in TrainningData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>
                                {{ _language==='en-us' ? Trainning.ProgrammeNameEn : Trainning.ProgrammeNameHi}}
                            </td>
                            <td>
                                {{ _language==='en-us' ? Trainning.ChannelName_En : Trainning.ChannelName_Hi}}
                            </td>
                            <td>
                                {{Trainning.StartDate}}
                            </td>
                            <td>
                                {{Trainning.EndDate}}
                            </td>
                            <td>
                                {{Trainning.StartTime}}
                            </td>
                            <td>
                                {{Trainning.EndTime}}
                            </td>

                            <td>
                                {{ _language==='en-us' ? Trainning.CurrentStatusEng : Trainning.CurrentStatusHi}}
                            </td>
                            <td>
                                <i ng-show="Trainning.IsApproved===1 || Trainning.IsApproved===3" class="fa fa-edit" ng-click="GetTrainningListById(Trainning.TrainningId)"></i>
                            </td>
                            <td>
                                <div> <a href="{{Trainning.FileName}}" target="_blank">{{translation.TrainingRequestLetter}}</a></div>
                            </td>
                            <td>
                                <div ng-show="Trainning.IsApproved === 5 "> <a href="{{Trainning.TrainingParticipantFileName}}" target="_blank">{{translation.MemberListForTraining}}</a>  </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div ng-show="divaccept" class="col-md-12">
            <div class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">
                        <label>{{translation.ProgramName}}</label>
                    </div>
                    <div class="col-lg-10">
                        {{ _language=='en-us' ? SingleTrainningData.ProgrammeNameEn : SingleTrainningData.ProgrammeNameHi }}
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">
                        <label>{{translation.StartDate}}</label>
                    </div>
                    <div class="col-lg-4">
                        {{ SingleTrainningData.StartDate}}
                    </div>
                    <div class="col-lg-2">
                        <label>{{translation.EndDate}}</label>
                    </div>
                    <div class="col-lg-4">
                        {{ SingleTrainningData.EndDate }}
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">
                        <label>{{translation.StartTime}}</label>
                    </div>
                    <div class="col-lg-4">
                        {{ SingleTrainningData.StartTime}}
                    </div>
                    <div class="col-lg-2">
                        <label>{{translation.EndTime}}</label>
                    </div>
                    <div class="col-lg-4">
                        {{ SingleTrainningData.EndTime }}
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">
                        <label>{{ translation.ChannelName}}</label>
                    </div>
                    <div class="col-lg-4">
                        {{ _language=='en-us' ? SingleTrainningData.ChannelName_En: SingleTrainningData.ChannelName_Hi}}
                    </div>
                    <div class="col-lg-2">
                        <label>HtmlContent</label>
                    </div>
                    <div class="col-lg-4">
                        <a href="{{SingleTrainningData.FileName}}" target="_blank">View Document</a>
                    </div>
                </div>

                <div ng-show="ShowDiv">
                    <div class="col-lg-12 form-group ">
                        <div class="col-lg-2"><label>{{translation.Organization}}</label></div>
                        <div class="col-lg-4">
                            <select class="form-control" id="ddlOrganisation" ng-model="Trainning.OrganisationId" ng-disabled="true">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in TraningOrgdata" value="{{item.OrganisationId}}" selected>
                                    {{_language =='en-us' ?  item.OrganisationNameEn : item.OrganisationNameHi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-lg-2">
                            <label>
                                {{translation.Level}}
                            </label>
                        </div>
                        <div class="col-lg-4">
                            <select class="form-control" id="ddllevel" ng-model="Trainning.LevelId" ng-init="Trainning.LevelId='0'" ng-change="GetDesignationList();">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Level" value="{{item.LevelId}}~{{item.MappingID}}">
                                    {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-12 form-group">
                        <div class="col-md-2">
                            <label>
                                {{translation.Designation}} :
                            </label>
                        </div>
                        <div class="form-group col-md-4">
                            <select ng-model="Trainning.DesignationLevelMappingId" class="form-control" ng-init="Trainning.DesignationLevelMappingId='0'" ng-change="GetTrainningAcceptUserList()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Designations" value="{{item.DesignationLevelMappingId}}">
                                    {{_language =='en-us' ?  item.DESIGNATIONDESCENGLISH : item.DESIGNATIONDESCENGLISH}}
                                </option>
                            </select>
                        </div>
                    </div>


                    @*<div class="col-lg-12 form-group">
                        <div class=" col-md-2">
                            <label>{{translation.Office}}</label>
                        </div>
                        <div class="form-group col-md-4">
                            <select ng-model="Trainning.OfficeId" id="ddloffice" class="form-control" ng-init="Trainning.OfficeId='0'" ng-change="GetDesignationList();">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option ng-repeat="item in OfficeListData" value="{{item.OfficeId}}">
                                    {{_language =='en-us' ?  item.OfficeNameEn : item.OfficeNameHi}}
                                </option>
                            </select>
                        </div>


                        <div class="col-md-2">
                            <label>
                                {{translation.Designation}} :
                            </label>
                        </div>
                        <div class="form-group col-md-4">
                            <select ng-model="Trainning.DesignationLevelMappingId" class="form-control" ng-init="Trainning.DesignationLevelMappingId='0'" ng-change="GetTrainningAcceptUserList()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Designations" value="{{item.DesignationLevelMappingId}}">
                                    {{_language =='en-us' ?  item.DESIGNATIONDESCENGLISH : item.DESIGNATIONDESCENGLISH}}
                                </option>
                            </select>
                        </div>
                    </div>*@


                    <div ng-show="ShowDiv" class="citizen-dash-head">
                        <div ng-show="divuser">
                            <table class="table table-responsive devtable" id="TblUser">
                                <thead>
                                    <tr>
                                        <th>
                                            <input type="checkbox" name="checkbox1" id="ckbCheckAll" />
                                        </th>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{ translation.UserHeading }}
                                        </th>
                                        <th>
                                            {{ translation.SSOID }}
                                        </th>
                                        <th>
                                            {{ translation.DepartmentHeading }}
                                        </th>
                                        <th>
                                            {{ translation.DesignationHeading }}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="Class in AcceptUSerLst | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                                        <td><p id="{{Class.UserId}}"><input type="checkbox" name="checkbox1" class="checkBoxClass" ng-model="ElectionMastermodal.chkdboxValue" ng-click="ClickToChkUsers(Class.UserId,Class.MappingID);" /></p></td>
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{Class.OfficerNameEn}}</td>
                                        <td>{{ Class.SSO_ID }}</td>
                                        <td>{{ Class.DEPTNAMEENGLISH }}</td>
                                        <td>{{ Class.DESIGNATIONDESCENGLISH }}</td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="form-group col-md-12">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-click="SaveTrainningUsersList()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearTrainningForm()">{{translation.Clear}}</button>

                                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../trainning/DeptTrainningAcceptance"> {{translation.Back}}</a>

                                    <input type="hidden" ng-model="Trainning.TrainningId" />
                                </div>
                            </div>
                            <div class="col-md-12 devpage-breadcrumb">
                                <button type="button" class="btn btn-primary dev-btn" ng-show="ShowDisDiv" ng-click="SaveElectionMaster();" style="float:right">NEXT</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group col-md-12 citizen-dash-head" ng-hide="ShowDiv">
                <div class="dev-menu-btn">
                    <button type="submit" class="btn btn-primary" ng-click="TrainningReject()">{{translation.Submit}}</button>
                    <button type="submit" class="btn btn-primary" ng-click="BackToPage()">{{translation.Back}}</button>
                </div>
            </div>

        </div>

    </div>
</div>
