<div ng-app="ApplicationFlowModule">
    <div ng-controller="ApplicationFlowCont" ng-cloak="">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">{{translation.GCC}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> {{translation.GCC}} </span>
                    </li>

                </ul>
            </div>
        </div>
        <div class="dev-popup-body modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content" style="width:800px">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearAppFlowForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.ApplicationFlow}} </h4>
                    </div>
                    <div class="modal-body">
                        <div class="table-responsive">
                            <table class="table table-responsive devtable" style="margin-top: 30px;color:black" id="a">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.Status}}
                                        </th>
                                        <th>{{translation.AssignTo}}</th>
                                        <th>
                                            {{translation.Remarks}}
                                        </th>
                                        <th>
                                            {{translation.CreationDate}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="AppFlowOne in ApplicationFlowSociety | itemsPerPage: 10">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ _language =='en-us' ? AppFlowOne.ProceesStatusTextEn : AppFlowOne.ProceesStatusTextHi}}</td>
                                        <td>{{AppFlowOne.OfficerNameEn}}</td>
                                        <td>{{AppFlowOne.Remark}}</td>
                                        <td>{{AppFlowOne.ActionDate}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <form class="dev-search-form" name="MyClassForm" ng-show="BaseUserId==ApplicationFlowMaster.UserId" style="overflow: hidden; margin-bottom:35px;">
                            <div class="col-md-6" ng-hide="ShowOTPDiv">
                                <label>
                                    {{translation.Status}} :
                                </label>
                                <select ng-model="ApplicationFlowMaster.StatusId" class="form-control" ng-init="ApplicationFlowMaster.StatusId='0'" ng-change="GetRoleList()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in SocietyProceesStatus" value="{{item.SocietyProceesStatusId}}">
                                        {{_language =='en-us' ?  item.ProceesStatusTextEn : item.ProceesStatusTextHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6" ng-hide="ShowOTPDiv">
                                <div ng-show="ApplicationFlowMaster.StatusId==3 || ApplicationFlowMaster.StatusId==9 || ApplicationFlowMaster.StatusId==12 || ApplicationFlowMaster.StatusId==19 || ApplicationFlowMaster.StatusId==23 || ApplicationFlowMaster.StatusId==35|| ApplicationFlowMaster.StatusId==36 || ApplicationFlowMaster.StatusId==1058">
                                    <label>
                                        {{translation.RoleHeading}} :
                                    </label>
                                    <select ng-model="RoleId" class="form-control" id="ddlRole" ng-init="RoleId=0" ng-change="GetOfficer()">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in RoleList " value="{{item.RoleID}}">
                                            {{ item.RoleName_EN }}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6" ng-hide="ShowOTPDiv">
                                <div ng-show="ApplicationFlowMaster.StatusId==3 || ApplicationFlowMaster.StatusId==9 || ApplicationFlowMaster.StatusId==12 || ApplicationFlowMaster.StatusId==19 || ApplicationFlowMaster.StatusId==23 || ApplicationFlowMaster.StatusId==35 || ApplicationFlowMaster.StatusId==36 || ApplicationFlowMaster.StatusId==1058">
                                    <label>
                                        {{translation.Officer}} :
                                    </label>
                                    <select ng-model="ApplicationFlowMaster.OfficeId" id="ddlOffice" class="form-control" ng-init="ApplicationFlowMaster.OfficeId='0'">
                                        @*<option value="0" disabled>{{translation.SelectOption}}</option>*@
                                        <option ng-repeat="item in OfficerData " value="{{item.userid}}">
                                            {{ item.OfficerNameEn }}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv">
                                <label>{{translation.Remarks}}</label>
                                <textarea type="text" rows="4" cols="50" class="form-control" id="Remarks" name="Remarks" ng-bind="Remarks" ng-model="ApplicationFlowMaster.Remark" placeholder={{translation.Remarks}}></textarea>
                                <code style="float: left;">
                                </code>
                                @*<input type="hidden" class="form-control hindiFont" id="txtRemark" ng-bind="Remarks" ng-model="ApplicationFlowMaster.Remark" />
                                    <textarea type="text" rows="4" cols="50" class="form-control hindiFont" name="Remarks" onblur="convert_to_unicode(this,'txtRemark')"  placeholder={{translation.Remarks}}></textarea>*@
                            </div>

                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==1065">
                                <label>{{translation.Amount}}</label>
                                <input type="text" rows="4" cols="50" class="form-control" id="AmendmendAmount" name="AmendmendAmount" ng-model="ApplicationFlowMaster.AmendmendAmount" placeholder={{translation.Amount}} />
                            </div>
                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv" ng-if="ApplicationFlowMaster.StatusId==1065">
                                <label>{{translation.ReceiptNumber }}</label>
                                <input type="text" rows="4" cols="50" class="form-control" id="AmendmendAmountReceipt" name="AmendmendAmountReceipt" ng-model="ApplicationFlowMaster.ReceiptNumber" placeholder={{translation.ReceiptNumber}} />
                            </div>

                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv">
                                <div ng-show="ApplicationFlowMaster.StatusId==36">
                                    <div class="col-md-3">
                                        <label>
                                            {{translation.File}} :
                                        </label>
                                    </div>
                                    <div class="col-md-8" style="text-align:left">
                                        <input type="file" name="File" filetype='pdf' id="flReportFile" class="form-control" ng-model="ApplicationFlowMaster.ReportFile" onchange="angular.element(this).scope().UploadReportFile(this.files)">
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv">
                                <div class="citizen-dash-head col-md-3" ng-show="ApplicationFlowMaster.StatusId==5 || ApplicationFlowMaster.StatusId==10 || ApplicationFlowMaster.StatusId==20">
                                    <label>{{translation.ObjectionBelongTo}}</label>
                                </div>
                                <div class="citizen-dash-head col-md-9" style="text-align:left" ng-show="ApplicationFlowMaster.StatusId==5 || ApplicationFlowMaster.StatusId==10 || ApplicationFlowMaster.StatusId==20">
                                    <input type="checkbox" style="" name="Basic" ng-model="ObjectionFlagBasic"> {{translation.SocietyDetails}}
                                    <input type="checkbox" style="padding-left:15px;margin-left:15px" name="Administrative" ng-model="ObjectionFlagAdmin"> {{translation.AdministrativeDetails}}
                                    <input type="checkbox" style="padding-left:15px;margin-left:15px" name="Office" ng-model="ObjectionFlagOffice"> {{translation.SocietyOfficeDetails}}
                                </div>
                            </div>
                            <div class="form-group col-md-12" ng-hide="ShowOTPDiv">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-click="SaveSocietyApplicationFlowStatus()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearAppFlowForm()">{{translation.Clear}}</button>
                                </div>
                            </div>

                            <div class="form-group col-md-6" ng-show="ShowOTPDiv">
                                <label>{{translation.EnterOTP}}</label>
                                <input type="text" class="form-control" name="OTP" ng-bind="OTP" ng-model="ApplicationFlowMaster.OTP" placeholder={{translation.EnterOTP}} autocomplete="off" /><br />
                                <button type="submit" class="btn btn-primary" ng-click="VerifyOTP()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="SaveSocietyApplicationFlowStatus()">{{translation.ReSendOTP}}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <div class="dev-popup-body modal fade" id="myModalNotAssign" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <div class="modal-content" style="width:800px">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearAppFlowForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.ApplicationFlow}} </h4>
                    </div>
                    <div class="modal-body">
                        <div class="table-responsive">
                            <table class="table table-responsive devtable" style="margin-top: 30px;color:black" id="a">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.Status}}
                                        </th>
                                        <th>{{translation.AssignTo}}</th>
                                        <th>
                                            {{translation.Remarks}}
                                        </th>
                                        <th>
                                            {{translation.CreationDate}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="AppFlowOne in ApplicationFlowSociety | itemsPerPage: 10">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ _language =='en-us' ? AppFlowOne.ProceesStatusTextEn : AppFlowOne.ProceesStatusTextHi}}</td>
                                        <td>{{AppFlowOne.OfficerNameEn}}</td>
                                        <td>{{AppFlowOne.Remark}}</td>
                                        <td>{{AppFlowOne.ActionDate}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <form class="dev-search-form" name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                            <div class="col-md-6">
                                <label>
                                    {{translation.Officer}} :
                                </label>
                                <select ng-model="ApplicationFlowMaster.OfficeId" id="ddlOffice" class="form-control" ng-init="ApplicationFlowMaster.OfficeId='0'">
                                    <option value="0">{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in OfficerNotAssignData " value="{{item.UserId}}">
                                        {{ item.OfficerNameEn }}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <span style="color: #964c4c;    font-weight: bold;">{{DivTextForNotMaaped}}</span>
                            </div>
                            <div class="clearfix"></div>
                            <div class="form-group col-md-12" style="margin-top:20px;">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-click="SavePermanentSocietyData()">{{translation.Submit}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">
                        <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">
                            <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />

                            <div class="col-md-2 margin-Top20" style="padding-left: 0;" id="ddrDistrictId">
                                <label>{{ translation.DistrictHeading}}:</label>
                                <select name="DISTRICT_ID" ng-model="DISTRICT_ID" class="form-control">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                        {{_language =='en-us' ?  district.DISTRICT_ENG : district.DISTRICT_MANGAL}}
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-2 margin-Top20" style="padding-left: 0;" id="ddrStatus">
                                <label>{{ translation.Status}}:</label>
                                <select name="StatusId" ng-model="StatusId" class="form-control">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="sts in StatusList" value="{{sts.SocietyProceesStatusId}}">
                                        {{_language =='en-us' ?  sts.ProceesStatusTextEn : sts.ProceesStatusTextHi}}
                                    </option>
                                </select>
                            </div>


                            <div class="col-md-2">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" name="SearchText" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-md-2">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                            </div>
                            <div class="col-md-4  margin-Top20">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-click="searchRequest(GetAppliFlowList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                                <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                            </div>
                        </div>
                        <div class="col-lg-12 Application_Flowinput" style="margin-bottom: 10px;padding-left: 0px;">
                            <div>
                                <label><input type="radio" id="one" name="ApplicationStatus" value="R" style="margin-left: 0px;" ng-click="searchRequest(GetAppliFlowList)">Reject</label>
                                <label><input type="radio" id="two" name="ApplicationStatus" value="A" ng-click="searchRequest(GetAppliFlowList)">Approved&nbsp;</label>
                                <label><input type="radio" id="three" name="ApplicationStatus" value="O" ng-click="searchRequest(GetAppliFlowList)">Objection&nbsp;</label>
                                <label><input type="radio" id="four" name="ApplicationStatus" value="PA" ng-click="searchRequest(GetAppliFlowList)">Pending All&nbsp;</label>
                                <label><input type="radio" id="five" name="ApplicationStatus" checked="checked" value="PS" ng-click="searchRequest(GetAppliFlowList)">Pending Self</label>
                                @*<label><input type="radio" id="five" name="ApplicationStatus" value="AP" ng-click="searchRequest(GetAppliFlowList)">Pending For Assign</label>*@
                            </div>
                            @*<div class="margin-Top20">
                                    <label><input type="checkbox" id="one" ng-model="IsAmendment" ng-click="searchRequest(GetAppliFlowList)" style="margin-right: 5px;">Section 12</label>
                                    <label><input type="checkbox" id="one" ng-model="NewRegistration" name="NewRegistration" value="N" ng-click="searchRequest(GetAppliFlowList)" style="margin-right: 5px;">Section 4</label>
                                </div>*@
                            <div class="margin-Top20" ng-show="false">
                                <label><input type="checkbox" id="one" ng-model="OverDue30days" name="OverDue30days" value="P" ng-click="searchRequest(GetAppliFlowList)" style="margin-right: 5px;">Show more than 30 days overdue</label>
                                <label><input type="checkbox" id="one" ng-model="OverDue10days" name="OverDue10days" value="P" ng-click="searchRequest(GetAppliFlowList)" style="margin-right: 5px;">Show more than 10 days overdue</label>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                    <div style="overflow-x: auto;">
                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th>
                                        #
                                    </th>
                                    <th ng-click="sortData('Name')">
                                        {{translation.Name}}
                                        <div ng-class="getSortClass('Name')"></div>
                                    </th>
                                    <th style=" min-width: 125px;">
                                        {{translation.RegistrationNo}}
                                    </th>
                                    <th>
                                        SSO ID
                                    </th>
                                    <th>
                                        {{translation.AssignTo}}
                                    </th>
                                    <th>
                                        {{translation.Status}}
                                    </th>
                                    <th>
                                        {{translation.Remarks}}
                                    </th>
                                    <th style=" min-width: 115px;">
                                        {{translation.CreationDate}}
                                    </th>
                                    @*<th style=" min-width: 115px;">
            Overdue(Days)
        </th>*@
                                    <th>
                                        View GCC Details
                                    </th>
                                    <th>
                                        {{translation.Actions}}
                                    </th>
                                    <th>
                                        {{translation.MokaReport}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="AppFlow in ApplicationFlowList">
                                    <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>

                                    <td>
                                        <b> <i>{{AppFlow.Name_ENG }}</i></b>
                                    </td>
                                    <td>{{AppFlow.RegistrationNo}}  </td>
                                    <td>{{AppFlow.SSOID}}  </td>
                                    <td>{{ _language =='en-us' ? AppFlow.OfficerNameEn : AppFlow.OfficerNameHi}}</td>
                                    <td>{{ _language =='en-us' ? AppFlow.ProceesStatusTextEn : AppFlow.ProceesStatusTextHi}}</td>
                                    <td>{{AppFlow.Remark}}</td>
                                    <td>{{AppFlow.ActionDate}}</td>
                                    @*<td style="text-align:center">{{AppFlow.OverDue=='0'?'':AppFlow.OverDue}}</td>*@
                                    @*<td><a title="{{translation.ShowDetails}}" style="color:#505050;" href="../ApplicationFlow/SocietyActionView?SocietyIDEnc={{AppFlow.SocietyIDEnc}}~_ApplicationFlow_ApplicationFlow" target="_blank"><i class="fa fa-info-circle infoicon-edit"></i></a></td>*@
                                    <td class="add-more-td">
                                        <a title="VIEW" ng-click="ApplicationView(AppFlow.Encrypted_GopalCreditCardId, AppFlow.Encrypted_RegistrationNo)"><i class="fa fa-eye"></i></a>
                                    </td>
                                    <td>
                                        <a title="VIEW" ng-click="ApplicationActionView(AppFlow.Encrypted_GopalCreditCardId, AppFlow.Encrypted_RegistrationNo)"><i class="fa fa-info-circle infoicon-edit"></i></a>
                                    </td>
                                    <td>
                                        <a title="VIEW" ng-click="MokaReportView(AppFlow.Encrypted_GopalCreditCardId, AppFlow.Encrypted_RegistrationNo)" ><i class="fa fa-download"></i></a>
                                    </td>

                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetAppliFlowList)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetAppliFlowList)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetAppliFlowList)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetAppliFlowList)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetAppliFlowList)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>     
        </div>
        <div class="se-pre-con"></div>
        <div id="stop" class="scrollTop">
            <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
        </div>
     
    </div> 
</div>