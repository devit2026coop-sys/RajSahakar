<script src="~/Scripts/angular.js"></script>
<script src="~/Scripts/jquery-3.1.0.js"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />
<script src="~/Scripts/dirPagination.js"></script>
<script src="~/Scripts/AngularFramework/Moka_Report.js?id=0"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
@{
    Layout = null;
}

<style>

    .modal-title {
        line-height: 30px;
    }

    .modal-body {
        background: #fff;
    }

    .modal-content {
        display: inline-block;
    }


    .modal-body span {
        color: #fff;
        padding-top: 10px;
        display: inline-block;
    }

    .pd30 {
        padding: 30px 0px;
    }

    .modal-footer {
        padding: 20px;
        text-align: center;
    }

    #ssoauth {
        background: transparent !important;
    }


    .modal-body .switch-field input:checked + label {
        background-color: #4caf50 !important;
        box-shadow: none;
    }

    p {
        line-height: 24px !important;
        color: #444;
    }
</style>
<link href="~/Content/Stylesheets/ssoauth_style.min.css" rel="stylesheet" />
<script src="~/Scripts/ssoauth_inline.min.js"></script>
<html>
<head>
    <meta charset="utf-8" />
    <title></title>
</head>
<body>
    <div ng-app="MokaReportModule">
        <div ng-controller="MokaReportCont" ng-cloak="">

            <div id="MokaReportView">
                <table width="100%" style="border-collapse:collapse;font-size:20px" border="0" cellpadding="3" cellspacing="0">

                    <tr>
                        <td align="center" colspan="2">
                            <b style="line-height:40px;color:#444;">
                                ग्राम सेवा सहकारी समिति लि. .....................<br />
                                मौका रिपोर्ट
                            </b>
                        </td>
                    </tr>
                    <tr>
                        <td align="left" colspan="2">
                            <p style="line-height:40px">
                                आज दिनांक .............................. को आवेदक श्री {{Name_HI}} पुत्र श्री  {{GopalCreditCardModel.FatherName_HI}}
                                निवासी {{GopalCreditCardModel.HouseBuildingNo}} {{GopalCreditCardModel.LaneStreetName}} {{GopalCreditCardModel.Address_ENG}} {{GopalCreditCardModel.PinCode}} {{GopalCreditCardModel.Village_HI}} {{GopalCreditCardModel.DistrictName_HI}} के  द्वारा गोपाल क्रेडिट कार्ड (GCC) योजनान्तर्गत समिति {{GopalCreditCardModel.DCSName}} में
                                राशि रू. {{GopalCreditCardModel.LoanAmountRecommendedByDCS}} के लिए प्रस्तुत आवेदन पत्र के आधार पर पशुओं  एवं   निवास स्थान का मेरे द्वारा मौका
                                देखा  गया है। जिसका विवरण निम्नानुसार है:-
                            </p>
                        </td>

                    </tr>
                    <tr>
                        <td colspan="2">
                            <p style="line-height:40px">
                                1. प्रार्थी श्री {{GopalCreditCardModel.GopalCreditCardModel.Name_HI}} ग्राम {{GopalCreditCardModel.Village_HI}} का मूल निवासी है तथा गत ..
                                ............... वर्षो से ग्राम में निवासित है।<br />
                                2. प्रार्थी के पास {{GopalCreditCardModel.NoOfbuffaloes}} भैस (नस्ल) तथा {{GopalCreditCardModel.NoOfCows}} गाय (नस्ल) की है, तथा उक्त सभी पशु स्वस्थ है एवं  उन पर प्रार्थी का मालीकाना हक है।<br />
                                3. प्रार्थी जीवित एवं स्वस्थ है तथा पशुओं की स्वयं देखभाल करता है।<br />
                                4. प्रार्थी के पास {{GopalCreditCardModel.AgricultureLandDetailList[0].Irrigated}} {{translation.Irrigated}} {{GopalCreditCardModel.AgricultureLandDetailList[0].NonIrrigated}}{{translation.NonIrrigated}} बीघा कृषि भूमि/मकान है। जिसका वर्तमान मूल्य रू. ....................है, एवं स्वयं काबिज है।<br />
                                5. प्रार्थी द्वारा..................................दुग्ध उत्पादक सहकारी समिति लि.,..................................में नियमित रूप से  दुध दिया जा रहा है।<br />
                                6. श्री ..............................................पुत्र श्री ........................................... निवासी ..........................एवं  श्री .................................
                                ... पुत्र श्री ...............................निवासी ........................ द्वारा उक्त ऋण, उसके ब्याज एवं अन्य खर्चो की पूर्ण चुकौती हेतु अपनी जमानत देने की सहमति दी गई है। जिनकी सम्पत्ति क्रमशः ग्राम .............................................................में
                                बीघा कृषि भूमि/मकान................................एवं ग्राम....................................... में ....................................................बीघा कृषि
                                भूमि/मकान है। जिसका अनुमानित मूल्य क्रमशः रू. .................., रू. .................. है एवं जमानतदार स्वयं काबिज है।<br />
                                7. प्राप्त जानकारी के अनुसार प्रार्थी एवं जमानदारों की साख एवं व्यवहार अच्छा है।<br />
                                8. अन्य..................................................................................................................................................................................................
                                ..................................................................................................................................................................................................................
                                ..............................................................
                            </p>

                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <p style="line-height:40px; text-align:center">
                                <b>
                                    हस्ताक्षर मय सील<br /><br />
                                    नाम..................................................<br />
                                    व्यवस्थापक ग्राम सेवा सहकारी समिति लि
                                </b>
                            </p>
                        </td>
                    </tr>
                </table>

            </div>
            <button id="download-pdf">Download as PDF</button>


        </div>
    </div>
</body>
</html>
<script>
    document.getElementById('download-pdf').addEventListener('click', function () {
        var element = document.getElementById('MokaReportView');
        html2pdf().from(element).save();
    });
</script>
