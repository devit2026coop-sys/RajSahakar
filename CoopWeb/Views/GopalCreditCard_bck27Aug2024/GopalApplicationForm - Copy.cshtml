@model Cooperative.Models.GopalCreditCardModel.GopalCreditCardFormModel
<script src="~/Scripts/AngularFramework/GopalCreditCardApplicationForm.js"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />
<style>
    input[type=file].form-control {
        border: 1px solid #cccccc !important;
    }
    .disabled input {
        background-color: #e0e0ef; /* Change background to indicate disabled state */
       /*pointer-events: none;*/
    }
</style>
@Html.Hidden("TemplateId")
<div ng-app="GopalCreditCardAppEntryForm" data-ng-init="init(@Newtonsoft.Json.JsonConvert.SerializeObject(Model))">
    <div ng-controller="GopalCreditCard">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.GopalCreditCardForm}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.EntryForm}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.GopalCreditCardApplicationForm}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn" ng-show="ActionId==1">
                        <button type="button" ng-click="AddNewGopalCreditCardApp(2)" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; {{translation.AddNewGopalCreditCardProfile}}</h5>
                        </button>
                    </li>
                    <li style="float: right;" id="divAddBtn" ng-show="ActionId==2">
                        <button type="button" ng-click="AddNewGopalCreditCardApp(1)" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; {{translation.BackToGopalCreditCardProfile}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div ng-show="divTabulation">
            <div class="col-md-12">
                <div class="table-responsive citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4" style="padding-left: 0;">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>

                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                    </div>
                    <table id="example" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('Name_ENG')">
                                    {{translation.ApplicantName}}
                                    <div ng-class="getSortClass('Name_ENG')"></div>
                                </th>
                                <th ng-click="sortData('RegistrationNo')">
                                    {{translation.ApplicationNo}}
                                    <div ng-class="getSortClass('RegistrationNo')"></div>
                                </th>
                                <th>
                                    {{translation.RegistrationDate}}
                                </th>
                                <th>
                                    {{translation.Status}}
                                </th>
                                <th>
                                    {{translation.Actions}}
                                </th>
                                @*<th>
                                        {{translation.Actions}}
                                    </th>*@
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in TableData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SocietyIdForTbl">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{item.Name_ENG}}</td>
                                <td>{{item.RegistrationNo}}</td>
                                <td>{{item.RegistrationDate_DDMMYYYY}}  </td>
                                @*<td>{{item.ActivationStatus}} </td>*@
                                <td>{{item.ProceesStatusTextEn}} </td>

                                <td class="add-more-td">
                                    <a title="VIEW" ng-click="ApplicationView(item.Encrypted_GopalCreditCardId, item.Encrypted_RegistrationNo)"><i class="fa fa-eye"></i></a>
                                    <a title="EDIT" ng-show="item.StatusId==1||item.StatusId==13||item.StatusId==14" ng-click="GetFormEditData(item.StatusId,item.Encrypted_GopalCreditCardId, item.Encrypted_RegistrationNo)"><i class="fa fa-edit"></i></a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="col-md-10">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="SocietyIdForTbl" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="ShowGopalCreditCardForm==true" >
            <div class="citizen-dash-head">
                <div class="caseformShow">
                    <form id="frmGopalForm">
                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> {{translation.PersonalDetail}} </h5>
                        </div>
                        <div class="col-lg-12" id="PersonalDetail">
                            <div class="row">
                                <div class="col-md-10">
                                    <div class="row">
                                        <div class="col-md-4  form-group">
                                            <label for="search">{{translation.Name}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled value="{{_language =='en-us' ?  GopalCreditCardModel.Name_ENG : GopalCreditCardModel.Name_HI}}" autocomplete="off" />
                                            <input type="hidden" ng-model="GopalCreditCardModel.Name_ENG" />
                                            <input type="hidden" ng-model="GopalCreditCardModel.Name_HI" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.FatherSpouseName}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled value="{{_language =='en-us' ?  GopalCreditCardModel.FatherName_ENG : GopalCreditCardModel.FatherName_HI}}" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.DOB}}/{{translation.Age}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled value="{{GopalCreditCardModel.DOB}}/{{GopalCreditCardModel.Age}}" autocomplete="off" />
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-2 form-group">
                                    <img src="{{(GopalCreditCardModel.MemberPhoto_Base64!=null && GopalCreditCardModel.MemberPhoto_Base64!='')?'data:image/jpg;base64,' + GopalCreditCardModel.MemberPhoto_Base64:'../content/images/dummyImg.jpg'}}" width="100" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-12">
                            <h5 class="heading-hr ng-binding"> {{translation.Address}}</h5>
                            <label><input type="checkbox" ng-model="GopalCreditCardModel.IsAddressSameAsJanAadhar" id="IsAddressSameAsJanAadhar" name="chkAddressSameAsJanAadhar" ng-click="IsAddressSameAsJanAadhar_Changed(1)"> {{translation.AddressSameAsJanAadhar}}:</label>
                        </div>
                        <div class="col-lg-12" id="Address">
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.HouseBuildingNo}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="HouseBuildingNo" ng-model="GopalCreditCardModel.HouseBuildingNo" placeholder="{{translation.HouseBuildingNo}}" autocomplete="off" >
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.LaneStreetName}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="LaneStreetName" ng-model="GopalCreditCardModel.LaneStreetName" placeholder="{{translation.LaneStreetName}}" autocomplete="off" >
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label>{{translation.Address}}<span class="error">*</span>:</label>
                                    <input type="text" class="form-control disabled" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar && GopalCreditCardModel.Address_ENG!=''" value="{{_language =='en-us' ?  GopalCreditCardModel.Address_ENG : GopalCreditCardModel.Address_HI}}" autocomplete="off" />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="control-label">{{ translation.PIN}}<span class="error">*</span></label>
                                    <input type="text" name="PinCode" class="form-control" ng-model="GopalCreditCardModel.PinCode" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar && GopalCreditCardModel.PinCode!=''" placeholder="{{translation.PIN}}" maxlength="6" ng-minlength="6" onkeypress='return event.charCode >= 48 && event.charCode <= 57' autocomplete="off">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.Locality}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="Locality" ng-model="GopalCreditCardModel.Locality" placeholder="{{translation.Locality}}" autocomplete="off" >
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.District}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.District_Code" class="form-control" ng-init="GopalCreditCardModel.District_Code='0'" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar" ng-change="ResetDataForAddress(1,2)">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_CODE}}">
                                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="form-check-label" for="inlineRadio1">{{translation.UrbanRural}}</label>
                                    <label class="help-block-gender">
                                        <input type="radio" id="sdfs" name="Urban" ng-value="0" ng-model="GopalCreditCardModel.IsRural" ng-change="RuralUrbanBlock(false)" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar">{{translation.Urban}}
                                    </label>
                                    <label class="help-block-gender">
                                        <input type="radio" id="sdf" ng-value="1" name="Rural" ng-model="GopalCreditCardModel.IsRural" ng-change="RuralUrbanBlock(true)" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar">{{translation.Rural}}
                                    </label>
                                </div>
                                <div class="col-md-6 form-group">

                                </div>
                            </div>
                            <div class="row" ng-show="RuralDiv">
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.BlockHeading}}<span class="error">*</span> </label>
                                    <select ng-model="GopalCreditCardModel.Block_Code" id="ddlblocki" class="form-control" ng-init="GopalCreditCardModel.Block_Code='0'" ng-change="GramPanchayatList(1)" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Blocksdata | orderBy:'BLOCK_ENG'" value="{{item.BLOCK_CODE}}">
                                            {{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.GramPanchayatHeading}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.GP_Code" id="ddlGP" class="form-control" ng-init="GopalCreditCardModel.GP_Code='0'" ng-change="VillageList(1)" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in GramPanchayats | orderBy:'GramPanchayats'" value="{{item.GP_CODE}}">
                                            {{_language =='en-us' ?  item.GP_ENG : item.GP_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="row" ng-show="RuralDiv">
                                <div class="col-md-6 form-group">
                                    <label>{{translation.Village}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.Village_Code" id="ddlVillage" class="form-control" ng-init="GopalCreditCardModel.Village_Code='0'" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Villages | orderBy:'VILLAGE_ENG'" value="{{item.VILLAGE_CODE}}">
                                            {{_language =='en-us' ?  item.VILLAGE_ENG : item.VILLAGE_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6 form-group">

                                </div>
                            </div>
                            <div class="row" ng-show="UrbanDiv">
                                <div class="col-md-6 form-group">
                                    <label>{{translation.City}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.City_Code" class="form-control" ng-change="GetWardList(1)" ng-init="GopalCreditCardModel.City_Code='0'" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in CityList" value="{{item.CITY_CODE}}">
                                            {{_language =='en-us' ?  item.CITY_ENG : item.CITY_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{translation.Ward}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.Ward_Code" class="form-control" ng-init="GopalCreditCardModel.Ward_Code='0'" ng-disabled="GopalCreditCardModel.IsAddressSameAsJanAadhar && GopalCreditCardModel.Ward_Code!='0'">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Ward" value="{{item.WARD_CODE}}">
                                            {{_language =='en-us' ?  item.WARD_ENG : item.WARD_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>


                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> {{translation.SelectCowherdFamily}} </h5>
                        </div>
                        <div class="col-lg-12 form-group" id="SelectCowherdFamily">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="citizen-dash-head">
                                        <table class="table table-responsive devtable" style="overflow-x:auto;">
                                            <thead>
                                                <tr>
                                                    <th width="10%">
                                                        {{translation.SRNO}}
                                                    </th>
                                                    <th width="30%">
                                                        {{translation.Name}}
                                                    </th>
                                                    <th width="20%">
                                                        {{translation.MobileNo}}
                                                    </th>
                                                    <th width="40%">
                                                        {{translation.SelectMember}}
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr dir-paginate="li in GopalCreditCardModel.janAaadharFamilyMemberModels | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                                    <td>
                                                        {{pageSize *(currentPage-1)+$index+1}}
                                                    </td>
                                                    <td>
                                                        {{_language =='en-us' ?  li.NAME : li.NAME_HINDI}}
                                                    </td>
                                                    <td>
                                                        {{li.Masked_MOBILE_NO}}
                                                    </td>
                                                    <td>
                                                        <input type="checkbox" ng-model="li.IsMemberSelected" ng-disabled="li.Age>25" id="chkIsFamilyMember{{li.Encrypted_JAN_MEMBER_ID}}" name="select" title="{{li.Age>25?translation.GCCRegistrationMsg_Age_25:''}}"  class="family-member-checkbox" >
                                                        @*<label ng-show="li.Age>25">
                                                                {{translation.GCCRegistrationMsg_Age_25}}
                                                            </label>*@
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> {{translation.GCCBankDetails}} </h5>
                        </div>
                        <div class="col-lg-12" id="GCCBankDetails">
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label for="txtBankAccountNo">{{translation.IsPACSBankAccountAvailable}}<span class="error">*</span>:</label>
                                    <label for="chkIsPACSBankAccountAvailableYes"><input type="radio" ng-value="true" ng-model="GopalCreditCardModel.IsPACSBankAccountAvailable" name="chkIsPACSBankAccountAvailable" id="chkIsPACSBankAccountAvailableYes" ng-click="IsPACSBankAccountAvailable_Changed(1)"> {{translation.Yes}}</label>
                                    <label for="chkIsPACSBankAccountAvailableNo"><input type="radio" ng-value="false" ng-model="GopalCreditCardModel.IsPACSBankAccountAvailable" name="chkIsPACSBankAccountAvailable" id="chkIsPACSBankAccountAvailableNo" ng-click="IsPACSBankAccountAvailable_Changed(0)">{{translation.No}}</label>
                                </div>
                                <div class="col-md-6 form-group">

                                </div>
                            </div>
                            <div class="row" ng-show="GopalCreditCardModel.IsPACSBankAccountAvailable">
                                <div class="col-md-6 form-group">
                                    <label for="txtBankAccountNo">{{translation.BankAccountNo}}<span class="error">*</span>:</label>
                                    <input type="text" class="form-control" ng-model="GopalCreditCardModel.BankAccountNo" id="txtBankAccountNo" name="txtBankAccountNo" maxlength="17" onkeypress='return event.charCode >= 48 && event.charCode <= 57' autocomplete="off">
                                </div>
                                <div class="col-md-6 form-group">
                                    <label for="txtBankIFSCCode">{{translation.BankAcIFSCNoInCCS}}<span class="error">*</span>:</label>
                                    <input type="text" class="form-control" ng-model="GopalCreditCardModel.BankIFSCCode" id="txtBankIFSCCode" name="txtBankIFSCCode" maxlength="30" autocomplete="off">
                                </div>
                            </div>
                            <div class="row" ng-show="GopalCreditCardModel.IsPACSBankAccountAvailable">
                                <div class="col-md-6 form-group">
                                    <label for="txtBankName">{{translation.BankName}}<span class="error">*</span>:</label>
                                    <input type="text" class="form-control" ng-model="GopalCreditCardModel.BankName" id="txtBankName" name="txtBankName" autocomplete="off">
                                </div>
                                <div class="col-md-6 form-group">
                                    <label for="txtBankName">{{translation.Branch}}<span class="error">*</span>:</label>
                                    <input type="text" class="form-control" ng-model="GopalCreditCardModel.BankBranchName" id="txtBankName" name="txtBankName" maxlength="100" autocomplete="off">
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> {{translation.RemittanceDetails}} </h5>
                        </div>
                        <div class="col-lg-12" id="RemittanceDetails">
                            <div class="row">
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.District}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.LoanDistrictId" class="form-control" ng-init="GopalCreditCardModel.LoanDistrictId='0'" ng-change="LoanBankList('0')" id="DistId">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.BankName}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.LoanBankID" ng-disabled="IsSubmiApplication" id="BankID" class="form-control" ng-init="GopalCreditCardModel.LoanBankID='0'" ng-change="Get_LoanBankBranch('0')">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in BankMasterList | orderBy:'BLOCK_ENG'" value="{{itemBlock.CCBId}}">
                                            {{_language =='en-us' ?  itemBlock.CCBNameEn : itemBlock.CCBNameHi}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.BankBranch}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.LoanBranchId" id="BranchId" class="form-control" ng-init="GopalCreditCardModel.LoanBranchId='0'" ng-change="Get_LoanBranch_PACS('0')">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in PLDBBranches | orderBy:'BLOCK_ENG'" value="{{itemBlock.Branch_ID}}">
                                            {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameEn}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.PACSName}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.PACS_ID" id="PacsId" class="form-control" ng-init="GopalCreditCardModel.PACS_ID='0'">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in PACSNameList | orderBy:'BLOCK_ENG'" value="{{itemBlock.PACS_ID}}">
                                            {{_language =='en-us' ?  itemBlock.PACSNameEn : itemBlock.PACSNameEn}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>


                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> {{translation.IsMemberOfDCS}} </h5>
                        </div>
                        <div class="col-lg-12" id="IsMemberOfDCS">
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label><input type="radio" ng-value="true" ng-model="GopalCreditCardModel.IsMemberOfDCS" name="IsMemberOfDCS" ng-click="IsMemberOfDCS_Changed(1)"> {{translation.Yes}}</label>
                                    <label> <input type="radio" ng-value="false" ng-model="GopalCreditCardModel.IsMemberOfDCS" name="IsMemberOfDCS" ng-click="IsMemberOfDCS_Changed(0)">{{translation.No}}</label>
                                </div>
                                <div class="col-md-6 form-group">

                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group" ng-show="GopalCreditCardModel.IsMemberOfDCS">
                                    <label for="txtDCSRegistrationNo">{{translation.DCSRegistrationNo}}:<span class="error">*</span></label>
                                    <input type="text" id="txtDCSRegistrationNo" ng-model="GopalCreditCardModel.DCSRegistrationNo" class="form-control" maxlength="100" onchange="angular.element(this).scope().GetDCSDetailByRegistrationNo()" autocomplete="off" />
                                </div>
                                <div class="col-md-6 form-group" ng-show="GopalCreditCardModel.IsMemberOfDCS">
                                    <label for="txtDCSName">{{translation.DCSName}}:<span class="error">*</span></label>
                                    <input type="text" id="txtDCSName" ng-model="GopalCreditCardModel.DCSName" class="form-control" maxlength="100" autocomplete="off" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group" ng-show="GopalCreditCardModel.IsMemberOfDCS">
                                    <label for="txtDCSOwnerName">{{translation.DCSOwnerName}}:<span class="error">*</span></label>
                                    <input type="text" id="txtDCSOwnerName" ng-model="GopalCreditCardModel.DCSOwnerName" class="form-control" maxlength="100" autocomplete="off" />
                                </div>
                                <div class="col-md-6 form-group" ng-show="GopalCreditCardModel.IsMemberOfDCS">
                                    <label for="txtDCSOwnerMobileNo">{{translation.DCSOwnerMobileNo}}:<span class="error">*</span></label>
