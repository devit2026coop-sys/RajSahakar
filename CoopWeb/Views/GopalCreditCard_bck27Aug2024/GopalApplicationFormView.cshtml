@model Cooperative.Models.GopalCreditCardModel.GopalCreditCardFormModel
<script src="~/Scripts/AngularFramework/GopalCreditCardApplicationFormView.js?id=1"></script>
<script type="text/javascript" src="~/Scripts/jqueryuitimepicker.js"></script>
<link href="~/Content/Stylesheets/jqueryuitimepicker.css" rel="stylesheet" />
<style>
    input[type=file].form-control {
        border: 1px solid #cccccc !important;
    }
</style>
<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }

    input[type=file].form-control {
        border: 1px solid #cccccc !important;
    }

    .dvfieldset {
        border: 1px solid #b0adad;
        border-radius: 5px;
        padding-bottom: 10px;
        margin-bottom: 20px;
        background: #fff;
    }

    .dvlegend {
        width: auto;
        padding: 24px;
        margin-left: 11px;
        border: 1px solid gray;
        padding: 5px;
        border-radius: 14px;
        font-size: 16px;
        padding-left: 14px;
        padding-right: 15px;
        background: #025e63;
        color: #fff;
    }

    label {
        color: #025e63;
        font-size: 14px;
    }

    .profile-d1 {
        color: #000;
        background: #fff;
        border-radius: 5px;
    }

    .profile-d1-hr {
        font-size: 17px;
        background: #025e63;
        padding: 10px 15px;
        color: #fff;
        border-radius: 4px;
    }

    .dev-spancon {
        font-size: 14px;
        color: #424242;
        font-weight: 700;
    }
</style>
@Html.Hidden("TemplateId")
<div ng-app="GopalCreditCardAppEntryForm" data-ng-init="init(@Newtonsoft.Json.JsonConvert.SerializeObject(Model))">
    <div ng-controller="GopalCreditCard">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.GopalCreditCardForm}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.EntryForm}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.GopalCreditCardApplicationForm}} </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <fieldset class="dvfieldset">
                <legend class="dvlegend">Application Details/आवेदन के ब्यौरे:</legend>
                <div class="col-lg-12">
                    <div class="col-md-2"><label>{{translation.GccRegNo}} :</label></div>
                    <div class="col-md-5">
                        <span class="dev-spancon">  {{GopalCreditCardModel.RegistrationNo}}</span>
                    </div>
                    <div class="col-md-1"><label>{{translation.Status}} :</label></div>
                    <div class="col-md-4">
                        <span class="dev-spancon">{{ _language =='en-us' ? ApplicationFlowGCC[0].ProceesStatusTextEn : ApplicationFlowGCC[0].ProceesStatusTextHi}}</span>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class=" profile-d1" style="margin-top: 30px;">
                        <div>
                            <h5 class="profile-d1-hr" style="text-align:center">{{_language=='en-us' ? 'Application Trail': 'आवेदन ट्रेल'}} </h5>
                        </div>
                        <div class="col-md-12 table-responsive ">
                            <table class="table table-responsive devtable" style="color:black" id="a">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.Status}}
                                        </th>
                                        <th>{{translation.AssignTo}}</th>
                                        <th>
                                            {{translation.Remarks}}
                                        </th>
                                        <th>
                                            {{translation.CreationDate}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="AppFlowOne in ApplicationFlowGCC | itemsPerPage: 50">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ _language =='en-us' ? AppFlowOne.ProceesStatusTextEn : AppFlowOne.ProceesStatusTextHi}}</td>
                                        <td>{{AppFlowOne.OfficerNameEn}}</td>
                                        <td>{{AppFlowOne.Remark}}</td>
                                        <td>{{AppFlowOne.ActionDate}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                </div>
            </fieldset>
            <div class="citizen-dash-head">
                <div class="caseformShow">
                    <form id="frmGopalForm">
                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> {{translation.PersonalDetail}} </h5>
                        </div>
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-md-10">
                                    <div class="row">
                                        <div class="col-md-4  form-group">
                                            <label for="search">{{translation.Name}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled value="{{_language =='en-us' ?  GopalCreditCardModel.Name_ENG : GopalCreditCardModel.Name_HI}}" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.FatherSpouseName}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled value="{{_language =='en-us' ?  GopalCreditCardModel.FatherName_ENG : GopalCreditCardModel.FatherName_HI}}" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.DOB}}/{{translation.Age}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled value="{{GopalCreditCardModel.DOB}}/{{GopalCreditCardModel.Age}}" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4  form-group">
                                            <label for="search">{{translation.ApplicationNo}}:</label>
                                            <input type="text" class="form-control disabled" disabled value="{{GopalCreditCardModel.RegistrationNo}}" />
                                        </div>
                                        <div class="col-md-4  form-group">
                                            <label for="search">{{translation.RegistrationDate}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled value="{{GopalCreditCardModel.RegistrationDate_DDMMYYYY}}" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label style="color:black;">{{translation.Category}} <span class="error">*</span></label>
                                            <select class="form-control" disabled ng-model="GopalCreditCardModel.Category">
                                                <option value="0">{{translation.SelectOption}}</option>
                                                <option ng-repeat="item1 in CategoryList" value="{{item1.CODEID}}" ng-selected="{{item.CategoryId==item1.CODEID}}">
                                                    {{_language =='en-us' ?  item1.CODENAME : item1.CODENAME_MANGAL}}
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4  form-group">
                                            <label for="search">{{translation.AADHARNo}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled ng-minlength="12" maxlength="12" ng-model="GopalCreditCardModel.AadharNo" placeholder="{{translation.AADHARNo}}" onkeypress="return event.charCode >= 48 && event.charCode <= 57" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.PANNo}}<span class="error">*</span>:</label>
                                            <input type="text" class="form-control disabled" disabled ng-minlength="10" maxlength="10" placeholder="{{translation.PANNo}}" ng-model="GopalCreditCardModel.PANCardNo" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="search">{{translation.MobileNo}}<span class="error">*</span>:</label>
                                            <input type="text" ng-minlength="10" maxlength="10" disabled onkeypress="return event.charCode >= 48 && event.charCode <= 57" class="form-control disabled" placeholder="{{translation.MobileNo}}" ng-model="GopalCreditCardModel.MobileNo" autocomplete="off" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 form-group">
                                            <label for="uploadAadharDoc"> {{translation.AadharDoc}}:</label>
                                            <a target="_blank" href="~/Content/GopalCreditCard/{{GopalCreditCardModel.AadharDoc}}" style="color: #337ab7;">View Aadhar Document<i class="fa fa-download"></i></a>

                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label for="uploadPanCardDoc"> {{translation.PanCardDoc}}:</label>
                                            <a target="_blank" href="~/Content/GopalCreditCard/{{GopalCreditCardModel.PanCardDoc}}" style="color: #337ab7;">View Pan Card Document<i class="fa fa-download"></i></a>

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2 form-group">
                                    <img src="~/Content/GopalCreditCard/{{GopalCreditCardModel.MemberPhoto}}" width="100" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-12">
                            <h5 class="heading-hr ng-binding"> {{translation.Address}}</h5>
                            <label><input type="checkbox" ng-model="GopalCreditCardModel.IsAddressSameAsJanAadhar" name="chkAddressSameAsJanAadhar" disabled> {{translation.AddressSameAsJanAadhar}}:</label>
                        </div>
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.HouseBuildingNo}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="HouseBuildingNo" ng-model="GopalCreditCardModel.HouseBuildingNo" placeholder="{{translation.HouseBuildingNo}}" autocomplete="off" disabled>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.LaneStreetName}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="LaneStreetName" ng-model="GopalCreditCardModel.LaneStreetName" placeholder="{{translation.LaneStreetName}}" autocomplete="off" disabled>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label>{{translation.Address}}<span class="error">*</span>:</label>
                                    <input type="text" class="form-control disabled" disabled value="{{_language =='en-us' ?  GopalCreditCardModel.Address_ENG : GopalCreditCardModel.Address_HI}}" />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="control-label">{{ translation.PIN}}<span class="error">*</span></label>
                                    <input type="text" name="PinCode" class="form-control" ng-model="GopalCreditCardModel.PinCode" disabled placeholder="{{translation.PIN}}" maxlength="6" ng-minlength="6" onkeypress='return event.charCode >= 48 && event.charCode <= 57' autocomplete="off">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.Locality}}<span class="error">*</span></label>
                                    <input type="text" class="form-control" name="Locality" ng-model="GopalCreditCardModel.Locality" placeholder="{{translation.Locality}}" autocomplete="off" disabled>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.District}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.District_Code" class="form-control" ng-init="GopalCreditCardModel.District_Code='0'" disabled ng-change="ResetDataForAddress(1,2)">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_CODE}}">
                                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="form-check-label" for="inlineRadio1">{{translation.UrbanRural}}</label>
                                    <label class="help-block-gender">
                                        <input type="radio" id="sdfs" name="Urban" value="0" ng-model="GopalCreditCardModel.IsRural" ng-change="RuralUrbanBlock(false)" disabled>{{translation.Urban}}
                                    </label>
                                    <label class="help-block-gender">
                                        <input type="radio" id="sdf" value="1" name="Rural" ng-model="GopalCreditCardModel.IsRural" ng-change="RuralUrbanBlock(true)" disabled>{{translation.Rural}}
                                    </label>
                                </div>
                                <div class="col-md-6 form-group">

                                </div>
                            </div>
                            <div class="row" ng-show="RuralDiv">
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.BlockHeading}}<span class="error">*</span> </label>
                                    <select ng-model="GopalCreditCardModel.Block_Code" id="ddlblocki" class="form-control" ng-init="GopalCreditCardModel.Block_Code='0'" ng-change="GramPanchayatList(1)" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Blocksdata | orderBy:'BLOCK_ENG'" value="{{item.BLOCK_CODE}}">
                                            {{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{ translation.GramPanchayatHeading}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.GP_Code" id="ddlGP" class="form-control" ng-init="GopalCreditCardModel.GP_Code='0'" ng-change="VillageList(1)" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in GramPanchayats | orderBy:'GramPanchayats'" value="{{item.GP_CODE}}">
                                            {{_language =='en-us' ?  item.GP_ENG : item.GP_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="row" ng-show="RuralDiv">
                                <div class="col-md-6 form-group">
                                    <label>{{translation.Village}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.Village_Code" id="ddlVillage" class="form-control" ng-init="GopalCreditCardModel.Village_Code='0'" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Villages | orderBy:'VILLAGE_ENG'" value="{{item.VILLAGE_CODE}}">
                                            {{_language =='en-us' ?  item.VILLAGE_ENG : item.VILLAGE_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6 form-group">

                                </div>
                            </div>
                            <div class="row" ng-show="UrbanDiv">
                                <div class="col-md-6 form-group">
                                    <label>{{translation.City}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.City_Code" class="form-control" ng-change="GetWardList(1)" ng-init="GopalCreditCardModel.City_Code='0'" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in CityList" value="{{item.CITY_CODE}}">
                                            {{_language =='en-us' ?  item.CITY_ENG : item.CITY_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label>{{translation.Ward}}<span class="error">*</span></label>
                                    <select ng-model="GopalCreditCardModel.Ward_Code" class="form-control" ng-init="GopalCreditCardModel.Ward_Code='0'" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Ward" value="{{item.WARD_CODE}}">
                                            {{_language =='en-us' ?  item.WARD_ENG : item.WARD_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> {{translation.RemittanceDetails}} </h5>
                        </div>
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.District}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.LoanDistrictId" class="form-control" ng-init="GopalCreditCardModel.LoanDistrictId='0'" ng-change="LoanBankList('0')" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.BankName}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.LoanBankID" id="BankID" class="form-control" ng-init="GopalCreditCardModel.LoanBankID='0'" ng-change="Get_LoanBankBranch('0')" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in BankMasterList | orderBy:'BLOCK_ENG'" value="{{itemBlock.CCBId}}">
                                            {{_language =='en-us' ?  itemBlock.CCBNameEn : itemBlock.CCBNameHi}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.BankBranch}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.LoanBranchId" id="BranchId" class="form-control" ng-init="GopalCreditCardModel.LoanBranchId='0'" ng-change="Get_LoanBranch_PACS('0')" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in PLDBBranches | orderBy:'BLOCK_ENG'" value="{{itemBlock.Branch_ID}}">
                                            {{_language =='en-us' ?  itemBlock.BranchNameEn : itemBlock.BranchNameEn}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label>
                                        {{translation.PACSName}}
                                    </label>
                                    <select ng-model="GopalCreditCardModel.PACS_ID" id="BranchId" class="form-control" ng-init="GopalCreditCardModel.PACS_ID='0'" disabled>
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="itemBlock in PACSNameList | orderBy:'BLOCK_ENG'" value="{{itemBlock.PACS_ID}}">
                                            {{_language =='en-us' ?  itemBlock.PACSNameEn : itemBlock.PACSNameEn}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label>1) {{translation.DoesTheMilkSaleToDCS}}:<span class="error">*</span></label>
                                <label for="chkDoesTheMilkSaleToDCSYes"><input type="radio" ng-value="true" disabled ng-model="GopalCreditCardModel.DoesTheMilkSaleToDCS" name="chkDoesTheMilkSaleToDCS" id="chkDoesTheMilkSaleToDCSYes" ng-click="DoesTheMilkSaleToDCS_Changed(1)"> {{translation.Yes}}</label>
                                <label for="chkDoesTheMilkSaleToDCSNo"><input type="radio" ng-value="false" disabled ng-model="GopalCreditCardModel.DoesTheMilkSaleToDCS" name="chkDoesTheMilkSaleToDCS" id="chkDoesTheMilkSaleToDCSNo" ng-click="DoesTheMilkSaleToDCS_Changed(0)">{{translation.No}}</label>
                            </div>
                        </div>
                        <div class="row" ng-show="GopalCreditCardModel.DoesTheMilkSaleToDCS">
                            <div class="col-md-4 form-group">
                                <label for="txtDCSName">{{translation.DCSName}}:<span class="error">*</span></label>
                                <input type="text" id="txtDCSName" disabled ng-model="GopalCreditCardModel.DCSName" placeholder="{{translation.SocietyName}}" class="form-control" maxlength="100" autocomplete="off" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label for="txtDCSMembershipNo">{{translation.DCSMembershipNo}}:<span class="error">*</span></label>
                                <input type="text" id="txtDCSMembershipNo" disabled ng-model="GopalCreditCardModel.DCSMembershipNo" placeholder="{{translation.MembershipNo}}" class="form-control" maxlength="30" autocomplete="off" />
                            </div>
                        </div>
                        <div class="row" ng-show="GopalCreditCardModel.DoesTheMilkSaleToDCS">
                            <div class="col-lg-12 padding_zero">
                                <h5 class="heading-hr ng-binding"> {{translation.AnimalDetails}} </h5>
                            </div>

                            <div class="col-md-2 form-group">
                                <label for="txtNoOfCows">{{translation.NoOfCows}}:<span class="error">*</span></label>
                                <input type="number" id="txtNoOfCows" disabled ng-model="GopalCreditCardModel.NoOfCows" onkeypress='return (event.charCode >= 48 && event.charCode <= 57)' class="form-control" maxlength="100" />
                            </div>
                            <div class="col-md-2 form-group">
                                <label for="txtNoOfbuffaloes">{{translation.NoOfbuffaloes}}:<span class="error">*</span></label>
                                <input type="number" id="txtNoOfbuffaloes" disabled ng-model="GopalCreditCardModel.NoOfbuffaloes" class="form-control" onkeypress='return (event.charCode >= 48 && event.charCode <= 57)' maxlength="100" autocomplete="off" />
                            </div>
                            <div class="col-md-2 form-group">
                                <label for="txtOtherAnimal">{{translation.Other}}:<span class="error">*</span></label>
                                <input type="number" id="txtOtherAnimal" disabled ng-model="GopalCreditCardModel.OtherAnimal" onkeypress='return (event.charCode >= 48 && event.charCode <= 57)' class="form-control" maxlength="10" autocomplete="off" />
                            </div>
                            <div class="col-md-2 form-group">
                                <label for="txtTotalAnimal">{{translation.TotalAnimal}}:<span class="error">*</span></label>
                                <input type="number" id="txtTotalAnimal" disabled ng-model="GopalCreditCardModel.TotalAnimal" value="{{GopalCreditCardModel.NoOfCows+GopalCreditCardModel.NoOfbuffaloes+GopalCreditCardModel.OtherAnimal}}" class="form-control" onkeypress='return (event.charCode >= 48 && event.charCode <= 57)' maxlength="100" autocomplete="off" readonly />
                            </div>
                            <div class="col-md-4 form-group">
                                <label for="txtEstimatedAmountOfMilkSoldToDCS">{{translation.EstimatedAmountOfMilkSoldToDCS}}:<span class="error">*</span></label>
                                <input type="text" id="txtEstimatedAmountOfMilkSoldToDCS" disabled ng-model="GopalCreditCardModel.EstimatedAmountOfMilkSoldToDCS" placeholder="0.00" class="form-control" maxlength="10" onkeypress='return (event.charCode >= 48 && event.charCode <= 57) || event.charCode==46' autocomplete="off" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label>2) {{translation.IsPACSLAMPSMember}}:<span class="error">*</span></label>
                                <label><input type="radio" ng-value="true" disabled ng-model="GopalCreditCardModel.IsPACSLAMPSMember" name="PACSLAMPSArea" ng-click="IsPACSLAMPSMember_Changed(1)"> {{translation.Yes}}</label>
                                <label><input type="radio" ng-value="false" disabled ng-model="GopalCreditCardModel.IsPACSLAMPSMember" name="PACSLAMPSArea" ng-click="IsPACSLAMPSMember_Changed(0)"> {{translation.No}}</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 form-group" ng-show="GopalCreditCardModel.IsPACSLAMPSMember">
                                <label for="txtPACSLAMPSMembershipNo"> {{translation.PACSLAMPSMembershipDetail}}:<span class="error">*</span></label>
                                <input type="text" id="txtPACSLAMPSMembershipNo" disabled ng-model="GopalCreditCardModel.PACSLAMPSMembershipNo" placeholder="{{translation.MembershipNoCCS}}" class="form-control" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-lg-12 padding_zero">
                            <h5 class="heading-hr ng-binding"> {{translation.SelectCowherdFamily}} </h5>
                        </div>
                        <div class="col-lg-12 form-group">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="citizen-dash-head">
                                        <table class="table table-responsive devtable" style="overflow-x:auto;">
                                            <thead>
