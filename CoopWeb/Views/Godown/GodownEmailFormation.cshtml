<style>
    .modal-title {
        color: #000;
    }

    #sendEmailModal .modal-body label {
        color: #000;
    }

    .FileAttached-container {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        background: #fff;
    }

    .FileAttached-input {
        display: none;
    }

    .FileAttached-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border: 1px dashed #4577d4;
        border-radius: 6px;
        color: #245fc7;
        background: #f5f8ff;
        cursor: pointer;
        white-space: nowrap;
        margin: 0;
    }

    .uploaded-document {
        display: flex;
        align-items: center;
        flex: 1;
        min-width: 220px;
        gap: 12px;
        padding: 8px 10px;
        border: 1px solid #e0e4ea;
        border-radius: 6px;
        background: #f9fafb;
    }

    .uploaded-document-info {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        min-width: 0;
    }

    .pdf-icon {
        padding: 9px 7px;
        border-radius: 4px;
        background: #fee4e2;
        color: #b42318;
        font-size: 11px;
        font-weight: bold;
    }

    .uploaded-document-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 13px;
        color: #000;
    }

    .uploaded-document-actions {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .document-view-btn,
    .document-remove-btn {
        padding: 7px 10px;
        border: 1px solid #d0d5dd;
        border-radius: 4px;
        background: #fff;
        cursor: pointer;
    }

    .document-view-btn {
        color: #245fc7;
    }

    .document-remove-btn {
        color: #b42318;
    }


    input.FileAttached-input[type="file"] {
        display: none !important;
    }

    .FileAttached-label i {
        font-size: 20px;
        color: #245fc7;
    }


    .society-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        max-height: 220px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, .12);
        z-index: 1050;
    }

    .society-option {
        padding: 9px 12px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
        overflow-wrap: anywhere;
    }

        .society-option:hover {
            background: #f2f6fc;
        }

        .society-option input {
            margin-right: 8px;
        }

    .selected-emails {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .email-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #eaf2ff;
        border: 1px solid #cbdcf7;
        border-radius: 15px;
        padding: 5px 9px;
        font-size: 12px;
        overflow-wrap: anywhere;
    }

    .remove-email {
        cursor: pointer;
        font-weight: bold;
        font-size: 16px;
    }

    .select2-container {
        width: 100% !important;
    }

        .select2-container .select2-selection--multiple {
            min-height: 38px;
            width: 100%;
            box-sizing: border-box;
        }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove span {
        color: #f00;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #012f31 !important;
        border: 1px solid #012f31 !important;
    }
</style>
<!-- Select2 -->
<link href="~/Content/Stylesheets/select2.min.css" rel="stylesheet" />
<script src="~/Scripts/select2.min.js"></script>
<script src="~/Scripts/AngularFramework/GodownEmailFormation.js?v=@DateTime.Now.Ticks"></script>
<div ng-app="GodownEmailFormationModule" ng-cloak="">
    <div ng-controller="GodownEmailFormationCtrl">
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:20px;">Godown Email Formation</h3>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <input type="hidden" id="hdnMappingId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).UserRoleDeptMappingId)" />
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#" class="ng-binding">Home</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;" class="ng-binding"> Godown </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;" class="ng-binding"> Godown Formation Action </span>
                    </li>

                </ul>
            </div>
        </div>


        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-lui">
                    <div class="row">
                    </div>
                </div>
                <div class="table-wrap table-responsive" id="DivRecord">
                    <div class="row mb-4 mt-4" style=" display: flex; align-items: end; flex-wrap: wrap;">
                        <div class="col-md-2">
                            <label>Search:</label>
                            <input type="text" class="form-control" ng-model="searchParams.searchingData" placeholder="Search by Application No or Society Name" />
                        </div>

                        <div class="col-md-6 mt-5">
                            <button type="button" class="btn btn-primary dev-btn" ng-click="GetGodownEmailFormationList(searchParams.searchingData)">Search</button>
                            <button type="button" class="btn btn-primary dev-btn" ng-click="ClearSearch()">Clear</button>
                        </div>
                    </div>

                    <table class="table table-responsive devtable" id="tblgetsuport">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Application No.</th>
                                <th>Society Name</th>
                                <th>Pacs Manager Name</th>
                                <th>Gram Panchayat</th>
                                <th>Block</th>
                                <th>District</th>
                                <th>CCB Name</th>
                                <th>CCB Branch Name</th>
                                <th>Status</th>
                                <th ng-if="IsASAvailable">AS Details</th>
                                <th ng-if="IsFSAvailable">FS Details</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in godownFormationDataList | filter: q | orderBy:colsort:reverseSort  | itemsPerPage: pageSize" current-page="currentPage" pagination-id="GETGodownFormationListDataPagination">
                                <td><input type="radio" name="SelectedApplication" ng-model="$parent.SelectedApplicationId" ng-value="item.Applicationid" ng-change="CheckSelection(item)" /></td>
                                <td>{{ item.ApplicationNo }}</td>
                                <td>{{ item.SocietyName  }}</td>
                                <td>{{ item.PacsManagerName  }}</td>
                                <td>{{ item.GramPanchayat  }}</td>
                                <td>{{ item.Block  }}</td>
                                <td>{{ item.District  }}</td>
                                <td>{{ item.CCBName }}</td>
                                <td>{{ item.BranchName }}</td>
                                <td>{{ item.Status  }}</td>
                                <!-- AS -->
                                <td ng-if="IsASAvailable">
                                    <a ng-if="item.ASGeneratePath" href="../Content/GodownDocument/{{item.ASGeneratePath}}" target="_blank" title="View AS File">
                                        <i class="fa fa-file text-success"></i>
                                    </a>
                                </td>
                                <!-- FS -->
                                <td ng-if="IsFSAvailable">
                                    <a ng-if="item.FSGeneratePath" href="../Content/GodownDocument/{{item.FSGeneratePath}}" target="_blank" title="View FS File">
                                        <i class="fa fa-file text-success"></i>
                                    </a>
                                </td>
                                <td>
                                    <!-- Send Email: show only when document is available -->
                                    <a ng-click="OpenSendEmailPopup(item)" style="cursor: pointer;" title="Send Email">
                                        <i class="fa fa-envelope text-primary"></i>
                                    </a>
                                    <a ng-show="item.IsFSAvailable" style="cursor: pointer;" ng-click="OpenSendEmailPopup(item)" title="Send Email">
                                        <i class="fa fa-envelope text-primary"></i>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal fade" id="sendEmailModal" data-backdrop="static" data-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="sendEmailModalLabel">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <!-- Header -->
                        <div class="modal-header">
                            <button type="button" class="close" ng-click="ClearModal()" aria-label="Close">
                                &times;
                            </button>
                            <h4 class="modal-title" id="sendEmailModalLabel">
                                <i class="fa fa-envelope text-primary"></i>
                                Send Godown FS Document by Email
                            </h4>
                        </div>
                        <!-- Body -->
                        <div class="modal-body">
                            <div class="form-group">
                                @*<label>To <span class="text-danger">*</span></label>*@
                                @*<input type="email" class="form-control" ng-model="EmailData.ToEmail" placeholder="Recipient email address" required />*@

                                <label>To <span class="text-danger">*</span></label>
                                <select name="ToEmail" class="form-control" id="ddlToEmail" ng-model="EmailData.ToEmailList" multiple required select2 placeholder="Recipient email address">
                                    <option ng-repeat="item in EmailDataList track by $index" value="{{item.Email}}">
                                        {{item.Email}}
                                    </option>
                                </select>
                            </div>

                            <!-- TO EMAIL -->
                            @*<div class="form-group" ng-if="EmailData.ToEmailList && EmailData.ToEmailList.length > 0">
                                    <label>CC</label>
                                    <input type="text" class="form-control" ng-model="EmailData.CC" placeholder="Enter CC email(s), separated by commas" />
                                </div>

                                <div class="form-group" ng-if="EmailData.ToEmailList && EmailData.ToEmailList.length > 0">
                                    <label>BCC</label>
                                    <input type="text" class="form-control" ng-model="EmailData.BCC" placeholder="Enter BCC email(s), separated by commas" />
                                </div>*@
                            <!-- CC -->
                            <div class="form-group" ng-if="EmailData.ToEmailList && EmailData.ToEmailList.length > 0">
                                <label>CC</label>
                                <select id="ddlCCEmail" class="form-control" ng-model="EmailData.CCList"
                                        select2 multiple placeholder="Search CC email">
                                    <option ng-repeat="item in EmailDataList track by $index" value="{{item.Email}}">
                                        {{item.Email}}
                                    </option>
                                </select>
                            </div>

                            <!-- BCC -->
                            <div class="form-group" ng-if="EmailData.ToEmailList && EmailData.ToEmailList.length > 0">
                                <label>BCC</label>
                                <select id="ddlBCCEmail" class="form-control" ng-model="EmailData.BCCList" select2 multiple placeholder="Search BCC email">
                                    <option ng-repeat="item in EmailDataList track by $index" value="{{item.Email}}">
                                        {{item.Email}}
                                    </option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>Subject <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" placeholder="Subject" ng-model="EmailData.Subject" maxlength="200" required />
                            </div>

                            <div class="form-group">
                                <label>Message</label>
                                <textarea class="form-control" ng-model="EmailData.Body" rows="4" placeholder="Enter your message"></textarea>
                            </div>
                            <div class="FileAttached">
                                <div class="FileAttached-container">
                                    <input type="file" id="attachedDocument" class="FileAttached-input" accept=".pdf,application/pdf" onchange="angular.element(this).scope().onDocumentSelected(this)" />
                                    <label for="attachedDocument" class="FileAttached-label">
                                        <i class="fa fa-paperclip" aria-hidden="true"></i>
                                        <span>Attached Document</span>
                                    </label>
                                    <div id="uploadedDocument" class="uploaded-document" ng-if="EmailData.selectedDocument">
                                        <div class="uploaded-document-info">
                                            <span class="pdf-icon">PDF</span>
                                            <span class="uploaded-document-name" title="{{EmailData.selectedDocument.name}}">
                                                {{EmailData.selectedDocument.name}}
                                            </span>
                                        </div>
                                        <div class="uploaded-document-actions">
                                            <button type="button" class="document-view-btn" ng-click="viewDocument()">
                                                View PDF
                                            </button>
                                            <button type="button" class="document-remove-btn" ng-click="removeDocument()">
                                                Remove
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" ng-click="ClearModal()">
                                Cancel
                            </button>

                            <button type="button" class="btn btn-primary" ng-click="SendEmail()" ng-disabled="!EmailData.ToEmailList && EmailData.ToEmailList.length > 0 || !EmailData.Subject">
                                <i class="fa fa-envelope"></i>
                                Send Email
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#ckbCheckAll").click(function () {
            $(".checkBoxClass").prop('checked', $(this).prop('checked'));
        });

        $(".checkBoxClass").change(function () {
            if (!$(this).prop("checked")) {
                $("#ckbCheckAll").prop("checked", false);
            }
        });
    });

</script>
