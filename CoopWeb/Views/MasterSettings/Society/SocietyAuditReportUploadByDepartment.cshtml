                    <tr dir-paginate="item in GetAuditorAssignReportDataShow1 | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="ClassFormatPagination">
                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                        <td>
                            {{item.SocietyName}}
                        </td>
                        <td>
                            <a href={{item.AuditReport}} target="_blank">{{translation.FincialYearHeading }}({{item.FIN_YEAR_NAME}})</a>
