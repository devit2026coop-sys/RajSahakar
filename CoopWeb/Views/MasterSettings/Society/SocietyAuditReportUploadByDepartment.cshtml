        <div class="col-md-4">
            @*<input class="form-check-input" type="radio" name="SocietyWorking" id="rbSocietyWorkingY" value="true" ng-model="SocietyAuditReport.IsSocietyWorking">
            <label class="form-check-label option_value ng-binding" style="margin-right: 15px;">{{translation.Yes}}</label>
            <input class="form-check-input" type="radio" name="SocietyWorking" id="rbSocietyWorkingN" value="false" ng-model="SocietyAuditReport.IsSocietyWorking">
            <label class="form-check-label option_value ng-binding">{{translation.No}}</label>*@
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 form-group">
        <div class="col-md-2">
            <label>{{ translation.FinancialYearAuditReportAvailable}}<span class="error">*</span></label>
        </div>
        <div class="col-md-4">
            <select class="form-control" ng-model="SocietyAuditReport.FinancialYear" ng-init="SocietyAuditReport.FinancialYear='0'">
                <option value="0" disabled>{{translation.SelectOption}}</option>
                <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_MASTR_ID}}">
                    {{item.FIN_YEAR_NAME}}
                </option>
            </select>
        </div>
        <div class="col-md-2">
            <label>{{ translation.UploadAuditReport}}</label>
        </div>
        <div class="col-md-4">
            <input id="flAuditReport" type="file" filetype="PDF" name="AuditReport" class="form-control" ng-model="SocietyAuditReport.AuditReport" onchange="angular.element(this).scope().UploadSocietyAuditFile(this.files)">
        </div>

        <div class="form-group col-md-12">
            <div class="dev-align-btn">
                <button type="submit" class="btn btn-primary dev-btn" ng-click="SaveSocietyAuditDetails()">{{translation.Submit}}</button>
                <button type="button" class="btn btn-primary dev-btn" ng-click="ClearSocietyAuditReportForm()">{{translation.Clear}}</button>
                <button type="submit" class="btn btn-primary dev-btn" ng-click="BackToPage()">{{translation.Back}}</button>
                <input type="hidden" name="hdfSocietyId" ng-model="hdfSocietyId" />

                @*<a ng-click="BackToPage()" data-toggle="modal" style="color:#ef0707;float:right;text-decoration:none;cursor:pointer" class="ng-binding">» {{translation.Back}}</a>*@
            </div>
        </div>

    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 dev-search-form " style="overflow: hidden;">
        <div class="col-md-4">
            <label for="search">{{translation.Search}}:</label>
            <input ng-model="q" id="search" class="form-control" placeholder="Filter text" autocomplete="off">
        </div>
        <div class="col-md-4">
            <label for="search">{{translation.ItemPerPage}}:</label>
            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <table class="table devtable">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                        <th ng-click="sortData('SocietyName')">
                            {{translation.SocietyName}}
                            <div ng-class="getSortClass('SocietyName')"></div>
                        </th>
                        <th ng-click="sortData('FIN_YEAR_NAME')">
                            {{translation.SocietyAuditReport}}
                            <div ng-class="getSortClass('FIN_YEAR_NAME')"></div>
                        </th>
                        @*<th ng-click="sortData('ClassNameEn')">
            {{translation.IsAuditReportAudit}}
            <div ng-class="getSortClass('ClassNameEn')"></div>
        </th>
        <th ng-click="sortData('ClassNameEn')">
            {{translation.Byauthorized}}
            <div ng-class="getSortClass('ClassNameEn')"></div>
