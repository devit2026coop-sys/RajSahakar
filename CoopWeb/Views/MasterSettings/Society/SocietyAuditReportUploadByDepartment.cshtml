                <label class="form-check-label option_value ng-binding" style="margin-right: 15px;">{{translation.ByRegistrar}}</label>
                <input class="form-check-input" type="radio" name="ApprovedBy" id="rbApprovedByBoard" value="2" ng-model="SocietyAuditReport.ApprovedBy">
                <label class="form-check-label option_value ng-binding">{{translation.ByBoard}}</label>
