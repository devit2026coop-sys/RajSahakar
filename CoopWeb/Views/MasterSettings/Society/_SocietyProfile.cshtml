<script type="text/javascript">
    function Removetr(Control) {
        if (confirm("Are you sure to remove this Data?")) {
            var index = -1;
            $(Control).parents('#myTable tr').find('[Id^="Remove_"]').each(function (e, res) {
                if ($(Control).attr('id') == $(res).attr('id')) {
                    index = e;
                }
            });

            if (index >= 0) {
                $(Control).parent().parent().remove();
            }
            else {

                // alert("Can't delete this item");
            }
        }
    };
    function ValidateAlphaNumericAndSlash(evt) {
        // alert(evt.keyCode);
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32) {
            //    alert("not cahr");
            if ((keyCode >= 48 && keyCode <= 57) || keyCode == 47) {
                //     alert(" num or slash");
                return true;
            }
            else {
                //    alert("not cahr and num");
                return false;
            }
        } else {
            //    alert("cahr");
            return true;
        }
    };
    function EntrenceFeeCalculate(value) {
        if (value > 0)
        {
            if ($('#lblFeeCalculate').html() == "0") {
                $('#txtEntranceFees').val(0);
            }
            else {
                $('#txtEntranceFees').val(value * 11);
            }
        }
        else if (value == 0)
            $('#txtEntranceFees').val(0);
    }

</script>

<script type="text/javascript">
    function blockSpecialChar(e) {
        var k;
        document.all ? k = e.keyCode : k = e.which;
        return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || k == 32 || (k >= 47 && k <= 57));
    }
</script>


<script type="text/javascript">
    function DateCheck() {
        var RegistrationDate = $("#txtRegistrationDate").val();
        var ElectionDate = $("#txtElectionDate").val();
        var SportRegistrationDate = $("#txtSportRegistrationDate").val();
        var SportElectionDate = $("#txtSportElectionDate").val();
        var AGM = $("#txtSportAgmDate").val();

        if (RegistrationDate > ElectionDate) {
            alert("Please ensure that the RegistrationDate is greater than or equal to the ElectionDate.");
            $("#txtElectionDate").val('');


        }
        if (SportRegistrationDate > SportElectionDate && SportElectionDate != '') {
            alert("Please ensure that the SportRegistrationDate is greater than or equal to the Sport Election Date.");

            $("#txtSportElectionDate").val('');

        }
        if (SportRegistrationDate > AGM && AGM != '') {
            alert("Please ensure that the SportRegistrationDate is greater than or equal to the AGM Date.");
            $("#txtSportAgmDate").val('');
        }
        else {
            return false;
        }
    }
</script>


