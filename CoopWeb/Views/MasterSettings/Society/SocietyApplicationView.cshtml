<script src="~/Scripts/AngularFramework/SocietyApplicationView.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script type="text/javascript">
    function OnSuccess(data) {
        $('#preloader').hide();
        if (data.UserType == 'C') {
            //$('#FormPost').html(data.result);
            //$('#FormPost').find('form').submit();
            alert('Society Details Save Successful');
            window.location = "../Society/SocietyApplicationView?SocietyIDEnc=" + data.SocietyIdEnc + "~_Citizen_SocietyProfile~";
        }
        else {
            if (data.result == '1') {
                alert('Society Details Save Successful');
                window.location = "../Society/SocietyApplicationView?SocietyIDEnc=" + data.SocietyIdEnc + "~_Citizen_SocietyProfile~";

            }
            else {
                ShowModelAlert("Society Administrative Details", 'Issue in Payment Receiveing Please Try after Some time');
            }
        }
    }
    function OnFailure(data) {
        $('#preloader').hide();
        alert(JSON.stringify(data));
    }
    function OnBegin() {
        $('#preloader').show();
    }
</script>
<script>
    function printpage() {
        var divToPrint = document.getElementById("printTable");
        newWin = window.print();
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();
    }
</script>
