<script type="text/javascript">
    function RemoveRowAdminiAct2001(Control, row) {
        if (confirm("Are you sure to remove this file?")) {
            //  $("button").show();
            $(Control).closest('tr').remove();
        }
    };

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))

            return false;
        return true;
    };

    function RemoveSportsData(Control, row) {
        if (confirm("Are you sure to remove this file?")) {
            var index = -1;
            $(Control).parents('#SportTableAdd tr').find('[Id^="Remove_"]').each(function (e, res) {
                if ($(Control).attr('id') == $(res).attr('id')) {
                    index = e;
                }
            });
            var id = $(Control).attr('id').replace("Remove_", '');
            var File = $(Control).parents('#SportTableAdd tr').find('[Id^="File_' + id + '"]');

            //alert(File.val().length+"---a---"+id);
            if (File.val().length > 0) {
                // alert(JSON.stringify(ImageDataList));
                for (var temRowNo = 0; temRowNo < ImageDataList.length; temRowNo++) {
                    //alert(ImageDataList[temRowNo].RowNo + "---d---" + row);
                    if (ImageDataList[temRowNo].RowNo == row) {
                        ImageDataList.splice(temRowNo);
                    }
                }
                // alert(JSON.stringify(ImageDataList));
            }

            if (index >= 0) {
                $(Control).parent().parent().remove();
                $("#Remove_" + (row - 1)).show();
            }
            else {
                alert("Can't delete this item");
            }
        }
    };
    function RemoveExecutiveSportsData(Control) {

        if (confirm("Are you sure to remove this file?")) {
            var index = -1;
            $(Control).parents('#SportExecutiveTable tr').find('[Id^="Remove_"]').each(function (e, res) {
                if ($(Control).attr('id') == $(res).attr('id')) {
                    index = e;
                }
            });

            var id = $(Control).attr('id').replace("Remove_", '');
            var File = $(Control).parents('#SportExecutiveTable tr').find('[Id^="File_' + id + '"]');

            if (File.val().length > 0) {
                var N = File.val().split("\\");
                $.each(SportImageDataList, function (index, value) {
                    if (value.name == N[N.length - 1]) {
                        alert('Match');
                        SportImageDataList.splice(index);
                    }
                });
            }

            if (index >= 0) {
                $(Control).parent().parent().remove();

            }
            else {
                alert("Can't delete this item");
            }


            if ($('#SportExecutiveTable tr').length < 22) {
                $('#btnAddMoreExecutiveSports').show();
            }
            else {
                $('#btnAddMoreExecutiveSports').hide();
            }
        }
    };


</script>



