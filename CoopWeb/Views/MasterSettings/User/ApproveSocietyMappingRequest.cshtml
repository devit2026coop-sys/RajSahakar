<div ng-app="SocietyMappingRequestApprovalMod">
    <div ng-controller="SocietyMappingRequestApprovalCnt">

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head"> {{translation.ApproveSocietyMappingRequest}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.ApproveSocietyMappingRequest}} </span>
                    </li>
                </ul>
            </div>
        </div>


        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="profile-d1" ng-show="divViewShow">
                <div class="col-lg-12 table-responsive">
                    <table class="col-lg-12 table ">

                        <tr>
                            <td colspan="4">
                                <div>
                                    <h5 class="profile-d1-hr">{{translation.Society}} {{translation.SocietyDetails}} </h5>
                                </div>
                            </td>
                        </tr>




                        <tr>
                            <td>
                                <label>{{translation.SocietyName}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon">{{RequestDetails.SocietyName }} OK</span>
                            </td>
                            <td>
                                <label>{{ translation.Act}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon">{{_language=='en-us' ? RequestDetails.ActNameEn : RequestDetails.ActNameHi}}</span>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <label>{{translation.SocietyRegistrationNo}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon">{{RequestDetails.RegistrationNo}}</span>
                            </td>
                            <td>
                                <label>{{translation.SocietyTyped}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon">{{_language=='en-us' ? RequestDetails.TypeameEng : RequestDetails.TypeNameHin}}</span>
                            </td>
                        </tr>
                       
                        <tr>
                            <td colspan="4">
                                <div>
                                    <h5 class="profile-d1-hr"> {{translation.ApplicantDetails}} </h5>
                                </div>
                            </td>
                        </tr>


                        <tr>
                            <td>
                                <label>{{translation.Name}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{ RequestDetails.Name }}  </span>
                            </td>
                            <td>
                                <label>{{translation.FatherHusbandName}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{RequestDetails.FatherName}}</span>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <label>{{translation.AADHARNo}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{ RequestDetails.AADHARNo }}  </span>
                            </td>
                            <td>
                                <label>{{translation.DOB}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{RequestDetails.DOB}}</span>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <label>{{translation.Gender}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{ RequestDetails.Gender ==='M' ? translation.GenderMale : translation.GenderFeMale}}  </span>
                            </td>
                            <td>
                                <label>{{translation.Photo}} :</label>
                            </td>
                            <td>
                                <img src="{{RequestDetails.Photo}}" alt="Userphoto" width="100" height="100" />
                            </td>
                        </tr>

                        <tr>
                            <td colspan="4">
                                <div>
                                    <h5 class="profile-d1-hr"> {{translation.OtherDetails}} </h5>
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <label>{{translation.MobileNo}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{ RequestDetails.MobileNo }}  </span>
                            </td>
                            <td>
                                <label>{{translation.Category}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{ _language ==='en-us' ? RequestDetails.CODENAME : RequestDetails.CODENAME_MANGAL}} </span>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <label>{{translation.PostHeading}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{ RequestDetails.PostName}}  </span>
                            </td>
                            <td>
                                <label>{{translation.Occupation}} :</label>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{RequestDetails.Occupation}}</span>
                            </td>
                        </tr>


                        <tr>
                            <td>
                                <span class="dev-spancon"> {{ translation.NextAction}}  </span> <span class="error">*</span>
                            </td>
                            <td>
                                <select id="ddlCategory" ng-model="ProcessData.NextActionId" class="form-control" ng-init="ProcessData.NextActionId='0'" ng-change="GetNextRoleList()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in ActionsList | orderBy:'ProceesStatusTextHi'" value="{{item.SocietyProceesStatusIdChild}}">
                                        {{_language =='en-us' ?  item.ProceesStatusTextEn : item.ProceesStatusTextHi}}
                                    </option>
                                </select>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{ translation.RoleHeading}}  </span> <span class="error">*</span>
                            </td>
                            <td>
                                <select id="ddlCategory" ng-model="ProcessData.NextRoleId" class="form-control" ng-init="ProcessData.NextRoleId='0'" ng-change="GetNextUserList()"  ng-disabled="isControlDisable">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in NextRoleList| orderBy:'RoleName_HI'" value="{{item.RoleID}}">
                                        {{_language =='en-us' ?  item.RoleName_EN : item.RoleName_HI}}
                                    </option>
                                </select>
                            </td>
                        </tr>


                        <tr>
                            <td>
                                <span class="dev-spancon"> {{ translation.NextUser}}  </span> <span class="error">*</span>
                            </td>
                            <td>
                                <select id="ddlCategory" ng-model="ProcessData.NextUserId" class="form-control" ng-init="ProcessData.NextUserId='0'" ng-disabled="isControlDisable">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in NextUserList | orderBy:'OfficerNameHi'" value="{{item.userid}}">
                                        {{_language =='en-us' ?  item.OfficerNameEn : item.OfficerNameHi}}
                                    </option>
                                </select>
                            </td>
                            <td>
                                <span class="dev-spancon"> {{ translation.Remark}}  </span> <span class="error">*</span>
                            </td>
                            <td>
                                <textarea rows="6" cols="125" style="margin: 0px; width: 341px; height: 74px;" placeholder="{{translation.Remarks}}" ng-model="ProcessData.Remark" maxlength="200" ng-minlength="1" autocomplete="off"> </textarea>
                            </td>
                        </tr>
                    </table>
                    <div class="form-group col-md-12">
                        <div class="dev-align-btn">
                            <button type="submit" class="btn btn-primary dev-btn" ng-click="ProcessRequest()">{{translation.Submit}}</button>
                            <button type="button" class="btn btn-primary dev-btn" ng-click="ClearUserApprovalForm()">{{translation.Back}}</button>
                            <input type="hidden" ng-model="UserRegistration.RequestId" id="hfRequestId" value="{{RequestDetails.SocietyMappingRequestId}}" />
                        </div>
                    </div>
                </div>
                <div class="clearfix"> </div>



            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divGrid">

            <div class="citizen-dash-head">
                <table class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.SocietyName}}
                            </th>
                            <th>
                                {{translation.Act}}
                            </th>
                            <th>
                                {{translation.ApplicantName}}
                            </th>
                            <th>
                                {{translation.MobileNo}}
                            </th>
                            <th>
                                {{translation.Status}}
                            </th>
                            <th>
                                {{translation.TransactionLog}}
                            </th>
                            <th>
                                {{translation.TakeAction}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="Item in SocietyMappingRequest | filter: q | orderBy:colsort:reverseSort  | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuPagination">

                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{ Item.SocietyName | uppercase }}</td>
                            <td>{{ _language==='en-us' ? Item.ActNameEn : Item.ActNameHi  }}</td>
                            <td>{{ Item.Name | uppercase }}</td>
                            <td>{{ Item.MobileNo }}</td>
                            <td>
                                {{ _language==='en-us' ? Item.ProceesStatusTextEn : Item.ProceesStatusTextHi  }}
                            </td>
                            <td>
                                <i class="fa fa-eye" data-target="#myModal" data-toggle="modal" ng-click="ShowMappingLog(Item.SocietyMappingRequestId)"></i>
                            </td>
                            <td>
                                <i class="fa fa-eye" ng-click="ViewDetails(Item)"></i>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>


        <div class="modal fade" id="myModal" role="dialog">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4> <label> {{translation.ApproveSocietyMappingRequest}} </label></h4>
                    </div>
                    <div class="modal-body">

                        <form class="dev-search-form" name="MyInspectionForm" style="overflow: hidden;">
                            <div class="citizen-dash-head">
                                <table class="table table-responsive devtable">
                                    <thead>
                                        <tr>
                                            <th>
                                                {{translation.SRNO}}
                                            </th>
                                            <th>
                                                {{translation.Actions}}
                                            </th>
                                            <th>
                                                {{translation.ActionBy}}
                                            </th>
                                            <th>
                                                {{translation.MarkTo}}
                                            </th>
                                            <th>
                                                {{translation.Remarks}}
                                            </th>
                                            <th>
                                                {{translation.Date}}
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="Item in LogData">

                                            <td>{{$index+1}}</td>
                                            <td>{{ _language==='en-us' ? Item.ProceesStatusTextEn : Item.ProceesStatusTextHi | uppercase }}</td>
                                            <td>{{ _language==='en-us' ? Item.RequestByUserEn : Item.RequestByUserEn  }} ({{ _language==='en-us' ? Item.RoleName_EN : Item.RoleName_HI  }} )</td>
                                            <td>{{Item.NextUserEn | uppercase}} ({{ _language==='en-us' ? Item.NextRoleName_EN : Item.NextRoleName_HI  }} )</td>
                                            <td>{{ Item.Remark | uppercase }}</td>
                                            <td>{{ Item.ActionDateTime }}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
        <div class="form-group col-md-12" ng-show="BackBtnLast">
            <center>
                <div class="print">
                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/ApproveSocietyMappingRequest">{{ translation.Back}}</a>
                </div>
            </center>
        </div>
    </div>
</div>




