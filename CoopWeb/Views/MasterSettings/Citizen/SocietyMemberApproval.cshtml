                            <button type="submit" class="btn btn-primary dev-btn" ng-disabled="MyUserForm.$invalid" ng-click="SaveUser()">{{translation.Submit}}</button>
                            <button type="button" class="btn btn-primary dev-btn" ng-click="ClearUserApprovalForm()">{{translation.Clear}}</button>
                            <button type="button" class="btn btn-primary dev-btn" ng-click="SetBack()">{{translation.Back}}</button>
                            <input type="hidden" ng-model="UserRegistration.RequestId" id="hfRequestId" value="{{MemberDetailsList.RequestId}}" />
                        </div>
                    </div>
                </div>
                <div class="clearfix"> </div>



            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divGrid">

            <div class="citizen-dash-head">
                <table class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.ApplicantName}}
                            </th>
                            <th>
                                {{translation.SocietyName}}
                            </th>
                            <th>
                                {{translation.MobileNo}}
                            </th>
                            <th>
                                {{translation.ApplicationNo}}
                            </th>
                            <th>
                                {{translation.Date}}
                            </th>
                            <th>
                                {{translation.Status}}
                            </th>
                            <th>
                                {{translation.TakeAction}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="Item in SocietyMemberData | filter: q | orderBy:colsort:reverseSort  | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuPagination">

                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{ Item.Name | uppercase }}</td>
                            <td>{{ Item.SocietyName | uppercase }}</td>
                            <td>{{ Item.MobileNo }}</td>
                            <td>{{ Item.ApplicationNo  }}</td>
                            <td>{{ Item.InsertDate  }} </td>
                            <td ng-show="Item.ActionStatus==2">{{ translation.Pending  }}</td>
                            <td ng-show="Item.ActionStatus==0">{{ translation.Reject  }}</td>
                            <td ng-show="Item.ActionStatus==1">{{ translation.Approve  }}</td>
                            <td>
                                <i class="fa fa-eye" data-target="#myModal" data-toggle="modal" ng-click="ViewMemberApplication(Item.RequestIdEnc)"></i>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
        <div class="form-group col-md-12" ng-show="BackBtnLast">
            <center>
                <div class="print">
                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../Citizen/Index">{{ translation.Back}}</a>
                </div>
            </center>
        </div>
    </div>
</div>




