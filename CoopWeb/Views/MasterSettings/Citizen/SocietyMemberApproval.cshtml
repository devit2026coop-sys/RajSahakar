<script>
    function printpage() {
        var divToPrint = document.getElementById("printTable");
        newWin = window.print();
        newWin.document.write(divToPrint.outerHTML);
        newWin.print();
        newWin.close();
    }
</script>
<script src="~/Scripts/AngularFramework/SocietyMemberApproval.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script type="text/javascript">
    function OnSuccess(data) {
        $('#preloader').hide();
        if (data.UserType == 'C') {
            $('#FormPost').html(data.result);
            $('#FormPost').find('form').submit();
        }
        else {
            if (data.result == 'Sucess') {
                alert('Details Save Successful');
                window.location = "../Citizen/MemberApplicationView?ApplicationIdEnc=" + data.IdEnc;

            }
            else {
                ShowModelAlert("Society Member Registration", 'Issue in Payment Receiveing Please Try after Some time');
            }
        }
    }
    function OnFailure(data) {
        $('#preloader').hide();
        alert(JSON.stringify(data));
    }
    function OnBegin() {
        $('#preloader').show();
    }
</script>
