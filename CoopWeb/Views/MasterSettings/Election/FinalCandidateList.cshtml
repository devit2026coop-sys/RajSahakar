    <div class="dev-popup-body modal fade" data-backdrop="static" data-keyboard="false" id="deleteModal" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" ng-click="ClearOfficeForm()">&times;</button>
                </div>
                <div class="modal-body">
                    <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OfficeForm">
                        <div class="col-md-12">
                            <label>
                                Actions  @*{{translation.Action}}*@ :
                            </label>

                            <div style="width:100%">
                                <select id="ddrActionType" ng-model="AddNewMember.ActionType" class="form-control" ng-init="AddNewMember.ActionType='0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in NominationActions" value="{{item.LovValuesId}}">
                                        {{_language =='en-us' ?  item.LovCode : item.Lovdescription}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label>
                                PDF :
                            </label>
                            <input type="file" filetype="PDF" name="File" accept="application/pdf" class="form-control" id="MemberEditPDFForm1" ng-model="AddNewMember.ActionDocument">

                        </div>

                        <div class="col-md-12">
                            <label>
                                {{translation.Remarks}} :
                            </label>
                            <textarea class="form-control" id="MemberDeleteRemarks" ng-model="AddNewMember.ActionRemark" placeholder="{{translation.Remarks}}"></textarea>
                        </div>
                        <br />
                        <div class="col-md-12" style="margin-top: 10px;">
                            <div class="dev-menu-btn">
                                <button type="submit" class="btn btn-primary" ng-click="ModifyMember()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="ReSetAddModel()">{{translation.Clear}}</button>
                                <input type="hidden" ng-model="OfficeMaster.OfficeId" />
                            </div>
                            <i class="fa fa-angellist"></i>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="dev-popup-body modal fade" id="addElectionSymbolModal" data-backdrop="static" data-keyboard="false" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"> {{translation.ElectionSymbols}}</h4>
                </div>
                <div class="modal-body">
                    <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OfficeForm">
                        <input type="hidden" ng-model="AddNewSymbol.symbol_id" />
                        <div class="col-md-12" style="max-height:700px;overflow-y:auto;">
                            <table border="1" style="width:100%">
                                <tr><th></th><th></th><th>{{translation.SymbolName}}</th><th> {{translation.SymboleImage}}</th></tr>
                                <tr ng-repeat="item in ElectionSymbolsList" ng-if="item.IsShow">
                                    <td style="color:black">{{$index+1}}</td>
                                    <td><input type="checkbox" name="electionsymbol" ng-model="item.IsSelected" ng-change="ChangeSymbol($index)"/></td>
                                    <td style="color:black">
                                        {{item.symbol_name_en}}
                                        ({{item.symbol_name_hi}})
                                    </td>
                                    <td>
                                        <img src="/Content/ElectioSymbol/{{item.symbol_url}}" style="width:60px;" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-12" style="margin-top: 10px;">
                            <div class="dev-menu-btn">
                                <button type="submit" class="btn btn-primary" ng-click="AddSymbole()">{{translation.Submit}}</button> 
                                <input type="hidden" id="candidateIndex"/>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
