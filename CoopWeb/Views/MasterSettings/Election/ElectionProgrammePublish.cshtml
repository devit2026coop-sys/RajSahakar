@{
    ViewBag.Title = "Publish Election Programme By Election Officer for Society";
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}

<script src="~/Scripts/AngularFramework/ElectionProgramme.js"></script>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>

<script type="text/javascript">
    $("body").on("click", "#btnExport", function () {
        $("#PrintDiv").css("display", "block");
        html2canvas($('#tblCustomers')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500
                    }]
                };
                pdfMake.createPdf(docDefinition).download("CandidateList.pdf");
                $("#PrintDiv").css("display", "none");
            }
        });
    });
</script>
<style type="text/css">
    body {
        font-family: Arial;
        font-size: 10pt;
    }

    table {
        border: 1px solid #ccc;
        border-collapse: collapse;
    }

        table th {
            background-color: #F7F7F7;
            color: #333;
            font-weight: bold;
        }

        table th, table td {
            padding: 5px;
            border: 1px solid #ccc;
        }
</style>




<div ng-app="ElectionProgrammePublishMod" ng-controller="ElectionProgrammePublishCnt">

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head">{{translation.ElectionProgrammePublish}} </h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.ElectionProgrammePublish}} </span>
                </li>
            </ul>
        </div>
    </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="ShowDateDiv">
            <div class="table-responsive citizen-dash-head">
                <div class="table-responsive citizen-dash-head">
                    <p style="text-align:center;"><b>कार्यालय निर्वाचन अधिकारी</b></p>
                    <p style="text-align:center"><b>{{PublishData.SocietyName}}सहकारी समिति</b></p>
                    <p style="text-align:center"><b>निर्वाचन की सुचना का प्रारूप</b></p>
                    <p style="text-align:center"><b>नियम 45 (5) (iii)</b></p>
                    <p style="text-align:right"><b>दिनांक</b></p>

                    <p style='text-align:left;'>{{PublishData.SocietyName}} सहकारी समिति लिमिटेड की प्रबंधकारिणी के सदस्यों के निर्वाचन हेतु दिनांक {{PublishData.ElectionStartDate}} को प्रातः {{PublishData.ElectionStartTime}} बजे से सांय {{PublishData.ElectionEndDate}} बजे तक ………………………………… पर मतदान होगा। अतः समस्त सदस्य सूचित रहे।</p>

                    <p style='text-align:left;'>&nbsp;&nbsp;प्रस्तावित मतदाता सूची का प्रकाशन समिति के कार्यालय एवं सभी शाखाओ पर दिनांक {{PublishData.VoterListPublicationDate}} को कर दिया गया है।  यदि इस सूची में किसी सदस्य को कोई एतराज हो तो वह अपनी आपत्ति मय ठोस सबूत मुझे अथवा मेरे द्वारा अधिकृत व्यक्ति श्री  {{PublishData.ElectionOfficerName}} के समक्ष समिति के कार्यालय में दिनांक {{PublishData.ObjectionDate}} को दोपहर {{PublishData.ObjectionTime}} बजे तक प्रस्तुत कर सकते है। जिनकी सुनवाई उसी दिन की जाकर मतदाताओं की सूची का अंतिम प्रकाशन उसी दिन कर दिया जाएगा। </p>

                    <p style='text-align:left;'>&nbsp;&nbsp;सोसायटी के संचालक मंडल में 12 (बारह) निर्वाचित सदस्य होंगे। परन्तु कोई सहकारी सोसायटी जो व्यक्तिगत सदस्यों से मिलकर बनी हो और जिसमे अनुसूचित जाति या अनुसूचित जनजाति अथवा महिला वर्ग से सदस्य हो, एक स्थान अनुसूचित जातियों के लिए एक स्थान अनुसूचित जनजातियों के लिए और दो स्थान महिलाओ के लिए आरक्षित होंगे। </p>

                    <p style='text-align:left;'>&nbsp;&nbsp;चुनाव लड़ने वाले उम्मीदवार को राजस्थान सहकारी सोसाइटी अधिनियम 2001, राजस्थान सहकारी सोसाइटी नियम,2003 एवं सोसाइटी के पंजीकृत उपनियमो में उल्लेखित निर्योगिताओ से ग्रसित नहीं होना चाहिए।</p>
                    <p style='text-align:left;page-break-before:always;margin-top:20px;'><b>निर्वाचन कार्यक्रम :-</b></p>
                    <p style='text-align:left;'>1. नामनिर्देशन पत्र……………………… स्थान पर निर्वाचन अधिकारी को दिनांक {{PublishData.NominationDate}} को प्रातः {{PublishData.NominationStartTime}} बजे से {{PublishData.NominationEndTime}} बजे तक स्वयं उम्मीदवार अथवा उसके समर्थक अथवा उसके प्रस्तावक द्वारा निर्धारित प्रपत्र में दिया जायेगा। तत्पश्चात  प्राप्त नामनिर्देशन पत्रों की सूची का प्रकाशन {{PublishData.NominationEndTime}} बजे तक किया जाएगा। </p>

                    <p style='text-align:left;'>2. नामनिर्देशन पत्रों की सूक्ष्म परीक्षा उसी स्थान पर दिनांक {{PublishData.PublicationDate}} को {{PublishData.PublicationStartTime}} से {{PublishData.PublicationEndTime}} बजे की जाएगी। जिसमे उम्मीदवार या उसका प्रस्तावक अथवा समर्थक उपस्थित रह सकता है। तत्पश्चात वैध नाम निर्देशन पत्रों की सूची का प्रकाशन {{PublishData.PublicationEndTime}} बजे तक किया जाएगा।</p>

                    <p style='text-align:left;'>3. उम्मीदवारों के नाम वापसी लेने की सुचना निर्वाचन अधिकारी को {{PublishData.NominarionWithdrawDate}} {{PublishData.NominarionWithdrawTime}} बजे तक उसी दिनांक को स्वयं उम्मीदवार द्वारा उपस्थित होकर लिखित में दी जा सकेगी। उम्मीदवार द्वारा प्रस्तुत नाम वापसी का आवेदन पत्र अंतिम होगा, जिसे उम्मीदवार द्वारा वापस नहीं लिया जा सकेगा।</p>
                    <p style='text-align:left;'>4. यदि आवश्यक हुआ तो मतदान दिनांक {{PublishData.ReElectionDate}} को प्रातः {{PublishData.ReElectionStartTime}} बजे से  {{PublishData.ReElectionEndTime}} बजे तक ऊपर उल्लेखित स्थान/ स्थानों पर होगा तथा मतगणना दिनांक {{PublishData.VotingCountDate}} को {{PublishData.ReElectionEndTime}} बजे से निर्धारित स्थान पर होगी। निर्वाचन परिणाम की घोषणा मतगणना के पश्चात की जाएगी।</p>

                    <p style='text-align:left;'>5. सहकारी सोसाइटी के प्रबंधकारिणी के पदाधिकारियों का चुनाव दिनांक {{PublishData.OfficialElectionDate}} स्थान ……………………पर निर्वाचन अधिकारी द्वारा कराया जाएगा।</p>
                    <p style='text-align:right;'>निर्वाचन अधिकारी</p>
                    <p style='text-align:left'><b>प्रतिलिपि सूचनार्थ एवं आवश्यक कार्यवाही हेतु -</b></p>
                    <p style='text-align:left'>1. इकाई रिटर्निंग अधिकारी एवं उप / सहायक रजिस्ट्रार सहकारी समितियों ……………………………….</p>
                    <p style='text-align:left'>2. समिति नोटिस बोर्ड।</p>
                    <p style='text-align:left'>3. ग्राम पंचायत या आम स्थल पर चस्पा।</p>
                    <p style='text-align:left'>4. मुख्य कार्यकारी अधिकारी सम्बंधित सोसाइटी।</p>
                    <p style='text-align:right'>निर्वाचन अधिकारी</p>
                    <p>
                        <label id="lbltrn" hidden="hidden"></label>
                        <button id="btnautoclick" style="display:none" value="@ViewBag.ElectionMasterId">Click Me!</button>
                        <input type="button" class="btn btn-primary dev-btn" value="Publish" ng-click="Publish()" />
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-12 citizen-dash-head" id="ShowOTPDiv" style="display:none">


            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.EnterOTP}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="text" class="form-control" placeholder="{{translation.EnterOTP}}" ng-bind="OTP" ng-model="OTP" autocomplete="off" required onkeypress='return event.charCode >= 48 && event.charCode <= 57' min="6" maxlength="6">
                </div>

                <div class="col-lg-4">
                    <button type="button" class="btn btn-success ng-binding" ng-click="VerifyOTP()">&nbsp;&nbsp;{{translation.OtpVeryfication}}</button>
                </div>
                <div class="col-lg-2"><button type="button" class="btn btn-success ng-binding" ng-click="Publish()">&nbsp;&nbsp;{{translation.ReSendOTP}}</button></div>
            </div>

        </div>

    </div>



