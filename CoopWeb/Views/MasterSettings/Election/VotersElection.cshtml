                            <input type="file" filetype="PDF" dat-val="Delete" name="File" accept="application/pdf" class="form-control validateAddMember" id="addDeleteMember" ng-model="AddNewMember.DeleteDocument">
                        </div>
                        <div class="col-md-12 addNewIsDelete" style="display:none;">
                            <label>
                                {{translation.Delete}} {{translation.Remarks}}
                            </label>
                            <textarea class="form-control validateAddMember" id="AddNewMemberDeleteRemarks" ng-model="AddNewMember.DeleteRemarks" placeholder="{{translation.Remarks}}"></textarea>
                        </div>

                        <div class="col-md-12" style="margin-top: 10px;">
                            <div class="dev-menu-btn">
                                <button type="submit" class="btn btn-primary" ng-click="AddNewMemberRow()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="ReSetAddModel()">{{translation.Clear}}</button>
                                <input type="hidden" ng-model="OfficeMaster.OfficeId" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


</div>

