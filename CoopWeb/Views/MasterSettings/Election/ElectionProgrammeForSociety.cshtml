

<script src="~/Scripts/AngularFramework/ElectionProgramme.js"></script>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
<script type="text/javascript">
    $("body").on("click", "#btnExport", function () {
        $("#PrintDiv").css("display", "block");
        html2canvas($('#tblCustomers')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500
                    }]
                };
                pdfMake.createPdf(docDefinition).download("CandidateList.pdf");
                $("#PrintDiv").css("display", "none");
            }
        });
    });
</script>
<style type="text/css">
    body {
        font-family: Arial;
        font-size: 10pt;
    }

    table {
        border: 1px solid #ccc;
        border-collapse: collapse;
    }

        table th {
            background-color: #F7F7F7;
            color: #333;
            font-weight: bold;
        }

        table th, table td {
            padding: 5px;
            border: 1px solid #ccc;
        }
</style>




<div ng-app="ElectionProgrammeMod" ng-controller="ElectionProgrammeCnt">

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head">{{translation.ElectionProgrammeSociety}} </h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.ElectionProgrammeSociety}} </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="table-responsive citizen-dash-head">
            <table id="example" class="table devtable" style="margin-top: 30px;border:1px solid rgb(222, 221, 221); float: left;">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                       
                        <th>
                            {{translation.SocietyName}}
                        </th>
                        <th>
                            {{translation.Election}} {{translation.ViewOrder}}
                        </th>
                        <th>
                            {{translation.ElectionOfficer}}  {{translation.ViewOrder}}
                        </th>
                        
                        <th>
                            {{translation.Publish}}
                        </th>
                        <th>
                            {{translation.View}}
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <tr dir-paginate="item in ElectionOfficerData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: 1000">

                        <td>{{$index+1}}</td>
                        <td>{{item.SocietyName}}</td>
                        <td><a style="color:#505050;" ng-hide="{{item.ElectionOrderPDF==''}}" target="_blank" href="../Content/ElectionOrder/Hin{{ item.ElectionOrderPDF }}"><i class="fa fa-download"></i></a></td>
                        <td><a style="color:#505050;" ng-hide="{{item.ElectionOrderEOPDF==''}}" target="_blank" href="../Content/ElectionOrder/Hin{{ item.ElectionOrderEOPDF }}"><i class="fa fa-download"></i></a></td>
                        <td class="add-more-td">
                            <a ng-show="{{item.ElectionOrderFile==''}}" title="{{translation.ShowDetails}}" href="/Election/ElectionProgrammePublish?Id={{item.Id}}">Publish</a>
                        </td>
                        <td class="add-more-td">
                            <a target="_blank" ng-hide="{{item.ElectionOrderFile==''}}" title="{{translation.ShowDetails}}" href="../Content/ElectionOrder/{{item.ElectionOrderFile}}">View</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>



