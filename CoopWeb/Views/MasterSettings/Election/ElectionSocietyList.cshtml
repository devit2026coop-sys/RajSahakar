                        <button type="button" class="btn btn-primary dev-btn" ng-show="ShowDisDiv" ng-click="SaveElectionMaster();" style="float:right">NEXT</button>
                    </div>
                </div>

            </div>
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="javascript:void(0);" ng-click="FunShowGrid(false)">{{ translation.Back}}</a>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="citizen-dash-head" ng-hide="ShowSavedData">
                <table class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.TotalSociety}}
                            </th>
                            <th>
                                {{translation.Election}}
                                {{translation.StartDate}}
                            </th>
                            <th>
                                {{translation.OrderDate}}
                            </th>
                            <th>
                                {{translation.SocietyName}}
                            </th>

                            <th>
                                {{translation.OrderOfficer}}
                            </th>
                            <th>
                                {{translation.Election}} {{translation.ViewOrder}}
                            </th>
                            <th>
                                {{translation.Actions}}
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="Class in ElectionOrderData | filter:q |  itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubPagination">
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{Class.NoOfSociety}}</td>
                            <td>{{Class.StartDate}}</td>
                            <td>{{ Class.OrderDate }}</td>
                            <td>{{ Class.SocietiesName }}</td>
                            <td>{{ Class.ReturningOfficer }}</td>
                            <td><a style="color:#505050;" ng-hide="{{Class.ElectionOrderPDF==''}}" target="_blank" href="../Content/ElectionOrder/{{ Class.ElectionOrderPDF }}"><i class="fa fa-download"></i></a></td>
                            <td>
                                <button type="button" ng-if="Class.ElectionOrderPDF==''" class="btn btn-primary dev-btn" ng-click="RedirectTopublishOrImpoDate(Class.Id)" style="float:right">Procced</button>           @*ng-show="{{Class.NoOfSociety>Class.NoOfElecOffi?true:true}}"*@
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="col-md-10">
                    <div class="text-center">
                        <dir-pagination-controls boundary-links="true" pagination-id="SubPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
                <div class="col-md-2">
                    <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                </div>

            </div>
        </div>
        <div class="se-pre-con"></div>
    </div>

</div>

