<script>
    var myVar;
    $(document).ready(function () {
        $('#select-all').click(function (event) {
            if (this.checked) {
                // Iterate each checkbox
                $('.chk').each(function () {
                    this.checked = true;
                });
            } else {
                $('.chk').each(function () {
                    this.checked = false;
                });
            }
        });
        myVar = setInterval("SetOfficerData()", 4000);
    });
    var totalSeen = $("input#chk:checked").length;
    function SetOfficerData() {
        $('#tblPublish tr').each(function () {
            var OffiId = $(this).find('td:eq(3)').find('input').val();
            $(this).find('td:eq(3)').find('select').val(OffiId);
            if (OffiId != "0") {
                $(this).find('td:eq(3)').find('select').prop("disabled", "disabled");
            }
            var StepId = $(this).find('td:eq(2)').find('input').val();
            $(this).find('td:eq(2)').find('select').val(StepId);
            if (StepId != "0") {
                $(this).find('td:eq(2)').find('select').prop("disabled", "disabled");
            }
        });
        $("#divPrint").hide();
        clearInterval(myVar);
    }
    function ChekOfficerStep(SocId) {
        // alert(SocId.id);  // "ddlStep ddlOffi"
        var SocIdAll = SocId.id;
        var DDLOffiId;
        var DDLStepId;
        if (SocIdAll.indexOf("ddlStep") > -1)
        {
            DDLStepId = SocIdAll;
            DDLOffiId = SocIdAll.replace("ddlStep", "ddlOffi");
        }
        else {
            DDLOffiId = SocIdAll;
            DDLStepId = SocIdAll.replace("ddlOffi", "ddlStep");
        }
        var DDLOffiVal = $('#' + DDLOffiId).val();
        var DDLStepVal = $('#' + DDLStepId).val();
        var flag = 0;
        $('#tblPublish tr').each(function () {
            var DDLStepVal1=$(this).find('td:eq(2)').find('select').val();
            var DDLOffiVal1 = $(this).find('td:eq(3)').find('select').val();
            if (DDLStepVal1 == DDLStepVal && DDLOffiVal1 == DDLOffiVal)
            {
                flag = flag + 1;
            }
        });
        if (flag > 1)
        {
            alert("You can't select a officer in same step.");
            $(SocId).val("0");
        }
        else {
            return true;
        }
    }
</script>

