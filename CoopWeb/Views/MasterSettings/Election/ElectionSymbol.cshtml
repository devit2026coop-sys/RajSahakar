<script type="text/javascript">
    $("body").on("click", "#btnExport", function () {
        $("#PrintDiv").css("display", "block");
        html2canvas($('#tblCustomers')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500
                    }]
                };
                pdfMake.createPdf(docDefinition).download("CandidateList.pdf");
                $("#PrintDiv").css("display", "none");
            }
        });
    });
    $("body").on("click", "#btnExportSelected", function () {
        $("#PrintDiv1").css("display", "block");
        html2canvas($('#tblCustomers1')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500
                    }]
                };
                pdfMake.createPdf(docDefinition).download("CandidateList.pdf");
                $("#PrintDiv1").css("display", "none");
            }
        });
    });



</script>
