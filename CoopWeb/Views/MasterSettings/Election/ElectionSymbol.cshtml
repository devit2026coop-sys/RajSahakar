<script type="text/javascript">
    function RemoveRowAdminiAct2001(Control, row) {
        if (confirm("Are you sure to remove this file?")) {
            var id = $(Control).attr('id').replace("Remove_", '');
            var File = $(Control).parents('#myTable2 tr').find('[Id^="File_' + id + '"]');
            for (var temRowNo = 0; temRowNo < ImageDataList.length; temRowNo++) {
                if (ImageDataList[temRowNo].RowNo == row) {
                    ImageDataList.splice(temRowNo);
                }
            }
            for (var temRowNo1 = 0; temRowNo1 < PDFDataList.length; temRowNo1++) {
                if (PDFDataList[temRowNo1].RowNo == row) {
                    PDFDataList.splice(temRowNo1);
                }
            }
            $(Control).closest('tr').remove();
            $("#Remove_" + (row - 1)).show();
        }
    };

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };
    $(document).ready(function () {
        $('.SearchDate').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            //maxDate: '0D',
            //defaultDate: (new Date()).getDate() + '/' + ((new Date()).getMonth()) + '/' + ((new Date()).getFullYear() - 18).toString(),
            //yearRange: "-100:-18"
        });
    });
    function previewFile(ths) {
        var preview = document.querySelector('imgPreview');
        var file = ths.files[0];
        var reader = new FileReader();

        reader.onloadend = function () {
            $("#imgPreview").attr("src", reader.result);
            $("#imgPreview").show();
            //alert(1);
        }

        if (file) {
            reader.readAsDataURL(file);
        } else {
            newMemberPhoto = "";
        }
    }

</script>

