<script src="~/Scripts/AngularFramework/KPIMaster.js"></script>
<style>

    .kpi-form .form-group {
        margin-bottom: 20px;
    }

    .kpi-form label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .kpi-form .form-control {
        width: 100%;
        height: 38px;
    }

    .kpi-form .kpi-buttons {
        margin-top: 5px;
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .kpi-form .kpi-buttons .btn {
            min-width: 90px;
            padding: 8px 18px;
        }
</style>
<div ng-app="KPIMasterMod" ng-controller="KPIMasterCtrl" ng-cloak>
    <div class="col-md-12">
        <h3 class="citizen-dash-head">{{translation.KPIMaster}}</h3>
        <hr style="margin: 0;">
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.MasterSetting}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.New}} </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> {{translation.KPIMaster}} </span>
                </li>
                <li style="float: right;">
                    <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal"> <h5>&#187; {{translation.KPIMaster}}</h5> </button>
                </li>

            </ul>
        </div>
    </div>

    <div class="dev-popup-body modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" ng-click="ClearDesignationLevelMappingForm()">&times;</button>
                    <h4 class="modal-title"> {{translation.KPIMaster}} </h4>
                </div>

                <div class="modal-body">
                    <form class="dev-search-form kpi-form"
                          style="margin-bottom: 10px;"
                          ng-submit="$event.preventDefault()">

                        <div class="row">
                            <div class="col-md-12 form-group">
                                <label>KPI Name :</label>
                                <input type="text"
                                       ng-model="search.KPIRequireFor"
                                       class="form-control"
                                       placeholder="Enter KPI Name" />
                            </div>

                            <div class="col-md-12 form-group">
                                <label>Validate Entry Date :</label>
                                <select class="form-control"
                                        ng-model="search.ValidateEntryDate">
                                    <option value="" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in ValidateDateList track by $index"
                                            value="{{item.Id}}">
                                        {{item.text}}
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-12 form-group">
                                <label>Validate Entry Time :</label>
                                <select class="form-control"
                                        ng-model="search.ValidateEntryTime">
                                    <option value="" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in ValidateTimeList track by $index"
                                            value="{{item.Id}}">
                                        {{item.text}}
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-12 kpi-buttons">
                                <button type="button"
                                        class="btn btn-primary"
                                        ng-click="SaveKPIMasterData()">
                                    {{translation.Submit}}
                                </button>

                                <button type="button"
                                        class="btn btn-default"
                                        ng-click="ClearKPIData()">
                                    {{translation.Clear}}
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="">
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-xs-4">
                        <label for="search">{{translation.Search}}:</label>
                        <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                    </div>
                    <div class="col-xs-4">
                        <label for="search">{{translation.ItemPerPage}}:</label>
                        <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                    </div>
                </div>
                <table class="table table-responsive devtable">
                    <tr>
                        <td>Sr No.</td>
                        <td>KPI Name</td>
                        <td>Validate Entry Date</td>
                        <td>Validate Entry Time</td>
                        <td>Is Status</td>
                        <td>Take Action</td>
                    </tr>

                    <tr ng-repeat="item in KPIDetailsList track by $index">
                        <td>{{$index + 1}}</td>
                        <td>{{item.KPIName}}</td>
                        <td>
                            <span ng-if="!item.IsEdit">
                                {{item.ValidateEntryDate}}
                            </span>
                            <select ng-if="item.IsEdit" class="form-control" ng-model="item.ValidateEntryDate">
                                <option value="" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="date in ValidateDateList track by $index" value="{{date.Id}}">
                                    {{date.text}}
                                </option>
                            </select>
                        </td>
                        <td>
                            <span ng-if="!item.IsEdit">
                                {{item.ValidateEntryTime}}:00
                            </span>
                            <select ng-if="item.IsEdit" class="form-control" ng-model="item.ValidateEntryTime">
                                <option value="" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="time in ValidateTimeList track by $index" value="{{time.Id}}">
                                    {{time.text}}
                                </option>
                            </select>
                        </td>
                        <td>{{item.Status}}</td>
                        <td>
                            <button type="button" class="btn btn-primary" ng-if="!item.IsEdit" ng-click="EditKPI(item)" title="Edit">
                                <i class="fa fa-edit"></i> Edit
                            </button>

                            <button type="button" class="btn btn-primary" ng-if="item.IsEdit" ng-click="UpdateKPI(item)" title="Update">
                                <i class="fa fa-save"></i> Update
                            </button>

                            <button type="button" class="btn btn-danger" ng-if="item.IsEdit" ng-click="CancelEditKPI(item)" title="Cancel">
                                <i class="fa fa-times"></i> Cancel
                            </button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="se-pre-con"></div>
<div id="stop" class="scrollTop">
    <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
</div>

