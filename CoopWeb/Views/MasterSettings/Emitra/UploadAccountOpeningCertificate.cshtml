
@{
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}

<script src="~/Scripts/AngularFramework/Emitra.js?1111"></script>

<div ng-app="EmitraModule">
    <div ng-controller="EmitraCont">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">{{translation.SocietyPayment}}</h3>
        </div>        
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">                        
                        <span style="margin: 0 5px;">{{translation.SocietyPayment}} </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="form-group col-md-6" hidden>
            <input type="text" class="form-control" ng-model="SocietyRegistration.txn">
        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-lg-12 form-group">
                        <div class="col-lg-2">
                            <label style="color:black">{{translation.SocietyRegistrationNo}} :</label>
                        </div>
                        <div class="col-lg-4">
                            <input type="text" name="SocietyName" class="form-control" ng-model="SocietyRegistration.SocietyRegistrationNo" placeholder="{{translation.SocietyRegistrationNo}}" autocomplete="off">
                        </div>
                        <div>

                        </div>
                        <button type="submit" class="btn btn-primary dev-btn" ng-click="GetfSocietyForBankCUpload()" ng-disabled="SocietyRegistration.SocietyRegistrationNo==undefined || SocietyRegistration.SocietyRegistrationNo==''">{{translation.GetSocieties}}</button>
                    </div>
                </div>
                <table class="table table-responsive devtable" ng-show="Showgride">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th>
                                {{translation.SocietyName}}

                            </th>
                            <th>
                                {{translation.Act}}
                            </th>
                            <th>
                                {{translation.SocietyRegistrationNo}}

                            </th>
                            <th>
                                {{translation.SocietyTyped}}
                            </th>
                            <th>
                                {{translation.PaymentStatus}}
                            </th>
                            <th>
                                {{translation.payableamount}}
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="items in SocietyRegdata | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="statePagination">
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{ items.SocietyName }}</td>
                            <td>{{ items.ActNameEn }}</td>
                            <td>{{ items.RegistrationNo }}</td>
                            <td>{{ items.TypeameEng }}</td>
                            <td>{{ items.ProceesStatusTextEn }}</td>
                            <td>{{ items.Amount }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <div class="col-lg-12 form-group">
                <div class="col-md-12" ng-show="recordstblshow">
                    <div class="citizen-dash-head">
                        <table class="table devtable">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.Enclouserupload}}
                                    </th>
                                    <th>
                                        Upload Copy of Bank Passbook
                                    </th>
                                    <th>
                                        {{translation.OpeningBalance}}
                                    </th>
                                    <th>
                                        {{translation.Enclouserupload}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                       {{translation.EnclouserName}}
                                    </td>
                                    <td>
                                       <input type="file" filetype='pdf' name="File" id="flUploadEnclouserFile" class="form-control" ng-model="EnclouserDetails.Enclouserupload" onchange="angular.element(this).scope().UploadEnclouserFile(this.files, this)" DDLID="{{x.DDLID}}">
                                    </td>
                                    <td>
                                        <input type="text" id="txtOpeningBalance" name="OpeningBalance" class="form-control" ng-model="BankStatement.OpeningBalance" placeholder="{{translation.OpeningBalance}}" onkeypress='return event.charCode >= 48 && event.charCode <= 57' autocomplete="off">
                                    </td>
                                    <td>
                                        <button type="submit" id="abc" style="float:left" class="btn btn-primary dev-btn" ng-click="SaveBankDetails();">{{translation.Payment}}/{{translation.SUBMITTED}}</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
        <div>
            <div class="col-lg-12 form-group">
                <div class="col-md-12" ng-show="DivResponce" id="Responce">

                </div>

            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
</div>
