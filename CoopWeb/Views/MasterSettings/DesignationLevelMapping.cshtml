<script src="~/Scripts/AngularFramework/DesignationLevelMapping.js"></script>

<div ng-app="DesignationLevelMappingMastersModule">
    <div ng-controller="DesignationLevelMappingMasterCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.DesignationLevelMapping}}</h3>
            <hr style="margin: 0;">
        </div>
       
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.MasterSetting}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> {{translation.DesignationLevelMapping}} </span>
                    </li>
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal" ng-click="ClearDesignationLevelMappingForm()"> <h5>&#187; {{translation.DesignationLevelMapping}}</h5> </button>
                    </li>
                  
                </ul>
            </div>
        </div>

        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearDesignationLevelMappingForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.DesignationLevelMapping}} </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="DesignationLevelMappingForm">
                            <div class="col-md-6">
                                <label>
                                    {{translation.DepartmentHeading}} :
                                </label>

                                <select ng-model="DesignationLevelMappingMaster.DepartmentId" class="form-control" ng-init="DesignationLevelMappingMaster.DepartmentId='0'" ng-change="GetOrganisations()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Departments" value="{{item.ID}}">
                                        {{_language =='en-us' ?  item.DEPTNAMEENGLISH : item.DEPTNAMEHINDI}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    {{translation.Organisation}} :
                                </label>
                                <select ng-model="DesignationLevelMappingMaster.OrganisationId" class="form-control" ng-init="DesignationLevelMappingMaster.OrganisationId='0'" ng-change="GetLevels()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Organisations" value="{{item.OrganisationId}}">
                                        {{_language =='en-us' ?  item.OrganisationNameEn : item.OrganisationNameHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    {{translation.Level}} :
                                </label>
                                <select ng-model="DesignationLevelMappingMaster.OrganizationLevelsMappingID" class="form-control" ng-init="DesignationLevelMappingMaster.OrganizationLevelsMappingID='0'" ng-change="OfficeList()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Levels" value="{{item.MappingID}}">
                                        {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    {{translation.Office}} :
                                </label>
                                <select ng-model="DesignationLevelMappingMaster.OfficeId" class="form-control" ng-init="DesignationLevelMappingMaster.OfficeId='0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in OfficeListData" value="{{item.OfficeId}}">
                                        {{_language =='en-us' ?  item.OfficeNameEn : item.OfficeNameHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    {{translation.Designation}} :
                                </label>
                                <select ng-model="DesignationLevelMappingMaster.DESIGNATIONCODE" class="form-control" ng-init="DesignationLevelMappingMaster.DESIGNATIONCODE='0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Designations" value="{{item.DESIGNATIONCODE}}">
                                        {{_language =='en-us' ?  item.DESIGNATIONDESCENGLISH : item.DESIGNATIONDESCHINDI}}
                                    </option>
                                </select>
                            </div>
                            <div class="form-group col-md-3">
                                <div class="form-check form-check-inline col-md-9" style="padding: 0;margin-top:10px">
                                    <label class="check-box" for="inlineRadio1"> {{translation.IsActive}} </label>
                                </div>
                                <div class="check-item col-md-3" style="padding: 0;margin-top:10px">

                                    <input class="form-check-input ng-pristine ng-untouched ng-valid ng-not-empty" type="checkbox" id="inlineCheckbox1" ng-true-value="true" ng-false-value="false" ng-model="DesignationLevelMappingMaster.IsActive" ng-checked="DesignationLevelMappingMaster.IsActive">
                                </div>
                            </div>
                            <div class="form-group col-md-3">
                                <div class="form-check form-check-inline col-md-9" style="padding: 0;margin-top:10px">
                                    <label class="check-box" for="inlineRadio1"> {{translation.IsHOD}}? </label>
                                </div>
                                <div class="check-item col-md-3" style="padding: 0;margin-top:10px">

                                    <input class="form-check-input ng-pristine ng-untouched ng-valid ng-not-empty" type="checkbox" id="inlineCheckbox1" ng-true-value="true" ng-false-value="false" ng-model="DesignationLevelMappingMaster.IsHOD" ng-checked="DesignationLevelMappingMaster.IsHOD">
                                </div>
                            </div>
                            <div class="col-md-6">

                                <button type="submit" class="btn btn-primary" ng-disabled="DesignationLevelMappingForm.$invalid" ng-click="SaveDesignationLevelMappingForm()">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="ClearDesignationLevelMappingForm()">{{translation.Clear}}</button>
                                <input type="hidden" ng-model="DesignationLevelMappingMaster.DesignationLevelMappingId" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>





        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                        <div class="col-md-4">
                            <label>
                                {{translation.DepartmentHeading}} :
                            </label>

                            <select ng-model="DesignationLevelMappingMaster.DepartmentId" class="form-control" ng-init="DesignationLevelMappingMaster.DepartmentId='0'" ng-change="GetAllDesignationLevelMappingListByDept();GetOrganisations()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Departments" value="{{item.ID}}">
                                    {{_language =='en-us' ?  item.DEPTNAMEENGLISH : item.DEPTNAMEHINDI}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>
                                {{translation.Organisation}} :
                            </label>
                            <select ng-model="DesignationLevelMappingMaster.OrganisationId" class="form-control" ng-init="DesignationLevelMappingMaster.OrganisationId='0'" ng-change="GetAllDesignationLevelMappingListByOrg();GetLevels()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Organisations" value="{{item.OrganisationId}}">
                                    {{_language =='en-us' ?  item.OrganisationNameEn : item.OrganisationNameHi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>
                                {{translation.Level}} :
                            </label>
                            <select ng-model="DesignationLevelMappingMaster.OrganizationLevelsMappingID" class="form-control" ng-init="DesignationLevelMappingMaster.OrganizationLevelsMappingID='0'" ng-change="GetAllDesignationLevelMappingListBylbl()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Levels" value="{{item.MappingID}}">
                                    {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>
                                {{translation.Designation}} :
                            </label>
                            <select ng-model="DesignationLevelMappingMaster.DESIGNATIONCODE" class="form-control" ng-init="DesignationLevelMappingMaster.DESIGNATIONCODE='0'" ng-change="GetAllDesignationLevelMappingListByDesig()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Designations" value="{{item.DESIGNATIONCODE}}">
                                    {{_language =='en-us' ?  item.DESIGNATIONDESCENGLISH : item.DESIGNATIONDESCHINDI}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'DESIGNATIONDESCENGLISH' : 'DESIGNATIONDESCHINDI')">
                                    {{translation.Designation}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'DESIGNATIONDESCENGLISH' : 'DESIGNATIONDESCHINDI')"></div>
                                </th>

                                <th ng-click="sortData(_language =='en-us' ? 'DEPTNAMEENGLISH' : 'DEPTNAMEHINDI')">
                                    {{translation.DepartmentHeading}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'DEPTNAMEENGLISH' : 'DEPTNAMEHINDI')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'OrganisationNameEn' : 'OrganisationNameHi')">
                                    {{translation.Organisation}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'OrganisationNameEn' : 'OrganisationNameHi')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'LevelNameEn' : 'LevelNameHi')">
                                    {{translation.Level}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'LevelNameEn' : 'LevelNameHi')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'OfficeNameEn' : 'OfficeNameHi')">
                                    {{translation.Office}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'OfficeNameEn' : 'OfficeNameHi')"></div>
                                </th>
                                <th>
                                    {{translation.IsHOD}}
                                </th>
                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                                <th>
                                    {{translation.Delete}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="Class in DesignationLevelMappingData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="DesignationLevelMappingPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{_language =='en-us' ?  Class.DESIGNATIONDESCENGLISH : Class.DESIGNATIONDESCHINDI}}</td>
                                <td>{{_language =='en-us' ?  Class.DEPTNAMEENGLISH : Class.DEPTNAMEHINDI}}</td>
                                <td>{{_language =='en-us' ?  Class.OrganisationNameEn : Class.OrganisationNameHi}}</td>
                                <td>{{_language =='en-us' ?  Class.LevelNameEn : Class.LevelNameHi}}</td>
                                <td>{{_language =='en-us' ?  Class.OfficeNameEn : Class.OfficeNameHi}}</td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Class.IsHOD == 1" disabled="disabled">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Class.IsActive == 1" ng-click="SetStatus(Class.DesignationLevelMappingId,Class.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Class)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(Class.DesignationLevelMappingId,2)"></i>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="DesignationLevelMappingPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">

                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                </div>
            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>

