                            </div>

                            <div class="col-lg-2">
                                <label>{{_language == 'en-us' ? 'Complain Date':'शिकायत की तारीख'}}</label>
                            </div>
                            <div class="col-lg-4">

                                <input name="ComplaintDate" type="text" id="ComplaintDate6" ng-disabled="true" dat-val="1" class="form-control devcalender" placeholder="dd/MM/yyyy" ng-model="ComplainUnderSection.ComplainDate" autocomplete="off" onKeyPress="return isNumber(event);" size=10 maxlength=10 />
                            </div>

                            <div class="col-lg-2" ng-if="ComplainUnderSection.StatusId==3 || ComplainUnderSection.StatusId==6">
                                <label>{{translation.Status}}</label>
                            </div>

                            <div class="col-lg-4">
                                <select name="StatusId" id="CaseStatusId" ng-if="ComplainUnderSection.StatusId==3 || ComplainUnderSection.StatusId==6" ng-model="ComplainUnderSection.Status" class="form-control" ng-init="ComplainUnderSection.Status=''" ng-change="StatusDetail()">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="itm in ComplainStatusList" value="{{itm.Id}}">
                                        {{_language =='en-us' ?  itm.StatusName : itm.StatusNameHi}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12" style="margin-top: 20px;">
                            <div class="dev-menu-btn">
                                <button type="submit" class="btn btn-primary" ng-click="ResetAddNew()">{{translation.Back}}</button>
                            </div>
                        </div>
                    </form>


                </div>

            </div>


            <div class="dev-popup-body modal fade" id="mdlTrailList" data-backdrop="static" data-keyboard="false" role="dialog">
                <div class="modal-dialog" style="width: 50%;">
                    <!-- Modal content-->
                    <div class="modal-content" style="width: 825px!important;">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                            <h4 class="modal-titmemberle" style="color:black; text-align:center"> सोसाइटी के खिलाफ शिकायत </h4>
                        </div>
                        <div class="modal-body">
                            <div class="table-responsive">
                                <table id="tblData" class="table table-responsive devtable" style="color:black">
                                    <thead>
                                        <tr>
                                            <th>
                                                {{translation.SRNO}}
                                            </th>


                                            <th>Procees Status</th>
                                            <th>Remarks</th>
                                            <th>Investigating Officer</th>
                                            <th>
                                                File
                                            </th>
                                            <th>Letter</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in ComplainTrailList">
                                            <td style="display:none"><input type="hidden" value="{{item.SocietyID}}" id="SocietyID" ng-model="SocietyID" /></td>
                                            <td>{{$index+1}}</td>
                                            <td>
                                                {{_language =='en-us' ?  item.StatusName : item.StatusNameHi }}
                                            </td>
                                            <td>{{item.Remark}}</td>
                                            <td>{{_language =='en-us' ?  item.OfficerNameEn : item.OfficerNameHi}}</td>
                                            <td style="text-align:center;">
                                                <a style="color:#505050;" ng-if="item.FName!=''&&item.ComplaintStatusId!=3" target="_blank" href="../Content/CCSComplaintFiles/{{item.FName}}"><i class="fa fa-download"></i></a>
                                                <a ng-repeat="itm in item.drFiles" style="margin-left:5px; color:#505050;" ng-if="itm!=''&&item.ComplaintStatusId==3" target="_blank" href="../Content/CCSComplaintFiles/{{itm}}"><i class="fa fa-download"></i></a>

                                            </td>
                                            <td style="text-align:center;"><a style="color:#505050;" ng-if="item.Letter!=''" target="_blank" href="../Content/CCSComplaintFiles/{{item.Letter}}"><i class="fa fa-download"></i></a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
</div>

