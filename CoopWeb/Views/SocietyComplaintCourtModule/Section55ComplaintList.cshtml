<div ng-app="ComplaintListModuleMod">
    <div ng-controller="ComplaintListModuleCnt">

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="citizen-dash-head">Section55 Complaint List  </h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="../Citizen/Index"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        Section55 Complaint List
                    </li>
               
                </ul>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="citizen-dash-head">

                <div class="table-dropdown" id="search-filter">
                    <div class="col-lg-4" style="padding-left: 0;">
                        <label for="search">{{translation.Search}}:</label>
                        <input name="searchText" id="searchText" class="form-control" placeholder="{{translation.filttertext}}" autocomplete="off">
                    </div>

                    <div class="col-lg-4">
                        <label>
                            {{translation.Status}}
                        </label>
                        <select name="StatusId" id="CaseStatusId" class="form-control" ng-init="IODetail.UserId=''">
                            <option value="">{{translation.SelectOption}}</option>
                            <option ng-repeat="itm in FilterComplainStatus" value="{{itm.Id}}">
                                {{_language =='en-us' ?  itm.StatusName : itm.StatusNameHi}}
                            </option>
                        </select>



                    </div>
                    <div class="col-lg-4">
                        <label>&nbsp;</label><br>
                        <button type="button" ng-click="searchRequest(GetSocietyComplaintList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                        <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                    </div>
                </div>

            </div>
            </div>

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="tablediv">
                <div class="citizen-dash-head">
                    <table class="table devtable" id="Section551">
                        <thead>
                            <tr>
                                <th> {{translation.SRNO}}  </th>

                                <th>{{translation.RegistrationNo}}</th>
                                <th style="text-align:left">{{translation.SocietyName}}</th>
                                <th style="text-align:left">{{translation.Address}}</th>
                                <th>{{translation.InvestigationofficerName}}</th>
                                <th>Procees Status</th>
                                <th>Complaint Letter</th>
                                <th>View Complaint Details</th>
                                <th>Report Submited By IO</th>
                                <th>{{translation.TransactionLog}}</th>


                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in SocietyComplaintList">
                                <td>{{$index+1}}</td>
                                <td>{{item.RegistrationNo}}</td>
                                <td>{{item.SocietyName}}</td>
                                <td>{{item.AddressEn}}</td>



                                <td>{{_language =='en-us' ?  item.OfficerNameEn : item.OfficerNameHi}}</td>
                                <td>
                                    {{_language =='en-us' ?  item.StatusName : item.StatusNameHi }}


                                <td style="text-align:center;"><a style="color:#505050;" ng-if="item.ComplainLetter!=''" target="_blank" href="../Content/CCSComplaintFiles/{{item.ComplainLetter}}"><i class="fa fa-download"></i></a></td>

                                <td style="text-align:center;"> <a title="Add" ng-click="GetComplainDetails(item.ComplainID)"><i class="fa fa-eye"></i></a></td>


                                <td style="text-align:center;">

                                    <a ng-repeat="itm in item.drFiles" style="margin-left:2px; color:#505050;" ng-if="item.IOReport!='' && itm!=''" target="_blank" href="../Content/CCSComplaintFiles/{{itm}}"><i class="fa fa-download"></i></a>

                                </td>


                                <td><a title="Add" ng-click="GetComplainTrail(item.ComplainID)"><i class="fa fa-list-ul"></i></a></td>


                            </tr>
                            <tr>
                                <td colspan="7">
                                    <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                        <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                            Total Records: {{DataPagingDetails.TotalRecords}}
                                        </div>
                                        <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetSocietyComplaintList)" style="cursor: pointer;">
                                                <span>«First</span>
                                            </li>
                                            <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetSocietyComplaintList)" style="cursor:pointer;">
                                                <span>« Previous</span>
                                            </li>
                                            <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetSocietyComplaintList)"><span>{{n}}</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                            <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetSocietyComplaintList)" style="cursor:pointer;">
                                                <span>Next »</span>
                                            </li>
                                            <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetSocietyComplaintList)" style="cursor:pointer;">
                                                <span>Last »</span>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>



