<script src="~/Scripts/AngularFramework/NIActDetails.js?v=1.3"></script>
@{
    ViewBag.Title = "NI ACT Details";
}
<style>
    label {
        display: inline-block;
        width: 100% !important;
        margin-bottom: 5px;
        font-weight: 700;
        font-weight: normal
    }

    .zoom {
        transition: transform .2s; /* Animation */
        margin: 0 auto;
    }

        .zoom:hover {
            padding-left: 30px;
            transform: scale(2.5); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }

    a > i.fa.fa-plus-circle {
        font-size: 25px;
        cursor: pointer;
    }

    a:hover > i.fa.fa-plus-circle {
        font-size: 26px;
        cursor: pointer;
    }

    a > i.fa.fa-eye {
        font-size: 25px;
        cursor: pointer;
    }

    a:hover > i.fa.fa-eye {
        font-size: 26px;
        cursor: pointer;
    }


    .dvfieldset {
        border: 1px solid #b0adad;
        border-radius: 5px;
        padding-bottom: 10px;
        margin-bottom: 20px;
        background: #fff;
        color: #444;
    }

    .dvlegend {
        width: auto;
        padding: 24px;
        margin-left: 11px;
        border: 1px solid gray;
        padding: 5px;
        border-radius: 14px;
        font-size: 16px;
        padding-left: 14px;
        padding-right: 15px;
        background: #025e63;
        color: #fff;
    }

    .modal-dialog {
        color: #444;
    }

    .payment-table {
        width: 100%;
    }

        .payment-table td {
            padding: 5px;
        }
</style>
<div ng-app="pldbApp" ng-controller="pldbCtrl" ng-cloak="">
    <div class="col-md-12">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pt-2">
            <h5 style="text-align:center;font-size: 17px;background:#025e63;color:#fff;" class="citizen-dash-head">NI ACT Details</h5>
        </div>
        <fieldset class="dvfieldset">
            <legend class="dvlegend">Application Details/आवेदक का विवरण</legend>
            <div class="col-lg-12">
                <div class="col-lg-12 table-responsive">
                    <table class="col-lg-12 table ">
                        <tr>
                            <td>
                                <label>{{translation.LoanApplicationNo}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.LoanAccNo : ApplicantDetails.LoanAccNo }}
                            </td>
                            <td>
                                <label>{{translation.RegistrationNo}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.NoticeNo : ApplicantDetails.NoticeNo }}
                            </td>
                            <td>
                                <label>{{translation.PLDB}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.PLDBName: ApplicantDetails.PLDBName}}
                            </td>
                            <td>
                                <label>{{translation.PLDBBranch}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.PLDBBranch: ApplicantDetails.PLDBBranch}}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label>{{translation.ApplicantName}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.ApplicantName: ApplicantDetails.ApplicantName}}
                            </td>
                            <td>
                                <label>{{translation.FatherHasbandName}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.FatherHusbandName : ApplicantDetails.FatherHusbandName }}
                            </td>
                            <td>
                                <label>{{translation.Gender}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.Gender: ApplicantDetails.Gender}}
                            </td>
                            <td>
                                <label>{{translation.MobileNo}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.MobileNo: ApplicantDetails.MobileNo}}
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </fieldset>
        <fieldset class="dvfieldset">
            <legend class="dvlegend">NI ACT Details</legend>
            <div class="col-lg-12">
                <div class="col-lg-12 table-responsive">
                    <form id="niActForm" ng-submit="SaveNIActDetails()">
                        <div class="row">
                            <div class="col-md-12 mb-4" ng-init="niObj.IsChequesCollectedFromLoanee=0">
                                <label>
                                    क्या ऋणी से चेक प्राप्त किए हैं?
                                </label>
                                <div style="display:inline-flex;min-width:200px;">
                                    <label> <input type="radio" name="IsChequesCollectedFromLoanee" value="1" ng-model="niObj.IsChequesCollectedFromLoanee" /> हाँ</label>
                                    <label> <input type="radio" name="IsChequesCollectedFromLoanee" value="0" ng-model="niObj.IsChequesCollectedFromLoanee" /> नहीं</label>
                                </div>
                            </div>
                            <div class="col-md-12 mb-4" ng-show="niObj.IsChequesCollectedFromLoanee==1" ng-init="niObj.IsChequesPresentedBankForClearing=0">
                                <label>
                                    ऋण अवधिपार होने की स्थिति में क्या चेक समाशोधन के लिए प्रस्तुत किया हैं?
                                </label>
                                <div style="display:inline-flex;min-width:200px;">
                                    <label> <input type="radio" name="IsChequesPresentedBankForClearing" value="1" ng-model="niObj.IsChequesPresentedBankForClearing" /> हाँ</label>
                                    <label> <input type="radio" name="IsChequesPresentedBankForClearing" value="0" ng-model="niObj.IsChequesPresentedBankForClearing" /> नहीं</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4" ng-show="niObj.IsChequesCollectedFromLoanee==1 && niObj.IsChequesPresentedBankForClearing==1">
                            <div class="col-md-3">
                                <label>चेक नं.<span class="error">*</span></label>
                                <input type="text" class="form-control" ng-model="niObj.ChequeNo" placeholder="चेक नं." ng-required="niObj.IsChequesPresentedBankForClearing==1" />
                            </div>
                            <div class="col-md-3">
                                <label>बैंक का नाम<span class="error">*</span></label>
                                <input type="text" class="form-control" ng-model="niObj.Bankdetails" placeholder="बैंक का नाम" ng-required="niObj.IsChequesPresentedBankForClearing==1" />
                            </div>
                            <div class="col-md-3">
                                <label>चेक प्रस्तुत दिनांक <span class="error">*</span></label>
                                <input type="date" class="form-control" ng-model="niObj.ChequeDate" ng-required="niObj.IsChequesPresentedBankForClearing==1" />
                            </div>
                            <div class="col-md-3">
                                <label> चेक राशि <span class="error">*</span></label>
                                <input type="number" class="form-control" ng-model="niObj.ChequeAmt" placeholder="चेक राशि" ng-required="niObj.IsChequesPresentedBankForClearing==1" />
                            </div>
                        </div>
                        <div class="row" ng-show="niObj.IsChequesCollectedFromLoanee==1 && niObj.IsChequesPresentedBankForClearing==1">
                            <div class="col-md-12 mb-4">
                                <hr />
                                <div style="display:inline-flex;min-width:400px;">
                                    <label> <input type="radio" name="IsChequeDishonoured" value="1" ng-model="niObj.IsChequeDishonoured" /> चेक अनादरित </label>
                                    <label> <input type="radio" name="IsChequeDishonoured" value="0" ng-model="niObj.IsChequeDishonoured" /> राशि प्राप्त</label>
                                </div>
                            </div>
                            <div class="col-md-3" ng-show="niObj.IsChequeDishonoured==0">
                                <label>प्राप्त राशि<span class="error">*</span></label>
                                <input type="number" class="form-control" ng-model="niObj.RecoveryAmt" placeholder="प्राप्त राशि" ng-required="niObj.IsChequesCollectedFromLoanee==1 && niObj.IsChequesPresentedBankForClearing==1 && niObj.IsChequeDishonoured==0" />
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-md-12" ng-show="niObj.IsChequesPresentedBankForClearing==1 && niObj.IsChequeDishonoured==1" ng-init="niObj.IsChequeDishonourActionTaken=0">
                                <label>
                                    क्या चेक अनादरण के पश्चात NI Act की धारा 138 में कार्यवाही की गई है?
                                </label>
                                <div style="display:inline-flex;min-width:200px;">
                                    <label> <input type="radio" name="IsChequeDishonourActionTaken" value="1" ng-model="niObj.IsChequeDishonourActionTaken" /> हाँ</label>
                                    <label> <input type="radio" name="IsChequeDishonourActionTaken" value="0" ng-model="niObj.IsChequeDishonourActionTaken" /> नहीं</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4" ng-show="niObj.IsChequesPresentedBankForClearing==1 && niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==1">
                            <div class="col-md-3">
                                <label>केस दिनांक<span class="error">*</span></label>
                                <input type="date" class="form-control" ng-model="niObj.ActionTakenDate" placeholder="केस दिनांक" ng-required="niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==1" />
                            </div>
                            <div class="col-md-3">
                                <label>
                                    केस नं. <span class="error">*</span>
                                </label>
                                <input type="text" class="form-control" ng-model="niObj.CaseNo" placeholder="केस नं." ng-required="niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==1" />
                            </div>
                            <div class="col-md-3">
                                <label>न्यायालय का नाम<span class="error">*</span></label>
                                <input type="text" class="form-control" ng-model="niObj.CourtDetails" placeholder="न्यायालय का नाम" ng-required="niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==1" />
                            </div>
                            <div class="col-md-3">
                                <label>गत सुनवाई दिनांक<span class="error">*</span></label>
                                <input type="date" class="form-control" ng-model="niObj.LastHearingDate" ng-required="niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==1" />
                            </div>
                        </div>
                        <div class="row mb-4" ng-show="niObj.IsChequesPresentedBankForClearing==1 && niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==1">
                            <div class="col-md-3">
                                <label>अगली सुनवाई दिनांक<span class="error">*</span></label>
                                <input type="date" class="form-control" ng-model="niObj.NextHearingDate" ng-required="niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==1" />
                            </div>
                            <div class="col-md-3">
                                <label>बैंक के पक्ष में निर्णय </label>
                                <textarea class="form-control" rows="3" ng-model="niObj.JudgementFavourOfBank" placeholder="निर्णय"></textarea>
                            </div>
                            <div class="col-md-3">
                                <label> ऋणी के पक्ष में निर्णय</label>
                                <textarea class="form-control" rows="3" ng-model="niObj.JudgementFavourOfLoanee" placeholder="निर्णय"></textarea>
                            </div>
                            <div class="col-md-3">
                                <label>वसूली राशि प्राप्त<span class="error">*</span></label>
                                <input type="number" class="form-control" ng-model="niObj.RecoveryAmt" placeholder="वसूली राशि प्राप्त" ng-required="niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==1" />
                            </div>
                        </div>
                        <div class="row mb-4" ng-show="niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==0">
                            <div class="col-md-8">
                                <label>NI Act की धारा 138 में कार्यवाही नहीं करने का कारण <span class="error">*</span></label>
                                <textarea type="text" class="form-control" rows="3" ng-model="niObj.DishonourActionReason" placeholder="कार्यवाही नहीं करने का कारण" ng-required="niObj.IsChequeDishonoured==1 && niObj.IsChequeDishonourActionTaken==0"></textarea>
                            </div>
                        </div>
                        <div class="row mb-4">
                            @*<div class="col-md-8">
                                <label>OTS अंतर्गत समझौता राशि प्राप्त<span class="error">*</span></label>
                                <textarea type="text" class="form-control" rows="3" ng-model="niObj.OTSSettlementProposed" placeholder="OTS Settlement Proposal" required></textarea>
                            </div>*@
                            <div class="col-md-8">
                                <label>
                                    क्या OTS अंतर्गत समझौता राशि प्राप्त हुई हैं?
                                </label>
                                <div style="display:inline-flex;min-width:200px;">
                                    <label> <input type="radio" name="IsSettlementProposed" value="1" ng-model="niObj.IsSettlementProposed" /> हाँ</label>
                                    <label> <input type="radio" name="IsSettlementProposed" value="0" ng-model="niObj.IsSettlementProposed" /> नहीं</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-md-12 text-center">
                                @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10188 ||
                                ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10189)
                                {
                                    <input type="submit" class="btn btn-primary dev-btn" value="संचित करें" />
                                    <input type="button" class="btn btn-danger" value="रद्द करें" ng-click="niObj={}" />
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </fieldset>
    </div>
</div>
