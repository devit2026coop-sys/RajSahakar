<script src="~/Scripts/AngularFramework/PldbTaamil.js"></script>
@{
    ViewBag.Title = "Upload Taamili Document";
}
<style>
    label {
        display: inline-block;
        width: 100% !important;
        margin-bottom: 5px;
        font-weight: 700;
        font-weight: normal
    }

    .zoom {
        transition: transform .2s; /* Animation */
        margin: 0 auto;
    }

        .zoom:hover {
            padding-left: 30px;
            transform: scale(2.5); /* (150% zoom - Note: if the zoom is too large, it will go outside of the viewport) */
        }

    a > i.fa.fa-plus-circle {
        font-size: 25px;
        cursor: pointer;
    }

    a:hover > i.fa.fa-plus-circle {
        font-size: 26px;
        cursor: pointer;
    }

    a > i.fa.fa-eye {
        font-size: 25px;
        cursor: pointer;
    }

    a:hover > i.fa.fa-eye {
        font-size: 26px;
        cursor: pointer;
    }


    .dvfieldset {
        border: 1px solid #b0adad;
        border-radius: 5px;
        padding-bottom: 10px;
        margin-bottom: 20px;
        background: #fff;
        color: #444;
    }

    .dvlegend {
        width: auto;
        padding: 24px;
        margin-left: 11px;
        border: 1px solid gray;
        padding: 5px;
        border-radius: 14px;
        font-size: 16px;
        padding-left: 14px;
        padding-right: 15px;
        background: #025e63;
        color: #fff;
    }

    .modal-dialog {
        color: #444;
    }

    .payment-table {
        width: 100%;
    }

        .payment-table td {
            padding: 5px;
        }
</style>
<div ng-app="pldbApp" ng-controller="pldbCtrl" ng-cloak="">
    <div class="col-md-12">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pt-2">
            <div class="text-right"><button ng-click="BackToPage()" class="btn btn-primary dev-btn">Back To List</button></div>
            <h5 style="text-align:center;font-size: 17px;background:#025e63;color:#fff;" class="citizen-dash-head">For Upload Taamili Documents/तामिल दस्तावेज़</h5>
        </div>
        <fieldset class="dvfieldset">
            <legend class="dvlegend">Application Details/आवेदक का विवरण</legend>
            <div class="col-lg-12">
                <div class="col-lg-12 table-responsive">
                    <table class="col-lg-12 table ">
                        <tr>
                            <td>
                                <label>{{translation.LoanApplicationNo}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.LoanAccNo : ApplicantDetails.LoanAccNo }}
                            </td>
                            <td>
                                <label>{{translation.RegistrationNo}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.NoticeNo : ApplicantDetails.NoticeNo }}
                            </td>
                            <td>
                                <label>{{translation.PLDB}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.PLDBName: ApplicantDetails.PLDBName}}
                            </td>
                            <td>
                                <label>{{translation.PLDBBranch}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.PLDBBranch: ApplicantDetails.PLDBBranch}}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label>{{translation.ApplicantName}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.ApplicantName: ApplicantDetails.ApplicantName}}
                            </td>
                            <td>
                                <label>{{translation.FatherHasbandName}} :</label>
                            </td>
                            <td>
                                {{ _language=='en-us' ? ApplicantDetails.FatherHusbandName : ApplicantDetails.FatherHusbandName }}
                            </td>
                            <td>
                                <label>{{translation.Gender}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.Gender: ApplicantDetails.Gender}}
                            </td>
                            <td>
                                <label>{{translation.MobileNo}} :</label>
                            </td>
                            <td>
                                {{_language=='en-us' ? ApplicantDetails.MobileNo: ApplicantDetails.MobileNo}}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label>{{translation.Taamili}} :</label>
                            </td>
                            <td>
                                <a ng-show="ApplicantDetails.TaamilDoc!=null && ApplicantDetails.TaamilDoc!=''" href="~/Content/OTS/AcceptanceLetter/{{ApplicantDetails.TaamilDoc}}" target="_blank" class="btn dev-btn btn-primary"> View Taamili</a>

                                <a href="javascript:void(0);" class="btn btn-warning" data-toggle="modal" data-target="#Taamilmodal">Upload Taamili</a>
                            </td>
                            <td>
                                <label>{{translation.OtherAttachment}} :</label>
                            </td>
                            <td>
                                <a ng-show="ApplicantDetails.OtherDoc!=null && ApplicantDetails.OtherDoc!=''" href="~/Content/OTS/AcceptanceLetter/{{ApplicantDetails.OtherDoc}}" target="_blank" class="btn dev-btn btn-primary">View Selfie</a>
                            </td>
                            <td>
                                <label>{{translation.Remark}} :</label>
                            </td>
                            <td>
                                {{ApplicantDetails.docRemark}}
                            </td>
                            <td></td>
                            <td></td>
                        </tr>
                    </table>
                </div>
            </div>
        </fieldset>
    </div>
    <div id="Taamilmodal" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <b class="text-info">To Upload Taamili Documents/तामिल दस्तावेज़ अपलोड</b>
                    <a data-dismiss="modal" class="pull-right"><i class="fa fa-times"></i></a>
                </div>
                <div class="modal-body">
                    <form id="paymentForm" ng-submit="UploadeReportFileInDB(ApplicantDetails)">
                        <table class="payment-table">
                            <tr>
                                <td>Upload Taamili:<br> <span class="text-muted text-danger">  Upload PDF only, max size 2 MB</span></td>
                                <td>
                                    <input type="file" name="File_{{$index}}" accept="application/pdf" filetype='pdf' id="flReportFile" class="form-control fileuploader" checkmaxsize="5120" ng-model="ApplicantDetails.DocTaamil" onchange="angular.element(this).scope().UploadReportFile(this.files,'Taamil')">
                                </td>
                            </tr>
                            <tr>
                                <td>Upload selfie: <br><span class="text-muted text-danger">  Upload Image only, max size 5 MB</span></td>
                                <td>
                                    <input type="file" name="File_{{$index}}" accept="image/*" filetype='image' id="flReportFile" class="form-control fileuploader" checkmaxsize="5120" ng-model="ApplicantDetails.DocSelfie" onchange="angular.element(this).scope().UploadReportFile(this.files,'Selfie')">
                                </td>
                            </tr>
                            <tr>
                                <td>टिप्पणी</td>
                                <td ng-init="Remark=''">
                                    <input type="text" class="form-control" id="Remarks" ng-model="Remark" placeholder="Remark" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" align="center">
                                    <input type="submit" class="btn btn-primary dev-btn" value="Submit" />
                                    <input type="button" class="btn btn-danger" value="Cancel" data-dismiss="modal" ng-click="BackToPage()" />
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<input type="hidden" name="hdlang" id="hdlang" value="hi-IN" />

<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />

<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }
</style>
<script src="~/Scripts/google_hindi/google_transapi.js"></script>
<script type="text/javascript">
    google.load("elements", "1", {
        packages: "transliteration"
    });

    function onLoad() {
        //var content = document.getElementById('content');
        if (document.getElementById('hdlang').value == "hi-IN") {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: true
            };
        }
        else {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: false
            }
        }
        var ids = ["Remarks"];
        var control = new google.elements.transliteration.TransliterationControl(options);
        control.makeTransliteratable(ids);
    }
    google.setOnLoadCallback(onLoad);

</script>


<script src="~/Scripts/google_hindi/google_transliteration.js"></script>

