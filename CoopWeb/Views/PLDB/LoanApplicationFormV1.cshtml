<script type="text/javascript">
    function OnSuccess(data) {
        $('#preloader').hide();
        if (data.UserType == 'C') {
            $('#FormPost').html(data.result);
            $('#FormPost').find('form').submit();
        }
        else {
            if (data.result == 'Sucess') {
                alert('Details Save Successful');
                window.location = "../Citizen/MemberApplicationView?ApplicationIdEnc=" + data.IdEnc;
            }
            else {
                ShowModelAlert("Society Member Registration", 'Issue in Payment Receiveing Please Try after Some time');
            }
        }
    }
    function OnFailure(data) {
        $('#preloader').hide();
        alert(JSON.stringify(data));
    }
    function OnBegin() {
        $('#preloader').show();
    }

    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode
        if (iKeyCode != 46 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57))
            return false;

        return true;
    }
    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };

    function isAlphaNumeric(e) { // Alphanumeric only
        var k;
        document.all ? k = e.keycode : k = e.which;
        return ((k > 47 && k < 58) || (k > 64 && k < 91) || (k > 96 && k < 123) || k == 0 || k == 32 || k == 44);
    }


    $(document).ready(function () {
        $("select").on("change", function () {
            $(this).removeClass("notValid");
        });


        $(".expandDetails").click(function () {
            var panl_id = $(this).attr("dat-val");
            if ($(this).hasClass("fa-plus-circle")) {
                $(this).removeClass("fa-plus-circle").addClass("fa-minus-circle")
            } else {
                $(this).addClass("fa-plus-circle").removeClass("fa-minus-circle")
            }
            $("#" + panl_id).slideToggle("slow");
        });
        var date = (new Date()).getDate() + '/' + ((new Date()).getMonth() + 1) + '/' + ((new Date()).getFullYear()).toString();

        $('.devcalender').datepicker({
            showOn: "both",
            changeMonth: true,
            buttonImage: "../images/calender.png",
            changeYear: true,
            dateFormat: "dd/mm/yy",
            // minDate: '0'
            yearRange: "c-10:c+0"
        });

    });
    function validateInput(input, maxLength, maxDecimalPlaces) {
    let value = input.value;
    if (value) {
        // Check for decimal places
        let parts = value.split('.');
        if (parts.length > 1 && parts[1].length > maxDecimalPlaces) {
            value = parseFloat(value).toFixed(maxDecimalPlaces);
            input.value = value;
        }

        // Check for overall length (excluding decimal point and decimal places)
        let integerPartLength = parts[0].length;
        let totalLength = integerPartLength + (parts[1] ? parts[1].length : 0);
        if (totalLength > maxLength) {
            input.value = input.value.slice(0, maxLength);
        }
    }
}

</script>
