    <div id="repaymentmodal" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <b class="text-info">New Payment Form</b>
                    <a data-dismiss="modal" class="pull-right"><i class="fa fa-times"></i></a>
                </div>
                <div class="modal-body">
                    <form id="paymentForm" ng-submit="SavePayment()">
                        <table class="payment-table">
                            <thead>
                                <tr>
                                    <td colspan="2">
                                        <label><input type="checkbox" value="1" ng-model="payObj.IsFinalPayment" /> Check, If you want to make final receipt payment</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Deposit Amount (in Rupees):</td>
                                    <td>
                                        <input type="number" class="form-control" ng-model="payObj.PaidAmount" placeholder="0.00" min="1" required />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Payment Mode</td>
                                    <td>
                                        <select class="form-control" ng-model="payObj.PaymentModeId" ng-init="payObj.PaymentModeId=''" required>
                                            <option value="" disabled>--Select--</option>
                                            <option value="{{li.PaymentModeId}}" ng-repeat="li in PaymentModeList">{{_language=='en-us' ? li.ModeNameEn: li.ModeNameHi}}</option>
                                        </select>
                                    </td>

                                </tr>
                                <tr ng-hide="payObj.PaymentModeId==1 || payObj.PaymentModeId==2">
                                    <td>UTR/Ref No.</td>
                                    <td>
                                        <input type="text" class="form-control" ng-model="payObj.UTR_RefNo" placeholder="UTR/Ref No." />
                                    </td>
                                </tr>

                                <tr ng-show="payObj.PaymentModeId==2">
                                    <td>Cheque No.</td>
                                    <td>
                                        <input type="text" class="form-control" ng-model="payObj.ChequeNo" placeholder="Cheque No." />
                                    </td>
                                </tr>
                                <tr ng-show="payObj.PaymentModeId==2">
                                    <td>Cheque date</td>
                                    <td>
                                        <input type="date" class="form-control" ng-model="payObj.ChequeDate" placeholder="Cheque Date" max="{{ today | date:'yyyy-MM-dd' }}" />
                                    </td>
                                </tr>
                                <tr ng-show="payObj.PaymentModeId==2">
                                    <td>Cheque Remark</td>
                                    <td>
                                        <input type="text" class="form-control" ng-model="payObj.ChequeOther" placeholder="Remark " />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Depositor Type</td>
                                    <td>
                                        <select class="form-control" ng-model="payObj.DepositorType" ng-init="payObj.DepositorType=''" required>
                                            <option value="" disabled>--Select--</option>
                                            <option value="Self">Self</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </td>
                                </tr>

                                <tr ng-show="payObj.DepositorType=='Other'">
                                    <td>Depositor Person Name</td>
                                    <td>
                                        <input type="text" class="form-control" ng-model="payObj.DepositByPerson" ng-init="payObj.DepositorType=='Self' ?'Self':''" placeholder="Depositor Person Name" />
                                    </td>
                                </tr>

                                <tr>
                                    <td>Payment Date</td>
                                    <td>
                                        <input type="date" class="form-control" ng-model="payObj.PaymentDate" min="2025-04-01" max="{{ today | date:'yyyy-MM-dd' }}" required />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Remark</td>
                                    <td>
                                        <input type="text" id="Remarks" class="form-control" ng-model="payObj.Remark" placeholder="Remark" />
                                    </td>
                                </tr>
                            </thead>
                            <tbody ng-show="payObj.IsFinalPayment">
                                <tr>
                                    <td colspan="2">
                                        <hr />
                                        Dues after 01-04-2025
                                    </td>
                                </tr>
                                <tr>
                                    <td>Interest</td>
                                    <td>
                                        <input type="number" class="form-control" ng-model="payObj.InterestAmount" placeholder="0.00" min="0" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Penal Interest</td>
                                    <td>
                                        <input type="number" class="form-control" ng-model="payObj.PenalInterestAmount" placeholder="0.00" min="0" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Principal</td>
                                    <td>
                                        <input type="number" class="form-control" ng-model="payObj.PrincipalAmount" placeholder="0.00" min="0" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Other Amount</td>
                                    <td>
                                        <input type="number" class="form-control" ng-model="payObj.OtherAmount" placeholder="0.00" min="0" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Final Payment Remark</td>
                                    <td>
                                        <input type="text" id="Remarks" class="form-control" ng-model="payObj.FinalRemark" placeholder="Remark" />
                                    </td>
                                </tr>
                            </tbody>
                            <tbody>
                                <tr>
                                    <td><b>वसूली कर्ता का नाम</b></td>
                                    <td>
                                    </td>
                                </tr>
                                <tr>
                                    <td>वसूली कर्ता का प्रकार</td>
                                    <td>
                                        <select class="form-control" ng-model="payObj.RecoveryPersonType" ng-init="payObj.RecoveryPersonType=''" required>
                                            <option value="" disabled>--Select--</option>
                                            <option value="1">बैंक कार्मिक</option>
                                            <option value="2">पैक्स कार्मिक</option>
                                        </select>
                                    </td>
                                </tr>

                                <tr>
                                    <td>नाम</td>
                                    <td>
                                        <input type="text" class="form-control" ng-model="payObj.RecoveryPersonName" placeholder="नाम" required />
                                    </td>
                                </tr>
                                <tr>
                                    <td>पदनाम</td>
                                    <td>
                                        <input type="text" id="Remarks" class="form-control" ng-model="payObj.RecoveryPersonDesignation" placeholder="पदनाम" required />
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2" align="center">
                                        <input type="submit" class="btn btn-primary dev-btn" value="Submit" />
                                        <input type="button" class="btn btn-danger" value="Cancel" data-dismiss="modal" ng-click="payObj={}" />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<input type="hidden" name="hdlang" id="hdlang" value="hi-IN" />

<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />

<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }
</style>
<script src="~/Scripts/google_hindi/google_transapi.js"></script>
<script type="text/javascript">
    google.load("elements", "1", {
        packages: "transliteration"
    });

    function onLoad() {
        if (document.getElementById('hdlang').value == "hi-IN") {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: true
            };
        }
        else {
            var options = {
                sourceLanguage: google.elements.transliteration.LanguageCode.ENGLISH,
                destinationLanguage: google.elements.transliteration.LanguageCode.HINDI, // available option English, Bengali, Marathi, Malayalam etc.
                shortcutKey: 'ctrl+g',
                transliterationEnabled: false
            }
        }
        var ids = ["Remarks"];
        var control = new google.elements.transliteration.TransliterationControl(options);
        control.makeTransliteratable(ids);
    }
    google.setOnLoadCallback(onLoad);

</script>


