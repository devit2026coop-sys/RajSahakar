

<script src="~/Scripts/AngularFramework/BankDetails.js"></script>

<div ng-app="BankDetailsMod">
    <div ng-controller="BankDetailsCnt">
        <input type="hidden" id="hdnPLDBId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
        <input type="hidden" id="hdnBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h4 class="citizen-dash-head"> {{translation.BankDetails}}</h4>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">{{translation.BankDetails}} </span>
                    </li>
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" ng-click="ShowForm()"> <h5>&#187; {{translation.AddNew}}</h5> </button>
                    </li>
                </ul>
            </div>
        </div>
        <input type="hidden" id="hdnSocietyType" value="1" />
        @Html.Partial("_BankDetails")

    </div>
</div>

