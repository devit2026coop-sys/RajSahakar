@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" ng-app="OTSLoanReceiptModule" ng-controller="OTSLoanReceiptCont">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/jquery-3.1.0.js"></script>
    <script src="~/Scripts/dirPagination.js"></script>
    <script src="~/Scripts/AngularFramework/OtsFinalLoanReceipt.js?v=1.2"></script>
    <title>{{FinalPaymentSummaryList[0].ReceiptNo}}</title>
    <style>
        * {
            font-size: 12px;
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        .pdf-table {
            width: 740px;
            padding: 20px 50px;
            background: #ffffff;
        }

        .iner-tbler td, .iner-tbler th {
            border: 1px solid #000;
            padding: 4px;
        }

            .iner-tbler td:nth-child(2) {
                font-weight: 800;
                text-align: right;
            }
    </style>
</head>
<body style="background:#808080">
    <div ng-cloak="" style="display:flex;justify-content:center">
        <section class="pdf-table">
            <table width="100%">
                <tbody>
                    <tr>
                        <td><img src="../Content/Images/cm-ots-logo.png" alt="" width="90"></td>
                        <td>
                            <p style="text-align: center; font-weight: 800; font-size: 22px; vertical-align:top">
                                प्राथमिक सहकारी भूमि विकास बैंक लि.  {{ApplicantDetails.PLDBNameHi}}
                                <br>शाखा {{ApplicantDetails.BranchNameHi}}
                            </p>

                        </td>
                        <td align="right"><img src="../Content/Images/iyc_logo.png" alt="" width="90"></td>
                    </tr>
                </tbody>
            </table>
            <table width="100%">
                <tbody>
                    <tr>
                        <td colspan="2">दिनांक : <b>{{FinalPaymentSummaryList[0].CreatedOn | date:'dd-MM-yyyy'}}</b></td>
                        <td style="padding: 10px 0;" align="right">रसीद नं. : <b>{{FinalPaymentSummaryList[0].ReceiptNo}}</b></td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <p style="text-align: justify; font-size: 15px;font-weight: 500; padding: 20px 0; line-height: 35px;text-transform:uppercase">
                                श्री/श्रीमती/सुश्री <b style="font-size:15px;">{{ApplicantDetails.ApplicantName}}</b> पुत्र/पुत्री/पति/पत्नी <b style="font-size:15px;">{{ApplicantDetails.FatherHusbandName}}</b><br />
                                ग्राम {{ApplicantDetails.VName}} तहसील {{ApplicantDetails.TehsilName}} जिला {{ApplicantDetails.DistrictName}}<br />
                                खाता सं. <b style="font-size:15px;">{{ApplicantDetails.LoanAccNo}}</b> ऋण उद्देश्य {{ApplicantDetails.Purpose}} से कुल राशि रू. <b>
                                    <u style="font-size:15px;">{{FinalPaymentSummaryList[0].PaidAmount}}</u>
                                </b> अक्षरे रु. <b><u style="font-size:15px;">{{FinalPaymentSummaryList[0].PaidAmountInWord}}</u></b>
                                वसूली पेटे  प्राप्त किए।
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <table class="iner-tbler" border="1">
                                <thead>
                                    <tr>
                                        <th>नाम मद</th>
                                        <th width="120">राशि (रु.)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="2"><strong>अवधिपार वसूली</strong></td>
                                    </tr>
                                    <tr>
                                        <td>असल में</td>
                                        <td>{{FinalPaymentSummaryList[0].Actual}}</td>
                                    </tr>
                                    <tr>
                                        <td>बीमा प्रीमियम</td>
                                        <td>{{FinalPaymentSummaryList[0].InsurancePremium}}</td>
                                    </tr>
                                    @*<tr>
                                            <td>अन्य</td>
                                            <td>{{FinalPaymentSummaryList[0].OtherAmount}}</td>
                                        </tr>*@
                                    <tr>
                                        <td>योग (अ)</td>
                                        <td>{{FinalPaymentSummaryList[0].OverdueRecoveryTotal}}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2"><strong>चालू वसूली</strong></td>
                                    </tr>
                                    <tr>
                                        <td>असल में</td>
                                        <td>{{FinalPaymentSummaryList[0].CurrentActual}}</td>
                                    </tr>
                                    <tr>
                                        <td>बीमा प्रीमियम</td>
                                        <td>{{FinalPaymentSummaryList[0].CurrentInsurancePremium}}</td>
                                    </tr>
                                    <tr>
                                        <td>ब्याज</td>
                                        <td>
                                            {{FinalPaymentSummaryList[0].CurrentInterest}}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>द. ब्याज</td>
                                        <td>
                                            {{PenalInt}}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>वसूली शुल्क</td>
                                        <td>{{FinalPaymentSummaryList[0].RecoveryCharge}}</td>
                                    </tr>
                                    <tr>
                                        <td>अन्य</td>
                                        <td>{{FinalPaymentSummaryList[0].CurrentOtherAmount}}</td>
                                    </tr>
                                    <tr>
                                        <td>योग (ब)</td>
                                        <td>{{FinalPaymentSummaryList[0].CurrentRecoveryTotal}}</td>
                                    </tr>
                                    <tr>
                                        <td><b>कुल योग (अ + ब)</b></td>
                                        <td>{{FinalPaymentSummaryList[0].SubTotal}}</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <b>
                                                मुख्यमंत्री अवधिपार ब्याज राहत एकमुश्त समझौता योजना 2025-26 (CM OTS 2025-26) में प्रदत्त राहत
                                            </b>
                                        </td>
                                        <td>{{FinalPaymentSummaryList[0].ReliefAmount}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <p style="text-align: center; font-size: 15px;font-weight: 500; padding: 10px 0; line-height: 20px;">
                                योजनान्तर्गत जमा करवाई गई उपरोक्त राशि का विवरण
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <table class="iner-tbler" border="1">
                                <thead>
                                    <tr>
                                        <th width="30">क्रमांक</th>
                                        <th align="center">दिनांक</th>
                                        <th align="center">रसीद नं.</th>
                                        <th align="center">भुगतान का तरीका</th>
                                        <th align="center" width="100">राशि रू.</th>
                                        <th align="center">जमा कराने वाला व्यक्ति</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in paymentSummaryList">
                                        <td align="center">{{$index+1}}</td>
                                        <td>{{item.PaymentDate | date:'dd-MM-yyyy'}}</td>
                                        <td align="left">{{item.ReceiptNo}}</td>
                                        <td align="left">
                                            {{item.PaymentMode}}
                                            <div ng-show="item.PaymentModeId==2">
                                                Cheque No: {{item.ChequeNo}}
                                                Cheque Date: {{item.ChequeDate|date:'dd-MM-yyyy'}}
                                                Remark: {{item.ChequeOther}}
                                            </div>
                                        </td>
                                        <td align="center">{{item.PaidAmount1}}</td>
                                        <td align="center">{{item.DepositByPerson}}</td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="4" align="center">कुल योग</th>
                                        <th>{{paymentSummaryList[0].TotalPaidAmount}}</th>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
            <br />
            <img height="100" width="100" src="{{QrData}}" />
            <p style="font-size:10px; text-align:center">This is a system generated receipt, no signature is required./यह सिस्टम द्वारा जनरेटेड रसीद है, इसमें हस्ताक्षर की आवश्यकता नहीं है।</p>
        </section>
    </div>
    <script>
        setTimeout(function () { window.print(); }, 2000)
    </script>
</body>
</html>