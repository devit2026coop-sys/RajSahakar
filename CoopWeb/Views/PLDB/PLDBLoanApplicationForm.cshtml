                                        <input type="date" class="form-control" ng-model="PLDB.LoanDisbursement.CertificateThirdInstallmentDate">
                                    </div>

                                    <!-- Insurance Medical Certificate -->
                                    <div class="form-group col-md-4">
                                        <label>ऋण उद्देश्य से संबंधित आवश्यक विवरण(R.C., Insurance, Medical Certificate आदि)</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.InsuranceMedicalCertificate" placeholder="ऋण उद्देश्य से संबंधित आवश्यक विवरण">
                                    </div>

