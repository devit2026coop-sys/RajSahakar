                                        <label>ऋण उपसमिति के सदस्य 2 का नाम</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.Member2" placeholder="सदस्य 2 का नाम">
                                    </div>

                                    <div class="form-group col-md-4">
                                        <label>ऋण उपसमिति के सदस्य 3 का नाम</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.Member3" placeholder="सदस्य 3 का नाम">
                                    </div>

                                    <div class="form-group col-md-4">
                                        <label>ऋण उपसमिति के सदस्य 4 का नाम</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.Member4" placeholder="सदस्य 4 का नाम">
                                    </div>

                                    <div class="form-group col-md-4">
                                        <label>ऋण उपसमिति के सदस्य 5 का नाम</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.Member5" placeholder="सदस्य 5 का नाम">
                                    </div>

                                    <!-- Administrator Name -->
                                    <div class="form-group col-md-4">
                                        <label>प्रशासक / अध्यक्ष का नाम</label>
