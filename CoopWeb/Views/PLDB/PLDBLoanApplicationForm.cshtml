                                    <div class="form-group col-md-3">
                                        <label>क्या ऋण को पासबुक जारी की गई है?</label>
                                        <div class="radio-button-box" ng-init="PLDB.LoanDisbursement.IsIssueofPassbook=0">
                                            <label class="help-block-gender">
                                                <input type="radio" name="IsIssueofPassbook" value="1" ng-model="PLDB.LoanDisbursement.IsIssueofPassbook">हाँ

                                            </label>
                                            <label class="help-block-gender">
                                                <input type="radio" value="0" name="IsIssueofPassbook" ng-model="PLDB.LoanDisbursement.IsIssueofPassbook">नहीं
                                            </label>
                                        </div>
                                    </div>

                                    <div class="form-group col-md-12">
                                        <h5 class="heading-hr ng-binding">ऋण स्वीकृति हेतु उत्तरदायी कार्मिक / सचिव / ऋण उपसमिति के सदस्यों का नाम</h5>
                                    </div>

                                    <!-- Loan Supervisor Name -->
                                    <div class="form-group col-md-4">
                                        <label>ऋण पर्यवेक्षक का नाम</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.LoanSupervisorName" placeholder="ऋण पर्यवेक्षक का नाम">
                                    </div>

                                    <!-- Branch Secretary Name -->
                                    <div class="form-group col-md-4">
                                        <label>शाखा सचिव का नाम</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.BranchSecretaryName" placeholder="शाखा सचिव का नाम">
                                    </div>

                                    <!-- Secretary Name -->
                                    <div class="form-group col-md-4">
                                        <label>सचिव का नाम </label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.SecretaryName" placeholder="सचिव का नाम">
                                    </div>

                                    <div class="form-group col-md-4">
                                        <label>ऋण उपसमिति के सदस्य 1 का नाम</label>
