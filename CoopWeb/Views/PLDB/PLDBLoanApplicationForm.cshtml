                                                <label>तृतीय किस्त दिनांक</label>
                                                <input type="date" class="form-control"
                                                       ng-model="PLDB.LoanDisbursement.ThirdInstallmentDate">
                                            </div>

                                            <!-- Third Installment Money -->
                                            <div class="form-group col-md-4">
                                                <label>तृतीय किस्त राशि</label>
                                                <input type="number" class="form-control"
                                                       ng-model="PLDB.LoanDisbursement.ThirdInstallmentMoney"
                                                       placeholder="तृतीय किस्त राशि">
                                            </div>

                                        </div>
                                    </div>
                                    <!-- Cheque Number -->
                                    <div class="form-group col-md-4">
                                        <label> विक्रेता को किए गए भुगतान के संबंध में चेक संख्या </label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.VendorChequeNumber" placeholder="चेक संख्या ">
                                    </div>

                                    <!-- Receipt Number -->
                                    <div class="form-group col-md-4">
                                        <label> विक्रेता को किए गए भुगतान के संबंध में रसीद संख्या</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.ReceiptNumber" placeholder="रसीद संख्या">
                                    </div>

                                    <!-- Vendor Amount -->
                                    <div class="form-group col-md-4">
                                        <label>विक्रेता को किए गए भुगतान के संबंध में राशि</label>
                                        <input type="number" class="form-control" ng-model="PLDB.LoanDisbursement.VendorAmount" placeholder="भुगतान के संबंध में राशि">
                                    </div>

                                    <!-- Bill Number -->
                                    <div class="form-group col-md-4">
                                        <label>बिल का विवरण क्रमांक</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.BillNumber" placeholder="बिल का विवरण क्रमांक">
                                    </div>

                                    <!-- GST Number -->
                                    <div class="form-group col-md-4">
                                        <label>जीएसटी नंबर</label>
                                        <input type="text" class="form-control" ng-model="PLDB.LoanDisbursement.GSTNo" placeholder=" GST No">
                                    </div>

                                    <!-- Bill Date -->
                                    <div class="form-group col-md-4">
                                        <label> बिल का दिनांक</label>
                                        <input type="date" class="form-control" ng-model="PLDB.LoanDisbursement.BillDate">
                                    </div>

                                    <!-- Loan Time (Years) -->
                                    <div class="form-group col-md-4">
                                        <label>ऋण अदायगी की अवधि (वर्ष में)</label>
                                        <input type="number" class="form-control" ng-model="PLDB.LoanDisbursement.LoanTimeInYear" placeholder="ऋण अदायगी की अवधि (वर्ष में)">
                                    </div>

                                    <div class="form-group col-md-4">
                                        <label>किस्त आवृत्ति</label>
                                        <select class="form-control" ng-model="PLDB.LoanDisbursement.InstallmentYearWiseId">
                                            <option value="">-- चुनें --</option>
                                            <option value="4">वार्षिक</option>
                                            <option value="1">अर्धवार्षिक</option>
                                            <option value="2">त्रैमासिक</option>
                                            <option value="3">मासिक</option>
                                        </select>
                                    </div>


                                    <!-- Certificate First Installment Date -->
                                    <div class="form-group col-md-4">
                                        <label>किस्तवार ऋण उपयोगिता प्रमाण पत्र प्रथम किस्त (दिनांक)</label>
                                        <input type="date" class="form-control" ng-model="PLDB.LoanDisbursement.CertificateFirstInstallmentDate" max="{{maxCertDate}}">
                                    </div>

                                    <!-- Certificate Second Installment Date -->
                                    <div class="form-group col-md-4">
                                        <label>किस्तवार ऋण उपयोगिता प्रमाण पत्र द्वितीय किस्त (दिनांक)</label>
                                        <input type="date" class="form-control" ng-model="PLDB.LoanDisbursement.CertificateSecondInstallmentDate">
                                    </div>

