                                        <div style="display:flex; align-items:center; gap:5px;">
                                            <input type="file" accept="application/pdf" class="form-control" id="LoanDocument" ng-model="PLDB.LoanDisbursement.LoanDocument" ng-hide="isViewMode"
                                                   onchange="angular.element(this).scope().SelectReceiptFile(this.files)">
                                            <div style="display:flex; align-items:center; gap:5px;">
                                                <button ng-hide="isViewMode" type="button" class="btn btn-primary mt-2" ng-click="Save_PLDBFormUploadDoc(false)">  Upload Document </button>
                                                <div ng-if="PLDB.LoanDisbursement.LoanDocument" style="display:flex; align-items:center; gap:5px" class="mt-2">
                                                    <a target="_blank" class="btn btn-success" href="../Content/PLDB/LoanDocuments/{{PLDB.LoanDisbursement.LoanDocument}}" title="View Document">
                                                        <i class="fa fa-file-o"></i>
                                                    </a>
                                                    <a href="javascript:void(0)" class="btn btn-danger" ng-click="RemoveLoanDocument()" ng-hide="isViewMode" title="Remove Document">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                    </div>


                                    <!-- Document 2 -->
                                    <div class="col-md-4 form-group">  
                                        <label ng-hide="isViewMode">अपलोड करें</label>
                                        <div style="display:flex; align-items:center; gap:5px;">
                                            <input type="file" accept="application/pdf" class="form-control" id="LoanDocument2" ng-model="PLDB.LoanDisbursement.LoanDocument2" ng-hide="isViewMode"
                                                   onchange="angular.element(this).scope().SelectReceiptFile2(this.files)">

                                            <div style="display:flex; align-items:center; gap:5px;">
                                                <button ng-hide="isViewMode" type="button" class="btn btn-primary mt-2" ng-click="Save_PLDBFormUploadDoc(false)"> Upload Document </button>
                                                <div ng-if="PLDB.LoanDisbursement.LoanDocument2" style="display:flex; align-items:center; gap:5px" class="mt-2">
                                                    <a target="_blank" class="btn btn-success" href="../Content/PLDB/LoanDocument2/LoanDocuments/{{PLDB.LoanDisbursement.LoanDocument2}}" title="View Document">
                                                        <i class="fa fa-file-o"></i>
                                                    </a>
                                                    <a href="javascript:void(0)" class="btn btn-danger" ng-click="RemoveLoanDocument2()" ng-hide="isViewMode" title="Remove Document">
                                                        <i class="fa fa-trash"></i>
                                                    </a>

                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <!-- Document 3 -->
                                    <div class="col-md-4 form-group">


                                        <label ng-hide="isViewMode">अपलोड करें</label>
                                        <div style="display:flex; align-items:center; gap:5px;">
                                            <input type="file" accept="application/pdf" class="form-control" id="LoanDocument3" ng-model="PLDB.LoanDisbursement.LoanDocument3" ng-hide="isViewMode"
                                                   onchange="angular.element(this).scope().SelectReceiptFile3(this.files)">

                                            <div style="display:flex; align-items:center; gap:5px;">
                                                <button ng-hide="isViewMode" type="button" class="btn btn-primary mt-2" ng-click="Save_PLDBFormUploadDoc(false)">  Upload Document  </button>
                                                <div ng-if="PLDB.LoanDisbursement.LoanDocument3" style="display:flex; align-items:center; gap:5px" class="mt-2">
                                                    <a target="_blank" class="btn btn-success" href="../Content/PLDB/LoanDocument3/LoanDocuments/{{PLDB.LoanDisbursement.LoanDocument3}}" title="View Document">
                                                        <i class="fa fa-file-o"></i>
                                                    </a>
                                                    <a href="javascript:void(0)" class="btn btn-danger" ng-click="RemoveLoanDocument3()" ng-hide="isViewMode" title="Remove Document">
                                                        <i class="fa fa-trash"></i>
                                                    </a>

                                                </div>
                                            </div>

                                        </div>
                                    </div>


                                    <div class="form-group col-md-3">
                                        <button type="button" ng-if="!isViewMode && IsSubmiApplication==false" class="btn btn-primary" ng-click="Save_PLDBForm(false)">
                                            Partial Save
                                        </button>
                                    </div>

                                </div>
                                @*</div>*@
                            </div>
                            <br />
                        </div>
                        <div class="form-group col-md-12 text-center" style="margin-top: 25px; padding-top: 10px; background-color: white; padding-bottom: 10px;">
                            <center>
                                <input type="hidden" ng-model="PLDB.PLDB_OTS_SchemeID" />
                                @*Partial Save Button*@
                                @*<button type="button" class="btn btn-primary" ng-if="!isViewMode && IsSubmiApplication==false" ng-disabled="PLDB.IsFinalSubmit" ng-click="Save_PLDBForm(false)"> Partial Save </button>*@
                                @*Final Save Button*@
                                <button type="button" class="btn btn-success" ng-if="!isViewMode && IsSubmiApplication==false && PLDB.IsFinalSubmit != 1" ng-disabled="PLDB.IsFinalSubmit" ng-click="Save_PLDBForm(true)"> Final Submit </button>
                            </center>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
