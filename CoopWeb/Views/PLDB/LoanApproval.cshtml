                                                            <option value="0">{{translation.Tehsil}}</option>
                                                            <option ng-repeat="itemBlock in item.TehsilList | orderBy:'BLOCK_ENG'" value="{{itemBlock.BLOCK_ID}}">
                                                                {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                                                            </option>
                                                        </select>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div style="width:100%">
                                                        <select ng-model="item.GramPanchayat" class="form-control" ng-init="item.GramPanchayat" style="width: 110px;" ng-change="GetPropertyDetailsVillages($index)">
                                                            <option value="0">{{translation.GramPanchayatHeading}}</option>
                                                            <option ng-repeat="itemGP in item.GramPanchayatList | orderBy:'GramPanchayats'" value="{{itemGP.GP_ID}}">
                                                                {{_language =='en-us' ?  itemGP.GP_ENG : itemGP.GP_MANGAL}}
                                                            </option>
                                                        </select>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div style="width:100%">
                                                        <select ng-model="item.Village" class="form-control" ng-init="item.Village" style="width: 110px;">
                                                            <option value="0">{{translation.Village}}</option>
                                                            <option ng-repeat="itm in item.VillageList" value="{{itm.VILLAGE_ID}}">
                                                                {{_language =='en-us' ?  itm.VILLAGE_ENG : itm.VILLAGE_MANGAL}}
                                                            </option>
                                                        </select>
                                                    </div>
                                                </td>


                                                <td>
                                                    <input type="text" name="MembershipNumber" class="form-control" placeholder="{{translation.KhanKulKita}}" ng-model="item.Khasara" autocomplete="off" onKeyPress="">
                                                </td>
                                                <td>
                                                    <input type="text" name="MembershipNumber" class="form-control" placeholder="{{translation.BiHain}}" ng-model="item.ChahiBi" autocomplete="off" onKeyPress="">
                                                </td>
                                                <td>
                                                    <input type="text" name="MembershipNumber" class="form-control" placeholder="{{translation.ViAyear}}" ng-model="item.ChahiVi" autocomplete="off" onKeyPress="">
                                                </td>
                                                <td>
                                                    <input type="text" name="MembershipNumber" class="form-control" placeholder="{{translation.BiHain}}" ng-model="item.BaraniBi" autocomplete="off" onKeyPress="">
                                                </td>

                                                <td>
                                                    <input type="text" name="MembershipNumber" class="form-control" placeholder="{{translation.ViAyear}}" ng-model="item.BaraniVi" autocomplete="off" onKeyPress="">
                                                </td>
                                                <td>
                                                    <textarea rows="1" class="form-control" maxlength="150" placeholder="{{translation.OtherDetails}}" ng-model="item.OtherDetails"></textarea>
                                                </td>
                                                <td>
                                                    <textarea rows="1" class="form-control" maxlength="150" placeholder="{{translation.Specifications}}" ng-model="item.Specifications"></textarea>
                                                </td>
                                                <td style="text-align: right !important">
                                                    <i class="fa fa-trash clsShowHide btn btn btn-xs btn-danger tooltips rowdeleteBtn" id="Remove_2" ng-if="PropertyDetailsList.length>1" ng-click="RemovePropertyRow($index)" style=""></i>
                                                </td>

                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="11"></td>
                                                <td style="text-align:right;cursor:pointer;" ng-click="AddNewPropertyDetails()"><i class="fa fa-plus" title="Add New"></i>{{translation.Add}}</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <div class="col-lg-12 form-group">
                                <h4 class="heading-hr ng-binding">{{translation.PreLoanDetails}}<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_4" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
                            </div>

                            <div class="col-lg-12 clspanal" id="panal_4">
                                <div class="table-responsive">
                                    <table class="table devtable" id="tblPreLoanDetails">
                                        <thead>
                                            <tr>
                                                <th rowspan="3" class="thverticalMiddle">{{translation.SRNO}}</th>
                                                <th rowspan="3" class="thverticalMiddle">{{translation.CooperativeBankName}}</th>
                                                <th rowspan="3" class="thverticalMiddle">{{translation.LoanAmount}}</th>
                                                <th rowspan="3" class="thverticalMiddle">{{translation.MonthlyInstallment}}</th>
                                                <th class="thCenter"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item in PreLoanDetailsList" ng-if="item.IsDelete==false">
                                                <td>{{$index+1}}</td>
                                                <td>
                                                    <input type="text" name="FatherName" class="form-control" placeholder="{{translation.CooperativeBankName}}" ng-model="item.Organization" autocomplete="off" onKeyPress="return ValidateAlpha(event);">
                                                </td>
                                                <td>
                                                    <input type="text" name="Age" class="form-control" placeholder="{{translation.LoanAmount}}" ng-model="item.LoanAmount" maxlength="9" autocomplete="off" onKeyPress="return isNumber(event);">
                                                </td>
                                                <td>
                                                    <input type="text" name="MembershipNumber" class="form-control" placeholder="{{translation.MonthlyInstallment}}" maxlength="9" ng-model="item.MonthlyInstallment" autocomplete="off" onKeyPress="return isNumber(event);">
                                                </td>
                                                <td style="text-align: right !important">
                                                    <i class="fa fa-trash clsShowHide btn btn btn-xs btn-danger tooltips rowdeleteBtn" id="Remove_2" ng-if="PreLoanDetailsList.length>1" ng-click="RemovePreLoanRow($index)" style=""></i>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="4"></td>
                                                <td style="text-align:right;cursor:pointer;" ng-click="AddNewPreLoanDetails()"><i class="fa fa-plus" title="Add New"></i>{{translation.Add}}</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <div class="col-lg-12 form-group" ng-if="IsSubmiApplication && LoanDetails.status_level==1">
                                <h4 class="heading-hr ng-binding">{{translation.LoanProcessAction}}</h4>
                            </div>
                            <div class="col-lg-12" ng-if="IsSubmiApplication && LoanDetails.status_level==3">
                                <div class="table-responsive">

                                    <div class="col-lg-12">
                                        <div class="col-lg-1"><label>{{translation.Status}}</label></div>
                                        <div class="col-lg-4">
                                            <select ng-model="MemberRegistration.ProcessStatus" id="ddlblock" class="form-control" ng-init="MemberRegistration.ProcessStatus='0'">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="itemBlock in ProcessStatus | orderBy:'BLOCK_ENG'" value="{{itemBlock.status_id}}" ng-if="itemBlock.status_id==2||itemBlock.status_id==6">
                                                    {{_language =='en-us' ?  itemBlock.ProceesStatusTextEn : itemBlock.ProceesStatusTextHi}}
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-12" style="margin-top:10px;">
                                        <div class="col-lg-1"><label>{{translation.Remarks}}</label></div>
                                        <div class="col-lg-4">
                                            <textarea ng-model="MemberRegistration.Remarks" class="form-control" rows="3"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-md-12" style="margin-top:10px;" ng-show="BackBtnLast">
                                <center>
                                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="javascript:void(0);" ng-click="SowApplicationGrid()">{{translation.Back}}</a>
                                    <button type="submit" class="btn btn-primary dev-btn" ng-if="IsSubmiApplication" ng-click="SaveLoanApplication()">&nbsp;&nbsp;{{translation.Submit}}</button>
                                </center>
                            </div>
                        </div>


                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
