<script type="text/javascript">
    function OnSuccess(data) {
        $('#preloader').hide();
        if (data.UserType == 'C') {
            $('#FormPost').html(data.result);
            $('#FormPost').find('form').submit();
        }
        else {
            if (data.result == 'Sucess') {
                alert('Details Save Successful');
                window.location = "../Citizen/MemberApplicationView?ApplicationIdEnc=" + data.IdEnc;
            }
            else {
                ShowModelAlert("Society Member Registration", 'Issue in Payment Receiveing Please Try after Some time');
            }
        }
    }
    function OnFailure(data) {
        $('#preloader').hide();
        alert(JSON.stringify(data));
    }
    function OnBegin() {
        $('#preloader').show();
    }

    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode
        if (iKeyCode != 46 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57))
            return false;

        return true;
    }
    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((keyCode < 65 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32)

            return false;
        return true;
    };
    $(document).ready(function () {
        $("select").on("change", function () {
            $(this).removeClass("notValid");
        });


        $(".expandDetails").click(function () {

            var panl_id = $(this).attr("dat-val");

            if ($(this).hasClass("fa-plus-circle")) {
                $(this).removeClass("fa-plus-circle").addClass("fa-minus-circle")
            } else {
                $(this).addClass("fa-plus-circle").removeClass("fa-minus-circle")
            }
            $("#" + panl_id).slideToggle("slow");
        });

    });

    function previewFile(ths) {
        var indx = ths.id.split('_')[1];
        var preview = document.querySelector('img_' + indx);
        var file = ths.files[0];
        var reader = new FileReader();
        reader.onloadend = function () {
            $('#img_' + indx).attr("src", reader.result);
        }

        if (file) {
            reader.readAsDataURL(file);
        }
    }

</script>
