                                                        </div>

                                                        <div class="col-md-3 mt-2">
                                                            <label>Int. Subvention</label>
                                                            <input type="text" class="form-control" ng-model="PLDB.IntSubvention" placeholder="0.00" ng-required="PLDB.IsChequeDishonoured==1 && PLDB.IsChequeDishonourActionTaken==0" />
                                                        </div>

                                                        <div class="col-md-3 mt-2">
                                                            <label>Total</label>
                                                            <input type="text" class="form-control" ng-model="PLDB.ReccoveryTotalAmount"  placeholder="Total" readonly>                                                                                                                                                                                          
                                                        </div>
                                                    </div>
                                                </div>                                              
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <br />
                        </div>
                        <div class="form-group col-md-12" style="margin-top: 25px; border-top: 1px solid darkgray;    padding-top: 10px; background-color: white; padding-bottom: 10px;">
                            <center>
                                @*<a class="btn btn-primary dev-btn" id="saveBtn" ng-if="!isViewMode" style="text-transform: capitalize;" ng-if="IsSubmiApplication==true" href="javascript:void(0);" ng-click="ShowLoanApplication()">{{ translation.Back}}</a>*@                             
                                <button type="submit" class="btn btn-success" ng-if="IsSubmiApplication==false" ng-click="Save_PLDBForm(true)">&nbsp;&nbsp;{{translation.Submit}} </button>                             
                            </center>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
