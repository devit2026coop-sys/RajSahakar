                                                </div>
                                            </div>
                                            <div class="row mb-4" >
                                                <div class="col-md-12  ">
                                                    <label> if no , why</label>
                                                    <textarea type="text" class="form-control" rows="3" ng-model="PLDB.DishonourActionReason" placeholder="if no , why" ng-required="PLDB.IsChequeDishonoured==1 && PLDB.IsChequeDishonourActionTaken==0"></textarea>

                                                    <div class="mt-3">

                                                        <label> Recovery After 30-06-2025  </label>

                                                        <div class="col-md-3 mt-2">
                                                            <label>Principal Amount</label>
                                                            <input type="text" class="form-control" ng-model="PLDB.Principal" placeholder="0.00" ng-required="PLDB.IsChequeDishonoured==1 && PLDB.IsChequeDishonourActionTaken==0" />
                                                        </div>

                                                        <div class="col-md-3 mt-2">
                                                            <label>Int./P.I./Rec.Charges/Others</label>
