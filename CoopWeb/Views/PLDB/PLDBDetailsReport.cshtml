<script src="~/Scripts/AngularFramework/PLDBDetailsReport.js"></script>



<div ng-app="PLDBDetailsReportMod">
    <div ng-controller="PLDBDetailsReportCnt">
        <input type="hidden" id="hdnPLDBId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
        <input type="hidden" id="hdnBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h4 class="citizen-dash-head"> PLDB Details Report</h4>
        </div>

        <input type="hidden" id="hdnSocietyType" value="1" />
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="citizen-dash-head">
                <table class="table table-responsive devtable">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th ng-show="{{value}}=='2'">
                                BranchName_En
                            </th>
                            <th>
                                PLDBName
                            </th>
                            <th>
                                DistrictName
                            </th>

                            <th>
                                RegistrationNo
                            </th>

                            <th>
                                SocietyName
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="Item in PLDB">
                            <td>{{$index+1}}</td>
                            <td ng-show="{{value}}=='2'">
                                {{Item.BranchName_En}}
                            </td>
                            <td>
                                {{Item.PLDBName}}
                            </td>
                            <td>
                                {{Item.DistrictName}}
                            </td>
                            <td>
                                {{Item.RegistrationNo}}
                            </td>

                            <td>
                                {{Item.SocietyName}}
                            </td>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

