
@{Layout = null;}
<div class="col-lg-12 form-group">
    <h4 class="heading-hr ng-binding">{{translation.LoanAmountDetails}}<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_1" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
</div>

<div class="col-lg-12  clspanal" id="panal_1">
    <div class="table-responsive">
        <table class="table devtable" id="tblLoanAmountDetail">
            <thead>
                <tr>
                    <th>{{translation.SRNO}}</th>
                    <th>{{translation.Type}}</th>
                    <th>{{translation.Sector}}</th>
                    <th>{{translation.Scheme}}</th>
                    <th>{{translation.PurposeOfLoan}}</th>
                    <th>{{translation.LoanType}}</th>
                    <th>{{translation.EstimatedTotalAmount}}</th>
                    <th>{{translation.LoanAmountApplied}}</th>
                    <th>{{translation.PurposeOfLoan}}</th>
                    <th>{{translation.Period}}    &nbsp;(वर्ष)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in LoanAmountDetails">
                    <td>{{$index+1}}</td>
                    <td>
                        <div style="width:100%">
                            <select ng-disabled="item.IsDisableScheme" ng-model="item.Type" id="Type" class="form-control" ng-init="item.Type='0'" ng-change="ChangeLoanType(item.Type,$index)">
                                <option value="0" selected="selected">{{translation.SelectOption}}</option>
                                <option value="Farming">Farming</option>
                                <option value="NonFarming">Non-Farming</option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div style="width:100%">
                            <select ng-disabled="item.IsDisableScheme" ng-model="item.SectorId" id="sector_id" class="form-control" ng-init="item.SectorId='0'" ng-change="GetSchemeMasterBySector(item.SectorId,$index)">
                                <option value="0" selected="selected">{{translation.SelectOption}}</option>
                                <option ng-repeat="itm in item.LoanSectorList" value="{{itm.sector_id}}">
                                    {{_language =='en-us' ?  itm.sector_name_en : itm.sector_name_hi}}
                                </option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div style="width:100%">
                            <select ng-disabled="item.IsDisableScheme" ng-model="item.SchemeId" id="SchemeId" class="form-control" ng-init="item.SchemeId='0'" ng-change="LoadPurposeByShemeId(item.SchemeId,$index)">
                                <option value="0" ng-disabled="true" selected="selected">{{translation.SelectOption}}</option>
                                <option ng-repeat="itm in item.LoanSchemeList" value="{{itm.scheme_id}}">
                                    {{_language =='en-us' ?  itm.scheme_name_en : itm.scheme_name_hi}}
                                </option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div style="width:100%">
                            <select ng-model="item.PurposeOfLoan" class="form-control" ng-init="item.PurposeOfLoan='0'">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option ng-repeat="itm in item.PurposeOfLoanList" value="{{itm.purpose_id}}">
                                    {{_language =='en-us' ?  itm.purpose_name_en : itm.purpose_name_hi}}
                                </option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div style="width:100%">
                            <select ng-model="item.LoanType" class="form-control" ng-init="item.LoanType='0'">
                                <option value="0">{{translation.SelectOption}}</option>
                                <option ng-repeat="itm in LoanTypeList" value="{{itm.LovValuesId}}">
                                    {{_language =='en-us' ?  itm.LovCode : itm.Lovdescription}}
                                </option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <input type="text" style="width:100px;" id="txtEstimatedTotalAmount " name="EstimatedTotalAmount" class="form-control" placeholder="{{translation.EstimatedTotalAmount}}" ng-model="item.EstimatedTotalAmount" maxlength="10" autocomplete="off" onKeyPress="return isNumber(event);">
                    </td>
                    <td>
                        <input type="text" style="width:100px;" name="LoanAmountApplied" class="form-control" placeholder="{{translation.LoanAmountApplied}}" ng-model="item.LoanAmountApplied" maxlength="10" autocomplete="off" onKeyPress="return isNumber(event);">
                    </td>
                    <td>
                        <input type="checkbox" class="c-input ui-icon-circle-check" name="CapitalAsRequired" value="1" ng-model="item.CapitalAsRequired">{{translation.CapitalAsRequired}}
                        <input type="checkbox" name="WorkingCapital" value="2" ng-model="item.WorkingCapital">{{translation.WorkingCapital}}
                        @*{{translation.Both}} <input type="checkbox" name="Both" value="3" ng-model="item.Both" ng-change="CheckLoanAmountCapital(item)">*@
                    </td>
                    <td>
                        <input type="text" style="width:80px;" id="txtPeriod" name="Period" class="form-control" placeholder="{{translation.Period}}" ng-model="item.Period" maxlength="3" autocomplete="off" onKeyPress="return isNumber(event);">
                    </td>
                    <td style="text-align: right !important">
                        <i class="fa fa-trash clsShowHide btn btn btn-xs btn-danger tooltips rowdeleteBtn" id="Remove_1" ng-if="LoanAmountDetails.length>1" ng-click="RemoveLoanAmountRow($index)" style=""></i>
                    </td>
                </tr>
            </tbody>          
        </table>
    </div>
</div>



