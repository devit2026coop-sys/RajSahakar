

<script src="~/Scripts/AngularFramework/PLDBLoanAppDetailsReportByStatus.js"></script>

<div ng-app="PLDBLoanAppDetailsReportByStatusMod">
    <div ng-controller="PLDBLoanAppDetailsReportByStatusCnt">
        <input type="hidden" id="hdnPLDBId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
        <input type="hidden" id="hdnBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />

        <input type="hidden" id="PLDBId" value="@ViewBag.PLDBID" />
        <input type="hidden" id="PLDBbranchId" value="@ViewBag.BranchPLDBID" />

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h4 class="citizen-dash-head"> PLDB Loan Application Details</h4>
        </div>

        <input type="hidden" id="hdnSocietyType" value="1" />
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="citizen-dash-head" ng-show="false">
                <div class="col-md-2 margin-Top20" style="padding-left: 0;">
                    <label for="search">{{translation.PLDB}}</label>
                    <select ng-model="AppLoanReport.PLDB_ID" name="ddlPldbId" ng-disabled="PLDBdrop" class="form-control" ng-init="AppLoanReport.PLDB_ID=''" ng-change="PLDBBranchList()">
                        <option value="">{{translation.SelectOption}}</option>
                        <option ng-repeat="itemPLDB in PLDB | orderBy:'PldbId'" value="{{itemPLDB.PldbId}}">
                            {{itemPLDB.PLDBName}}
                        </option>
                    </select>
                </div>
                <div class="col-md-2 margin-Top20" style="padding-left: 0;">
                    <label for="search">{{translation.Branch}}</label>
                    <select ng-model="AppLoanReport.Branch_ID" name="ddlbranch" ng-disabled="PLDBbrachdrop" class="form-control" ng-init="AppLoanReport.Branch_ID=''">
                        <option value="">{{translation.SelectOption}}</option>
                        <option ng-repeat="itemBlock in PLDBBranches | orderBy:'BLOCK_ENG'" value="{{itemBlock.BLOCK_ID}}">
                            {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                        </option>
                    </select>
                </div>
                <div class="col-md-2 margin-Top20" style="padding-left: 0;">
                    <input type="button" class="btn btn-primary" name="name" style="margin-top: 24px;" value="Search" ng-click="GetTotalPLDBData(AppLoanReport.PLDB_ID,AppLoanReport.Branch_ID)" />
                </div>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="citizen-dash-head">
                <div class="col-lg-12" style="margin-bottom: 9px;padding-left: 0px;"><span style="font-size:20px;">{{PLDBName}}</span> <span style="font-size:20px;" ng-if="BranchName!=''">, {{BranchName}}</span></div>
                <br />
                <table class="table table-responsive devtable" ng-if="ShowPLDBWise">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                PLDB Name
                            </th>
                            <th>
                                Total Application
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="Item in PLDBDataList">
                            <td>{{$index+1}}</td>
                            <td>
                                {{Item.PLDBName}}
                            </td>
                            <td>
                                {{Item.TotalCount}}
                            </td>
                            <th><a href="javascript:void(0);" ng-click="ShowBranchDetails(Item.PldbId,Item.PLDBName)">View Details</a></th>
                    </tbody>
                    <tr>
                        <td colspan="4">
                            <button type="submit" class="btn btn-primary dev-btn" ng-click="GoBack(1)">{{translation.Back}}</button>
                            <button type="submit" class="btn btn-primary dev-btn" ng-click="ExportDataPLDBDetails()">{{translation.ExportToExcel}}</button>
                        </td>
                    </tr>
                </table>
                <table class="table table-responsive devtable" ng-if="ShowBranchWise">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                Branch Name
                            </th>
                            <th>
                                Total Application
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="Item in BranchDataList">
                            <td>{{$index+1}}</td>
                            <td>
                                {{Item.BranchName_En}}
                            </td>
                            <td>
                                {{Item.TotalCount}}
                            </td>
                            <th><a href="javascript:void(0);" ng-click="ShowDetails(Item.BranchId,Item.BranchName_En)">View Details</a></th>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <button type="submit" class="btn btn-primary dev-btn" ng-click="GoBack(2)">{{translation.Back}}</button>
                                <button type="submit" class="btn btn-primary dev-btn" ng-click="ExportDataBranchDetails()">{{translation.ExportToExcel}}</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-responsive devtable" ng-if="ShowDetailsWise">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                {{translation.ApplicationNo}}
                            </th>
                            <th>
                                {{translation.MemberName}}
                            </th>
                            <th>
                                {{translation.NameOfFather}}
                            </th>
                            <th>
                                {{translation.PLDB}}
                            </th>
                            <th>
                                {{translation.Branch}}
                            </th>
                            <th>
                                {{translation.SubmissionDate}}
                            </th>
                            <th>
                                {{translation.Status}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in PLDBStatusData">
                            <td>{{$index+1}}</td>
                            <td>{{item.application_no}}</td>
                            <td>{{item.MemberName}}</td>
                            <td>{{item.FatherName}}</td>
                            <td>{{item.PLDBName}}</td>
                            <td>{{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}</td>
                            <td>{{item.FormatedDate}}</td>
                            <td>{{_language =='en-us' ?  item.ProceesStatusTextEn : item.ProceesStatusTextHi}}</td>
                        </tr>
                        <tr>
                            <td colspan="8">
                                <button type="submit" class="btn btn-primary dev-btn" ng-click="GoBack(3)">{{translation.Back}}</button>
                                <button type="submit" class="btn btn-primary dev-btn" ng-click="ExportDataDetails()">{{translation.ExportToExcel}}</button>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

