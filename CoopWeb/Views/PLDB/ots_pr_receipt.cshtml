@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" ng-app="OTSPreLoanReceiptModule" ng-controller="OTSPreLoanReceiptCont" ng-cloak="">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{CurrentPaymentSummaryList[0].ReceiptNo}}</title>
    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/jquery-3.1.0.js"></script>
    <script src="~/Scripts/dirPagination.js"></script>
    <script src="~/Scripts/AngularFramework/OtsPreLoanReceipt.js?id=1"></script>

    <style>
        * {
            font-size: 12px;
            line-height: 1.5;
        }
        table { 
            width: 100%;
        }

        .pdf-table {
            width: 740px;
            padding: 20px 50px;
            background: #ffffff;
        }
    </style>
</head>
<body style="background:#808080">
    <div ng-cloak="" style="display:flex;justify-content:center">
        <section class="pdf-table">
            <table>
                <tbody>
                    <tr>
                        <td width="100">
                            <img src="../Content/Images/cm-ots-logo.png" alt="" width="90" />
                        </td>
                        <td>
                            <p style="text-align: center; font-weight: 800; font-size: 22px;width:100%;">
                                प्राथमिक सहकारी भूमि विकास बैंक लि. {{ApplicantDetails.PLDBNameHi}}
                                <br>शाखा {{ApplicantDetails.BranchNameHi}}
                            </p>
                        </td>
                        <td align="right" width="100">
                            <img src="../Content/Images/iyc_logo.png" alt="" width="90" />
                        </td>
                    </tr>
                </tbody>
            </table>
            <table>
                <tbody>
                    <tr>
                        <td colspan="2">दिनांक : <span style="font-size:15px;">{{CurrentPaymentSummaryList[0].PaymentDate | date:'dd/MM/yyyy'}}</span></td>
                        <td style="padding: 10px 0;white-space:nowrap" align="right">रसीद नं. : {{CurrentPaymentSummaryList[0].ReceiptNo}}</td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <p style="font-size: 15px;font-weight: 500;line-height: 35px; text-transform:uppercase">
                                श्री/श्रीमती/सुश्री <b style="font-size:15px;">{{ApplicantDetails.ApplicantName}}</b> पुत्र/पुत्री/पति/पत्नी <b style="font-size:15px;">{{ApplicantDetails.FatherHusbandName}}</b><br />
                                ग्राम {{ApplicantDetails.VName}} तहसील {{ApplicantDetails.TehsilName}} जिला {{ApplicantDetails.DistrictName}}<br />
                                खाता सं. <b style="font-size:15px;">{{ApplicantDetails.LoanAccNo}}</b> ऋण उद्देश्य {{ApplicantDetails.Purpose}} से कुल राशि रू.
                                <b>
                                    <u style="font-size:15px;">{{CurrentPaymentSummaryList[0].PaidAmount}}/-</u>
                                </b> अक्षरे रु. <b><u style="font-size:15px;">{{CurrentPaymentSummaryList[0].PaidAmountInWord}}</u></b>
                                <strong style="font-size:15px;">आंशिक</strong> वसूली पेटे प्राप्त किए।
                            </p>
                        </td>
                    </tr>
                </tbody>
            </table>
            <br />
            <table border="1" cellpadding="2" cellspacing="0" ng-show="OldPaymentSummaryList.length>0">
                <caption style="text-align:center;padding-bottom:20px;">योजनान्तर्गत पूर्व में जमा करवाई गई राशि का विवरण</caption>
                <thead>
                    <tr>
                        <th>क्रमांक</th>
                        <th>रसीद नं.</th>
                        <th>भुगतान का तरीका</th>
                        <th>जमा की गई राशि</th>
                        <th>यूटीआर / संदर्भ संख्या</th>
                        <th>जमा करने की तिथि</th>
                        <th>जमा कराने वाला व्यक्ति</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat=" item in OldPaymentSummaryList">
                        <td align="center">{{$index + 1}}</td>
                        <td>{{item.ReceiptNo}}</td>
                        <td align="center">{{item.PaymentMode}}</td>
                        <td align="center">{{item.PaidAmount1}}</td>
                        <td>{{item.UTR_RefNo}}
                            <div ng-show="item.PaymentModeId==2">
                                Cheque No: {{item.ChequeNo}}
                                Cheque Date: {{item.ChequeDate|date:'dd-MM-yyyy'}}
                                Remark: {{item.ChequeOther}}
                            </div>
                        </td>
                        <td>{{item.PaymentDate | date:'dd/MM/yyyy'}}</td>
                        <td>{{item.DepositByPerson}}</td>
                    </tr>
                </tbody>
            </table>
            <br />
            <img height="100" width="100" src="{{QrData}}" />
            <p style="font-size:10px; text-align:center">This is a system generated receipt, no signature is required./यह सिस्टम द्वारा जनरेटेड रसीद है, इसमें हस्ताक्षर की आवश्यकता नहीं है।</p>
        </section>
    </div>
    <script>
        setTimeout(function () { window.print(); }, 2000)
    </script>
</body>
</html>
