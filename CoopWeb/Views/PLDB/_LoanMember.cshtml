
@{Layout = null;}

<div class="col-lg-12 form-group">
    <h4 class="heading-hr ng-binding">आवेदक का विवरण <a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_2" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
</div>
<div class="col-lg-12 clspanal" id="panal_2" style="margin-top: 10px;">
    <div ng-repeat="item in LoanMembers">
        <div class="col-lg-1" style="width:5px;">{{($index+1)}}</div>
        <div class="col-lg-11" style="width: 98%;">
            <div class="row" style="margin-top:5px;">
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        आधार संख्या<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" ng-if="!item.IsValidate" id="AADHARNo_{{$index}}" name="MembershipNumber" class="form-control" placeholder="{{translation.AADHARNo}}" ng-model="item.AADHARNo" autocomplete="off" onKeyPress="return isNumber(event);">
                        <input type="text" ng-if="item.IsValidate" ng-disabled="true" name="MembershipNumber" class="form-control" placeholder="{{translation.AADHARNo}}" value="{{item.AADHARNo}}" autocomplete="off" onKeyPress="return isNumber(event);">
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-5">
                        बैंक की सदस्य संख्या<span class="mad">*</span>
                    </div>
                    <div class="col-lg-7">
                        <input type="text" ng-if="!item.IsValidate" id="MembershipNumber_{{$index}}" name="MembershipNumber" class="form-control" placeholder="{{translation.MembershipNumber}}" ng-model="item.MembershipNumber" autocomplete="off" onKeyPress="return isNumber(event);">
                        <input type="text" ng-if="item.IsValidate" ng-disabled="true" name="MembershipNumber" class="form-control" placeholder="{{translation.MembershipNumber}}" value="{{item.MembershipNumber}}" autocomplete="off" onKeyPress="return isNumber(event);">
                    </div>
                </div>
                <div class="col-lg-3">
                    <button type="submit" class="btn btn-primary dev-btn ng-binding ng-scope" ng-if="!item.IsValidate" ng-click="GetMemberDetails(item.AADHARNo,item.MembershipNumber,$index)">{{translation.SearchMember}}</button>
                    <button ng-if="(item.IsValidate || LoanMembers.length>1)&&IsSubmiApplication==false" type="submit" class="btn btn-primary dev-btn ng-binding ng-scope validateMemberBTN" ng-click="RemoveMemberRow($index)">{{translation.DeleteRow}}</button>
                </div>
            </div>
        </div>
        <br />
        <div class="col-lg-1" style="width:5px;"></div>
        <div class="col-lg-11" style="width: 98%;">
            <div class="row" style="margin-top:5px;" ng-if="item.IsShow">
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        आवेदक का पूरा नाम<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" name="Name" ng-disabled="true" class="form-control" placeholder="{{translation.Name}}" title="{{item.Name}}" value="{{item.Name}}" autocomplete="off" onKeyPress="return ValidateAlpha(event);">
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-5">
                        पिता/पति का नाम<span class="mad">*</span>
                    </div>
                    <div class="col-lg-7">
                        <input type="text" name="FatherName" ng-disabled="true" class="form-control" title="{{item.FatherName}}" placeholder="पिता/पति का नाम" value="{{item.FatherName}}" autocomplete="off" onKeyPress="return ValidateAlpha(event);">
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        आयु<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" name="Age" ng-disabled="true" style="" class="form-control" placeholder="{{translation.Age}}" value="{{item.Age}}" maxlength="2" autocomplete="off" onKeyPress="return isNumber(event);">
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        जाती<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" name="Category" ng-disabled="true" class="form-control" tite="{{item.CategoryId}}" style="" placeholder="{{translation.Category}}" value="{{item.CategoryId}}" maxlength="2" autocomplete="off" onKeyPress="return isNumber(event);">
                    </div>
                </div>
            </div>
            <div class="row" style="margin-top:5px;" ng-if="item.IsShow">
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        वर्त्तमान में सेवा /व्यवसाय<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" class="form-control" id="BusinessName_{{$index}}" maxlength="100" placeholder="वर्त्तमान में सेवा /व्यवसाय" ng-model="item.Business" onKeyPress="return isAlphaNumeric(event);" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-5">
                        निवास /व्यवसाय  स्थल का पूर्ण पता<span class="mad">*</span>
                    </div>
                    <div class="col-lg-7">
                        <textarea type="text" rows="1" id="BusinessAddress_{{$index}}" maxlength="100" class="form-control" placeholder="निवास /व्यवसाय  स्थल का पूर्ण पता" ng-model="item.BusinessAddress" onKeyPress="return isAlphaNumeric(event);"></textarea>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        स्थाई निवास का पूर्ण पता<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <textarea type="text" rows="1" class="form-control" maxlength="100" id="PermanentAddress_{{$index}}" placeholder="स्थाई निवास का पूर्ण पता " ng-model="item.PermanentAddress" onKeyPress="return isAlphaNumeric(event);"></textarea>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        टेलीफोन निवास<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" class="form-control" maxlength="15" id="MobileNo_{{$index}}" placeholder="टेलीफोन निवास" ng-model="item.MobileNo" onKeyPress="return isNumber(event);" />
                    </div>
                </div>
            </div>
            <div class="row" style="margin-top:5px;" ng-if="item.IsShow">
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        टेलीफोन व्यवसाय<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" class="form-control" maxlength="15" id="OfficeMobileNo_{{$index}}" placeholder="टेलीफोन व्यवसाय" ng-model="item.OfficeMobileNo" onKeyPress="return isNumber(event);" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-5">
                        आवेदक की शेक्षणिक योग्यता<span class="mad">*</span>
                    </div>
                    <div class="col-lg-7">
                        <textarea type="text" rows="1" ng-disabled="true" maxlength="150" id="Education_{{$index}}" class="form-control" placeholder="आवेदक की शेक्षणिक योग्यता" ng-model="item.Education" onKeyPress="return isAlphaNumeric(event);"></textarea>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        आवेदक की मासिक आय<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" class="form-control" maxlength="10" id="MonthlyIncome_{{$index}}" placeholder="आवेदक की मासिक आय" onKeyPress="return isNumber(event);" ng-model="item.MonthlyIncome" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        परिवार के आश्रितों की संख्या<span class="mad">*</span>
                    </div>
                    <div class="col-lg-6">
                        <input type="text" class="form-control" maxlength="2" id="FamilyDependents_{{$index}}" placeholder="परिवार के आश्रितों की संख्या" ng-model="item.FamilyDependents" onKeyPress="return isNumber(event);" />
                    </div>
                </div>
            </div>
            <div class="row" style="margin-top:5px;" ng-if="item.IsShow">
                <div class="col-lg-3">
                    <div class="col-lg-6">
                        परिवार के जीवनोपार्जन  हेतु प्रतिमाह न्यूनतम राशि  की आवश्यकता
                    </div>
                    <div class="col-lg-6">
                        <input type="text" class="form-control" maxlength="10" placeholder="परिवार के जीवनोपार्जन  हेतु प्रतिमाह न्यूनतम राशि  की आवश्यकता" onKeyPress="return isNumber(event);" ng-model="item.MonthlyMinimumAmountForLiving" />
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="row" ng-if="LoanMembers[LoanMembers.length-1].IsValidate">
        <table class="table devtable" style="border: 0px;margin: 0px;">
            <tfoot>
                <tr>
                    <td style="text-align:right;cursor:pointer;padding-right: 35px;"><i ng-click="AddNewMember()" class="fa fa-plus" title="Add New"></i>{{translation.Add}}</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>



