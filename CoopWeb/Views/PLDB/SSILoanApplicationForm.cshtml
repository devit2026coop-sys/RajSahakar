                    </div>
                    <div class="col-lg-2">{{translation.RateOfInterest}}<span class="error">*</span></div>
                    <div class="col-lg-2">
                        <input id="txtRateOfInterest" name="RateOfInterest" class="form-control" placeholder="{{translation.RateOfInterest}}" ng-model="MemberRegistration.RateOfInterest" maxlength="5" onkeypress='return isNumber(event);' autocomplete="off">
