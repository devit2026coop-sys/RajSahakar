@{ Layout = null;}

    <div class="col-lg-12 form-group">
        <h4 class="heading-hr ng-binding">{{translation.DescriptionOfIndustry}} <a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_13" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
    </div>

    <div class="col-lg-12 clspanal" id="panal_13">
        <div class="table-responsive">
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.RegistrationNumber}} <span class="error">*</span></div>
                <div class="col-lg-2">
                    <input type="text" class="form-control" name="RegistrationNumber" placeholder="पंजीयन संख्या" maxlength="25" ng-model="MemberRegistration.RegistrationNumber" id="RegistrationNumber" onkeypress="" autocomplete="off" />
                </div>
            </div>
            @*Small Industry Registration*@
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.SmallIndustryRegistration}}</div>
                <div class="col-lg-2">
                    <input type="radio" style="margin-bottom: 17px;" name="Registration" ng-model="MemberRegistration.Isregistration" value="Yes" ng-change="ClearIsregistration()">{{translation.Yes}}
                    <input type="radio" style="margin-bottom: 17px;" name="Registration" ng-model="MemberRegistration.Isregistration" value="No" ng-change="ClearIsregistration()">{{translation.No}}
                </div>
                <div class="col-lg-8" ng-show="MemberRegistration.Isregistration=='Yes'">
                    <div class="col-lg-12">
                        <div class="col-lg-2">{{translation.RegistrationName}} <span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" class="form-control" name="RegistrationName" placeholder="पंजीकरण नाम" ng-model="MemberRegistration.RegistrationName" id="RegistrationName" onkeypress='return ValidateAlpha(event);' autocomplete="off">
                        </div>
                        <div class="col-lg-2">{{translation.RegistrationDate}}<span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input name="Date" class="form-control devcalender" placeholder="{{translation.RegistrationDate}}" id="RegistrationDate" ng-model="MemberRegistration.RegistrationDate" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>

            @*Date of establishment if the unit is already operational*@
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.DateOfEstablishment_IfUnitAlreadyOperational}}</div>
                <div class="col-lg-2">
                    <input type="radio" style="margin-bottom: 17px;" name="DateOfEstablishment" value="Yes" ng-model="MemberRegistration.IsDateOfEstablishment" ng-change="ClearIsDateOfEstablishment()">{{translation.Yes}}
                    <input type="radio" style="margin-bottom: 17px;" name="DateOfEstablishment" value="No" ng-model="MemberRegistration.IsDateOfEstablishment" ng-change="ClearIsDateOfEstablishment()">{{translation.No}}
                </div>
                <div class="col-lg-8" ng-show="MemberRegistration.IsDateOfEstablishment=='Yes'">
                    <div class="col-lg-12">
                        <div class="col-lg-2">{{translation.DateOfEstablishment}} <span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input id="DateOfEstablishment" name="DateOfEstablishment" ng-model="MemberRegistration.DateOfEstablishment" class="form-control devcalender" placeholder="{{translation.DateOfEstablishment}}" onkeypress="return event.charCode >= 48 &amp;&amp; event.charCode <= 57" autocomplete="off">
                        </div>
                        <div class="col-lg-6">
                        </div>
                    </div>
                </div>
            </div>

            @*Address*@
            <div class="col-lg-12 form-group">
                <div class="col-lg-2">{{translation.Address}}<span class="error">*</span></div>
                <div class="col-lg-2">
                    <input type="radio" style="margin-bottom: 17px;" name="AddressType" value="Self" ng-model="MemberRegistration.AddressType" ng-change="ClearAddress()"> {{translation.Self}}
                    <input type="radio" style="margin-bottom: 17px;" name="AddressType" value="Rental" ng-model="MemberRegistration.AddressType" ng-change="ClearAddress()">{{translation.Rental}}
                    <input type="radio" style="margin-bottom: 17px;" name="AddressType" value="IsRico" ng-model="MemberRegistration.AddressType" ng-change="ClearAddress()">{{translation.Rico}}
                </div>
                <div class="col-lg-8" ng-show="MemberRegistration.AddressType=='Rental'">
                    <div class="col-lg-12">
                        <div class="col-lg-2">{{translation.OwnerName}} <span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" id="txtOwnerName" name="OwnerName" placeholder="{{translation.OwnerName}}" class="form-control" ng-model="MemberRegistration.OwnerName" onkeypress='return ValidateAlpha(event);' autocomplete="off">
                        </div>
                        <div class="col-lg-2" style="text-align: center;">{{translation.Address}} <span class="error">*</span></div>
                        <div class="col-lg-4">
                            <textarea type="text" rows="1" id="txtOwnerAddress" name="OwnerAddress" placeholder="{{translation.Address}}" class="form-control" ng-model="MemberRegistration.OwnerAddress" onkeypress="" autocomplete="off"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*Other Details*@
    <div class="col-lg-12 form-group">
        <h4 class="heading-hr ng-binding">{{translation.OtherDetails}}<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_14" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
