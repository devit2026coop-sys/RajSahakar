@{
    ViewBag.Title = "OTS 2025-26 Application List";
}
<script src="~/Scripts/AngularFramework/OTSApplicationList.js?v=1.13"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />

<style>
    .inputapi-transliterate-indic-suggestion-menu {
        z-index: 99999 !important;
        display: block;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td {
        padding: 1px;
        padding-right: 5px;
        padding-left: 5px;
    }
</style>
<div ng-app="ApplicationFlowModule" ng-controller="ApplicationFlowCont" ng-cloak="">
    <div>
        <div class="col-md-12">
            <h3 class="citizen-dash-head ng-binding" style="margin-top:0px;">{{translation.OtsApplicationList}}</h3>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> {{translation.OtsApplicationList}} </span>
                    </li>

                </ul>
            </div>
        </div>
        <div style="margin-top:30px;padding-top:30px">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown" id="search-filter" style="margin-bottom: 5px;">
                        <div class="col-lg-12" style="margin-bottom: 5px; padding-left: 0;">
                            <input type="hidden" id="hdnRoleId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId)" />
                            <input type="hidden" id="hdnDistrictId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).DistrictId)" />
                            <input type="hidden" id="hdnPldbId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
                            <input type="hidden" id="hdnPldbBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />

                            <div class="col-md-2 margin-Top20" style="padding-left: 0;" id="ddrDistrictId">
                                <label>{{ translation.DistrictHeading}}:</label>
                                <select name="DISTRICT_ID" ng-model="DISTRICT_ID" class="form-control" ng-change="PLDBListData('0')">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="district in DistrictList" value="{{district.DISTRICT_ID}}">
                                        {{_language =='en-us' ?  district.DISTRICT_ENG : district.DISTRICT_MANGAL}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-lg-2 margin-Top20" style="padding-left: 0;" id="ddlPLDBID">
                                <label for="PLDB_ID">{{ translation.PLDB}} </label>
                                <select id="PLDB_ID" name="PLDB_ID" ng-model="PLDB_ID" class="form-control" ng-init="PLDB_ID='0'" ng-change="PLDBBranchList('0')">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="itemPLDB in PLDBList  track by itemPLDB.PldbId " value="{{itemPLDB.PldbId}}">
                                        {{itemPLDB.PLDBName}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-lg-2 margin-Top20" style="padding-left: 0;" id="ddlPldbBranchID">
                                <label for="PLDB_Branch_ID">{{ translation.Branch}}</label>
                                <select ng-model="PLDB_Branch_ID" name="PLDB_Branch_ID" id="PLDB_Branch_ID" class="form-control" ng-init="PLDB_Branch_ID='0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="itemBlock in PLDBBranches " value="{{itemBlock.BLOCK_ID}}">
                                        {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-2 margin-Top20" style="padding-left: 0;" id="ddrStatus">
                                <label>{{ translation.Status}}:</label>
                                <select name="StatusId" ng-model="StatusId" class="form-control" ng-change="searchRequest(GetOTSList)">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option ng-repeat="sts in StatusList" value="{{sts.OtsProcessStatusId}}">
                                        {{_language =='en-us' ?  sts.Status : sts.Status}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" name="SearchText" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            @*<div class="col-md-1">
                                <label for="search">Land Mortgage</label>
                                <select name="IsLandMortgaged" ng-model="IsLandMortgaged" class="form-control" ng-change="searchRequest(GetOTSList)">
                                    <option value="">{{translation.SelectOption}}</option>
                                    <option value="Y">Yes</option>
                                    <option value="N">No</option>
                                </select>
                            </div>*@
                            <div class="col-md-1">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="1000" class="form-control" ng-model="pageSize">
                            </div>
                            <div class="col-lg-12" style="margin-top: 10px;padding-left: 0px;" ng-init="Cases103='B'">
                                <div>
                                    <label><input type="radio" value="NC" name="ApplicationStatus" ng-model="Cases103" ng-click="searchRequest(GetOTSList)">Normal Cases</label>
                                    <label><input type="radio" value="103C" name="ApplicationStatus" ng-model="Cases103" ng-click="searchRequest(GetOTSList)">103 Cases</label>
                                    <label><input type="radio" value="B" name="ApplicationStatus" ng-model="Cases103" ng-click="searchRequest(GetOTSList)" checked>Both</label>
                                </div>
                            </div>
                            <div class="col-md-4 margin-Top20">
                                <label>&nbsp;</label><br>
                                <button type="button" ng-click="searchRequest(GetOTSList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                                <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                            </div>
                            <div class="col-md-8 margin-Top20" style="text-align:right">
                                <label>&nbsp;</label><br>
                                <button type="button" class="btn btn-primary" ng-show="chkBulkSelected" ng-click="DownloadMultipleOTSForm()">{{translation.Download}}</button>
                            </div>
                        </div>
                    </div>
                    <div style="overflow-x: auto;">
                        <table class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th>
                                        {{translation.SRNO}}
                                        <input type="checkbox" ng-model="CheckedAll" ng-change="CheckedAllOTS()">
                                    </th>
                                    <th ng-click="sortData('ApplicantName')">
                                        {{translation.ApplicantName}}
                                        <div ng-class="getSortClass('ApplicantName')"></div>
                                    </th>
                                    <th style=" min-width: 125px;">
                                        {{translation.Notice}}
                                    </th>
                                    <th style=" min-width: 125px;">
                                        {{translation.PLDB}}
                                    </th>
                                    <th style=" min-width: 125px;">
                                        {{translation.Branch}}
                                    </th>
                                    <th>
                                        {{translation.MobileNo}}
                                    </th>
                                    <th>
                                        Loan Account No @*{{translation.BankAccountNo}}*@
                                    </th>
                                    <th>
                                        {{translation.Sector}}
                                    </th>
                                    @*<th>
                                            {{translation.PurposeOfLoan}}
                                        </th>*@
                                    <th>
                                        {{translation.DateOfFirstDisbursement}}
                                    </th>
                                    <th>Released Land Area (Ha.)</th>
                                    <th>
                                        {{translation.LoanSanctionAmt}}
                                    </th>
                                    @*<th>
                                        Pending Level
                                    </th>*@
                                    <th>
                                        Certificate
                                    </th>
                                    <th>
                                        {{translation.Notice}}/
                                        {{translation.Taamili}}
                                    </th>
                                    <th>
                                        {{translation.Actions}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="OTS in OTSList">
                                    <td>
                                        {{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}
                                        <input type="checkbox" ng-model="OTS.selected" ng-change="toggleSelection(OTS)">

                                    </td>
                                    <td style="text-transform:uppercase;">
                                        <b> <i>{{OTS.ApplicantName }}</i></b><br />

                                        {{OTS.FatherHusbandName}}
                                    </td>
                                    <td>{{OTS.NoticeNo}}  </td>
                                    <td>{{OTS.PLDBName}}  </td>
                                    <td>{{OTS.PLDBBranch }}</td>
                                    <td>{{OTS.MobileNo }}</td>
                                    <td>{{OTS.LoanAccNo }}</td>
                                    <td>{{OTS.Sector }}</td>
                                    @*<td>{{OTS.Purpose }}</td>*@
                                    <td>{{OTS.DateOfFirstDisbursement |date:'dd-MM-yyyy'}}</td>
                                    <td>{{ OTS.ReleasedLandAreaHectare || '' }}</td>
                                    <td>{{OTS.LoanSanctionAmt |inrCurrency}}</td>
                                    @*<td>
                                        <span ng-show="OTS.PendingLevel.length>20">
                                            <a ng-show="OTS.IsNormalCase==0" target="_blank" href="~/Content/OTS/MutationDoc/{{OTS.PendingLevel}}" class="btn btn-sm btn-primary text-white"><i class="fa fa-eye text-white"></i>  Mutation Doc</a>
                                            <a ng-show="OTS.IsNormalCase==1" target="_blank" href="~/Content/OTS/MutationDoc/{{OTS.PendingLevel}}" class="btn btn-sm btn-primary text-white"><i class="fa fa-eye text-white"></i>  Mortgage Doc</a>
                                        </span>
                                        <span ng-show="OTS.PendingLevel.length<20">
                                            {{OTS.PendingLevel}}
                                        </span>
                                    </td>*@
                                    <td>
                                        <a ng-show="OTS.CertificateFile!=null && OTS.CertificateFile!=''" target="_blank" href="~/Content/OTS/{{OTS.CertificateFile}}" class="btn btn-sm btn-success text-white"><i class="fa fa-eye text-white"></i>  View Certificate</a>
                                    </td>
                                    <td style="width: 220px;">
                                        <a ng-show="OTS.TaamilDoc_New!=null && OTS.TaamilDoc_New!=''" target="_blank" href="~/Content/OTS/AcceptanceLetterNew/{{OTS.TaamilDoc_New}}" class="btn btn-sm btn-primary text-white"><i class="fa fa-eye text-white"></i>  View</a>
                                        <a ng-show="OTS.OtherDoc_New!=null && OTS.OtherDoc_New!=''" target="_blank" href="~/Content/OTS/AcceptanceLetterNew/{{OTS.OtherDoc_New}}" class="btn btn-sm btn-warning text-white"><i class="fa fa-eye text-white"></i>  Selfie</a>
                                        @*<a class="btn btn-sm btn-primary dev-btn" ng-show="OTS.Status!=5" title="Upload Taamil" href="../PLDB/PldbTaamil?otsEncId={{OTS.EncPldbOtsSchemeId}}" target="_blank"><i class="fa fa-upload text-white"></i> Upload</a>*@
                                        <a class="btn btn-sm btn-primary dev-btn" ng-show="OTS.Status!=5" title="Upload Taamil" href="../PLDB/PldbTaamilNew?otsEncId={{OTS.EncPldbOtsSchemeId}}" target="_blank"><i class="fa fa-upload text-white"></i> Upload</a>
                                    </td>
                                    <td>
                                        <div style="display:flex;gap:5px;">
                                            @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10188 ||
                                                ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10189)
                                            {
                                                <a ng-show="OTS.Status<2 && OTS.Status!=5 && NotShowing == true" class="btn btn-sm btn-success" title="Make Payment" href="../PLDB/PldbPrLoanPayment?otsEncId={{OTS.EncPldbOtsSchemeId}}" target="_blank">PR Payment</a>
                                                <a ng-show="OTS.Status>1 && OTS.Status!=5 && NotShowing == true" class="btn btn-sm btn-success" title="Make FR Receipt" href="../PLDB/PldbFinalLoanPayment?otsEncId={{OTS.EncPldbOtsSchemeId}}" target="_blank">FR Receipt</a>
                                            }
                                            @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10188 ||
                                                ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10064 ||
                                                ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10189
                                                )
                                            {
                                                <a ng-show="OTS.Status==3" class="btn btn-sm btn-success" title="Generate Certificate" href="../PLDB/PldbFinalLoanPayment?otsEncId={{OTS.EncPldbOtsSchemeId}}" target="_blank">Generate Certificate</a>
                                                <a class="btn btn-sm btn-primary" ng-show="OTS.Status<3" title="EDIT" href="../PLDB/OTSApplicationForm?eId={{OTS.EncPldbOtsSchemeId}}" target="_blank"><i class="fa fa-edit text-white"></i></a>
                                            }
                                            <a class="btn btn-sm btn-primary" title="View" href="../PLDB/OTSApplicationForm?eId={{OTS.EncPldbOtsSchemeId}}&mode=v" target="_blank"><i class="fa fa-eye text-white"></i></a>

                                            <a class="btn btn-sm btn-primary" title="Edit Pending level info" href="javascript:void(0)" ng-click="openLevelModal(OTS)"><i class="fa fa-file-text text-white"></i></a>
                                            @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10235 ||
                                                                                            ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10236)
                                            {
                                                @*<a class="btn btn-sm btn-primary" title="Case not Mortgage" href="javascript:void(0)" ng-click="openCaseNotMortgageModal(OTS)"><i class="fa fa-file-zip-o text-white"></i></a>*@
                                            }
                                            <button ng-click="downloadFile(OTS)" title="Download Notice" class="btn btn-sm btn-warning"> <i class="fa fa-download text-white"></i></button>
                                            @*<a class="btn btn-sm btn-primary" title="NI Act Detail" href="../PLDB/NIActDetail?otsEncId={{OTS.EncPldbOtsSchemeId}}" target="_blank">NI Act Detail</a>*@
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages > 1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetOTSList)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetOTSList)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetOTSList)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetOTSList)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetOTSList)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="pendingLevelModal" class="modal fade" role="dialog" style="color:#444;" data-backdrop="static">
            <div class="modal-dialog" style="min-width:500px;max-width:800px;">
                <div class="modal-content">
                    <div class="modal-header">
                        <b class="text-info">बंधक विवरण के लिए लंबित स्तर संपादित करें</b>
                        <a data-dismiss="modal" class="pull-right"><i class="fa fa-times"></i></a>
                    </div>
                    <div class="modal-body" style="display:grid;">
                        <form id="pendingLevelForm" ng-submit="SavePendingLevelData()">
                            <div id="otherDetails">
                                <div class="col-md-12">
                                    <div class="row" ng-show="PLDB.IsNormalCase==0">
                                        <div class="col-sm-6">
                                            <div class="form-group ">
                                                <label for="PendingLevel"> धारा 103 के तहत लम्बित स्तर</label>
                                                <select id="PendingLevel" ng-model="PLDB.PendingLevelId" class="form-control pending-level" ng-disabled="allDisable">
                                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                                    <option ng-repeat="li in PendingLevelList track by li.OtsPendingLevelId" value="{{li.OtsPendingLevelId}}" ng-selected="li.OtsPendingLevelId==PLDB.PendingLevelId">
                                                        {{li.Name}}
                                                    </option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group col-sm-6" ng-show="PLDB.PendingLevelId==6">
                                            <label for="MutationNo">नामान्तरण सं.</label>
                                            <input type="text" class="form-control mutation-no" id="MutationNo" ng-model="PLDB.MutationNo" ng-disabled="allDisable" placeholder="नामान्तरण सं." autocomplete="off">
                                        </div>
                                        <div class="form-group col-sm-6" ng-show="PLDB.PendingLevelId==6">
                                            <label for="MutationDate">दिनांक</label>
                                            <input type="date" class="form-control mutation-date" id="MutationDate" ng-model="PLDB.MutationDate" ng-disabled="allDisable" autocomplete="off">
                                        </div>
                                        <div class="col-sm-6 form-group" ng-show="PLDB.PendingLevelId==6">
                                            <label>दस्तावेज़ (जमाबंदी)<span class="error">(max 5MB)</span>:</label>
                                            <div ng-show="PLDB.MutationDocument!=null && PLDB.MutationDocument!=''">
                                                <a href="~/Content/OTS/MutationDoc/{{PLDB.MutationDocument}}" class="btn btn-primary dev-btn" target="_blank">देखें</a>
                                            </div>
                                            <div ng-show="PLDB.MutationDocument==null || PLDB.MutationDocument==''">
                                                <input type="file" accept=".pdf" class="form-control mutation-doc" checkmaxsize="5120" multiple onchange="angular.element(this).scope().FileUploader(this.files,'MutationDocument')" />
                                                <input type="hidden" ng-model="PLDB.MutationDocument" id="MutationDocument" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" ng-show="PLDB.IsNormalCase==1">
                                        <div class="form-group col-md-12">
                                            <label> योजना का लाभ लेने के उपरान्त रहनमुक्त की गई भूमि का क्षेत्रफल (हेक्टेयर में) </label>
                                            <input type="number"  class="form-control"  ng-model="PLDB.ReleasedLandAreaHectare"  placeholder="रहनमुक्त भूमि का क्षेत्रफल (हेक्टेयर में)"  step="0.0001"  min="0"  ng-disabled="allDisable" autocomplete="off" />
                                        </div>
                                        <div class="col-md-12">
                                            <label>क्या ऋण नीति अनुसार भूमि बैंक पक्ष में रहन दर्ज आवश्यक हैं?</label>
                                            <div style="display:inline-flex;min-width:400px;">
                                                <label> <input type="radio" name="IsMortgageMandatory" class="ml-mortgage-mandatory" value="1" ng-model="PLDB.IsMortgageMandatory" /> हाँ</label>
                                                <label> <input type="radio" name="IsMortgageMandatory" class="ml-mortgage-mandatory" value="0" ng-model="PLDB.IsMortgageMandatory" /> नहीं</label>
                                            </div>
                                            <div class="row" ng-show="PLDB.IsMortgageMandatory==1">

                                                <div class="form-group col-md-6">
                                                    <label for="MLPendingLevel">रहन से वंचित लम्बित स्तर</label>
                                                    <select id="MLPendingLevel" ng-model="PLDB.LandMortgagedPendingLevelId" class="form-control ml-pending-level" ng-disabled="allDisable">
                                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                                        <option ng-repeat="li in MLPendingLevelList" value="{{li.OtsPendingLevelId}}">
                                                            {{li.Name}}
                                                        </option>
                                                    </select>
                                                </div>
                                                <div class="form-group col-md-6" ng-show="PLDB.LandMortgagedPendingLevelId==6">
                                                    <label for="MLMutationNo">नामान्तरण सं.</label>
                                                    <input type="text" class="form-control ml-mutation-no" id="MLMutationNo" ng-model="PLDB.LandMortgagedMutationNo" ng-disabled="allDisable" placeholder="नामान्तरण सं." autocomplete="off">
                                                </div>
                                                <div class="form-group col-md-6" ng-show="PLDB.LandMortgagedPendingLevelId==6">
                                                    <label for="MLMutationDate">दिनांक</label>
                                                    <input type="date" class="form-control ml-mutation-date" id="MLMutationDate" ng-model="PLDB.LandMortgagedMutationDate" ng-disabled="allDisable" autocomplete="off">
                                                </div>
                                                <div class="col-sm-6 form-group" ng-show="PLDB.LandMortgagedPendingLevelId==6">
                                                    <label>दस्तावेज़ (जमाबंदी)<span class="error">(max 5MB)</span>:</label>
                                                    <div ng-show="PLDB.LandMortgagedMutationDocument!=null && PLDB.LandMortgagedMutationDocument!=''">
                                                        <a href="~/Content/OTS/MutationDoc/{{PLDB.LandMortgagedMutationDocument}}" class="btn btn-primary dev-btn" target="_blank">देखें</a>
                                                    </div>
                                                    <div ng-show="PLDB.LandMortgagedMutationDocument==null || PLDB.LandMortgagedMutationDocument==''">
                                                        <input type="file" accept=".pdf" class="form-control ml-mutation-doc" checkmaxsize="5120" multiple onchange="angular.element(this).scope().FileUploader(this.files,'LandMortgagedMutationDocument')" />
                                                        <input type="hidden" ng-model="PLDB.LandMortgagedMutationDocument" id="ML_MutationDocument" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 text-center">
                                            @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10188 ||
                                                ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10189 ||
