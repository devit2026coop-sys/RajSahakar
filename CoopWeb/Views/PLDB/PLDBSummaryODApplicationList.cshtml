                    <div style="overflow-x: auto;">
                        <table id="OTSListTable" class="table table-responsive devtable" style="">
                            <thead>
                                <tr>
                                    <th rowspan="2">Sr. No.</th>
                                    <th rowspan="2">PLDB Name</th>
                                    <th rowspan="2">Branch</th>
                                    <th rowspan="2">Applicant Name</th>
                                    <th rowspan="2">Mobile No.</th>
                                    <th rowspan="2">Village</th>
                                    <th rowspan="2">Loan A/c No.</th>

                                    <th colspan="5" style="text-align:center;">OD as on 01-07-2025</th>
                                    <th colspan="4" style="text-align:center;">Demand due after 01-07-2025</th>
                                    <th colspan="4" style="text-align:center;">Recovery After 30-06-2025</th>

                                    <th rowspan="2">{{translation.Actions}}</th>
                                </tr>

                                <tr>
                                    <!-- OD -->
                                    <th>OD Principal</th>
                                    <th>Insurance Premium</th>
                                    <th>OD Interest</th>
                                    <th>Penal Interest / Recovery Charges / Others</th>
                                    <th>OD Total</th>

                                    <!-- Demand -->
                                    <th>Principal</th>
                                    <th>Interest</th>
                                    <th>Penal Interest</th>
                                    <th>CD Total</th>

                                    <!-- Recovery -->
                                    <th>Principal</th>
                                    <th>Int./P.I./ Rec. Charges / Others</th>
                                    <th>Int. Subvention</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="OTS in OTSList">
                                    <td>
                                        {{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}
                                        @*<input type="checkbox" ng-model="OTS.selected" ng-change="toggleSelection(OTS)">*@

                                    </td>
                                    @*<td style="text-transform:uppercase;">*@
                                     
                                    @*<td>{{$index+1}}</td>*@
                                    <td>{{OTS.PLDBName}}</td>
                                    <td>{{OTS.PLDBBranch}}</td>
                                    <td>{{OTS.ApplicantName}}</td>
                                    <td>{{OTS.MobileNo}}</td>
                                    <td>{{OTS.Village}}</td>
                                    <td>{{OTS.LoanAccNo}}</td>

                                    <td>{{OTS.ODPrincipal}}</td>
                                    <td>{{OTS.ODInsurancePremium}}</td>
                                    <td>{{OTS.ODInterest}}</td>
                                    <td>{{OTS.ODPenalInterast}}</td>
                                    <td>{{OTS.ODTotal}}</td>

                                    <td>{{OTS.CDPrincipal}}</td>
                                    <td>{{OTS.CDInterest}}</td>
                                    <td>{{OTS.CDPenalInterest}}</td>
                                    <td>{{OTS.CDTotal}}</td>

                                    <td>{{OTS.Principal}}</td>
                                    <td>{{OTS.OtherCharges}}</td>
                                    <td>{{OTS.IntSubvention}}</td>
                                    <td>{{OTS.ReccoveryTotalAmount}}</td>

                                    <td>
                                        <div style="display:flex;gap:5px;">
                                            <!-- Edit Button -->
                                            <a class="btn btn-sm btn-warning" title="Edit" href="../PLDB/PLDBSummaryODApplicationForm?eId={{OTS.EncPldbOtsSchemeId}}&mode=e" target="_blank"><i class="fa fa-edit text-white"></i></a>
                                            <a class="btn btn-sm btn-primary" title="View" href="../PLDB/PLDBSummaryODApplicationForm?eId={{OTS.EncPldbOtsSchemeId}}&mode=v" target="_blank"><i class="fa fa-eye text-white"></i></a>
                                            <a class="btn btn-sm btn-danger" title="Delete" href="javascript:void(0);"  ng-click="DeletePLDB(OTS.PLDB_OTS_SchemeID)"> <i class="fa fa-trash text-white"></i> </a>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-12">
                        <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                                Total Records: {{DataPagingDetails.TotalRecords}}
                            </div>
                            <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetOTSList)" style="cursor: pointer;">
                                    <span>«First</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetOTSList)" style="cursor:pointer;">
                                    <span>« Previous</span>
                                </li>
                                <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetOTSList)"><span>{{n}}</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                                <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                                <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetOTSList)" style="cursor:pointer;">
                                    <span>Next »</span>
                                </li>
                                <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetOTSList)" style="cursor:pointer;">
                                    <span>Last »</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="pendingLevelModal" class="modal fade" role="dialog" style="color:#444;" data-backdrop="static">
            <div class="modal-dialog" style="min-width:500px;max-width:800px;">
                <div class="modal-content">
                    <div class="modal-header">
                        <b class="text-info">बंधक विवरण के लिए लंबित स्तर संपादित करें</b>
                        <a data-dismiss="modal" class="pull-right"><i class="fa fa-times"></i></a>
                    </div>
                    <div class="modal-body" style="display:grid;">
                        <form id="pendingLevelForm" ng-submit="SavePendingLevelData()">
                            <div id="otherDetails">
                                <div class="col-md-12">
                                    <div class="row" ng-show="PLDB.IsNormalCase==0">
                                        <div class="col-sm-6">
                                            <div class="form-group ">
                                                <label for="PendingLevel"> धारा 103 के तहत लम्बित स्तर</label>
                                                <select id="PendingLevel" ng-model="PLDB.PendingLevelId" class="form-control pending-level" ng-disabled="allDisable">
                                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                                    <option ng-repeat="li in PendingLevelList track by li.OtsPendingLevelId" value="{{li.OtsPendingLevelId}}" ng-selected="li.OtsPendingLevelId==PLDB.PendingLevelId">
                                                        {{li.Name}}
                                                    </option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group col-sm-6" ng-show="PLDB.PendingLevelId==6">
                                            <label for="MutationNo">नामान्तरण सं.</label>
                                            <input type="text" class="form-control mutation-no" id="MutationNo" ng-model="PLDB.MutationNo" ng-disabled="allDisable" placeholder="नामान्तरण सं." autocomplete="off">
                                        </div>
                                        <div class="form-group col-sm-6" ng-show="PLDB.PendingLevelId==6">
                                            <label for="MutationDate">दिनांक</label>
                                            <input type="date" class="form-control mutation-date" id="MutationDate" ng-model="PLDB.MutationDate" ng-disabled="allDisable" autocomplete="off">
                                        </div>
                                        <div class="col-sm-6 form-group" ng-show="PLDB.PendingLevelId==6">
                                            <label>दस्तावेज़ (जमाबंदी)<span class="error">(max 5MB)</span>:</label>
                                            <div ng-show="PLDB.MutationDocument!=null && PLDB.MutationDocument!=''">
                                                <a href="~/Content/OTS/MutationDoc/{{PLDB.MutationDocument}}" class="btn btn-primary dev-btn" target="_blank">देखें</a>
                                            </div>
                                            <div ng-show="PLDB.MutationDocument==null || PLDB.MutationDocument==''">
                                                <input type="file" accept=".pdf" class="form-control mutation-doc" checkmaxsize="5120" multiple onchange="angular.element(this).scope().FileUploader(this.files,'MutationDocument')" />
                                                <input type="hidden" ng-model="PLDB.MutationDocument" id="MutationDocument" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" ng-show="PLDB.IsNormalCase==1">
                                        <div class="col-md-12">
                                            <label>क्या ऋण नीति अनुसार भूमि बैंक पक्ष में रहन दर्ज आवश्यक हैं?</label>
                                            <div style="display:inline-flex;min-width:400px;">
                                                <label> <input type="radio" name="IsMortgageMandatory" class="ml-mortgage-mandatory" value="1" ng-model="PLDB.IsMortgageMandatory" /> हाँ</label>
                                                <label> <input type="radio" name="IsMortgageMandatory" class="ml-mortgage-mandatory" value="0" ng-model="PLDB.IsMortgageMandatory" /> नहीं</label>
                                            </div>
                                            <div class="row" ng-show="PLDB.IsMortgageMandatory==1">

                                                <div class="form-group col-md-6">
                                                    <label for="MLPendingLevel">रहन से वंचित लम्बित स्तर</label>
                                                    <select id="MLPendingLevel" ng-model="PLDB.LandMortgagedPendingLevelId" class="form-control ml-pending-level" ng-disabled="allDisable">
                                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                                        <option ng-repeat="li in MLPendingLevelList" value="{{li.OtsPendingLevelId}}">
                                                            {{li.Name}}
                                                        </option>
                                                    </select>
                                                </div>
                                                <div class="form-group col-md-6" ng-show="PLDB.LandMortgagedPendingLevelId==6">
                                                    <label for="MLMutationNo">नामान्तरण सं.</label>
                                                    <input type="text" class="form-control ml-mutation-no" id="MLMutationNo" ng-model="PLDB.LandMortgagedMutationNo" ng-disabled="allDisable" placeholder="नामान्तरण सं." autocomplete="off">
                                                </div>
                                                <div class="form-group col-md-6" ng-show="PLDB.LandMortgagedPendingLevelId==6">
                                                    <label for="MLMutationDate">दिनांक</label>
                                                    <input type="date" class="form-control ml-mutation-date" id="MLMutationDate" ng-model="PLDB.LandMortgagedMutationDate" ng-disabled="allDisable" autocomplete="off">
                                                </div>
                                                <div class="col-sm-6 form-group" ng-show="PLDB.LandMortgagedPendingLevelId==6">
                                                    <label>दस्तावेज़ (जमाबंदी)<span class="error">(max 5MB)</span>:</label>
                                                    <div ng-show="PLDB.LandMortgagedMutationDocument!=null && PLDB.LandMortgagedMutationDocument!=''">
                                                        <a href="~/Content/OTS/MutationDoc/{{PLDB.LandMortgagedMutationDocument}}" class="btn btn-primary dev-btn" target="_blank">देखें</a>
                                                    </div>
                                                    <div ng-show="PLDB.LandMortgagedMutationDocument==null || PLDB.LandMortgagedMutationDocument==''">
                                                        <input type="file" accept=".pdf" class="form-control ml-mutation-doc" checkmaxsize="5120" multiple onchange="angular.element(this).scope().FileUploader(this.files,'LandMortgagedMutationDocument')" />
                                                        <input type="hidden" ng-model="PLDB.LandMortgagedMutationDocument" id="ML_MutationDocument" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 text-center">
                                            @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10188 ||
                                                ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10189 ||
                                                ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10236)
                                            {
                                                <input type="submit" class="btn btn-primary dev-btn" value="संचित करें" />
                                                <input type="button" class="btn btn-danger" value="रद्द करें" data-dismiss="modal" />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div id="caseNotMortgageModal" class="modal fade" role="dialog" style="color:#444;" data-backdrop="static">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <b class="text-info">रहन से वंचित मामले में संपादन </b>
                        <a data-dismiss="modal" class="pull-right"><i class="fa fa-times"></i></a>
                    </div>
                    <div class="modal-body" style="display:grid;">
                        <form id="pendingLevelForm" ng-submit="SaveCaseNotMortgageStatus()">
                            <div id="otherDetails">
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label>यदि मामला रहन से वंचित है तो हाँ (Yes) चुने </label>
                                            <div style="display:inline-flex;min-width:400px;">
                                                <label> <input type="radio" name="CaseNotMortgagedStatus" class="ml-mortgage-mandatory" value="1" ng-model="PLDB.CaseNotMortgagedStatus" /> हाँ</label>
                                                <label> <input type="radio" name="CaseNotMortgagedStatus" class="ml-mortgage-mandatory" value="0" ng-model="PLDB.CaseNotMortgagedStatus" /> नहीं</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 text-center">
                                            @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10235 ||
                                                ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10236)
                                            {
                                                <input type="submit" class="btn btn-primary dev-btn" value="संचित करें" />
                                                <input type="button" class="btn btn-danger" value="रद्द करें" data-dismiss="modal" />
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="se-pre-con"></div>
    </div>
</div>

