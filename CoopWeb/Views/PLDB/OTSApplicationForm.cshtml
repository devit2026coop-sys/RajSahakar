                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item in CityListdata" value="{{item.CITY_ID}}">
                                                    {{_language =='en-us' ?  item.CITY_ENG : item.CITY_MANGAL}}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label for="">{{translation.Ward}}<span class="error">*</span></label>
                                            <select ng-model="PLDB.WARD_ID" class="form-control" ng-init="PLDB.WARD_ID='0'" ng-disabled="allDisable">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="item in Ward" value="{{item.WARD_ID}}">
                                                    {{_language =='en-us' ?  item.WARD_ENG : item.WARD_MANGAL}}
                                                </option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">

                                        <div class="form-group col-md-6">
                                            <label for="Tehsil">{{ translation.Tehsil}}<span class="error">*</span></label>
                                            <input type="text" class="form-control" name="Tehsil" id="Tehsil" ng-model="PLDB.TehsilName" ng-disabled="allDisable" placeholder="{{translation.VidhanSabhaArea}}" autocomplete="off">
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label for="VidhanSabha">{{ translation.VidhanSabhaArea}}<span class="error">*</span></label>
                                            <input type="text" class="form-control" name="VidhanSabha" id="VidhanSabha" ng-model="PLDB.VidhanSabha" ng-disabled="allDisable" placeholder="{{translation.VidhanSabhaArea}}" autocomplete="off">
                                        </div>
                                    </div>

                                </div>

                            </div>
                            <br />
                            <div id="otherDetails" style="display:none;">
                                <div class="form-group col-md-12">
                                    <h5 class="heading-hr ng-binding"> Pending level for mortgage details under 103 cases</h5>
                                </div>
                                <div class="form-group col-md-12">
                                    <div class="row">
                                        <div class="form-group col-md-3">
                                            <label for="PendingLevel">Pending level of cases under 103</label>
                                            <select id="PendingLevel" ng-model="PLDB.PendingLevelId" class="form-control pending-level" ng-disabled="allDisable">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="li in PendingLevelList track by li.OtsPendingLevelId" value="{{li.OtsPendingLevelId}}" ng-selected="li.OtsPendingLevelId==PLDB.PendingLevelId">
                                                    {{li.Name}}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="form-group col-md-3" ng-show="PLDB.PendingLevelId==6">
                                            <label for="MutationNo">Mutation No.</label>
                                            <input type="text" class="form-control mutation-no" id="MutationNo" ng-model="PLDB.MutationNo" ng-disabled="allDisable" placeholder="Mutation No." autocomplete="off">
                                        </div>
                                        <div class="form-group col-md-3" ng-show="PLDB.PendingLevelId==6">
                                            <label for="MutationDate">Mutation Date</label>
                                            <input type="date" class="form-control mutation-date" id="MutationDate" ng-model="PLDB.MutationDate" ng-disabled="allDisable" placeholder="Mutation Date" autocomplete="off">
                                        </div>
                                    </div>
                                    <div class="row" ng-show="{{PLDB.IsNormalCase==0}}">
                                        <div class="col-md-12">
                                            <br />
                                            <label>
                                                If land not mortaged, than pending level
                                            </label>
                                        </div>
                                        <div class="form-group col-md-3">
                                            <label for="MLPendingLevel">Pending level of cases under 103</label>
                                            <select id="MLPendingLevel" ng-model="PLDB.LandMortgagedPendingLevelId" class="form-control ml-pending-level" ng-disabled="allDisable">
                                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                                <option ng-repeat="li in MLPendingLevelList" value="{{li.OtsPendingLevelId}}">
                                                    {{li.Name}}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="form-group col-md-3" ng-show="PLDB.LandMortgagedPendingLevelId==6">
                                            <label for="MLMutationNo">Mutation No.</label>
                                            <input type="text" class="form-control ml-mutation-no" id="MLMutationNo" ng-model="PLDB.LandMortgagedMutationNo" ng-disabled="allDisable" placeholder="Mutation No." autocomplete="off">
                                        </div>
                                        <div class="form-group col-md-3" ng-show="PLDB.LandMortgagedPendingLevelId==6">
                                            <label for="MLMutationDate">Mutation Date</label>
                                            <input type="date" class="form-control ml-mutation-date" id="MLMutationDate" ng-model="PLDB.LandMortgagedMutationDate" ng-disabled="allDisable" placeholder="Mutation Date" autocomplete="off">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-12" style="margin-top: 25px;    border-top: 1px solid darkgray;    padding-top: 10px; background-color: white; padding-bottom: 10px;">
                            <center>
                                <a class="btn btn-primary dev-btn" style="text-transform: capitalize;" ng-if="IsSubmiApplication==true" href="javascript:void(0);" ng-click="ShowLoanApplication()">{{ translation.Back}}</a>
                                @if (((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10188 ||
                                    ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10064 || 
                                    ((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).RoleId == 10189)
                                {
                                    <button type="submit" class="btn btn-success" ng-if="IsSubmiApplication==false" ng-click="Save_PLDBForm(true)">&nbsp;&nbsp;{{translation.Submit}} </button>
                                }
                            </center>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="FormPost">
</div>


