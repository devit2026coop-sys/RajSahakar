        <div class="col-lg-12">
            <div class="col-lg-1"><label>{{translation.PLDB}}</label></div>
            <div class="col-lg-4">
                {{GetNameFromList(PLDB,LoanDetails.pldb_id,'District')}}
            </div>
        </div>
        <div class="col-lg-12">
            <div class="col-lg-1"><label>{{translation.Branch}}</label></div>
            <div class="col-lg-4">
                {{GetNameFromList(PLDBBranches,LoanDetails.branch_id,'Branch')}}
            </div>
        </div>
        <div class="col-lg-12">
            <div class="col-lg-1"><label>{{translation.Status}}</label></div>
            <div class="col-lg-4">
                {{LoanDetails.ProceesStatusTextHi}}
            </div>
        </div>

        <div class="col-lg-12">
            <div class="col-lg-1"><label>{{translation.Remarks}}</label></div>
            <div class="col-lg-4">
                {{LoanDetails.status_remark}}
            </div>
        </div>



        <div class="col-lg-12" ng-if="LoanDetails.status_level==1 && UserLevel>0">
            <div class="col-lg-1"></div>
            <div class="col-lg-4">
                <a href="javascript:void(0);" ng-click="EditAppication(LoanDetails)" style="font-size:20px;" class="fa fa-edit"></a>
            </div>
        </div>
    </div>

