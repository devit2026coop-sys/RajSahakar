                        <th rowspan="3" class="thverticalMiddle">{{translation.MonthlyInstallment}}</th>
                        @*<th rowspan="3" class="thverticalMiddle">यदि राशि अवधिपार हो, तो विवरण</th>*@
                        <th rowspan="3" class="thverticalMiddle">{{translation.Tenure}}</th>
                        <th rowspan="3" class="thverticalMiddle">{{translation.IntrestRate}}</th>
                        <th rowspan="3" class="thverticalMiddle">{{translation.Source}}</th>
                        <th class="thCenter"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in LoadPreLoanDetails" ng-if="!item.IsDelete">
                        <td>{{$index+1}}</td>
                        <td>
                            <input type="text" id="txtOrganization" name="CooperativeBankName" class="form-control" placeholder="{{translation.CooperativeBankName}}" ng-model="item.Organization" autocomplete="off" onKeyPress="return ValidateAlpha(event);">
                        </td>
                        <td>
                            <input type="text" id="txtPreLoanAmount" name="PreLoanAmount" class="form-control" placeholder="{{translation.LoanAmount}}" maxlength="9" ng-model="item.PreLoanAmount" onKeyPress="return isNumber(event);" autocomplete="off">
                        </td>

                        <td>
                            <input type="text" id="txtRestAmount" name="Rest Amount" class="form-control" maxlength="9" placeholder="{{translation.RestAmount}}" ng-model="item.RestAmount" autocomplete="off" onKeyPress="return isNumber(event);">
                        </td>

                        <td>
                            <input type="text" name="MembershipNumber" id="txtMonthlyInstallment" class="form-control" placeholder="{{translation.MonthlyInstallment}}" maxlength="9" ng-model="item.MonthlyInstallment" autocomplete="off" onKeyPress="return isNumber(event);">
                        </td>
                        @*<td>
                                <textarea class="form-control" rows="1" placeholder="यदि राशि अवधिपार हो, तो विवरण"></textarea>
                            </td>*@
                        <td>
                            <input type="text" id="txtTenure" name="Tenure" class="form-control" placeholder="{{translation.Tenure}}" ng-model="item.Tenure" maxlength="2" onKeyPress="return isNumber(event);" autocomplete="off">
                        </td>
                        <td>
                            <input type="text" id="txtIntrestRate" name="Intrest Rate" class="form-control" placeholder="{{translation.IntrestRate}}" maxlength="5" ng-model="item.IntrestRate" onKeyPress="return isNumber(event);" autocomplete="off">
                        </td>
                        <td>
                            <input type="text" id="txtSource" name="Source" class="form-control" placeholder="{{translation.Source}}" ng-model="item.Source" autocomplete="off" onKeyPress="return ValidateAlpha(event);">
                        </td>
                        <td style="text-align: right !important">
                            <i class="fa fa-trash clsShowHide btn btn btn-xs btn-danger tooltips rowdeleteBtn" id="Remove_4" ng-if="LoadPreLoanDetails.length>1" ng-click="RemovePreLoanDetailsRow($index)" style=""></i>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="8"></td>
                        <td style="text-align:right;cursor:pointer;" ng-click="AddNewPreLoanDetails()"><i class="fa fa-plus" title="Add New"></i>{{translation.Add}}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

