
@{Layout = null;}

<div ng-show="!IsSubmiApplication">
    <input type="hidden" id="hdnUserlevel" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).LevelId)" />
    <div class="col-lg-12 form-group">
        <div class="col-lg-2">{{ translation.PLDB}} <span class="error">*</span></div>
        <div class="col-lg-4">
            <select ng-model="MemberRegistration.PLDB_ID" ng-show="!LoanMembers[0].IsValidate" ng-disabled="IsSubmiApplication" id="ddlDistrict" class="form-control" ng-init="MemberRegistration.PLDB_ID='0'" ng-change="PLDBBranchList('0')">
                <option value="0" disabled>{{translation.SelectOption}}</option>
                <option ng-repeat="itemPLDB in PLDB | orderBy:'PldbId'" value="{{itemPLDB.PldbId}}">
                    {{itemPLDB.PLDBName}}
                </option>
            </select>
            <input ng-if="LoanMembers[0].IsValidate" class="form-control" type="text" disabled value="{{GetNameFromList(PLDB,MemberRegistration.PLDB_ID,'District')}}" />
        </div>
        <div class="col-lg-2">{{ translation.Branch}} <span class="error">*</span></div>
        <div class="col-lg-4">
            <select ng-show="!LoanMembers[0].IsValidate" ng-model="MemberRegistration.Branch_ID" ng-disabled="IsSubmiApplication" id="ddlblock" class="form-control" ng-init="MemberRegistration.Branch_ID='0'" ng-change="GetGramPanchayatData()">
                <option value="0" disabled>{{translation.SelectOption}}</option>
                <option ng-repeat="itemBlock in PLDBBranches | orderBy:'BLOCK_ENG'" value="{{itemBlock.BLOCK_ID}}">
                    {{_language =='en-us' ?  itemBlock.BLOCK_ENG : itemBlock.BLOCK_MANGAL}}
                </option>
            </select>
            <input ng-if="LoanMembers[0].IsValidate" class="form-control" type="text" disabled value="{{GetNameFromList(PLDBBranches,MemberRegistration.Branch_ID,'Branch')}}" />
        </div>
    </div>
</div>
