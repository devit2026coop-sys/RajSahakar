              ,[InspectorId] ,[RegistrarId] ,[CreatedBy] ,[CreationDate] ,[UpdatedBy] ,[UpdationDate],[CreatedIP] ,[UpdatedIP] ,[TotalMembersClassA] ,[TotalMembersClassB] ,[TotalMembersClassC]
