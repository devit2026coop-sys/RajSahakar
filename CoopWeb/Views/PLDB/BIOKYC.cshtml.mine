        string TextBox1 = @"


ALTER PROCEDURE [dbo].[Insert_Societies_Edit_Request_New]
@SocietyIdEnc VARCHAR(Max),
@EMitraTransactionId int=0,
@SocietyName NVARCHAR(250)='',
@SocietyTypeId int =0,
@SocietyClassId int =0,
@SocietySubClassId int =0,
@SocietyCategoryId int,
@ActId int,
@RegistrationCertificateFile NVARCHAR(250)='',
@ByeLawsSocietyFile NVARCHAR(250)='',
@RulesAndRegulationFile NVARCHAR(250)='',
@BRN NVARCHAR(250)='',
@RegistrationDate datetime,
@RegistrationNo NVARCHAR(150)='',
@SSOID NVARCHAR(150),
@CreatedBy int ,
@CreatedIP NVARCHAR(250),
@NoOfBranches int=0,
@ElectionDate datetime,
@KIOSKCODE Nvarchar(150),

--For Sports Society
@IsRSSC bit,
@AgmDate date,
@SportsAssociationId int,

@IsAffiliatedByRSSC bit,
@RSSCRegNo NVARCHAR(150)='',
@RSSCAffiliatedDate date,
@RSSCFileName NVARCHAR(250)='',

@IsAffiliatedBySOC bit,
@SOCRegNo NVARCHAR(100)='',
@SOCAffiliatedDate date,
@SOCFileName NVARCHAR(250)='',

@IsAffiliatedByDLSC bit,
@DLSCRegNo NVARCHAR(100)='',
@DLSCAffiliatedDate date,
@DLSCFileName NVARCHAR(200)='',
@MemberListExcelFile NVARCHAR(200)='',
@SocietyID Int=0,
@ServicesId int,
@IsNewRegistration bit,
--NEW
@SingleShareValue NUMERIC,
@BusinessId int,
@LiablityId int,
@NoOfMemberInAGM int,
@EntranceFeesCollected NUMERIC,
@PaidUpShareCapital NUMERIC,
@MemberLiablity int,
@WorkPlanEcoViabilityFile  NVARCHAR(250)='',
@GeneralMeetingProcedureFile  NVARCHAR(250)='',
@BalanceSheetExcelFile  NVARCHAR(250)='',
@LiabilityOfMember int=0,
@TotalNumberOfMembers int,
@ObjectsFile  NVARCHAR(250)='',
@IsAffiliationBySLSA bit,
@SLSARegNo NVARCHAR(200)='',
@SLSAAffiliatedDate date,
@SLSAFileName NVARCHAR(200)='',
@UserType NVARCHAR(250),
@IsAadharverified bit=1,
@AADHARNO NVARCHAR(250)='',
@IsPermanentSave tinyint=0,
@OldRegistrationNo nvarchar='',
@ISPROFILR int=0,
@IsActive tinyint,
@Remarks NVARCHAR(250)='',
@Certificate NVARCHAR(250)='',
@SeqId int=0,
@Amount decimal(18,3)=0,
@OTP NVARCHAR(250)='',
@InspectorId int=0,
@RegistrationNoOld nvarchar='',
@IsSWS bit=0,
@IsAmendmentAtProfiling bit=0,
@AmendmentType varchar(250)='',
@OldExecutiveCommittee  varchar(250)='',
@SocietyCode nvarchar(150)=''
AS

BEGIN TRY
SET NOCOUNT ON
SET XACT_ABORT ON
BEGIN TRANSACTION
insert into ErrorLogging(ErrorMessage,ErrorLocation,LogEntryDatetime,StatusId)values(@SocietyIdEnc+'__1','DD',GETDATE(),1)
IF(LEN(@SocietyIdEnc)>0)
BEGIN
select @SocietyID=dbo.Decrypt(@SocietyIdEnc)
END
DECLARE @RETURN INT=1

IF ( @IsNewRegistration =0 and @RegistrationNo like '%COOP%')
BEGIN

    SET @RETURN= -5;
    select @RETURN

END
else
begin


IF (@ActId !=7)
BEGIN
IF ( @SocietyID >0)
BEGIN
SET @IsNewRegistration=0;
IF(  (SELECT COUNT(Societies.SocietyID) FROM Societies Where (RegistrationNo=@RegistrationNo OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')=REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(@SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','') OR (BRN=@BRN  AND LEN(@BRN)>0)) and RegistrationNo!='' and IsActive=1  AND SocietyId!=@SocietyId)>0)
BEGIN
    SET @RETURN= -5;
END
END
ELSE IF (@SocietyID = 0 and  @IsNewRegistration=1)
BEGIN
IF(len(@BRN)>0)
BEGIN
    IF( (SELECT COUNT(Societies.SocietyID) FROM Societies Where ( SocietyName=@SocietyName OR BRN=@BRN OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')=REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(@SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')) and IsActive=1  )>0)
    BEGIN
        SET @RETURN= -5;
    END
END
ELSE
BEGIN
    IF( (SELECT COUNT(Societies.SocietyID) FROM Societies Where (REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')=REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(@SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','') ) and IsActive=1  )>0)
    BEGIN
        SET @RETURN= -5;
    END
END
--IF(SELECT COUNT(Societies.SocietyID) from Societies Where  UserType='C' AND Societies.SSOID=@SSOID AND Societies.ISACTIVE=1 AND @UserType='C')>1
--BEGIN
  --SET @RETURN= -10;
--END
END
ELSE IF((SELECT COUNT(Societies.SocietyID) from Societies Where (RegistrationNo=@RegistrationNo OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')=REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(@SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','') OR (BRN=@BRN AND LEN(@BRN)>0)) and RegistrationNo!=''  and IsActive=1  )>0)
BEGIN
SET @RETURN= -5;
END
END
ELSE IF(@ActId =7)
BEGIN
IF (@SocietyID >0)
BEGIN
SET @IsNewRegistration=0;
IF( (SELECT COUNT(Societies.SocietyID) FROM Societies Where (RegistrationNo=@RegistrationNo OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')=REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(@SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')) and IsActive=1  and RegistrationNo!=''   AND SocietyId!=@SocietyId)>0)
BEGIN
SET @RETURN= -5;
END
END
ELSE IF (@SocietyID = 0 and  @IsNewRegistration=1)
BEGIN
IF( (SELECT COUNT(Societies.SocietyID) FROM Societies Where (RegistrationNo=@RegistrationNo OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')=REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(@SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')) and IsActive=1  and RegistrationNo!='')>0)
BEGIN
    SET @RETURN= -5;
END
END
ELSE IF((SELECT COUNT(Societies.SocietyID) from Societies Where (RegistrationNo=@RegistrationNo OR REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')=REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(@SocietyName,'/',''),'_',''),'-',''),',',''),'.',''),' ','')) and IsActive=1  and RegistrationNo!=''  )>0)
BEGIN
SET @RETURN= -5;
END
END

insert into ErrorLogging(ErrorMessage,ErrorLocation,LogEntryDatetime,StatusId)values(@SocietyIdEnc+'__2','DD',GETDATE(),1)

IF  @RETURN > 0
BEGIN
DECLARE @StatusId int=0;
DECLARE @REGNO nvarchar(50);
DECLARE @IsObjection int=0;
insert into ErrorLogging(ErrorMessage,ErrorLocation,LogEntryDatetime,StatusId)values(@SocietyIdEnc+'__4','DD',GETDATE(),1)
select @IsObjection=ApplicationFlowID from SocietyApplicationFlow where SocietyApplicationFlow.StatusId in (5,10,20,27) and SocietyID=@SocietyID
and ApplicationFlowID=(select max(ApplicationFlowID) from SocietyApplicationFlow where SocietyID=@SocietyID)


IF (@IsNewRegistration=1 AND @SocietyID =0 AND (SELECT COUNT(1) FROM SOCIETIES WHERE SocietyName=@SocietyName AND ISACTIVE=1)=0)--Registration WITH NEW REG NO.KIOSK AND CITYZEN
BEGIN
insert into ErrorLogging(ErrorMessage,ErrorLocation,LogEntryDatetime,StatusId)values(@SocietyIdEnc+'__5','DD',GETDATE(),1)
    INSERT INTO [Societies]	([RegistrationNo],[SocietyName],[SocietyTypeId],[ClassId],[SubClassId],[SocietyCategoryId],[StatusId],[IsActive],[CreatedBy],[CreatedIP],[RegistrationCertificateFile],[RegistrationDate],[ActId],[SSOID],NoOfBranches,ElectionDate,

    BylawsFile,RulesRegulationFile,KIOSKCODE,BRN,IsRSSC,AGMDate,SportsAssociationId,IsAffiliatedByRSSC,RSSCRegNo,RSSCAffiliatedDate,RSSCFileName,IsAffiliatedBySOC,SOCRegNo,SOCAffiliatedDate,SOCFileName,IsAffiliatedByDLSC,DLSCRegNo,DLSCAffiliatedDate,DLSCFileName,MemberListFileName,CreationDate,IsNewRegistration,BusinessId,LiablityId,SingleShareValue,PaidUpShareCapital,NoOfMemberInAGM,EntranceFeesCollected,WorkPlanEcoViabilityFile,GeneralMeetingProcedureFile,BalanceSheetExcelFile,MemberLiablity,TotalNumberOfMembers,ObjectsFile,IsAffiliationBySLSA,SLSARegNo,SLSAAffiliatedDate,SLSAFileName,IsPermanentSave,OldRegistrationNo,ISPROFILR,SOCIETIESAUTHORIZEDPERSONS,SocietyReportFile,ExcelUploadId,IsDev,IsSWS,IsAmendmentAtProfiling,AmendmentType,OldExecutiveCommittee,SocietyCode,ApplicationStatus)
    VALUES	(@RegistrationNo,@SocietyName,@SocietyTypeId,@SocietyClassId,@SocietySubClassId,@SocietyCategoryId,0,@IsActive,@CreatedBy,@CreatedIP,@RegistrationCertificateFile,@RegistrationDate,@ActId,@SSOID,@NoOfBranches,@ElectionDate,@ByeLawsSocietyFile,@RulesAndRegulationFile,@KIOSKCODE,@BRN,@IsRSSC,@AGMDate,@SportsAssociationId,@IsAffiliatedByRSSC,@RSSCRegNo,@RSSCAffiliatedDate,@RSSCFileName,@IsAffiliatedBySOC,@SOCRegNo,@SOCAffiliatedDate,@SOCFileName,@IsAffiliatedByDLSC,@DLSCRegNo,@DLSCAffiliatedDate,@DLSCFileName,@MemberListExcelFile,getdate(),@IsNewRegistration,@BusinessId,@LiablityId,@SingleShareValue,@PaidUpShareCapital,@NoOfMemberInAGM,@EntranceFeesCollected,@WorkPlanEcoViabilityFile,@GeneralMeetingProcedureFile,@BalanceSheetExcelFile,@MemberLiablity,@TotalNumberOfMembers,@ObjectsFile,@IsAffiliationBySLSA,@SLSARegNo,@SLSAAffiliatedDate,@SLSAFileName,@IsPermanentSave,@OldRegistrationNo,@ISPROFILR,'','',0,1,@IsSWS,@IsAmendmentAtProfiling,@AmendmentType,@OldExecutiveCommittee,@SocietyCode,1)
    SET @SocietyID =@@IDENTITY;

    INSERT INTO EMitraApplicationRequest (SocietyId,RegistrationNo,KioskID,CreatedIP,CreationDate,SERICEID,SSOID)
    VALUES(@SocietyID,@RegistrationNo,@KIOSKCODE,@CreatedIP,GETDATE(),@ServicesId,@SSOID)
    SET @EMitraTransactionId= @@IDENTITY


    INSERT INTO [Societies_Edit_Request]([EMitraTransactionId],[SocietyID],[RegistrationNo],[SocietyName],[SocietyTypeId],[ClassId],[SubClassId],[SocietyCategoryId],[StatusId],[IsActive],[CreatedBy],[CreatedIP],[RegistrationCertificateFile],[RegistrationDate],[ActId],[SSOID],NoOfBranches,ElectionDate,BylawsFile,RulesRegulationFile,KIOSKCODE,BRN,IsRSSC,AGMDate,SportsAssociationId,IsAffiliatedByRSSC,RSSCRegNo,RSSCAffiliatedDate,RSSCFileName,IsAffiliatedBySOC,SOCRegNo,SOCAffiliatedDate,SOCFileName,IsAffiliatedByDLSC,DLSCRegNo,DLSCAffiliatedDate,DLSCFileName,MemberListFileName,CreationDate,IsNewRegistration,BusinessId,LiablityId,SingleShareValue,PaidUpShareCapital,NoOfMemberInAGM,EntranceFeesCollected,WorkPlanEcoViabilityFile,GeneralMeetingProcedureFile,BalanceSheetExcelFile,MemberLiablity,TotalNumberOfMembers,ObjectsFile,IsAffiliationBySLSA,SLSARegNo,SLSAAffiliatedDate,SLSAFileName,IsPermanentSave,OldRegistrationNo,ISPROFILR,SOCIETIESAUTHORIZEDPERSONS,SocietyReportFile,ExcelUploadId,IsDev)
    VALUES(@EMitraTransactionId,@SocietyID,@RegistrationNo,@SocietyName,@SocietyTypeId,@SocietyClassId,@SocietySubClassId,@SocietyCategoryId,@StatusId,1,@CreatedBy,@CreatedIP,@RegistrationCertificateFile,@RegistrationDate,@ActId,@SSOID,@NoOfBranches,@ElectionDate,@ByeLawsSocietyFile,@RulesAndRegulationFile,@KIOSKCODE,@BRN,@IsRSSC,@AGMDate,@SportsAssociationId,@IsAffiliatedByRSSC,@RSSCRegNo,@RSSCAffiliatedDate,@RSSCFileName,@IsAffiliatedBySOC,@SOCRegNo,@SOCAffiliatedDate,@SOCFileName,@IsAffiliatedByDLSC,@DLSCRegNo,@DLSCAffiliatedDate,@DLSCFileName,@MemberListExcelFile,getdate(),@IsNewRegistration,@BusinessId,@LiablityId,@SingleShareValue,@PaidUpShareCapital,@NoOfMemberInAGM,@EntranceFeesCollected,@WorkPlanEcoViabilityFile,@GeneralMeetingProcedureFile,@BalanceSheetExcelFile,@MemberLiablity,@TotalNumberOfMembers,@ObjectsFile,@IsAffiliationBySLSA,@SLSARegNo,@SLSAAffiliatedDate,@SLSAFileName,@IsPermanentSave,@OldRegistrationNo,@ISPROFILR,'','',0,1)


    INSERT INTO SocietyApplicationFlow(SocietyID,StatusId,Remark,ActionDate,EAppRequestID)
    VALUES(@SocietyId,1,'',getdate(),@EMitraTransactionId);


    IF @ActId=1
    BEGIN
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,1,@ByeLawsSocietyFile,YEAR(GETDATE()),0);
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,2,@MemberListExcelFile,YEAR(GETDATE()),0);
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,3,@ObjectsFile,YEAR(GETDATE()),0);
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,4,@BalanceSheetExcelFile,YEAR(GETDATE()),0);
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,7,@RegistrationCertificateFile,YEAR(GETDATE()),0)

    END
    ELSE IF @ActId=3
    BEGIN

            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,1,@ByeLawsSocietyFile,YEAR(GETDATE()),0);
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,2,@MemberListExcelFile,YEAR(GETDATE()),0);
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,4,@BalanceSheetExcelFile,YEAR(GETDATE()),0)
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,5,@WorkPlanEcoViabilityFile,YEAR(GETDATE()),0)
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,6,@GeneralMeetingProcedureFile,YEAR(GETDATE()),0)
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,7,@RegistrationCertificateFile,YEAR(GETDATE()),0)

    END
    ELSE IF @ActId=7
    BEGIN
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,1,@ByeLawsSocietyFile,YEAR(GETDATE()),0);
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,2,@MemberListExcelFile,YEAR(GETDATE()),0);
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,8,@RSSCFileName,YEAR(GETDATE()),0)
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,9,@SLSAFileName,YEAR(GETDATE()),0)
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,10,@SOCFileName,YEAR(GETDATE()),0)
            INSERT INTO SocietyDocumentTransjection (SocietyId,DocumentId,[FileName],[YearId],[IsProfiling])values(@SocietyID,11,@DLSCFileName,YEAR(GETDATE()),0)

    END

    SET @SocietyIdEnc=  (select dbo.Encrypt(@SocietyID));


END

IF (@IsNewRegistration=0 AND @SocietyID =0 AND (SELECT COUNT(1) FROM SOCIETIES WHERE RegistrationNo=@RegistrationNo  and RegistrationNo!=''  and SOCIETIES.IsActive=1)=0)--OFFLINE REG HA BUT APNE DB ME RECORD NAHI HA
BEGIN
    --

    INSERT INTO [Societies]	([RegistrationNo],[SocietyName],[SocietyTypeId],[ClassId],[SubClassId],[SocietyCategoryId],[StatusId],[IsActive],[CreatedBy],[CreatedIP],[RegistrationCertificateFile],[RegistrationDate],[ActId],[SSOID],NoOfBranches,ElectionDate,BylawsFile,RulesRegulationFile,KIOSKCODE,BRN,IsRSSC,AGMDate,SportsAssociationId,IsAffiliatedByRSSC,RSSCRegNo,RSSCAffiliatedDate,RSSCFileName,IsAffiliatedBySOC,SOCRegNo,SOCAffiliatedDate,SOCFileName,IsAffiliatedByDLSC,DLSCRegNo,DLSCAffiliatedDate,DLSCFileName,MemberListFileName,CreationDate,IsNewRegistration,BusinessId,LiablityId,SingleShareValue,PaidUpShareCapital,NoOfMemberInAGM,EntranceFeesCollected,WorkPlanEcoViabilityFile,GeneralMeetingProcedureFile,BalanceSheetExcelFile,MemberLiablity,TotalNumberOfMembers,ObjectsFile,IsAffiliationBySLSA,SLSARegNo,SLSAAffiliatedDate,SLSAFileName,IsPermanentSave,OldRegistrationNo,ISPROFILR,SOCIETIESAUTHORIZEDPERSONS,SocietyReportFile,ExcelUploadId,IsDev,IsSWS,IsAmendmentAtProfiling,AmendmentType,OldExecutiveCommittee,SocietyCode,ApplicationStatus)
    VALUES	(@RegistrationNo,@SocietyName,@SocietyTypeId,@SocietyClassId,@SocietySubClassId,@SocietyCategoryId,0,@IsActive,@CreatedBy,@CreatedIP,@RegistrationCertificateFile,@RegistrationDate,@ActId,@SSOID,@NoOfBranches,@ElectionDate,@ByeLawsSocietyFile,@RulesAndRegulationFile,@KIOSKCODE,@BRN,@IsRSSC,@AGMDate,@SportsAssociationId,@IsAffiliatedByRSSC,@RSSCRegNo,@RSSCAffiliatedDate,@RSSCFileName,@IsAffiliatedBySOC,@SOCRegNo,@SOCAffiliatedDate,@SOCFileName,@IsAffiliatedByDLSC,@DLSCRegNo,@DLSCAffiliatedDate,@DLSCFileName,@MemberListExcelFile,getdate(),@IsNewRegistration,@BusinessId,@LiablityId,@SingleShareValue,@PaidUpShareCapital,@NoOfMemberInAGM,@EntranceFeesCollected,@WorkPlanEcoViabilityFile,@GeneralMeetingProcedureFile,@BalanceSheetExcelFile,@MemberLiablity,@TotalNumberOfMembers,@ObjectsFile,@IsAffiliationBySLSA,@SLSARegNo,@SLSAAffiliatedDate,@SLSAFileName,@IsPermanentSave,@OldRegistrationNo,@ISPROFILR,'','',0,1,@IsSWS,@IsAmendmentAtProfiling,@AmendmentType,@OldExecutiveCommittee,@SocietyCode,1)
    SET @SocietyID =@@IDENTITY;

    INSERT INTO EMitraApplicationRequest (SocietyId,RegistrationNo,KioskID,CreatedIP,CreationDate,SERICEID,SSOID)
    VALUES(@SocietyID,@RegistrationNo,@KIOSKCODE,@CreatedIP,GETDATE(),@ServicesId,@SSOID)
    SET @EMitraTransactionId= @@IDENTITY

