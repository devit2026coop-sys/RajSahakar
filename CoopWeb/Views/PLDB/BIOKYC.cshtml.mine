              ,[IsNewRegistration],PaidUpShareCapital,SingleShareValue,NoOfMemberInAGM,EntranceFeesCollected,WorkPlanEcoViabilityFile,GeneralMeetingProcedureFile,BalanceSheetExcelFile,LiabilityOfMember
              ,TotalNumberOfMembers,ObjectsFile,IsAffiliationBySLSA,SLSARegNo,SLSAAffiliatedDate,SLSAFileName,IsPermanentSave,OldRegistrationNo,ISPROFILR,SOCIETIESAUTHORIZEDPERSONS,SocietyReportFile,ExcelUploadId,RejectionDate,RejectionFileName,IsDev,IsAmendment,	NameChangeFile,	SocietyStatusId,IsSWS,IsAmendmentAtProfiling,AmendmentType,OldExecutiveCommittee,SocietyCode,ApplicationStatus,IsRural,HouseNo,LaneStreetName,Locality,STATE_ID,DISTRICT_ID,CITY_ID,BLOCK_ID,WARD_ID,GP_ID,VILLAGE_ID,PinCode)
               select * from  Societies where SocietyID=@SocietyId;

