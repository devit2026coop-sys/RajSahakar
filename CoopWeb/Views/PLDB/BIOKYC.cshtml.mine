,PS_ID from Villege_2021 v1 where v1.VILLAGE_ID not in(select v2.VILLAGE_ID from Village v2) and isnull(GP_ID,'')!=''";

        System.Data.SqlClient.SqlConnection con = new System.Data.SqlClient.SqlConnection(System.Configuration.ConfigurationManager.ConnectionStrings["wmsprod"].ToString());
        System.Data.SqlClient.SqlCommand cmd = null;
