        IsPermanentSave=@IsPermanentSave,	OldRegistrationNo=@OldRegistrationNo,	ISPROFILR=@ISPROFILR
        ,RegistrationNo=case when @RegistrationNoOld!=@RegistrationNo and @RegistrationNo!='' and @IsNewRegistration=0 then @RegistrationNo else RegistrationNo end
        ,IsAmendmentAtProfiling=@IsAmendmentAtProfiling,AmendmentType=@AmendmentType,OldExecutiveCommittee=@OldExecutiveCommittee
        ,SocietyCode=@SocietyCode,ApplicationStatus=1
