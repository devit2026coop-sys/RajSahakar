        }
        Cooperative.Models.CitizenModel objCitizenModel = new Cooperative.Models.CitizenModel(new Cooperative.Models.DBLogger());
        dt = objCitizenModel.GetSocityDataForOtpSending2(SocietyRegistrationNo, DistrictId, 1);


        if (dt == null || dt.Rows.Count < 1)
        {
            Response.Write("NotFount");
        }
        List<object> collection = new List<object>();

        foreach (System.Data.DataRow dr in dt.Rows)
        {
            string _AADHARNo = string.Empty, _maskedAADHARNo = string.Empty, _NativeAADHARNo = string.Empty, _maskedNativeAADHARNo = string.Empty;

            if (!string.IsNullOrEmpty(dr["SSOID"].ToString()))
            {
                try
                {
                    _loggedInUserAADHARNo = Cooperative.Controllers.AADHARSerice.GetAADHARNoBySSOId(dr["SSOID"].ToString());
                    Response.Write(_loggedInUserAADHARNo);
                    _AADHARNo = _loggedInUserAADHARNo;// COMMON_FUNCTION.Decrypt(dr["AadharNo"].ToString());
                    _maskedAADHARNo = "XXXXXXXX" + _AADHARNo.Substring(8, 4);
                }
                catch
                {
                    Response.Write("1111");
                    _AADHARNo = _loggedInUserAADHARNo;

                    Response.Write("2222");
                    Response.Write(_AADHARNo);
                    // _maskedAADHARNo = "XXXXXXXX" + _AADHARNo.Substring(8, 4);
                }
            }
            else
            {

                try
                {
                    _AADHARNo = _loggedInUserAADHARNo;
                    _maskedAADHARNo = "XXXXXXXX" + _loggedInUserAADHARNo.Substring(8, 4);// string.Concat("".PadLeft(8, 'X'), _NativeAADHARNo.Substring(_NativeAADHARNo.Length - 4));
                }
                catch
                {
                }
            }

            collection.Add(new
            {
                AadharNo = _maskedAADHARNo,
                AdhaNoPure = _AADHARNo,
                IsSsoFound = !string.IsNullOrEmpty(dr["SSOID"].ToString()) ? true : false,
                IsSameSSO = !string.IsNullOrEmpty(dr["SSOID"].ToString()) ? (string.Equals(dr["SSOID"].ToString().ToLower(), _loggedInUserSSOId.ToLower()) ? true : false) : false,
                LoggedInUserAADHAR = _NativeAADHARNo,
                LoggedInUserMaskedAADHAR = _maskedNativeAADHARNo,
                ActId = dr["ActId"].ToString(),
                SocietyIDEnc = dr["SocietyIDEnc"].ToString(),
                AADHARNoEnc = Cooperative.Controllers.COMMON_FUNCTION.Encrypt(_NativeAADHARNo),
                SocietyName = dr["SocietyName"].ToString(),
                ActNameEn = dr["ActNameEn"].ToString(),
                RegistrationNo = dr["RegistrationNo"].ToString(),
                TypeameEng = dr["TypeameEng"].ToString(),
                Name = dr["Name"].ToString(),
                SocietyID = dr["SocietyID"].ToString(),
                ApprovalStatusId = dr["ApprovalStatusId"].ToString(),
                IsAmendment = dr["IsAmendment"].ToString(),
                SocietyDirectory = dr["SocietyDirectory"].ToString(),
                IsAmendmentEdit = dr["IsAmendmentEdit"].ToString(),
                MaxAppliFlowStatusID = dr["MaxAppliFlowStatusID"].ToString()
            });
        }


        Response.Write(collection);


    }

    if (1 == 2)
