@{ Layout= null;}


    <div class="col-lg-12 form-group">
        <h4 class="heading-hr ng-binding">प्रस्तावित वाहन का विवरण<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_8" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
    </div>
    <div class="col-lg-12 clspanal" id="panal_8">
        <div class="row" style="margin-top:5px;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    वाहन का नाम  एवं प्रकार <span class="mad">*</span>
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" id="VehicleType_1" maxlength="100" placeholder=" वाहन का नाम  एवं प्रकार " ng-model="LoanVehicle.VehicleType" onKeyPress="return isAlphaNumeric(event);" autocomplete="off"/>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-4">
                    मॉडल <span class="mad">*</span>
                </div>
                <div class="col-lg-8">
                    <input type="text" class="form-control" id="Model_1" maxlength="100" placeholder="मॉडल" ng-model="LoanVehicle.Model" onKeyPress="return isAlphaNumeric(event);"  autocomplete="off"/>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-6">
                    भार वाहन की क्षमता<span class="mad">*</span>
                </div>
                <div class="col-lg-6">
                    <input type="text" class="form-control" maxlength="50" id="Capacity_1" placeholder=" भार वाहन की क्षमता" ng-model="LoanVehicle.Capacity" onKeyPress="return isAlphaNumeric(event);" autocomplete="off" />
                </div>
            </div>
        </div>
        <div class="row" style="margin-top:5px;">

            <div class="col-lg-4">
                <div class="col-lg-7">
                    वाहन विक्रेता का नाम <span class="mad">*</span>
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" id="VehicleVendorName_1" maxlength="150" placeholder="वाहन विक्रेता का नाम" ng-model="LoanVehicle.VehicleVendorName" onKeyPress="return isAlphaNumeric(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-4">
                    ईंधन की औसत खपत प्रति ली. डीजल/पैट्रोल
                </div>
                <div class="col-lg-8">
                    <input type="text" class="form-control" maxlength="10" placeholder="ईंधन की औसत खपत प्रति ली. डीजल/पैट्रोल" ng-model="LoanVehicle.AverageFuelConsumption" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-6">
                    आवेदक का स्वयं का योगदान
                </div>
                <div class="col-lg-6">
                    <input type="text" class="form-control" id="ApplicantOwnContribution_1" maxlength="10" placeholder="आवेदक का स्वयं का योगदान" ng-model="LoanVehicle.ApplicantOwnContribution" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="row" style="margin-top:5px;">

            <div class="col-lg-4">
                <div class="col-lg-7">
                    एक्स-शोरूम कीमत  @*बॉडी का मूल्य*@<span class="mad">*</span>
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" id="BodyPrice_1" maxlength="10" placeholder="एक्स-शोरूम कीमत" ng-model="LoanVehicle.BodyPrice" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-4">
                    ऑन रोड कीमत   @*चेसिसि का मूल्य*@<span class="mad">*</span>
                </div>
                <div class="col-lg-8">
                    <input type="text" class="form-control" id="ChassisPrice_1" maxlength="10" placeholder="ऑन रोड कीमत" ng-model="LoanVehicle.ChassisPrice" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>


            <div class="col-lg-4">
                <div class="col-lg-6">
                    वांशित ऋण राशि
                </div>
                <div class="col-lg-6">
                    <input type="text" ng-disabled="true" value="{{LoanAmountDetails[0].LoanAmountApplied}}" class="form-control" maxlength="10" placeholder="वांशित ऋण राशि" ng-model="LoanVehicle.CommutedLoanAmount" onKeyPress="return isNumber(event);"  autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="row" style="margin-top:5px;display:none;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    अन्य व्यय
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="अन्य व्यय " value="0" ng-model="LoanVehicle.OtherExpenses" onKeyPress="return isNumber(event);"  autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-4">
                    योग
                </div>
                <div class="col-lg-8">
                    <input type="text" class="form-control" maxlength="10" placeholder="योग" value="{{LoanVehicle.ChassisPrice -- LoanVehicle.BodyPrice -- LoanVehicle.OtherExpenses}}" onKeyPress="return isNumber(event);" ng-disabled="true" />
                </div>
            </div>

        </div>

    </div>

    <div class="col-lg-12 form-group">
        <h4 class="heading-hr ng-binding">वाहन के परिचालन का विवरण<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_9" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
    </div>
    <div class="col-lg-12 clspanal" id="panal_9">
        <div class="row" style="margin-top:5px;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    क्षेत्र जहाँ वाहन चलाया जायेगा
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder=" क्षेत्र जहाँ वाहन चलाया जायेगा " ng-model="LoanVehicle.AreaVehicleDriven" onKeyPress="return isAlphaNumeric(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-5">
                <div class="col-lg-7">
                    स्टेट जिसके लिए परमिट/लाइसेंस प्राप्त कर लिया है| यदि हाँ तो परमिट नं. एवं अवधि अंकित करें |
                </div>
                <div class="col-lg-3">
                    <input type="text" class="form-control" maxlength="10" placeholder="परमिट नं." ng-model="LoanVehicle.StatePermitNo" onKeyPress="return isAlphaNumeric(event);" autocomplete="off"/>

                </div>
                <div class="col-lg-2">
                    <input type="text" class="form-control" maxlength="10" placeholder="अवधि" ng-model="LoanVehicle.StatePermitValidity" onKeyPress="return isAlphaNumeric(event);" autocomplete="off" />
                </div>

            </div>
        </div>
        <div class="row" style="margin-top:5px;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    वाहन से होने वाली अनुमानित मासिक  आय
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder=" वाहन से होने वाली अनुमानित मासिक आय" ng-model="LoanVehicle.MonthlyIncomeByVehicle" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-5">
                <div class="col-lg-7">
                    वाहन से क्या-क्या  वस्तुएँ लाई/ले जाई  जाएगी
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="150" placeholder="वाहन से क्या-क्या वस्तुएँ लाई/ले जाई जाएगी" ng-model="LoanVehicle.ItemsBroughtByVehicle" onKeyPress="return isAlphaNumeric(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-3">
                <div class="col-lg-6">
                    आय होने पर आधार
                </div>
                <div class="col-lg-6">
                    <input type="text" class="form-control" maxlength="10" placeholder="आय होने पर आधार" ng-model="LoanVehicle.IncomeBasis" onKeyPress="return isNumber(event);"autocomplete="off" />
                </div>
            </div>

        </div>
    </div>

    <div class="col-lg-12 form-group">
        <h4 class="heading-hr ng-binding">वाहन से प्रतिमाह की अनुमानित आय<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_10" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
    </div>
    <div class="col-lg-12 clspanal" id="panal_10">
        <div class="row" style="margin-top:5px;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    वाहन माह में कितने दिन चलेगा ?
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder=" वाहन माह में कितने दिन चलेगा ?" ng-model="LoanVehicle.VehicleRunDaysInMonth" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-5">
                    वाहन प्रतिदिन कितने कि.मी. चलेगा
                </div>
                <div class="col-lg-7">
                    <input type="text" class="form-control" maxlength="10" placeholder="वाहन प्रतिदिन कितने कि.मी. चलेगा" ng-model="LoanVehicle.VehicleRunPerDay" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-7">
                    किराया प्रति कि.मी. (भार ढोने की दशा में )
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="किराया प्रति कि.मी. (भार ढोने की दशा में )" ng-model="LoanVehicle.FarePerKM" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
        </div>
        <div class="row" style="margin-top:5px;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    अनुमानित मासिक आय
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="अनुमानित मासिक आय" ng-model="LoanVehicle.EstimatedMonthlyEarnings" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-5">
                    अन्य कोई
                </div>
                <div class="col-lg-7">
                    <input type="text" class="form-control" maxlength="10" placeholder="अन्य कोई " ng-model="LoanVehicle.OtherIncomeByVehicle" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-7">
                    योग
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="योग" value="{{LoanVehicle.FarePerKM -- LoanVehicle.EstimatedMonthlyEarnings}}" onKeyPress="return isNumber(event);" ng-disabled="true" />
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-12 form-group">
        <h4 class="heading-hr ng-binding">प्रति माह व्यय<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_11" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
    </div>
    <div class="col-lg-12 clspanal" id="panal_11">

        <div class="row" style="margin-top:5px;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    ईंधन (डीजल/पेट्रोल/आयल ) का प्रतिमाह व्यय
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="ईंधन (डीजल/पेट्रोल/आयल ) का प्रतिमाह व्यय" ng-model="LoanVehicle.MonthlyExpenditureFuel" onKeyPress="return isNumber(event);"  autocomplete="off"/>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-5">
                    कर्मचारी का वेतन/भत्ता
                </div>
                <div class="col-lg-7">
                    <input type="text" class="form-control" maxlength="10" placeholder="कर्मचारी का वेतन/भत्ता" ng-model="LoanVehicle.DriverSalaryAllowance" onKeyPress="return isNumber(event);"  autocomplete="off"/>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-7">
                    पथ परिहन (रोड टेक्स एवं अन्य कर)
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="पथ परिहन (रोड टेक्स एवं अन्य कर)" ng-model="LoanVehicle.RoadAndOtherTaxes" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
        </div>
        <div class="row" style="margin-top:5px;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    मरम्मत एवं रख-रखाव सर्विस
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="मरम्मत एवं रख-रखाव सर्विस" ng-model="LoanVehicle.RepairMaintenanceService" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-5">
                    बीमा  किस्त
                </div>
                <div class="col-lg-7">
                    <input type="text" class="form-control" maxlength="10" placeholder="बीमा किस्त" ng-model="LoanVehicle.InsurancePremiums" onKeyPress="return isNumber(event);"  autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-4">
                <div class="col-lg-7">
                    आयल स्पेयर पार्ट्स
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder=" आयल स्पेयर पार्ट्स" ng-model="LoanVehicle.OilSpareParts" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>

        </div>
        <div class="row" style="margin-top:5px;">

            <div class="col-lg-4">
                <div class="col-lg-7">
                    अन्य विविध व्यय
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="अन्य विविध व्यय" ng-model="LoanVehicle.OtherMiscellaneousExpenses" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>

            <div class="col-lg-4">
                <div class="col-lg-5">
                    गैरेज किराया
                </div>
                <div class="col-lg-7">
                    <input type="text" class="form-control" maxlength="10" placeholder="गैरेज किराया" ng-model="LoanVehicle.GarageRent" onKeyPress="return isNumber(event);"  autocomplete="off" />
                </div>
            </div>

            <div class="col-lg-4">
                <div class="col-lg-7">
                    छीजत (ह्रास)
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="छीजत (ह्रास)" ng-model="LoanVehicle.WearAndTear" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>
        </div>
        <div class="row" style="margin-top:5px;">
            <div class="col-lg-4">
                <div class="col-lg-7">
                    ऋण पर ब्याज
                </div>
                <div class="col-lg-5">
                    <input type="text" class="form-control" maxlength="10" placeholder="ऋण पर ब्याज" ng-model="LoanVehicle.InterestOnLoan" onKeyPress="return isNumber(event);" autocomplete="off" />
                </div>
            </div>

            <div class="col-lg-4">
                <div class="col-lg-5">
                    कुल व्यय
                </div>
                <div class="col-lg-7">
                    <input type="text" class="form-control" maxlength="10" placeholder="कुल व्यय" value="{{LoanVehicle.MonthlyExpenditureFuel -- LoanVehicle.DriverSalaryAllowance -- LoanVehicle.RoadAndOtherTaxes -- LoanVehicle.RepairMaintenanceService -- LoanVehicle.InsurancePremiums -- LoanVehicle.OilSpareParts -- LoanVehicle.OtherMiscellaneousExpenses -- LoanVehicle.GarageRent -- LoanVehicle.WearAndTear -- LoanVehicle.InterestOnLoan}}" onKeyPress="return isNumber(event);" ng-disabled="true" />
                </div>
            </div>
        </div>
    </div>


    <div class="col-lg-12 form-group">
        <h4 class="heading-hr ng-binding">{{translation.AttachmentDetails}}<a ng-show="IsSubmiApplication" href="javascript:void(0);" dat-val="panal_12" class="fa fa-plus-circle expandDetails" style="float:right;font-size: 25px;"></a></h4>
    </div>
    <div class="col-lg-12  clspanal" id="panal_12">
        <div class="table-responsive">
            <table class="table devtable">
                <thead>
                    <tr>
                        <th style="width:50%;">
                            {{translation.AttachmentDetails}}
                        </th>
                        <th>
                            {{translation.File}}
                        </th>
                    </tr>
                </thead>
                <tbody>
<tr ng-if="true">
                        <td>

                            <label><input type="checkbox" style="margin-right: 5px;" ng-checked="true" ng-disabled="true" ng-model="Applicaion.IsQuotation" value="">वाहन की कीमत का कोटशन </label>

                        </td>
                        <td>
                            <div class="col-lg-12">

                                <div class="col-lg-6" ng-show="!LoanMembers[0].IsQuotation">
                                    <input type="file" dat-val="nocheck" accept="image/*,application/pdf" ng-model="QuotationCopy" id="QuotationlCopy" ng-click="AddFile(11,0)" validfile />
                                </div>
                                <div class="col-lg-6" ng-if="LoanMembers[0].IsQuotation">
                                    <a href="javascript:void(0);" ng-if="LoanMembers[0].QuotationlCopy!=''"><i class="fa fa-check-circle-o" style="font-size: 18px;margin-right: 5px;    color: #20cc20;"></i></a>
                                    <a href="~/Content/pldb/{{LoanMembers[0].QuotationlCopy}}" ng-if="LoanMembers[0].QuotationlCopy!=''" target="_blank"><i class="fa fa-eye-slash" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>View File</a>
                                    <a href="javascript:void(0);" ng-if="LoanMembers[0].QuotationlCopy==''&& !IsSubmiApplication" ng-click="UploadFile('QuotationlCopy',11,0)"><i class="fa fa-upload" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>Upload  File</a>
                                    <a href="javascript:void(0);" ng-if="LoanMembers[0].IsQuotation && !IsSubmiApplication" ng-click="ChangeFile('QuotationlCopy',11,0)"><i class="fa fa-undo" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>Change File</a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr ng-if="LoanMembers.length>1 && LoanMembers[1].IsValidate">
                        <td>

                            <label><input type="checkbox" ng-disabled="true" style="margin-right: 5px;" ng-checked="LoanMembers.length>1" ng-model="Applicaion.IsApplicantShared" value="">क्यां आवेदक सांझेदार हैं ? यदि हाँ , तो , रजिस्ट्रेशन /सांझेदारी अभिलेख की प्रमाणित प्रति सलंग्न ली जाय | </label>

                        </td>
                        <td>
                            <div class="col-lg-12">

                                <div class="col-lg-6" ng-show="(LoanMembers.length>1 && LoanMembers[1].IsValidate)&& !LoanMembers[1].IsPartnershipCertifiedCopy">
                                    <input type="file" dat-val="nocheck" accept="image/*,application/pdf" ng-model="PartnershipCertifiedCopy" id="PartnershipCertifiedCopy" ng-click="AddFile(1,0)" validfile />
                                </div>
                                <div class="col-lg-6" ng-if="LoanMembers[1].IsPartnershipCertifiedCopy">
                                    <a href="javascript:void(1);" ng-if="LoanMembers[1].PartnershipCertifiedCopy!=''"><i class="fa fa-check-circle-o" style="font-size: 18px;margin-right: 5px;    color: #20cc20;"></i></a>
                                    <a href="~/Content/pldb/{{LoanMembers[0].PartnershipCertifiedCopy}}" ng-if="LoanMembers[1].PartnershipCertifiedCopy!=''" target="_blank"><i class="fa fa-eye-slash" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>View File</a>
                                    <a href="javascript:void(1);" ng-if="LoanMembers[1].PartnershipCertifiedCopy==''&& !IsSubmiApplication" ng-click="UploadFile('PartnershipCertifiedCopy',1,0)"><i class="fa fa-upload" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>Upload  File</a>
                                    <a href="javascript:void(1);" ng-if="LoanMembers[1].IsPartnershipCertifiedCopy && !IsSubmiApplication" ng-click="ChangeFile('PartnershipCertifiedCopy',1,0)"><i class="fa fa-undo" style="font-size: 18px;margin-right: 5px;font-weight: bold"></i>Change File</a>
                                </div>
                            </div>
                        </td>
                    </tr>


                    <tr ng-if="true">
                        <td>

