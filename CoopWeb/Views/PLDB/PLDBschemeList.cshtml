    }

    .green1:hover .icon .fa {
        color: #66bb6a;
        transition: 0.5s all;
    }

    .blue1:hover .panel {
        background: #ef5350;
        transition: 0.5s all;
    }

    .blue1:hover .blue-txt, .blue1:hover h3 {
        color: #fff;
