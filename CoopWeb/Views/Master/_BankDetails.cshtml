@model Cooperative.Models.BankDetailsViewModel
@{
    Layout = null;

}
<script src="~/Scripts/BankDetails.js"></script>
<script type="text/javascript" src="~/Scripts/1.8.3.jquery.min.js"></script>
<script type="text/javascript" src="~/Scripts/pdfmake.min.js"></script>
<script type="text/javascript" src="~/Scripts/html2canvas.min.js"></script>
<link href="~/Scripts/google_hindi/google_transliteration.css" rel="stylesheet" />



<div class="citizen-dash-head">
    <input type="hidden" id="hdnPLDBId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBId)" />
    <input type="hidden" id="hdnBranchId" value="@(((Cooperative.Models.UserEntity)System.Web.HttpContext.Current.Session[Cooperative.Controllers.SessionIdentity.Admin]).PLDBBrancchId)" />

    @using (Html.BeginForm("SaveBankDetails", "Master", FormMethod.Post, new { @Class = "dev-search-form", id = "formSavebankDetail" }))
    {
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.BankDetails.Id,new { Id="hdnID"})

    <div class="col-lg-12 form-group">
        <div class="col-md-6">
            <label>
                {{translation.PLDB}}
            </label>
            @Html.DropDownListFor(m => m.BankDetails.SocietyID, new SelectList(ViewBag.SocietyMasterList, "SocietyID", "SocietyName"), "--Select PLDB--", new { id = "SocietyID", @class = "form-control" })
        </div>

        <div class="col-md-6">
            <label>
                {{translation.PLDB}} {{translation.Branch}}
            </label>
            @Html.DropDownListFor(m => m.BankDetails.BranchId, new SelectList(ViewBag.PLDBBranch, "SocietyID", "SocietyName"), "--Select PLDB Branch--", new { id = "BranchId", @class = "form-control" })
        </div>


        <div class="col-md-6">
            <label>
                {{translation.BankName}}
            </label>
            @Html.DropDownListFor(m => m.BankDetails.BankID, new SelectList(ViewBag.BankMasterList, "BankId", "BankName"), "--Select Bank--", new { id = "BankID", @class = "form-control" })
        </div>

        @*<div class="col-md-6">
            <label>
                {{translation.ApplicationNo}}
            </label>
            @Html.TextBoxFor(m => m.BankDetails.ApplicationNo, new { @class = "form-control", id = "ApplicationNo", onkeypress = "return ValidateAlpha(event);", autocomplete = "off" })
        </div>*@

        @*<div class="col-md-6">
            <label>
                {{translation.RegistedId}}
            </label>
            @Html.TextBoxFor(m => m.BankDetails.RegID, new { @class = "form-control", id = "RegID", autocomplete = "off" })
        </div>*@
    </div>

    <div class="col-lg-12 form-group">

        <div class="col-md-6">
            <label>
                {{translation.BankBranch}}
            </label>
            @Html.TextBoxFor(m => m.BankDetails.BankBranch, new { @class = "form-control", id = "BankBranch", autocomplete = "off" })
        </div>
        <div class="col-md-6">
            <label>
                {{translation.IFSCCode}}
            </label>
            @Html.TextBoxFor(m => m.BankDetails.IFSCCode, new { @class = "form-control", id = "IFSCCode", autocomplete = "off" })
        </div>
    </div>

    <div class="col-lg-12 form-group">
        <div class="col-md-6">
            <label>
                {{translation.BankAccountNo}}
            </label>
            @Html.TextBoxFor(m => m.BankDetails.BankAccountNo, new { @class = "form-control", id = "BankAccountNo", autocomplete = "off" })
        </div>
        <div class="col-md-6">
            <label>
                {{translation.AccountHolderName}}
            </label>
            @Html.TextBoxFor(m => m.BankDetails.AccHolderName, new { @class = "form-control", id = "AccHolderName", autocomplete = "off" })
        </div>
    </div>

    <div class="col-lg-12 form-group">
        <div class="col-md-6">
            <label>
                {{translation.IsActive}}
            </label>
            @Html.CheckBoxFor(m => m.BankDetails.IsActive, new { id = "IsActive" })
        </div>
    </div>

    <div class="col-lg-12 form-group" style="margin-top: 10px;">
        <div class="dev-menu-btn">
            <button type="button" class="btn btn-primary" onclick="ValidateBankDetailsMaster()">{{translation.Submit}}</button>
            <button type="button" class="btn btn-primary" onclick="Reset()">{{translation.Clear}}</button>
            <button type="button" onclick="back()" class="btn btn-primary dev-btn ng-binding">{{translation.Back}}</button>
        </div>
    </div>
    }

</div>
