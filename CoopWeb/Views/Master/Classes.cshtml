<script src="~/Scripts/AngularFramework/Classes.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>
@Html.Hidden("TemplateId")
<div ng-app="AppClassesFormat">
    <div ng-controller="Classes">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.Classes}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.Classes}} </span>
                    </li>
                    <!-- Trigger the modal with a button -->
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" data-target="#myModal" ng-click="ClearClassForm()">
                            <h5>&#187; {{translation.AddClasses}}</h5>
                        </button>
                    </li>

                </ul>
            </div>
        </div>

        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearClassForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.Classes}} </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" name="MyClassForm" style="overflow: hidden; margin-bottom:35px;">
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : MyClassForm.Classnameen.$invalid && !MyClassForm.Classnameen.$pristine }">
                                <label>{{translation.ClassNameen}}</label>
                                <input type="text" class="form-control" name="Classnameen" ng-bind="Classnameen" ng-model="Classes.ClassNameEn" placeholder={{translation.ClassNameen}} ng-required="true" autocomplete="off" />
                                <label ng-show="MyClassForm.TemplateHeadingEN.$error.required && !MyClassForm.Classnameen.$pristine" class="help-block">{{translation.Classnameen}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : MySMSForm.Classnamehin.$invalid && !MySMSForm.Classnamehin.$pristine }">
                                <label>{{translation.ClassNamehin}}</label>
                                <input type="text" class="form-control" name="Classnamehin" ng-bind="Classnamehin" ng-model="Classes.ClassNameHi" placeholder={{translation.ClassNamehin}} ng-required="true" autocomplete="off" />
                                <label ng-show="MyClassForm.TemplateHeadingHI.$error.required && !MyClassForm.TemplateHeadingHI.$pristine" class="help-block">{{translation.Classnamehin}} - {{translation.Required}}</label>

                            </div>

                            <div class="form-group col-md-6">
                                <div class="form-check form-check-inline col-md-4" style="padding: 0;">
                                    <label class="check-box" for="inlineRadio1"> {{translation.IsActive}} </label>
                                </div>
                                <div class="check-item col-md-2">

                                    <input class="form-check-input" type="checkbox" id="inlineCheckbox1" ng-true-value="true" ng-false-value="false" ng-model="Classes.IsActive" ng-checked="Classes.IsActive" />
                                </div>
                            </div>

                            <div class="form-group col-md-12">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-disabled="MyClassForm.$invalid" ng-click="SaveClasses()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearClassForm()">{{translation.Clear}}</button>
                                    <input type="hidden" ng-model="Classes.ClassId" />

                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <div class="" ng-show="DivSms">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4" style="padding-left: 0;">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                        <div class="col-md-4" style="padding-top: 25px; ">
                            <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                        </div>
                    </div>
                    <table class="table devtable"     id="tblgetsuport">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('ClassNameEn')">
                                    {{translation.ClassNameen}}
                                    <div ng-class="getSortClass('ClassNameEn')"></div>
                                </th>
                                <th ng-click="sortData('ClassNameHi')">
                                    {{translation.ClassNamehin}}
                                    <div ng-class="getSortClass('ClassNameHi')"></div>
                                </th>


                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                                <th>
                                    {{translation.Delete}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="Class in ClassesData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="ClassesFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>
                                    {{Class.ClassNameEn}}
                                </td>
                                <td>
                                    {{Class.ClassNameHi}}
                                </td>

                                <td>
                                    <div class="dev-action">
                                        @*<input  type="text" value="{{sms.IsActive}}"/>*@
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Class.IsActive == 1" ng-click="SetStatus(Class.ClassId,Class.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Class)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(Class.ClassId,2)"></i>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="ClassesFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">

                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                </div>

            </div>
            <div class="col-md-2" ng-show="DivSms">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>




