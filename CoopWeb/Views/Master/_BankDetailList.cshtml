@model Cooperative.Models.BankDetailsViewModel
@{

    Layout = null;
}


<table id="tblgetsuport" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;" ng-app="BankDetailsMasterMOD" ng-controller="BankDetailsMasterCONT">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                {{translation.PLDB}}
            </th>

            <th>
                {{translation.PLDB}} {{translation.Branch}}
            </th>


            @*
            <th>
                {{translation.ApplicationNo}}
            </th>
            <th>
                {{translation.RegistedId}}
            </th>*@
            <th>
                {{translation.BankName}}
            </th>
            <th>
                {{translation.BankBranch}}
            </th>
            <th>
                {{translation.IFSCCode}}
            </th>
            <th>
                {{translation.BankAccountNo}}
            </th>
            <th>
                {{translation.AccountHolderName}}
            </th>
            <th>
                {{translation.Status}}
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
        Cooperative.Models.DataPagingModel PagingModel = (Cooperative.Models.DataPagingModel)ViewBag.DataPagingModel;
        int index = PagingModel.PageSize;
        if(PagingModel.PageNumber == 1)
        {
        index = PagingModel.PageNumber;
        }
        else
        {

        int pageN = (((PagingModel.PageNumber - 1) * PagingModel.PageSize) + 1);

        index = pageN;
        }
        }
        @foreach (var item in Model.BankDetailsList)
        {
        <tr>
            @{
            var Id = item.Id;
            var actionId = item.IsActive==true?1:0;
            }
            @Html.HiddenFor(modelItem => item.IsActive, new { id="IsActive"})
            <td> @(index++)</td>
            <td>
                @Html.DisplayFor(modelItem => item.SocietyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PLDBBranchName)
            </td>
            @*
            <td>
                @Html.DisplayFor(modelItem => item.ApplicationNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegID)
            </td>*@
            <td>
                @Html.DisplayFor(modelItem => item.BankMaster_Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BankBranch)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IFSCCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BankAccountNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccHolderName)
            </td>
            <td>
                <div class="dev-action">

                    <label class="switch">
                        <input type="checkbox" ng-checked="@actionId == 1" onclick="deleteDetails(@Id,@actionId)">
                        <span class="slider round"></span>
                    </label>
                </div>
            </td>


            <td class="add-more-td">
                <a href="javascript:void(0);" name="editText" onclick="update(@item.Id)" ng-click="AddNew()"><i class="fa fa-edit"></i></a>
                <a href="javascript:void(0);" onclick="deleteDetails(@item.Id,2)"><i class="fa fa-trash"></i></a>
            </td>
        </tr>
        }
    </tbody>
</table>

@Html.Partial("DataPaging")