<script src="~/Scripts/AngularFramework/MastersClient.js"></script>

<div ng-app="MastersWidgetModule" ng-controller="MastersWidgetCont">

  
    <div class="devpage-breadcrumb">
        <ul class="page-breadcrumb">
            <li class="dev-page-br">
                <i class="fa fa-home"> </i>
                <a href="#"> {{translation.Master}} </a>
                <i class="fa fa-angle-right"> </i>
            </li>
            <li style="float: left">
                <span style="margin: 0 5px;"> {{translation.Widget}} </span>
            </li>
          
        </ul>
    </div>

    <div class="col-md-12">
        <form class="dev-search-form" style="overflow: hidden; margin-bottom:35px;">
            <div class="form-group col-md-6">
                <label>Widget Title Name Hindi</label>
                <input type="text" class="form-control" name="widgetTitleNameHi" ng-model="MastersModule.WidgetTitleNameHi" placeholder="Widget Title Name Hindi" autocomplete="off" ng-required="true" />
            </div>
            <div class="form-group col-md-6">
                <label>Widget Title Name English</label>
                <input type="text" class="form-control" name="widgetTitleNameHi" ng-model="MastersModule.WidgetTitleNameHi" placeholder="Widget Title Name Hindi" autocomplete="off" ng-required="true" />
            </div>
            <div class="form-group col-md-6">
                <label>Widget Sub Title Name Hindi</label>
                <input type="text" class="form-control" name="widgetSubTitleNameHi" ng-model="MastersModule.WidgetSubTitleNameHi" placeholder="Widget Sub Title Name Hindi" autocomplete="off" ng-required="true" />
            </div>
            <div class="form-group col-md-6">
                <label>Widget Sub Title Name English</label>
                <input type="text" class="form-control" name="widgetSubTitleNameEn" ng-model="MastersModule.WidgetSubTitleNameEn" placeholder="Widget Sub Title Name English" autocomplete="off" ng-required="true" />
            </div>
            <div class="form-group col-md-6">
                <label>Widget Data Query</label>
                <input type="text" class="form-control" name="widgetDataQuery" ng-model="MastersModule.WidgetDataQuery" placeholder="Widget Data Query" autocomplete="off" ng-required="true" />
            </div>
            <div class="form-group col-md-6">
                <label>Widget Version</label>
                <input type="text" class="form-control" name="widgetVersion" ng-model="MastersModule.Version" placeholder="Widget Version" autocomplete="off" ng-required="true" />
            </div>
            <div class="form-group col-md-6">
                <label>Widget Remarks</label>
                <input type="text" class="form-control" name="widgetRemarks" ng-model="MastersModule.Remarks" placeholder="Widget Remarks" autocomplete="off" ng-required="true" />
            </div>


            <div class="form-group col-md-6">
                <label>Widget Type</label>
                <select class="form-control" name="ddlWidgetType" ng-model="MastersModule.WidgetTypeId">
                    <option value="" disabled>Select Widget Type</option>
                    <option ng-repeat="item in WidgetType.list" ng-show="item.WidgetTypeId >0" value="{{item.WidgetTypeName}}">
                        {{item.WidgetTypeNameEn}}
                    </option>
                </select>
            </div>

            <div class="form-group col-md-6">
                <label>Widget Colour</label>
                <select class="form-control" name="ddlWidgetColor" ng-model="MastersModule.WidgetColor">
                    <option value="" disabled>Select Widget Color</option>
                    <option ng-repeat="item in WidgetColor.list" ng-show="item.WidgetColor >0" value="{{item.WidgetColor}}">
                        {{item.WidgetColor}}
                    </option>
                </select>
            </div>

            <div class="form-group col-md-6 col-xs-12" style="margin-top: 20px;">
                <div class="form-check form-check-inline col-md-2 col-xs-6" style="padding: 0;">
                    <label class="check-box" for="inlineRadio1"> Active ? </label>
                </div>
                <div class="check-item col-md-2">
                    <input type="checkbox" ng-model="MastersModule.IsActive" ng-checked="MastersModule.IsActive == 1">
                </div>
            </div>



            <div class="form-group col-md-12">
                <div class="dev-menu-btn" style="margin-top: 20px;">
                    <button type="submit" class="btn btn-primary" ng-click="SaveWidget()">SUBMIT</button>
                    <button type="submit" class="btn btn-primary" ng-click="ClearWidget()">CLEAR</button>
                </div>
            </div>
        </form>
    </div>
    <div class="" ng-show="DivWidget">
        <div class="col-md-12 dev-search-form">
            <div class="col-md-2">
                <h4> {{translation.Page}}: {{ currentPage }} </h4>
            </div>
            <div class="col-md-5">
                <label for="search">{{translation.Search}}:</label>
                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}}>
            </div>
            <div class="col-md-5">
                <label for="search">{{translation.ItemPerPage}}:</label>
                <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
            </div>
        </div>

        <div class="col-md-12">
            <div class="table-responsive citizen-dash-head">
                <table class="table devtable">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th ng-click="sortData('WIDGET_ENG')">
                                {{translation.WidgetEN}}
                                <div ng-class="getSortClass('WIDGET_ENG')"></div>
                            </th>
                            <th ng-click="sortData('WIDGET_MANGAL')">
                                {{translation.WidgetHi}}
                                <div ng-class="getSortClass('WIDGET_MANGAL')"></div>
                            </th>
                            <th>
                                Widget Type
                            </th>
                            <th>
                                Widget Colour
                            </th>
                            <th>
                                Creation Date
                            </th>
                            <th>
                                Is Active?
                            </th>
                            <th>
                                Action
                            </th>
                            <th>
                                Delete
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="items in Widget | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="WidgetPagination">
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{ items.WIDGET_ENG }}</td>
                            <td>{{ items.WIDGET_MANGAL }}</td>
                            <td> </td>
                            <td> </td>
                            <td> </td>
                            <td>
                                <div class="dev-action">
                                    <label class="switch">
                                        <input type="checkbox" checked>
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </td>
                            <td> <i class="fa fa-edit" ng-click="update(sms)"></i> </td>
                            <td> <i class="fa fa-trash" ng-click="deleterecord(sms.TemplateId)"></i> </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-12">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="MenuActionPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="form-group col-md-12">
            <div class="dev-align-btn">

                <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
            </div>

        </div>
    </div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
