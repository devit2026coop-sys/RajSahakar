<script src="~/Scripts/AngularFramework/Rajfed_PurchaseCenter.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>
<div ng-app="PurchaseCenterMastersModule">
    <div ng-controller="PurchaseCenterMasterCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.PurchaseCenter}}</h3>
            <hr style="margin: 0;">
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">  {{translation.PurchaseCenter}}</span>
                    </li>
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" ng-click="ClearPurchaseCenterForm()"> <h5>&#187; {{translation.AddPurchaseCenter}}</h5> </button>
                    </li>

                </ul>
            </div>
        </div>

        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-md-4" style="padding-left: 0;">
                        <label for="search">{{translation.Search}}:</label>
                        <input ng-model="q" id="search" class="form-control" placeholder="{{translation.filttertext}}" autocomplete="off">
                    </div>
                    <div class="col-md-4">
                        <label for="search">{{translation.ItemPerPage}}:</label>
                        <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                    </div>
                    <div class="col-md-4" style="padding-top: 25px; ">
                        <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                    </div>
                </div>
            </div>
            <div class="dev-popup-body modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false" >
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" ng-click="ClearPurchaseCenterForm()">&times;</button>
                            <h4 class="modal-title"> {{translation.AddPurchaseCenter}} </h4>
                        </div>
                        <div class="modal-body">
                            <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="PurchaseCenterForm">

                                <div class="col-md-6">
                                    <label>
                                        {{translation.DistrictHeading}} :
                                    </label>

                                    <select ng-model="PurchaseCenterMaster.DistrictId" class="form-control" ng-init="PurchaseCenterMaster.DistrictId='0'">
                                        <option value="0" disabled>{{translation.SelectOption}}-</option>
                                        <option ng-repeat="item in Districts" value="{{item.DISTRICT_ID}}">
                                            {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                                        </option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label>
                                        {{translation.Commodity}} :
                                    </label>

                                    <select ng-model="PurchaseCenterMaster.CommodityId" class="form-control" ng-init="PurchaseCenterMaster.CommodityId='0'">
                                        <option value="0" disabled>{{translation.SelectOption}}-</option>
                                        <option ng-repeat="item in ItemList" value="{{item.CommodityId}}">
                                            {{_language =='en-us' ?  item.CommodityNameEn : item.CommodityNameHi}}
                                        </option>
                                    </select>

                                </div>

                                

                                <div class="form-group col-md-6">
                                    <label>{{translation.PurchaseCenterName_En}}</label>
                                    <input type="text" class="form-control" name="PurchaseCenterName_En" ng-model="PurchaseCenterMaster.PurchaseCenterName_En" placeholder={{translation.PurchaseCenterName_En}} ng-required="true" autocomplete="off" />
                                    <label ng-show="PurchaseCenterForm.PurchaseCenterName_En.$error.required && !PurchaseCenterForm.PurchaseCenterName_En.$pristine" class="help-block">{{translation.PurchaseCenterName_En}} - {{translation.Required}}</label>
                                </div>
                                <div class="form-group col-md-6">
                                    <label>{{translation.PurchaseCenterName_Hi}}</label>
                                    <input type="text" class="form-control" name="PurchaseCenterName_Hi" ng-bind="PurchaseCenterName_Hi" ng-model="PurchaseCenterMaster.PurchaseCenterName_Hi" placeholder={{translation.PurchaseCenterName_Hi}} ng-required="true" autocomplete="off" />
                                    <label ng-show="PurchaseCenterForm.PurchaseCenterName_Hi.$error.required && !PurchaseCenterForm.PurchaseCenterName_Hi.$pristine" class="help-block">{{translation.PurchaseCenterName_Hi}} - {{translation.Required}}</label>
                                </div>
                                <div class="form-group col-md-6">
                                    <label class="check-box" for="inlineRadio1"> {{translation.IsActive}} </label>

                                    <input class="form-check-input ng-pristine ng-untouched ng-valid ng-not-empty" type="checkbox" id="inlineCheckbox1" ng-true-value="true" ng-false-value="false" ng-model="PurchaseCenterMaster.IsActive" ng-checked="PurchaseCenterMaster.IsActive">

                                </div>

                                <div class="col-md-12">
                                    <div class="dev-menu-btn">
                                        <button type="submit" class="btn btn-primary" ng-disabled="PurchaseCenterForm.$invalid" ng-click="SavePurchaseCenterForm()">{{translation.Submit}}</button>
                                        <button type="submit" class="btn btn-primary" ng-click="ClearPurchaseCenterForm()">{{translation.Clear}}</button>
                                        <input type="hidden" ng-model="PurchaseCenterForm.PurchaseCenterId" />
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive citizen-dash-head">
                <table class="table devtable" id="tblgetsuport">
                    <thead>
                        <tr>
                            <th>
                                {{translation.SRNO}}
                            </th>
                            <th ng-click="sortData('PurchaseCenterName_En')">
                                {{translation.PurchaseCenterName_En}}
                                <div ng-class="getSortClass('PurchaseCenterName_En')"></div>
                            </th>
                            <th ng-click="sortData('PurchaseCenterName_Hi')">
                                {{translation.PurchaseCenterName_Hi}}
                                <div ng-class="getSortClass('PurchaseCenterName_Hi')"></div>
                            </th>
                            <th>
                                {{translation.IsActive}}
                            </th>
                            <th>
                                {{translation.Edit}}
                            </th>
                            <th>
                                {{translation.Delete}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="Class in PurchaseCenterData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="PurchaseCenterPagination">
                            <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                            <td>{{ Class.PurchaseCenterName_En}}</td>
                            <td>{{ Class.PurchaseCenterName_Hi }}</td>
                            <td>
                                <div class="dev-action">

                                    <label class="switch">

                                        <input type="checkbox" ng-checked="Class.IsActive == 1" ng-click="SetStatus(Class.PurchaseCenterId,Class.IsActive)">

                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </td>
                            <td>
                                <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Class)"></i>
                            </td>
                            <td>
                                <i class="fa fa-trash" ng-click="SetStatus(Class.PurchaseCenterId,2)"></i>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>


        <div class="col-md-10">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="PurchaseCenterPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="form-group col-md-12">
            <div class="dev-align-btn">

                <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
            </div>

        </div>
        <div class="col-md-2">
            <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
        </div>

    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
