
@{
    ViewBag.Title = "LiablitiesForm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<h2>LiablitiesForm</h2>*@

<script src="~/Scripts/AngularFramework/MastersClient.js"></script>
@*<h2>BuissnessForm</h2>*@
<div ng-app="MastersModule" ng-controller="MasterCont">
    <!-- Trigger the modal with a button -->
    <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal"> <h5>&#187; {{translation.AddSMSModel}}</h5> </button>


    <div class="dev-popup-body modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" ng-click="ClearTemplateForm()">&times;</button>
                    <h4 class="modal-title"> {{translation.Sms}} </h4>
                </div>
                <div class="modal-body">
              <form class="dev-search-form"  style="overflow: hidden; margin-bottom:35px;" name="BuissnessForm">
                        <div class="col-md-12">
                            <div class="form-group col-md-4">
                                <label>{{translation.BuissnessName }}<span class="error">*</span></label>
                                <input type="text" name="EngBuissnessName" class="form-control" placeholder="Buissness Name" ng-model="LiablitiesRegistration.LiablityNameEn" autocomplete="off" required>

                            </div>
                            <div class="form-group col-md-4">
                                <label>{{translation.BuissnessName}}<span class="error">*</span></label>
                                <input type="text" name="CEOName" class="form-control" placeholder="{{translation.BuissnessName}}" ng-model="LiablitiesRegistration.LiablityNameHi" autocomplete="off" required>

                            </div>
                        </div>
                        <div class="form-group col-md-12">
                            <div class="dev-align-btn">
                                <button type="submit" class="btn btn-primary dev-btn" ng-disabled="BuissnessForm.$invalid" ng-click="SaveLiablitiesRegistration()">{{translation.Submit}}</button>
                                <button type="button" class="btn btn-primary dev-btn" ng-click="ClearBuissnessLiabilities()">{{translation.Clear}}</button>
                            </div>
                        </div>
                    </form>
                </div>


            </div>

        </div>
    </div>
    <div>
        {{newdiv}}
    </div>

</div>





