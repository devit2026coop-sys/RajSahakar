<script src="~/Scripts/AngularFramework/MastersClient.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>
<div ng-app="MastersModule">
    <div ng-controller="MasterCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.Ward}}</h3>
            <hr style="margin: 0;">
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.Ward}} </span>
                    </li>
                    @*<li style="float: right;" id="divAddBtn">
                            <a ng-click="AddNewSociety()" style="color: #025e63; cursor: pointer; text-decoration:none; font-weight: bold;" class="ng-binding">» नई सोसायटी प्रोफाइल जोड़ें</a>
                        </li>*@
                </ul>
            </div>

        </div>
        <div class="col-md-12">
            <div class="citizen-dash-head">
                <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;">
                    <div class="col-md-3">
                        <label>   {{translation.DivisionHeading}} :</label>
                        <select class="form-control" ng-model="ddlDivisions" ng-options="_language == 'en-us' ?  item.DIVISION_ENG : item.DIVISION_MANGAL for item in Divisions" ng-change="DistrictList()">
                            <option value="" disabled>{{translation.SelectOption}}</option>

                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>
                            {{translation.District}} :
                        </label>
                        <select class="form-control" ng-model="ddlDistrct" ng-change="CityList()" ng-options="_language == 'en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL for item in Districts">
                            <option value="" disabled>{{translation.SelectOption}}</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>
                            {{translation.City}} :
                        </label>
                        <select class="form-control" ng-options="_language == 'en-us' ?  item.CITY_ENG : item.CITY_MANGAL for item in City" ng-model="ddlCity">
                            <option value="" disabled>{{translation.SelectOption}}</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="button" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="WardList()">{{translation.Show}}</button>
                    </div>
                </form>
            </div>
            </div>


        <div class="col-md-12" ng-show="DivWard">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-md-12 dev-search-form">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                        </div>
                        <div class="col-md-4" style="padding-top: 25px; ">
                            <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                        </div>
                    </div>
                    <br>
                    <div class="col-md-12">
                        <div class="table-responsive citizen-dash-head">
                            <table class="table devtable"     id="tblgetsuport">
                                <caption>
                                    <h2>{{translate.WardHeading}}</h2>
                                </caption>
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th ng-click="sortData('WARD_ENG')">
                                            {{translation.WardEng}}
                                            <div ng-class="getSortClass('WARD_ENG')"></div>
                                        </th>
                                        <th ng-click="sortData('WARD_MANGAL')">
                                            {{translation.WardHindi}}
                                            <div ng-class="getSortClass('WARD_MANGAL')"></div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="items in Ward | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="WardPagination">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ items.WARD_ENG }}</td>
                                        <td>{{ items.WARD_MANGAL }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="WardPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="dev-align-btn">

                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                        </div>

                    </div>
                    <div class="col-md-2">
                        <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>