<script src="~/Scripts/AngularFramework/Office.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()

</script>
<div ng-app="OfficeMastersModule">
    <div ng-controller="OfficeMasterCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.Office}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.Office}} </span>
                    </li>
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal" ng-click="ClearOfficeForm()"> <h5>&#187; {{translation.AddOffice}}</h5> </button>
                    </li>

                </ul>
            </div>
        </div>

        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearOfficeForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.AddOffice}} </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OfficeForm">
                            <div class="col-md-6">
                                <label>
                                    {{translation.DepartmentHeading}} :
                                </label>

                                <select ng-model="OfficeMaster.DepartmentId" class="form-control" ng-init="OfficeMaster.DepartmentId='0'" ng-change="GetOrganisations()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Departments" value="{{item.ID}}">
                                        {{_language =='en-us' ?  item.DEPTNAMEENGLISH : item.DEPTNAMEHINDI}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    {{translation.Organisation}} :
                                </label>
                                <select ng-model="OfficeMaster.OrganisationId" class="form-control" ng-init="OfficeMaster.OrganisationId='0'" ng-change="GetLevels()">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Organisations" value="{{item.OrganisationId}}">
                                        {{_language =='en-us' ?  item.OrganisationNameEn : item.OrganisationNameHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    {{translation.Level}} :
                                </label>
                                <select ng-model="OfficeMaster.OrganizationLevelsMappingID" class="form-control" ng-init="OfficeMaster.OrganizationLevelsMappingID='0'">
                                    <option value="0" disabled>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in Levels" value="{{item.MappingID}}">
                                        {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                                    </option>
                                </select>
                            </div>
                            <div class="form-group col-md-6">
                                <label>{{translation.OfficeNameEng}}</label>
                                <input type="text" class="form-control" name="OfficeNameEng1" ng-model="OfficeMaster.OfficeNameEn" placeholder={{translation.OfficeNameEng}} ng-required="true" autocomplete="off" />
                                <label ng-show="OfficeForm.OfficeNameEng.$error.required && !OfficeForm.OfficeNameEng.$pristine" class="help-block">{{translation.OfficeNameEng}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6">
                                <label>{{translation.OfficeNameHin}}</label>
                                <input type="text" class="form-control" name="OfficeNAmeHin" ng-bind="OfficeNameHi" ng-model="OfficeMaster.OfficeNameHi" placeholder={{translation.OfficeNameEng}} ng-required="true" autocomplete="off" />
                                <label ng-show="OfficeForm.OfficeNameHin.$error.required && !OfficeForm.OfficeNameHin.$pristine" class="help-block">{{translation.OfficeNameHin}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6">
                                <div class="form-check form-check-inline col-md-4" style="padding: 0;">
                                    <label class="check-box" for="inlineRadio1"> {{translation.IsActive}} </label>
                                </div>
                                <div class="check-item col-md-2">

                                    <input class="form-check-input ng-pristine ng-untouched ng-valid ng-not-empty" type="checkbox" id="inlineCheckbox1" ng-true-value="true" ng-false-value="false" ng-model="OfficeMaster.IsActive" ng-checked="OfficeMaster.IsActive">
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-disabled="OfficeForm.$invalid" ng-click="SaveOfficeForm()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearOfficeForm()">{{translation.Clear}}</button>
                                    <input type="hidden" ng-model="OfficeMaster.OfficeId" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>





        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                        <div class="col-md-4">
                            <label>
                                {{translation.DepartmentHeading}} :
                            </label>

                            <select ng-model="OfficeMaster.DepartmentId" class="form-control" ng-init="OfficeMaster.DepartmentId='0'" ng-change="GetAllOfficeListByDept();GetOrganisations()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Departments" value="{{item.ID}}">
                                    {{_language =='en-us' ?  item.DEPTNAMEENGLISH : item.DEPTNAMEHINDI}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>
                                {{translation.Organisation}} :
                            </label>
                            <select ng-model="OfficeMaster.OrganisationId" class="form-control" ng-init="OfficeMaster.OrganisationId='0'" ng-change="GetAllOfficeListByOrg();GetLevels()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Organisations" value="{{item.OrganisationId}}">
                                    {{_language =='en-us' ?  item.OrganisationNameEn : item.OrganisationNameHi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>
                                {{translation.Level}} :
                            </label>
                            <select ng-model="OfficeMaster.OrganizationLevelsMappingID" class="form-control" ng-init="OfficeMaster.OrganizationLevelsMappingID='0'" ng-change="GetAllOfficeListBylbl()">
                                <option value="0" disabled>{{translation.SelectOption}}</option>
                                <option ng-repeat="item in Levels" value="{{item.MappingID}}">
                                    {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                                </option>
                            </select>
                        </div>
                        <div class="col-xs-4" style="padding-top: 25px; ">
                            <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                        </div>
                    </div>
                    <table class="table devtable"        id="tblgetsuport">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('OfficeNameEn')">
                                    {{translation.OfficeNameEng}}
                                    <div ng-class="getSortClass('OfficeNameEn')"></div>
                                </th>
                                <th ng-click="sortData('OfficeNameHi')">
                                    {{translation.OfficeNameHin}}
                                    <div ng-class="getSortClass('OfficeNameHi')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'DEPTNAMEENGLISH' : 'DEPTNAMEHINDI')">
                                    {{translation.DepartmentHeading}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'DEPTNAMEENGLISH' : 'DEPTNAMEHINDI')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'OrganisationNameEn' : 'OrganisationNameHi')">
                                    {{translation.Organisation}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'OrganisationNameEn' : 'OrganisationNameHi')"></div>
                                </th>
                                <th ng-click="sortData(_language =='en-us' ? 'LevelNameEn' : 'LevelNameHi')">
                                    {{translation.Level}}
                                    <div ng-class="getSortClass(_language =='en-us' ? 'LevelNameEn' : 'LevelNameHi')"></div>
                                </th>
                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                                <th>
                                    {{translation.Delete}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="Class in OfficeData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ Class.OfficeNameEn }}</td>
                                <td>{{ Class.OfficeNameHi }}</td>
                                <td>{{_language =='en-us' ?  Class.DEPTNAMEENGLISH : Class.DEPTNAMEHINDI}}</td>
                                <td>{{_language =='en-us' ?  Class.OrganisationNameEn : Class.OrganisationNameHi}}</td>
                                <td>{{_language =='en-us' ?  Class.LevelNameEn : Class.LevelNameHi}}</td>
                                <td>

                                    <div class="dev-action">

                                        <label class="switch">

                                            <input type="checkbox" ng-checked="Class.IsActive == 1" ng-click="SetStatus(Class.OfficeId,Class.IsActive)">

                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Class)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(Class.OfficeId,2)"></i>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">

                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                </div>

            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
