
<script src="~/Scripts/AngularFramework/BuissnessForm.js"></script>

<div ng-app="AppBuissnessForm">
    <div ng-controller="Buissness">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.Buissness}}</h3>
            <hr style="margin: 0;">
        </div>    
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">                      
                        <span style="margin: 0 5px;"> {{translation.Buissness}} </span>
                    </li>
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;" data-target="#myModal" ng-click="ClearBuisnessForm()"> <h5>&#187; {{translation.AddBuissness}}</h5> </button>
                    </li>
                    
                </ul>
            </div>
        </div>

        <!-- Trigger the modal with a button -->


        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearBuisnessForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.AddBuissness}} </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" name="MyBuisnessForm" style="overflow: hidden; margin-bottom:35px;">
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : MyBuisnessForm.BusinessNameEn.$invalid && !MyBuisnessForm.BusinessNameEn.$pristine }">
                                <label>{{translation.BuissnessNameEn}}</label>
                                <input type="text" class="form-control" name="BusinessNameEn" ng-model="Buisness.BusinessNameEn" placeholder={{translation.BuissnessNameHi}} ng-required="true" autocomplete="off" />
                                <label ng-show="MyBuisnessForm.BusinessNameEn.$error.required && !MyBuisnessForm.BusinessNameEn.$pristine" class="help-block">{{translation.BusinessNameEn}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : MyBuisnessForm.BuissnessNameHi.$invalid && !MyBuisnessForm.BuissnessNameHi.$pristine }">
                                <label>{{translation.BuissnessNameHi}}</label>
                                <input type="text" class="form-control" name="BusinessNameHi" ng-model="Buisness.BusinessNameHi" placeholder={{translation.BuissnessNameHi}} ng-required="true" autocomplete="off" />
                                <label ng-show="MyBuisnessForm.BuissnessNameHi.$error.required && !MyBuisnessForm.BuissnessNameHi.$pristine" class="help-block">{{translation.BuissnessNameHi}} - {{translation.Required}}</label>

                            </div>

                            <div class="form-group col-md-6">
                                <div class="form-check form-check-inline col-md-4" style="padding: 0;">
                                    <label class="check-box" for="inlineRadio1"> {{translation.IsActive}} </label>
                                </div>

                                <div class="check-item col-md-2">

                                    <input class="form-check-input ng-pristine ng-untouched ng-valid ng-not-empty" type="checkbox" id="inlineCheckbox1" ng-true-value="true" ng-false-value="false" ng-model="Buisness.IsActive" ng-checked="Buisness.IsActive">
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-disabled="MyBuisnessForm.$invalid" ng-click="SaveBuissnessRegister()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearBuisnessForm()">{{translation.Clear}}</button>
                                    <input type="hidden" ng-model="Buisness.businessId" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="" ng-show="DivSms">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                    </div>
                    <table class="table devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('BusinessNameEn')">
                                    {{translation.BuissnessNameEn}}
                                    <div ng-class="getSortClass('BusinessNameEn')"></div>
                                </th>
                                <th ng-click="sortData('BusinessNameHi')">
                                    {{translation.BuissnessNameHi}}
                                    <div ng-class="getSortClass('BusinessNameHi')"></div>
                                </th>
                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                                <th>
                                    {{translation.Delete}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="items in BuisnesData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="BuisnessPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ items.BusinessNameEn }}</td>
                                <td>{{ items.BusinessNameHi }}</td>
                                <td>
                                    <div class="dev-action">

                                        <label class="switch">
                                            <input type="checkbox" ng-checked="items.IsActive == 1" ng-click="SetStatus(items.BusinessId,items.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>

                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(items)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(items.BusinessId,2)"></i>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="BuisnessPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2"  ng-show="DivSms">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>



