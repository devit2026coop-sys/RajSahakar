<script src="~/Scripts/AngularFramework/MastersClient.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>
<div ng-app="MastersModule">
    <div ng-controller="MasterCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.Village}}</h3>
            <hr style="margin: 0;">
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.Village}} </span>
                    </li>

                </ul>
            </div>
        </div>

        <div class="col-md-12">
            <form class="dev-search-form citizen-dash-head" style="overflow: hidden; margin-bottom: 20px;">
                <div class="col-md-3">
                    <label>  {{translation.DivisionHeading}} :</label>
                    <select class="form-control" ng-model="ddlDivisions" ng-options="_language == 'en-us' ?  item.DIVISION_ENG : item.DIVISION_MANGAL for item in Divisions" ng-change="DistrictList()">
                        <option value="" disabled>{{translation.SelectOption}}-</option>
                        @*<option value="0">{{translation.SelectOption}}-</option>
                            <option ng-repeat="item in Divisions" value="{{item.DIVISION_ID}}">
                                {{_language =='en-us' ?  item.DIVISION_ENG : item.DIVISION_MANGAL}}
                            </option>*@
                    </select>
                </div>

                <div class="col-md-3">
                    <label>  {{translation.District}} : </label>
                    <select class="form-control" ng-model="ddlDistrct" ng-options="_language == 'en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL for item in Districts" ng-change="BlockList()">
                        <option value="" disabled>{{translation.SelectOption}}-</option>
                        @*<option value="0">{{translation.SelectOption}}-</option>
                            <option ng-repeat="item in Districts" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>*@
                    </select>
                </div>

                <div class="col-md-3">
                    <label>
                        {{translation.PanchayatSamiti}} :
                    </label>
                    <select class="form-control" ng-model="ddlBlock" ng-options="_language == 'en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL for item in Blocks" ng-change="GramPanchayatList()">
                        <option value="" disabled>{{translation.SelectOption}}-</option>
                        @*<option value="0">{{translation.SelectOption}}-</option>
                            <option ng-repeat="item in Blocks" value="{{item.BLOCK_ID}}">
                                {{_language =='en-us' ?  item.BLOCK_ENG : item.BLOCK_MANGAL}}
                            </option>*@
                    </select>
                </div>
                <div class="col-md-3">
                    <label>
                        {{translation.GramPanchayat}} :
                    </label>
                    <select class="form-control" ng-options="_language == 'en-us' ?  item.GP_ENG : item.GP_MANGAL for item in GramPanchayats" ng-model="ddlGramPanchayat">
                        <option value="" disabled>{{translation.SelectOption}}-</option>
                        @*<option value="0">{{translation.SelectOption}}-</option>
                            <option ng-repeat="item in GramPanchayats" value="{{item.GP_ID}}">
                                     {{_language =='en-us' ?  item.GP_ENG : item.GP_MANGAL}}
                            </option>*@
                    </select>
                </div>
                <div class="col-md-6">
                    <button type="button" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="VillageList()">{{translation.Show}}</button>
                </div>
            </form>
        </div>

        <div class="col-md-12" ng-show="DivVillage">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-md-12 dev-search-form">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                        </div>
                        <div class="col-md-4" style="padding-top: 25px; ">
                            <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="table-responsive citizen-dash-head">
                            <table class="table devtable"      id="tblgetsuport">
                                <caption>
                                    <h2>{{translate.GramHeading}}</h2>
                                </caption>
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th ng-click="sortData('VILLAGE_ENG')">
                                            {{translation.GramEN}}
                                            <div ng-class="getSortClass('VILLAGE_ENG')"></div>
                                        </th>
                                        <th ng-click="sortData('VILLAGE_MANGAL')">
                                            {{translation.GramHi}}
                                            <div ng-class="getSortClass('VILLAGE_MANGAL')"></div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="items in Villages | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="VillagePagination">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ items.VILLAGE_ENG }}</td>
                                        <td>{{ items.VILLAGE_MANGAL }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="text-center">
                            <dir-pagination-controls boundary-links="true" pagination-id="VillagePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                        </div>
                    </div>
                    <div class="form-group col-md-12">
                        <div class="dev-align-btn">

                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                        </div>

                    </div>
                    <div class="col-md-2">
                        <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>