
<script src="~/Scripts/AngularFramework/AddPurchaseCenter.js"></script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>

<div ng-app="WarehouseCnt">
    <div ng-controller="WarehouseMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">Purchase Center</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;">Add Purchase Center </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowDivForInsert()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; Add New</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divInsert">
            <form class="citizen-dash-head">

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.District}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select id="ddlDistrict" ng-model="PurchaseCenterMaster.DistrictId" class="form-control" ng-init="PurchaseCenterMaster.DistrictId=''">
                            <option value="" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Districts" value="{{item.DISTRICT_CODE}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{translation.Commodity}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="PurchaseCenterMaster.CommodityId" id="Item_Kind" class="form-control validateNewAdd" ng-init="PurchaseCenterMaster.CommodityId=''">
                            <option value="" selected="selected">{{translation.SelectOption}}</option>
                            <option ng-repeat="itm in ItemList" value="{{itm.CommodityId}}">
                                {{_language =='en-us' ?  itm.CommodityNameEn : itm.CommodityNameHi}}
                            </option>
                        </select>
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">Purchase CenterName English<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseCenterMaster.PurchaseCenterName_En" placeholder="Purchase CenterName English" autocomplete="off" onKeyPress="return ValidateAlpha(event);" maxlength="50" />
                    </div>
                    <div class="col-lg-2">Purchase CenterName Hindi<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseCenterMaster.PurchaseCenterName_Hi" placeholder="Purchase CenterName Hindi" autocomplete="off" maxlength="50" />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">KVSS English<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseCenterMaster.KVSS_En" placeholder="KVSS English" autocomplete="off" onKeyPress="return ValidateAlpha(event);" maxlength="50" />
                    </div>
                    <div class="col-lg-2">KVSS Hindi<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input style="width:80%" type="text" id="txtLicenceValidUpto" ng-model="PurchaseCenterMaster.KVSS_Hi" class="form-control SetCalender" placeholder="KVSS Hindi" autocomplete="off" maxlength="50" />
                    </div>
                </div>


                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="SavePurchaseCenterForm()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearForm()">{{translation.Clear}}</button>
                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToList()"> {{translation.Back}}</a>
                        <input type="hidden" ng-model="PurchaseCenterMaster.PurchaseCenterId" />
                    </div>
                </div>

            </form>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="GridWarehouses">

            <div>
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-lg-12 form-group">
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">Search</label>
                                <input ng-model="q" id="search" class="form-control" placeholder="filttertext" autocomplete="off">
                            </div>
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">ItemPerPage</label>
                                <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12 form-group">
                        <h4 class="heading-hr ng-binding">Total No. of Purchase Center :{{PurchaseCenterData.length}}</h4>
                    </div>
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th>
                                    SR NO
                                </th>
                                <th>District</th>
                                <th>Commodity</th>
                                <th>
                                    Purchase CenterName English

                                </th>
                                <th>
                                    Purchase CenterName Hindi

                                </th>
                                <th>KVSS English</th>
                                <th>KVSS Hindi</th>
                                <th>
                                    Status
                                </th>
                                @*<th>Edit</th>*@
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="Class in PurchaseCenterData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="PurchaseCenterPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{Class.District}}</td>
                                <td>{{Class.Commodity}}</td>
                                <td>{{Class.PurchaseCenterName_En}}</td>
                                <td>{{Class.PurchaseCenterName_Hi}}</td>
                                <td>{{Class.KVSSEn}}</td>
                                <td>{{Class.KVSS}}</td>
                                <td>
                                    <div class="dev-action">

                                        <label class="switch">

                                            <input type="checkbox" ng-checked="Class.IsActive == 1" ng-click="SetStatus(Class.PurchaseCenterId,Class.IsActive)">

                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>

                                @*<td><a href="javascript:void(0)"><i class="fa fa-edit" aria-hidden="true" ng-click="Edit(Class)"></i></a></td>*@


                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="PurchaseCenterPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>

