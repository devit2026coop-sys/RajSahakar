

<script src="~/Scripts/AngularFramework/WorkFlowConfiguration.js"></script>
<div ng-app="WorkFlowConfigurationModule">
    <div ng-controller="WorkFlowConfigurationCont">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.WorkFlowConfig}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-md-12">

        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.WorkFlowConfig}} </span>
                    </li>

                </ul>
            </div>

        </div>

        <div class="col-md-12">
            <form class="citizen-dash-head" style="overflow: hidden; margin-bottom: 20px;">

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Page}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="Configuration.MenuId" id="ddlDistrict" class="form-control" ng-init="Configuration.MenuId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Pages" value="{{item.MenuId}}">
                                {{_language=='en-us' ? item.MenuNameEn : item.MenuNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.Level}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" id="ddllevel" ng-model="Configuration.LevelId" ng-init="Configuration.LevelId='0'" ng-change="GetRoleList();">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in LevelList" value="{{item.LevelId}}">
                                {{_language =='en-us' ?  item.LevelNameEn : item.LevelNameHi}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.RoleHeading}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="Configuration.RoleId" class="form-control" ng-init="Configuration.RoleId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Roles" value="{{item.RoleID}}">
                                {{_language =='en-us' ?  item.RoleName_EN : item.RoleName_HI}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.Actions}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="Configuration.SocietyProceesStatusIdParent" class="form-control" ng-init="Configuration.SocietyProceesStatusIdParent='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Actions" value="{{item.SocietyProceesStatusId}}">
                                {{_language =='en-us' ?  item.ProceesStatusTextEn : item.ProceesStatusTextHi}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.NextRole}}</div>
                    <div class="col-lg-4">
                        <select ng-model="Configuration.NextRoleId" id="ddlblock" class="form-control" ng-init="Configuration.NextRoleId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Roles" value="{{item.RoleID}}">
                                {{_language =='en-us' ?  item.RoleName_EN : item.RoleName_HI}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.NextAction}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select ng-model="Configuration.SocietyProceesStatusIdChild" class="form-control" ng-init="Configuration.SocietyProceesStatusIdChild='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Actions" value="{{item.SocietyProceesStatusId}}">
                                {{_language =='en-us' ?  item.ProceesStatusTextEn : item.ProceesStatusTextHi}}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Act}} </div>
                    <div class="col-lg-4">
                        <select ng-model="Configuration.WorkOnActId" class="form-control" ng-init="Configuration.WorkOnActId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="itemAct in ActList" value="{{itemAct.ActId}}">
                                {{_language =='en-us' ?  itemAct.ActNameEn : itemAct.ActNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2"></div>
                    <div class="col-lg-4"></div>
                </div>

                <div class="col-md-12">
                    <center>
                        <button type="button" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="SaveConfiguration()">{{translation.Submit}}</button>
                        <button type="button" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="ClearForm()">{{translation.Clear}}</button>
                        <input type="hidden" ng-model="Action.ApplicationNextActionId" />
                    </center>

                </div>
            </form>
        </div>



        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-md-12">

                        <div class="col-md-12 dev-search-form">
                            <div class="col-xs-4">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-xs-4">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                            </div>
                        </div>
                        <br>

                        <div class="table-responsive citizen-dash-head">
                            <table class="table devtable" id="tblgetsuport">
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.Page}}
                                        </th>
                                        <th>
                                            {{translation.RoleHeading}}
                                        </th>

                                        <th>
                                            {{translation.Actions}}
                                        </th>

                                        <th>
                                            {{translation.NextRole}}
                                        </th>
                                        <th>
                                            {{translation.NextAction}}
                                        </th>
                                        <th>
                                            {{translation.Act}}
                                        </th>
                                        <th>
                                            {{translation.Level}}
                                        </th>
                                        <th>
                                            {{translation.IsActive}}
                                        </th>
                                        <th>
                                            {{translation.Action}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="items in AllWorkFlow | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="BlockPagination">
                                        <td>{{pageSize *(currentPage-1)+$index+1}} {{ items.LevelID}}</td>
                                        <td>{{ _language==='en-us' ?  items.MenuNameEn : items.MenuNameHi }}</td>
                                        <td>{{ _language==='en-us' ?  items.RoleName_EN : items.RoleName_HI }}</td>
                                        <td>{{ _language==='en-us' ?  items.ParentProcessEn : items.ParentProcessHi }}</td>
                                        <td>{{ _language==='en-us' ?  items.NextRoleName_EN : items.NextRoleName_HI }}</td>
                                        <td>{{ _language==='en-us' ?  items.ChildProcessEn : items.ChildProcessHi }}</td>
                                        <td>{{ _language==='en-us' ?  items.ActNameEn_Short : items.ActNameHi_Short }}</td>
                                        <td>{{ _language==='en-us' ?  items.LevelNameEn : items.LevelNameHi }}</td>
                                        <td>{{ items.IsActive ==='True' ?  translation.Yes : translation.No }}</td>
                                        <td>
                                            <i class="fa fa-firefox" title="Set Active/Inactive Status" ng-click="ChangeActionMasterStatus(items.ApplicationNextActionId)"></i> &nbsp;&nbsp;&nbsp;&nbsp;
                                            <i class="fa fa-edit" title="Edit" ng-click="Update(items)"></i> &nbsp;&nbsp;&nbsp;&nbsp;
                                            <i class="fa fa-trash" title="Delete" ng-click="DeleteActionMasterData(items.ApplicationNextActionId)"></i>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>



                <div class="col-md-12">
                    <div class="text-center">
                        <dir-pagination-controls boundary-links="true" pagination-id="BlockPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
                <div class="form-group col-md-12">
                    <div class="dev-align-btn">

                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                    </div>

                </div>
                <div class="col-md-2">
                    <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                </div>
            </div>
        </div>
    </div>

    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>