
<script src="~/Scripts/AngularFramework/SocietyType.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>
<div ng-app="AppSocietyTypeForm">
    <div ng-controller="SocietyTypeCtr">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.SocietyType}}</h3>
            <hr style="margin: 0;">
        </div>
        
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.SocietyType}} </span>
                    </li>

                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal" ng-click="ClearSocietyTypeForm()"> <h5>&#187; {{translation.AddSocietyTypes}}</h5> </button>
                    </li>
                  
                </ul>
            </div>
        </div>

        <!-- Trigger the modal with a button -->




        <div class="dev-popup-body modal fade" id="myModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearSocietyTypeForm()">&times;</button>
                        <h4 class="modal-title"> {{translation.SocietyType}} </h4>
                    </div>
                    <div class="modal-body">
                        <form class="dev-search-form" name="SocietyTypeForm" style="overflow: hidden; margin-bottom:35px;">
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyTypeForm.TypeNameEng.$invalid && !SocietyTypeForm.TypeNameEng.$pristine }">
                                <label>{{translation.TypeNameEng}}</label>
                                <input type="text" class="form-control" name="TypeNameEng" ng-bind="BusinessNameEn" ng-model="SocietyType.TypeameEng" placeholder={{translation.TypeNameEng}} ng-required="true" autocomplete="off" />
                                <label ng-show="SocietyTypeForm.TypeNameEng.$error.required && !SocietyTypeForm.TypeNameEng.$pristine" class="help-block">{{translation.TypeNameEng}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyTypeForm.BuissnessNameHi.$invalid && !SocietyTypeForm.BuissnessNameHi.$pristine }">
                                <label>{{translation.TypeNameHin}}</label>
                                <input type="text" class="form-control" name="TypeNameHin" ng-bind="BusinessNameHi" ng-model="SocietyType.TypeNameHin" placeholder={{translation.BuissnessNameHi}} ng-required="true" autocomplete="off" />
                                <label ng-show="SocietyTypeForm.BuissnessNameHi.$error.required && !SocietyTypeForm.BuissnessNameHi.$pristine" class="help-block">{{translation.BuissnessNameHi}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6" ng-class="{ 'has-error' : SocietyTypeForm.SocietyTypeAmt.$invalid && !SocietyTypeForm.SocietyTypeAmt.$pristine }">
                                <label>{{translation.SocietyTypeAmt}}</label>
                                <input type="text" class="form-control" name="SocietyTypeAmt" maxlength="10" ng-minlength="0" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-bind="SocietyTypeAmt" ng-model="SocietyType.Amount" placeholder={{translation.SocietyTypeAmt}} ng-required="true" autocomplete="off" />
                                <label ng-show="SocietyTypeForm.SocietyTypeAmt.$error.required && !SocietyTypeForm.SocietyTypeAmt.$pristine" class="help-block">{{translation.SocietyTypeAmt}} - {{translation.Required}}</label>
                            </div>
                            <div class="form-group col-md-6">
                                <div class="form-check form-check-inline col-md-4" style="padding: 0;">
                                    <label class="check-box" for="inlineRadio1"> {{translation.IsActive}} </label>
                                </div>
                                <div class="check-item col-md-2">
                                    @*<input class="form-check-input" type="checkbox" id="inlineCheckbox1" value="option1" ng-true-value="1" ng-false-value="0" ng-model="SocietyType.IsActive" />*@
                                    <input class="form-check-input ng-pristine ng-untouched ng-valid ng-not-empty" type="checkbox" id="inlineCheckbox1" ng-true-value="true" ng-false-value="false" ng-model="SocietyType.IsActive" ng-checked="Classes.IsActive">
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-disabled="SocietyTypeForm.$invalid" ng-click="SaveSocietyType()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearSocietyTypeForm()">{{translation.Clear}}</button>
                                    <input type="hidden" ng-model="SocietyType.SocietyTypeId" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
        <div class="" ng-show="DivSms">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>
                        <div class="col-md-4" style="padding-top: 25px; ">
                            <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('tblgetsuport', 'Get Support Data')" value="Export to Excel">
                        </div>
                    </div>
                    <table class="table devtable"       id="tblgetsuport">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('TypeameEng')">
                                    {{translation.TypeNameEng}}
                                    <div ng-class="getSortClass('TypeameEng')"></div>
                                </th>
                                <th ng-click="sortData('TypeNameHin')">
                                    {{translation.TypeNameHin}}
                                    <div ng-class="getSortClass('TypeNameHin')"></div>
                                </th>
                                <th ng-click="sortData('Amount')">
                                    {{translation.SocietyTypeAmt}}
                                    <div ng-class="getSortClass('Amount')"></div>
                                </th>
                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                                <th>
                                    {{translation.Delete}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr dir-paginate="items in SocietyTypeData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SocietyTypePagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ items.TypeameEng | uppercase  }}</td>
                                <td>{{ items.TypeNameHin }}</td>
                                <td>{{ items.Amount }}</td>
                                <td>
                                    <div class="dev-action">

                                        <label class="switch">
                                            <input type="checkbox" ng-checked="items.IsActive == 1" ng-click="SetStatus(items.SocietyTypeId,items.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>

                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(items)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(items.SocietyTypeId,2)"></i>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="SocietyTypePagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">

                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                </div>

            </div>
            <div class="col-md-2" ng-show="DivSms">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>

    </div>
    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
