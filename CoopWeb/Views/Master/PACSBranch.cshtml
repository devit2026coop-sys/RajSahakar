                        <div class="col-lg-2">{{ translation.SocietyName}}<span class="error">*</span></div>
                        <div class="col-lg-4">
                            <input type="text" name="SocietyName" class="form-control" ng-model="Mapping.SocietyName" placeholder="{{translation.ProposedSocietyName}}" autocomplete="off" onKeyPress="return ValidateAlpha(event);" ng-readonly="txtSocietyName">
                        </div>
