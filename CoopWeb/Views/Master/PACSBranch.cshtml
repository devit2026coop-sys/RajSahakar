                <div class="col-md-12" style="margin-top:5px;padding-top:5px">
                    <div class="col-lg-5">&nbsp;</div>
                    <div class="col-lg-6"><button type="button" class="btn btn-primary dev-btn" ng-click="SUBForm()">{{ translation.Submit}}</button></div>

                </div>
            </div>
        </div>
    </div>

    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>