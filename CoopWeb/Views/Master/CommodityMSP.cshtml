
<script src="~/Scripts/AngularFramework/Rajfed_CommodityMSP.js"></script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>

<div ng-app="CommodityMSPCnt">
    <div ng-controller="CommodityMSPMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.CommodityMSP}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.CommodityMSP}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowDivForInsert()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; {{translation.AddCommodityMSP}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divInsert">
            <form class="citizen-dash-head">

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.FincialYearHeading}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="CommodityMSP.FYEAR_ID" ng-init="CommodityMSP.FYEAR_ID='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in FinancialYears" value="{{item.FIN_YEAR_MASTR_ID}}">
                                {{item.FIN_YEAR_NAME}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.Commodity}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="CommodityMSP.CommodityId" ng-init="CommodityMSP.CommodityId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Commodities" value="{{item.CommodityId}}">
                                {{_language =='en-us' ?  item.CommodityNameEn : item.CommodityNameHi}}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">NAFED Price<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="CommodityMSP.Price" placeholder="Price"  autocomplete="off" maxlength="10" />
                    </div>
                    <div class="col-lg-2">Nafed Charges<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="CommodityMSP.NafedChargesa" placeholder="Nafed Chargesa"  autocomplete="off" maxlength="10" />
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">NCCF Price<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="CommodityMSP.msp_nccf" placeholder="Price"  autocomplete="off" maxlength="10" />
                    </div>
                </div>
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">High Charges<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="CommodityMSP.HighCharges" placeholder="High Charges"  autocomplete="off" maxlength="10" />
                    </div>
                    <div class="col-lg-2">Is Active<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="checkbox" ng-model="CommodityMSP.IsActive" />
                    </div>
                </div>


                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="Insert()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearForm()">{{translation.Clear}}</button>
                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToList()"> {{translation.Back}}</a>
                        <input type="hidden" ng-model="CommodityMSP.Msp_Id" />
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="GridWarehouses">
            <div>
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-lg-12 form-group">
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                            </div>
                        </div>
                    </div>
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.FincialYearHeading}}
                                </th>
                                <th>
                                    {{translation.Commodity}}
                                </th>
                                @*<th>
                                    {{translation.Unit}}
                                </th>*@
                                <th>
                                   NAFED {{translation.Price}}
                                </th>
                                <th>
                                    NCCF {{translation.Price}}
                                </th>

                                <th>
                                   Nafed Chargesa
                                </th>

                                <th>
                                    High Charges
                                </th>

                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                                <th>
                                    {{translation.Delete}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in CommodityMSPs | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>
                                    {{ item.FIN_YEAR_NAME}}
                                </td>
                                <td>
                                    {{ _language === 'en-us' ?  item.CommodityNameEn : item.CommodityNameHi}}
                                </td>

                                @*<td>
                                    {{ _language === 'en-us' ?  item.UnitNameEng : item.UnitNameHi}}
                                </td>*@
                                <td>
                                    {{ item.Price}}
                                </td>
                                <td>
                                    {{ item.msp_nccf}}
                                </td>


                                <th>
                                    {{item.NafedChargesa}}
                                </th>

                                <th>
                                    {{item.HighCharges}}
                                </th>

                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="item.IsActive === '1' || item.IsActive === 1 || item.IsActive === true" ng-click="SetStatus(item.Msp_Id,1)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td><a href="javascript:void(0)"><i class="fa fa-edit" aria-hidden="true" ng-click="Edit(item)"></i></a></td>
                                <td><a href="javascript:void(0)"><i class="fa fa-trash" aria-hidden="true" ng-click="SetStatus(item.Msp_Id,2)"></i></a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="TrainningFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>

</div>