
<script src="~/Scripts/AngularFramework/MastersClient.js"></script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>

<div ng-app="LiabilityAssetCnt">
    <div ng-controller="LiabilityAssetMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.LiabilityAsset}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Master}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.LiabilityAsset}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowDivProductInsert()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; {{translation.AddNewLiabilityAsset}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divInsertProduct">
            <form class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.LiabilityAssetNameEng}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="LiabilityAsset.NameEng" placeholder={{translation.LiabilityAssetNameEng}} autocomplete="off" onKeyPress="return ValidateAlpha(event);" maxlength="50" />
                    </div>
                    <div class="col-lg-2">{{ translation.LiabilityAssetNameHi}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="LiabilityAsset.NameHi" placeholder={{translation.LiabilityAssetNameHi}} autocomplete="off" maxlength="50" />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.IsLiability}}</div>
                    <div class="col-lg-4">
                        <input type="radio" name="LiabilityType" ng-checked="true" ng-model="LiabilityAsset.IsLiability" value="1" />&nbsp; {{translation.Yes}} &nbsp;&nbsp;
                        <input type="radio" name="LiabilityType" ng-model="LiabilityAsset.IsLiability" value="2" />&nbsp; {{translation.No}} &nbsp;&nbsp;
                    </div>
                    <div class="col-lg-2">{{ translation.IsFurtherExtended}}</div>
                    <div class="col-lg-4">
                        <input type="radio" name="FurtherExtended" ng-checked="true" ng-model="LiabilityAsset.IsFurtherExtended" value="1" />&nbsp; {{translation.Yes}} &nbsp;&nbsp;
                        <input type="radio" name="FurtherExtended" ng-model="LiabilityAsset.IsFurtherExtended" value="2" />&nbsp; {{translation.No}} &nbsp;&nbsp;
                    </div>
                </div>

                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="Insert()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="Clear()">{{translation.Clear}}</button>
                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToList()"> {{translation.Back}}</a>
                        <input type="hidden" ng-model="LiabilityAsset.LiabilityAssetMasterId" />
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="GridProducts">
            <div>
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-lg-12 form-group">
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                            </div>
                        </div>
                    </div>
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('NameEng')">
                                    {{translation.LiabilityAssetNameEng}}
                                    <div ng-class="getSortClass('NameEng')"></div>
                                </th>
                                <th ng-click="sortData('NameHi')">
                                    {{translation.LiabilityAssetNameHi}}
                                    <div ng-class="getSortClass('NameHi')"></div>
                                </th>
                                <th>
                                    {{translation.IsLiability}}
                                </th>
                                <th>
                                    {{translation.IsFurtherExtended}}
                                </th>
                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                                <th>
                                    {{translation.Delete}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in LiabilityAssetMasterData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>
                                    {{ item.NameEng}}
                                </td>
                                <td>
                                    {{ item.NameHi}}
                                </td>
                                <td>
                                    {{ item.IsLiability === 'True' ? translation.Yes : translation.No }}
                                </td>
                                <td>
                                    {{ item.IsFurtherExtended === 'True' ? translation.Yes : translation.No }}
                                </td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="item.IsActive === 'True'" ng-click="SetStatus(item.LiabilityAssetMasterId,1)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td><a href="javascript:void(0)"><i class="fa fa-edit" aria-hidden="true" ng-click="Edit(item)"></i></a></td>
                                <td><a href="javascript:void(0)"><i class="fa fa-trash" aria-hidden="true" ng-click="SetStatus(item.LiabilityAssetMasterId,2)"></i></a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

           
        </div>
    </div>

</div>