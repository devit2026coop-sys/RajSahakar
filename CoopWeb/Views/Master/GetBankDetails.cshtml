                </li>


            </ul>
        </div>
    </div>
    @*MEMBERS*@
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="ModelList">
        <div class="table-responsive citizen-dash-head">
            <div class="table-dropdown" id="search-filter">
                <div class="col-md-4">
                    <label for="search" class="ng-binding">{{translation.Search}}</label>
                    <input name="searchText" id="search" class="form-control ng-pristine ng-valid ng-empty ng-touched" placeholder="Filter Text" autocomplete="off">
                </div>
                @*<div class="col-md-4">
            <label for="search">{{translation.ItemPerPage}}:</label>
            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
        </div>*@

                <div class="col-md-4">
                    <label>&nbsp;</label><br>
                    <button type="button" onclick="searchRequest()" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                    <button type="button" id="reset" onclick="resetFilter()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                  
                </div>
            </div>
            <div id="DataList">
                @Html.Partial("_BankDetailList")
            </div>

        </div>

    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="display:none" id="addModal" data-backdrop="static" data-keyboard="false" role="dialog">
        @*<div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" onclick="Reset() ">&times;</button>
                <h4 class="modal-title"> {{translation.BankDetails}}</h4>
            </div>*@
