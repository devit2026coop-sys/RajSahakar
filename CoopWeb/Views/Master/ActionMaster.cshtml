

<script src="~/Scripts/AngularFramework/ActionMaster.js"></script>
<div ng-app="ActionMasterModule">
    <div ng-controller="ActionMasterCnt">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.ActionMaster}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-md-12">

        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.ActionMaster}} </span>
                    </li>

                </ul>
            </div>

        </div>

        <div class="col-md-12">
            <form class="citizen-dash-head" style="overflow: hidden; margin-bottom: 20px;">

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.ProcessStatusEn}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="Action.ProcessStatusEn" placeholder={{translation.ProcessStatusEn}} />
                    </div>
                    <div class="col-lg-2">{{ translation.ProcessStatusHi}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="Action.ProcessStatusHi" placeholder={{translation.ProcessStatusHi}} />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Act}} <span class="error">*</span></div>
                    <div class="col-lg-4">

                        <div ng-repeat="item in ActList">
                            <input type="checkbox" name="chkActList" value="{{item.ActId}}" />&nbsp;  {{_language =='en-us' ?  item.ActNameEn : item.ActNameHi}}
                        </div>
                       
                    </div>
                    <div class="col-lg-2">{{ translation.IsEndUserRelated}}</div>
                    <div class="col-lg-4">
                        <input type="checkbox" ng-model="Action.IsEndUserRelated" placeholder={{translation.IsEndUserRelated}} />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.IsActive}}</div>
                    <div class="col-lg-4">
                        <input type="checkbox" ng-model="Action.IsActive" placeholder={{translation.IsActive}} />
                    </div>
                </div>

                <div class="col-md-12">
                    <center>
                        <button type="button" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="SaveActionMasterEntry()">{{translation.Submit}}</button>
                        <button type="button" class="btn btn-primary dev-btn" style="margin-top: 25px;" ng-click="ClearForm()">{{translation.Clear}}</button>
                        <input type="hidden" ng-model="Action.SocietyProceesStatusId" />
                    </center>

                </div>
            </form>
        </div>



        <div class="col-md-12">
            <div class="citizen-dash-head">
                <div class="table-dropdown">
                    <div class="col-md-12">

                        <div class="col-md-12 dev-search-form">
                            <div class="col-xs-4">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-xs-4">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                            </div>
                        </div>
                        <br>

                        <div class="table-responsive citizen-dash-head">
                            <table class="table devtable" id="tblgetsuport">
                                <caption>
                                    <h2>{{translate.TehsilHeading}}</h2>
                                </caption>
                                <thead>
                                    <tr>
                                        <th>
                                            {{translation.SRNO}}
                                        </th>
                                        <th>
                                            {{translation.ProcessStatusEn}}
                                        </th>
                                        <th>
                                            {{translation.ProcessStatusHi}}
                                        </th>
                                        <th>
                                            {{translation.Act}}
                                        </th>
                                        <th>
                                            {{translation.IsEndUserRelated}}
                                        </th>
                                        <th>
                                            {{translation.IsActive}}
                                        </th>
                                        <th>
                                            {{translation.Action}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="items in AllActions | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="BlockPagination">
                                        <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                        <td>{{ items.ProceesStatusTextEn }}</td>
                                        <td>{{ items.ProceesStatusTextHi }}</td>
                                        <td>{{ _language==='en-us' ?  items.ActDetailEn : items.ActDetailHi }}</td>
                                        <td>{{ items.IsEnduserRelated =="1" ? translation.Yes : translation.No }}</td>
                                        <td>{{ items.IsActive =="1" ? translation.Yes : translation.No }}</td>
                                        <td>
                                            <i class="fa fa-firefox" title="Set Active/Inactive Status" ng-click="ChangeActionMasterStatus(items.SocietyProceesStatusId)"></i> &nbsp;&nbsp;&nbsp;&nbsp;
                                            <i class="fa fa-edit" title="Edit" ng-click="Update(items)"></i> &nbsp;&nbsp;&nbsp;&nbsp;
                                            <i class="fa fa-trash" title="Delete" ng-click="DeleteActionMasterData(items.SocietyProceesStatusId)"></i>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>



                <div class="col-md-12">
                    <div class="text-center">
                        <dir-pagination-controls boundary-links="true" pagination-id="BlockPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                    </div>
                </div>
                @*<div class="form-group col-md-12">
                    <div class="dev-align-btn">

                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                    </div>

                </div>*@
                <div class="col-md-2">
                    <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
                </div>
            </div>
        </div>
    </div>

    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>