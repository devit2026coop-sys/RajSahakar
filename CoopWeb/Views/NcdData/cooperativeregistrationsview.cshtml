@{
    ViewBag.Title = "NCD Basic Details View";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

        .form-control:not(select) {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

    .ncd-box {
        background: #ecf8ee !important;
        border: 1px dashed #ccc !important;
        padding: 20px;
        margin-bottom: 30px;
        width: 100%;
    }

    fieldset legend {
        border: none;
        background: #bf8313;
        width: auto;
        color: #ffffff;
        padding: 2px 10px;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }

    .tblthfont {
        font-weight: bold;
    }

    .d-flex {
        display: flex;
    }
    i.fa.fa-info {
       /* margin-left: 10px;*/
        color: #4caf50;
    }
    .box-header {
        background-color: #2991df !important;
    }
</style>

<script src="~/Scripts/AngularFramework/cooperative-registrationsview.js?v=1"></script>
<script src="~/Scripts/xlsx.full.min.js"></script>
<div ng-app="ncdMod" ng-controller="ncdCtrl">
    @*{{ncd}}*@
    <div class="container-fluid citizen-dash-head" id="printTable">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter   box-header">
                <b><i class="fa fa-info"></i> Cooperative Details of ( {{ ncd.cooperative_society_name }} )</b>
                <button type="button" class="btn btn-secondary" ng-click="goBack()">
                    <i class="ti ti-arrow-left"></i> Back
                </button>
            </div>
            <fieldset class="ncd-box">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-6">
                            @*<label><strong>Form Status:</strong> {{ ncd.form_status }}</label>*@
                            <label><strong>Form Status:</strong> {{ ncd.StatusType }}</label>
                        </div>
                        <div class="col-md-6">
                            <label><strong>Approval Status:</strong> {{ ncd.ProceesStatusTextEn }}</label>
                            @*<label><strong>Approval Status:</strong>{{ statusMap[item.is_approved] }}</label>

                        <label><strong>Approval Status:</strong> {{  getStatusText(item.is_approved) }}</label>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label><strong>1(a). Cooperative Society Name:</strong> {{ ncd.cooperative_society_name }}</label>
                        </div>
                        <div class="col-md-6">
                            <label><strong>1(b).Registration Authority:</strong> {{ ncd.authorityname }}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>1(c). Cooperative ID:</strong>
                            </label>
                            <span>{{ ncd.cooperative_id }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>1(d). Reference Year:</strong>
                            </label>
                            <span>{{ ncd.reference_year || 'N/A'}}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>1(e).  Date of Registration:</strong>
                            </label>
                            <span>{{ ncd.date_registration | date:'yy-mm-dd'}}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>1(f). Registration No:</strong>
                            </label>
                            <span>{{ ncd.registration_number }}</span>
                        </div>
                    </div>
                </div>
            </fieldset>
            <fieldset class="ncd-box">
                <legend class="dvlegend"> Location Details of Registration Office</legend>
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>2(a). Location of Registered Office:</strong>
                            </label>
                            {{ ncd.LocationArea == 1 ? 'Urban' : (ncd.LocationArea == 2 ? 'Rural' : '') }}
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>2(b). State or UT:</strong>
                            </label>
                            <span>{{ncd.StateName  }}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>2(c). District:</strong>
                            </label>
                            <span>{{ ncd.DistrictName }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>2(d). Block:</strong>
                            </label>
                            <span>{{ ncd.BlockName }}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>2(e).  Gram Panchayat:</strong>
                            </label>
                            <span>{{ ncd.GPName }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>2(f). Village:</strong>
                            </label>
                            <span>{{ ncd.GPName}}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>2(g). Pincode:</strong>
                            </label>
                            <span>{{ ncd.Pincode}}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>2(h). Full Address:</strong>
                            </label>
                            <span>{{ ncd.fulladdress}}</span>
                        </div>
                    </div>
                </div>
            </fieldset>
            <fieldset class="ncd-box">
                <legend class="dvlegend">Contact Details</legend>
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>3(a). Name: </strong>
                            </label>
                            <span>{{ ncd.contact_person || 'N/A' }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>3(b). Designation:</strong>
                            </label>
                            <span>{{ ncd.designations || 'N/A' }}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>3(c). Mobile Number:</strong>
                            </label>
                            <span>{{ ncd.Mobile || 'N/A'}}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>3(d). Landline:</strong>
                            </label>
                            <span>{{ ncd.landline || 'N/A'}}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>3(e). Email ID:</strong>
                            </label>
                            <span>{{ ncd.email || 'N/A'}}</span>
                        </div>
                    </div>
                </div>
            </fieldset>
            <fieldset class="ncd-box">
                <legend class="dvlegend">Sector Details</legend>
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>4(a). Sector of Operation:</strong>
                            </label>
                            <span> {{ ncd.IsCredit == 1 ? 'Credit' : (ncd.IsCredit == 2 ? 'Non-Credit' : '') }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>4(b). Primary Activity:</strong>
                            </label>
                            <span>{{ ncd.Sectorname }}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>5(a). Tier of the Cooperative Society:</strong>
                            </label>
                            <span>{{  }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>5(b). Operation Area Location:</strong>
                            </label>
                            <span> {{ ncd.LocationArea == 1 ? 'Urban' : (ncd.LocationArea == 2 ? 'Rural' : '') }}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>5(b).  Area of operation Rural:</strong>
                            </label>
                            <span>{{ ncd.UrbanRuralArea || 'N/A' }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>5(c)(i). District:</strong>
                            </label>
                            <span>{{ ncd.DistrictName }}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>5(c)(ii). Block:</strong>
                            </label>
                            <span>{{ ncd.BlockName }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>5(c)(iii). Gram Panchayat:</strong>
                            </label>
                            <span>{{ ncd.GPName }}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>5(c)(iv). Village:</strong>
                            </label>
                            <span>{{ ncd.GPName }}</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>
                            <strong>
                                5(d). Whether Area of Operation (Village, Panchayat, Block or Mandal or Town, Taluka/District) is adjacent to or includes water body:
                            </strong>
                        </label>
                        <span>{{ ncd.is_coastal ==1 ? 'Yes' : 'No'}}</span>
                    </div>
                    <div class="col-md-6" ng-show="ncd.is_coastal=='1'">
                        <label><strong> 5(d)(i). Type of water body: </strong> </label>
                        <span>{{ ncd.waterbody }}</span>
                    </div>
                    <div class="col-md-6">
                        <label>
                            <strong>
                                5(f). Whether the Society is affiliated to Union/Federation/Central/State Coop Bank/Milk Union/Central Fishermens`s Society:
                            </strong>
                        </label>
                        <span>{{ncd.affilated == 1 ? 'Yes' : 'No'}}</span>
                    </div>
                    <div class="col-md-6" ng-show="ncd.affilated=='1'">
                        <label>
                            <strong>
                                5(f)(i). Level of Affiliated Union/Federation :
                            </strong>
                        </label>
                        @*<span>{{ncd.affilated }}</span>*@
                    </div>
                    <div class="form-group">

                        <div class="col-md-6">
                            <label>
                                <strong>
                                    5(f)(ii). Name of Affiliated Union/Federation :
                                </strong>
                            </label>
                            @*<span>{{ncd.affilated }}</span>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>6. Present Functional Status:</strong>
                            </label>
                            <span>{{ ncd.functionstatus }}</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <p><strong>7. Number of Members of the Cooperative Society : {{ncd.NumberofmemberofSociety || 0}}</strong></p>
                            <table class="table table-bordered text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th></th>
                                        <th>General</th>
                                        <th>SC</th>
                                        <th>ST</th>
                                        <th>OBC</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Male</td>
                                        <td>{{ncdm.m_general}}</td>
                                        <td>{{ncdm.msc || 0}}</td>
                                        <td>{{ncdm.mst || 0}}</td>
                                        <td>{{ncdm.m_obc || 0}}</td>
                                        <td>{{ (+ncdm.m_general || 0) + (+ncdm.msc || 0) + (+ncdm.mst || 0) + (+ncdm.m_obc || 0) }}</td>
                                    </tr>
                                    <tr>
                                        <td>Female</td>
                                        <td>{{ncdm.f_general}}</td>
                                        <td>{{ncdm.fsc}}</td>
                                        <td>{{ncdm.fst}}</td>
                                        <td>{{ncdm.f_obc}}</td>
                                        <td>{{ (+ncdm.f_general || 0) + (+ncdm.fsc || 0) + (+ncdm.fst || 0) + (+ncdm.f_obc || 0) }}</td>
                                    </tr>
                                    <tr>
                                        <td>Transgender</td>
                                        <td>{{ncdm.t_general}}</td>
                                        <td>{{ncdm.tsc}}</td>
                                        <td>{{ncdm.tst}}</td>
                                        <td>{{ncdm.t_obc}}</td>
                                        <td>{{ (+ncdm.t_general || 0) + (+ncdm.tsc || 0) + (+ncdm.tst || 0) + (+ncdm.t_obc || 0) }}</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total</strong></td>
                                        <td>{{ (+ncdm.m_general || 0) + (+ncdm.f_general || 0) + (+ncdm.t_general || 0) }}</td>
                                        <td>{{ (+ncdm.msc || 0) + (+ncdm.fsc || 0) + (+ncdm.tsc || 0) }}</td>
                                        <td>{{ (+ncdm.mst || 0) + (+ncdm.fst || 0) + (+ncdm.tst || 0) }}</td>
                                        <td>{{ (+ncdm.m_obc || 0) + (+ncdm.f_obc || 0) + (+ncdm.t_obc || 0) }}</td>
                                        <td>
                                            {{
                                                   (
                                                     (+ncdm.m_general || 0) + (+ncdm.msc || 0) + (+ncdm.mst || 0) + (+ncdm.m_obc || 0)
                                                   ) +
                                                   (
                                                     (+ncdm.f_general || 0) + (+ncdm.fsc || 0) + (+ncdm.fst || 0) + (+ncdm.f_obc || 0)
                                                   ) +
                                                   (
                                                     (+ncdm.t_general || 0) + (+ncdm.tsc || 0) + (+ncdm.tst || 0) + (+ncdm.t_obc || 0)
                                                   )
                                            }}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>
                                    7(a). Whether the Cooperative Society is profit making? :
                                </strong>
                            </label>
                            <span>{{ ncd.Profitmaking == 1 || ncd.Profitmaking == '1' || ncd.Profitmaking == true || ncd.Profitmaking == 'Yes' ? 'Yes' : 'No' }}</span>
                        </div>
                        <div class="col-md-6" ng-show="ncd.Profitmaking=='1'">
                            <label>
                                <strong>
                                    7(b). Net Profit of the Cooperative Society (in Rs):
                                </strong>
                            </label>
                            <span>{{ ncd.annual_turnover }}</span>
                        </div>
                        <div class="col-md-6" ng-show="ncd.Profitmaking=='0'">
                            <label>
                                <strong>7(b). Net Loss of the Cooperative Society (in Rs) : </strong>
                            </label>
                            <span>{{ ncd.netloss }}</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>
                            <strong>8. Whether Financial Audit has been done? :</strong>
                        </label>
                        <span>{{ ncd.financial_audit == 1 ? 'Yes' : 'No'}}</span>
                    </div>
                    <div class="col-md-6" ng-show="ncd.financial_audit=='1'">
                        <label>
                            <strong>8(a). Years of Latest Audit Complete :</strong>
                        </label>
                        <span>{{ ncd.audityears }}</span>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>
                                    9(c). Whether the dividend paid by the Cooperative  Society? :
                                </strong>
                            </label>
                            <span>{{ ncd.isdevidentpaid ? 'Yes' : 'No'}}</span>
                        </div>
                        <div class="col-md-6" ng-show="ncd.isdevidentpaid==1">
                            <label>
                                <strong>
                                    9(d). Dividend Rate Paid by the Cooperative Society (in %) :
                                </strong>
                            </label>
                            <span>{{ ncd.dividend_rate }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>9(e). is MSME Registered?:</strong>
                            </label>
                            <span>{{ ncd.msme ? 'Yes' : 'No' }}</span>
                        </div>
                    </div>
                    <div class="col-md-6" ng-show="ncd.msme==1">
                        <label>
                            <strong>9(e)(i). Udyan Registration Number(URN):</strong>
                        </label>
                        <span>{{ ncd.udyam_no || 'N/A' }}</span>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>10(a). Select the type of bank where the cooperative society have a bank account? :</strong>
                            </label>
                            <span>{{ getBankTypeName(ncd.bank_type) || 'N/A'}}</span>
                        </div>
                    </div>
                    <div class="form-group" ng-show="getBankTypeName(ncd.bank_type)=='1'">
                        <div class="col-md-6">
                            <label>
                                <strong>
                                    10(b). Select the name of the bank where the cooperative society has its bank account :
                                </strong>
                            </label>
                            <span>{{ ncd.bankname }}</span>
                        </div>
                    </div>
                </div>
            </fieldset>
            @*<fieldset class="ncd-box" ng-show="ncd.sectorOperation  == 1 || ncd.sectorOperation == 20 || ncd.sectorOperation  == 22">*@
            <fieldset class="ncd-box" ng-show="fss">
                <legend>{{is_pacsTitle}}</legend>
                <div class="form-group">
                    <div class="col-md-6">
                        <label>
                            <strong>10(a). Whether the co-operative society has an office building : </strong>
                        </label>
                        <span>{{ fss.has_building ? 'Yes' : 'No' }}</span>
                    </div>
                    <div class="col-sm-3" ng-show="fss.has_building==1">
                        <label>
                            <strong>10(B). Type of Office Building of the Cooperative Society  </strong>
                        </label>
                        <span>{{ fss.building_type }}</span>
                    </div>
                    <div class="col-md-6">
                        <label>
                            <strong>10(c). Whether the co-operative society has land : </strong>
                        </label>
                        <span>{{ fss.is_socitey_has_land  ? 'Yes' : 'No'}}</span>
                    </div>
                    <div class="row" ng-show="fss.is_socitey_has_land== 1">
                        <div class="col-sm-6">
                            <label>10(d). Land Available with the Cooperative</label>
                            <div class="box-primary box-st">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th style="background:#00005f !important; color:#fff;width:10%">S. No.</th>
                                            <th style="background:#00005f !important; color:#fff;width:50%">Type of Possession</th>
                                            <th style="background:#00005f !important; color:#fff;width:40%">Area (in Acres)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>1</td>
                                            <td>Owned Land</td>
                                            <td>{{ fss.land_owned }}</td>
                                        </tr>
                                        <tr>
                                            <td>2</td>
                                            <td>Leased Land</td>
                                            <td>{{ fss.land_leased }}</td>

                                        </tr>
                                        <tr>
                                            <td>3</td>
                                            <td>Land allotted by the Government</td>
                                            <td>{{ fss.land_allotted }}</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2"><strong>Total</strong></td>
                                            <td>{{ fss.land_total }}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <fieldset class="ncd-box">
                    <legend> Services/Facilities Provided to the Members </legend>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong> 11(a). Total Outstanding Loan extended to members in last financial year (in Rs.) : </strong>
                            </label>
                            <span>{{ fss.pack_total_outstanding_loan }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong> 11(b). Last Financial Year Revenue (Other than interest) from Non-Credit Activities (in Rs.) : </strong>
                            </label>
                            <span>{{ fss.pack_revenue_non_credit }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>11(c). Whether PACS is engaged in Pesticide Distribution? :</strong>
                            </label>
                            <span>{{ fss.pesticide_distribution  ? 'Yes' : 'No'}}</span>
                        </div>
                        <div class="col-md-6" ng-show="fss.pesticide_distribution ==1 ">
                            <label> <strong>If Yes, please specify the quantity of pesticide distributed in last financial year (In MT) :</strong> </label>
                            <span>{{ fss.pesticide_distribution_qty }}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong> 11(d). Does the PACS possess a Fertilizer Distribution Centre? :</strong>
                            </label>
                            <span>{{ fss.fertilizer_distribution ? 'Yes' : 'No'}}</span>
                        </div>
                        <div class="col-md-6" ng-show="fss.fertilizer_distribution==1">
                            <label>
                                <strong>(i). If Yes, please specify the quantity of fertilizer distributed in last financial year (in MT) :	</strong>
                            </label>
                            <span>{{ fss.fertilizer_distribution_qty}}</span>
                        </div>
                        <div class="col-md-6" ng-show="fss.fertilizer_distribution==1">
                            <label>
                                <strong>(ii). Remarks (if any)</strong>
                            </label>
                            <span>{{ fss.fertilizer_distribution_details}}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>11(e). Does the PACS also function as Pradhan Mantri Kisan Samridhi Kendra (PMKSK)? :</strong>
                            </label>
                            <span>{{ fss.is_pmksk ? 'Yes' : 'No'}}</span>
                        </div>
                        <div class="col-md-6" ng-show="fss.is_pmksk==1">
                            <label>
                                <strong>If Yes, please provide the details of Pradhan Mantri Kisan Samridhi Kendra (PMKSK) :</strong>
                            </label>
                            <span>{{ fss.pmksk_details }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>11(f). Whether PACS is engaged in Seed Distribution? :	</strong>
                            </label>
                            <span>{{ fss.seed_distribution ? 'Yes' : 'No'}}</span>
                        </div>
                        <div class="col-md-6" ng-show="fss.seed_distribution==1">
                            <label>
                                <strong>If Yes, please specify the quantity of seed distributed in last financial year (in MT) :</strong>
                            </label>
                            <span>{{ fss.seed_distribution_qty}}</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                            <label>
                                <strong>11(g). Whether PACS is engaged in Procurement of food grains? :</strong>
                            </label>
                            <span>{{ fss.is_foodgrains ? 'Yes' : 'No'}}</span>
                        </div>
                        <div class="col-md-6" ng-show="fss.is_foodgrains==1">
                            <label>
                                <strong>If Yes, please specify the quantity of Procurement done in last financial year (In MT) :</strong>
                            </label>
                            <span>{{ fss.foodgrains_qty }}</span>
                        </div>
