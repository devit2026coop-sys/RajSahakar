                                <label>
                                    7(a). Annual Turnover of the Cooperative Society
                                    <span class="text-danger">
                                        <strong>
                                            (in Rs.)
                                        </strong>
                                    </span>
                                </label>
                                <div class="form-group">
                                    <input type="text" ng-model="ncd.annual_turnover" placeholder="Annual Turnover of the Cooperative Society" class="form-control" required numbers-only />
                                </div>
                            </div>
                            <div class="col-sm-4" ng-init="ncd.is_profit_making='0'">
                                <label>7(b). Whether the Cooperative Society is Profit Making? <span class="text-danger">*</span></label>
                                <div class="form-group d-flex">
                                    <div class="form-check">
                                        <input type="radio" name="is_profit_making" ng-model="ncd.is_profit_making" value="1" class="form-check-input" ng-change="is_profitMaking()" required />
                                        <label class="form-check-label" for="profitYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" name="is_profit_making" ng-model="ncd.is_profit_making" value="0" class="form-check-input" ng-change="is_profitMaking()" required />
                                        <label class="form-check-label" for="profitNo">No</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-4" ng-init="is_profitMaking()">
                                <label for="{{isTextName}}">
                                    7(c).{{isTrunOverText}}
                                    <span class="text-danger">
                                        <strong>
                                            (in Rs.)
                                        </strong>
                                    </span>
                                </label>
                                <div class="form-group">
                                    <input type="text" id="{{isTextName}}" name="{{isTextName}}" ng-model="ncd.annualPayment" placeholder={{isTrunOverText}} class="form-control" required numbers-only />
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <label>8(a). Whether the Dividend is Paid by the Cooperative Society? <span class="text-danger">*</span></label>
                                <div class="form-group d-flex">
                                    <div class="form-check">
                                        <input type="radio" id="dividendYes" name="dividend_paid" ng-model="ncd.is_dividend_paid" value="1" class="form-check-input" required>
                                        <label class="form-check-label" for="dividendYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" id="dividendNo" name="dividend_paid" ng-model="ncd.is_dividend_paid" value="0" class="form-check-input" required>
                                        <label class="form-check-label" for="dividendNo">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4" ng-show="ncd.is_dividend_paid==1">
                                <label>
                                    8(b). Dividend Rate Paid by the Cooperative Society
                                    <span class="text-danger">
                                        <strong>(in %)</strong>
                                    </span>
                                </label>
                                <input type="text" ng-model="ncd.dividend_rate" class="form-control" placeholder="Dividend Rate Paid" percent-input />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <label for="bank_type">
                                    9(a). Select the Type of Bank where the Cooperative Society has a Bank Account? <span class="text-danger">*</span>
                                </label>
                                <div class="multi-select new-drp" ng-click="AccountToggleDropdown($event)">
                                    <div class="selected-text">
                                        {{getBankAccountSelectedText()}}
                                    </div>
                                    <div class="dropdown" ng-show="open" ng-click="$event.stopPropagation()">
                                        <input type="text" ng-model="searchText" placeholder="Search" class="search-box" />
                                        <label>
                                            <input type="checkbox" ng-checked="AccountIsAllSelected()" ng-click="BankAccountToggleAll($event)">  Select all
                                        </label>

                                        <div class="option" ng-repeat="item in sectorOperationList | filter:searchText">
                                            <label>
                                                <input type="checkbox" ng-checked="AccountIsSelected(item.id)" ng-click="BankAccountToggleItem($event, item.id)"> {{item.name}}
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label>
                                    9(b). Select Bank Name where the Cooperative Society has its bank account
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="dropdown mange-slct">
                                    <button class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button">
                                        {{getSelectedBankText()}}
                                    </button>
                                    <ul class="dropdown-menu" style="padding:10px; max-height:250px; overflow-y:auto;">
                                        <li>
                                            <label>
                                                <input type="checkbox" ng-model="selectAllBanks" ng-change="ToggleSelectAllBanks()">
                                                <strong>Select All</strong>
                                            </label>
                                        </li>
                                        <li ng-repeat="item in NCDCoopBanks">
                                            <label>
                                                <input type="checkbox" ng-model="item.selected" ng-change="UpdateSelectedBankName()">
                                                {{item.bank_name}}
                                            </label>
                                        </li>

