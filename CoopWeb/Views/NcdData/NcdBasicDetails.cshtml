                                    <i class="fa fa-minus-circle"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-4">
                                <label>4(d). Whether Area of Operation (Village, Panchayat, Block or Mandal or Town, Taluka/ District) is adjacent to or includes water body? <span class="text-danger">*</span></label>
                                <div class="form-group d-flex">
                                    <div class="form-check" ng-init="ncd.is_coastal='0'">
                                        <input type="radio" ng-model="ncd.is_coastal" value="1" required class="form-check-input" ng-change="ToggleChange()">
                                        <label for="water_body_yes" class="form-check-label">Yes</label>
                                    </div>

                                    <div class="form-check">
                                        <input type="radio" ng-model="ncd.is_coastal" value="0" required class="form-check-input" ng-change="ToggleChange()">
                                        <label for="water_body_no" class="form-check-label">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4" ng-show="ncd.is_coastal==1">
                                <label>4(e).Type of water body <span class="text-danger">*</span></label>
                                <select ng-model="ncd.water_body_type_id" class="form-control">
                                    <option value="0" disabled selected>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in waterBodyTypeList " value="{{item.id}}">
                                        {{item.name}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-sm-4">
                                <label>4(f). Whether the Society is affiliated to Union/Federation/Central/State Coop Bank/Milk Union/Central Fishermens's Society <span class="text-danger">*</span></label>
                                <div class="form-group d-flex">
                                    <div class="form-check">
                                        <input type="radio" ng-model="ncd.is_affiliated_union_federation" value="1" class="form-check-input" ng-click="isAffiliatedUnionToggle()" required>
                                        <label class="form-check-label" for="is_affiliated_union_federation">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" ng-model="ncd.is_affiliated_union_federation" value="0" class="form-check-input" ng-click="isAffiliatedUnionToggle()" required>
                                        <label class="form-check-label" for="is_affiliated_union_federation">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3" ng-show="ncd.is_affiliated_union_federation==1">
                            <div class="col-sm-12">
                                <label for="AffiliatedUnionFederation">
                                    4(g). Level of Affiliated Union/Federation<span class="text-danger">*</span>
                                </label>
                                <div class="row">
                                    <div class="col-sm-4">
                                        <select name="affiliated_union_federation_level" ng-model="ncd.affiliated_union_federation_level" class="form-control" required select2 multiple>
                                            <option value="">{{translation.SelectOption}}</option>
                                            @*<option ng-repeat="item in AffiliatedFeederationList track by $index" value="{{item.id}}">
                                                    {{item.name}}
                                                </option>*@
                                        </select>
                                    </div>
                                    <div class="col-sm-2">
                                        <button type="button" class="btn btn-primary btn-sm mt-sm-0 mt-2">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3" ng-repeat="item in ncd.unionLevelList track by $index">
                            <div class="col-sm-12">
                                <label for="Level">4(g). Level</label>
                                <div class="row">
                                    <div class="col-sm-4">
                                        <input type="text" class="form-control" ng-model="item.union_level" placeholder="Enter level" />
                                    </div>
                                    <div class="col-sm-2">
                                        <button type="button" class="btn btn-danger btn-sm mt-sm-0 mt-2" ng-click="removeUnionLevel($index)">
                                            <i class="fa fa-minus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-sm-5 member-details">
                                <label>5. Number of Members of the Cooperative Society</label>
                                <input type="text" ng-model="ncd.members_of_society" class="form-control mb-3" readonly />
                                <table class="table table-bordered text-center">
                                    <thead class="table-light">
                                        <tr>
                                            <th></th>
                                            <th>General</th>
                                            <th>SC</th>
                                            <th>ST</th>
                                            <th>OBC</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <th>Male</th>
                                            <td><input type="number" ng-model="ncdm.m_general" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.m_general)"></td>
                                            <td><input type="number" ng-model="ncdm.m_sc" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.m_sc)"></td>
                                            <td><input type="number" ng-model="ncdm.m_st" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.m_st)"></td>
                                            <td><input type="number" ng-model="ncdm.m_obc" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.m_obc)"></td>
                                            <td><input type="number" ng-model="ncdm.m_total" class="form-control" min="0" readonly></td>
                                        </tr>
                                        <tr>
                                            <th>Female</th>
                                            <td><input type="number" ng-model="ncdm.f_general" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.f_general)"></td>
                                            <td><input type="number" ng-model="ncdm.f_sc" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.f_sc)"></td>
                                            <td><input type="number" ng-model="ncdm.f_st" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.f_st)"></td>
                                            <td><input type="number" ng-model="ncdm.f_obc" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.f_obc)"></td>
                                            <td><input type="number" ng-model="ncdm.f_total" class="form-control" min="0" readonly></td>
                                        </tr>
                                        <tr>
                                            <th>Transgender</th>
                                            <td><input type="number" ng-model="ncdm.t_general" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.t_general)"></td>
                                            <td><input type="number" ng-model="ncdm.t_sc" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.t_sc)"></td>
                                            <td><input type="number" ng-model="ncdm.t_st" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.t_st)"></td>
                                            <td><input type="number" ng-model="ncdm.t_obc" class="form-control" min="0" ng-change="AddMemberDetail(ncdm.t_obc)"></td>
                                            <td><input type="number" ng-model="ncdm.t_total" class="form-control" min="0" readonly></td>
                                        </tr>
                                        <tr>
                                            <th>Total</th>
                                            <td><input type="number" ng-model="ncdm.total_general" class="form-control" min="0" readonly></td>
                                            <td><input type="number" ng-model="ncdm.total_sc" class="form-control" min="0" readonly></td>
                                            <td><input type="number" ng-model="ncdm.total_st" class="form-control" min="0" readonly></td>
                                            <td><input type="number" ng-model="ncdm.total_obc" class="form-control" min="0" readonly></td>
                                            <td><input type="number" ng-model="ncdm.total_total" class="form-control" min="0" readonly></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-4">
                                <label>6(a). Whether Financial Audit Has Been Done? <span class="text-danger">*</span></label>
                                <div class="form-group d-flex" ng-init="ncd.financial_audit='1'">
                                    <div class="form-check">
                                        <input type="radio" name="financial_audit" ng-model="ncd.financial_audit" value="1" class="form-check-input" required />
                                        <label class="form-check-label" for="auditYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" name="financial_audit" ng-model="ncd.financial_audit" value="0" class="form-check-input" required />
                                        <label class="form-check-label" for="auditNo">No</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-4" ng-show="ncd.financial_audit==1">
                                <label for="latest_audit_year">6(b). Years of Latest Audit Complete</label>
                                <select name="latest_audit_year" ng-model="ncd.audit_complete_year" class="form-control" required>
                                    <option value="" disabled selected>{{translation.SelectOption}}</option>
                                    <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_END}}">
                                        {{item.FIN_YEAR_NAME}}
                                    </option>
                                </select>
                                <span class="cop-add_span">Note: - Data after 8(b) will be based on Latest Audit Year</span>
                            </div>

                            <div class="col-sm-4" ng-show="ncd.financial_audit==1">
                                <label for="audit_category">6(c). Category of Audit</label>
                                <select name="audit_category" ng-model="ncd.category_audit" class="form-control" required ng-options="c.id as c.name for c in NCDAuditCategories">
                                    <option value="" disabled selected>{{translation.SelectOption}}</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3" ng-show="ncd.financial_audit==1">
