                                        <input type="radio"
                                               id="msmeYes"
                                               name="msme_registered"
                                               ng-model="ncd.is_msme"
                                               value="1"
                                               class="form-check-input"
                                               required>
                                        <label class="form-check-label" for="msmeYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" name="msme_registered" ng-model="ncd.is_msme" value="0" class="form-check-input" required />
                                        <label class="form-check-label" for="msmeNo">No</label>
                                    </div>
                                </div>
