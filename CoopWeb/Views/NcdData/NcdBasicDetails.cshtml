                                    <span class="text-danger">*</span>
                                </label>
                                <div class="form-group">
                                    <input type="text" name="other_bank_name" ng-model="ncd.other_bank" placeholder="Enter Other Bank Name" required maxlength="255" class="form-control">
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <label>9(d). Is MSME Registered? <span class="text-danger">*</span></label>
                                <div class="form-group d-flex">
