                                    <option ng-repeat="item in NCDOfficeBuildingTypes " value="{{item.id}}">
                                        {{item.name}}
                                    </option>

                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <label>
                                    10(c). Whether the co-operative society has land?
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="form-group d-flex">
                                    <div class="form-check">
                                        <input type="radio" id="is_socitey_has_landYes" name="is_socitey_has_landYes" ng-model="pacs.is_socitey_has_land" value="1" class="form-check-input">
                                        <label class="form-check-label" for="is_socitey_has_landYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" id="is_socitey_has_landNo" name="is_socitey_has_landNo" ng-model="pacs.is_socitey_has_land" value="0" class="form-check-input">
                                        <label class="form-check-label" for="is_socitey_has_landNo">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row" ng-show="pacs.is_socitey_has_land== 1">
                            <div class="col-sm-6">
