                                                    <input type="text" name="land_owned" ng-model="pacs.land.land_owned" class="form-control" min="0" ng-change="PacsLandAreaCalculate()" numbers-only />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>2</td>
                                                <td>Leased Land</td>
                                                <td>
                                                    <input type="text" name="land_leased" ng-model="pacs.land.land_leased" class="form-control" min="0" ng-change="PacsLandAreaCalculate()" numbers-only />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>3</td>
                                                <td>Land allotted by the Government</td>
                                                <td>
                                                    <input type="text" name="land_allotted" ng-model="pacs.land.land_allotted" class="form-control" min="0" ng-change="PacsLandAreaCalculate()" numbers-only />
                                                </td>
                                            </tr>
                                            <tr>
