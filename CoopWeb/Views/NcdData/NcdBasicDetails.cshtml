@{
    ViewBag.Title = "NCD Basic Details";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

        .form-control:not(select) {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

    .ncd-box {
        background: #ecf8ee !important;
        border: 1px dashed #ccc !important;
        padding: 10px;
        margin-bottom: 30px;
        width: 100%;
    }

        .ncd-box label {
            font-size: 14px;
        }

    fieldset legend {
        border: none;
        background: #bf8313;
        width: auto;
        color: #ffffff;
        padding: 2px 10px;
        margin-bottom: 5px;
        font-size: 15px;
        border-radius: 8px;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }

    .tblthfont {
        font-weight: bold;
    }

    .d-flex {
        display: flex;
    }

    .member-details {
        background: #d2f1d7;
        margin: 0 15px 20px;
        padding: 15px 15px 15px 15px;
        border-radius: 5px;
        border: 1px solid #8bd599;
    }

    .sector-details {
        background: #d2f1d7;
        position: relative;
        display: flow-root;
        margin: 0 0px 20px;
        padding: 15px 10px 0;
        border-radius: 5px;
        border: 1px solid #8bd599;
    }

    .box-primary, .success_box {
        border-top-left-radius: 10px;
        overflow: hidden;
        border-top-right-radius: 10px;
        border-top: 2px solid #c47618 !important;
        border-top-color: #c47618 !important;
    }

    .servce-hading {
        font-size: 20px;
        font-weight: 600;
        background: #1e738d;
        color: #fff;
        margin-bottom: 0px;
        padding: 5px 10px;
    }

    .select2 {
        width: 100% !important;
        border: 1px solid #d2d6de;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #3c8dbc !important;
        border: 1px solid #3c8dbc !important;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove, .select2-container--default .select2-selection--multiple .select2-selection__choice__display {
        color: #fff !important;
    }

    .multi-select.new-drp {
        border: 1px solid #ccc;
        padding: 8px;
        cursor: pointer;
        background: #fff;
        position: relative;
    }

    .new-drp .dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 999;
        border: 1px solid #ccc;
        background: #fff;
        /* width: 100%;
        max-height: 250px;*/
        overflow-y: auto;
        padding: 10px;
        width: 100%;
    }

    .new-drp .search-box {
        width: 100%;
        padding: 5px;
        margin-bottom: 10px;
        border: 1px solid #ccc;
    }

    .citizen-dash-head {
        overflow: inherit;
    }

    .mange-slct {
        width: 100%;
    }

        .mange-slct button {
            width: 100%;
            text-align: left;
        }

        .mange-slct .dropdown-menu {
            width: 100%;
        }

    .select2-container--default .select2-selection--single {
        background-color: #fff;
        border: 0px solid #d2d6de !important;
        border-radius: 0 !important;
    }

    .select2 {
        border: 1px solid #d2d6de !important;
    }

    .bold-italic {
        font-weight: bold;
        font-style: italic;
    }

    .invalid-field {
        border: 2px solid red;
        background-color: #ffe6e6;
    }

    .text-danger {
        color: red !important;
    }

    .cop-add_span {
        display: block;
        margin-top: 8px;
    }

    .invalid-field {
        border: 1px solid red !important;
    }

    .select2-selection.invalid-field {
        border: 1px solid red !important;
    }
</style>
<script src="~/Scripts/AngularFramework/NcdBasicDetails.js?v=@DateTime.Today.Ticks"></script>
<link href="~/Content/Stylesheets/toastr.min.css" rel="stylesheet" />
<script src="~/Scripts/toastr.min.js"></script>
<div ng-app="ncdMod" ng-controller="ncdCtrl" ng-cloak="">
    <div class="container-fluid citizen-dash-head">
        <div class="panel panel-default">
            <div class="panel-heading flexEqualCenter">
                <b><i class="fa fa-th-list"></i>&nbsp; NCD Basic Details</b><div class="text-right">
                    <a href="~/NCDData/NcdBasicDetailsList" class="btn btn-primary dev-btn"><i class="fa fa-angle-left"></i> Back</a>
                </div>
            </div>

            <div class="panel-body">
                <form name="ncdForm" novalidate>
                    <span class="text-danger">
                        <strong>Note:</strong> Please ensure that all information is filled in English.
                    </span>
                    <div class="ncd-box">
                        <div class="row">
                            <div class="col-md-4 col-sm-4">
                                <label>1(a). Registration Number <span class="text-danger">*</span></label>
                                <div class="form-group" style="display:flex;gap:5px">
                                    <input type="text" ng-model="ncd.registration_number" placeholder="Enter Registration Number" required maxlength="60" class="form-control" ng-disabled="isRegistrationTxt" />
                                    <button type="button" class="btn btn-primary dev-btn" ng-click="GetCooperativeDataByRegistrationNo()" ng-hide="isShowRemoveBtn">Fetch Detail</button>
                                    <button type="button" class="btn btn-danger btn-sm" ng-show="isShowforEdit==2" ng-click="IsEnableRegistrationNo()">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-5 col-sm-4">
                                <label>1(b). Name of Cooperative Society<span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <input type="text" name="cooperative_society_name" ng-model="ncd.cooperative_society_name" placeholder="Name of Cooperative Society" required maxlength="255" class="form-control" ng-disabled="IsCooperativeNameTxt" allow-letters />
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-4">
                                <label for="sector_operation">1(c). Sector of Operation<span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="sector_of_operation_type" id="sector_operation" ng-model="ncd.sector_of_operation_type" class="form-control" required ng-init="ncd.sector_of_operation_type='0'"
                                            ng-change="filterPrimaryActivity(ncd.sector_of_operation_type)" ng-disabled="isRegistrationTxt">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option value="1">Credit</option>
                                        <option value="2">Non-Credit</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-4" ng-init="GetSectorDetail()">
                                <label for="primary_activity">1(d). Primary Activity<span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select ng-model="ncd.sector_of_operation" class="form-control" required ng-change="isPacsPrimaryActivity(ncd.sector_of_operation)" ng-init="ncd.sector_of_operation='0'" ng-disabled="isRegistrationTxt">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in FilteredNCDSectorDetails" value="{{item.id}}">
                                            {{item.name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label for="registration_authority">1(e). Registration Authority<span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="registration_authority" id="registration_authority" ng-model="ncd.registration_authoritie_id" class="form-control" required>
                                        <option value="" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in NCDRegistrationAuthorities" value="{{item.id}}">
                                            {{item.authority_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-4">
                                <label>1(f). Date of Registration <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <input type="date" name="date_of_registration" ng-model="ncd.date_registration" required class="form-control" disable-before-date />
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-4">
                                <label for="prsent_functional_status">1(g). Present Functional Status<span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select id="prsent_functional_status" ng-model="ncd.functional_status" class="form-control" required
                                            ng-options="s.Id as s.FunctionalName for s in SocietyFunctionalStatusList">
                                        <option value="" disabled>{{translation.SelectOption}}</option>
                                    </select>
                                    <span class="help-block text-danger" ng-show="ncdForm.functional_status.$touched && ncdForm.functional_status.$error.required">
                                        Functional status is required.
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <fieldset class="ncd-box">
                        <legend>Location Details of Registered Office</legend>
                        <div class="row">
                            <div class="col-md-3 col-sm-4">
                                <label>2(a). Location of Registered Office <span class="text-danger">*</span></label>
                                <div class="form-group d-flex">
                                    <div class="form-check">
                                        <input type="radio" name="location_of_head_quarter" ng-model="ncd.location_of_head_quarter" value="1" required class="form-check-input" ng-change="locationHeadQuarterToggle(ncd.location_of_head_quarter)">
                                        <label for="location_urban" class="form-check-label">Urban</label>
                                    </div>

                                    <div class="form-check">
                                        <input type="radio" id="location_rural" name="location_of_head_quarter" ng-model="ncd.location_of_head_quarter" value="2" required class="form-check-input" ng-change="locationHeadQuarterToggle(ncd.location_of_head_quarter)">
                                        <label for="location_rural" class="form-check-label">Rural</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label for="address_line"> 2(b). Address Line <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <input type="text" ng-model="ncd.address_line" class="form-control" placeholder="House No./ Plot No." ng-change="fillAddress()" />
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-4">
                                <label for="state_ut">2(c). State / UT <span class="text-danger">*</span></label>
                                <div class="form-group" ng-init="ncd.state_code='8'">
                                    <select ng-model="ncd.state_code" class="form-control" disabled>
                                        <option value="0">{{translation.SelectOption}}</option>
                                        <option value="8">RAJASTHAN</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label for="district">2(d). District <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="district" id="district" ng-model="ncd.district_code" class="form-control" required ng-options="d.district_code as d.district_name for d in NCDDistrictDetails"
                                            ng-change="GetBlockByStateDistrict(ncd.state_code, ncd.district_code)">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4" ng-show="ncd.location_of_head_quarter==2">
                                <label for="block">2(e). Block <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="block" id="block" ng-model="ncd.block_code" class="form-control" required ng-options="b.block_code as b.block_name for b in NCDBlockDetails"
                                            ng-change="GetGramPanchayatByStateDistrictBlock(ncd.state_code, ncd.district_code,ncd.block_code)">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4" ng-show="ncd.location_of_head_quarter==1">
                                <label for="block">2(h). Category of Urban Local Body <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select ng-model="ncd.urban_local_body_type_code" name="urban_local_body_type_code" id="urban_local_body_type_code" ng-init="urban_local_body_type_code='0'"
                                            class="form-control" ng-change="GetUrbanLocalBodyByTypecode(ncd.urban_local_body_type_code)">
                                        <option value="" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in UrbanCategoryLocalList " value="{{item.localbody_type_code}}">
                                            {{item.localbody_type_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4" ng-show="ncd.location_of_head_quarter==2">
                                <label for="gram_panchayat">2(f). Gram Panchayat <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="gram_panchayat" id="gram_panchayat" ng-model="ncd.gram_panchayat_code" class="form-control" required
                                            ng-options="g.gram_panchayat_code as g.gram_panchayat_name for g in NCDGramPanchayatDetails"
                                            ng-change="GetVillageByStateDistrictBlockGramPanchayat(ncd.state_code, ncd.district_code,ncd.block_code,ncd.gram_panchayat_code)">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4" ng-show="ncd.location_of_head_quarter==1">
                                <label for="gram_panchayat">2(i). Urban Local Body <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="urban_local_body_code" id="urban_local_body_code" ng-model="ncd.urban_local_body_code" class="form-control" ng-init="urban_local_body_code='0'" ng-change="GetWardDetails(ncd.urban_local_body_code)">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in urbanBodyTypeDetailList " value="{{item.localbody_code}}">
                                            {{item.local_body_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4" ng-show="ncd.location_of_head_quarter==2">
                                <label for="village">2(g). Village <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="village" id="village" ng-model="ncd.village_code" class="form-control" required ng-options="g.village_code as g.village_name for g in NCDVillageDetails" ng-change="fillAddress()">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4" ng-show="ncd.location_of_head_quarter==1">
                                <label for="village">2(j). Locality or Ward <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="locality_ward_code" id="locality_ward_code" ng-init="locality_ward_code='0'" ng-model="ncd.locality_ward_code" class="form-control" ng-change="fillAddress()">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in wardDetailList " value="{{item.ward_code}}">
                                            {{item.ward_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label for="pincode">2(k). Pincode <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <input type="text" name="pincode" id="pincode" ng-model="ncd.pincode" placeholder="Enter Pincode" required maxlength="6" minlength="6" pattern="[0-9]{6}" class="form-control" ng-change="fillAddress()" numbers-only />
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label>2(l). Correspondence Address</label>
                                <div class="form-group">
                                    <textarea name="address" ng-model="ncd.full_address" placeholder="Correspondence Address" required maxlength="500" rows="3" class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-4">
                                <label>De Registered</label>
                                <div class="form-group d-flex">
                                    <div class="form-check">
                                        <input type="radio" ng-model="ncd.deregistered" value="1" required class="form-check-input">
                                        <label for="deregistered" class="form-check-label">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" ng-model="ncd.deregistered" value="0" required class="form-check-input">
                                        <label for="deregistered" class="form-check-label">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-4" ng-show="ncd.deregistered==1">
                                <label>Date of De-Registered </label>
                                <div class="form-group">
                                    <input type="date" name="date_deregistered" ng-model="ncd.date_deregistered" required class="form-control" disable-before-date />
                                </div>
                            </div>
                        </div>

                    </fieldset>

                    <fieldset class="ncd-box">
                        <legend>Contact Details</legend>
                        <div class="row">
                            <div class="col-md-3 col-sm-4">
                                <label>3(a). Name <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <input type="text" name="Name" ng-model="ncd.contact_person" placeholder="Name" required maxlength="255" class="form-control" />
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label for="designation">3(b). Designation <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="designation" id="designation" ng-model="ncd.designation" class="form-control" required ng-options="d.ncd_designation_id as d.name for d in NcdDesignationsList">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label for="mobile_no">3(c). Mobile Number <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <input type="text" name="mobile_no" id="mobile_no" ng-model="ncd.mobile" placeholder="Enter Mobile Number" required class="form-control" mobile-number />
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label for="landline_number">3(d). Landline Number with STD Code</label>
                                <div class="form-group d-flex">
                                    <input type="text" id="landline_number" ng-model="ncd.landline" placeholder="Landline Number" class="form-control" landline-number />
                                </div>
                            </div>

                            <div class="col-md-3 col-sm-4">
                                <label for="email">3(e). Email</label>
                                <div class="form-group">
                                    <input type="email" name="email" id="email" ng-model="ncd.email" placeholder="Enter Email Address" maxlength="255" class="form-control" required />
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="ncd-box">
                        <legend>Sector Details</legend>
                        <div class="row">
                            <div class="col-sm-4">
                                <label>4(a).Operation Area Location <span class="text-danger">*</span></label>
                                <div class="form-group d-flex">
                                    <div class="form-check">
                                        <input type="radio" ng-model="sectorDetail.operation_area_location" value="1" name="operation_area_location" ng-change="GetAreaOfOperations(sectorDetail.operation_area_location)" required class="form-check-input" />
                                        <label for="location_urban_oal" class="form-check-label">Urban</label>
                                    </div>

                                    <div class="form-check">
                                        <input type="radio" ng-model="sectorDetail.operation_area_location" value="2" name="operation_area_location" required ng-change="GetAreaOfOperations(sectorDetail.operation_area_location)" class="form-check-input" />
                                        <label for="location_rural_oal" class="form-check-label">Rural</label>
                                    </div>

                                    <div class="form-check">
                                        <input type="radio" ng-model="sectorDetail.operation_area_location" value="3" name="operation_area_location" required ng-change="GetAreaOfOperations(sectorDetail.operation_area_location)" class="form-check-input" />
                                        <label for="location_both" class="form-check-label">Both</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-3">
                                <label class="bold-italic">
                                    {{ selectedArea }}
                                </label>
                                <br />
                                <label for="area_of_operation">4(b). Area of Operation {{ selectedArea }} <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="area_of_operation_urban" ng-model="sectorDetail.area_of_operation_id" class="form-control">
                                        <option value="0" disabled selected>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in areaofOperationList " value="{{item.id}}">
                                            {{item.name}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div ng-repeat="sector in ncd.sectorListData track by $index" class="row sector-details" ng-if="sector.is_deleted==0">
                            <!-- District -->
                            <div class="col-sm-3">
                                <label for="district">4(c)(i). District <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select ng-model="sector.district_code" class="form-control" required ng-change="GetBlockByStateDistrictBySectorDynamic(sector, 8, sector.district_code)">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in NCDDistrictDetails" value="{{item.district_code}}">
                                            {{item.district_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <!-- Block -->
                            <div class="col-sm-3" ng-show="sectorDetail.operation_area_location==2 || sectorDetail.operation_area_location==3">
                                <label for="block">4(c)(ii). Block <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select ng-model="sector.block_code" class="form-control" required ng-change="GetGramPanchayatByStateDistrictBlockBySectorDynamic(sector, 8, sector.district_code, sector.block_code)">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in sector.NCDBlockListDetails" value="{{item.block_code}}">
                                            {{item.block_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <!-- Category of Urban Local Body -->
                            <div class="col-sm-3" ng-show="sectorDetail.operation_area_location==1 || sectorDetail.operation_area_location==3">
                                <label for="block">2(d). Category of Urban Local Body <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select ng-model="sector.local_body_type_code" name="local_body_type_code" class="form-control" ng-change="GetUrbanLocalBodyByTypecodeDynamic(sector,sector.local_body_type_code)">
                                        <option value="" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in UrbanCategoryLocalList " value="{{item.localbody_type_code}}">
                                            {{item.localbody_type_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <!-- Gram Panchayat -->
                            <div class="col-sm-3" ng-show="sectorDetail.operation_area_location==2 || sectorDetail.operation_area_location==3">
