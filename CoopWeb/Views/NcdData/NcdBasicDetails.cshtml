                                    <select ng-model="sector.panchayat_code" class="form-control" required
                                            ng-change="GetVillageByStateDistrictBlockGramPanchayatBySectorDynamic(sector, 8, sector.district_code, sector.block_code, sector.panchayat_code)">
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in sector.NCDGramPanchayatListDetails" value="{{item.gram_panchayat_code}}">
                                            {{item.gram_panchayat_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <!-- Urban Local Body -->
                            <div class="col-sm-3" ng-show="sectorDetail.operation_area_location==1 || sectorDetail.operation_area_location==3">
                                <label for="gram_panchayat">2(e). Urban Local Body <span class="text-danger">*</span></label>
                                <div class="form-group">
                                    <select name="local_body_code" ng-model="sector.local_body_code" class="form-control" ng-change="GetWardDetailsDynamic(sector,sector.local_body_code)">
