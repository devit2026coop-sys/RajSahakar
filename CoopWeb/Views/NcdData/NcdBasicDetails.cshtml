                                    <select ng-model="sector.village_code" class="form-control" required>
                                        <option value="" disabled selected>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in sector.NCDVillageListDetails" value="{{item.village_code}}">
                                            {{item.village_name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <!-- Locality or Ward -->
                            <div class="col-sm-3" ng-show="sectorDetail.operation_area_location==1 || sectorDetail.operation_area_location==3">
