@{
    ViewBag.Title = "NCD Basic Details Edit";
}

<style>
    .form-control {
        border-radius: 0;
        box-shadow: none;
        border-color: #d2d6de;
    }

        .form-control:not(select) {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

    .ncd-box {
        background: #ecf8ee !important;
        border: 1px dashed #ccc !important;
        padding: 20px;
        margin-bottom: 30px;
        width: 100%;
    }

    fieldset legend {
        border: none;
        background: #bf8313;
        width: auto;
        color: #ffffff;
        padding: 2px 10px;
    }

    .flexEqualCenter {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    a.backBtn {
        padding: 3px 5px;
        background: rgb(99,205,219);
        color: #fff;
        border: 0px;
        outline: none;
        display: inline-block;
        text-decoration: none;
    }

        a.backBtn i {
            display: inline-block;
            margin-right: 5px;
        }

    .tblthfont {
        font-weight: bold;
    }

    .d-flex {
        display: flex;
    }
</style>

<script src="~/Scripts/AngularFramework/NcdBasicDetailsEdit.js"></script>
