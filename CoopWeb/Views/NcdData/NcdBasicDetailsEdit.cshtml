                        </div>
                        <div class="col-md-6">
                            <label>
                                <strong>2(h). Full Address:</strong>
                            </label>
                            <span>{{ ncd.fulladdress}}</span>
                        </div>
                    </div>


                </fieldset>

                <fieldset class="ncd-box">
                    <legend>Contact Details</legend>
                    <div class="row">
                        <div class="col-sm-4">
                            <label>3(a). Name <span class="text-danger">*</span></label>
                            <div class="form-group">
                                <input type="text" name="Name" ng-model="ncd.contact_person" placeholder="Name" required="required" maxlength="255" class="form-control">
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <label for="designation">3(b). Designation <span class="text-danger">*</span></label>
                            <select name="designation"
                                    id="designation"
                                    ng-model="ncd.designation"
                                    class="form-control"
                                    required="required"
                                    ng-options="d.ncd_designation_id as d.name for d in NcdDesignationsList">
                                <option value="" disabled selected>{{translation.SelectOption}}</option>

                            </select>
                        </div>

                        <div class="col-sm-4">
                            <label for="mobile_no">3(c). Mobile Number <span class="text-danger">*</span></label>
                            <div class="form-group">
                                <input type="text" name="mobile_no" id="mobile_no" ng-model="ncd.Mobile" placeholder="Enter Mobile Number" required="required" ng-disabled="ncd.mobile"
                                       maxlength="10" minlength="10" pattern="[0-9]{10}" class="form-control">
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label for="landline_number">3(d). Landline Number with STD Code <span class="text-danger">*</span></label>
                            <div class="form-group d-flex">
                                <input type="text" name="landline_number" id="landline_number" ng-model="ncd.landline" placeholder="Landline Number" maxlength="8"
                                       pattern="[0-9]{6,8}" required="required" class="form-control" ng-disabled="ncd.landline" />
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <label for="email">3(e). Email <span class="text-danger">*</span></label>
                            <div class="form-group">
                                <input type="email" name="email" id="email" ng-model="ncd.email" placeholder="Enter Email Address" required="required"
                                       maxlength="255" class="form-control">
                            </div>
                        </div>

                        <div class="col-sm-12">
                            <p class="fw-bold">
                                Note : <span class="text-primary">#</span> Fields are optional
                            </p>
                        </div>
                    </div>
                </fieldset>



                <fieldset class="ncd-box">
                    <legend class="dvlegend">Sector Details</legend>

                    <!-- Display section -->
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>4(a). Sector of Operation:</strong>
                                </label>
                                <span> {{ ncd.IsCredit == 1 ? 'Credit' : (ncd.IsCredit == 2 ? 'Non-Credit' : '') }}</span>
                            </div>

                            <div class="col-md-6">
                                <label>
                                    <strong>4(b). Primary Activity:</strong>
                                </label>
                                <span>{{ ncd.Sectorname }}</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>5(a). Tier of the Cooperative Society:</strong>
                                </label>
                                <span>{{  }}</span>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    <strong>5(b). Operation Area Location:</strong>
                                </label>
                                <span> {{ ncd.LocationArea == 1 ? 'Urban' : (ncd.LocationArea == 2 ? 'Rural' : '') }}</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>5(b)(i).  Area of operation Rural:</strong>
                                </label>
                                <span>{{ ncd.UrbanRuralArea }}</span>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    <strong>5(c)(i). District:</strong>
                                </label>
                                <span>{{ ncd.DistrictName }}</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>5(c)(ii). Block:</strong>
                                </label>
                                <span>{{ ncd.BlockName }}</span>
                            </div>

                            <div class="col-md-6">
                                <label>
                                    <strong>5(c)(iii). Gram Panchayat:</strong>
                                </label>
                                <span>{{ ncd.GPName }}</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>5(c)(iv). Village:</strong>
                                </label>
                                <span>{{ ncd.VillageName }}</span>
                            </div>

                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>
                                        5(d). Whether Area of Operation (Village, Panchayat, Block or Mandal or Town, Taluka/District) is adjacent to or includes water body:
                                    </strong>
                                </label>
                                <span>{{ ncd.waterbody }}</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-7">
                                <label>
                                    <strong>
                                        5(f). Whether the Society is affiliated to Union/Federation/Central/State Coop Bank/Milk Union/Central Fishermens`s Society:
                                    </strong>
                                </label>
                                <span>{{ncd.affilated == 1 ? 'Yes' : 'No'}}</span>
                            </div>

                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>6. Present Functional Status:</strong>
                                </label>
                                <span>{{ ncd.functionstatus }}</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>  7. Number of Members of the Cooperative Society :</strong>
                                </label>
                                <span>{{ ncd.NumberofmemberofSociety }}</span>
                            </div>

                            <div class="col-md-6">
                                <label>
                                    <strong>  8. Whether Financial Audit has been done? :</strong>
                                </label>
                                <span>{{ ncd.audityears }}</span>
                            </div>
                        </div>
                        @*{{ncdm}}*@

                        <div class="row">
                            <div class="col-sm-6">

                                <p><strong>{{ncd.NumberofmemberofSociety || 0}}</strong></p>

                                <table class="table table-bordered text-center">
                                    <thead class="table-light">
                                        <tr>
                                            <th></th>
                                            <th>General</th>
                                            <th>SC</th>
                                            <th>ST</th>
                                            <th>OBC</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Male</td>
                                            <td>{{ncdm.m_general}}</td>
                                            <td>{{ncdm.msc || 0}}</td>
                                            <td>{{ncdm.mst || 0}}</td>
                                            <td>{{ncdm.m_obc || 0}}</td>
                                            <td>{{ (+ncdm.m_general || 0) + (+ncdm.msc || 0) + (+ncdm.mst || 0) + (+ncdm.m_obc || 0) }}</td>
                                        </tr>
                                        <tr>
                                            <td>Female</td>
                                            <td>{{ncdm.f_general}}</td>
                                            <td>{{ncdm.fsc}}</td>
                                            <td>{{ncdm.fst}}</td>
                                            <td>{{ncdm.f_obc}}</td>
                                            <td>{{ (+ncdm.f_general || 0) + (+ncdm.fsc || 0) + (+ncdm.fst || 0) + (+ncdm.f_obc || 0) }}</td>
                                        </tr>
                                        <tr>
                                            <td>Transgender</td>
                                            <td>{{ncdm.t_general}}</td>
                                            <td>{{ncdm.tsc}}</td>
                                            <td>{{ncdm.tst}}</td>
                                            <td>{{ncdm.t_obc}}</td>
                                            <td>{{ (+ncdm.t_general || 0) + (+ncdm.tsc || 0) + (+ncdm.tst || 0) + (+ncdm.t_obc || 0) }}</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Total</strong></td>
                                            <td>{{ (+ncdm.m_general || 0) + (+ncdm.f_general || 0) + (+ncdm.t_general || 0) }}</td>
                                            <td>{{ (+ncdm.msc || 0) + (+ncdm.fsc || 0) + (+ncdm.tsc || 0) }}</td>
                                            <td>{{ (+ncdm.m_st || 0) + (+ncdm.fst || 0) + (+ncdm.tst || 0) }}</td>
                                            <td>{{ (+ncdm.m_obc || 0) + (+ncdm.f_obc || 0) + (+ncdm.t_obc || 0) }}</td>
                                            <td>
                                                {{
                                                   (
                                                     (+ncdm.m_general || 0) + (+ncdm.msc || 0) + (+ncdm.m_st || 0) + (+ncdm.m_obc || 0)
                                                   ) +
                                                   (
                                                     (+ncdm.f_general || 0) + (+ncdm.fsc || 0) + (+ncdm.fst || 0) + (+ncdm.f_obc || 0)
                                                   ) +
                                                   (
                                                     (+ncdm.t_general || 0) + (+ncdm.tsc || 0) + (+ncdm.tst || 0) + (+ncdm.t_obc || 0)
                                                   )
                                                }}
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>9(a). Whether the Cooperative Society is profit making? :</strong>
                                </label>
                                <span>{{ ncd.Profitmaking ? 'Yes' : 'No' }}</span>
                            </div>

                            <div class="col-md-6">
                                <label>
                                    <strong>9(b). Net Loss of the Cooperative Society :</strong>
                                </label>
                                <span>{{ ncd.netloss }}</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>
                                        9(c). Whether the dividend paid by the Cooperative  Society? :
                                    </strong>
                                </label>
                                <span>{{ ncd.isdevidentpaid }}</span>
                            </div>
                            <div class="col-md-6">
                                <label>
                                    <strong>9(e). is MSME Registered?:</strong>
                                </label>
                                <span>{{ ncd.msme ? 'Yes' : 'No' }}</span>
                            </div>
                        </div>

                        <div class="form-group">

                            <div class="col-md-6">
                                <label>
                                    <strong>10(a). Select the type of bank where the cooperative society have a bank account?	:</strong>
                                </label>
                                <span>{{ ncd.bank_type}}</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6">
                                <label>
                                    <strong>
                                        10(b). Select the name of the bank where the cooperative society has its bank account :
                                    </strong>
                                </label>
                                <span>{{ ncd.bankname }}</span>
                            </div>
                        </div>

                    </div>

                </fieldset>

                <div class="row" style="margin-top:15px">
                    <div class="col-sm-12">
                        <button class="btn btn-primary" ng-click="UpdateNcdData(ncd.cooperative_id)">
                            {{ Editing ? 'Updating...' : 'Update' }}
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
