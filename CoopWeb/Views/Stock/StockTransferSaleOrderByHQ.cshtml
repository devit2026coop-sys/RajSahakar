
<script src="~/Scripts/AngularFramework/StockTransferSaleOrderByHQ.js"></script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>

<div ng-app="StockTransferSaleOrderCnt">
    <div ng-controller="StockTransferSaleOrderMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.StockTransferSaleOrder}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.StockManagement}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.StockTransferSaleOrder}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowDivProductInsert()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; {{translation.AddStockTransferSaleOrder}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divInsertProduct">
            <form class="citizen-dash-head">

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.OrderType}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="radio" name="rdoOrderType" value="1" ng-model="HqOrder.OrderType" ng-checked="true" ng-change="ChangeOrderType()" /> {{translation.StockTransfer}} &nbsp;&nbsp;
                        <input type="radio" name="rdoOrderType" value="2" ng-model="HqOrder.OrderType" ng-change="ChangeOrderType()" /> {{translation.SalesOrder}} &nbsp;&nbsp;
                    </div>
                    <div class="col-lg-2">{{ translation.OrderForWhichPlant}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" id="ddlPlant" ng-model="HqOrder.PlantId" ng-init="HqOrder.PlantId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in ProcessingUnits" value="{{item.ProcessingUnitId}}">
                                {{_language =='en-us' ?  item.ProcessingUnitNameEng : item.ProcessingUnitNameHi}}
                            </option>
                        </select>
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Product}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="HqOrder.ProductId" ng-init="HqOrder.ProductId='0'" ng-change="GetSalesEntryForm()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Products" value="{{item.ProductId}}">
                                {{_language =='en-us' ?  item.ProductNameEng : item.ProductNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.OrderDate}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input dat-val="1" id="txtOrderDate" class="form-control devcalender SetCalender" disabled="disabled" placeholder="{{translation.OrderDate}}" ng-model="HqOrder.OrderDate" autocomplete="off" />
                    </div>
                </div>

                <div class="col-lg-12 form-group" ng-hide="IsStockTransfer">
                    <div class="col-lg-2">{{ translation.SalesOrderTakingFirmName}} <span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="HqOrder.FirmName" placeholder={{translation.SalesOrderTakingFirmName}} autocomplete="off" maxlength="50" />
                    </div>
                </div>

                <div class="col-lg-12 form-group" ng-show="IsStockTransfer">
                    <div class="col-lg-2">{{ translation.DepotName}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="HqOrder.DepotId" ng-init="HqOrder.DepotId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Depots" value="{{item.DepotId}}">
                                {{_language =='en-us' ?  item.DepotNameEng : item.DepotNameHi}}
                            </option>
                        </select>
                    </div>
                </div>

                <div ng-show="divPackingDetails">
                    <div class="col-lg-12 form-group">
                        <h4 class="heading-hr ng-binding"> {{translation.StockTransferSaleOrderDetail}}</h4>
                    </div>

                    <div class="citizen-dash-head">
                        <table class="table table-responsive devtable" style="overflow-x:auto;">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="vertical-align:central;text-align:center;">
                                        {{translation.SRNO}}
                                    </th>
                                    <th rowspan="2" style="text-align:center">
                                        {{translation.ProductSubCategory}}
                                    </th>
                                    <th colspan="{{InitialStockData.PackingList.length}}" style="text-align:center">
                                        {{translation.PackagingMaster}}
                                    </th>
                                </tr>
                                <tr>
                                    <th ng-repeat="itemPacking in InitialStockData.PackingList" style="text-align:center;">
                                        {{_language === 'en-us' ? itemPacking.PackingNameEng : itemPacking.PackingNameHi }}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in InitialStockData.ProductSubCategoryPackingMappingList">
                                    <td>{{$index+1}}</td>
                                    <td>
                                        {{_language === 'en-us' ? item.ProductSubCategoryNameEng : item.ProductSubCategoryNameHi }}
                                    </td>
                                    <td ng-repeat="item2 in item.ProductSubCategoryQuantityEntity">
                                        <input type="text" class="form-control" ng-model="item2.Quantity" maxlength="5" onkeypress='return event.charCode>= 48 && event.charCode <= 57 || (event.charCode===190)' />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>


                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary" ng-click="Insert()">{{translation.Submit}}</button>
                            <button type="submit" class="btn btn-primary" ng-click="Clear()">{{translation.Clear}}</button>
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToList()"> {{translation.Back}}</a>
                            <input type="hidden" ng-model="StockDemand.StockDemandId" />
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="GridProducts">
            <div>
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-lg-12 form-group">
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">{{translation.Search}}:</label>
                                <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                            </div>
                            <div class="col-md-4" style="padding-left: 0;">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                            </div>
                        </div>
                    </div>
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('IsStockTransfer')">
                                    {{translation.OrderType}}
                                    <div ng-class="getSortClass('IsStockTransfer')"></div>
                                </th>
                                <th ng-click="sortData('ProductNameEng')">
                                    {{translation.OrderForWhichPlant}}
                                    <div ng-class="getSortClass('ProductNameEng')"></div>
                                </th>
                                <th ng-click="sortData('ProductSubCategoryNameEng')">
                                    {{translation.Product}}
                                    <div ng-class="getSortClass('ProductSubCategoryNameEng')"></div>
                                </th>
                                <th ng-click="sortData('UnitNameEng')">
                                    {{translation.OrderDate}}
                                    <div ng-class="getSortClass('UnitNameEng')"></div>
                                </th>
                                <th>
                                    {{translation.SalesOrderTakingFirmName}}
                                </th>
                                <th>
                                    {{translation.DepotName}}
                                </th>
                                <th>
                                    {{translation.IsInTransit}}
                                </th>
                                <th>
                                    {{translation.OrderFulfillDate}}
                                </th>
                                <th>
                                    {{translation.OrderDetails}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in StockTransferSalesOrderList | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>
                                    {{ item.IsStockTransfer ==='True'  ? translation.StockTransfer : translation.SalesOrder }}
                                </td>
                                <td>
                                    {{ _language === 'en-us' ? item.ProcessingUnitNameEng : item.ProcessingUnitNameHi}}
                                </td>
                                <td>
                                    {{ _language === 'en-us' ? item.ProductNameEng : item.ProductNameHi}}
                                </td>
                                <td>
                                    {{ item.OrderDate }}
                                </td>
                                <td>
                                    {{ item.FirmName}}
                                </td>
                                <td>
                                    {{ _language === 'en-us' ? item.DepotNameEng : item.DepotNameHi}}
                                </td>
                                <td>
                                    {{ item.IsInTransit === 'True'  ? translation.Yes : translation.No}}
                                </td>
                                <td>
                                    {{ item.OrderTakenDateTimeByDepot}}
                                </td>
                                <td>
                                    <div ng-click="GetOrderDetails(item.IdStockTransferSaleOrderOnPlantByHQ,item.ProductId)" data-target="#myModalForVehicleDetailsStatus" data-toggle="modal">{{translation.Details}}</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="TrainningFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>

            <div class="dev-popup-body modal fade" id="myModalForVehicleDetailsStatus">
                <div class="modal-dialog" style="width:950px;">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                            <h4 class="modal-title"> {{translation.OrderDetails}}  </h4>
                        </div>


                        <div class="citizen-dash-head">
                            <table class="table table-responsive devtable" style="overflow-x:auto;">
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="vertical-align:central;text-align:center;">
                                            {{translation.SRNO}}
                                        </th>
                                        <th rowspan="2" style="text-align:center">
                                            {{translation.Product}}
                                        </th>
                                        <th colspan="4" style="text-align:center;">
                                            {{translation.PackagingMaster}}
                                        </th>
                                    </tr>
                                    <tr>
                                        <th ng-repeat="itemPacking in OrderDetails.PackingList" style="text-align:center;">
                                            {{_language === 'en-us' ? itemPacking.PackingNameEng : itemPacking.PackingNameHi }}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in OrderDetails.ProductSubCategoryPackingMappingList">
                                        <td>{{$index+1}}</td>
                                        <td>
                                            {{_language === 'en-us' ? item.ProductSubCategoryNameEng : item.ProductSubCategoryNameHi }}
                                        </td>
                                        <td ng-repeat="item2 in item.ProductSubCategoryQuantityEntity">
                                            <label>{{item2.Quantity}}</label>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>

</div>

