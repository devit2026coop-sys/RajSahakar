
<script src="~/Scripts/AngularFramework/TilamSanghStockPurchaseDelivery.js"></script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>

<div ng-app="TilamSanghStockPurchaseDeliveryCnt">
    <div ng-controller="TilamSanghStockPurchaseDeliveryMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.StockPurchase}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.StockManagement}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.StockPurchase}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowDivProductInsert()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; {{translation.InsertProduct}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <form class="citizen-dash-head">

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.ProcessingUnit}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="PurchaseRegister.ProcessingUnitId" ng-init="PurchaseRegister.ProcessingUnitId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in ProcessingUnits" value="{{item.ProcessingUnitId}}">
                                {{_language =='en-us' ?  item.ProcessingUnitNameEng : item.ProcessingUnitNameHi}}
                            </option>
                        </select>
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Party}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.PartyName" />
                    </div>
                    <div class="col-lg-2">{{ translation.PartyNameHi}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.PartyNameHi" />
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Broker}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.BrokerName" />
                    </div>
                    <div class="col-lg-2">{{ translation.BrokerNameHi}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.BrokerNameHi" />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Product}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="PurchaseRegister.ProductId" ng-init="PurchaseRegister.ProductId='0'" ng-change="ProductSubCategoryList()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Products" value="{{item.ProductId}}">
                                {{_language =='en-us' ?  item.ProductNameEng : item.ProductNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.ProductSubCategory}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="PurchaseRegister.ProductSubCategoryId" ng-init="PurchaseRegister.ProductSubCategoryId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in ProductSubCategories" value="{{item.ProductSubCategoryId}}">
                                {{_language =='en-us' ?  item.ProductSubCategoryNameEng : item.ProductSubCategoryNameHi}}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="col-lg-12 form-group">

                    <div class="col-lg-2">{{ translation.UnitMaster}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="PurchaseRegister.UnitId" ng-init="PurchaseRegister.UnitId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Units" value="{{item.UnitId}}">
                                {{_language =='en-us' ?  item.UnitNameEng : item.UnitNameHi}}
                            </option>
                        </select>
                    </div>

                    <div class="col-lg-2">{{ translation.Quantity}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.Quantity" />
                    </div>

                </div>


                <div class="col-lg-12 form-group">

                    <div class="col-lg-2">{{ translation.RateUnit}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="PurchaseRegister.RateUnitId" ng-init="PurchaseRegister.RateUnitId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Units" value="{{item.UnitId}}">
                                {{_language =='en-us' ?  item.UnitNameEng : item.UnitNameHi}}
                            </option>
                        </select>
                    </div>

                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Rate}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.Rate" />
                    </div>
                    <div class="col-lg-2">{{ translation.RateQuantity}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.RateQuantity" />
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.PaymentDate}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input dat-val="1" id="txtPurchasedate" class="form-control devcalender SetCalender" disabled="disabled" placeholder="{{translation.PaymentDate}}" ng-model="PurchaseRegister.PurchasePaymentDate" autocomplete="off" />
                    </div>
                    <div class="col-lg-2">{{ translation.ExpectedDeliveryDate}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input dat-val="1" id="txtDeliverydate" class="form-control devcalender SetCalender" disabled="disabled" placeholder="{{translation.ExpectedDeliveryDate}}" ng-model="PurchaseRegister.ExpectedDeliveryDate" autocomplete="off" />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.SaleContractNo}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.SaleContractNo" />
                    </div>
                    <div class="col-lg-2">{{ translation.Conditions}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.Conditions" />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Remarks}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="PurchaseRegister.Remark" />
                    </div>
                </div>
               

                <div>
                    <div class="col-lg-12 form-group">
                        <h4 class="heading-hr ng-binding"> {{translation.StockPurchaseDetails}}</h4>
                    </div>


                    <div class="col-lg-12">
                        <div class="table-responsive">
                            <table class="table devtable">
                                <thead>
                                    <tr>
                                        <th rowspan="2">{{translation.SRNO}}</th>
                                        <th rowspan="2">{{translation.VehicleNo}}</th>
                                        <th rowspan="2">{{translation.RateQuantity}}</th>
                                        <th>&nbsp;</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in PurchaseDetails">
                                        <td>{{$index+1}}</td>
                                        <td><input type="text" class="form-control" ng-model="item.VehicleNo" maxlength="12" /></td>
                                        <td><input type="text" class="form-control" ng-model="item.Quantity" maxlength="4" onkeypress='return event.charCode >= 48 && event.charCode <= 57' /></td>
                                        <td><i ng-hide="($index+1)==1" class="fa fa-trash" title="Remove" ng-click="RemovePurchaseDetails($index)"></i></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3">&nbsp;</td>
                                        <td ng-click="AddPurchaseDetails()"><i class="fa fa-plus" title="Add New"></i>{{translation.Add}}</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="SaveStockPurchase()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearProcessingUnitForm()">{{translation.Clear}}</button>
                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToProcessingUnitList()"> {{translation.Back}}</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

</div>