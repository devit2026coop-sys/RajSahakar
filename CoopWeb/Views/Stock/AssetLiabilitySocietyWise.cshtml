
<script src="~/Scripts/AngularFramework/AssetLiabilitySocietyWise.js"></script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>

<div ng-app="AssetLiabilitySocietyWiseCnt">
    <div ng-controller="AssetLiabilitySocietyWiseMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.UnitMaster}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.StockManagement}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.UnitMaster}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowDivProductInsert()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; {{translation.InsertUnitMaster}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>


        <div class="col-md-12">
            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                <div class="citizen-dash-head">
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th colspan="3" style="text-align:center;">
                                    {{translation.Asset}}
                                </th>
                            </tr>
                            <tr>
                                <th style="text-align:center;">
                                    {{translation.SRNO}}
                                </th>
                                <th style="text-align:center;">
                                    {{translation.Head}}
                                </th>
                                <th style="text-align:center;">
                                    {{translation.Amount}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in AssetLiabilities.AssetList">
                                <td>
                                    {{$index+1}}
                                </td>
                                <td>
                                    {{ _language === 'en-us' ? item.NameEng : item.NameHi}}
                                    <br />
                                    <table ng-show="item.IsFurtherExtended" width="100" class="col-md-12">
                                        <thead>
                                            <tr>
                                                <th style="text-align:center;">
                                                    {{translation.SRNO}}
                                                </th>
                                                <th style="text-align:center;">
                                                    {{_language === 'en-us' ? 'Details' : 'विवरण' }}
                                                </th>
                                                <th style="text-align:center;">
                                                    {{translation.Amount}}
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item2 in item.AmountDistribution">
                                                <td>
                                                    {{$index+1}}
                                                </td>
                                                <td>
                                                    {{item2.WhereDid}}
                                                </td>
                                                <td>
                                                    {{item2.Amount}}
                                                </td>
                                            </tr>

                                        </tbody>
                                    </table>
                                </td>
                                <td>
                                    {{item.Amount}}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                <div class="citizen-dash-head">
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th colspan="3" style="text-align:center;">
                                    {{translation.Liability}}
                                </th>
                            </tr>
                            <tr>
                                <th style="text-align:center;">
                                    {{translation.SRNO}}
                                </th>
                                <th style="text-align:center;">
                                    {{translation.Head}}
                                </th>
                                <th style="text-align:center;">
                                    {{translation.Amount}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in AssetLiabilities.LiabilityList">
                                <td>
                                    {{$index+1}}
                                </td>
                                <td>
                                    {{ _language === 'en-us' ? item.NameEng : item.NameHi}}
                                    <br />
                                    <table ng-show="item.IsFurtherExtended" width="100" class="col-md-12">
                                        <thead>
                                            <tr>
                                                <th style="text-align:center;">
                                                    {{translation.SRNO}}
                                                </th>
                                                <th style="text-align:center;">
                                                    {{_language === 'en-us' ? 'Details' : 'विवरण' }}
                                                </th>
                                                <th style="text-align:center;">
                                                    {{translation.Amount}}
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="item2 in item.AmountDistribution">
                                                <td>
                                                    {{$index+1}}
                                                </td>
                                                <td>
                                                    {{item2.WhereDid}}
                                                </td>
                                                <td>
                                                    {{item2.Amount}}
                                                </td>
                                            </tr>

                                        </tbody>
                                    </table>
                                </td>
                                <td>
                                    {{item.Amount}}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>

</div>