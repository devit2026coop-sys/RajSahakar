
@{
    ViewBag.Title = "CommodityMaster";
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}


<script src="~/Scripts/AngularFramework/CommodityMaster.js"></script>
<script type="text/javascript" src="~/Scripts/1.8.3.jquery.min.js"></script>

<div ng-app="CommodityMasterModule" ng-controller="CommodityMasterCont">

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <h3 class="citizen-dash-head">{{translation.CommodityMaster}} </h3>
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="../Citizen/Index"> {{translation.Home}} </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.CommodityMaster}} </span>
                </li>
                <li style="float: right;" id="divAddBtn">
                    <i class="fa fa-angle-double-right" style="color: #025e63;"></i>
                    <a ng-click="AddNew()" style="color: #025e63; cursor: pointer; text-decoration:none; font-weight: bold;" class="ng-binding">{{translation.AddNew}}</a>
                </li>
            </ul>
        </div>
    </div>



    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-if="divShowdata">
        <div class="table-responsive citizen-dash-head">

            @*<div class="table-dropdown" id="search-filter">
                    <div class="col-lg-4">
                        <label for="search" class="ng-binding">{{translation.District}}:</label>
                        <select id="DISTRICT_ID" name="DISTRICT_ID" class="form-control" ng-model="PurchaseCenter.DISTRICT_ID" ng-init="PurchaseCenter.DISTRICT_ID='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in DistrictList" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-4" ng-show="showSearchText">
                        <label for="search" class="ng-binding">Search:</label>
                        <input name="searchText" id="search" class="form-control ng-pristine ng-valid ng-empty ng-touched" ng-model="PurchaseCenter.SearchText" placeholder="Filter Text" autocomplete="off">
                    </div>


                    <div class="col-md-4">
                        <label>&nbsp;</label><br>
                        <button type="button" ng-click="searchRequest(GetPurchaseCenterList)" class="btn btn-primary dev-btn ng-binding">{{translation.Search}}</button>
                        <button type="button" ng-click="ClearSearch()" class="btn btn-primary dev-btn ng-binding">{{translation.Clear}}</button>
                    </div>
                </div>*@

            <table id="example" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                <thead>
                    <tr>
                        <th>
                            {{translation.SRNO}}
                        </th>
                        <th>
                            Commodity Name
                            @*{{_language =='en-us' ?  translation.CommodityNameEng : translation.CommodityNameHi}}*@
                         
                        </th>

                        <th>
                            {{translation.Date}}
                        </th>


                        <th>
                            {{translation.InActive}}/{{translation.Active}}
                        </th>
                        <th>
                            {{translation.Edit}}
                        </th>
                        <th>
                            {{translation.DeleteRow}}
                        </th>
                        <th>
                            {{translation.Price}}
                        </th>

                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in CommoditymasterList">
                        <td>{{(((DataPagingDetails.PageNumber - 1) * DataPagingDetails.PageSize) + 1)+$index}}</td>
                        <td>
                         
                            {{_language =='en-us' ?  item.CommodityNameEn : item.CommodityNameHi}}
                        </td>
                        <td>
                            {{item.CreationDate}}
                        </td>

                        <td>
                            <div class="dev-action">
                                <label class="switch">
                                    <input type="checkbox" ng-checked="item.IsActive == 1" ng-click="ChangeStatus(item,3)">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                        </td>
                        <td>
                            <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="EditRecord(item)"></i>
                        </td>
                        <td>
                            <i class="fa fa-trash" data-target="#myModal" data-toggle="modal" ng-click="ChangeStatus(item,4)"></i>
                        </td>
                        <td>
                            <button type="button" ng-click="AddpriceCommudity(item)" class="btn btn-primary dev-btn ng-binding">Add Price</button>
                        </td>

                    </tr>
                </tbody>
            </table>

            <div class="col-md-12">
                <div ng-if="DataPagingDetails.TotalPages>1" class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                    <div class="dataTables_info" id="dataTables-example_info" role="status" aria-live="polite">
                        Total Records: {{DataPagingDetails.TotalRecords}}
                    </div>
                    <ul class="pagination pagination_1" style="margin-left: 10px !important;">
                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« First</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == 1" class="previous-off"><span>« Previous</span></li>

                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest('1',GetCommoditymasterList)" style="cursor: pointer;">
                            <span>«First</span>
                        </li>
                        <li ng-if="DataPagingDetails.PageNumber > 1" class="previous-off" ng-click="pageRequest(DataPagingDetails.PageNumber-1,GetCommoditymasterList)" style="cursor:pointer;">
                            <span>« Previous</span>
                        </li>
                        <li class="{{n==DataPagingDetails.PageNumber?'active':''}}" style="{{n==DataPagingDetails.PageNumber?'':'cursor: pointer'}}" ng-repeat="n in PagingRange(DataPagingDetails.StartPageNumber,DataPagingDetails.EndPageNumber,DataPagingDetails.TotalPages)" ng-click="pageRequest(n,GetCommoditymasterList)"><span>{{n}}</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Next</span></li>
                        <li ng-if="DataPagingDetails.PageNumber == DataPagingDetails.TotalPages" class="next"><span>« Last</span></li>
                        <li ng-if="DataPagingDetails.PageNumber!= DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.PageNumber+1,GetCommoditymasterList)" style="cursor:pointer;">
                            <span>Next »</span>
                        </li>
                        <li ng-if="DataPagingDetails.PageNumber != DataPagingDetails.TotalPages" class="next" ng-click="pageRequest(DataPagingDetails.TotalPages,GetCommoditymasterList)" style="cursor:pointer;">
                            <span>Last »</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>



    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divInsert">
        <div class="citizen-dash-head">
            <div class="col-lg-12 form-group">

                <div class="col-lg-2">{{translation.CommodityNameEng}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input name="CommodityNameEn" id="CommodityNameEn" class="form-control" ng-model="CommodityMaster.CommodityNameEn" placeholder="Commodity Name">
                </div>
                <div class="col-lg-2">{{translation.CommodityNameHi}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input name="CommodityNameHi" id="CommodityNameHi" class="form-control" ng-model="CommodityMaster.CommodityNameHi" placeholder="Commodity Name(Hindi)">
                </div>
            </div>

            <div class="col-lg-12 form-group">

                <div class="col-lg-2">{{translation.IsKharif}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="checkbox" name="IsKharifstaus" value="1" id="IsKharif" ng-checked="IsKharifstaus" ng-model="CommodityMaster.IsKharif" />&nbsp;&nbsp;{{translation.IsKharif}}
                </div>

                <div class="col-lg-2">{{translation.IsActive}}<span class="error">*</span></div>
                <div class="col-lg-4">
                    <input type="checkbox" name="IsActivestatus" value="1" id="IsActive" ng-checked="IsActivestatus" ng-model="CommodityMaster.IsActive" />&nbsp;&nbsp;{{translation.IsActive}}
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-menu-btn">
                    <button type="button" class="btn btn-primary" ng-click="SaveCommodityMaster()">{{translation.Submit}}</button>

                </div>
            </div>


        </div>
    </div>



    <div class="dev-popup-body modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false" >
        <div class="modal-dialog">
            <div class="modal-content" style="width: 838px;  margin-left: -100px;">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" ng-click="ClearOrganisationForm()">&times;</button>
                    <h4 class="modal-title">{{translation.CommodityPrice}} </h4>
                </div>
                <div class="modal-body" id="DvPriceAdd">
                    <form class="dev-search-form" style="overflow: hidden; margin-bottom: 35px;" name="OrganisationForm">
                        <div class="col-md-12">
                            <div class="col-md-3">
                                <label>{{translation.FincialYearHeading}}<span class="error">*</span></label>
                                </div>
                                <div class="col-md-6">
                                    <select class="form-control" ng-model="CommodityPrice.FinancialYear" ng-init="CommodityPrice.FinancialYear='0'">
                                        <option value="0" disabled>{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in FinancialYearList" value="{{item.FIN_YEAR_MASTR_ID}}">
                                            {{item.FIN_YEAR_NAME}}
                                        </option>
                                    </select>
                                </div>
                            </div>


                        <div class="col-md-12" style="margin-top:10px;" ng-show="priceshowfaq">
                            <div class="col-md-3">
                                <label>{{translation.FAQPrice}}<span class="error">*</span></label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="form-control" ng-model="CommodityPrice.PriceFAQ" placeholder="FAQ Price">
                            </div>
                        </div>
                      
                     
                        <div class="col-md-12" style="margin-top:10px;" ng-show="priceshowURS">
                            <div class="col-md-3">
                                <label>{{translation.URSPrice}}<span class="error">*</span></label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="form-control" ng-model="CommodityPrice.PriceURS" placeholder="URS Price">
                            </div>
                        </div>
                        <div class="col-md-12" style="margin-top:10px;">
                            <div class="col-md-3" ><label>{{translation.IsActive}}</label></div>
                            <div class="col-md-6">
                                <input type="checkbox" name="IsActivePrice" value="1" id="IsActivePrice" ng-checked="IsActivestatus" ng-model="CommodityPrice.IsActive" />&nbsp;&nbsp;<label>IsActive</label>
                            </div>
                        </div>
                        <div class="col-md-12" style="margin-top: 15px; margin-bottom:20px; text-align:center">
                            <button type="submit" class="btn btn-primary" ng-click="SavePriceCommudity()">{{translation.Submit}}</button>
                            <button type="submit" class="btn btn-primary" ng-click="CancelPriceCommudity()">{{translation.Cancel}}</button>
                        </div>


                        <div class="table-dropdown" id="search-filter">
                            </div>
                            <div class="table-responsive citizen-dash-head" style="margin-top: 30px;">
                                <table id="example11" class="table devtable" style="border:1px solid rgb(222, 221, 221); float: left;">
                                    <thead>
                                        <tr>
                                            <th>SN.</th>
                                            <th>
                                                {{translation.UnitType}}
                                            </th>
                                            <th>
                                                {{translation.Price}}
                                            </th>
                                            <th>{{translation.FincialYearHeading}} </th>
                                            <th>
                                                {{translation.InActive}}/{{translation.Active}}
                                            </th>
                                            <th>
                                                {{translation.Edit}}
                                            </th>
                                            <th>
                                                {{translation.DeleteRow}}
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <tr ng-repeat="item in CommodityPriceList">
                                            <td>{{1 + $index}}</td>
                                            <td ng-if="item.UnitId=='1'">
                                                {{translation.FAQ}}
                                            </td>
                                            <td ng-if="item.UnitId=='2'">
                                                {{translation.URS}}
                                            </td>
                                            <td>
                                                {{item.Price}}
                                            </td>
                                            <td>  {{item.FIN_YEAR_NAME}}</td>
                                            <td>
                                                <div class="dev-action">
                                                    <label class="switch">
                                                        <input type="checkbox" ng-checked="item.IsActive == 1" ng-click="ChangeStatusPrice(item,3)">
                                                        <span class="slider round"></span>
                                                    </label>
                                                </div>
                                            </td>
                                            <td>
                                                <i class="fa fa-edit" ng-click="EditRecordPrice(item)"></i>
                                            </td>
                                            <td>
                                                <i class="fa fa-trash" data-toggle="modal" ng-click="ChangeStatusPrice(item,4)"></i>
                                            </td>
                                        </tr>
                                        
                                    </tbody>
                                </table>
                            </div>
</form>
                </div>
            </div>
            </div>
        </div>


        </div>

