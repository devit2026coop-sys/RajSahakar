
<script src="~/Scripts/AngularFramework/Tilam_StockTransferSalesOrderReport.js"></script>
<script type="text/javascript">
    var tableToExcel = (function () {
        var uri = 'data:application/vnd.ms-excel;base64,'
            , template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>'
            , base64 = function (s) { return window.btoa(unescape(encodeURIComponent(s))) }
            , format = function (s, c) { return s.replace(/{(\w+)}/g, function (m, p) { return c[p]; }) }
        return function (table, name) {
            if (!table.nodeType) table = document.getElementById(table)
            var ctx = { worksheet: name || 'Worksheet', table: table.innerHTML }
            window.location.href = uri + base64(format(template, ctx))
        }
    })()
</script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>

<div ng-app="StockTransferSaleOrderReportCnt">
    <div ng-controller="StockTransferSaleOrderReportMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.StockTransferSaleOrder}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.StockManagement}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.StockTransferSaleOrder}} </span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <form class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.OrderType}} <span class="error">*</span></div>
                    <div class="col-lg-4" ng-init="HqOrder.OrderType=0">
                        <input type="radio" name="rdoOrderType" value="1" ng-model="HqOrder.OrderType" ng-checked="true" ng-change="ChangeOrderType()" /> {{translation.StockTransfer}} &nbsp;&nbsp;
                        <input type="radio" name="rdoOrderType" value="0" ng-model="HqOrder.OrderType" ng-change="ChangeOrderType()" /> {{translation.SalesOrder}} &nbsp;&nbsp;
                    </div>
                    <div class="col-lg-2">{{ translation.OrderForWhichPlant}}</div>
                    <div class="col-lg-4">
                        <select class="form-control" id="ddlPlant" ng-model="HqOrder.PlantId" ng-init="HqOrder.PlantId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in ProcessingUnits" value="{{item.ProcessingUnitId}}">
                                {{_language =='en-us' ?  item.ProcessingUnitNameEng : item.ProcessingUnitNameHi}}
                            </option>
                        </select>
                    </div>
                </div>


                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Product}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="HqOrder.ProductId" ng-init="HqOrder.ProductId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Products" value="{{item.ProductId}}">
                                {{_language =='en-us' ?  item.ProductNameEng : item.ProductNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.OrderDate}}</div>
                    <div class="col-lg-4">
                        <input dat-val="1" id="txtOrderDate" class="form-control devcalender SetCalender" disabled="disabled" placeholder="{{translation.OrderDate}}" ng-model="HqOrder.OrderDate" autocomplete="off" ng-init="HqOrder.OrderDate=''" />
                    </div>
                </div>

                <div class="col-lg-12 form-group" ng-hide="IsStockTransfer">
                    <div class="col-lg-2">{{ translation.SalesOrderTakingFirmName}}</div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="HqOrder.FirmName" placeholder={{translation.SalesOrderTakingFirmName}} autocomplete="off" maxlength="50" ng-init="HqOrder.FirmName=''" />
                    </div>
                </div>

                <div class="col-lg-12 form-group" ng-show="IsStockTransfer">
                    <div class="col-lg-2">{{ translation.DepotName}}</div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="HqOrder.DepotId" ng-init="HqOrder.DepotId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Depots" value="{{item.DepotId}}">
                                {{_language =='en-us' ?  item.DepotNameEng : item.DepotNameHi}}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="button" class="btn btn-primary" ng-click="ShowSearchData()">{{translation.Show}}</button>
                        <button type="button" class="btn btn-primary" ng-click="Clear()">{{translation.Clear}}</button>
                    </div>
                </div>
            </form>

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divSearchResult">
                <div class="citizen-dash-head">
                    <input type="button" class="btn btn-primary dev-btn" onclick="tableToExcel('divExcelDownload', 'AuditReportDistrictWise')" value="{{translation.ExportToExcel}}">
                </div>
                <div id="divExcelDownload" style="padding:20px 0px;">
                    <div class="citizen-dash-head">

                        <div ng-repeat="item in SearchData">

                            <table class="table table-responsive devtable" style="overflow-x:auto;">
                                <tbody>
                                    <tr>
                                        <td>{{ translation.OrderType}}</td>
                                        <td>
                                            {{ item.IsStockTransfer ? translation.StockTransfer : translation.SalesOrder}}
                                        </td>
                                        <td>
                                            {{ translation.OrderForWhichPlant}}
                                        </td>
                                        <td>
                                            {{ _language === 'en-us' ? item.PlantDetails.ProcessingUnitNameEng : item.PlantDetails.ProcessingUnitNameHi}}
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>{{ translation.Product}}</td>
                                        <td>
                                            {{ _language === 'en-us' ? item.ProductDetails.ProductNameEng : item.ProductDetails.ProductNameHi}}
                                        </td>
                                        <td>
                                            {{ translation.OrderDate}}
                                        </td>
                                        <td>
                                            {{ item.OrderDate.toMSDate()}}
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>{{ item.IsStockTransfer ? translation.DepotName :  translation.SalesOrderTakingFirmName }}</td>
                                        <td>
                                            {{ item.IsStockTransfer ? _language === 'en-us' ? item.DepotDetails.DepotNameEng : item.DepotDetails.DepotNameHi  :  item.FirmName }}
                                        </td>
                                        <td>
                                            {{ translation.IsInTransit}}
                                        </td>
                                        <td>
                                            {{ item.IsInTransit ? translation.Yes : translation.No}}
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>{{ translation.TransitDate }}</td>
                                        <td>
                                            <span ng-if="item.IsInTransit">  {{ translation.IsInTransit}}</span>
                                        </td>
                                        <td>
                                            <span ng-if="item.IsInTransit === false"> {{ translation.OrderFulfillDate}}</span>
                                        </td>
                                        <td>
                                            <span ng-if="item.IsInTransit === false">  {{item.OrderTakenDateTimeByDepot.toMSDate()}}</span>
                                        </td>
                                    </tr>

                                </tbody>
                            </table>


                            <table class="table table-responsive devtable" style="overflow-x:auto;">
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="vertical-align:central;text-align:center;">
                                            {{translation.SRNO}}
                                        </th>
                                        <th rowspan="2" style="text-align:center">
                                            {{translation.ProductSubCategory}}
                                        </th>
                                        <th colspan="{{item.OrderDetailShow.PackingList.length}}" style="text-align:center">
                                            {{translation.PackagingMaster}}
                                        </th>
                                    </tr>
                                    <tr>
                                        <th ng-repeat="itemPacking in item.OrderDetailShow.PackingList" style="text-align:center;">
                                            {{_language === 'en-us' ? itemPacking.PackingNameEng : itemPacking.PackingNameHi }}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item3 in item.OrderDetailShow.ProductSubCategoryPackingMappingList">
                                        <td>{{$index+1}}</td>
                                        <td>
                                            {{_language === 'en-us' ? item3.ProductSubCategoryNameEng : item3.ProductSubCategoryNameHi }}
                                        </td>
                                        <td ng-repeat="item4 in item3.ProductSubCategoryQuantityEntity">
                                            {{item4.Quantity}}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>


        </div>
    </div>

</div>

