
<script src="~/Scripts/AngularFramework/StockManagemenetMaster.js?600"></script>

<div ng-app="EncValueCnt">
    <div ng-controller="EncValueMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">Encrypt/Decrypt Value</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.StockManagement}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> Encrypt/Decrypt Value </span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <form class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">Value To Be  Encrypt</div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="Calculator.ToBeEncrypt" autocomplete="off" maxlength="100" />
                    </div>
                    <div class="col-lg-6">Plaint Text Value : {{Calculator.ToBeEncrypt}} &nbsp; &nbsp; &nbsp; &nbsp; Encrypted Value : <span style="font-weight:800;"> {{EncryptedValue}} </span> </div>
                </div>

                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="GetEncyptedValue()">{{translation.Submit}}</button>
                    </div>
                </div>
            </form>


            <form class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">Value To Be  Decrypt</div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="Calculator.ToBeDecrypt" autocomplete="off" maxlength="100" />
                    </div>
                    <div class="col-lg-6">Encrypted Text Value : {{Calculator.ToBeDecrypt}} &nbsp; &nbsp; &nbsp; &nbsp; Plaint Text Value : <span style="font-weight:800;">  {{DecryptedValue}} </span></div>
                </div>
                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="GetDecyptedValue()">{{translation.Submit}}</button>
                    </div>
                </div>
            </form>
        </div>

        
    </div>

</div>