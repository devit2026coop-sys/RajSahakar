
<script src="~/Scripts/AngularFramework/TilamSanghSalesRegister.js"></script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>

<div ng-app="TilamSanghSalesRegisterCnt">
    <div ng-controller="TilamSanghSalesRegisterMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.ProductSaleByDepot}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.StockManagement}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.ProductSaleByDepot}} </span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <form class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.Product}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="ProductId" ng-init="ProductId='0'" ng-change="GetSalesEntryForm()">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Products" value="{{item.ProductId}}">
                                {{_language =='en-us' ?  item.ProductNameEng : item.ProductNameHi}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{ translation.SellingDate}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input dat-val="1" id="txtSellingdate" class="form-control devcalender SetCalender" disabled="disabled" placeholder="{{translation.SellingDate}}" autocomplete="off" />
                    </div>
                </div>

                <div ng-show="IsShow">

                    <div class="col-lg-12 form-group">
                        <h4 class="heading-hr ng-binding"> {{translation.ProductAvailableQuantityAtDepot}}</h4>
                    </div>

                    <div class="citizen-dash-head">
                        <table class="table table-responsive devtable" style="overflow-x:auto;">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="vertical-align:central;text-align:center;">
                                        {{translation.SRNO}}
                                    </th>
                                    <th rowspan="2" style="text-align:center">
                                        {{translation.Product}}
                                    </th>
                                    <th colspan="4" style="text-align:center">
                                        {{translation.PackagingMaster}}
                                    </th>
                                </tr>
                                <tr>
                                    <th ng-repeat="itemPacking in SalesEntryData.PackingList" style="text-align:center;">
                                        {{_language === 'en-us' ? itemPacking.PackingNameEng : itemPacking.PackingNameHi }}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in SalesEntryData.ProductAvailableDetails">
                                    <td>{{$index+1}}</td>
                                    <td>
                                        {{_language === 'en-us' ? item.ProductSubCategoryNameEng : item.ProductSubCategoryNameHi }}
                                    </td>
                                    <td ng-repeat="item2 in item.ProductSubCategoryQuantityEntity">
                                        <label>{{item2.Quantity}}</label>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div ng-show="IsShow">

                    <div class="col-lg-12 form-group">
                        <h4 class="heading-hr ng-binding"> {{translation.DailySalesEntryAtDepot}}</h4>
                    </div>

                    <div class="citizen-dash-head">
                        <table class="table table-responsive devtable" style="overflow-x:auto;">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="vertical-align:central;text-align:center;">
                                        {{translation.SRNO}}
                                    </th>
                                    <th rowspan="2" style="text-align:center">
                                        {{translation.Product}}
                                    </th>
                                    <th colspan="4" style="text-align:center">
                                        {{translation.PackagingMaster}}
                                    </th>
                                </tr>
                                <tr>
                                    <th ng-repeat="itemPacking in SalesEntryData.PackingList" style="text-align:center;">
                                        {{_language === 'en-us' ? itemPacking.PackingNameEng : itemPacking.PackingNameHi }}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in SalesEntryData.ProductSalesEntryDetails">
                                    <td>{{$index+1}}</td>
                                    <td>
                                        {{_language === 'en-us' ? item.ProductSubCategoryNameEng : item.ProductSubCategoryNameHi }}
                                    </td>
                                    <td ng-repeat="item2 in item.ProductSubCategoryQuantityEntity">
                                        <input type="text" class="form-control" ng-model="item2.Quantity" maxlength="5" onkeypress='return event.charCode>= 48 && event.charCode <= 57 || (event.charCode===190)' />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-menu-btn">
                            <button type="submit" class="btn btn-primary" ng-click="SaveSalesEntry()">{{translation.Submit}}</button>
                            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="Back()"> {{translation.Back}}</a>
                        </div>
                    </div>
                </div>

                
            </form>
        </div>


    </div>

</div>