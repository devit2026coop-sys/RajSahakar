
<script src="~/Scripts/AngularFramework/StockManagemenetMaster.js?888"></script>
<script type="text/javascript">

    function ValidateAlpha(evt) {
        var keyCode = (evt.which) ? evt.which : evt.keyCode
        if ((evt.which == 8 || evt.keyCode == 8 || evt.charCode == 8))
            return true;

        if (((keyCode < 49 || keyCode > 90) && (keyCode < 97 || keyCode > 123) && keyCode != 32))
            return false;
        return true;
    };

</script>



<div ng-app="ProcessingUnitCnt">
    <div ng-controller="ProcessingUnitMod">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.ProcessingUnit}}</h3>
            <hr style="margin: 0;">
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.StockManagement}}</a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.ProcessingUnit}} </span>
                    </li>
                    <li style="float: right;" id="divAddBtn">
                        <button type="button" ng-click="ShowDivProcessingUnitInsert()" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" style="color: #025e63; cursor: pointer; text-decoration:none;  font-weight: bold;">
                            <h5>&#187; {{translation.InsertProcessingUnit}}</h5>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="divInsertProcessingUnit">
            <form class="citizen-dash-head">
                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{ translation.ProcessingUnitNameEng}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="ProcessingUnit.ProcessingUnitNameEng" placeholder={{translation.ProcessingUnitNameEng}} autocomplete="off" onKeyPress="return ValidateAlpha(event);" maxlength="50" />
                    </div>
                    <div class="col-lg-2">{{ translation.ProcessingUnitNameHi}}<span class="error">*</span></div>
                    <div class="col-lg-4">
                        <input type="text" class="form-control" ng-model="ProcessingUnit.ProcessingUnitNameHi" placeholder={{translation.ProcessingUnitNameHi}} autocomplete="off" maxlength="50" />
                    </div>
                </div>

                <div class="col-lg-12 form-group">
                    <div class="col-lg-2">{{translation.District}}</div>
                    <div class="col-lg-4">
                        <select class="form-control" ng-model="ProcessingUnit.DistrictId" ng-init="ProcessingUnit.DistrictId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option ng-repeat="item in Districts" value="{{item.DISTRICT_ID}}">
                                {{_language =='en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL}}
                            </option>
                        </select>
                    </div>
                    <div class="col-lg-2">{{translation.IsProcessingUnitOperational}}</div>
                    <div class="col-lg-4">
                        <input class="form-check-input" type="checkbox" ng-model="ProcessingUnit.IsOperating" ng-checked="ProcessingUnit.IsOperating === true" />
                    </div>
                </div>
                <div class="form-group col-md-12">
                    <div class="dev-menu-btn">
                        <button type="submit" class="btn btn-primary" ng-click="InsertProcessingUnit()">{{translation.Submit}}</button>
                        <button type="submit" class="btn btn-primary" ng-click="ClearProcessingUnitForm()">{{translation.Clear}}</button>
                        <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" ng-click="BackToProcessingUnitList()"> {{translation.Back}}</a>
                        <input type="hidden" ng-model="ProcessingUnit.ProcessingUnitId" />
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="GridProcessingUnit">
            <div>
                <div class="citizen-dash-head">
                    @*<div class="table-dropdown">
                            <div class="col-lg-12 form-group">
                                <div class="col-lg-4" style="padding-left: 0;">
                                    <label for="search">{{translation.ChannelName}}:</label>
                                    <select ng-model="Trainning.ChannelId" class="form-control" ng-init="Trainning.ChannelId='0'" ng-change="GetAllTrainningList()" id="ddlChannel">
                                        <option value="0">{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in Channels" value="{{item.ChannelId}}">
                                            {{_language =='en-us' ?  item.ChannelName_En : item.ChannelName_Hi}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-lg-4" style="padding-left: 0;">
                                    <label for="search">{{translation.Organization}}:</label>
                                    <select class="form-control" id="ddlOrganisation" ng-model="Trainning.OrganisationId" ng-init="Trainning.OrganisationId='0'" ng-change="GetAllTrainningList()">
                                        <option value="0">{{translation.SelectOption}}</option>
                                        <option ng-repeat="item in OrganisationData" value="{{item.OrganisationId}}">
                                            {{_language =='en-us' ?  item.OrganisationNameEn : item.OrganisationNameHi}}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4" style="padding-left: 0;">
                                    <label for="search">{{translation.Search}}:</label>
                                    <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                                </div>
                            </div>
                            <div class="col-lg-12 form-group">
                                <label for="search">{{translation.ItemPerPage}}:</label>
                                <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                            </div>
                        </div>*@
                    <table class="table table-responsive devtable" style="overflow-x:auto;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('DISTRICT_ENG')">
                                    {{translation.District}}
                                    <div ng-class="getSortClass('DISTRICT_ENG')"></div>
                                </th>
                                <th ng-click="sortData('ProcessingUnitNameEng')">
                                    {{translation.ProcessingUnitNameEng}}
                                    <div ng-class="getSortClass('ProcessingUnitNameEng')"></div>
                                </th>
                                <th ng-click="sortData('ProcessingUnitNameHi')">
                                    {{translation.ProcessingUnitNameHi}}
                                    <div ng-class="getSortClass('ProcessingUnitNameHi')"></div>
                                </th>
                                <th ng-click="sortData('IsOperating')">
                                    {{translation.IsProcessingUnitOperational}}
                                    <div ng-class="getSortClass('IsOperating')"></div>
                                </th>
                                <th>
                                    {{translation.IsActive}}
                                </th>
                                <th>
                                    {{translation.Edit}}
                                </th>
                                <th>
                                    {{translation.Delete}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in ProcessingUnits | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="TrainningFormatPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>
                                    {{ _language === 'en-us' ?  item.DISTRICT_ENG : item.DISTRICT_MANGAL }}
                                </td>
                                <td>
                                    {{ item.ProcessingUnitNameEng}}
                                </td>
                                <td>
                                    {{ item.ProcessingUnitNameHi}}
                                </td>
                                <td>
                                    {{item.IsOperating === 'True' ? translation.Yes : translation.No}}
                                </td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="item.IsActive === 'True' || item.IsActive === 'true' || item.IsActive === true" ng-click="SetStatus(item.ProcessingUnitId,1)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td><a href="javascript:void(0)"><i class="fa fa-edit" aria-hidden="true" ng-click="Edit(item)"></i></a></td>
                                <td><a href="javascript:void(0)"><i class="fa fa-trash" aria-hidden="true" ng-click="SetStatus(item.ProcessingUnitId,2)"></i></a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="TrainningFormatPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
        </div>
