@{ ViewBag.Title = "Department Progress"; }
<div ng-app="departmentProgressApp" ng-controller="DepartmentProgressCtrl">
 @Html.AntiForgeryToken()
 <h3>जिला वार विभागीय प्रगति</h3>
 <label>District ID <input type="number" min="1" ng-model="districtId" /></label>
 <label>Report date <input type="date" ng-model="reportDate" /></label>
 <button type="button" ng-click="load()">Load</button>
 <div style="overflow-x:auto"><table class="table table-bordered table-condensed">
 <thead><tr><th>विभाग</th><th>कुल समितियां</th><th>चुनाव विभाग</th><th>चुनाव पार्टी</th><th>आवेदन से शेष</th><th>नया विभाग</th><th>नया पार्टी</th><th>पुराना विभाग</th><th>पुराना पार्टी</th></tr></thead>
 <tbody><tr ng-repeat="r in rows track by r.DepartmentId"><th>{{r.DepartmentName}}</th>
 <td><input type="number" min="0" step="1" ng-model="r.TotalCommittees" class="form-control" /></td>
 <td><input type="number" min="0" step="1" ng-model="r.ElectionDepartment" class="form-control" /></td>
 <td><input type="number" min="0" step="1" ng-model="r.ElectionParty" class="form-control" /></td>
 <td><input type="number" min="0" step="1" ng-model="r.PendingApplications" class="form-control" /></td>
 <td><input type="number" min="0" step="1" ng-model="r.NewDepartment" class="form-control" /></td>
 <td><input type="number" min="0" step="1" ng-model="r.NewParty" class="form-control" /></td>
 <td><input type="number" min="0" step="1" ng-model="r.OldDepartment" class="form-control" /></td>
 <td><input type="number" min="0" step="1" ng-model="r.OldParty" class="form-control" /></td></tr></tbody>
 <tfoot><tr><th>कुल योग</th><th>{{total('TotalCommittees')}}</th><th>{{total('ElectionDepartment')}}</th><th>{{total('ElectionParty')}}</th><th>{{total('PendingApplications')}}</th><th>{{total('NewDepartment')}}</th><th>{{total('NewParty')}}</th><th>{{total('OldDepartment')}}</th><th>{{total('OldParty')}}</th></tr></tfoot>
 </table></div>
 <button type="button" ng-disabled="busy" ng-click="save()">{{busy ? 'Saving...' : 'Submit'}}</button>
 <button type="button" ng-click="clear()">Clear</button>
 <p role="status">{{message}}</p>
</div>
@section scripts {
 <script src="~/Scripts/angular.min.js"></script>
 <script>window.progressUrls={get:'@Url.Action("GetData","DepartmentProgress")',save:'@Url.Action("Save","DepartmentProgress")'};</script>
 <script src="~/Scripts/department-progress.js"></script>
}
