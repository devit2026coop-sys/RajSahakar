@model Cooperative.Models.LogInEntity
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" name="viewport" content="width=device-width" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@ViewBag.Title</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="EO" content="Directorate of Cooperative Organisation (Government of Rajasthan)">
    <link href="~/Content/Stylesheets/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Stylesheets/responsive.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Stylesheets/SiteStyle.css" rel="stylesheet" type="text/css" />

    <script src="~/Scripts/jquery-3.1.0.js"></script>
    <script src="~/Scripts/CommonScript.js"></script>
    <link rel="stylesheet" href="~/Content/Stylesheets/font-awesome.min.css">
    <link href="~/Scripts/jquery-ui-1.10.3/themes/base/jquery.ui.core.css" rel="stylesheet" />
    <script type="text/javascript" src="~/Scripts/angular-cookies.js"></script>
    <link href="~/Content/Stylesheets/StyleSheet1.css" rel="stylesheet" />


    <script type="text/javascript">
        window.history.forward();
        function noBack() {
            window.history.forward();
            window.onhashchange = function () { window.location.hash = "no-back-button"; }
        }

        function PostMyForm() {
            $('input[type=hidden][name=UserSSOId]').val($('#ddlUser :selected').val());
            return true;
        }
    </script>

    <script>
        function GetUserList() {
            var RoleId = $("#ddlRole :selected").val();
            $.ajax
                ({
                    url: '/Login/SSOUserList',
                    type: 'POST',
                    datatype: 'application/json',
                    contentType: 'application/json',
                    data: JSON.stringify({ RoleId: RoleId }),
                    success: function (result) {
                        $("#ddlUser").html("");
                        $.each(result, function (i, item) {
                            $("#ddlUser").append($('<option></option>').val(item.SSOID).html(item.OfficerNameEn))
                        })

                    },
                    error: function () {
                    },
                });
        }
    </script>
</head>
<body onload="noBack();" onpageshow="if (event.persisted) noBack();" onunload="">
    @using (Html.BeginForm("GetUserDashboard", "Login", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="LoginOuter" style="background-image: url('../Content/Images/LoginBG.jpg');">
            <div class="vv">
                <div class="LoginInner">
                    <div class="dev-bg-frm-clr">
                        <form name="form" class="dev-bg-frm-clr">
                            <span class="loginTitle"> Log in </span>
                            <div class="form-group">
                                <select name="ddlRoleList" id="ddlRole" class="form-control" onchange="GetUserList()">
                                    @foreach (var item in (List<Cooperative.Models.UserEntity>) ViewBag.RoleList)
                                    {
                                        <option value="@item.UserId">@item.OfficerNameEn</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <select name="ddlUserList" id="ddlUser" class="form-control">
                                    <option value="0">--Select User --</option>
                                </select>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary dev-log-btn" onclick="return PostMyForm()">Login</button>
                                <input type="hidden" name="UserSSOId" value="" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    }
</body>
</html>
