@{
    ViewBag.Title = "Citizen Detail List";
}

<script src="~/Scripts/AngularFramework/CitizenDetailList.js?id=3"></script>

<link href="http://cdn.rawgit.com/davidstutz/bootstrap-multiselect/master/dist/css/bootstrap-multiselect.css" rel="stylesheet" type="text/css" />
<script src="http://cdn.rawgit.com/davidstutz/bootstrap-multiselect/master/dist/js/bootstrap-multiselect.js" type="text/javascript"></script>

<div ng-app="CitizenDetailListModule">
    <div ng-controller="CitizenDetailListCont">
        <div class="loader"> </div>
        <div class="col-md-12">

        </div>
      
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#">  {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;">{{translation.CITIZENDASHBOARD || 'Citizen Detail List'}} </span>
                    </li>

                </ul>
            </div>
        </div>

        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head" style="overflow: hidden;">
                    <div class="table-dropdown">
                        <div class="col-xs-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-xs-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" onkeypress='return event.charCode >= 48 && event.charCode <= 57' ng-model="pageSize">
                        </div>

                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary" style="margin-top:10px;padding-top:10px" ng-click="ShowUserSearchList()">{{translation.Search}}</button>
                        </div>
                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>
                                    {{translation.DisplayNameEn || 'Citizen Name'}}
                                </th>

                                <th>
                                    {{translation.MobileNo}}
                                </th>
                                <th>
                                    {{translation.SSOID}}
                                </th>
                                <th>
                                    {{translation.Gender}}
                                </th>

                                <th ng-click="sortData('DateOfBirth')">
                                    {{translation.DOB}} <div ng-class="getSortClass('DateOfBirth')"></div>
                                </th>
                                <th>{{translation.IsActive}}</th>
                            </tr>

                        </thead>

                        <tbody>
                            <tr dir-paginate="Class in UserReqData | filter:q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="SubclassPagination">

                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ Class.DisplayNameEn }}</td>
                                <td>{{Class.MobileNo}} </td>
                                <td>{{Class.SSO_ID}}</td>
                                <td>{{Class.Gender}}</td>
                                <td>{{Class.DateOfBirth | date:'dd-MM-yyyy' }}</td>
                                <td>{{Class.IsActive == 1 ? 'Yes' : 'No' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>


            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="SubclassPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">

                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
                </div>
            </div>

            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>

      
    </div>

    <div class="se-pre-con"></div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>



</div>