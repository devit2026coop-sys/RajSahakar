@model Cooperative.Models.LogInEntity
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" name="viewport" content="width=device-width" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@ViewBag.Title</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="EO" content="Directorate of Evaluation Organisation (Government of Rajasthan)">
    <link href="~/Content/Stylesheets/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Stylesheets/responsive.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Stylesheets/SiteStyle.css" rel="stylesheet" type="text/css" />
    <script type="text/javascript">
        window.history.forward();
        function noBack() {
            window.history.forward();
            window.onhashchange = function () { window.location.hash = "no-back-button"; }
        }
    </script>
</head>
<body onload="noBack();" onpageshow="if (event.persisted) noBack();" onunload="">
    @using (Html.BeginForm("MapSSOWithCredentials", "Login", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="LoginOuter" style="background-image: url('../Content/Images/LoginBG.jpg');">
            <div class="vv">
                <div class="LoginInner">
                    <img src="~/Content/Images/logo.png" class="img-responsive sso-logo" alt="Logo" />
                    <div class="dev-bg-frm-clr">
                        <span class="loginTitle"> Log in </span>
                        <div class="form-group">
                            @Html.TextBoxFor(m => m.UserId, new { @class = "form-control", placeholder = "User Name", autocomplete = "off" })
                        </div>
                        <div class="form-group">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Password", autocomplete = "off" })
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary dev-sso-btn">Login</button>
                            <button type="submit" class="btn btn-primary dev-sso-btn">Back to SSO</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</body>
</html>
