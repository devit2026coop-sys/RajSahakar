<script src="~/Scripts/AngularFramework/Lov.js"></script>
<style>
    .has-error {
        border: #F00;
    }
</style>
<div ng-app="LovMod" ng-controller="LovCnt">

    <div class="col-md-12">
        <h3 class="citizen-dash-head "> {{translation.LOV}}  </h3>
        <hr style="margin: 0;">
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#" class="ng-binding">Home</a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;" class="ng-binding"> Godown </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;" class="ng-binding"> List of Values </span>
                </li>
            </ul>
        </div>
    </div>

    <div class="citizen-dash-head">
        <div class="row">
            <div class="col-md-12">
                <form class="dev-masters" name="Lov">
                    <div class="form-group col-md-6">
                        <label>{{translation.LOVCode}}</label>
                        <select ng-model="LOVvalue.LovListId" class="form-control" ng-init="LOVvalue.LovListId='0'">
                            <option value="0" disabled>{{translation.SelectOption}}</option>
                            <option data-ng-repeat="item in LovddlData" value="{{item.LovListId}}">
                                {{_language =='en-us' ?  item.ListDescription : item.ListDescriptionHi}}
                            </option>
                        </select>
                    </div>

                    <div class="form-group col-md-6" ng-class="{ 'has-error' : Lov.lovcode.$invalid && !Lov.lovcode.$pristine }">
                        <label>{{translation.LOVCode}}</label>
                        <input type="text" class="form-control" name="lovcode" ng-model="LOVvalue.ListCode" placeholder="{{translation.LOVCode}}" ng-minlength="1" >
                        <label ng-show="Lov.lovcode.$error.required && !Lov.lovcode.$pristine" class="help-block">{{translation.LOVCode}} - {{translation.Required}}</label>
                        <input type="hidden" ng-model="LOV.LovListId" value="{{LOV.LovValuesId}}" />

                    </div>

                    <div class="form-group col-md-6" ng-class="{ 'has-error' : Lov.LOVDescEn.$invalid && !Lov.LOVDescEn.$pristine }">
                        <label>{{translation.LOVDescEn}}</label>
                        <input type="text" class="form-control" only-letters-input name="LOVDescEn" ng-model="LOVvalue.Listdescription" placeholder="{{translation.LOVDescEn}}" required>
                        <label ng-show="Lov.LOVDescEn.$error.required && !Lov.LOVDescEn.$pristine" class="help-block">{{translation.LOVDescEn}} - {{translation.Required}}</label>
                    </div>

                    <div class="form-group col-md-12">
                        <div class="dev-align-btn">
                            <button type="submit" class="btn btn-primary dev-btn" ng-click="SaveLovValue(LOVvalue)">{{translation.Submit}}</button>
                            <button type="button" class="btn btn-primary dev-btn" ng-click="ClearLovValueForm()">{{translation.Clear}}</button>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <div class="citizen-dash-head">
        <div class="">  {{newdiv}}  </div>
        <div class="" ng-show="DivLov">
            <div class="col-md-12 dev-search-form">
                <div class="col-md-4">
                    <label for="search">{{translation.Search}}:</label>
                    <input ng-model="q" id="search" class="form-control" placeholder="Filter text">
                </div>
                <div class="col-md-4">
                    <label for="search">{{translation.ItemPerPage}}:</label>
                    <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                </div>
            </div>

            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table devtable" style="margin-top: 30px;">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th ng-click="sortData('LovCode')">
                                    {{translation.LOVCode}}
                                    <div ng-class="getSortClass('LovCode')"></div>
                                </th>
                                <th ng-click="sortData('Lovdescription')">
                                    {{translation.LOVDescEn}}
                                    <div ng-class="getSortClass('Lovdescription')"></div>
                                </th>

                                <th ng-click="sortData('ListDescription')">
                                    {{translation.LOVDeschi}}
                                    <div ng-class="getSortClass('ListDescription')"></div>
                                </th>
                                <th>
                                    {{translation.Action}}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="item in LovValueData | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="lovPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ item.LovCode }}</td>
                                <td>{{ item.Lovdescription }}</td>
                                <td>{{ language == 'en-us' ? item.ListDescription  : item.ListDescriptionHi }}</td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="item.IsActive == 1" ng-click="SetStatusValue(item.LovValuesId,item.IsActive)">
                                            <span class="slider round"></span>
                                        </label>

                                        <i class="fa fa-edit" ng-click="LovValueUpdate(item)"></i>

                                        <i class="fa fa-trash" ng-click="SetStatusValue(item.LovValuesId,2)"></i>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-12">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="lovPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>


