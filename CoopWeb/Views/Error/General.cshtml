@{
    Layout = "~/Views/Shared/_Layout.cshtml";
  //  ViewBag.Title = "Http Error general";
}
<style>
    .error {
        text-align: center;
        font-size: xx-large;
        margin-top: 100px;
        font-family: 'Segoe Ui', Tahoma, Helvetica, Arial, sans-serif;
    }
</style>
<div class="error">
    <span>@((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "OOPs!" : "क्षमा करें!")</span><br />
    <span>
       
        @((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "General Error " : "सामान्य त्रुटि")<br>
        @((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "Some Error Occure Please Contact To Admin" : "कुछ त्रुटि उत्पन्न कृपया व्यवस्थापक से संपर्क करें")
    </span>
</div>
