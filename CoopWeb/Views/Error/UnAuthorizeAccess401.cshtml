
@{
    Layout = "~/Views/Shared/_LayoutWithoutLogin.cshtml";
    ViewBag.Title = "Http Error 401 - Unauthorized Access";
}
<style>
    .error {
        text-align: center;
        font-size: xx-large;
        margin-top: 100px;
        font-family: 'Segoe Ui', Tahoma, Helvetica, Arial, sans-serif;
    }
</style>
@if ((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]) != null)
{
    <div class="error">
        <span>@((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "OOPs!" : "क्षमा करें!")</span><br />
        <span>
            401
            <br>
            @((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "Error Code" : "त्रुटि कोड")<br>
            @((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "Unauthorized Access ! You are Not authorized user For this request" : "अनधिकृत एक्सेस! आप इस अनुरोध के लिए अधिकृत उपयोगकर्ता नहीं हैं")
        </span>
    </div>
}
else
{
    <div class="error">
        <span>OOPs!</span><br />
        <span>
            401
            <br>
            Error Code<br>
            Unauthorized Access ! You are Not authorized user For this request
        </span>
    </div>
}