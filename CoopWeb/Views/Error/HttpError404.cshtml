@{

    Layout = "~/Views/Shared/_Layout.cshtml";
    //  ViewBag.Title = "Http Error 404";
}
<style>
    .error {
        text-align: center;
        font-size: xx-large;
        margin-top: 100px;
        font-family: 'Segoe Ui', Tahoma, Helvetica, Arial, sans-serif;
    }
</style>
<div class="error">
    @if ((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]) != null)
    {
        <span>@((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "OOPs!" : "क्षमा करें")</span><br />
        <span>
            404
            <br>
            @((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "Error Code" : "त्रुटि कोड")<br>
            @((Request.Cookies[Cooperative.Controllers.SessionIdentity.Culture]).Value.ToLower() == "en-us" ? "Page You are Searching Which is not available" : "पृष्ठ आप खोज रहे हैं जो उपलब्ध नहीं है")
        </span>
    }
    else
    {
        <span>OOPs!</span><br />
        <span>
            404
            <br>
            Error Code<br>
            Page You are Searching Which is not available.
        </span>
    }
</div>