                        </tr>
                       
                    </thead>
                    <tbody>
                        @*<tr>
                            <td>1.</td>
                            <td>Request for closing society</td>
                            <td><a href="../Citizen/SocietyMemberRegistration" class="btn btn-primary dev-btn">Apply</a></td>
                        </tr>*@
                        <tr>
                            <td>1.</td>
                            <td>{{translation.MembershipRequest}}</td>
                            <td>
                                <a href="../Citizen/SocietyMemberRegistration" class="btn btn-primary dev-btn">{{translation.Apply}}</a>
                            </td>
                        </tr>
                        <tr>
                            <td>2.</td>
                            <td>{{translation.PLDBMemberRegistration}}</td>
                            <td>
                                <a href="../SocietyMemberRegistration/PLDBMemberRegistration" class="btn btn-primary dev-btn">{{translation.Apply}}</a>
                            </td>
                        </tr>
                        <tr>
                            <td>3.</td>
                            <td>{{translation.LoanApplicationLetter}}</td>
                            <td>
                                <a href="../PldbLoan/LoanApplication" class="btn btn-primary dev-btn">{{translation.Apply}}</a>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
            <div class="form-group col-md-12">
                <div class="dev-align-btn">                   
                    <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../Citizen/Index"> Back</a>
