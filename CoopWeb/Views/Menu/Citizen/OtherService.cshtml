
@{
    ViewBag.Title = "OtherService";
    Layout = "~/Views/Shared/_CitizenLayout.cshtml";
}

<script src="~/Scripts/AngularFramework/CitizenClient.js"></script>
@*@model List<Cooperative.Models.SocietyRegistrationEntity>*@
<style>
    .heading-hr {
        font-size: 17px;
        font-weight: bold;
