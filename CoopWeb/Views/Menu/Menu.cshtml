
<script src="~/Scripts/AngularFramework/MenuClient.js?id=1"></script>
<style>
    .has-error {
        border: #F00;
    }
</style>
<div ng-app="UserMenu">
    <div ng-controller="Menu">
        <div class="col-md-12">
            <h3 class="citizen-dash-head">{{translation.MenueHeading}}</h3>
            <hr style="margin: 0;">
        </div>

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="devpage-breadcrumb">
                <ul class="page-breadcrumb">
                    <li class="dev-page-br">
                        <i class="fa fa-home"> </i>
                        <a href="#"> {{translation.Home}} </a>
                        <i class="fa fa-angle-right"> </i>
                    </li>
                    <li style="float: left">
                        <span style="margin: 0 5px;"> {{translation.New}} </span>
                        <i class="fa fa-angle-right"> </i>
                        <span style="margin: 0 5px;"> {{translation.MenueHeading}} </span>
                    </li>
                    <li style="float: right;">
                        <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal"> <h5>&#187; {{translation.AddMenu}}</h5> </button>
                    </li>
                </ul>
            </div>
        </div>



        <div class="dev-popup-body modal fade" id="myModal" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" ng-click="ClearMenuForm()">&times;</button>
                        <h4 class="modal-title">{{translation.MenueHeading}} </h4>
                    </div>
                    <div class="modal-body">

                        <form class="dev-search-form" name="MyMenuForm" style="overflow: hidden;">
                            <div class="form-group">
                                <div class="form-check form-check-inline">
                                    <label class="check-box" for="inlineRadio1">{{translation.IsParent}} </label>
                                    <input name="Parent" type="checkbox" ng-model="Show" placeholder="Is Parent Menu" ng-checked="menu.ParentId==0" ng-change="ShowHide()">
                                </div>

                            </div>

                            <div ng-hide='IsVisible'>
                                <div class="form-group">
                                    <label>{{translation.ParentMenu}} </label>
                                    <select ng-model="menu.ParentId" class="form-control" ng-init="menu.ParentId='0'" ng-change="GetSubMenu()">
                                        <option value="0" disabled>{{translation.SelectMasterMenu}}</option>
                                        <option ng-repeat="Menu in  parentmenu" value="{{Menu.MenuId}}">
                                            {{_language =='en-us' ?  Menu.MenuNameEn : Menu.MenuNameHi}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group" ng-hide='IsVisible'>
                                <div class="form-check form-check-inline">
                                    <label class="check-box" for="inlineRadio1">{{translation.SubMenu}} </label>
                                    <input name="Parent" type="checkbox" ng-model="menu.SubMenu" placeholder="Is Parent Menu">
                                </div>
                            </div>

                            <div ng-if='menu.SubMenu'>
                                <div class="form-group">
                                    @*<label>{{translation.SubMenu}} </label>*@
                                    <select ng-model="menu.SubMenuId" class="form-control" ng-init="menu.SubMenuId='0'">
                                        <option value="0">{{translation.SelectOption}}</option>
                                        <option ng-repeat="Menu in submenu" value="{{Menu.MenuId}}">
                                            {{_language =='en-us' ?  Menu.MenuNameEn : Menu.MenuNameHi}}
                                        </option>
                                    </select>
                                </div>
                            </div>


                            <div class="form-group" ng-class="{ 'has-error' : MyMenuForm.MenuNameEn.$invalid && !MyMenuForm.MenuNameEn.$pristine }">
                                <label>{{translation.MenuNameEn}}</label>
                                <input type="text" class="form-control" only-letters-input name="MenuNameEn" ng-bind="MenuNameEn" ng-model="menu.MenuNameEn" placeholder="{{translation.MenuNameEn}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                <label ng-show="MyMenuForm.MenuNameEn.$error.required && !MyMenuForm.MenuNameEn.$pristine" class="help-block">{{translation.MenuNameEn}} - {{translation.Required}}</label>

                            </div>


                            <div class="form-group" ng-class="{ 'has-error' : MyMenuForm.MenuNameHi.$invalid && !MyMenuForm.MenuNameHi.$pristine }">
                                <label>{{translation.MenuNameHi}}</label>
                                <input type="text" class="form-control" name="MenuNameHi" ng-bind="MenuNameHi" ng-model="menu.MenuNameHi" placeholder="{{translation.MenuNameHi}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                <label ng-show="MyMenuForm.MenuNameHi.$error.required && !MyMenuForm.MenuNameHi.$pristine" class="help-block">{{translation.MenuNameHi}} - {{translation.Required}}</label>

                            </div>

                            <div class="form-group" ng-class="{ 'has-error' : MyMenuForm.MenuUrl.$invalid && !MyMenuForm.MenuUrl.$pristine }">
                                <label>{{translation.MenuUrl}}</label>
                                <input type="text" class="form-control" name="MenuUrl" ng-bind="MenuUrl" ng-model="menu.MenuUrl" placeholder="{{translation.MenuUrl}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                <label ng-show="MyMenuForm.MenuUrl.$error.required && !MyMenuForm.MenuUrl.$pristine" class="help-block">{{translation.MenuUrl}} - {{translation.Required}}</label>

                            </div>

                            <div class="form-group" ng-class="{ 'has-error' : MyMenuForm.MenuIcon.$invalid && !MyMenuForm.MenuIcon.$pristine }">
                                <label>{{translation.MenuIcon}}</label>
                                <input type="text" class="form-control" name="MenuIcon" ng-bind="MenuIcon" ng-model="menu.MenuIcon" placeholder="{{translation.MenuIcon}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off">
                                <label ng-show="MyMenuForm.MenuIcon.$error.required && !MyMenuForm.MenuIcon.$pristine" class="help-block">{{translation.MenuIcon}} - {{translation.Required}}</label>

                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label no-padding-right">{{translation.MenueAction}}</label>
                                <div class="col-sm-9">
                                    <label ng-repeat="item in MenuActionList">
                                        <input type="checkbox" name="MenuAction{{item.MenuActionId}}" ng-model="item.Checked" value="item.Checked==true ? true : false"> {{item.MenuActionEn}}
                                    </label>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="form-check form-check-inline">
                                    <label class="check-box" for="inlineRadio1" style="margin-right: 15px;"> {{translation.IsActive}} </label>
                                    <input class="form-check-input" type="checkbox" id="inlineCheckbox1" value="option1" ng-model="menu.IsActive" ng-checked="menu.IsActive == 1" /> @*ng-checked="menuaction.IsActive == 1"*@
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="dev-menu-btn">
                                    <button type="submit" class="btn btn-primary" ng-disabled="MyMenuForm.$invalid" ng-click="InsertMenu()">{{translation.Submit}}</button>
                                    <button type="submit" class="btn btn-primary" ng-click="ClearMenuForm()">{{translation.Clear}}</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>

        <div class="">
            <div class="col-md-12">
                <div class="citizen-dash-head">
                    <div class="table-dropdown">
                        <div class="col-md-4">
                            <label for="search">{{translation.Search}}:</label>
                            <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label for="search">{{translation.ItemPerPage}}:</label>
                            <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                        </div>
                        <div class="col-md-4">
                            <label>{{translation.ParentMenu}} </label>
                            <select ng-model="menu.ParentId" class="form-control" ng-init="menu.ParentId='0'" ng-change="MenuListbyparents()">
                                <option value="0" disabled>{{translation.SelectMasterMenu}}</option>
                                <option ng-repeat="Menu in parentmenu" value="{{Menu.MenuId}}">
                                    {{_language =='en-us' ?  Menu.MenuNameEn : Menu.MenuNameHi}}
                                </option>
                            </select>
                        </div>



                    </div>
                    <table class="table table-responsive devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>
                                <th>Level 1</th>
                                <th>Level 2</th>
                                <th>Level 3</th>
                                @*<th ng-click="sortData('MenuNameEn')">
                                    {{translation.MenuNameEn}}
                                    <div ng-class="getSortClass('MenuNameEn')"></div>
                                </th>
                                <th ng-click="sortData('MenuNameHi')">
                                    {{translation.MenuNameHi}}
                                    <div ng-class="getSortClass('MenuNameHi')"></div>
                                </th>*@
                                @*<th ng-click="sortData('ParentMenuNameEn')">
                                    {{translation.ParentMenuNameEn}}
                                    <div ng-class="getSortClass('ParentMenuNameEn')"></div>
                                </th>
                                <th ng-click="sortData('ParentMenuNameHi')">
                                    {{translation.ParentMenuNameHi}}
                                    <div ng-class="getSortClass('ParentMenuNameHi')"></div>
                                </th>*@
                                <th ng-click="sortData('MenuUrl')">
                                    {{translation.MenuUrl}}
                                    <div ng-class="getSortClass('MenuUrl')"></div>
                                </th>

                                <th ng-click="sortData('MenuIcon')">
                                    {{translation.MenuIcon}}
                                    <div ng-class="getSortClass('MenuIcon')"></div>
                                </th>

                                <th ng-click="sortData('IsActive')">
                                    {{translation.Status}}
                                    <div ng-class="getSortClass('IsActive')"></div>
                                </th>
                                <th>{{translation.Edit}}</th>
                                <th>{{translation.Delete}}</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr dir-paginate="Menu in AllMenus | filter: q | orderBy:colsort:reverseSort  | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                
                                <td>{{ Menu.Level1En | uppercase }}</td>
                                <td>{{ Menu.Level2En | uppercase }}</td>
                                <td>{{ Menu.Level3En | uppercase }}</td>
                                
                                @*<td>{{ Menu.MenuNameEn | uppercase }}</td>
                                <td>{{ Menu.MenuNameHi | uppercase }}</td>*@
                                @*<td>{{ Menu.ParentMenuNameEn | uppercase }}</td>
                                <td>{{ Menu.ParentMenuNameHi | uppercase }}</td>*@
                                <td>{{ Menu.MenuUrl | uppercase }}</td>
                                <td>{{ Menu.MenuIcon | uppercase }}</td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Menu.IsActive == 1" ng-click="SetStatus(Menu.MenuId,Menu.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Menu.MenuId)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(Menu.MenuId,2)"></i>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-10">
                <div class="text-center">
                    <dir-pagination-controls boundary-links="true" pagination-id="MenuPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
                </div>
            </div>
            <div class="col-md-2">
                <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
            </div>
        </div>
    </div>
    <div class="form-group col-md-12">
        <div class="dev-align-btn">

            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
        </div>
    </div>
    <div class="se-pre-con"></div>

    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>
