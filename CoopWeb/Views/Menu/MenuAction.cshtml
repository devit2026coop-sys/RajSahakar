
<script src="~/Scripts/AngularFramework/MenuActionClient.js"></script>
<style>
    .has-error {
        border: #F00;
    }
</style>
<div ng-app="MenuAction" ng-controller="Action">


    <div class="col-md-12">
        <h3 class="citizen-dash-head">{{translation.MenueAction}}</h3>
        <hr style="margin: 0;">
    </div>

    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="devpage-breadcrumb">
            <ul class="page-breadcrumb">
                <li class="dev-page-br">
                    <i class="fa fa-home"> </i>
                    <a href="#"> {{translation.Home}}  </a>
                    <i class="fa fa-angle-right"> </i>
                </li>
                <li style="float: left">
                    <span style="margin: 0 5px;"> {{translation.New}}  </span>
                    <i class="fa fa-angle-right"> </i>
                    <span style="margin: 0 5px;"> {{translation.MenueAction}}  </span>
                </li>
                <li style="float: right;" id="divAddBtn">
                    <button type="button" class="btn btn-info btn-lg dev-popup-btn" data-toggle="modal" data-target="#myModal"> <h5>&#187; {{translation.AddMenuModel}}</h5> </button>
                </li>
            </ul>
        </div>
    </div>




    <!-- Trigger the modal with a button -->
    <!-- Modal -->
    <div class="dev-popup-body modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" ng-click="ClearMenuActionForm()">&times;</button>
                    <h4 class="modal-title"> {{translation.MenuActionName}} </h4>
                </div>
                <div class="modal-body">

                    <form class="dev-search-form" name="MyMenuActionForm" style="overflow: hidden;">
                        <div class="form-group" ng-class="{ 'has-error' : MyMenuActionForm.MenuActionEn.$invalid && !MyMenuActionForm.MenuActionEn.$pristine }">
                            <label>{{translation.MenueActionNameEn}}</label>
                            <input type="text" only-letters-input name="MenuActionEn" ng-model="menuaction.MenuActionEn" class="form-control" placeholder="{{translation.MenueActionNameEn}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off" />
                            <label ng-show="MyMenuActionForm.MenuActionEn.$error.required && !MyMenuActionForm.MenuActionEn.$pristine" class="help-block">{{translation.MenueActionNameEn}} - {{translation.Required}}</label>

                        </div>
                        <div class="form-group" ng-class="{ 'has-error' : MyMenuActionForm.MenuActionHi.$invalid && !MyMenuActionForm.MenuActionHi.$pristine }">
                            <label>{{translation.MenueActionNameHi}}</label>
                            <input type="text" only-letters-input name="MenuActionHi" ng-model="menuaction.MenuActionHi" class="form-control" placeholder="{{translation.MenueActionNameHi}}" ng-minlength="1" maxlength="50" ng-required="true" autocomplete="off" />
                            <label ng-show="MyMenuActionForm.MenuActionHi.$error.required && !MyMenuActionForm.MenuActionHi.$pristine" class="help-block">{{translation.MenueActionNameHi}} - {{translation.Required}}</label>

                        </div>
                        <div class="form-group">
                            <input type="hidden" name="title" ng-model="menuaction.MenuActionId" placeholder="menu Action ID" />
                        </div>
                        <div class="form-group">
                            <div class="form-check form-check-inline">
                                <label class="check-box" for="inlineRadio1" style="margin-right: 15px;"> {{translation.IsActive}} </label>
                                <input class="form-check-input" type="checkbox" id="inlineCheckbox1" value="option1" ng-model="menuaction.IsActive" ng-checked="menuaction.IsActive == 1" /> @*ng-checked="menuaction.IsActive == 1"*@
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="dev-menu-btn">
                                <button type="submit" class="btn btn-primary" ng-disabled="MyMenuActionForm.$invalid" ng-click="SaveMenuAction()" style="margin-right:15px;">{{translation.Submit}}</button>
                                <button type="submit" class="btn btn-primary" ng-click="ClearMenuAction()">{{translation.Clear}}</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
    <div class="col-md-12">
        <div class="citizen-dash-head">
            <div class="table-dropdown">
                <div class="col-md-4">
                    <label for="search">{{translation.Search}}:</label>
                    <input ng-model="q" id="search" class="form-control" placeholder={{translation.filttertext}} autocomplete="off">
                </div>
                <div class="col-md-4">
                    <label for="search">{{translation.ItemPerPage}}:</label>
                    <input type="number" min="1" max="100" class="form-control" ng-model="pageSize">
                </div>
            </div>
            <div class="col-md-12 dev-search-form">

            </div><div class="col-md-12 dev-search-form">

            </div>
            <div class="col-md-12">
                <div class="table-responsive citizen-dash-head">
                    <table class="table devtable">
                        <thead>
                            <tr>
                                <th>
                                    {{translation.SRNO}}
                                </th>

                                <th ng-click="sortData('MenuActionEn')">
                                    {{translation.MenueActionNameEn}}
                                    <div ng-class="getSortClass('MenuActionEn')"></div>
                                </th>
                                <th ng-click="sortData('MenuActionHi')">
                                    {{translation.MenueActionNameHi}}
                                    <div ng-class="getSortClass('MenuActionHi')"></div>
                                </th>
                                <th ng-click="sortData('IsActive')">
                                    {{translation.Status}}
                                    <div ng-class="getSortClass('IsActive')"></div>
                                </th>
                                <th>{{translation.Edit}}</th>
                                <th>{{translation.Delete}}</th>
                            </tr>
                        </thead>
                        <tbody id="myTable">
                            <tr dir-paginate="Action in MenuActions | filter: q | orderBy:colsort:reverseSort | itemsPerPage: pageSize" current-page="currentPage" pagination-id="MenuActionPagination">
                                <td>{{pageSize *(currentPage-1)+$index+1}}</td>
                                <td>{{ Action.MenuActionEn | uppercase }}</td>
                                <td>{{ Action.MenuActionHi | uppercase }}</td>
                                <td>
                                    <div class="dev-action">
                                        <label class="switch">
                                            <input type="checkbox" ng-checked="Action.IsActive == 1" ng-click="SetStatus(Action.MenuActionId,Action.IsActive)">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <i class="fa fa-edit" data-target="#myModal" data-toggle="modal" ng-click="update(Action.MenuActionId)"></i>
                                </td>
                                <td>
                                    <i class="fa fa-trash" ng-click="SetStatus(Action.MenuActionId,2)"></i>


                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-10">
            <div class="text-center">
                <dir-pagination-controls boundary-links="true" pagination-id="MenuActionPagination" on-page-change="pageChangeHandler(newPageNumber)" template-url="/dirPagination.tpl.html"></dir-pagination-controls>
            </div>
        </div>
        <div class="col-md-2">
            <h5 class="dev-page"> {{translation.Page}}: {{ currentPage }} </h5>
        </div>
      
    </div>
    <div class="form-group col-md-12">
        <div class="dev-align-btn">

            <a class="btn btn-primary dev-btn" style="text-transform:capitalize;" href="../User/DashBoard"> Back</a>
        </div>

    </div>
    <div id="stop" class="scrollTop">
        <span><a href=""><i class="fa fa-arrow-up">Top</i></a></span>
    </div>
</div>