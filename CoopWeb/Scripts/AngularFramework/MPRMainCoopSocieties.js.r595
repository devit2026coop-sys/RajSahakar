            $scope.Coop.De_MS == undefined || $scope.Coop.De_MS == '0' ||
            $scope.Coop.Bo_MS == undefined || $scope.Coop.Bo_MS == '0' ||
            $scope.Coop.Wc_MS == undefined || $scope.Coop.Wc_MS == '0'


        ) {
